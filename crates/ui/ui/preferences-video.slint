import { Theme } from "theme.slint";
import { PreferenceSwitch, PreferenceNumericInput, PreferenceToggle, PreferenceOptionCard, PreferenceDisclosure } from "preferences-controls.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";

export global VideoSettingsState {
    in-out property <length> video-scroll-position: 0px;
    in-out property <string> video-threads-text: "0";
    in-out property <int> hardware-decoder-index: 1;
    in-out property <bool> live-text-enabled: false;
    in-out property <bool> load-icc-profile: true;
    in-out property <bool> default-hdr-mode-enabled: true;
    in-out property <bool> tone-mapping-expanded: false;
    in-out property <bool> tone-mapping-enabled: true;
    in-out property <bool> tone-mapping-target-peak-enabled: false;
    in-out property <string> tone-mapping-target-peak-text: "400";
    in-out property <[string]> tone-mapping-algorithm-options: [];
    in-out property <int> tone-mapping-algorithm-index: 0;
    in-out property <bool> tone-mapping-param-enabled: false;
    in-out property <string> tone-mapping-param-text: "1";
}

export component VideoPreferencesPage inherits ScrollView {
    in property <bool> platform-macos;
    in property <bool> live-text-available;
    in property <bool> mica-backdrop-enabled;
    callback settings-changed();

    content-y <=> VideoSettingsState.video-scroll-position;
    content-height: root.platform-macos
        ? (VideoSettingsState.tone-mapping-expanded
            ? (root.live-text-available ? 1130px : 1020px)
            : (root.live-text-available ? 870px : 760px))
        : (VideoSettingsState.tone-mapping-expanded
            ? (root.live-text-available ? 1030px : 920px)
            : (root.live-text-available ? 770px : 660px));
    content-width: self.visible-width;
    horizontal-scrollbar-policy: always-off;
    Rectangle {
        width: parent.width;
        height: root.platform-macos
            ? (VideoSettingsState.tone-mapping-expanded
                ? (root.live-text-available ? 1130px : 1020px)
                : (root.live-text-available ? 870px : 760px))
            : (VideoSettingsState.tone-mapping-expanded
                ? (root.live-text-available ? 1030px : 920px)
                : (root.live-text-available ? 770px : 660px));
        Text { x: 22px; y: 16px; text: "Video";
            font-size: 15px; font-weight: 600; color: Theme.settings-page-heading; }
        Text { x: 20px; y: 52px; text: "Decoding";
            font-size: 12px; font-weight: 600; color: Theme.settings-video-section-heading; }
        Rectangle {
            x: 20px; y: 76px; width: parent.width - 40px; height: 282px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            Text { x: 16px; y: 10px; text: "Number of threads";
                font-size: 11px; color: Theme.settings-control-label; }
            PreferenceNumericInput { x: parent.width - 62px; y: 7px; width: 42px; height: 24px;
                text <=> VideoSettingsState.video-threads-text;
                accepted => { root.settings-changed(); }
            }
            Text { x: 16px; y: 30px; text: "Default: 0 (Auto)";
                font-size: 9px; color: Theme.settings-section-heading; }
            Text { x: 16px; y: 56px; text: "Hardware decoder";
                font-size: 11px; color: Theme.settings-control-label; }
            PreferenceOptionCard { x: 36px; y: 78px; width: parent.width - 56px;
                title: "Disabled"; description: "Disable hardware decoding.";
                selected: VideoSettingsState.hardware-decoder-index == 0;
                activated => { VideoSettingsState.hardware-decoder-index = 0; root.settings-changed(); }
            }
            PreferenceOptionCard { x: 36px; y: 136px; width: parent.width - 56px;
                title: "Auto";
                description: "Enable hardware decoding. However, most of the video filters won't work properly.";
                selected: VideoSettingsState.hardware-decoder-index == 1;
                activated => { VideoSettingsState.hardware-decoder-index = 1; root.settings-changed(); }
            }
            PreferenceOptionCard { x: 36px; y: 194px; width: parent.width - 56px;
                title: "Auto (Copy)";
                description: "Enable hardware decoding. It will consume double the memory but work with video filters.";
                selected: VideoSettingsState.hardware-decoder-index == 2;
                activated => { VideoSettingsState.hardware-decoder-index = 2; root.settings-changed(); }
            }
        }
        if root.live-text-available : Rectangle {
            x: 20px; y: 378px; width: parent.width - 40px; height: 88px;
            Text { x: 8px; y: 0px; text: "Live Text";
                font-size: 12px; font-weight: 600; color: Theme.settings-video-section-heading; }
            Rectangle { x: 0px; y: 24px; width: parent.width; height: 64px;
                border-width: 1px; border-color: Theme.settings-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
                PreferenceSwitch { x: 16px; y: 7px; width: parent.width - 32px; height: 24px;
                    label: "Live Text"; checked <=> VideoSettingsState.live-text-enabled;
                    toggled => { root.settings-changed(); }
                }
                Text { x: 16px; y: 32px; width: parent.width - 32px; height: 26px;
                    text: "Show a text-selection overlay when video is paused.";
                    font-size: 9px; color: Theme.settings-section-heading; wrap: word-wrap; }
            }
        }
        Text { x: 20px; y: root.live-text-available ? 492px : 378px; text: "Color and HDR";
            font-size: 12px; font-weight: 600; color: Theme.settings-video-section-heading; }
        if root.platform-macos : Rectangle {
            x: 20px; y: root.live-text-available ? 516px : 402px;
            width: parent.width - 40px; height: 84px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            PreferenceSwitch { x: 16px; y: 8px; width: parent.width - 32px; height: 24px;
                label: "Load ICC profile"; checked <=> VideoSettingsState.load-icc-profile;
                toggled => { root.settings-changed(); }
            }
            Text { x: 36px; y: 38px; width: parent.width - 52px; height: 38px;
                text: "Load the current display profile to transform video RGB to screen output. (Only for SDR mode)";
                font-size: 9px; color: Theme.settings-section-heading; wrap: word-wrap;
            }
        }
        Rectangle {
            x: 20px;
            y: (root.live-text-available ? 516px : 402px)
                + (root.platform-macos ? 100px : 0px);
            width: parent.width - 40px; height: 84px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            PreferenceSwitch { x: 16px; y: 8px; width: parent.width - 32px; height: 24px;
                label: "Enable HDR mode"; checked <=> VideoSettingsState.default-hdr-mode-enabled;
                toggled => { root.settings-changed(); }
            }
            Text { x: 36px; y: 38px; width: parent.width - 52px; height: 38px;
                text: "Enable HDR mode by default when playing HDR videos.";
                font-size: 9px; color: Theme.settings-section-heading; wrap: word-wrap;
            }
        }
        Rectangle {
            x: 20px;
            y: (root.live-text-available ? 516px : 402px)
                + (root.platform-macos ? 200px : 100px);
            width: parent.width - 40px;
            height: VideoSettingsState.tone-mapping-expanded ? 376px : 84px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            PreferenceToggle { x: 12px; y: 8px; width: parent.width - 24px;
                label: "Tone Mapping"; checked <=> VideoSettingsState.tone-mapping-enabled;
                toggled => { root.settings-changed(); }
            }
            Text { x: 20px; y: 41px; width: parent.width - 40px; height: 22px;
                text: "Map high dynamic range video for the display.";
                font-size: 9px; color: Theme.settings-section-heading; wrap: word-wrap; }
            PreferenceDisclosure { x: 24px; y: 62px;
                width: parent.width - 48px;
                label: "Tone mapping options"; expanded: VideoSettingsState.tone-mapping-expanded;
                toggled => { VideoSettingsState.tone-mapping-expanded = !VideoSettingsState.tone-mapping-expanded; }
            }
            if VideoSettingsState.tone-mapping-expanded : Rectangle {
                x: 0; y: 90px; width: parent.width; height: 278px; background: transparent;
                PreferenceToggle { x: 24px; y: 0; width: parent.width - 48px;
                    label: "Override target peak";
                    checked <=> VideoSettingsState.tone-mapping-target-peak-enabled;
                    enabled: VideoSettingsState.tone-mapping-enabled;
                    toggled => { root.settings-changed(); }
                }
                PreferenceNumericInput { x: 36px; y: 35px; width: 58px; height: 24px;
                    text <=> VideoSettingsState.tone-mapping-target-peak-text;
                    enabled: VideoSettingsState.tone-mapping-enabled && VideoSettingsState.tone-mapping-target-peak-enabled;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 100px; y: 35px; height: 24px; text: "nits (10–10,000)";
                    font-size: 9px; color: Theme.settings-section-heading; vertical-alignment: center; }
                Text { x: 24px; y: 68px; text: "Algorithm";
                    font-size: 10px; color: Theme.settings-control-label; }
                ComboBox { x: 24px; y: 84px; width: parent.width - 48px; height: 25px;
                    model: VideoSettingsState.tone-mapping-algorithm-options;
                    current-index <=> VideoSettingsState.tone-mapping-algorithm-index;
                    enabled: VideoSettingsState.tone-mapping-enabled;
                    selected => { root.settings-changed(); }
                }
                PreferenceToggle { x: 24px; y: 119px; width: parent.width - 48px;
                    label: "Override tone-mapping parameter";
                    checked <=> VideoSettingsState.tone-mapping-param-enabled;
                    enabled: VideoSettingsState.tone-mapping-enabled;
                    toggled => { root.settings-changed(); }
                }
                PreferenceNumericInput { x: 36px; y: 154px; width: 72px; height: 24px;
                    text <=> VideoSettingsState.tone-mapping-param-text;
                    enabled: VideoSettingsState.tone-mapping-enabled && VideoSettingsState.tone-mapping-param-enabled;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 116px; y: 154px; width: parent.width - 132px; height: 32px;
                    text: "Uses the selected algorithm's parameter.";
                    font-size: 9px; color: Theme.settings-section-heading; vertical-alignment: center; wrap: word-wrap; }
            }
        }
    }
}
