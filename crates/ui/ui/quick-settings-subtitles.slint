import { PlaybackSubtitleState } from "playback-subtitle-state.slint";
import { Theme } from "theme.slint";
import { PlayerSlider } from "shared-controls.slint";
import { Tool } from "player-tool.slint";
import { QuickSettingsDelayEditor } from "quick-settings-delay.slint";
import { QuickSettingsTrackList } from "quick-settings-tracks.slint";
import { DelayLane } from "delay-lane.slint";
import { SubtitleVisibilityRow, SubtitleLaneSegment } from "player-sidebar-controls.slint";
import { SubtitleSizePicker } from "subtitle-size-picker.slint";
import { SubtitleColorWell } from "shared-controls.slint";

export component SubtitleQuickSettingsPage inherits VerticalLayout {
    in property <length> sidebar-width;
    callback choose-subtitle-font();
    in property <bool> compact-ui;
    in property <bool> dark-theme;
    callback find-online-subtitles();
    in property <color> interactive-accent-color;
    callback load-subtitle();
    in property <bool> loaded;
    in property <bool> platform-windows;
    callback reset-subtitle-delay();
    callback restore-player-focus();
    callback format-delay-preview(float) -> string;
    callback set-delay(DelayLane, float);
    callback set-delay-text(DelayLane, string) -> bool;
    callback set-subtitle-color(int, color);
    callback set-subtitle-font-size(float);
    callback set-subtitle-outline-size(float);
    callback set-subtitle-position(bool, float);
    callback set-subtitle-scale-slider(float);
    in property <color> sidebar-card-material-fill;
    in property <color> sidebar-control-material-fill;
    callback toggle-secondary-subtitle-visibility();
    callback toggle-subtitle-visibility();
    callback track-selected(int, string);
    callback focus-entered(length, length);
    in property <color> windows-accent-color;
    in property <color> windows-accent-foreground;
    in property <bool> windows-sidebar-material-active;
    private property <bool> secondary: PlaybackSubtitleState.edit-secondary-subtitle;
    private property <bool> delay-enabled: loaded && (!secondary || PlaybackSubtitleState.secondary-subtitle-delay-known);
    private property <float> selected-delay: secondary
        ? PlaybackSubtitleState.secondary-subtitle-delay : PlaybackSubtitleState.subtitle-delay;

    function select-delay-lane(secondary: bool) {
        if secondary != root.secondary {
            delay-editor.cancel-edit();
            PlaybackSubtitleState.edit-secondary-subtitle = secondary;
        }
    }
    function focus-delay-lane(secondary: bool) {
        root.select-delay-lane(secondary);
        if secondary { secondary-lane.take-focus(); }
        else { primary-lane.take-focus(); }
    }

    width: root.sidebar-width - (root.compact-ui ? 28px : 32px);
    spacing: root.compact-ui ? 16px : 18px;
    VerticalLayout { width: parent.width; spacing: root.compact-ui ? 8px : 12px;
        SubtitleVisibilityRow { label: "Primary"; number: "1";
            focus-entered(top, height) => { root.focus-entered(top, height); }
            checked: PlaybackSubtitleState.subtitle-visible; enabled: root.loaded;
            dark-theme: root.dark-theme;
            accent-color: root.platform-windows ? root.windows-accent-color : Theme.sidebar-catalog-accent;
            changed(value) => { root.toggle-subtitle-visibility(); } }
        QuickSettingsTrackList { width: parent.width; tracks: PlaybackSubtitleState.subtitle-tracks;
            focus-entered(top, height) => { root.focus-entered(top, height); }
            observed-index: PlaybackSubtitleState.subtitle-track-selected-index;
            hint: "Primary subtitle tracks"; label-prefix: "Primary subtitle: ";
            focus-accent-color: root.interactive-accent-color;
            track-kind: 2; dark-theme: root.dark-theme; enabled: root.loaded;
            accent-color: root.platform-windows ? root.windows-accent-color : Theme.sidebar-catalog-accent;
            card-fill: root.sidebar-card-material-fill;
            card-edge: Theme.sidebar-card-border(root.dark-theme);
            selected(kind, token) => { root.track-selected(kind, token); } }
    }
    VerticalLayout { width: parent.width; spacing: root.compact-ui ? 8px : 12px;
        SubtitleVisibilityRow { label: "Secondary"; number: "2";
            focus-entered(top, height) => { root.focus-entered(top, height); }
            checked: PlaybackSubtitleState.secondary-subtitle-visible;
            enabled: root.loaded && PlaybackSubtitleState.secondary-subtitle-visibility-known;
            dark-theme: root.dark-theme;
            accent-color: root.platform-windows ? root.windows-accent-color : Theme.sidebar-catalog-accent;
            changed(value) => { root.toggle-secondary-subtitle-visibility(); } }
        QuickSettingsTrackList { width: parent.width;
            focus-entered(top, height) => { root.focus-entered(top, height); }
            tracks: PlaybackSubtitleState.secondary-subtitle-tracks;
            observed-index: PlaybackSubtitleState.secondary-subtitle-track-selected-index;
            hint: "Secondary subtitle tracks"; label-prefix: "Secondary subtitle: ";
            focus-accent-color: root.interactive-accent-color; track-kind: 5;
            dark-theme: root.dark-theme; enabled: root.loaded;
            accent-color: root.platform-windows ? root.windows-accent-color : Theme.sidebar-catalog-accent;
            card-fill: root.sidebar-card-material-fill;
            card-edge: Theme.sidebar-card-border(root.dark-theme);
            selected(kind, token) => { root.track-selected(kind, token); } }
    }
    Rectangle {
        width: root.sidebar-width - (root.compact-ui ? 30px : 36px);
        height: 48px; border-radius: 8px; border-width: 1px;
        border-color: Theme.sidebar-card-border(root.dark-theme);
        background: root.sidebar-card-material-fill;
        HorizontalLayout { padding: 8px; spacing: 8px;
            Rectangle { horizontal-stretch: 1; height: 30px; border-radius: 4px;
                background: root.sidebar-control-material-fill;
                accessible-role: button; accessible-label: "Load subtitle";
                accessible-enabled: root.loaded;
                accessible-action-default => { if root.loaded { root.load-subtitle(); } }
                Text { text: "Load Subtitle…";
                    color: Theme.sidebar-action-text(root.dark-theme, root.loaded);
                    font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                if subtitle-load-focus.has-focus : Rectangle { border-width: 1px;
                    border-color: root.interactive-accent-color; border-radius: 4px; background: transparent; }
                TouchArea { enabled: root.loaded;
                    clicked => { subtitle-load-focus.focus(); root.load-subtitle(); } }
                subtitle-load-focus := FocusScope {
                    focus-changed-event => {
                        if self.has-focus { root.focus-entered(parent.absolute-position.y, parent.height); }
                    }
                    focus-on-click: false;
                    enabled: root.loaded;
                    key-pressed(event) => {
                        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                        if event.text == Key.Return || event.text == " " { root.load-subtitle(); return accept; }
                        return reject;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; height: 30px; border-radius: 4px;
                background: root.sidebar-control-material-fill;
                accessible-role: button; accessible-label: "Search online subtitles";
                accessible-enabled: root.loaded;
                accessible-action-default => { if root.loaded { root.find-online-subtitles(); } }
                Text { text: "Search Online…";
                    color: Theme.sidebar-action-text(root.dark-theme, root.loaded);
                    font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                if online-subtitle-focus.has-focus : Rectangle { border-width: 1px;
                    border-color: root.interactive-accent-color; border-radius: 4px; background: transparent; }
                TouchArea { enabled: root.loaded;
                    clicked => { online-subtitle-focus.focus(); root.find-online-subtitles(); } }
                online-subtitle-focus := FocusScope {
                    focus-changed-event => {
                        if self.has-focus { root.focus-entered(parent.absolute-position.y, parent.height); }
                    }
                    focus-on-click: false;
                    enabled: root.loaded;
                    key-pressed(event) => {
                        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                        if event.text == Key.Return || event.text == " " { root.find-online-subtitles(); return accept; }
                        return reject;
                    }
                }
            }
        }
    }
    Rectangle {
        width: root.sidebar-width - (root.compact-ui ? 28px : 32px);
        height: 190px; border-radius: 8px; border-width: 1px;
        border-color: Theme.sidebar-card-border(root.dark-theme);
        background: root.sidebar-card-material-fill;
        VerticalLayout { padding: 8px; spacing: 8px;
            Rectangle { height: 28px; border-radius: 5px;
                background: Theme.sidebar-delay-target-surface(root.dark-theme);
                HorizontalLayout { padding: 2px; spacing: 1px;
                    primary-lane := SubtitleLaneSegment { focus-accent-color: root.interactive-accent-color;
                        label: "Primary"; hint: "Edit primary subtitle timing and position";
                        focus-entered(top, height) => { root.focus-entered(top, height); }
                        selected: !PlaybackSubtitleState.edit-secondary-subtitle;
                        dark-theme: root.dark-theme;
                        windows-acrylic-surface: root.windows-sidebar-material-active;
                        accent-color: root.platform-windows ? root.windows-accent-color : Theme.sidebar-catalog-accent;
                        accent-foreground: root.windows-accent-foreground;
                        activated => { root.select-delay-lane(false); }
                        navigate(secondary) => { root.focus-delay-lane(secondary); } }
                    secondary-lane := SubtitleLaneSegment { focus-accent-color: root.interactive-accent-color;
                        label: "Secondary"; hint: "Edit secondary subtitle timing and position";
                        focus-entered(top, height) => { root.focus-entered(top, height); }
                        selected: PlaybackSubtitleState.edit-secondary-subtitle;
                        dark-theme: root.dark-theme;
                        windows-acrylic-surface: root.windows-sidebar-material-active;
                        accent-color: root.platform-windows ? root.windows-accent-color : Theme.sidebar-catalog-accent;
                        accent-foreground: root.windows-accent-foreground;
                        activated => { root.select-delay-lane(true); }
                        navigate(secondary) => { root.focus-delay-lane(secondary); } }
                }
            }
            HorizontalLayout { height: 20px; spacing: 8px;
                Image { source: @image-url("../../../assets/icons/resume-history.svg");
                    width: 14px; height: 14px; colorize: Theme.sidebar-delay-icon(root.dark-theme); }
                Text { text: "Delay"; color: Theme.sidebar-detail-text(root.dark-theme);
                    font-size: 11px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Tool { accent-color: root.interactive-accent-color; dark-theme: root.dark-theme; label: "↺";
                    focus-entered(top, height) => { root.focus-entered(top, height); }
                    hint: root.secondary ? "Reset secondary subtitle delay" : "Reset subtitle delay";
                    visible: root.delay-enabled && root.selected-delay != 0;
                    enabled: self.visible;
                    windows-acrylic-surface: root.windows-sidebar-material-active;
                    activated => {
                        if root.secondary { root.set-delay(DelayLane.secondary-subtitle, 0); }
                        else { root.reset-subtitle-delay(); }
                    } }
            }
            delay-editor := QuickSettingsDelayEditor {
                lane: root.secondary ? DelayLane.secondary-subtitle : DelayLane.primary-subtitle;
                label: root.secondary ? "Secondary subtitle delay" : "Subtitle delay";
                delay: root.selected-delay;
                delay-text: root.secondary
                    ? PlaybackSubtitleState.secondary-subtitle-delay-text : PlaybackSubtitleState.subtitle-delay-text;
                enabled: root.delay-enabled;
                accent-color: root.interactive-accent-color;
                dark-theme: root.dark-theme;
                windows-acrylic-surface: root.windows-sidebar-material-active;
                format-preview(value) => { return root.format-delay-preview(value); }
                focus-entered(top, height) => { root.focus-entered(top, height); }
                set-delay(lane, value) => { root.set-delay(lane, value); }
                set-delay-text(lane, text) => { return root.set-delay-text(lane, text); }
                editing-finished => { root.restore-player-focus(); }
            }
            HorizontalLayout { height: 14px; spacing: 8px;
                HorizontalLayout { horizontal-stretch: 1;
                    Text { width: 32px; text: "-5s"; color: Theme.sidebar-secondary-text(root.dark-theme); font-size: 10px; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { width: 32px; text: "0s"; color: Theme.sidebar-secondary-text(root.dark-theme);
                        font-size: 10px; horizontal-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { width: 32px; text: "+5s"; color: Theme.sidebar-secondary-text(root.dark-theme);
                        font-size: 10px; horizontal-alignment: right; }
                }
                Rectangle { width: 50px; background: transparent; }
            }
            HorizontalLayout { height: 16px; spacing: 6px;
                Text { text: "↕"; color: Theme.sidebar-detail-text(root.dark-theme); font-size: 12px; }
                Text { text: "Position"; color: Theme.sidebar-detail-text(root.dark-theme);
                    font-size: 11px; vertical-alignment: center; }
            }
            // IINA exposes a 0–100 slider even when mpv accepts larger values.
            PlayerSlider { dark-theme: root.dark-theme; minimum: 0; maximum: 100; step: 1;
                focus-entered(top, height) => { root.focus-entered(top, height); }
                value: PlaybackSubtitleState.edit-secondary-subtitle ? PlaybackSubtitleState.secondary-subtitle-position : PlaybackSubtitleState.subtitle-position;
                enabled: root.loaded && (PlaybackSubtitleState.edit-secondary-subtitle
                ? PlaybackSubtitleState.secondary-subtitle-position-known : PlaybackSubtitleState.subtitle-position-known);
                hint: PlaybackSubtitleState.edit-secondary-subtitle ? "Secondary subtitle position" : "Subtitle position";
                changed(value) => { root.set-subtitle-position(PlaybackSubtitleState.edit-secondary-subtitle, round(value)); } }
        }
    }
    if PlaybackSubtitleState.subtitle-text-style-available : Rectangle {
        width: root.sidebar-width - (root.compact-ui ? 28px : 32px);
        height: 200px; border-radius: 8px; border-width: 1px;
        border-color: Theme.sidebar-card-border(root.dark-theme);
        background: root.sidebar-card-material-fill;
        VerticalLayout { padding: 8px; spacing: 8px;
            HorizontalLayout { height: 30px; spacing: 8px;
                Text { text: "Scale"; color: Theme.sidebar-heading-text(root.dark-theme);
                    font-size: 12px; font-weight: 700; vertical-alignment: center; }
                PlayerSlider { dark-theme: root.dark-theme; minimum: -5; maximum: 5; step: 0.05; value: PlaybackSubtitleState.subtitle-scale-slider;
                    focus-entered(top, height) => { root.focus-entered(top, height); }
                    enabled: root.loaded && PlaybackSubtitleState.subtitle-scale-known; hint: "Subtitle text scale";
                    changed(value) => { root.set-subtitle-scale-slider(value); } }
                Tool { accent-color: root.interactive-accent-color; dark-theme: root.dark-theme; label: "↺"; hint: "Reset subtitle text scale";
                    focus-entered(top, height) => { root.focus-entered(top, height); }
                    enabled: root.loaded && PlaybackSubtitleState.subtitle-scale-known;
                    activated => { root.set-subtitle-scale-slider(0); } }
            }
            HorizontalLayout { height: 30px; spacing: 8px;
                Text { text: "Font"; color: Theme.sidebar-heading-text(root.dark-theme);
                    font-size: 12px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Tool { accent-color: root.interactive-accent-color; dark-theme: root.dark-theme;
                    width: clamp(parent.width - 110px, 0px, 140px);
                    label: PlaybackSubtitleState.subtitle-font; hint: "Choose subtitle font";
                    elide-label: true;
                    focus-entered(top, height) => { root.focus-entered(top, height); }
                    enabled: root.loaded && PlaybackSubtitleState.subtitle-font-known;
                    activated => { root.choose-subtitle-font(); } }
                SubtitleSizePicker {
                    focus-entered(x, top, width, height) => { root.focus-entered(top, height); }
                    presets: ["25", "30", "35", "40", "45", "50", "55", "60", "65", "70", "75"];
                    observed-value: PlaybackSubtitleState.subtitle-font-size;
                    value-known: PlaybackSubtitleState.subtitle-font-size-known;
                    enabled: root.loaded && PlaybackSubtitleState.subtitle-font-size-known;
                    hint: "Subtitle font size";
                    dark-theme: root.dark-theme;
                    focus-accent-color: root.interactive-accent-color;
                    windows-acrylic-surface: root.windows-sidebar-material-active;
                    selected(value) => { root.set-subtitle-font-size(value); }
                }
            }
            HorizontalLayout { height: 30px; spacing: 8px;
                Text { text: "Color"; color: Theme.sidebar-heading-text(root.dark-theme);
                    font-size: 12px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SubtitleColorWell { observed-color: PlaybackSubtitleState.subtitle-text-color; hint: "Subtitle text color";
                    focus-entered(top, height) => { root.focus-entered(top, height); }
                    enabled: root.loaded && PlaybackSubtitleState.subtitle-text-color-known;
                    edited(value) => { root.set-subtitle-color(1, value); } }
            }
            HorizontalLayout { height: 30px; spacing: 8px;
                Text { text: "Border"; color: Theme.sidebar-heading-text(root.dark-theme);
                    font-size: 12px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SubtitleSizePicker {
                    focus-entered(x, top, width, height) => { root.focus-entered(top, height); }
                    presets: ["0", "0.25", "0.5", "1", "1.5", "2", "2.5", "3", "4", "5"];
                    observed-value: PlaybackSubtitleState.subtitle-outline-size;
                    value-known: PlaybackSubtitleState.subtitle-outline-size-known;
                    enabled: root.loaded && PlaybackSubtitleState.subtitle-outline-size-known;
                    hint: "Subtitle outline width";
                    dark-theme: root.dark-theme;
                    focus-accent-color: root.interactive-accent-color;
                    windows-acrylic-surface: root.windows-sidebar-material-active;
                    selected(value) => { root.set-subtitle-outline-size(value); }
                }
                SubtitleColorWell { observed-color: PlaybackSubtitleState.subtitle-border-color; hint: "Subtitle border color";
                    focus-entered(top, height) => { root.focus-entered(top, height); }
                    enabled: root.loaded && PlaybackSubtitleState.subtitle-border-color-known;
                    edited(value) => { root.set-subtitle-color(3, value); } }
            }
            HorizontalLayout { height: 30px; spacing: 8px;
                Text { text: "Shadow"; color: Theme.sidebar-heading-text(root.dark-theme);
                    font-size: 12px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SubtitleColorWell { observed-color: PlaybackSubtitleState.subtitle-shadow-color; hint: "Subtitle shadow color";
                    focus-entered(top, height) => { root.focus-entered(top, height); }
                    enabled: root.loaded && PlaybackSubtitleState.subtitle-shadow-color-known;
                    edited(value) => { root.set-subtitle-color(2, value); } }
            }
        }
    }
    if !PlaybackSubtitleState.subtitle-text-style-available : Text {
        text: "Some settings are not available for this subtitle type.";
        wrap: word-wrap; color: Theme.sidebar-detail-text(root.dark-theme); font-size: 11px;
    }
    if PlaybackSubtitleState.subtitle-ass-style-warning : Text {
        text: "Setting style options for ASS subtitles may break rendering.";
        wrap: word-wrap; color: Theme.sidebar-detail-text(root.dark-theme); font-size: 11px;
    }
}
