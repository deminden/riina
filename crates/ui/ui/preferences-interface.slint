import { MediaSettingsText } from "media-settings-text.slint";
import { PreferenceSwitch, PreferenceActionButton, ToolbarPreferenceRow, PreferenceNumericInput, PreferenceChoiceRow, PreferenceRadioRow, PreferenceToggle, PreferenceDisclosure, PreferenceDetailRow } from "preferences-controls.slint";
import { Theme } from "theme.slint";
import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";

export component InterfacePreferencesPage inherits ScrollView {
    in property <length> interface-content-height;
    in-out property <length> interface-scroll-position;
    in property <length> interface-appearance-threshold;
    in-out property <int> selected-interface-section;
    in property <length> interface-window-threshold;
    in property <length> interface-osc-threshold;
    in property <length> interface-osd-threshold;
    in property <length> interface-thumbnail-threshold;
    in property <length> interface-pip-threshold;
    in property <bool> mica-backdrop-enabled;
    in property <length> interface-appearance-card-y;
    in property <length> interface-appearance-card-height;
    in-out property <int> appearance-index;
    callback settings-changed();
    in property <string> surface-material-title;
    in-out property <bool> liquid-glass-expanded;
    in-out property <bool> liquid-glass-osd;
    in-out property <bool> liquid-glass-osc;
    in-out property <bool> liquid-glass-sidebar;
    in property <length> liquid-glass-detail-height;
    in-out property <bool> compact-ui;
    in property <length> interface-window-title-y;
    in property <length> interface-window-y;
    in property <length> interface-window-card-height;
    in-out property <bool> initial-window-size-enabled;
    in-out property <int> initial-window-size-axis-index;
    in-out property <string> initial-window-size-value-text;
    in-out property <int> initial-window-size-unit-index;
    in property <length> initial-window-size-detail-height;
    in-out property <bool> initial-window-position-enabled;
    in-out property <string> initial-window-x-offset-text;
    in-out property <int> initial-window-x-unit-index;
    in-out property <int> initial-window-x-anchor-index;
    in-out property <string> initial-window-y-offset-text;
    in-out property <int> initial-window-y-unit-index;
    in-out property <int> initial-window-y-anchor-index;
    in property <length> interface-resize-y;
    in-out property <int> window-resize-option-index;
    in-out property <int> window-resize-timing-index;
    in property <length> interface-physical-resolution-y;
    in-out property <bool> use-physical-resolution;
    in property <length> interface-float-y;
    in-out property <bool> always-float-on-top;
    in-out property <bool> always-show-on-top-icon;
    in property <length> interface-osc-y;
    in property <length> interface-osc-card-height;
    in-out property <int> osc-position;
    in-out property <bool> docked-controls;
    in property <bool> edge-to-edge-video;
    in-out property <bool> show-chapter-pos;
    in-out property <bool> control-auto-hide-enabled;
    in-out property <string> control-auto-hide-timeout-text;
    in-out property <bool> control-disable-play-slider-scrolling;
    in-out property <bool> control-disable-volume-slider-scrolling;
    callback toolbar-reset();
    in property <[int]> toolbar-order;
    in-out property <int> toolbar-drag-index;
    in-out property <int> toolbar-drop-index;
    in-out property <length> toolbar-drag-start-y;
    in-out property <bool> toolbar-drag-active;
    in-out property <bool> toolbar-show-quick-settings;
    in-out property <bool> toolbar-show-playlist;
    in-out property <bool> toolbar-show-pip;
    in-out property <bool> toolbar-show-fullscreen;
    in-out property <bool> toolbar-show-music-mode;
    in-out property <bool> toolbar-show-subtitle-track;
    in-out property <bool> toolbar-show-screenshot;
    in-out property <bool> toolbar-show-plugins;
    in-out property <bool> toolbar-show-live-text;
    callback toolbar-move(int, int);
    callback toolbar-drag-finished();
    in property <length> interface-osd-y;
    in property <length> osd-suppression-detail-height;
    in property <length> osd-settings-height;
    in-out property <bool> osd-enabled;
    in-out property <bool> osd-suppression-expanded;
    in-out property <bool> disable-osd-file-start;
    in-out property <bool> disable-osd-pause-resume;
    in-out property <bool> disable-osd-seek;
    in-out property <bool> disable-osd-speed;
    in-out property <string> osd-timeout-text;
    in-out property <string> osd-text-size-text;
    in-out property <bool> display-time-and-battery-in-fullscreen;
    in property <length> interface-pip-y;
    in property <length> interface-pip-card-height;
    in-out property <int> pip-window-behavior-index;
    in-out property <bool> pip-pause-when-entering;
    in-out property <bool> pip-toggle-by-minimizing;
    in-out property <bool> pip-minimize-toggle-video-only;
    in property <length> interface-thumbnail-y;
    in-out property <bool> thumbnail-preview-enabled;
    in-out property <string> thumbnail-cache-size-text;
    in-out property <bool> thumbnail-remote-enabled;
    in-out property <string> thumbnail-width-text;
    in property <length> interface-accessibility-y;
    in-out property <bool> disable-animations;

    content-height: root.interface-content-height;
    content-width: self.visible-width;
    content-y <=> root.interface-scroll-position;
    horizontal-scrollbar-policy: always-off;
    scrolled => {
        if root.interface-scroll-position > root.interface-appearance-threshold { root.selected-interface-section = 0; }
        else if root.interface-scroll-position > root.interface-window-threshold { root.selected-interface-section = 1; }
        else if root.interface-scroll-position > root.interface-osc-threshold { root.selected-interface-section = 2; }
        else if root.interface-scroll-position > root.interface-osd-threshold { root.selected-interface-section = 3; }
        else if root.interface-scroll-position > root.interface-thumbnail-threshold { root.selected-interface-section = 4; }
        else if root.interface-scroll-position > root.interface-pip-threshold { root.selected-interface-section = 5; }
        else { root.selected-interface-section = 6; }
    }
    Rectangle { width: parent.width; height: root.interface-content-height;
        background: Theme.settings-content-surface(root.mica-backdrop-enabled);
    Text { x: 28px; y: 16px; text: @tr("Interface"); font-size: Theme.settings-page-title-size; font-weight: 600; color: Theme.settings-page-heading; }
    Text { x: 28px; y: 52px; text: @tr("Appearance");
        font-size: 13px; font-weight: 600; color: Theme.settings-general-section-heading; }
    Rectangle { x: 20px; y: root.interface-appearance-card-y;
        width: parent.width - 40px; height: root.interface-appearance-card-height;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        Text { x: 36px; y: 8px; text: @tr("Appearance");
            font-size: 12px; color: Theme.settings-page-heading; vertical-alignment: center; }
        ComboBox { x: 160px; y: 4px; width: 190px; height: 24px;
            model: [@tr("Dark"), @tr("Light"), @tr("Match System Appearance")];
            current-index <=> root.appearance-index;
            selected => { root.settings-changed(); }
        }
        PreferenceDetailRow { x: 36px; y: 44px; width: parent.width - 60px;
            label: MediaSettingsText.material-caption(root.surface-material-title); expanded: root.liquid-glass-expanded;
            toggled => { root.liquid-glass-expanded = !root.liquid-glass-expanded; }
        }
        if root.liquid-glass-expanded : VerticalLayout {
            x: 52px; y: 80px; width: parent.width - 68px; height: 84px; spacing: 0px;
            PreferenceSwitch { height: 28px; label: @tr("On-Screen Display");
                checked <=> root.liquid-glass-osd;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { height: 28px; label: @tr("On-Screen Controller");
                checked <=> root.liquid-glass-osc;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { height: 28px; label: @tr("Sidebar");
                checked <=> root.liquid-glass-sidebar;
                toggled => { root.settings-changed(); }
            }
        }
        PreferenceSwitch { x: 36px; y: 84px + root.liquid-glass-detail-height;
            width: parent.width - 48px; label: @tr("Compact Interface");
            checked <=> root.compact-ui;
            toggled => { root.settings-changed(); }
        }
    }
    Text { x: 28px; y: root.interface-window-title-y; text: @tr("Window");
        font-size: 13px; font-weight: 600; color: Theme.settings-general-section-heading; }
    Rectangle { x: 20px; y: root.interface-window-y; width: parent.width - 40px; height: root.interface-window-card-height;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        PreferenceToggle { x: 24px; y: 4px; width: parent.width - 48px;
            label: @tr("Initial window size"); checked <=> root.initial-window-size-enabled;
            toggled => { root.settings-changed(); }
        }
        if root.initial-window-size-enabled : Rectangle {
            x: 32px; y: 42px; width: parent.width - 64px; height: 26px; background: transparent;
            ComboBox { x: 0; y: 1px; width: 92px; height: 23px;
                model: [@tr("Width"), @tr("Height")];
                current-index <=> root.initial-window-size-axis-index;
                selected => { root.settings-changed(); }
            }
            Rectangle { x: 100px; y: 1px; width: 82px; height: 23px;
                border-width: 1px; border-color: Theme.settings-field-border; border-radius: Theme.settings-text-field-corner; background: Theme.settings-field-surface;
                TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                    text <=> root.initial-window-size-value-text; font-size: 11px; color: Theme.settings-page-heading;
                    accepted => { root.settings-changed(); }
                }
            }
            ComboBox { x: 190px; y: 1px; width: 116px; height: 23px;
                model: [@tr("point"), @tr("% of screen")];
                current-index <=> root.initial-window-size-unit-index;
                selected => { root.settings-changed(); }
            }
        }
        PreferenceToggle { x: 24px; y: 44px + root.initial-window-size-detail-height;
            width: parent.width - 48px; label: @tr("Initial window position");
            checked <=> root.initial-window-position-enabled;
            toggled => { root.settings-changed(); }
        }
        if root.initial-window-position-enabled : Rectangle {
            x: 32px; y: 80px + root.initial-window-size-detail-height;
            width: parent.width - 64px; height: 96px; background: transparent;
            Text { x: 0; y: 0; width: 60px; height: 23px; text: @tr("X Offset:");
                font-size: 11px; color: Theme.settings-control-label; vertical-alignment: center; }
            Rectangle { x: 62px; y: 0; width: 56px; height: 23px;
                border-width: 1px; border-color: Theme.settings-field-border; border-radius: Theme.settings-text-field-corner; background: Theme.settings-field-surface;
                TextInput { x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
                    text <=> root.initial-window-x-offset-text; font-size: 11px; color: Theme.settings-page-heading;
                    accepted => { root.settings-changed(); }
                }
            }
            ComboBox { x: 122px; y: 0; width: 94px; height: 23px;
                model: [@tr("point"), @tr("% of screen")];
                current-index <=> root.initial-window-x-unit-index;
                selected => { root.settings-changed(); }
            }
            Text { x: 16px; y: 24px; width: 34px; height: 23px; text: @tr("to the");
                font-size: 11px; color: Theme.settings-control-label; vertical-alignment: center; }
            ComboBox { x: 52px; y: 24px; width: 84px; height: 23px;
                model: [@tr("left"), @tr("right")];
                current-index <=> root.initial-window-x-anchor-index;
                selected => { root.settings-changed(); }
            }
            Text { x: 140px; y: 24px; width: 92px; height: 23px; text: @tr("side of screen");
                font-size: 11px; color: Theme.settings-control-label; vertical-alignment: center; }
            Text { x: 0; y: 48px; width: 60px; height: 23px; text: @tr("Y Offset:");
                font-size: 11px; color: Theme.settings-control-label; vertical-alignment: center; }
            Rectangle { x: 62px; y: 48px; width: 56px; height: 23px;
                border-width: 1px; border-color: Theme.settings-field-border; border-radius: Theme.settings-text-field-corner; background: Theme.settings-field-surface;
                TextInput { x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
                    text <=> root.initial-window-y-offset-text; font-size: 11px; color: Theme.settings-page-heading;
                    accepted => { root.settings-changed(); }
                }
            }
            ComboBox { x: 122px; y: 48px; width: 94px; height: 23px;
                model: [@tr("point"), @tr("% of screen")];
                current-index <=> root.initial-window-y-unit-index;
                selected => { root.settings-changed(); }
            }
            Text { x: 16px; y: 72px; width: 34px; height: 23px; text: @tr("to the");
                font-size: 11px; color: Theme.settings-control-label; vertical-alignment: center; }
            ComboBox { x: 52px; y: 72px; width: 84px; height: 23px;
                model: [@tr("bottom"), @tr("top")];
                current-index <=> root.initial-window-y-anchor-index;
                selected => { root.settings-changed(); }
            }
            Text { x: 140px; y: 72px; width: 92px; height: 23px; text: @tr("side of screen");
                font-size: 11px; color: Theme.settings-control-label; vertical-alignment: center; }
        }
    }
    Rectangle { x: 20px; y: root.interface-resize-y; width: parent.width - 40px; height: 118px;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        Text { x: 36px; y: 7px; width: 150px; height: 24px; text: @tr("Resize window to:");
            font-size: 12px; color: Theme.settings-page-heading; vertical-alignment: center; }
        ComboBox { x: 232px; y: 4px; width: parent.width - 252px; height: 24px;
            model: [@tr("Fit Screen"), @tr("0.5x Video Size"), @tr("1x Video Size"), @tr("1.5x Video Size"), @tr("2x Video Size")];
            current-index <=> root.window-resize-option-index;
            selected => { root.settings-changed(); }
        }
        PreferenceRadioRow { x: 28px; y: 40px; width: parent.width - 48px;
            label: @tr("Always when playing a new file"); checked: root.window-resize-timing-index == 0;
            activated => { root.window-resize-timing-index = 0; root.settings-changed(); }
        }
        PreferenceRadioRow { x: 28px; y: 64px; width: parent.width - 48px;
            label: @tr("When media is opened manually"); checked: root.window-resize-timing-index == 1;
            activated => { root.window-resize-timing-index = 1; root.settings-changed(); }
        }
        PreferenceRadioRow { x: 28px; y: 88px; width: parent.width - 48px;
            label: @tr("Do not resize"); checked: root.window-resize-timing-index == 2;
            activated => { root.window-resize-timing-index = 2; root.settings-changed(); }
        }
    }
    Rectangle { x: 20px; y: root.interface-physical-resolution-y; width: parent.width - 40px; height: 40px;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        PreferenceSwitch { x: 36px; y: 6px; width: parent.width - 48px; label: @tr("Use physical resolution on Retina displays");
            checked <=> root.use-physical-resolution;
            toggled => { root.settings-changed(); }
        }
    }
    Rectangle { x: 20px; y: root.interface-float-y; width: parent.width - 40px; height: 80px;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        PreferenceSwitch { x: 36px; y: 4px; width: parent.width - 48px; label: @tr("Always float on top");
            checked <=> root.always-float-on-top;
            toggled => { root.settings-changed(); }
        }
        PreferenceSwitch { x: 36px; y: 44px; width: parent.width - 48px; label: @tr("Always show float on top status in the title bar");
            checked <=> root.always-show-on-top-icon;
            toggled => { root.settings-changed(); }
        }
    }
    Rectangle { x: 20px; y: root.interface-osc-y; width: parent.width - 40px; height: root.interface-osc-card-height;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        Text { x: 0; y: 8px; text: @tr("On-Screen Controller:");
            font-weight: 600; font-size: 13px; color: Theme.settings-page-heading; }
        ComboBox { x: 160px; y: 4px; width: 150px; height: 24px;
            model: [@tr("Floating"), @tr("Top"), @tr("Bottom")];
            current-index <=> root.osc-position;
            selected => { root.settings-changed(); }
        }
        CheckBox { x: 160px; y: 42px; height: 24px; text: @tr("Dock control bar and titlebar");
            checked <=> root.docked-controls;
            enabled: !root.edge-to-edge-video;
            toggled => { root.settings-changed(); }
        }
        PreferenceSwitch { x: 36px; y: 82px; width: parent.width - 48px;
            label: @tr("Show chapter position in progress bar");
            checked <=> root.show-chapter-pos;
            toggled => { root.settings-changed(); }
        }
        PreferenceSwitch { x: 36px; y: 116px; width: 128px;
            label: @tr("Auto hide after:");
            checked <=> root.control-auto-hide-enabled;
            toggled => { root.settings-changed(); }
        }
        Rectangle { x: 170px; y: 118px; width: 70px; height: 24px;
            border-width: 1px; border-color: Theme.settings-field-border; border-radius: Theme.settings-text-field-corner; background: Theme.settings-field-surface;
            TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                text <=> root.control-auto-hide-timeout-text; enabled: root.control-auto-hide-enabled;
                font-size: 11px; color: Theme.settings-page-heading;
                accepted => { root.settings-changed(); }
            }
        }
        Text { x: 244px; y: 118px; width: 20px; height: 24px; text: "s";
            font-size: 11px; color: Theme.settings-interface-unit-text(root.control-auto-hide-enabled);
            vertical-alignment: center; }
        PreferenceSwitch { x: 36px; y: 150px; width: parent.width - 48px;
            label: @tr("Prevent scroll wheel from changing playback position");
            checked <=> root.control-disable-play-slider-scrolling;
            toggled => { root.settings-changed(); }
        }
        PreferenceSwitch { x: 36px; y: 186px; width: parent.width - 48px;
            label: @tr("Prevent scroll wheel from changing volume");
            checked <=> root.control-disable-volume-slider-scrolling;
            toggled => { root.settings-changed(); }
        }
        Text { x: 36px; y: 218px; text: @tr("Toolbar buttons");
            font-size: 12px; font-weight: 600; color: Theme.settings-page-heading; }
        PreferenceActionButton { x: parent.width - 112px; y: 214px;
            label: @tr("Restore Default");
            activated => { root.toolbar-reset(); }
        }
        for action-kind[index] in root.toolbar-order : ToolbarPreferenceRow {
            x: 36px; y: 238px + index * 28px; width: parent.width - 72px;
            label: action-kind == 0 ? @tr("Quick Settings") :
                action-kind == 1 ? @tr("Playlist and chapters") :
                action-kind == 2 ? @tr("Picture in Picture") :
                action-kind == 3 ? @tr("Full Screen") :
                action-kind == 4 ? @tr("Music Mode") :
                action-kind == 5 ? @tr("Subtitle Track") :
                action-kind == 6 ? @tr("Screenshot") :
                action-kind == 7 ? @tr("Plugins") : @tr("Live Text");
            position: index; count: root.toolbar-order.length;
            drag-index: root.toolbar-drag-index;
            drop-index: root.toolbar-drop-index;
            drag-start-y: root.toolbar-drag-start-y;
            drag-active: root.toolbar-drag-active;
            checked: action-kind == 0 ? root.toolbar-show-quick-settings :
                action-kind == 1 ? root.toolbar-show-playlist :
                action-kind == 2 ? root.toolbar-show-pip :
                action-kind == 3 ? root.toolbar-show-fullscreen :
                action-kind == 4 ? root.toolbar-show-music-mode :
                action-kind == 5 ? root.toolbar-show-subtitle-track :
                action-kind == 6 ? root.toolbar-show-screenshot :
                action-kind == 7 ? root.toolbar-show-plugins : root.toolbar-show-live-text;
            toggled(value) => {
                if action-kind == 0 { root.toolbar-show-quick-settings = value; }
                else if action-kind == 1 { root.toolbar-show-playlist = value; }
                else if action-kind == 2 { root.toolbar-show-pip = value; }
                else if action-kind == 3 { root.toolbar-show-fullscreen = value; }
                else if action-kind == 4 { root.toolbar-show-music-mode = value; }
                else if action-kind == 5 { root.toolbar-show-subtitle-track = value; }
                else if action-kind == 6 { root.toolbar-show-screenshot = value; }
                else if action-kind == 7 { root.toolbar-show-plugins = value; }
                else { root.toolbar-show-live-text = value; }
                root.settings-changed();
            }
            move-requested(position, destination) => { root.toolbar-move(position, destination); }
            drag-started(position, start-y) => {
                root.toolbar-drag-index = position;
                root.toolbar-drop-index = position;
                root.toolbar-drag-start-y = start-y;
                root.toolbar-drag-active = false;
            }
            drag-target-changed(destination) => {
                root.toolbar-drag-active = true;
                root.toolbar-drop-index = destination;
            }
            drag-finished => {
                root.toolbar-drag-finished();
                root.toolbar-drag-index = -1;
                root.toolbar-drop-index = -1;
                root.toolbar-drag-active = false;
            }
        }
    }
    Rectangle { x: 20px; y: root.interface-osd-y; width: parent.width - 40px;
        height: 92px + root.osd-suppression-detail-height;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        PreferenceSwitch { x: 36px; y: 4px; width: parent.width - 48px; label: @tr("Enable OSD");
            checked <=> root.osd-enabled;
            toggled => { root.settings-changed(); }
        }
        PreferenceDisclosure { x: 36px; y: 40px; label: @tr("Suppress messages for:");
            expanded: root.osd-suppression-expanded;
            toggled => { root.osd-suppression-expanded = !root.osd-suppression-expanded; }
        }
        if root.osd-suppression-expanded : VerticalLayout {
            x: 52px; y: 64px; width: parent.width - 68px; height: 108px; spacing: 0px;
            PreferenceSwitch { height: 27px; label: @tr("File start");
                checked <=> root.disable-osd-file-start;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { height: 27px; label: @tr("Pause / Resume");
                checked <=> root.disable-osd-pause-resume;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { height: 27px; label: @tr("Seek");
                checked <=> root.disable-osd-seek;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { height: 27px; label: @tr("Speed");
                checked <=> root.disable-osd-speed;
                toggled => { root.settings-changed(); }
            }
        }
    }
    Rectangle { x: 20px; y: root.interface-osd-y + 108px + root.osd-suppression-detail-height;
        width: parent.width - 40px; height: root.osd-settings-height;
        private property <bool> stacked-status: root.osd-settings-height > 112px;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        Text { x: 36px; y: 4px; text: @tr("On-Screen Display");
            font-size: 12px; color: Theme.settings-page-heading; vertical-alignment: center; }
        Text { x: 36px; y: 39px; width: 132px; height: 24px; text: @tr("Auto hide after:");
            font-size: 12px; color: Theme.settings-page-heading; vertical-alignment: center; }
        Rectangle { x: 170px; y: 39px; width: 70px; height: 24px;
            border-width: 1px; border-color: Theme.settings-field-border; border-radius: Theme.settings-text-field-corner; background: Theme.settings-field-surface;
            TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                text <=> root.osd-timeout-text; font-size: 11px; color: Theme.settings-page-heading;
                accepted => { root.settings-changed(); }
            }
        }
        Text { x: 244px; y: 39px; width: 20px; height: 24px; text: "s";
            font-size: 11px; color: Theme.settings-interface-unit-text(true); vertical-alignment: center; }
        Text { x: 36px; y: 68px; width: 132px; height: 24px; text: @tr("Text size:");
            font-size: 12px; color: Theme.settings-page-heading; vertical-alignment: center; }
        Rectangle { x: 170px; y: 68px; width: 70px; height: 24px;
            border-width: 1px; border-color: Theme.settings-field-border; border-radius: Theme.settings-text-field-corner; background: Theme.settings-field-surface;
            TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                text <=> root.osd-text-size-text; font-size: 11px; color: Theme.settings-page-heading;
                accepted => { root.settings-changed(); }
            }
        }
        Text { x: 244px; y: 68px; width: 24px; height: 24px; text: "pt";
            font-size: 11px; color: Theme.settings-interface-unit-text(true); vertical-alignment: center; }
        PreferenceSwitch { x: parent.stacked-status ? 36px : 270px;
            y: parent.stacked-status ? 100px : 67px;
            width: parent.width - self.x - 12px;
            label: @tr("Time and battery in full screen");
            checked <=> root.display-time-and-battery-in-fullscreen;
            toggled => { root.settings-changed(); }
        }
    }
    Text { x: 28px; y: root.interface-pip-y; text: @tr("Picture-in-Picture");
        font-size: 13px; font-weight: 600; color: Theme.settings-section-heading; }
    Rectangle {
        x: 20px; y: root.interface-pip-y + 28px; width: parent.width - 40px;
        height: root.interface-pip-card-height;
        border-width: 1px; border-color: Theme.settings-input-card-border; border-radius: 10px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        VerticalLayout { x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px; spacing: 0px;
            PreferenceChoiceRow { width: parent.width; label: @tr("Window after entering");
                options: [@tr("Do nothing"), @tr("Hide"), @tr("Minimize")];
                selected-index <=> root.pip-window-behavior-index;
                selected => { root.settings-changed(); }
            }
            PreferenceSwitch { width: parent.width; label: @tr("Automatically pause playback");
                checked <=> root.pip-pause-when-entering;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { width: parent.width;
                label: @tr("Toggle Picture-in-Picture by minimizing/un-minimizing the window");
                checked <=> root.pip-toggle-by-minimizing;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { width: parent.width; label: @tr("Only for video files");
                enabled: root.pip-toggle-by-minimizing;
                checked <=> root.pip-minimize-toggle-video-only;
                toggled => { root.settings-changed(); }
            }
        }
    }
    Rectangle {
        x: 20px; y: root.interface-thumbnail-y;
        width: parent.width - 40px; height: 220px;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        Text { x: 0; y: 8px; text: @tr("Thumbnail Preview");
            font-weight: 600; font-size: 13px; color: Theme.settings-page-heading; }
        PreferenceSwitch { x: 16px; y: 36px; width: parent.width - 32px;
            label: @tr("Enable thumbnail preview");
            checked <=> root.thumbnail-preview-enabled;
            toggled => { root.settings-changed(); }
        }
        Text { x: 16px; y: 76px; width: 210px; height: 24px;
            text: @tr("Maximum cache size"); font-size: 12px; color: Theme.settings-control-label;
            vertical-alignment: center; }
        PreferenceNumericInput { x: parent.width - 91px; y: 76px; width: 57px; height: 24px;
            text <=> root.thumbnail-cache-size-text;
            enabled: root.thumbnail-preview-enabled;
            accepted => { root.settings-changed(); }
        }
        Text { x: parent.width - 29px; y: 76px; width: 24px; height: 24px;
            text: "MB"; font-size: 11px; color: Theme.settings-section-heading; vertical-alignment: center; }
        PreferenceSwitch { x: 16px; y: 112px; width: parent.width - 32px;
            label: @tr("Generate previews for files on remote volumes");
            checked <=> root.thumbnail-remote-enabled;
            enabled: root.thumbnail-preview-enabled;
            toggled => { root.settings-changed(); }
        }
        Text { x: 16px; y: 150px; width: 210px; height: 24px;
            text: @tr("Thumbnail width"); font-size: 12px; color: Theme.settings-control-label;
            vertical-alignment: center; }
        PreferenceNumericInput { x: parent.width - 91px; y: 150px; width: 57px; height: 24px;
            text <=> root.thumbnail-width-text;
            enabled: root.thumbnail-preview-enabled;
            accepted => { root.settings-changed(); }
        }
        Text { x: parent.width - 29px; y: 150px; width: 24px; height: 24px;
            text: "pt"; font-size: 11px; color: Theme.settings-section-heading; vertical-alignment: center; }
        Text { x: 16px; y: 182px; width: parent.width - 32px;
            text: @tr("Width is measured in points and applies to generated previews.");
            font-size: 10px; color: Theme.settings-section-heading; }
    }
    Rectangle {
        x: 20px; y: root.interface-accessibility-y;
        width: parent.width - 40px; height: 80px;
        border-width: 1px; border-color: Theme.settings-option-border; border-radius: Theme.settings-card-corner; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        Text { x: 0; y: 8px; text: @tr("Accessibility");
            font-weight: 600; font-size: 13px; color: Theme.settings-page-heading; }
        PreferenceSwitch { x: 16px; y: 29px; width: parent.width - 32px;
            label: @tr("Disable animations"); checked <=> root.disable-animations;
            toggled => { root.settings-changed(); }
        }
        Text { x: 16px; y: 58px; text: @tr("Turn off interface motion.");
            font-size: 10px; color: Theme.settings-section-heading; }
    }
    }
}
