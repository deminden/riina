
export struct PreferencesSearchResult {
    page-index: int,
    page-name: string,
    section-name: string,
    title: string,
    is-header: bool,
    icon: image,
    anchor-y: int,
}

export component PreferenceSearchField inherits Rectangle {
    in-out property <string> query: "";
    in property <int> result-count: 0;
    in property <int> selected-index: -1;
    callback query-changed(string);
    callback move-selection(int);
    callback activate-selection();
    width: 184px;
    height: 34px;
    border-radius: 17px;
    border-width: input.has-focus ? 3px : 1px;
    border-color: input.has-focus ? #168bff : #d2d2d6;
    background: #e6e6e9;

    Image { x: 8px; y: 7px; width: 18px; height: 18px;
        source: @image-url("../../../assets/icons/search.svg"); }
    if root.query.is-empty : Text {
        x: 31px; y: 0px; width: parent.width - 38px; height: parent.height;
        text: "Search"; font-size: 13px; color: #77777d;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 31px; y: 0px; width: parent.width - 38px; height: parent.height;
        text <=> root.query; single-line: true;
        accessible-label: "Search Settings";
        accessible-action-set-value(value) => { self.text = value; }
        key-pressed(event) => {
            if event.text == Key.DownArrow && root.result-count > 0 {
                root.move-selection(1); return accept;
            }
            if event.text == Key.UpArrow && root.result-count > 0 {
                root.move-selection(-1); return accept;
            }
            if event.text == Key.Return && root.selected-index >= 0 {
                root.activate-selection(); return accept;
            }
            return reject;
        }
        changed text => { root.query-changed(self.text); }
        accepted => { root.query-changed(self.text); }
        font-size: 13px; color: #303034; vertical-alignment: center;
    }
}

component PreferenceSearchGroupHeader inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    width: 340px;
    height: 38px;
    accessible-role: none;

    Image { x: 8px; y: 10px; width: 16px; height: 16px; source: root.icon; }
    Text { x: 32px; y: 0px; width: parent.width - 40px; height: parent.height;
        text: root.title; font-size: 13px; font-weight: 700;
        color: #68686e; vertical-alignment: center; }
}

component PreferenceSearchResultRow inherits Rectangle {
    in property <PreferencesSearchResult> result;
    in property <bool> selected: false;
    callback activated(int, string, string, int);
    width: 340px;
    height: 38px;
    background: selected ? #e2e8f2 : touch.has-hover ? #eeeeF3 : transparent;
    accessible-role: button;
    accessible-label: root.result.page-name + " " + root.result.section-name + " " + root.result.title;
    accessible-action-default => {
        root.activated(root.result.page-index, root.result.section-name, root.result.title, root.result.anchor-y);
    }

    Text {
        x: 32px; y: 2px; width: parent.width - 40px; height: 17px;
        text: root.result.title; font-size: 13px; color: #242428;
        vertical-alignment: center; overflow: elide;
    }
    Text {
        x: 32px; y: 19px; width: parent.width - 40px; height: 15px;
        text: root.result.section-name; font-size: 11px; color: #77777d;
        vertical-alignment: center; overflow: elide;
    }
    touch := TouchArea {
        clicked => {
            root.activated(root.result.page-index, root.result.section-name, root.result.title, root.result.anchor-y);
        }
    }
}

export component PreferenceSearchResultCell inherits Rectangle {
    in property <PreferencesSearchResult> result;
    in property <bool> selected: false;
    callback activated(int, string, string, int);
    width: 340px;
    height: 38px;

    if root.result.is-header : PreferenceSearchGroupHeader {
        title: root.result.page-name; icon: root.result.icon;
    }
    if !root.result.is-header : PreferenceSearchResultRow {
        result: root.result;
        selected: root.selected;
        activated(page-index, section-name, title, anchor-y) => {
            root.activated(page-index, section-name, title, anchor-y);
        }
    }
}
