import { Theme } from "theme.slint";
import { ComboBox } from "std-widgets.slint";
import { SidebarTab } from "player-sidebar-controls.slint";
import { QuickSettingsTabs } from "quick-settings-tabs.slint";
import { Tool } from "player-tool.slint";

export component PlayerSidebarTabs inherits HorizontalLayout {
    in property <bool> leading;
    in property <int> pane-kind;
    in property <bool> expanded-tab-labels;
    in property <bool> compact-ui;
    in property <bool> dark-theme;
    in property <color> interactive-accent-color;
    in property <bool> platform-windows;
    in property <[string]> plugin-sidebar-identifiers;
    in property <[string]> plugin-sidebar-labels;
    in property <int> plugin-sidebar-selected-index;
    in property <color> quick-settings-tab-selected-fill;
    in property <color> quick-settings-tab-selected-foreground;
    in property <color> windows-accent-color;
    in property <color> windows-accent-foreground;
    in property <bool> windows-sidebar-material-active;
    callback close-pane();
    callback select-settings-pane(int);
    callback select-playlist-pane(int);
    callback select-plugin-sidebar-tab(string);

    alignment: space-between;
    if !root.leading : Tool { accent-color: root.interactive-accent-color;
        dark-theme: root.dark-theme;
        circular: true;
        circular-size: root.compact-ui ? 28px : 36px;
        windows-acrylic-surface: root.windows-sidebar-material-active;
        icon: @image-url("../../../assets/icons/chevron-forward.svg");
        hint: "Close sidebar";
        activated => { root.close-pane(); }
    }
    // Tabs switch the visible pane without closing it or changing catalog tokens.
    if root.pane-kind == 1 || root.pane-kind == 2 || root.pane-kind == 5 || root.pane-kind == 6 : QuickSettingsTabs {
        selected-pane: root.pane-kind;
        show-label: root.expanded-tab-labels;
        dark-theme: root.dark-theme;
        accent-color: root.quick-settings-tab-selected-fill;
        accent-foreground: root.quick-settings-tab-selected-foreground;
        focus-accent-color: root.interactive-accent-color;
        chosen(pane) => { root.select-settings-pane(pane); }
    }
    if root.pane-kind == 3 || root.pane-kind == 4 : HorizontalLayout {
        spacing: 4px;
        SidebarTab { min-width: 76px; dark-theme: root.dark-theme; accent-color: root.platform-windows ? root.windows-accent-color : Theme.sidebar-catalog-accent; accent-foreground: root.platform-windows ? root.windows-accent-foreground : Theme.sidebar-catalog-accent-text; focus-accent-color: root.interactive-accent-color; label: "Playlist"; selected: root.pane-kind == 4;
            activated => { root.select-playlist-pane(4); } }
        SidebarTab { min-width: 76px; dark-theme: root.dark-theme; accent-color: root.platform-windows ? root.windows-accent-color : Theme.sidebar-catalog-accent; accent-foreground: root.platform-windows ? root.windows-accent-foreground : Theme.sidebar-catalog-accent-text; focus-accent-color: root.interactive-accent-color; label: "Chapters"; selected: root.pane-kind == 3;
            activated => { root.select-playlist-pane(3); } }
    }
    if root.pane-kind == 7 : HorizontalLayout {
        Text { text: "Plugins"; color: Theme.sidebar-heading-text(root.dark-theme);
            font-size: 12px; font-weight: 700; vertical-alignment: center; }
        if root.plugin-sidebar-labels.length > 0 : ComboBox {
            horizontal-stretch: 1;
            height: 24px;
            model: root.plugin-sidebar-labels;
            current-index: max(0, root.plugin-sidebar-selected-index);
            selected => {
                if self.current-index >= 0 && self.current-index < root.plugin-sidebar-identifiers.length {
                    root.select-plugin-sidebar-tab(root.plugin-sidebar-identifiers[self.current-index]);
                }
            }
        }
    }
    if root.leading : Tool { accent-color: root.interactive-accent-color;
        dark-theme: root.dark-theme;
        circular: true;
        circular-size: root.compact-ui ? 28px : 36px;
        windows-acrylic-surface: root.windows-sidebar-material-active;
        icon: @image-url("../../../assets/icons/chevron-backward.svg");
        hint: "Close sidebar";
        activated => { root.close-pane(); }
    }
}
