import { PlayerOsdState } from "player-osd-state.slint";
import { PlaybackTimelineState } from "playback-timeline-state.slint";
import { Theme } from "theme.slint";

export struct OsdMaterial {
    active: bool,
    native-tint: bool,
    frame: image,
    video-x: length,
    video-y: length,
    video-width: length,
    video-height: length,
    sample-opacity: float,
}

component OsdVideoSample inherits Image {
    in property <OsdMaterial> material;
    in property <length> card-x;
    in property <length> card-y;

    source: material.frame;
    x: material.video-x - card-x;
    y: material.video-y - card-y;
    width: material.video-width;
    height: material.video-height;
    opacity: material.sample-opacity;
    image-fit: contain;
}

// Geometry is estimated from the reviewed 320×180 reference capture.
export component SeekOsd inherits Rectangle {
    in property <OsdMaterial> material;
    in property <bool> osd-enabled;
    in property <float> osd-text-size;
    in property <color> progress-color;
    in property <duration> osd-fade-duration;

    clip: true;
    x: Theme.playback-osd-left; y: Theme.playback-osd-top; width: max(147px, seek-clock.preferred-width + 32px); height: 50px;
    opacity: PlayerOsdState.seek-osd-visible && root.osd-enabled ? 1 : 0;
    animate opacity { duration: root.osd-fade-duration; }
    border-radius: Theme.playback-osd-corner;
    background: Theme.playback-osd-surface(root.material.active, root.material.native-tint);
    if root.material.active : OsdVideoSample {
        material: root.material;
        card-x: parent.x;
        card-y: parent.y;
    }
    seek-clock := HorizontalLayout {
        x: 16px; y: 8px; width: parent.width - 32px; height: 25px; spacing: 5px;
        Text { text: PlaybackTimelineState.seek-position-label; color: white; font-size: root.osd-text-size * 1px; font-weight: 600; }
        Text { text: "/ " + PlaybackTimelineState.seek-duration-label; color: Theme.seek-osd-duration-text; font-size: root.osd-text-size * 1px; font-weight: 600; }
    }
    Rectangle { x: 16px; y: 35px; height: 2px;
        width: (parent.width - 32px) * clamp(PlaybackTimelineState.position / max(0.001, PlaybackTimelineState.duration), 0, 1);
        background: root.progress-color; border-radius: 1px; }
}

export component PluginOsd inherits Rectangle {
    in property <OsdMaterial> material;
    in property <bool> native-video;

    clip: true;
    height: 40px;
    border-radius: 8px;
    background: Theme.plugin-osd-surface(root.native-video, root.material.active);
    border-width: 1px; border-color: Theme.plugin-osd-border;
    if root.material.active : OsdVideoSample {
        material: root.material;
        card-x: parent.x;
        card-y: parent.y;
    }
    Text {
        x: 14px; y: 5px; width: parent.width - 28px; height: parent.height - 10px;
        text: PlayerOsdState.plugin-osd-message; color: #ffffff; font-size: 13px;
        vertical-alignment: center; overflow: elide;
    }
}

export component FullscreenInfoOsd inherits Rectangle {
    in property <OsdMaterial> material;
    in property <string> media-title;

    clip: true;
    height: 77px;
    border-radius: root.material.active ? 16px : 10px;
    background: Theme.fullscreen-info-surface(root.material.active, root.material.native-tint);
    border-width: 1px; border-color: Theme.fullscreen-info-border;
    if root.material.active : OsdVideoSample {
        material: root.material;
        card-x: parent.x;
        card-y: parent.y;
    }
    Text { x: 16px; y: 8px; width: parent.width - 32px; height: 24px;
        text: root.media-title; color: white; font-size: 18px; overflow: elide; }
    HorizontalLayout { x: 16px; y: 39px; width: parent.width - 32px; height: 24px; spacing: 4px;
        Rectangle { width: 22px; height: 22px; border-radius: 11px;
            border-width: 2px; border-color: Theme.fullscreen-info-symbol;
            Rectangle { x: 9px; y: 4px; width: 2px; height: 7px; background: Theme.fullscreen-info-symbol; }
            Rectangle { x: 10px; y: 10px; width: 6px; height: 2px; background: Theme.fullscreen-info-symbol; }
        }
        Text { text: PlayerOsdState.fullscreen-info-time; color: Theme.fullscreen-info-symbol; font-family: "monospace"; font-size: 18px; font-weight: 700; vertical-alignment: center; }
        Rectangle { width: 2px; height: 16px; background: #ffffff55; }
        if PlayerOsdState.fullscreen-info-battery != "" : HorizontalLayout {
            spacing: 4px;
            Rectangle { width: 22px; height: 12px; border-radius: 2px;
                border-width: 1px; border-color: Theme.fullscreen-info-symbol;
                Rectangle { x: 3px; y: 3px; width: 15px * PlayerOsdState.fullscreen-info-battery-level / 100; height: 4px; background: Theme.fullscreen-info-symbol; }
                Rectangle { x: 22px; y: 4px; width: 2px; height: 4px; background: Theme.fullscreen-info-symbol; }
            }
            Text { text: PlayerOsdState.fullscreen-info-battery; color: Theme.fullscreen-info-symbol; font-size: 13px; font-weight: 700; vertical-alignment: center; }
        }
    }
}

export component PlaybackOsd inherits Rectangle {
    in property <OsdMaterial> material;
    in property <bool> osd-enabled;
    in property <float> osd-text-size;
    in property <color> progress-color;
    in property <duration> osd-fade-duration;

    clip: true;
    x: Theme.playback-osd-left; y: Theme.playback-osd-top; width: video-message.preferred-width + 32px;
    height: PlayerOsdState.video-osd-progress >= 0 ? 50px : 41px;
    opacity: PlayerOsdState.video-osd-visible && root.osd-enabled ? 1 : 0;
    animate opacity { duration: root.osd-fade-duration; }
    border-radius: Theme.playback-osd-corner;
    background: Theme.playback-osd-surface(root.material.active, root.material.native-tint);
    if root.material.active : OsdVideoSample {
        material: root.material;
        card-x: parent.x;
        card-y: parent.y;
    }
    video-message := Text { x: 16px; y: 8px; text: PlayerOsdState.video-osd-text;
        color: white; font-size: root.osd-text-size * 1px; font-weight: 600; }
    if PlayerOsdState.video-osd-progress >= 0 : Rectangle { x: 16px; y: 35px;
        width: (parent.width - 32px) * clamp(PlayerOsdState.video-osd-progress, 0, 1);
        height: 2px; background: root.progress-color; border-radius: 1px; }
}
