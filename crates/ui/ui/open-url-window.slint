import { Button, CheckBox, LineEdit, Palette, ProgressIndicator } from "std-widgets.slint";
import { NativeTypography } from "shared-controls.slint";
import { Theme } from "theme.slint";

export component OpenUrlWindow inherits Window {
    title: @tr("Open URL");
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    preferred-width: 576px;
    preferred-height: 270px;
    min-width: 380px;
    min-height: 250px;
    default-font-family: NativeTypography.system-font-family;
    background: Theme.about-content-surface(root.dark-theme);

    in property <bool> dark-theme;
    in property <bool> show-default-scheme;
    in property <bool> valid-address;
    in property <bool> loading;
    in property <bool> authentication-available;
    in property <string> message;
    out property <string> invalid-address-message: @tr("Enter a valid stream URL");
    out property <string> closed-player-message: @tr("The player window closed. Open this dialog from another player.");
    out property <string> failed-stream-message: @tr("Cannot open this file or stream.");
    in-out property <string> address;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> remember;
    callback address-edited();
    callback submit();
    callback cancel();
    callback stop();
    changed dark-theme => {
        Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }
    changed address => { root.address-edited(); }
    public function focus-address() { stream.focus(); }
    public function focus-stop() { stop-button.focus(); }

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 14px;
            spacing: 7px;
            visible: !root.loading;
            Text {
                text: @tr("Open URL");
                font-size: 17px;
                font-weight: 600;
                color: Theme.about-title(root.dark-theme);
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: stretch;
                if root.show-default-scheme : Text {
                    text: "http://";
                    vertical-alignment: center;
                    color: Theme.about-summary-detail(root.dark-theme);
                }
                stream := LineEdit {
                    text <=> root.address;
                    placeholder-text: @tr("Please enter the URL here…");
                    accessible-label: @tr("Media URL");
                    accepted => { if root.valid-address { root.submit(); } }
                }
            }
            Text {
                text: root.message;
                min-height: 16px;
                color: Theme.player-dialog-error;
                wrap: word-wrap;
            }
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: @tr("HTTP Authentication");
                    font-weight: 600;
                    color: Theme.about-summary-detail(root.dark-theme);
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        enabled: root.authentication-available;
                        placeholder-text: @tr("Username");
                        accessible-label: @tr("Username");
                        text <=> root.username;
                        accepted => { if root.valid-address { root.submit(); } }
                    }
                    LineEdit {
                        enabled: root.authentication-available;
                        placeholder-text: @tr("Password");
                        accessible-label: @tr("Password");
                        input-type: InputType.password;
                        text <=> root.password;
                        accepted => { if root.valid-address { root.submit(); } }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    remember-choice := CheckBox {
                        enabled: root.authentication-available;
                        accessible-label: remember-caption.text;
                        checked <=> root.remember;
                        horizontal-stretch: 0;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-height: remember-caption.preferred-height;
                        remember-caption := Text {
                            width: parent.width; height: parent.height;
                            text: @tr("Remember username and password for this host");
                            color: root.authentication-available ? Palette.foreground : Palette.foreground.with-alpha(0.56);
                            vertical-alignment: center;
                            wrap: word-wrap;
                            accessible-role: none;
                        }
                        TouchArea {
                            enabled: root.authentication-available;
                            clicked => {
                                remember-choice.focus();
                                root.remember = !root.remember;
                            }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
                Button { text: @tr("Open"); enabled: root.valid-address; clicked => { root.submit(); } }
            }
        }

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: center;
            visible: root.loading;
            Text {
                text: @tr("Loading Media…");
                horizontal-alignment: center;
                font-size: 17px;
                color: Theme.about-title(root.dark-theme);
            }
            ProgressIndicator { indeterminate: true; }
            HorizontalLayout {
                alignment: center;
                stop-button := Button { text: @tr("Stop Loading"); clicked => { root.stop(); } }
            }
        }
    }
}
