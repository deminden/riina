import { Theme } from "theme.slint";
import { KeyBindingDialogs } from "preferences-key-binding-dialogs.slint";
import { PluginsPreferencesPage, PluginInstallDialog } from "preferences-plugin-page.slint";
import { PluginInformation, PluginInformationAction, PluginInformationDialog } from "preferences-plugin-information.slint";
export { PluginInformation, PluginInformationAction } from "preferences-plugin-information.slint";
import { KeyBindingsPreferencesPage } from "preferences-key-binding-page.slint";
import { NetworkPreferencesPage } from "preferences-network.slint";
export { NetworkSettingsState } from "preferences-network.slint";
import { SubtitleSettingsState, SubtitlesPreferencesPage } from "preferences-subtitles.slint";
export { SubtitleSettingsState } from "preferences-subtitles.slint";
import { InterfacePreferencesPage } from "preferences-interface.slint";
import { GeneralSettingsState, GeneralPreferencesPage } from "preferences-general.slint";
export { GeneralSettingsState } from "preferences-general.slint";
import { AdvancedPreferencesPage } from "preferences-advanced.slint";
export { AdvancedSettingsState } from "preferences-advanced.slint";
import { ControlPreferencesPage } from "preferences-control.slint";
export { ControlSettingsState } from "preferences-control.slint";
import { AudioPreferencesPage } from "preferences-audio.slint";
export { AudioSettingsState } from "preferences-audio.slint";
import { VideoPreferencesPage, VideoSettingsState } from "preferences-video.slint";
export { VideoSettingsState } from "preferences-video.slint";
import { BrowserExtension, UtilityAction, UtilityActionDialog, UtilitySettingsState, UtilitiesPreferencesPage, DefaultAppDialog } from "preferences-utilities.slint";
export { BrowserExtension, UtilityAction, UtilitySettingsState } from "preferences-utilities.slint";
import { PreferencesNavigation } from "preferences-navigation.slint";
import { PreferencesSearchResult, PreferenceSearchPopup } from "preferences-search.slint";
export { PreferencesSearchResult } from "preferences-search.slint";
export { KeyBindingRow, KeyBindingSettingsState } from "preferences-key-bindings.slint";
import { PluginPreferencesRow } from "preferences-plugins.slint";
export { PluginPreferencesRow } from "preferences-plugins.slint";
import { MotionSettings, AdvancedMpvOptionRow } from "preferences-controls.slint";
export { AdvancedMpvOptionRow } from "preferences-controls.slint";
import { Palette } from "std-widgets.slint";
import { NativeTypography } from "shared-controls.slint";

export component PreferencesWindow inherits Window {
    default-font-family: NativeTypography.system-font-family;
    title: @tr("Settings");
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    preferred-width: 600px;
    preferred-height: 620px;
    min-width: 600px;
    min-height: 480px;
    // Keep standard controls aligned with the light reference surfaces even
    // when the desktop or player uses dark appearance.
    init => { Palette.color-scheme = ColorScheme.light; }
    in-out property <bool> mica-backdrop-enabled: false;
    in property <string> profile-status;
    // Layer the Settings surfaces over Windows Mica and preserve their solid
    // colors when the native backdrop is unavailable.
    background: mica-backdrop-enabled ? transparent : Theme.settings-content-surface(false);
    in-out property <int> selected-pane: 0;
    in-out property <int> selected-general-section: 0;
    in-out property <int> selected-subtitle-section: 0;
    in-out property <bool> disable-animations: false;
    in property <bool> system-reduce-motion: false;
    in property <bool> platform-macos: false;
    in-out property <length> general-scroll-position: 0px;
    private property <length> general-content-height: max(
        root.general-screenshots-y + 228px,
        root.height - root.general-screenshots-target);

    in-out property <int> appearance-index: 0;
    in-out property <bool> liquid-glass-expanded: false;
    in-out property <bool> liquid-glass-osd: true;
    in-out property <bool> liquid-glass-osc: true;
    in-out property <bool> liquid-glass-sidebar: true;
    in property <string> surface-material-title: "Translucent Surfaces";
    in-out property <int> selected-interface-section: 0;
    in-out property <bool> control-auto-hide-enabled: true;
    in-out property <string> control-auto-hide-timeout-text: "2.5";
    in-out property <bool> control-stick-to-center: true;
    in-out property <bool> control-show-remaining-time: false;
    in-out property <bool> control-scale-remaining-time: false;
    in-out property <int> control-time-precision: 0;
    callback controller-options-adopted();
    in-out property <bool> toolbar-show-plugins: true;
    in-out property <bool> toolbar-show-pip: true;
    in-out property <bool> toolbar-show-playlist: true;
    in-out property <bool> toolbar-show-quick-settings: true;
    in-out property <bool> toolbar-show-fullscreen: false;
    in-out property <bool> toolbar-show-music-mode: false;
    in-out property <bool> toolbar-show-subtitle-track: false;
    in-out property <bool> toolbar-show-screenshot: false;
    in-out property <bool> toolbar-show-live-text: false;
    in-out property <[int]> toolbar-order: [7, 2, 1, 0, 3, 4, 5, 6, 8];
    in-out property <int> toolbar-drag-index: -1;
    in-out property <int> toolbar-drop-index: -1;
    in-out property <length> toolbar-drag-start-y: 0px;
    in-out property <bool> toolbar-drag-active: false;
    in-out property <bool> osd-suppression-expanded: false;
    in-out property <bool> disable-osd-file-start: false;
    in-out property <bool> disable-osd-pause-resume: false;
    in-out property <string> osd-timeout-text: "1";
    in-out property <string> osd-text-size-text: "20";
    in-out property <bool> thumbnail-preview-enabled: true;
    in-out property <string> thumbnail-cache-size-text: "500";
    in-out property <bool> thumbnail-remote-enabled: false;
    in-out property <string> thumbnail-width-text: "120";
    in-out property <bool> display-time-and-battery-in-fullscreen: false;
    in-out property <length> interface-scroll-position: 0px;
    in-out property <bool> always-float-on-top: false;
    in-out property <bool> always-show-on-top-icon: false;
    in-out property <int> window-resize-option-index: 2;
    in-out property <int> window-resize-timing-index: 1;
    in-out property <bool> use-physical-resolution: true;
    in-out property <bool> initial-window-size-enabled: false;
    in-out property <int> initial-window-size-axis-index: 0;
    in-out property <string> initial-window-size-value-text: "1280";
    in-out property <int> initial-window-size-unit-index: 0;
    in-out property <bool> initial-window-position-enabled: false;
    in-out property <int> initial-window-x-anchor-index: 0;
    in-out property <string> initial-window-x-offset-text: "20";
    in-out property <int> initial-window-x-unit-index: 0;
    in-out property <int> initial-window-y-anchor-index: 1;
    in-out property <string> initial-window-y-offset-text: "20";
    in-out property <int> initial-window-y-unit-index: 0;
    // Expanded source rows move every following SettingsList and its scroll target.
    out property <length> interface-appearance-card-y: 81px;
    out property <length> liquid-glass-detail-height: liquid-glass-expanded ? 96px : 0px;
    out property <length> interface-appearance-card-height: 122px + liquid-glass-detail-height;
    out property <length> interface-window-title-y: interface-appearance-card-y + interface-appearance-card-height + 17px;
    out property <length> interface-window-y: interface-window-title-y + 28px;
    out property <length> initial-window-size-detail-height: initial-window-size-enabled ? 34px : 0px;
    out property <length> initial-window-position-detail-height: initial-window-position-enabled ? 100px : 0px;
    out property <length> interface-window-card-height: 82px + initial-window-size-detail-height + initial-window-position-detail-height;
    out property <length> interface-resize-y: interface-window-y + interface-window-card-height + 16px;
    out property <length> interface-physical-resolution-y: interface-resize-y + 134px;
    out property <length> interface-float-y: interface-physical-resolution-y + 56px;
    out property <length> interface-osc-y: interface-float-y + 96px;
    out property <length> interface-osc-card-height: 610px;
    out property <length> interface-osd-y: interface-osc-y + interface-osc-card-height + 16px;
    out property <length> osd-suppression-detail-height: osd-suppression-expanded ? 112px : 0px;
    private property <length> osd-settings-height: root.width < 820px ? 144px : 112px;
    out property <length> interface-thumbnail-y: interface-osd-y + 108px + osd-suppression-detail-height
        + osd-settings-height + 16px;
    out property <length> interface-pip-y: interface-thumbnail-y + 236px;
    out property <length> interface-pip-card-height: 148px;
    out property <length> interface-accessibility-y: interface-pip-y + interface-pip-card-height + 44px;
    out property <length> interface-content-height: interface-accessibility-y + root.height - 13px;
    out property <length> interface-window-target: 0px - (interface-window-title-y - 13px);
    out property <length> interface-osc-target: 0px - (interface-osc-y - 13px);
    out property <length> interface-osd-target: 0px - (interface-osd-y - 13px);
    out property <length> interface-thumbnail-target: 0px - (interface-thumbnail-y - 13px);
    out property <length> interface-pip-target: 0px - (interface-pip-y - 13px);
    out property <length> interface-accessibility-target: 0px - (interface-accessibility-y - 13px);
    private property <length> general-media-opened-height: GeneralSettingsState.when-media-opened-expanded ? 166px : 0px;
    private property <length> general-expanded-height: root.general-media-opened-height
        + (GeneralSettingsState.pause-resume-when-expanded ? (GeneralSettingsState.pause-policies-available ? 168px : 104px) : 0px);
    private property <length> general-window-y: 219px + root.general-expanded-height;
    private property <length> general-power-y: root.general-window-y + 228px;
    private property <length> general-updates-y: root.general-power-y + 98px;
    private property <length> general-history-y: root.general-updates-y + 152px;
    private property <length> general-playlist-y: root.general-history-y + 221px;
    private property <length> general-screenshots-y: root.general-playlist-y + 248px;
    out property <length> general-media-opened-target: 13px - 122px;
    out property <length> general-pause-policy-target: 13px - 163px - root.general-media-opened-height;
    out property <length> general-window-target: 13px - root.general-window-y;
    out property <length> general-updates-target: 13px - root.general-updates-y;
    out property <length> general-power-target: 13px - root.general-power-y;
    out property <length> general-history-target: 13px - root.general-history-y;
    out property <length> general-playlist-target: 13px - root.general-playlist-y;
    out property <length> general-screenshots-target: 13px - root.general-screenshots-y;
    out property <length> interface-appearance-threshold: interface-window-target / 2;
    out property <length> interface-window-threshold: (interface-window-target + interface-osc-target) / 2;
    out property <length> interface-osc-threshold: (interface-osc-target + interface-osd-target) / 2;
    out property <length> interface-osd-threshold: (interface-osd-target + interface-thumbnail-target) / 2;
    out property <length> interface-thumbnail-threshold: (interface-thumbnail-target + interface-pip-target) / 2;
    out property <length> interface-pip-threshold: (interface-pip-target + interface-accessibility-target) / 2;
    in-out property <int> selected-network-section: 0;
    in-out property <length> network-scroll-position: 0px;
    private property <length> network-connection-y: 588px;
    private property <length> network-online-y: network-connection-y + 259px;
    private property <length> network-content-height: max(network-online-y + 390px, root.height + network-online-y - 16px);
    public function reveal-network-section(section: int) {
        root.reveal-network-setting(section, 0px);
    }
    public function reveal-network-setting(section: int, inset: length) {
        root.selected-network-section = section;
        let start = section == 1 ? 16px - network-connection-y : section == 2 ? 16px - network-online-y : 0px;
        root.network-scroll-position = max(root.height - network-content-height, start - inset);
    }

    in-out property <length> control-scroll-position: 0px;
    private property <length> control-content-height: 760px;
    private property <length> control-mouse-y: 174px;
    private property <length> control-scroll-y: 418px;
    private property <length> control-sensitivity-y: 538px;
    public function reveal-control-section(section: int) {
        let heading = section == 1 ? control-mouse-y : section == 2 ? control-scroll-y : section == 3 ? control-sensitivity-y : 16px;
        root.control-scroll-position = max(min(0px, root.height - control-content-height), 16px - heading);
    }

    in-out property <int> selected-audio-section: 0;
    in-out property <length> audio-scroll-position: 0px;
    private property <length> audio-volume-title-y: 340px;
    private property <length> audio-other-title-y: 640px;
    private property <length> audio-content-height: max(930px, root.height + audio-other-title-y - 16px);
    public function reveal-audio-section(section: int) {
        root.selected-audio-section = section;
        root.audio-scroll-position = section == 1 ? 16px - audio-volume-title-y : section == 2 ? 16px - audio-other-title-y : 0px;
    }
    in-out property <string> search-query: "";
    in property <[PreferencesSearchResult]> search-results: [];
    in-out property <int> selected-search-index: -1;
    in-out property <length> subtitle-scroll-position: 0px;
    private property <length> subtitle-autoload-height: SubtitleSettingsState.subtitle-auto-load-advanced-expanded ? 240px : 82px;
    private property <length> subtitle-ass-y: 78px + subtitle-autoload-height + 20px;
    private property <length> subtitle-text-y: subtitle-ass-y + 400px;
    private property <length> subtitle-text-height: SubtitleSettingsState.subtitle-text-advanced-expanded ? 288px : 244px;
    private property <length> subtitle-position-y: subtitle-text-y + 26px + subtitle-text-height + 20px;
    private property <length> subtitle-online-y: subtitle-position-y + 294px;
    private property <length> subtitle-online-height: SubtitleSettingsState.open-subtitles-provider-index > 2 ? 156px : SubtitleSettingsState.open-subtitles-provider-index == 1 ? 276px : SubtitleSettingsState.open-subtitles-provider-index == 2 ? 224px : 244px;
    private property <length> subtitle-other-y: subtitle-online-y + 26px + subtitle-online-height + 20px;
    private property <length> subtitle-content-height: max(subtitle-other-y + 214px, root.height + subtitle-other-y - 16px);
    private property <[string]> subtitle-override-descriptions: [
        @tr("Render subtitle scripts without overriding their styles."),
        @tr("Apply all style settings from this section."),
        @tr("Apply subtitle scale together with these style settings."),
        @tr("Apply all subtitle styles."),
        @tr("Remove ASS tags and styling from the subtitle.")
    ];
    pure function subtitle-section-y(section: int) -> length {
        return section == 1 ? subtitle-ass-y : section == 2 ? subtitle-text-y : section == 3 ? subtitle-position-y : section == 4 ? subtitle-online-y : section == 5 ? subtitle-other-y : 52px;
    }
    public function reveal-subtitle-section(section: int) {
        root.selected-subtitle-section = section;
        root.subtitle-scroll-position = section == 0 ? 0px : 16px - root.subtitle-section-y(section);
    }
    function choose-subtitle-override(index: int) {
        if SubtitleSettingsState.subtitle-ass-override-lane == 0 { SubtitleSettingsState.subtitle-ass-override-primary-index = index; }
        else { SubtitleSettingsState.subtitle-ass-override-secondary-index = index; }
        root.settings-changed();
    }

    callback search-query-changed(string);
    callback search-selection-moved(int);
    callback search-selection-activated();
    callback search-result-activated(int);
    in-out property <int> osc-position: 0;
    in-out property <bool> show-chapter-pos: false;
    in-out property <int> pip-window-behavior-index: 1;
    in-out property <bool> pip-pause-when-entering: false;
    in-out property <bool> pip-toggle-by-minimizing: false;
    in-out property <bool> pip-minimize-toggle-video-only: false;
    in-out property <int> hardware-decoder-index <=> VideoSettingsState.hardware-decoder-index;
    in-out property <bool> load-icc-profile <=> VideoSettingsState.load-icc-profile;
    in-out property <bool> default-hdr-mode-enabled <=> VideoSettingsState.default-hdr-mode-enabled;
    in-out property <string> video-threads-text <=> VideoSettingsState.video-threads-text;
    callback key-binding-profile-selected(string);
    callback key-binding-row-selected(int);
    callback key-binding-settings-changed();
    callback key-binding-add-requested();
    callback key-binding-edit-requested(int);
    callback key-binding-remove-requested(int);
    callback key-binding-key-recorded(string, bool, bool, bool, bool);
    callback key-binding-mapping-submitted(string, string, string, int, int);
    callback key-binding-editor-cancelled();
    callback key-binding-delete-profile();
    callback key-binding-reveal-profile();
    callback key-binding-import-profile-requested();
    callback key-binding-profile-created(string, int);
    callback key-binding-profile-editor-cancelled();
    callback key-binding-search-changed(string);
    callback add-subtitle-language-token(string);
    callback remove-subtitle-language-token(int);
    in-out property <bool> volume-boost: false;
    callback add-audio-language-token(string);
    callback remove-audio-language-token(int);
    in-out property <bool> live-text-enabled <=> VideoSettingsState.live-text-enabled;
    in property <bool> live-text-available: false;
    out property <length> video-color-card-y: live-text-available ? 516px : 402px;
    out property <length> video-hdr-card-y: video-color-card-y + (platform-macos ? 100px : 0px);
    out property <length> video-tone-mapping-card-y: video-hdr-card-y + 100px;
    private property <length> video-content-height:
        video-tone-mapping-card-y + (VideoSettingsState.tone-mapping-expanded ? 418px : 158px);
    public function reveal-video-setting(target: length) {
        VideoSettingsState.video-scroll-position = max(16px - target, min(0px, root.height - video-content-height));
    }
    in property <[PluginPreferencesRow]> plugin-rows: [];
    in-out property <bool> plugin-information-open;
    in property <PluginInformation> plugin-information;
    in property <string> plugin-information-status;
    in property <bool> plugin-information-checking;
    callback plugin-information-action(PluginInformationAction);
    callback plugin-information-update();
    in-out property <string> plugin-update-status: "All plugins are up to date.";
    in-out property <bool> plugin-github-sheet-open: false;
    in-out property <string> plugin-github-repository: "";
    in-out property <bool> plugin-github-installing: false;
    in-out property <bool> compact-ui: false;
    in-out property <bool> docked-controls: false;
    in-out property <bool> edge-to-edge-video: true;
    in-out property <bool> osd-enabled: true;
    in-out property <bool> disable-osd-speed: false;
    in-out property <bool> disable-osd-seek: false;
    callback settings-changed();
    callback native-subtitle-color-requested(int, color);
    callback open-assrt-token-page();
    callback toolbar-move(int, int);
    callback toolbar-drag-finished();
    callback toolbar-reset();
    changed disable-animations => {
        MotionSettings.animations-disabled = root.disable-animations ||
            (root.system-reduce-motion && !root.platform-macos);
    }
    changed system-reduce-motion => {
        MotionSettings.animations-disabled = root.disable-animations ||
            (root.system-reduce-motion && !root.platform-macos);
    }
    changed platform-macos => {
        MotionSettings.animations-disabled = root.disable-animations ||
            (root.system-reduce-motion && !root.platform-macos);
    }
    callback choose-folder();
    callback choose-subtitle-font();
    callback close-profile-font-picker();
    callback utilities-open-default-apps();
    callback utilities-default-apps-requested(bool, bool, bool);
    callback utilities-refresh-sizes();
    callback utility-confirmed(UtilityAction) -> string;
    public function refresh-utility-sizes-if-selected() {
        if root.selected-pane == 10 { root.utilities-refresh-sizes(); }
    }
    public function dismiss-utility-dialogs() {
        utility-dialog.dismiss();
        UtilitySettingsState.utilities-default-app-sheet-open = false;
    }
    callback utilities-browser-extension(BrowserExtension);
    callback advanced-settings-changed();
    callback advanced-choose-config-directory();
    callback advanced-open-log-folder();
    callback advanced-open-log-viewer();
    callback advanced-option-added();
    callback advanced-option-removed(int);
    callback advanced-option-edited(int, string, string);
    callback plugin-request-github-install();
    callback plugin-github-install-requested(string);
    callback plugin-update-staged(int);
    callback plugin-update-completed(int);
    pure callback plugin-id-transfer(string) -> data-transfer;
    pure callback plugin-id-from-transfer(data-transfer) -> string;
    callback plugin-reordered(string, string);
    callback plugin-request-local-install();
    callback plugin-install-archive(string);
    callback plugin-cancel-import();
    callback plugin-refresh();
    callback plugin-enabled-changed(int, bool);
    callback plugin-row-about(int);
    callback plugin-row-actions(int);
    callback plugin-row-uninstall(int);
    callback plugin-uninstall-completed();
    callback plugin-row-settings(int);
    callback close-plugin-settings();
    callback plugin-settings-pane-left();

    changed selected-pane => {
        root.refresh-utility-sizes-if-selected();
        if root.selected-pane != 9 {
            root.plugin-information-open = false;
            root.plugin-settings-pane-left();
        }
    }
    in-out property <bool> custom-directory: false;
    PreferencesNavigation {
        x: 0; y: 0; width: 200px; height: parent.height;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        search-query <=> root.search-query;
        search-result-count: root.search-results.length;
        selected-search-index <=> root.selected-search-index;
        selected-pane <=> root.selected-pane;
        selected-general-section <=> root.selected-general-section;
        selected-interface-section <=> root.selected-interface-section;
        selected-subtitle-section: root.selected-subtitle-section;
        selected-audio-section: root.selected-audio-section;
        selected-network-section: root.selected-network-section;
        general-scroll-position <=> root.general-scroll-position;
        interface-scroll-position <=> root.interface-scroll-position;
        general-history-target: root.general-history-target;
        general-playlist-target: root.general-playlist-target;
        general-screenshots-target: root.general-screenshots-target;
        interface-window-target: root.interface-window-target;
        interface-osc-target: root.interface-osc-target;
        interface-osd-target: root.interface-osd-target;
        interface-thumbnail-target: root.interface-thumbnail-target;
        interface-pip-target: root.interface-pip-target;
        interface-accessibility-target: root.interface-accessibility-target;
        search-query-changed(query) => { root.search-query-changed(query); }
        search-selection-moved(direction) => { root.search-selection-moved(direction); }
        search-selection-activated => { root.search-selection-activated(); }
        reveal-audio-section(section) => { root.reveal-audio-section(section); }
        reveal-subtitle-section(section) => { root.reveal-subtitle-section(section); }
        reveal-network-section(section) => { root.reveal-network-section(section); }
    }
    if root.selected-pane == 0 : GeneralPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        general-content-height: root.general-content-height;
        general-scroll-position <=> root.general-scroll-position;
        general-history-target: root.general-history-target;
        selected-general-section <=> root.selected-general-section;
        general-playlist-target: root.general-playlist-target;
        general-screenshots-target: root.general-screenshots-target;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        settings-changed => { root.settings-changed(); }
        general-power-y: root.general-power-y;
        general-window-y: root.general-window-y;
        general-updates-y: root.general-updates-y;
        general-history-y: root.general-history-y;
        general-playlist-y: root.general-playlist-y;
        general-screenshots-y: root.general-screenshots-y;
        choose-folder => { root.choose-folder(); }
    }

    if root.selected-pane == 1 : InterfacePreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        interface-content-height: root.interface-content-height;
        interface-scroll-position <=> root.interface-scroll-position;
        interface-appearance-threshold: root.interface-appearance-threshold;
        selected-interface-section <=> root.selected-interface-section;
        interface-window-threshold: root.interface-window-threshold;
        interface-osc-threshold: root.interface-osc-threshold;
        interface-osd-threshold: root.interface-osd-threshold;
        interface-thumbnail-threshold: root.interface-thumbnail-threshold;
        interface-pip-threshold: root.interface-pip-threshold;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        interface-appearance-card-y: root.interface-appearance-card-y;
        interface-appearance-card-height: root.interface-appearance-card-height;
        appearance-index <=> root.appearance-index;
        settings-changed => { root.settings-changed(); }
        surface-material-title: root.surface-material-title;
        liquid-glass-expanded <=> root.liquid-glass-expanded;
        liquid-glass-osd <=> root.liquid-glass-osd;
        liquid-glass-osc <=> root.liquid-glass-osc;
        liquid-glass-sidebar <=> root.liquid-glass-sidebar;
        liquid-glass-detail-height: root.liquid-glass-detail-height;
        compact-ui <=> root.compact-ui;
        interface-window-title-y: root.interface-window-title-y;
        interface-window-y: root.interface-window-y;
        interface-window-card-height: root.interface-window-card-height;
        initial-window-size-enabled <=> root.initial-window-size-enabled;
        initial-window-size-axis-index <=> root.initial-window-size-axis-index;
        initial-window-size-value-text <=> root.initial-window-size-value-text;
        initial-window-size-unit-index <=> root.initial-window-size-unit-index;
        initial-window-size-detail-height: root.initial-window-size-detail-height;
        initial-window-position-enabled <=> root.initial-window-position-enabled;
        initial-window-x-offset-text <=> root.initial-window-x-offset-text;
        initial-window-x-unit-index <=> root.initial-window-x-unit-index;
        initial-window-x-anchor-index <=> root.initial-window-x-anchor-index;
        initial-window-y-offset-text <=> root.initial-window-y-offset-text;
        initial-window-y-unit-index <=> root.initial-window-y-unit-index;
        initial-window-y-anchor-index <=> root.initial-window-y-anchor-index;
        interface-resize-y: root.interface-resize-y;
        window-resize-option-index <=> root.window-resize-option-index;
        window-resize-timing-index <=> root.window-resize-timing-index;
        interface-physical-resolution-y: root.interface-physical-resolution-y;
        use-physical-resolution <=> root.use-physical-resolution;
        interface-float-y: root.interface-float-y;
        always-float-on-top <=> root.always-float-on-top;
        always-show-on-top-icon <=> root.always-show-on-top-icon;
        interface-osc-y: root.interface-osc-y;
        interface-osc-card-height: root.interface-osc-card-height;
        osc-position <=> root.osc-position;
        docked-controls <=> root.docked-controls;
        edge-to-edge-video: root.edge-to-edge-video;
        show-chapter-pos <=> root.show-chapter-pos;
        control-auto-hide-enabled <=> root.control-auto-hide-enabled;
        control-auto-hide-timeout-text <=> root.control-auto-hide-timeout-text;
        control-stick-to-center <=> root.control-stick-to-center;
        control-show-remaining-time <=> root.control-show-remaining-time;
        control-scale-remaining-time <=> root.control-scale-remaining-time;
        toolbar-reset => { root.toolbar-reset(); }
        toolbar-order: root.toolbar-order;
        toolbar-drag-index <=> root.toolbar-drag-index;
        toolbar-drop-index <=> root.toolbar-drop-index;
        toolbar-drag-start-y <=> root.toolbar-drag-start-y;
        toolbar-drag-active <=> root.toolbar-drag-active;
        toolbar-show-quick-settings <=> root.toolbar-show-quick-settings;
        toolbar-show-playlist <=> root.toolbar-show-playlist;
        toolbar-show-pip <=> root.toolbar-show-pip;
        toolbar-show-fullscreen <=> root.toolbar-show-fullscreen;
        toolbar-show-music-mode <=> root.toolbar-show-music-mode;
        toolbar-show-subtitle-track <=> root.toolbar-show-subtitle-track;
        toolbar-show-screenshot <=> root.toolbar-show-screenshot;
        toolbar-show-plugins <=> root.toolbar-show-plugins;
        toolbar-show-live-text <=> root.toolbar-show-live-text;
        toolbar-move(value1, value2) => { root.toolbar-move(value1, value2); }
        toolbar-drag-finished => { root.toolbar-drag-finished(); }
        interface-osd-y: root.interface-osd-y;
        osd-suppression-detail-height: root.osd-suppression-detail-height;
        osd-settings-height: root.osd-settings-height;
        osd-enabled <=> root.osd-enabled;
        osd-suppression-expanded <=> root.osd-suppression-expanded;
        disable-osd-file-start <=> root.disable-osd-file-start;
        disable-osd-pause-resume <=> root.disable-osd-pause-resume;
        disable-osd-seek <=> root.disable-osd-seek;
        disable-osd-speed <=> root.disable-osd-speed;
        osd-timeout-text <=> root.osd-timeout-text;
        osd-text-size-text <=> root.osd-text-size-text;
        display-time-and-battery-in-fullscreen <=> root.display-time-and-battery-in-fullscreen;
        interface-pip-y: root.interface-pip-y;
        interface-pip-card-height: root.interface-pip-card-height;
        pip-window-behavior-index <=> root.pip-window-behavior-index;
        pip-pause-when-entering <=> root.pip-pause-when-entering;
        pip-toggle-by-minimizing <=> root.pip-toggle-by-minimizing;
        pip-minimize-toggle-video-only <=> root.pip-minimize-toggle-video-only;
        interface-thumbnail-y: root.interface-thumbnail-y;
        thumbnail-preview-enabled <=> root.thumbnail-preview-enabled;
        thumbnail-cache-size-text <=> root.thumbnail-cache-size-text;
        thumbnail-remote-enabled <=> root.thumbnail-remote-enabled;
        thumbnail-width-text <=> root.thumbnail-width-text;
        interface-accessibility-y: root.interface-accessibility-y;
        disable-animations <=> root.disable-animations;
    }

    if root.selected-pane == 2 : VideoPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        platform-macos: root.platform-macos;
        live-text-available: root.live-text-available;
        color-card-y: root.video-color-card-y;
        hdr-card-y: root.video-hdr-card-y;
        tone-mapping-card-y: root.video-tone-mapping-card-y;
        video-content-height: root.video-content-height;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        settings-changed => { root.settings-changed(); }
    }

    if root.selected-pane == 4 : SubtitlesPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        subtitle-scroll-position <=> root.subtitle-scroll-position;
        subtitle-content-height: root.subtitle-content-height;
        subtitle-ass-y: root.subtitle-ass-y;
        selected-subtitle-section <=> root.selected-subtitle-section;
        subtitle-text-y: root.subtitle-text-y;
        subtitle-position-y: root.subtitle-position-y;
        subtitle-online-y: root.subtitle-online-y;
        subtitle-other-y: root.subtitle-other-y;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        subtitle-autoload-height: root.subtitle-autoload-height;
        settings-changed => { root.settings-changed(); }
        subtitle-override-descriptions: root.subtitle-override-descriptions;
        choose-subtitle-override(value) => { root.choose-subtitle-override(value); }
        subtitle-text-height: root.subtitle-text-height;
        choose-subtitle-font => { root.choose-subtitle-font(); }
        platform-macos: root.platform-macos;
        native-subtitle-color-requested(value1, value2) => { root.native-subtitle-color-requested(value1, value2); }
        subtitle-online-height: root.subtitle-online-height;
        open-assrt-token-page => { root.open-assrt-token-page(); }
        add-subtitle-language-token(value1) => { root.add-subtitle-language-token(value1); }
        remove-subtitle-language-token(value1) => { root.remove-subtitle-language-token(value1); }
    }

    if root.selected-pane == 3 : AudioPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        audio-content-height: root.audio-content-height;
        audio-scroll-position <=> root.audio-scroll-position;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        settings-changed => { root.settings-changed(); }
        audio-volume-title-y: root.audio-volume-title-y;
        volume-boost <=> root.volume-boost;
        audio-other-title-y: root.audio-other-title-y;
        add-audio-language-token(value1) => { root.add-audio-language-token(value1); }
        remove-audio-language-token(value1) => { root.remove-audio-language-token(value1); }
    }

    if root.selected-pane == 5 : NetworkPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        network-content-height: root.network-content-height;
        network-scroll-position <=> root.network-scroll-position;
        network-connection-y: root.network-connection-y;
        selected-network-section <=> root.selected-network-section;
        network-online-y: root.network-online-y;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        settings-changed => { root.settings-changed(); }
    }

    if root.selected-pane == 6 : ControlPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        control-content-height: root.control-content-height;
        control-scroll-position <=> root.control-scroll-position;
        control-mouse-y: root.control-mouse-y;
        control-scroll-y: root.control-scroll-y;
        control-sensitivity-y: root.control-sensitivity-y;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        settings-changed => { root.settings-changed(); }
    }

    if root.selected-pane == 7 : KeyBindingsPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        window-height: root.height;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        key-binding-settings-changed => { root.key-binding-settings-changed(); }
        settings-changed => { root.settings-changed(); }
        key-binding-profile-selected(value1) => { root.key-binding-profile-selected(value1); }
        key-binding-search-changed(value1) => { root.key-binding-search-changed(value1); }
        key-binding-add-requested => { root.key-binding-add-requested(); }
        key-binding-row-selected(value1) => { root.key-binding-row-selected(value1); }
        key-binding-edit-requested(value1) => { root.key-binding-edit-requested(value1); }
        key-binding-remove-requested(value1) => { root.key-binding-remove-requested(value1); }
        key-binding-import-profile-requested => { root.key-binding-import-profile-requested(); }
        key-binding-reveal-profile => { root.key-binding-reveal-profile(); }
    }

    if root.selected-pane == 8 : AdvancedPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        advanced-settings-changed => { root.advanced-settings-changed(); }
        advanced-open-log-folder => { root.advanced-open-log-folder(); }
        advanced-open-log-viewer => { root.advanced-open-log-viewer(); }
        advanced-choose-config-directory => { root.advanced-choose-config-directory(); }
        advanced-option-edited(value1, value2, value3) => { root.advanced-option-edited(value1, value2, value3); }
        settings-changed => { root.settings-changed(); }
        advanced-option-added => { root.advanced-option-added(); }
        advanced-option-removed(value1) => { root.advanced-option-removed(value1); }
    }

    if root.selected-pane == 9 : PluginsPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        plugin-request-github-install => { root.plugin-request-github-install(); }
        plugin-request-local-install => { root.plugin-request-local-install(); }
        plugin-update-status: root.plugin-update-status;
        plugin-refresh => { root.plugin-refresh(); }
        plugin-rows: root.plugin-rows;
        plugin-id-transfer(value) => { return root.plugin-id-transfer(value); }
        plugin-id-from-transfer(value) => { return root.plugin-id-from-transfer(value); }
        plugin-enabled-changed(value1, value2) => { root.plugin-enabled-changed(value1, value2); }
        plugin-row-about(value1) => { root.plugin-row-about(value1); }
        plugin-row-actions(value1) => { root.plugin-row-actions(value1); }
        plugin-row-uninstall(value1) => { root.plugin-row-uninstall(value1); }
        plugin-row-settings(value1) => { root.plugin-row-settings(value1); }
        plugin-reordered(value1, value2) => { root.plugin-reordered(value1, value2); }
    }

    if root.selected-pane == 10 : UtilitiesPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        utilities-open-default-apps => { root.utilities-open-default-apps(); }
        utility-requested(action) => { utility-dialog.open(action); }
        utilities-browser-extension(browser) => { root.utilities-browser-extension(browser); }
    }

    if !root.search-query.is-empty : PreferenceSearchPopup {
        x: 8px; y: 48px;
        results: root.search-results;
        selected-index: root.selected-search-index;
        activated(target) => { root.search-result-activated(target); }
    }

    KeyBindingDialogs {
        width: root.width; height: root.height;
        key-binding-profile-editor-cancelled => { root.key-binding-profile-editor-cancelled(); }
        key-binding-profile-created(name, mode) => { root.key-binding-profile-created(name, mode); }
        key-binding-delete-profile => { root.key-binding-delete-profile(); }
        key-binding-editor-cancelled => { root.key-binding-editor-cancelled(); }
        key-binding-key-recorded(key, control, alt, shift, meta) => { root.key-binding-key-recorded(key, control, alt, shift, meta); }
        key-binding-mapping-submitted(key, action, comment, kind, row) => { root.key-binding-mapping-submitted(key, action, comment, kind, row); }
    }

    if root.profile-status != "" : Rectangle {
        x: 212px; y: parent.height - self.height - 12px;
        width: parent.width - self.x - 12px;
        height: profile-message.preferred-height + 16px;
        background: Theme.settings-modal-surface;
        border-width: 1px; border-color: Theme.settings-modal-border; border-radius: 6px;
        profile-message := Text {
            x: 8px; y: 8px; width: parent.width - 16px;
            text: root.profile-status; color: Theme.settings-modal-title;
            font-size: 12px; wrap: word-wrap;
        }
    }

    if root.plugin-information-open : PluginInformationDialog {
        width: root.width; height: root.height;
        information: root.plugin-information;
        status: root.plugin-information-status;
        checking-update: root.plugin-information-checking || root.plugin-github-installing;
        action(action) => { root.plugin-information-action(action); }
        update => { root.plugin-information-update(); }
        closed => { root.plugin-information-open = false; root.close-plugin-settings(); }
    }

    if root.plugin-github-sheet-open : PluginInstallDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        repository <=> root.plugin-github-repository;
        installing: root.plugin-github-installing;
        install-requested(repository) => { root.plugin-github-install-requested(repository); }
        cancelled => { root.plugin-github-sheet-open = false; }
    }

    if UtilitySettingsState.utilities-default-app-sheet-open : DefaultAppDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        video <=> UtilitySettingsState.utilities-default-video;
        audio <=> UtilitySettingsState.utilities-default-audio;
        playlist <=> UtilitySettingsState.utilities-default-playlist;
        cancelled => { UtilitySettingsState.utilities-default-app-sheet-open = false; }
        confirmed(video, audio, playlist) => {
            UtilitySettingsState.utilities-default-app-sheet-open = false;
            root.utilities-default-apps-requested(video, audio, playlist);
        }
    }

    utility-dialog := UtilityActionDialog {
        width: root.width;
        height: root.height;
        confirmed(action) => { return root.utility-confirmed(action); }
    }
}
