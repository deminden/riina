        utilities-clear-history => { root.utilities-clear-history(); }
        utilities-clear-thumbnail-cache => { root.utilities-clear-thumbnail-cache(); }
    }

    if !root.search-query.is-empty : PreferenceSearchPopup {
        x: 8px; y: 48px;
        results: root.search-results;
        selected-index: root.selected-search-index;
        activated(page-index, section-name, title, anchor-y) => {
            root.search-result-activated(page-index, section-name, title, anchor-y);
        }
    }

    if root.key-binding-profile-editor-open : KeyBindingProfileDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        mode: root.key-binding-profile-editor-mode;
        profile-name <=> root.key-binding-profile-editor-name;
        cancelled => { root.key-binding-profile-editor-cancelled(); }
        submitted(profile-name, mode) => { root.key-binding-profile-created(profile-name, mode); }
    }

    if root.key-binding-profile-delete-confirm-open : DeleteKeyBindingProfileDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        cancelled => { root.key-binding-profile-delete-confirm-open = false; }
        confirmed => {
            root.key-binding-profile-delete-confirm-open = false;
            root.key-binding-delete-profile();
        }
    }

    if root.key-binding-editor-open : KeyBindingMappingDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        mapping-key: root.key-binding-editor-key;
        mapping-action <=> root.key-binding-editor-action;
        mapping-comment <=> root.key-binding-editor-comment;
        mapping-kind <=> root.key-binding-editor-kind;
        mapping-row: root.key-binding-editor-row;
        cancelled => { root.key-binding-editor-cancelled(); }
        key-recorded(key, control, alt, shift, meta) => {
            root.key-binding-key-recorded(key, control, alt, shift, meta);
        }
        submitted(key, action, comment, kind, row) => {
            root.key-binding-mapping-submitted(key, action, comment, kind, row);
        }
    }

    if root.plugin-github-sheet-open : PluginInstallDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        repository <=> root.plugin-github-repository;
        installing: root.plugin-github-installing;
        install-requested(repository) => { root.plugin-github-install-requested(repository); }
        cancelled => { root.plugin-github-sheet-open = false; }
    }

    if root.utilities-default-app-sheet-open : DefaultAppDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        video <=> root.utilities-default-video;
        audio <=> root.utilities-default-audio;
        playlist <=> root.utilities-default-playlist;
        cancelled => { root.utilities-default-app-sheet-open = false; }
        confirmed(video, audio, playlist) => {
            root.utilities-default-app-sheet-open = false;
            root.utilities-default-apps-requested(video, audio, playlist);
        }
    }
}
