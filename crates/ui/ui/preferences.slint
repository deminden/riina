    // IINA v1.5.0 enables its newer settings window by default; preserve its
    // page order even while some individual Riina pages are still in progress.
    Rectangle { x: 0; y: 0; width: 200px; height: parent.height;
        background: root.mica-backdrop-enabled ? #f6f6f680 : #f6f6f6;
        PreferenceSearchField { x: 8px; y: 10px; query <=> root.search-query;
            result-count: root.search-results.length;
            selected-index: root.selected-search-index;
            query-changed(query) => {
                root.selected-search-index = -1;
                root.search-query-changed(query);
            }
            move-selection(direction) => { root.search-selection-moved(direction); }
            activate-selection => { root.search-selection-activated(); }
        }
        ScrollView { x: 0; y: 52px; width: parent.width; height: parent.height - 52px;
            content-height: root.navigation-content-height;
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            Rectangle { width: parent.width; height: root.navigation-content-height; background: transparent;
        PreferenceNavItem { x: 10px; y: root.navigation-row-y(0); width: 180px; label: "General";
            icon: @image-url("../../../assets/icons/settings.svg");
            selected: root.selected-pane == 0; activated => { root.selected-pane = 0; root.general-scroll-position = 0px; } }
        if root.selected-pane == 0 : Rectangle { x: 24px; y: 36px; width: 2px; height: 96px; background: #d3d3d7; }
        if root.selected-pane == 0 : PreferenceSubNavItem { x: 32px; y: 36px; width: 158px; label: "Behavior";
            selected: root.selected-general-section == 0;
            activated => { root.selected-general-section = 0; root.general-scroll-position = 0px; } }
        if root.selected-pane == 0 : PreferenceSubNavItem { x: 32px; y: 60px; width: 158px; label: "History";
            selected: root.selected-general-section == 1;
            activated => { root.selected-general-section = 1; root.general-scroll-position = root.general-history-target; } }
        if root.selected-pane == 0 : PreferenceSubNavItem { x: 32px; y: 84px; width: 158px; label: "Playlist";
            selected: root.selected-general-section == 2;
            activated => { root.selected-general-section = 2; root.general-scroll-position = root.general-playlist-target; } }
        if root.selected-pane == 0 : PreferenceSubNavItem { x: 32px; y: 108px; width: 158px; label: "Screenshots";
            selected: root.selected-general-section == 3;
            activated => { root.selected-general-section = 3; root.general-scroll-position = root.general-screenshots-target; } }
        PreferenceNavItem { x: 10px; y: root.navigation-row-y(1); width: 180px; label: "Interface";
            icon: @image-url("../../../assets/icons/interface.svg");
            selected: root.selected-pane == 1; activated => { root.selected-pane = 1; root.selected-interface-section = 0; root.interface-scroll-position = 0px; } }
        if root.selected-pane == 1 : Rectangle { x: 24px; y: 76px; width: 2px; height: 144px; background: #d3d3d7; }
        if root.selected-pane == 1 : PreferenceSubNavItem { x: 32px; y: 72px; width: 158px; label: "Appearance";
            selected: root.selected-interface-section == 0;
            activated => { root.selected-interface-section = 0; root.interface-scroll-position = 0px; } }
        if root.selected-pane == 1 : PreferenceSubNavItem { x: 32px; y: 96px; width: 158px; label: "Window";
            selected: root.selected-interface-section == 1;
            activated => { root.selected-interface-section = 1; root.interface-scroll-position = root.interface-window-target; } }
        if root.selected-pane == 1 : PreferenceSubNavItem { x: 32px; y: 120px; width: 158px; label: "On Screen Controller";
            selected: root.selected-interface-section == 2;
            activated => { root.selected-interface-section = 2; root.interface-scroll-position = root.interface-osc-target; } }
        if root.selected-pane == 1 : PreferenceSubNavItem { x: 32px; y: 144px; width: 158px; label: "On Screen Display";
            selected: root.selected-interface-section == 3;
