    if root.selected-pane == 9 : PluginsPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        plugin-request-github-install => { root.plugin-request-github-install(); }
        plugin-request-local-install => { root.plugin-request-local-install(); }
        plugin-update-status: root.plugin-update-status;
        plugin-refresh => { root.plugin-refresh(); }
        plugin-rows: root.plugin-rows;
        plugin-id-transfer(value) => { return root.plugin-id-transfer(value); }
        plugin-id-from-transfer(value) => { return root.plugin-id-from-transfer(value); }
        plugin-enabled-changed(value1, value2) => { root.plugin-enabled-changed(value1, value2); }
        plugin-row-about(value1) => { root.plugin-row-about(value1); }
        plugin-row-actions(value1) => { root.plugin-row-actions(value1); }
        plugin-reordered(value1, value2) => { root.plugin-reordered(value1, value2); }
    }

    if root.selected-pane == 10 : UtilitiesPreferencesPage {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        mica-backdrop-enabled: root.mica-backdrop-enabled;
        utilities-thumbnail-size: root.utilities-thumbnail-size;
