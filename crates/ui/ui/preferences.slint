    in property <[string]> audio-language-tokens;
    callback add-audio-language-token(string);
    callback remove-audio-language-token(int);
    in-out property <bool> network-cache-enabled: true;
    in-out property <bool> network-cache-pause-initial: false;
    in-out property <string> network-cache-pause-wait-text: "1";
    in-out property <string> network-cache-prefetch-secs-text: "36000";
    in-out property <string> network-cache-size-kib-text: "153600";
    in-out property <bool> network-show-buffering-throbber: true;
    in-out property <bool> network-show-seeking-throbber: true;
    in-out property <string> network-user-agent: "";
