import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NativeTypography } from "shared-controls.slint";
import { JumpDialogButton } from "player-chrome-controls.slint";

export component PluginInteractionWindow inherits Window {
    title: asks-for-text ? "Plugin Prompt" : "Plugin Confirmation";
    default-font-family: NativeTypography.system-font-family;
    preferred-width: 410px;
    min-width: 310px;
    preferred-height: asks-for-text ? 194px : 148px;
    min-height: self.preferred-height;
    background: Theme.player-dialog-surface(dark-theme);
    in property <bool> dark-theme: true;
    in property <bool> asks-for-text;
    in property <string> message;
    in-out property <string> draft;
    callback response(bool, string);
    callback focus-default();

    focus-default => {
        if root.asks-for-text { entry.focus(); }
        else { confirm.focus(); }
    }

    FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.response(false, "");
                return accept;
            }
            return reject;
        }

        ScrollView {
            x: 18px;
            y: 16px;
            width: parent.width - 36px;
            height: parent.height - (root.asks-for-text ? 107px : 61px);
            content-width: self.width;
            content-height: max(self.height, body.preferred-height);
            body := Text {
                width: parent.width - 8px;
                height: self.preferred-height;
                wrap: word-wrap;
                text: root.message;
                font-size: 14px;
                color: Theme.player-dialog-title(root.dark-theme);
            }
        }

        Rectangle {
            visible: root.asks-for-text;
            x: 18px; y: parent.height - 85px;
            width: parent.width - 36px; height: 32px;
            border-radius: 5px; border-width: 1px;
            background: Theme.player-dialog-field-surface(root.dark-theme);
            border-color: entry.has-focus ? Theme.player-dialog-field-focus : Theme.player-dialog-field-border(root.dark-theme);
            entry := TextInput {
                x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px;
                text <=> root.draft; single-line: true;
                font-size: 13px; color: Theme.player-dialog-field-text(root.dark-theme);
                accessible-label: "Response";
                accepted => { root.response(true, root.draft); }
            }
        }

        HorizontalLayout {
            x: parent.width - 162px;
            y: parent.height - 42px;
            width: 144px; height: 26px; spacing: 8px;
            JumpDialogButton {
                label: "Cancel"; dark-theme: root.dark-theme;
                activated => { root.response(false, ""); }
            }
            confirm := JumpDialogButton {
                label: "OK"; dark-theme: root.dark-theme;
                activated => { root.response(true, root.draft); }
            }
        }
    }
}
