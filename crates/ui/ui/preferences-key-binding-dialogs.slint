import { KeyBindingSettingsState } from "preferences-key-bindings.slint";
import { CheckBox, ComboBox } from "std-widgets.slint";
import { KeyBindingActionBuilder } from "preferences-key-binding-builder.slint";
import { PreferenceActionButton } from "preferences-controls.slint";
import { Theme } from "theme.slint";

export component KeyBindingProfileDialog inherits Rectangle {
    in property <int> mode;
    in-out property <string> profile-name;
    callback cancelled();
    callback submitted(string, int);

    background: Theme.settings-modal-scrim;
    Rectangle {
        x: (parent.width - 340px) / 2; y: (parent.height - 168px) / 2;
        width: 340px; height: 168px;
        border-radius: Theme.settings-modal-corner; border-width: 1px; border-color: Theme.settings-modal-border;
        background: Theme.settings-modal-surface;
        Text {
            x: 20px; y: 14px; width: parent.width - 40px; height: 22px;
            text: root.mode == 0 ? @tr("Create key binding set") : root.mode == 1 ? @tr("Duplicate key binding set") : @tr("Rename key binding set");
            font-size: Theme.settings-modal-title-size; font-weight: 600; color: Theme.settings-modal-title;
        }
        Text { x: 20px; y: 42px; width: parent.width - 40px; height: 18px;
            text: root.mode == 2 ? @tr("Enter a new name for this set.") : @tr("Enter a name for the new set."); font-size: 11px; color: Theme.settings-modal-message; }
        Rectangle { x: 20px; y: 70px; width: parent.width - 40px; height: 30px;
            border-radius: 5px; border-width: 1px; border-color: Theme.settings-field-border; background: Theme.settings-field-surface;
            TextInput { x: 7px; y: 1px; width: parent.width - 14px; height: parent.height - 2px;
                text <=> root.profile-name; single-line: true;
                font-size: 11px; color: Theme.settings-modal-title; accessible-label: @tr("Key binding set name"); }
        }
        PreferenceActionButton {
            x: parent.width - 178px; y: 124px; label: @tr("Cancel");
            activated => { root.cancelled(); }
        }
        PreferenceActionButton {
            x: parent.width - 92px; y: 124px;
            label: root.mode == 0 ? @tr("Create") : root.mode == 1 ? @tr("Duplicate") : @tr("Rename");
            activated => {
                if !root.profile-name.is-empty {
                    root.submitted(root.profile-name,
                        root.mode);
                }
            }
        }
    }
}

export component DeleteKeyBindingProfileDialog inherits Rectangle {
    callback cancelled();
    callback confirmed();

    background: Theme.settings-modal-scrim;
    Rectangle {
        x: (parent.width - 340px) / 2; y: (parent.height - 156px) / 2;
        width: 340px; height: 156px;
        border-radius: Theme.settings-modal-corner; border-width: 1px; border-color: Theme.settings-modal-border;
        background: Theme.settings-modal-surface;
        Text {
            x: 20px; y: 16px; width: parent.width - 40px; height: 22px;
            text: @tr("Delete key binding set?");
            font-size: Theme.settings-modal-title-size; font-weight: 600; color: Theme.settings-modal-title;
        }
        Text {
            x: 20px; y: 45px; width: parent.width - 40px; height: 38px;
            text: @tr("The selected set will be removed from this computer.");
            font-size: 11px; color: Theme.settings-modal-message; wrap: word-wrap;
        }
        PreferenceActionButton {
            x: parent.width - 178px; y: 112px; label: @tr("Cancel");
            activated => { root.cancelled(); }
        }
        PreferenceActionButton {
            x: parent.width - 92px; y: 112px; label: @tr("Delete");
            activated => { root.confirmed(); }
        }
    }
}

export component KeyBindingMappingDialog inherits Rectangle {
    in-out property <string> mapping-key;
    in-out property <string> mapping-action;
    in-out property <string> mapping-comment;
    in-out property <int> mapping-kind;
    in property <int> mapping-row;
    in property <string> edit-error;
    callback cancelled();
    callback key-recorded(string, bool, bool, bool, bool);
    callback submitted(string, string, string, int, int);

    private property <bool> ready: builder.draft-valid && !mapping-key.is-empty && !mapping-action.is-empty;

    function submit() {
        if root.ready { root.submitted(root.mapping-key, root.mapping-action, root.mapping-comment, root.mapping-kind, root.mapping-row); }
    }

    init => { capture.focus(); }
    background: Theme.settings-modal-scrim;
    TouchArea { width: parent.width; height: parent.height; }

    panel := FocusScope {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(520px, parent.width - 24px); height: 314px;
        capture-key-pressed(event) => {
            let backward = event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift);
            if backward && capture.has-focus {
                if root.ready { ok-button.focus(); } else { cancel-button.focus(); }
                return accept;
            }
            if event.text == Key.Tab && !backward && (ok-button.has-focus || (!root.ready && cancel-button.has-focus)) {
                capture.focus();
                return accept;
            }
            return reject;
        }
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancelled(); return accept; }
            return reject;
        }
        Rectangle {
            border-radius: Theme.settings-modal-corner; border-width: 1px; border-color: Theme.settings-modal-border;
            background: Theme.settings-modal-surface;
        }
        Text { x: 20px; y: 14px; width: parent.width - 40px; height: 22px;
            text: @tr("Key Mapping"); font-size: Theme.settings-modal-title-size; font-weight: 600; color: Theme.settings-modal-title; }
        Text { x: 20px; y: 38px; width: parent.width - 40px; height: 18px;
            text: @tr("Press any key to record."); font-size: 11px; color: Theme.settings-modal-message; }

        Text { x: 20px; y: 66px; width: 52px; height: 26px; text: @tr("Key");
            font-size: 11px; color: Theme.settings-card-title; vertical-alignment: center; }
        capture := FocusScope {
            x: 76px; y: 66px; width: max(80px, parent.width * 0.50 - 60px); height: 26px;
            accessible-role: button; accessible-label: @tr("Press a key to record its shortcut");
            Rectangle { width: parent.width; height: parent.height;
                border-radius: 4px; border-width: 1px;
                border-color: parent.has-focus ? Theme.settings-accent : Theme.settings-field-border;
                background: Theme.settings-field-surface;
                Text { width: parent.width; height: parent.height;
                    text: root.mapping-key.is-empty ? @tr("Press a key…") : root.mapping-key;
                    font-size: 11px; color: root.mapping-key.is-empty ? Theme.settings-key-binding-capture-placeholder : Theme.settings-modal-title;
                    horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            }
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == Key.Tab || event.text == Key.Backtab { return reject; }
                if !event.repeat {
                    root.key-recorded(event.text, event.modifiers.control,
                        event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                }
                return accept;
            }
            TouchArea { clicked => { capture.focus(); } }
        }
        ComboBox {
            x: capture.x + capture.width + 8px; y: capture.y; width: parent.width - self.x - 20px; height: 26px;
            accessible-label: @tr("Choose a media key");
            model: [@tr("Media keys"), @tr("Play"), @tr("Previous"), @tr("Next")];
            selected => {
                if self.current-index > 0 {
                    let media = ["PLAY", "PREV", "NEXT"];
                    root.mapping-key = media[self.current-index - 1];
                    self.current-index = 0;
                }
            }
        }

        Text { x: 20px; y: 99px; width: 52px; height: 26px; text: @tr("Action");
            font-size: 11px; color: Theme.settings-card-title; vertical-alignment: center; }
        builder := KeyBindingActionBuilder {
            x: 76px; y: 100px; width: parent.width - 96px; height: 59px;
            action-built(action, kind) => { root.mapping-action = action; root.mapping-kind = kind; }
        }
        Text { x: 20px; y: 168px; width: 56px; height: 26px; text: @tr("Command");
            font-size: 11px; color: Theme.settings-card-title; vertical-alignment: center; overflow: elide; }
        Rectangle { x: 76px; y: 168px; width: parent.width - 96px; height: 26px;
            border-radius: 4px; border-width: 1px; border-color: Theme.settings-field-border; background: Theme.settings-field-surface;
            TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                text <=> root.mapping-action; single-line: true;
                font-size: 11px; color: Theme.settings-modal-title; accessible-label: @tr("Mapping action");
                edited => { builder.draft-valid = true; }
                accepted => { root.submit(); }
            }
        }
        CheckBox {
            x: 76px; y: 200px; width: 180px; height: 22px;
            text: @tr("Riina action"); checked: root.mapping-kind == 1;
            toggled => { root.mapping-kind = self.checked ? 1 : 0; }
        }
        Text { x: 20px; y: 228px; width: 52px; height: 26px; text: @tr("Note");
            font-size: 11px; color: Theme.settings-card-title; vertical-alignment: center; }
        Rectangle { x: 76px; y: 228px; width: parent.width - 96px; height: 26px;
            border-radius: 4px; border-width: 1px; border-color: Theme.settings-field-border; background: Theme.settings-field-surface;
            TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                text <=> root.mapping-comment; single-line: true;
                font-size: 11px; color: Theme.settings-modal-title; accessible-label: @tr("Mapping comment");
                accepted => { root.submit(); }
            }
        }
        if !root.edit-error.is-empty : Text {
            x: 20px; y: parent.height - 53px; width: parent.width - 216px; height: 42px;
            text: root.edit-error; font-size: 11px; wrap: word-wrap;
            color: Theme.settings-modal-message; vertical-alignment: center;
        }
        cancel-button := PreferenceActionButton {
            x: parent.width - 178px; y: parent.height - 40px; label: @tr("Cancel");
            activated => { root.cancelled(); }
        }
        ok-button := PreferenceActionButton {
            x: parent.width - 92px; y: parent.height - 40px; label: @tr("OK"); enabled: root.ready;
            activated => { root.submit(); }
        }
    }
}

export component KeyBindingDialogs inherits Rectangle {
    background: transparent;
    callback key-binding-profile-editor-cancelled();
    callback key-binding-profile-created(string, int);
    callback key-binding-delete-profile();
    callback key-binding-editor-cancelled();
    callback key-binding-key-recorded(string, bool, bool, bool, bool);
    callback key-binding-mapping-submitted(string, string, string, int, int);

    if KeyBindingSettingsState.key-binding-profile-editor-open : KeyBindingProfileDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        mode: KeyBindingSettingsState.key-binding-profile-editor-mode;
        profile-name <=> KeyBindingSettingsState.key-binding-profile-editor-name;
        cancelled => { root.key-binding-profile-editor-cancelled(); }
        submitted(profile-name, mode) => { root.key-binding-profile-created(profile-name, mode); }
    }

    if KeyBindingSettingsState.key-binding-profile-delete-confirm-open : DeleteKeyBindingProfileDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        cancelled => { KeyBindingSettingsState.key-binding-profile-delete-confirm-open = false; }
        confirmed => {
            KeyBindingSettingsState.key-binding-profile-delete-confirm-open = false;
            root.key-binding-delete-profile();
        }
    }

    if KeyBindingSettingsState.key-binding-editor-open : KeyBindingMappingDialog {
        x: 0px; y: 0px; width: root.width; height: root.height;
        mapping-key <=> KeyBindingSettingsState.key-binding-editor-key;
        mapping-action <=> KeyBindingSettingsState.key-binding-editor-action;
        mapping-comment <=> KeyBindingSettingsState.key-binding-editor-comment;
        mapping-kind <=> KeyBindingSettingsState.key-binding-editor-kind;
        mapping-row: KeyBindingSettingsState.key-binding-editor-row;
        edit-error: KeyBindingSettingsState.key-binding-editor-error;
        cancelled => { root.key-binding-editor-cancelled(); }
        key-recorded(key, control, alt, shift, meta) => {
            root.key-binding-key-recorded(key, control, alt, shift, meta);
        }
        submitted(key, action, comment, kind, row) => {
            root.key-binding-mapping-submitted(key, action, comment, kind, row);
        }
    }
}
