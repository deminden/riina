import { Theme } from "theme.slint";
import { PlayerCropState } from "player-crop-state.slint";
component CropButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    callback chosen();
    height: 24px; border-radius: 4px;
    background: selected ? Theme.crop-preset-selection : touch.has-hover ? Theme.crop-preset-hover : Theme.crop-preset-surface;
    accessible-role: button; accessible-label: label; accessible-enabled: enabled;
    accessible-action-default => { if enabled { chosen(); } }
    Text { text: label; font-size: 12px; color: root.enabled ? Theme.crop-preset-text : Theme.crop-preset-disabled-text;
        horizontal-alignment: center; vertical-alignment: center; }
    if focus.has-focus : Rectangle { background: transparent; border-radius: 4px; border-width: 1px; border-color: Theme.player-focus-accent; }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.chosen(); } }
    focus := FocusScope { enabled: root.enabled;
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.chosen(); return accept; } return reject; }
    }
}

export component CropEditor inherits Rectangle {
    callback focus-editor();
    focus-editor => { keys.focus(); }
    visible: PlayerCropState.crop-editing; background: transparent;
    keys := FocusScope { enabled: PlayerCropState.crop-editing; width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape { PlayerCropState.finish-custom-crop(false); return accept; }
            if event.text == Key.Return && PlayerCropState.crop-ready { PlayerCropState.finish-custom-crop(true); return accept; }
            if event.text == Key.Tab { return reject; }
            return accept;
        }
        if PlayerCropState.crop-box-width > 0 && PlayerCropState.crop-box-height > 0 : Rectangle {
            x:0px; y:0px; width:parent.width; height:PlayerCropState.crop-box-y * 1px; background:Theme.crop-mask;
        }
        if PlayerCropState.crop-box-width > 0 && PlayerCropState.crop-box-height > 0 : Rectangle {
            x:0px; y:PlayerCropState.crop-box-y * 1px; width:PlayerCropState.crop-box-x * 1px;
            height:PlayerCropState.crop-box-height * 1px; background:Theme.crop-mask;
        }
        if PlayerCropState.crop-box-width > 0 && PlayerCropState.crop-box-height > 0 : Rectangle {
            x:(PlayerCropState.crop-box-x + PlayerCropState.crop-box-width) * 1px; y:PlayerCropState.crop-box-y * 1px;
            width:max(0px,parent.width - self.x); height:PlayerCropState.crop-box-height * 1px; background:Theme.crop-mask;
        }
        if PlayerCropState.crop-box-width > 0 && PlayerCropState.crop-box-height > 0 : Rectangle {
            x:0px; y:(PlayerCropState.crop-box-y + PlayerCropState.crop-box-height) * 1px;
            width:parent.width; height:max(0px,parent.height - self.y); background:Theme.crop-mask;
        }
        if PlayerCropState.crop-ready && PlayerCropState.crop-box-width > 0 && PlayerCropState.crop-box-height > 0 : Rectangle { x:PlayerCropState.crop-box-x * 1px; y:PlayerCropState.crop-box-y * 1px;
            width:PlayerCropState.crop-box-width * 1px; height:PlayerCropState.crop-box-height * 1px;
            border-width:2px; border-color:Theme.playback-progress-accent; background:Theme.crop-selection-fill; }
        free := TouchArea { enabled: PlayerCropState.crop-ready; mouse-cursor:crosshair;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { PlayerCropState.begin-crop-drag(0,self.mouse-x / 1px,self.mouse-y / 1px); }
                if event.kind == PointerEventKind.up { PlayerCropState.end-crop-drag(); }
            }
            // The preset is retained control state, independent of later edits.
            moved => { if self.pressed { PlayerCropState.move-crop-drag(self.mouse-x / 1px,self.mouse-y / 1px); } }
        }
        for edge[index] in [1,2,3,4] : TouchArea {
            enabled: PlayerCropState.crop-ready && PlayerCropState.crop-box-width > 0 && PlayerCropState.crop-box-height > 0;
            mouse-cursor: edge <= 2 ? ew-resize : ns-resize;
            x: (edge == 1 ? PlayerCropState.crop-box-x - 2 : edge == 2 ? PlayerCropState.crop-box-x + PlayerCropState.crop-box-width - 2 : PlayerCropState.crop-box-x) * 1px;
            // Standardize the inset strip even below four points: a negative
            // span reverses its endpoints rather than removing the resize target.
            y: (edge == 3 ? PlayerCropState.crop-box-y - 2 : edge == 4 ? PlayerCropState.crop-box-y + PlayerCropState.crop-box-height - 2 : PlayerCropState.crop-box-y + min(2,PlayerCropState.crop-box-height - 2)) * 1px;
            width: (edge <= 2 ? 4 : PlayerCropState.crop-box-width) * 1px;
            height: (edge <= 2 ? max(PlayerCropState.crop-box-height - 4,4 - PlayerCropState.crop-box-height) : 4) * 1px;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { PlayerCropState.begin-crop-drag(edge,(self.x+self.mouse-x) / 1px,(self.y+self.mouse-y) / 1px); }
                if event.kind == PointerEventKind.up { PlayerCropState.end-crop-drag(); }
            }
            moved => { if self.pressed { PlayerCropState.move-crop-drag((self.x+self.mouse-x) / 1px,(self.y+self.mouse-y) / 1px); } }
        }
        VerticalLayout { x:max(8px,(parent.width - self.width)/2); y:parent.height - self.height - 20px;
            width:min(560px,parent.width - 16px); height:46px; spacing:8px;
            Text { text:PlayerCropState.crop-delogo && PlayerCropState.crop-box-width == 0 ? "Click and drag to select a logo" : PlayerCropState.crop-description;
                font-size:11px; color:Theme.crop-instruction-text; horizontal-alignment:center; }
            HorizontalLayout { spacing:4px; height:24px;
                if !PlayerCropState.crop-delogo : HorizontalLayout {
                    spacing:4px;
                    for label[index] in ["4:3","16:9","16:10","21:9","3:2","5:4"] : CropButton {
                        label:label; selected:PlayerCropState.crop-preset-index == index; enabled:PlayerCropState.crop-ready;
                        chosen => { PlayerCropState.crop-preset-index = index; PlayerCropState.crop-preset(index); }
                    }
                }
                Rectangle { width:8px; background:transparent; }
                CropButton { label:"Cancel"; width:72px; chosen => { PlayerCropState.finish-custom-crop(false); } }
                CropButton { label:PlayerCropState.crop-delogo ? "Apply" : "Done"; width:72px;
                    enabled:PlayerCropState.crop-ready && PlayerCropState.crop-box-width > 0 && PlayerCropState.crop-box-height > 0;
                    chosen => { PlayerCropState.finish-custom-crop(true); } }
            }
        }
    }
}
