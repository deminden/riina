import { ScrollView } from "std-widgets.slint";
import { ScrollReveal } from "scroll-reveal.slint";
import { PlaybackAudioState } from "playback-audio-state.slint";
import { Theme } from "theme.slint";
import { VerticalEqualizerSlider } from "shared-controls.slint";
import { Tool } from "player-tool.slint";
import { QuickSettingsDelayEditor } from "quick-settings-delay.slint";
import { DelayLane } from "delay-lane.slint";
import { QuickSettingsTrackList } from "quick-settings-tracks.slint";
import { AudioEqualizerProfilePicker } from "equalizer-profile-picker.slint";
import { QuickSettingsAction } from "player-sidebar-controls.slint";

export component AudioQuickSettingsPage inherits VerticalLayout {
    in property <length> card-width;
    in property <bool> compact-ui;
    in property <bool> dark-theme;
    callback delete-audio-equalizer-profile();
    callback focus-entered(length, length);
    in property <color> interactive-accent-color;
    callback load-external-audio();
    in property <bool> loaded;
    in property <bool> platform-windows;
    callback format-delay-preview(float) -> string;
    callback rename-audio-equalizer-profile(string) -> bool;
    callback reset-audio-delay();
    callback restore-player-focus();
    callback save-audio-equalizer-profile(string) -> bool;
    callback select-audio-equalizer-profile(int);
    callback set-audio-equalizer(int, float);
    callback set-delay(float);
    callback set-delay-text(string) -> bool;
    callback set-volume-boost(bool);
    in property <color> sidebar-card-material-fill;
    in property <color> sidebar-control-material-fill;
    callback track-selected(int, string);
    callback validate-audio-equalizer-profile-name(string, int) -> string;
    in property <bool> volume-boost;
    in property <color> windows-accent-color;
    in property <bool> windows-sidebar-material-active;

    alignment: start;
    spacing: 1px;
    cross-axis-alignment: center;
    QuickSettingsTrackList {
        focus-entered(top, height) => { root.focus-entered(top, height); }
        width: root.card-width;
        tracks: PlaybackAudioState.audio-tracks; observed-index: PlaybackAudioState.audio-track-selected-index;
        track-kind: 1; hint: "Audio tracks"; enabled: root.loaded;
        dark-theme: root.dark-theme;
        accent-color: root.platform-windows ? root.windows-accent-color : Theme.sidebar-catalog-accent;
        focus-accent-color: root.interactive-accent-color;
        card-fill: root.sidebar-card-material-fill;
        card-edge: Theme.sidebar-card-border(root.dark-theme);
        selected(kind, token) => { root.track-selected(kind, token); }
    }
    // The parent adds 8/6 pt on both sides; this spacer completes
    // IINA's 18/16 pt Audio stack gap in spacious/compact mode.
    Rectangle {
        height: root.compact-ui ? 14px : 16px;
        background: transparent;
    }
    Rectangle {
        width: root.card-width;
        height: 48px; border-radius: 8px; border-width: 1px;
        border-color: Theme.sidebar-card-border(root.dark-theme);
        background: root.sidebar-card-material-fill;
        HorizontalLayout { padding-left: 12px; padding-right: 12px;
            padding-top: 11px; padding-bottom: 11px;
            QuickSettingsAction {
                height: 24px;
                label: "Load External Audio Track…";
                hint: "Load external audio";
                fill: root.sidebar-control-material-fill;
                dark-theme: root.dark-theme;
                focus-accent-color: root.interactive-accent-color;
                enabled: root.loaded;
                focus-entered(top, height) => { root.focus-entered(top, height); }
                activated => { root.load-external-audio(); }
            }
        }
    }
    Rectangle {
        height: root.compact-ui ? 14px : 16px;
        background: transparent;
    }
    Rectangle {
        width: root.card-width;
        height: 92px; border-radius: 8px; border-width: 1px;
        border-color: Theme.sidebar-card-border(root.dark-theme);
        background: root.sidebar-card-material-fill;
        VerticalLayout { padding: 8px; spacing: 4px;
        HorizontalLayout { height: 24px; spacing: 8px;
            Image { source: @image-url("../../../assets/icons/delay.svg");
                image-fit: contain; width: 16px; height: 16px;
                colorize: Theme.sidebar-heading-text(root.dark-theme); }
            Text { text: "Delay"; color: Theme.sidebar-heading-text(root.dark-theme);
                font-size: 12px; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Tool { accent-color: root.interactive-accent-color; dark-theme: root.dark-theme; label: "↺"; hint: "Reset audio delay";
                focus-entered(top, height) => { root.focus-entered(top, height); }
                visible: PlaybackAudioState.audio-delay != 0;
                enabled: root.loaded && PlaybackAudioState.audio-delay != 0;
                activated => { delay-editor.focus-slider(); root.reset-audio-delay(); } }
        }
        delay-editor := QuickSettingsDelayEditor {
            lane: DelayLane.audio;
            label: "Audio delay";
            delay: PlaybackAudioState.audio-delay;
            delay-text: PlaybackAudioState.audio-delay-text;
            enabled: root.loaded;
            accent-color: root.interactive-accent-color;
            dark-theme: root.dark-theme;
            windows-acrylic-surface: root.windows-sidebar-material-active;
            format-preview(value) => { return root.format-delay-preview(value); }
            focus-entered(top, height) => { root.focus-entered(top, height); }
            set-delay(_, value) => { root.set-delay(value); }
            set-delay-text(_, text) => { return root.set-delay-text(text); }
            editing-finished => { root.restore-player-focus(); }
        }
        HorizontalLayout { height: 12px; spacing: 8px;
            HorizontalLayout { horizontal-stretch: 1;
                Text { width: 32px; text: "-5s"; color: Theme.sidebar-secondary-text(root.dark-theme); font-size: 10px; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { width: 32px; text: "0s"; color: Theme.sidebar-secondary-text(root.dark-theme); font-size: 10px; horizontal-alignment: center; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { width: 32px; text: "+5s"; color: Theme.sidebar-secondary-text(root.dark-theme); font-size: 10px; horizontal-alignment: right; }
            }
            Rectangle { width: 72px; background: transparent; }
        }
        }
    }
    Rectangle {
        height: root.compact-ui ? 14px : 16px;
        background: transparent;
    }
    // Keep the default IINA Audio pane hierarchy unchanged. The
    // optional extension is only surfaced here once the user opts in.
    if root.volume-boost : Rectangle {
        width: root.card-width;
        height: 28px; background: transparent;
        accessible-role: checkbox;
        accessible-label: "Allow volume boost (up to 200%)";
        accessible-checkable: true;
        accessible-checked: root.volume-boost;
        accessible-action-default => { delay-editor.focus-slider(); root.set-volume-boost(false); }
        Rectangle { x: 2px; y: 6px; width: 16px; height: 16px;
            border-radius: 3px; border-width: 1px; border-color: Theme.sidebar-boost-checkbox-border;
            background: root.volume-boost
                ? (root.interactive-accent-color)
                : Theme.sidebar-boost-checkbox-fill;
            if root.volume-boost : Text { text: "✓"; color: Theme.sidebar-boost-checkbox-mark;
                horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
        }
        Text { x: 26px; width: parent.width - 26px;
            text: "Allow volume boost (up to 200%)";
            color: Theme.sidebar-heading-text(root.dark-theme);
            font-size: 12px; vertical-alignment: center; }
        if boost-focus.has-focus : Rectangle { border-width: 1px;
            border-color: root.interactive-accent-color; border-radius: 4px; background: transparent; }
        TouchArea { clicked => { delay-editor.focus-slider(); root.set-volume-boost(false); } }
        boost-focus := FocusScope {
            focus-changed-event => {
                if self.has-focus { root.focus-entered(parent.absolute-position.y, parent.height); }
            }
            focus-on-click: false;
            key-pressed(event) => {
                if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                if event.text == " " || event.text == Key.Return {
                    if !event.repeat { delay-editor.focus-slider(); root.set-volume-boost(false); }
                    return accept;
                }
                return reject;
            }
        }
    }
    Rectangle {
        width: root.card-width;
        height: 246px + (equalizer-scroll.content-width > equalizer-scroll.visible-width ? 16px : 0px); border-radius: 8px; border-width: 1px;
        border-color: Theme.sidebar-card-border(root.dark-theme);
        background: root.sidebar-card-material-fill;
        VerticalLayout {
            padding: root.compact-ui ? 10px : 12px;
            spacing: root.compact-ui ? 8px : 12px;
        // IINA stacks the heading and a padded, full-width preset picker.
        HorizontalLayout { height: 18px; spacing: 8px;
            Image { source: @image-url("../../../assets/icons/equalizer.svg");
                image-fit: contain; width: 16px; height: 16px;
                colorize: Theme.sidebar-heading-text(root.dark-theme); }
            Text { text: "Equalizer"; color: Theme.sidebar-heading-text(root.dark-theme); font-size: 12px;
                font-weight: 700; vertical-alignment: center; }
        }
        AudioEqualizerProfilePicker {
            focus-entered(top, height) => { root.focus-entered(top, height); }
                width: parent.width - (root.compact-ui ? 20px : 24px);
                dark-theme: root.dark-theme;
                windows-acrylic-surface: root.windows-sidebar-material-active;
                profile-names: PlaybackAudioState.audio-equalizer-profile-names;
                selected-index: PlaybackAudioState.audio-equalizer-profile-index;
                user-profile-start-index: PlaybackAudioState.audio-equalizer-user-profile-start-index;
                can-save: PlaybackAudioState.audio-equalizer-can-save-profile;
                can-edit: PlaybackAudioState.audio-equalizer-can-edit-profile;
                can-delete: PlaybackAudioState.audio-equalizer-can-delete-profile;
                selected(index) => { root.select-audio-equalizer-profile(index); }
                validate-name(name, mode) => { root.validate-audio-equalizer-profile-name(name, mode) }
                save-requested(name) => { root.save-audio-equalizer-profile(name) }
                rename-requested(name) => { root.rename-audio-equalizer-profile(name) }
                delete-requested => { root.delete-audio-equalizer-profile(); }
        }
        equalizer-scroll := ScrollView {
            width: parent.width - (root.compact-ui ? 20px : 24px);
            height: (root.compact-ui ? 142px : 146px)
                + (self.content-width > self.visible-width ? 16px : 0px);
            content-width: max(self.visible-width, 300px);
            content-height: root.compact-ui ? 142px : 146px;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: as-needed;
            VerticalLayout {
                width: equalizer-scroll.content-width; height: root.compact-ui ? 142px : 146px;
                spacing: root.compact-ui ? 8px : 12px;
        HorizontalLayout { height: 120px; spacing: 1px;
            for label[index] in ["32", "64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"] : VerticalLayout {
                width: 24px;
                VerticalEqualizerSlider { horizontal-stretch: 1; vertical-stretch: 1;
                    focus-entered(top, height) => {
                        let start = self.absolute-position.x - equalizer-scroll.absolute-position.x;
                        equalizer-scroll.content-x = ScrollReveal.offset(equalizer-scroll.content-x, start,
                            self.width, equalizer-scroll.visible-width, equalizer-scroll.content-width);
                        root.focus-entered(top, height);
                    }
                    dark-theme: root.dark-theme; minimum: -12; maximum: 12;
                    step: 0.1; value: PlaybackAudioState.audio-equalizer-values[index];
                    hint: label + " Hz equalizer gain";
                    changed(value) => { root.set-audio-equalizer(index, value); }
                }
            }
            Rectangle { width: 48px; height: 120px; background: transparent;
                Text { x: 0px; y: -3px; width: parent.width; text: "+12 dB"; height: 14px;
                    color: Theme.sidebar-secondary-text(root.dark-theme);
                    font-size: 10px; vertical-alignment: center;
                    horizontal-alignment: right; }
                Text { x: 0px; y: 45px; width: parent.width; text: "0 dB"; height: 14px;
                    color: Theme.sidebar-secondary-text(root.dark-theme);
                    font-size: 10px; vertical-alignment: center;
                    horizontal-alignment: right; }
                Text { x: 0px; y: 93px; width: parent.width; text: "-12 dB"; height: 14px;
                    color: Theme.sidebar-secondary-text(root.dark-theme);
                    font-size: 10px; vertical-alignment: center;
                    horizontal-alignment: right; }
            }
        }
        HorizontalLayout { height: 14px; spacing: 1px;
            for label in ["32", "64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"] : Text {
                width: 24px; text: label;
                color: Theme.sidebar-secondary-text(root.dark-theme);
                font-size: 10px; horizontal-alignment: center;
            }
            Rectangle { width: 48px; background: transparent; }
        }
            }
        }
        }
    }
}
