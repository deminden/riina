import { Theme } from "theme.slint";
import { Button, HorizontalBox } from "std-widgets.slint";
import { NativeTypography } from "shared-controls.slint";

export component PictureInPictureWindow inherits Window {
    default-font-family: NativeTypography.system-font-family;
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    in property <string> media-title: "riina";
    in property <bool> paused: false;
    in-out property <bool> acrylic-backdrop-enabled: false;
    callback play-pause();
    callback stop();
    callback skip(float);
    callback exit-picture-in-picture();

    title: media-title;
    preferred-width: 480px;
    preferred-height: 326px;
    min-width: 360px;
    min-height: 258px;
    background: acrylic-backdrop-enabled ? transparent : Theme.pip-window-surface;

    Rectangle {
        background: root.acrylic-backdrop-enabled ? transparent : Theme.pip-window-surface;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height - 54px;
            background: Theme.pip-video-background;
        }
        Rectangle {
            x: 0;
            y: parent.height - 54px;
            width: parent.width;
            height: 54px;
            background: Theme.pip-overlay-surface(root.acrylic-backdrop-enabled);

            HorizontalBox {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;

                Button { text: "−15"; clicked => { root.skip(-15); } }
                Button {
                    text: root.paused ? "Play" : "Pause";
                    clicked => { root.play-pause(); }
                }
                Button {
                    text: "■";
                    accessible-label: "Stop playback";
                    clicked => { root.stop(); }
                }
                Button { text: "+15"; clicked => { root.skip(15); } }
                Text {
                    text: root.media-title;
                    color: Theme.pip-overlay-text;
                    font-size: 12px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Button {
                    text: "×";
                    clicked => { root.exit-picture-in-picture(); }
                }
            }
        }
    }
}
