import { PlayerMusicModeState } from "player-music-mode-state.slint";
import { PlayerPreferences } from "player-preferences.slint";
import { PlayerAppearance } from "player-appearance.slint";
import { PlaybackAudioState } from "playback-audio-state.slint";
import { PlaybackSubtitleState } from "playback-subtitle-state.slint";
import { PlaybackTimelineState } from "playback-timeline-state.slint";
import { PlayerMenuActions } from "player-menu-actions.slint";
import { Theme } from "theme.slint";
import { MusicModeControls } from "music-mode-controls.slint";
import { ToolbarAction } from "player-chrome-controls.slint";
import { Tool } from "player-tool.slint";
import { PlayerSlider } from "shared-controls.slint";

struct ControllerGeometry {
    window-width: length,
    window-height: length,
    available-width: length,
    available-height: length,
    video-width: length,
    video-inset-leading: length,
    video-inset-top: length,
    sidebar-leading-extent: length,
    sidebar-trailing-extent: length,
    edge-to-edge-video: bool,
    osc-position: int,
    osc-height: length,
}

struct ControllerLayout {
    osc-row-gap: length,
    osc-row-height: length,
    osc-row-inline-inset: length,
    osc-timeline-gap: length,
    osc-timeline-height: length,
    osc-timeline-inline-inset: length,
    transport-neighbor-actions-fit: bool,
    small-video-controller: bool,
    music-mode-time-label-min-width: length,
}

struct ControllerMaterial {
    video-blurred-frame: image,
    render-width: length,
    render-height: length,
    video-material-sample-opacity: float,
}

struct ControllerAudio {
    volume-limit: float,
    control-disable-volume-slider-scrolling: bool,
}

struct ControllerToolbar {
    toolbar-visible-order: [int],
    loaded: bool,
    screenshot-available: bool,
    live-text-available: bool,
    live-text-enabled: bool,
    picture-in-picture-active: bool,
    fullscreen: bool,
    sidebar: int,
    leading-sidebar: int,
    remembered-settings-pane: int,
    remembered-playlist-pane: int,
}

export component PlayerController inherits Rectangle {
    in property <ControllerGeometry> geometry;
    in property <ControllerLayout> layout;
    in property <bool> native-video;
    in property <ControllerMaterial> material;
    in property <ControllerAudio> audio;
    in property <float> video-display-aspect-ratio;
    in property <ControllerToolbar> toolbar;
    in property <string> media-title;
    in-out property <bool> control-bar-dragging;
    in-out property <bool> control-bar-hovered;
    in-out property <float> control-bar-position-horizontal;
    in-out property <float> control-bar-position-vertical;
    in-out property <bool> controls-visible;
    in property <bool> paused;
    callback activity();
    callback layout-settings-changed();
    callback seek-scroll-action-request(float, float) -> bool;
    callback set-ab-loop-point(int, float);
    callback set-volume(float);
    callback timeline-hovered(float);
    callback volume-scroll-action-request(float, float) -> bool;

    clip: true;
    // IINA's OSCToolbarButton uses 24-point frames and a zero-spacing
    // NSStackView; retain those bounds while allowing compact rows to clip vertically.
    private property <length> toolbar-button-width: Theme.controller-toolbar-button-size;
    private property <length> toolbar-gap: 0px;
    private property <length> toolbar-width: root.toolbar.toolbar-visible-order.length * toolbar-button-width +
        max(0, root.toolbar.toolbar-visible-order.length - 1) * toolbar-gap;
    private property <length> side-width: max(116px, toolbar-width);
    private property <bool> side-controls-fit: self.width >= transport-width +
        side-width * 2 + 2 * root.layout.osc-row-inline-inset + 4 * root.layout.osc-row-gap;
    // In constrained windows, hide the volume slider first and retain
    // the four configured right-side actions using smaller hit targets.
    private property <bool> compact-toolbar-fit: root.layout.small-video-controller &&
        self.width >= 2 * root.layout.osc-row-inline-inset + toolbar-width + 30px +
            (root.layout.transport-neighbor-actions-fit ? 60px : 0px) +
            (root.layout.transport-neighbor-actions-fit ? 20px : 12px);
    private property <bool> toolbar-actions-fit: side-controls-fit || compact-toolbar-fit;
    private property <length> transport-width: root.layout.transport-neighbor-actions-fit
        ? (root.geometry.osc-position == 0 ? 120px : 104px) : 24px;
    // Equal side reservations keep Play centered even without audio or
    // with a customized toolbar. Below this fit limit, retain the
    // Windows narrow-window packed row so every action stays reachable.
    private property <length> balanced-side-width: side-controls-fit ? side-width :
        compact-toolbar-fit && self.width >= 2 * root.layout.osc-row-inline-inset +
            2 * toolbar-width + transport-width + 4 * root.layout.osc-row-gap ? toolbar-width : 0px;
    // Edge-to-edge keeps video behind sidebars, but the controls must
    // stay in the unobscured video area so their actions remain visible.
    private property <length> osc-video-leading-inset:
        !PlayerMusicModeState.music-mode ? (root.geometry.edge-to-edge-video ? root.geometry.sidebar-leading-extent : root.geometry.video-inset-leading) : 0px;
    private property <length> osc-video-width:
        !PlayerMusicModeState.music-mode ? (root.geometry.edge-to-edge-video
            ? max(1px, root.geometry.window-width - root.geometry.sidebar-leading-extent - root.geometry.sidebar-trailing-extent)
            : root.geometry.video-width) : root.geometry.available-width;
    width: PlayerMusicModeState.music-mode ? root.geometry.available-width :
        root.geometry.osc-position == 0 ? min(osc-video-width, max(200px, min(460px, osc-video-width - 2px))) :
        osc-video-width;
    animate width { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-reposition-duration; }
    height: root.geometry.osc-height;
    x: PlayerMusicModeState.music-mode ? 0px :
        osc-video-leading-inset + (root.geometry.osc-position == 0 ? clamp(
            osc-video-width * (osc-video-width < 462px ? 0.5 : root.control-bar-position-horizontal) - self.width / 2,
            0px, max(0px, osc-video-width - self.width)) : 0px);
    animate x { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-reposition-duration; }
    // Keep the transport row outside the playlist's hit-test surface
    // in the compact music layout so Play/Pause remains directly usable.
    // IINA stores this fraction as a bottom inset and clamps its top
    // edge to 25 points; convert that bottom-origin rule to Slint's
    // top-origin coordinates before positioning the full visible bar.
    y: PlayerMusicModeState.music-mode ? root.geometry.available-height -
            (PlayerMusicModeState.music-mode-show-playlist ? 300px : 0px) - self.height :
        root.geometry.osc-position == 1 ? min(max(0px, root.geometry.available-height - self.height), PlayerAppearance.compact-ui ? 30px : 34px) :
        root.geometry.osc-position == 2 ? max(0px, root.geometry.available-height - self.height) :
            max(0px, root.geometry.available-height -
                min(max(0px, root.geometry.available-height - 67px - 25px),
                    max(0px, root.geometry.available-height * root.control-bar-position-vertical)) - self.height);
    opacity: PlayerMusicModeState.music-mode || root.controls-visible ? 1 : 0;
    animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-visibility-duration; }
    border-radius: PlayerMusicModeState.music-mode ? 0px : root.geometry.osc-position == 0 ? 12px : 4px;
    background: Theme.controller-surface(
        PlayerAppearance.dark-theme, PlayerAppearance.active-liquid-glass-osc,
        PlayerAppearance.platform-windows, root.native-video);
    if PlayerAppearance.active-liquid-glass-osc : Image {
        source: root.material.video-blurred-frame;
        x: root.geometry.video-inset-leading - parent.x;
        y: root.geometry.video-inset-top - parent.y;
        width: root.material.render-width;
        height: root.material.render-height;
        opacity: root.material.video-material-sample-opacity;
        image-fit: contain;
    }
    border-width: 1px; border-color: Theme.controller-border;
    // This is a tinted SDR approximation, not a claim of matching AppKit video blur.
    // The 24-point transport row, padded 24-point timeline, source
    // insets, and 8-point gap reproduce IINA's visible floating panel.
    TouchArea {
        width: parent.width; height: parent.height;
        private property <float> drag-start-x: 0;
        private property <float> drag-start-y: 0;
        private property <float> drag-origin-x: 0;
        private property <float> drag-origin-y: 0;
        moved => {
            if self.pressed && root.geometry.osc-position == 0 && !PlayerMusicModeState.music-mode {
                let available-x = max(0px, osc-video-width - root.width);
                let available-y = max(0, root.geometry.window-height / 1px - root.height / 1px);
                // AppKit constrains the left edge to 10 points, but lets
                // the right edge reach the video boundary. Its bottom-
                // origin y range converts to a 25-point top inset here.
                let minimum-x = min(10, available-x / 1px);
                let minimum-y = min(25, available-y);
                let requested-x = drag-origin-x + self.mouse-x / 1px - drag-start-x;
                let requested-y = drag-origin-y + self.mouse-y / 1px - drag-start-y;
                let bounded-x = clamp(requested-x, minimum-x, available-x / 1px);
                let bounded-y = clamp(requested-y, minimum-y, available-y);
                let center-x = (osc-video-width / 1px - root.width / 1px) / 2;
                let snapped-x = abs(bounded-x - center-x) <= 5 ? center-x : bounded-x;
                root.control-bar-position-horizontal = (snapped-x + root.width / 2 / 1px) / max(1, osc-video-width / 1px);
                root.control-bar-position-vertical = (root.geometry.window-height / 1px - bounded-y - root.height / 1px) / max(1, root.geometry.window-height / 1px);
                root.control-bar-dragging = true;
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down
                && root.geometry.osc-position == 0 && !PlayerMusicModeState.music-mode {
                drag-start-x = self.mouse-x / 1px;
                drag-start-y = self.mouse-y / 1px;
                drag-origin-x = (root.x - osc-video-leading-inset) / 1px;
                drag-origin-y = root.y / 1px;
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up
                && root.control-bar-dragging {
                root.control-bar-dragging = false;
                root.layout-settings-changed();
            }
        }
        changed has-hover => {
            root.control-bar-hovered = self.has-hover;
            if PlayerMusicModeState.music-mode && !self.has-hover { PlayerMusicModeState.music-mode-volume-open = false; }
        }
        VerticalLayout { width: parent.width; height: parent.height;
        padding-top: PlayerMusicModeState.music-mode ? 8px : root.geometry.window-height < 24px ? 0px : root.geometry.window-height < 42px ? 1px : root.layout.small-video-controller ? 5px : PlayerAppearance.compact-ui ? 10px : 14px;
        padding-bottom: PlayerMusicModeState.music-mode ? 8px : root.geometry.window-height < 24px ? 0px : root.geometry.window-height < 42px ? 1px : root.layout.small-video-controller ? 4px : PlayerAppearance.compact-ui ? 5px : 8px;
        // IINA's floating OSC keeps an 8 pt gap between the top row
        // and timeline in both spacious and compact layouts.
        spacing: PlayerMusicModeState.music-mode ? 6px : root.geometry.window-height < 24px ? 0px : root.geometry.window-height < 42px ? 1px : root.layout.small-video-controller ? 3px : 8px;
        Rectangle {
            horizontal-stretch: 1;
            height: PlayerMusicModeState.music-mode ? 32px : root.layout.osc-row-height;
            background: transparent;
            if PlayerMusicModeState.music-mode : MusicModeControls {
                y: 4px; width: parent.width;
                paused: root.paused; muted: PlaybackAudioState.muted; dark-theme: PlayerAppearance.dark-theme;
                accent-color: PlayerAppearance.interactive-accent-color;
                playlist-visible: PlayerMusicModeState.music-mode-show-playlist;
                artwork-visible: PlayerMusicModeState.music-mode-show-album-art;
                opacity: root.controls-visible ? 1 : 0;
                animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-content-fade-duration; }
                pause-requested => { PlayerMenuActions.toggle-pause(); }
                previous-requested => { PlayerMenuActions.playlist-previous(); }
                next-requested => { PlayerMenuActions.playlist-next(); }
                volume-requested => {
                    if !PlayerMusicModeState.music-mode-volume-open { PlayerMusicModeState.music-mode-volume-open = true; }
                    else { PlayerMenuActions.toggle-mute(); }
                }
                playlist-requested => { PlayerMusicModeState.music-mode-show-playlist = !PlayerMusicModeState.music-mode-show-playlist; }
                artwork-requested => { PlayerMusicModeState.music-mode-show-album-art = !PlayerMusicModeState.music-mode-show-album-art; }
            }
            if !PlayerMusicModeState.music-mode : HorizontalLayout {
            x: 0px; y: 0px;
            width: parent.width; height: root.layout.osc-row-height;
            opacity: root.controls-visible ? 1 : 0;
            animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-content-fade-duration; }
            padding-left: root.layout.osc-row-inline-inset;
            padding-right: root.layout.osc-row-inline-inset;
            spacing: root.layout.osc-row-gap;
            if !PlayerMusicModeState.music-mode && root.balanced-side-width > 0px : Rectangle {
                width: root.balanced-side-width; height: root.layout.osc-row-height;
                if root.side-controls-fit && PlaybackAudioState.has-active-audio-track : HorizontalLayout {
                    width: 116px; height: root.layout.osc-row-height; spacing: 4px;
                    Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; height: root.layout.osc-row-height;
                        icon: PlaybackAudioState.muted ? @image-url("../../../assets/icons/muted.svg") : @image-url("../../../assets/icons/volume.svg");
                        hint: "Mute"; activated => { PlayerMenuActions.toggle-mute(); } }
                    PlayerSlider { dark-theme: PlayerAppearance.dark-theme; width: 82px; height: root.layout.osc-row-height;
                        minimum: 0; maximum: root.audio.volume-limit; value: PlaybackAudioState.volume; hint: "Volume";
                        scroll-override-enabled: !root.audio.control-disable-volume-slider-scrolling;
                        scroll-disabled: root.audio.control-disable-volume-slider-scrolling;
                        scroll-request(delta-x, delta-y) => { root.volume-scroll-action-request(delta-x, delta-y); }
                        changed is-dragging => { root.control-bar-dragging = self.is-dragging; }
                        changed(value) => { root.set-volume(value); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            HorizontalLayout {
                spacing: PlayerMusicModeState.music-mode ? 2px : root.geometry.osc-position == 0 ? 24px : 16px;
                if root.layout.transport-neighbor-actions-fit : Tool { accent-color: PlayerAppearance.interactive-accent-color;
                    dark-theme: PlayerAppearance.dark-theme; width: 24px; height: root.layout.osc-row-height; icon-size: 24px;
                    icon: PlayerMusicModeState.music-mode
                        ? @image-url("../../../assets/icons/skip-previous.svg")
                        : @image-url("../../../assets/icons/speed-down.svg");
                    hint: PlayerMusicModeState.music-mode ? "Previous media" : "Half playback speed";
                    activated => {
                        if PlayerMusicModeState.music-mode { PlayerMenuActions.playlist-previous(); }
                        else { PlayerMenuActions.speed(0.5); }
                    }
                }
                Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme;
                    width: 24px; height: root.layout.osc-row-height; icon-size: 24px;
                    // The triangular ink's centroid sits 2.83 pt left of
                    // its SVG center. Balance its optical weight without
                    // moving the hit target or the symmetric pause bars.
                    icon-optical-offset-x: root.paused ? 2.5px : 0px;
                    icon: root.paused ? @image-url("../../../assets/icons/osc-play.svg") : @image-url("../../../assets/icons/osc-pause.svg"); hint: root.paused ? "Play" : "Pause";
                    activated => { PlayerMenuActions.toggle-pause(); } }
                if root.layout.transport-neighbor-actions-fit : Tool { accent-color: PlayerAppearance.interactive-accent-color;
                    dark-theme: PlayerAppearance.dark-theme; width: 24px; height: root.layout.osc-row-height; icon-size: 24px;
                    icon: PlayerMusicModeState.music-mode
                        ? @image-url("../../../assets/icons/skip-next.svg")
                        : @image-url("../../../assets/icons/speed-up.svg");
                    hint: PlayerMusicModeState.music-mode ? "Next media" : "Double playback speed";
                    activated => {
                        if PlayerMusicModeState.music-mode { PlayerMenuActions.playlist-next(); }
                        else { PlayerMenuActions.speed(2); }
                    }
                }
            }
            if !PlayerMusicModeState.music-mode : Rectangle { horizontal-stretch: 1; background: transparent; }
            if !PlayerMusicModeState.music-mode && root.toolbar-actions-fit : Rectangle {
                width: max(root.balanced-side-width, root.toolbar-width); height: root.layout.osc-row-height;
                HorizontalLayout {
                x: parent.width - self.width;
                width: root.toolbar-width; height: root.layout.osc-row-height;
                spacing: root.toolbar-gap;
                for action-kind in root.toolbar.toolbar-visible-order : ToolbarAction {
                kind: action-kind;
                action-width: root.toolbar-button-width;
                action-height: min(root.toolbar-button-width, root.layout.osc-row-height);
                height: root.layout.osc-row-height;
                dark-theme: PlayerAppearance.dark-theme;
                enabled: (action-kind != 5 || (root.toolbar.loaded && PlaybackSubtitleState.subtitle-tracks.length > 1)) &&
                    (action-kind != 6 || root.toolbar.screenshot-available) &&
                    (action-kind != 8 || root.toolbar.live-text-available);
                selected: action-kind == 0 ? (root.toolbar.sidebar == 1 || root.toolbar.sidebar == 2 || root.toolbar.sidebar == 5 || root.toolbar.sidebar == 6 ||
                        root.toolbar.leading-sidebar == 1 || root.toolbar.leading-sidebar == 2 || root.toolbar.leading-sidebar == 5 || root.toolbar.leading-sidebar == 6) :
                    action-kind == 1 ? (root.toolbar.sidebar == 3 || root.toolbar.sidebar == 4 || root.toolbar.leading-sidebar == 3 || root.toolbar.leading-sidebar == 4) :
                    action-kind == 2 ? root.toolbar.picture-in-picture-active :
                    action-kind == 3 ? root.toolbar.fullscreen :
                    action-kind == 4 ? PlayerMusicModeState.music-mode : action-kind == 8 ? root.toolbar.live-text-enabled : false;
                hint: action-kind == 0 ? "Quick Settings" :
                    action-kind == 1 ? "Playlist and chapters" :
                    action-kind == 2 ? "Toggle Picture-in-Picture" :
                    action-kind == 3 ? (root.toolbar.fullscreen ? "Exit Full Screen" : "Enter Full Screen") :
                    action-kind == 4 ? (PlayerMusicModeState.music-mode ? "Exit Music Mode" : "Enter Music Mode") :
                    action-kind == 5 ? "Switch Subtitle Track" :
                    action-kind == 6 ? "Take Screenshot" :
                    action-kind == 7 ? "Show plugins panel" : "Live Text";
                activated(kind) => {
                    if kind == 0 { PlayerMenuActions.toggle-settings-pane(root.toolbar.remembered-settings-pane); }
                    else if kind == 1 { PlayerMenuActions.toggle-playlist-pane(root.toolbar.remembered-playlist-pane); }
                    else if kind == 2 { PlayerMenuActions.toggle-picture-in-picture(); }
                    else if kind == 3 { PlayerMenuActions.toggle-fullscreen(); }
                    else if kind == 4 { PlayerMenuActions.toggle-music-mode(); }
                    else if kind == 5 { PlayerMenuActions.cycle-subtitle-track(); }
                    else if kind == 6 { PlayerMenuActions.take-screenshot(); }
                    else if kind == 7 { PlayerMenuActions.toggle-plugins-pane(); }
                    else if kind == 8 { PlayerMenuActions.toggle-live-text(); }
                }
            }
            }
            }
        }
            if PlayerMusicModeState.music-mode : HorizontalLayout {
            x: 0px; y: 0px; width: parent.width; height: 27px;
            opacity: root.controls-visible ? 0 : 1;
            animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-content-fade-duration; }
            padding-left: 16px; padding-right: 16px;
            VerticalLayout {
                spacing: 0px;
                Text { text: root.media-title; color: Theme.music-mode-title-text(PlayerAppearance.dark-theme);
                    font-size: 13px; font-weight: 600; horizontal-alignment: center;
                    overflow: elide; }
                Text {
                    text: PlayerMusicModeState.music-artist + (PlayerMusicModeState.music-artist != "" && PlayerMusicModeState.music-album != "" ? " · " : "") + PlayerMusicModeState.music-album;
                    visible: PlayerMusicModeState.music-artist != "" || PlayerMusicModeState.music-album != "";
                    color: Theme.music-mode-metadata-text(PlayerAppearance.dark-theme); font-size: 11px;
                    horizontal-alignment: center; overflow: elide;
                }
            }
        }
            if PlayerMusicModeState.music-mode && !root.controls-visible : TouchArea {
                width: parent.width; height: parent.height;
                moved => { root.controls-visible = true; root.activity(); }
                clicked => { root.activity(); }
            }
        }
        if root.layout.osc-timeline-height > 0px : HorizontalLayout {
            height: root.layout.osc-timeline-height; vertical-stretch: 0;
            padding-left: root.layout.osc-timeline-inline-inset;
            padding-right: root.layout.osc-timeline-inline-inset;
            // IINA gives each centered time label a 46-point minimum
            // and keeps a 2-point gap to the native playback slider.
            spacing: root.layout.osc-timeline-gap;
            Text { visible: root.geometry.window-width >= 150px; min-width: PlayerMusicModeState.music-mode ? root.layout.music-mode-time-label-min-width : root.layout.small-video-controller ? 34px : 46px;
                horizontal-alignment: PlayerMusicModeState.music-mode ? right : center;
                text: PlaybackTimelineState.position-label; color: Theme.controller-time-text(PlayerAppearance.dark-theme);
                font-size: root.layout.small-video-controller ? 10px : 11px; vertical-alignment: center; }
            PlayerSlider { dark-theme: PlayerAppearance.dark-theme; height: root.layout.small-video-controller ? 14px : 13px;
                knob-width: 3px; knob-height: root.layout.small-video-controller ? 12px : 15px; knob-radius: 1px;
                scroll-override-enabled: PlaybackTimelineState.seekable && !PlayerPreferences.control-disable-play-slider-scrolling;
                scroll-disabled: PlayerPreferences.control-disable-play-slider-scrolling;
                scroll-request(delta-x, delta-y) => { root.seek-scroll-action-request(delta-x, delta-y); }
                loop-a-visible: PlaybackTimelineState.ab-loop-a-known; loop-a-value: PlaybackTimelineState.ab-loop-a;
                loop-b-visible: PlaybackTimelineState.ab-loop-b-known; loop-b-value: PlaybackTimelineState.ab-loop-b;
                show-chapter-positions: PlayerPreferences.show-chapter-pos; chapter-times: PlaybackTimelineState.chapter-times;
                preview-enabled: PlaybackTimelineState.seekable && PlayerPreferences.thumbnail-preview-enabled;
                preview-image: PlaybackTimelineState.timeline-thumbnail-image;
                preview-label: PlaybackTimelineState.timeline-preview-label; preview-width: PlaybackTimelineState.thumbnail-preview-width;
                preview-aspect-ratio: root.video-display-aspect-ratio > 0 ? root.video-display-aspect-ratio : 16 / 9;
                preview-above: root.geometry.osc-position != 1;
                minimum: 0; maximum: max(1, PlaybackTimelineState.duration); value: PlaybackTimelineState.position; enabled: PlaybackTimelineState.seekable; hint: "Playback position";
                changed is-dragging => { root.control-bar-dragging = self.is-dragging; }
                changed(value) => { PlayerMenuActions.seek(value); }
                loop-a-moved(value) => { root.set-ab-loop-point(0, value); }
                loop-b-moved(value) => { root.set-ab-loop-point(1, value); }
                preview-requested(value) => { root.timeline-hovered(value); }
                preview-dismissed => { root.timeline-hovered(-1); } }
            Text { visible: root.geometry.window-width >= 150px; min-width: PlayerMusicModeState.music-mode ? root.layout.music-mode-time-label-min-width : root.layout.small-video-controller ? 34px : 46px;
                horizontal-alignment: PlayerMusicModeState.music-mode ? left : center;
                text: PlaybackTimelineState.duration-label; color: Theme.controller-time-text(PlayerAppearance.dark-theme);
                font-size: root.layout.small-video-controller ? 10px : 11px; vertical-alignment: center; }
        }
        }
    }
    if PlayerMusicModeState.music-mode && PlayerMusicModeState.music-mode-volume-open : Rectangle {
        x: parent.width - 156px; y: 2px; width: 148px; height: 36px;
        border-radius: 18px;
        background: Theme.music-mode-volume-surface(PlayerAppearance.dark-theme, PlayerAppearance.active-liquid-glass-osc);
        border-width: 1px; border-color: Theme.music-mode-volume-border;
        HorizontalLayout {
            x: 8px; y: 4px; width: parent.width - 16px; height: parent.height - 8px; spacing: 6px;
            Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; width: 24px; height: 24px;
                icon: PlaybackAudioState.muted ? @image-url("../../../assets/icons/muted.svg") : @image-url("../../../assets/icons/volume.svg");
                hint: "Mute"; activated => { PlayerMenuActions.toggle-mute(); } }
            PlayerSlider { dark-theme: PlayerAppearance.dark-theme; horizontal-stretch: 1; height: 17px;
                minimum: 0; maximum: root.audio.volume-limit; value: PlaybackAudioState.volume; hint: "Volume";
                scroll-override-enabled: !root.audio.control-disable-volume-slider-scrolling;
                scroll-disabled: root.audio.control-disable-volume-slider-scrolling;
                scroll-request(delta-x, delta-y) => { root.volume-scroll-action-request(delta-x, delta-y); }
                changed is-dragging => { root.control-bar-dragging = self.is-dragging; }
                changed(value) => { root.set-volume(value); } }
        }
    }
}
