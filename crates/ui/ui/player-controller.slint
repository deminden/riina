import { PlayerControlActions } from "player-control-actions.slint";
import { PlayerControlsState } from "player-controls-state.slint";
import { PlayerLayoutState } from "player-layout-state.slint";
import { PlayerPreferences } from "player-preferences.slint";
import { PlayerAppearance } from "player-appearance.slint";
import { PlaybackAudioState } from "playback-audio-state.slint";
import { PlayerMenuActions, SubtitleMenuSource } from "player-menu-actions.slint";
import { Theme } from "theme.slint";
import { ToolbarAction } from "player-chrome-controls.slint";
import { Tool } from "player-tool.slint";
import { ControllerArrow } from "controller-arrow.slint";
import { PlayerSlider } from "shared-controls.slint";
import { ControllerTimeline } from "controller-timeline.slint";

struct ControllerGeometry {
    window-width: length,
    window-height: length,
    available-height: length,
    video-width: length,
    video-inset-leading: length,
    video-inset-top: length,
    sidebar-leading-extent: length,
    sidebar-trailing-extent: length,
    osc-height: length,
}

struct ControllerLayout {
    osc-row-gap: length,
    osc-row-height: length,
    osc-row-inline-inset: length,
    osc-timeline-gap: length,
    osc-timeline-height: length,
    osc-timeline-inline-inset: length,
    transport-neighbor-actions-fit: bool,
    small-video-controller: bool,
}

struct ControllerMaterial {
    video-blurred-frame: image,
    render-width: length,
    render-height: length,
    video-material-sample-opacity: float,
}

struct ControllerAudio {
    volume-limit: float,
    control-disable-volume-slider-scrolling: bool,
}

struct ControllerToolbar {
    loaded: bool,
    screenshot-available: bool,
    live-text-available: bool,
    live-text-enabled: bool,
    picture-in-picture-active: bool,
    fullscreen: bool,
    sidebar: int,
    leading-sidebar: int,
    remembered-settings-pane: int,
    remembered-playlist-pane: int,
}

export component PlayerController inherits Rectangle {
    in property <ControllerGeometry> geometry;
    in property <ControllerLayout> layout;
    in property <bool> native-video;
    in property <ControllerMaterial> material;
    in property <ControllerAudio> audio;
    in property <float> video-display-aspect-ratio;
    in property <ControllerToolbar> toolbar;
    in property <bool> paused;
    callback layout-settings-changed();

    clip: true;
    // IINA's OSCToolbarButton uses 24-point frames and a zero-spacing
    // NSStackView; retain those bounds while allowing compact rows to clip vertically.
    private property <length> toolbar-button-width: Theme.controller-toolbar-button-size;
    private property <length> toolbar-gap: 0px;
    private property <length> toolbar-width: PlayerControlsState.toolbar-visible-order.length * toolbar-button-width +
        max(0, PlayerControlsState.toolbar-visible-order.length - 1) * toolbar-gap;
    private property <length> side-width: max(116px, toolbar-width);
    private property <bool> side-controls-fit: self.width >= transport-width +
        side-width * 2 + 2 * root.layout.osc-row-inline-inset + 4 * root.layout.osc-row-gap;
    // In constrained windows, hide the volume slider first and retain
    // the four configured right-side actions using smaller hit targets.
    private property <bool> compact-toolbar-fit: root.layout.small-video-controller &&
        self.width >= 2 * root.layout.osc-row-inline-inset + toolbar-width + 30px +
            (root.layout.transport-neighbor-actions-fit ? 60px : 0px) +
            (root.layout.transport-neighbor-actions-fit ? 20px : 12px);
    private property <bool> toolbar-actions-fit: side-controls-fit || compact-toolbar-fit;
    private property <length> transport-width: root.layout.transport-neighbor-actions-fit
        ? (PlayerLayoutState.osc-position == 0 ? 120px : 104px) : 24px;
    // Equal side reservations keep Play centered even without audio or
    // with a customized toolbar. Below this fit limit, retain the
    // Windows narrow-window packed row so every action stays reachable.
    private property <length> balanced-side-width: side-controls-fit ? side-width :
        compact-toolbar-fit && self.width >= 2 * root.layout.osc-row-inline-inset +
            2 * toolbar-width + transport-width + 4 * root.layout.osc-row-gap ? toolbar-width : 0px;
    // Edge-to-edge keeps video behind sidebars, but the controls must
    // stay in the unobscured video area so their actions remain visible.
    private property <length> osc-video-leading-inset:
        PlayerLayoutState.edge-to-edge-video ? root.geometry.sidebar-leading-extent : root.geometry.video-inset-leading;
    private property <length> osc-video-width:
        PlayerLayoutState.edge-to-edge-video
            ? max(1px, root.geometry.window-width - root.geometry.sidebar-leading-extent - root.geometry.sidebar-trailing-extent)
            : root.geometry.video-width;
    width: PlayerLayoutState.osc-position == 0 ? min(osc-video-width, max(200px, min(460px, osc-video-width - 2px))) :
        osc-video-width;
    animate width { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-reposition-duration; }
    height: root.geometry.osc-height;
    x: osc-video-leading-inset + (PlayerLayoutState.osc-position == 0 ? clamp(
            osc-video-width * (osc-video-width < 462px ? 0.5 : PlayerLayoutState.control-bar-position-horizontal) - self.width / 2,
            0px, max(0px, osc-video-width - self.width)) : 0px);
    animate x { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-reposition-duration; }
    // IINA stores this fraction as a bottom inset and clamps its top
    // edge to 25 points; convert that bottom-origin rule to Slint's
    // top-origin coordinates before positioning the full visible bar.
    y: PlayerLayoutState.osc-position == 1 ? min(max(0px, root.geometry.available-height - self.height), PlayerAppearance.compact-ui ? 30px : 34px) :
        PlayerLayoutState.osc-position == 2 ? max(0px, root.geometry.available-height - self.height) :
            max(0px, root.geometry.available-height -
                min(max(0px, root.geometry.available-height - 67px - 25px),
                    max(0px, root.geometry.available-height * PlayerLayoutState.control-bar-position-vertical)) - self.height);
    opacity: PlayerControlsState.controls-visible ? 1 : 0;
    animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-visibility-duration; }
    border-radius: PlayerLayoutState.osc-position == 0 ? 12px : 4px;
    background: Theme.controller-surface(
        PlayerAppearance.dark-theme, PlayerAppearance.active-liquid-glass-osc,
        PlayerAppearance.platform-windows, root.native-video);
    if PlayerAppearance.active-liquid-glass-osc : Image {
        source: root.material.video-blurred-frame;
        x: root.geometry.video-inset-leading - parent.x;
        y: root.geometry.video-inset-top - parent.y;
        width: root.material.render-width;
        height: root.material.render-height;
        opacity: root.material.video-material-sample-opacity;
        image-fit: contain;
    }
    border-width: 1px; border-color: Theme.controller-border;
    // This is a tinted SDR approximation, not a claim of matching AppKit video blur.
    // The 24-point transport row, padded 24-point timeline, source
    // insets, and 8-point gap reproduce IINA's visible floating panel.
    TouchArea {
        width: parent.width; height: parent.height;
        private property <float> drag-start-x: 0;
        private property <float> drag-start-y: 0;
        private property <float> drag-origin-x: 0;
        private property <float> drag-origin-y: 0;
        private property <bool> center-aligned: false;
        moved => {
            if self.pressed && PlayerLayoutState.osc-position == 0 {
                let available-x = max(0px, osc-video-width - root.width);
                let available-y = max(0, root.geometry.window-height / 1px - root.height / 1px);
                // AppKit constrains the left edge to 10 points, but lets
                // the right edge reach the video boundary. Its bottom-
                // origin y range converts to a 25-point top inset here.
                let minimum-x = min(10, available-x / 1px);
                let minimum-y = min(25, available-y);
                let requested-x = drag-origin-x + self.mouse-x / 1px - drag-start-x;
                let requested-y = drag-origin-y + self.mouse-y / 1px - drag-start-y;
                let bounded-x = clamp(requested-x, minimum-x, available-x / 1px);
                let bounded-y = clamp(requested-y, minimum-y, available-y);
                let center-x = (osc-video-width / 1px - root.width / 1px) / 2;
                let aligned = PlayerPreferences.control-stick-to-center && abs(bounded-x - center-x) <= 5;
                let snapped-x = aligned ? center-x : bounded-x;
                if PlayerAppearance.platform-macos && aligned && !self.center-aligned {
                    PlayerControlActions.controller-snap-aligned();
                }
                self.center-aligned = aligned;
                PlayerLayoutState.control-bar-position-horizontal = (snapped-x + root.width / 2 / 1px) / max(1, osc-video-width / 1px);
                PlayerLayoutState.control-bar-position-vertical = (root.geometry.window-height / 1px - bounded-y - root.height / 1px) / max(1, root.geometry.window-height / 1px);
                PlayerControlsState.control-bar-dragging = true;
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down
                && PlayerLayoutState.osc-position == 0 {
                drag-start-x = self.mouse-x / 1px;
                drag-start-y = self.mouse-y / 1px;
                self.center-aligned = false;
                drag-origin-x = (root.x - osc-video-leading-inset) / 1px;
                drag-origin-y = root.y / 1px;
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up
                && PlayerControlsState.control-bar-dragging {
                PlayerControlsState.control-bar-dragging = false;
                root.layout-settings-changed();
            }
        }
        changed has-hover => {
            PlayerControlsState.control-bar-hovered = self.has-hover;
        }
        VerticalLayout { width: parent.width; height: parent.height;
        padding-top: root.geometry.window-height < 24px ? 0px : root.geometry.window-height < 42px ? 1px : root.layout.small-video-controller ? 5px : PlayerAppearance.compact-ui ? 10px : 14px;
        padding-bottom: root.geometry.window-height < 24px ? 0px : root.geometry.window-height < 42px ? 1px : root.layout.small-video-controller ? 4px : PlayerAppearance.compact-ui ? 5px : 8px;
        // IINA's floating OSC keeps an 8 pt gap between the top row
        // and timeline in both spacious and compact layouts.
        spacing: root.geometry.window-height < 24px ? 0px : root.geometry.window-height < 42px ? 1px : root.layout.small-video-controller ? 3px : 8px;
        Rectangle {
            horizontal-stretch: 1;
            height: root.layout.osc-row-height;
            background: transparent;
            HorizontalLayout {
            x: 0px; y: 0px;
            width: parent.width; height: root.layout.osc-row-height;
            opacity: PlayerControlsState.controls-visible ? 1 : 0;
            animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-content-fade-duration; }
            padding-left: root.layout.osc-row-inline-inset;
            padding-right: root.layout.osc-row-inline-inset;
            spacing: root.layout.osc-row-gap;
            if root.balanced-side-width > 0px : Rectangle {
                width: root.balanced-side-width; height: root.layout.osc-row-height;
                if root.side-controls-fit && PlaybackAudioState.has-active-audio-track : HorizontalLayout {
                    width: 116px; height: root.layout.osc-row-height; spacing: 4px;
                    Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; height: root.layout.osc-row-height;
                        icon: PlaybackAudioState.muted ? @image-url("../../../assets/icons/muted.svg") : @image-url("../../../assets/icons/volume.svg");
                        hint: "Mute"; activated => { PlayerMenuActions.toggle-mute(); } }
                    PlayerSlider { dark-theme: PlayerAppearance.dark-theme; width: 82px; height: root.layout.osc-row-height;
                        minimum: 0; maximum: root.audio.volume-limit; value: PlaybackAudioState.volume; hint: "Volume";
                        scroll-override-enabled: !root.audio.control-disable-volume-slider-scrolling;
                        scroll-disabled: root.audio.control-disable-volume-slider-scrolling;
                        scroll-request(delta-x, delta-y) => { PlayerControlActions.volume-scroll-action-request(delta-x, delta-y); }
                        changed is-dragging => { PlayerControlsState.control-bar-dragging = self.is-dragging; }
                        changed(value) => { PlayerControlActions.set-volume(value); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            HorizontalLayout {
                spacing: PlayerLayoutState.osc-position == 0 ? 24px : 16px;
                if root.layout.transport-neighbor-actions-fit : ControllerArrow {
                    accent-color: PlayerAppearance.interactive-accent-color;
                    dark-theme: PlayerAppearance.dark-theme; width: 24px; height: root.layout.osc-row-height; icon-size: 24px;
                    left: true;
                    show-speed: PlayerLayoutState.osc-position == 0 && root.side-controls-fit;
                }
                Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme;
                    width: 24px; height: root.layout.osc-row-height; icon-size: 24px;
                    // The triangular ink's centroid sits 2.83 pt left of
                    // its SVG center. Balance its optical weight without
                    // moving the hit target or the symmetric pause bars.
                    icon-optical-offset-x: root.paused ? 2.5px : 0px;
                    icon: root.paused ? @image-url("../../../assets/icons/osc-play.svg") : @image-url("../../../assets/icons/osc-pause.svg"); hint: root.paused ? "Play" : "Pause";
                    activated => { PlayerMenuActions.toggle-pause(); } }
                if root.layout.transport-neighbor-actions-fit : ControllerArrow {
                    accent-color: PlayerAppearance.interactive-accent-color;
                    dark-theme: PlayerAppearance.dark-theme; width: 24px; height: root.layout.osc-row-height; icon-size: 24px;
                    left: false;
                    show-speed: PlayerLayoutState.osc-position == 0 && root.side-controls-fit;
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            if root.toolbar-actions-fit : Rectangle {
                width: max(root.balanced-side-width, root.toolbar-width); height: root.layout.osc-row-height;
                HorizontalLayout {
                x: parent.width - self.width;
                width: root.toolbar-width; height: root.layout.osc-row-height;
                spacing: root.toolbar-gap;
                for action-kind in PlayerControlsState.toolbar-visible-order : ToolbarAction {
                kind: action-kind;
                action-width: root.toolbar-button-width;
                action-height: min(root.toolbar-button-width, root.layout.osc-row-height);
                height: root.layout.osc-row-height;
                dark-theme: PlayerAppearance.dark-theme;
                enabled: (action-kind != 5 || root.toolbar.loaded) &&
                    (action-kind != 6 || root.toolbar.screenshot-available) &&
                    (action-kind != 8 || root.toolbar.live-text-available);
                selected: action-kind == 0 ? (root.toolbar.sidebar == 1 || root.toolbar.sidebar == 2 || root.toolbar.sidebar == 5 || root.toolbar.sidebar == 6 ||
                        root.toolbar.leading-sidebar == 1 || root.toolbar.leading-sidebar == 2 || root.toolbar.leading-sidebar == 5 || root.toolbar.leading-sidebar == 6) :
                    action-kind == 1 ? (root.toolbar.sidebar == 3 || root.toolbar.sidebar == 4 || root.toolbar.leading-sidebar == 3 || root.toolbar.leading-sidebar == 4) :
                    action-kind == 2 ? root.toolbar.picture-in-picture-active :
                    action-kind == 3 ? root.toolbar.fullscreen :
                    action-kind == 8 ? root.toolbar.live-text-enabled : false;
                hint: action-kind == 0 ? "Quick Settings" :
                    action-kind == 1 ? "Playlist and chapters" :
                    action-kind == 2 ? "Toggle Picture-in-Picture" :
                    action-kind == 3 ? (root.toolbar.fullscreen ? "Exit Full Screen" : "Enter Full Screen") :
                    action-kind == 4 ? "Enter Music Mode" :
                    action-kind == 5 ? "Switch Subtitle Track" :
                    action-kind == 6 ? "Take Screenshot" :
                    action-kind == 7 ? "Show plugins panel" : "Live Text";
                activated(kind) => {
                    if kind == 0 { PlayerMenuActions.toggle-settings-pane(root.toolbar.remembered-settings-pane); }
                    else if kind == 1 { PlayerMenuActions.toggle-playlist-pane(root.toolbar.remembered-playlist-pane); }
                    else if kind == 2 { PlayerMenuActions.toggle-picture-in-picture(); }
                    else if kind == 3 { PlayerMenuActions.toggle-fullscreen(); }
                    else if kind == 4 { PlayerMenuActions.toggle-music-mode(); }
                    else if kind == 5 {
                        PlayerMenuActions.show-subtitle-menu(SubtitleMenuSource.controller,
                            self.absolute-position.x / 1px, self.absolute-position.y / 1px);
                    }
                    else if kind == 6 { PlayerMenuActions.take-screenshot(); }
                    else if kind == 7 { PlayerMenuActions.toggle-plugins-pane(); }
                    else if kind == 8 { PlayerMenuActions.toggle-live-text(); }
                }
            }
            }
            }
        }
        }
        if root.layout.osc-timeline-height > 0px : ControllerTimeline {
            height: root.layout.osc-timeline-height;
            inline-inset: root.layout.osc-timeline-inline-inset;
            item-gap: root.layout.osc-timeline-gap;
            small: root.layout.small-video-controller;
            show-clocks: root.geometry.window-width >= 150px;
            preview-above: PlayerLayoutState.osc-position != 1;
            aspect-ratio: root.video-display-aspect-ratio;
        }
        }
    }
}
