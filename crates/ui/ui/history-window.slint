import { Theme } from "theme.slint";
import { ConfirmationSheet } from "confirmation-sheet.slint";
import { Button, ComboBox, ScrollView } from "std-widgets.slint";
import { NativeTypography, AuxiliaryPalette } from "shared-controls.slint";
import { HistoryActionMenu, PlaybackHistoryAction } from "history-action-menu.slint";

export struct PlaybackHistoryRow {
    is-group: bool,
    group-key: string,
    collapsed: bool,
    label: string,
    detail: string,
    progress: string,
    played-at: string,
    path: string,
    progress-ratio: float,
    available: bool,
    local-file: bool,
    selected: bool,
}

export enum PlaybackHistoryNavigation { previous, next, first, last, page-up, page-down }

component HistoryColumnHandle inherits TouchArea {
    in property <string> label;
    in property <length> column-width;
    in property <length> lower-width;
    in property <length> upper-width;
    in property <length> default-width;
    callback resize-to(length);
    private property <length> drag-start;
    private property <length> width-at-press;

    width: 10px;
    mouse-cursor: ew-resize;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.column-width / 1px;
    accessible-value-minimum: root.lower-width / 1px;
    accessible-value-maximum: root.upper-width / 1px;
    accessible-value-step: 8;
    accessible-action-set-value(text) => {
        if text.is-float() { root.apply-width(text.to-float() * 1px); }
    }
    accessible-action-increment => { root.apply-width(root.column-width + 8px); }
    accessible-action-decrement => { root.apply-width(root.column-width - 8px); }

    function apply-width(value: length) {
        root.resize-to(clamp(value, root.lower-width, root.upper-width));
    }

    pointer-event(event) => {
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            handle-focus.focus();
            root.drag-start = root.x + root.mouse-x;
            root.width-at-press = root.column-width;
        }
    }
    moved => {
        if root.pressed {
            // The handle moves under the pointer as the adjacent column changes.
            root.apply-width(root.width-at-press + root.drag-start - root.x - root.mouse-x);
        }
    }
    double-clicked => { root.apply-width(root.default-width); }

    handle-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        // The drag handler assigns focus after it captures the pointer.
        focus-on-click: false;
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.meta || event.modifiers.alt || event.modifiers.shift {
                return reject;
            }
            if event.text == Key.LeftArrow { root.apply-width(root.column-width + 8px); }
            else if event.text == Key.RightArrow { root.apply-width(root.column-width - 8px); }
            else if event.text == Key.Home { root.apply-width(root.default-width); }
            else { return reject; }
            return accept;
        }
    }
    Rectangle {
        x: (root.width - self.width) / 2; width: handle-focus.has-focus ? 2px : 1px;
        y: 4px; height: root.height - 8px;
        background: handle-focus.has-focus ? Theme.player-focus-accent : Theme.history-secondary-text;
        visible: handle-focus.has-focus || root.has-hover;
    }
}

export component PlaybackHistoryWindow inherits Window {
    default-font-family: NativeTypography.system-font-family;
    title: @tr("Playback History");
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 520px;
    min-height: 340px;
    in-out property <bool> acrylic-backdrop-enabled: false;
    background: acrylic-backdrop-enabled ? transparent : Theme.auxiliary-light-window-surface;

    in property <[PlaybackHistoryRow]> rows: [];
    in-out property <string> search-text: "";
    out property <string> recent-searches-title: @tr("Recent Searches");
    out property <string> clear-recents-title: @tr("Clear Recents");
    in property <[string]> recent-searches: [root.recent-searches-title];
    in property <string> status-text;
    in-out property <int> group-mode: 0;
    in-out property <int> search-mode: 1;
    in-out property <float> progress-column-width: 145;
    in-out property <float> played-at-column-width: 205;
    private property <length> minimum-media-width: 132px;
    private property <length> minimum-progress-width: 88px;
    private property <length> minimum-played-at-width: root.group-mode == 0 ? 96px : 145px;
    private property <length> played-at-width: clamp(root.played-at-column-width * 1px,
        root.minimum-played-at-width, max(root.minimum-played-at-width,
            outline.visible-width - root.minimum-media-width - root.minimum-progress-width));
    private property <length> progress-width: clamp(root.progress-column-width * 1px,
        root.minimum-progress-width, max(root.minimum-progress-width,
            outline.visible-width - root.minimum-media-width - root.played-at-width));
    private property <length> progress-left: max(root.minimum-media-width,
        outline.visible-width - root.played-at-width - root.progress-width);
    private property <length> played-at-left: root.progress-left + root.progress-width;
    in-out property <string> selected-path: "";
    in property <[string]> selected-paths: [];
    in property <int> selected-menu-row: -1;
    in property <bool> has-playable-selection;
    in property <bool> has-local-selection;
    in property <bool> has-playing-destination;
    in property <bool> has-collapsed-groups;
    in property <bool> has-expanded-groups;
    in property <bool> confirmation-visible;
    in property <string> confirmation-title;
    in property <string> confirmation-description;
    in property <string> confirmation-button;
    callback search-changed();
    callback search-accepted();
    callback recent-search-selected(int);
    callback select-all();
    callback navigate(PlaybackHistoryNavigation, bool, int);
    callback select-entry(string, int, bool, bool);
    callback context-action(PlaybackHistoryAction, string);
    callback open-entry(string);
    callback clear-history();
    callback answer-confirmation(bool);
    callback toggle-group(string);
    callback expand-all-groups();
    callback collapse-all-groups();
    changed search-text => { root.search-changed(); }
    changed search-mode => { root.search-changed(); }
    changed group-mode => { root.search-changed(); }
    changed confirmation-visible => {
        if root.confirmation-visible { confirmation.focus(); }
        else { keys.focus(); }
    }
    init => { keys.focus(); }

    public function reveal-row(index: int) {
        let top = index * 46px;
        if top + outline.content-y < 0px {
            outline.content-y = -top;
        } else if top + 46px + outline.content-y > outline.visible-height {
            outline.content-y = outline.visible-height - top - 46px;
        }
        outline.content-y = clamp(outline.content-y,
            min(0px, outline.visible-height - outline.content-height), 0px);
    }

    keys := FocusScope {
    width: root.width; height: root.height;
    Rectangle {
        x: 0; y: 0; width: parent.width; height: 84px;
        background: root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.auxiliary-light-toolbar-surface;
        HorizontalLayout {
            x: 16px; y: 7px; width: parent.width - 32px; height: 32px; spacing: 6px;
            Button {
                text: @tr("Date");
                checkable: true;
                checked: root.group-mode == 0;
                clicked => { root.group-mode = 0; }
            }
            Button {
                text: @tr("Folder & Website");
                checkable: true;
                checked: root.group-mode == 1;
                clicked => { root.group-mode = 1; }
            }
            Rectangle { horizontal-stretch: 1; }
            search-box := Rectangle {
                width: max(110px, min(190px, parent.width * 0.26)); height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: search-input.has-focus
                    ? Theme.player-focus-accent : Theme.history-column-header;
                TouchArea { clicked => { search-input.focus(); } }
                Text {
                    x: 6px; width: parent.width - 12px; height: parent.height;
                    visible: root.search-text == "";
                    text: @tr("Search History"); font-size: 12px;
                    color: Theme.history-secondary-text;
                    overflow: elide;
                    vertical-alignment: center;
                }
                search-input := TextInput {
                    x: 6px; width: parent.width - 12px; height: parent.height;
                    text <=> root.search-text;
                    font-size: 12px;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-label: @tr("Search playback history");
                    accepted => { root.search-accepted(); }
                    key-pressed(event) => {
                        if event.text != Key.Escape { return reject; }
                        if root.search-text == "" { keys.focus(); }
                        else { root.search-text = ""; }
                        return accept;
                    }
                }
            }
            ComboBox {
                preferred-width: 96px;
                accessible-label: @tr("Search in");
                model: [@tr("Filename"), @tr("Full Path")];
                current-index <=> root.search-mode;
            }
            Button { text: @tr("Clear History"); clicked => { root.clear-history(); } }
        }
        HorizontalLayout {
            x: 16px; y: 45px; width: parent.width - 32px; height: 30px; spacing: 6px;
            Button { text: @tr("Expand All"); enabled: root.has-collapsed-groups; clicked => { root.expand-all-groups(); } }
            Button { text: @tr("Collapse All"); enabled: root.has-expanded-groups; clicked => { root.collapse-all-groups(); } }
            Rectangle { horizontal-stretch: 1; }
            recents := ComboBox {
                width: 170px;
                accessible-label: @tr("Recent History searches");
                enabled: root.recent-searches.length > 1;
                model: root.recent-searches;
                current-index: 0;
                selected => {
                    let index = self.current-index;
                    self.current-index = 0;
                    if index > 0 { root.recent-search-selected(index); }
                }
            }
        }
    }

    Rectangle {
        x: 16px; y: 92px; width: outline.visible-width; height: 28px;
        background: root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.history-column-header;
        Text { x: 34px; y: 0; width: root.progress-left - 44px; height: parent.height;
            text: @tr("Media"); font-size: 11px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
        Text { x: root.progress-left; y: 0; width: root.progress-width - 15px; height: parent.height;
            text: @tr("Progress"); font-size: 11px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
        Text { x: root.played-at-left; y: 0; width: root.played-at-width - 15px; height: parent.height;
            text: @tr("Played At"); font-size: 11px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
        HistoryColumnHandle {
            x: root.progress-left - self.width / 2; height: parent.height;
            label: @tr("Progress column width");
            column-width: root.progress-width;
            lower-width: root.minimum-progress-width;
            upper-width: max(self.lower-width, root.played-at-left - root.minimum-media-width);
            default-width: 145px;
            resize-to(value) => { root.progress-column-width = value / 1px; }
        }
        HistoryColumnHandle {
            x: root.played-at-left - self.width / 2; height: parent.height;
            label: @tr("Played At column width");
            column-width: root.played-at-width;
            lower-width: root.minimum-played-at-width;
            upper-width: max(self.lower-width,
                outline.visible-width - root.minimum-media-width - root.progress-width);
            default-width: 205px;
            resize-to(value) => { root.played-at-column-width = value / 1px; }
        }
    }

    outline := ScrollView {
        x: 16px; y: 120px; width: parent.width - 32px;
        height: parent.height - (root.status-text == "" ? 132px : 156px);
        content-height: max(1px, root.rows.length * 46px);
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        Rectangle {
            width: parent.width; height: max(1px, root.rows.length * 46px);
            accessible-role: list;
            accessible-label: @tr("Playback History");
            background: root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.auxiliary-light-list-surface;
            for row[index] in root.rows : Rectangle {
                x: 0; y: index * 46px; width: parent.width; height: 46px;
                background: row.selected ? Theme.auxiliary-light-row-selection : row.is-group
                    ? (root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.history-group-fill)
                    : root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill
                    : (Math.mod(index, 2) == 0 ? Theme.auxiliary-light-list-surface : Theme.auxiliary-light-list-alternate);
                if row.is-group : Text {
                    x: 10px; y: 0; width: 12px; height: parent.height;
                    text: row.collapsed ? "▸" : "▾";
                    color: Theme.history-group-text; font-size: 11px; vertical-alignment: center;
                }
                if row.is-group : Text {
                    x: 24px; y: 0; width: parent.width - 36px; height: parent.height;
                    text: row.label; color: Theme.history-group-text; font-size: 11px; font-weight: 600;
                    vertical-alignment: center; overflow: elide;
                }
                if row.is-group : TouchArea {
                    width: parent.width; height: parent.height;
                    accessible-role: button;
                    accessible-label: row.label;
                    accessible-expanded: !row.collapsed;
                    accessible-action-default => { keys.focus(); root.toggle-group(row.group-key); }
                    clicked => { keys.focus(); root.toggle-group(row.group-key); }
                }
                if !row.is-group : Rectangle {
                    x: 10px; y: 11px; width: 22px; height: 22px;
                    border-radius: 4px; background: Theme.history-availability-surface(row.available);
                    Text { width: parent.width; height: parent.height;
                        text: row.available ? "▶" : "•"; color: Theme.history-availability-glyph; font-size: 11px;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                if !row.is-group : VerticalLayout {
                    x: 40px; y: 5px; width: root.progress-left - 50px; height: 36px; spacing: 1px;
                    Text { text: row.label; color: Theme.history-media-title(row.available);
                        font-size: 12px; vertical-alignment: center; overflow: elide; }
                    if row.detail != "" : Text { text: row.detail; color: Theme.history-secondary-text; font-size: 10px;
                        vertical-alignment: center; overflow: elide; }
                }
                if !row.is-group : Text {
                    x: root.progress-left; y: 0; width: root.progress-width - 15px; height: parent.height;
                    text: row.progress; color: Theme.history-progress-text(row.available);
                    font-size: 11px; vertical-alignment: center; overflow: elide;
                }
                if !row.is-group && row.progress != "" : Rectangle {
                    x: root.progress-left; y: parent.height - 8px;
                    width: root.progress-width - 33px; height: 3px;
                    border-radius: 2px; background: Theme.history-progress-track;
                    Rectangle {
                        x: 0; y: 0; width: parent.width * row.progress-ratio; height: parent.height;
                        border-radius: 2px; background: Theme.history-progress-value;
                    }
                }
                if !row.is-group : Rectangle {
                    x: root.played-at-left; y: 0; width: root.played-at-width - 15px;
                    height: parent.height; background: transparent;
                    Text { x: 0; y: 0; width: parent.width; height: parent.height;
                        text: row.played-at; color: Theme.auxiliary-light-secondary-text; font-size: 11px;
                        vertical-alignment: center; overflow: elide; }
                }
                if !row.is-group : TouchArea {
                    width: parent.width; height: parent.height;
                    accessible-role: list-item;
                    accessible-label: row.label;
                    accessible-item-index: index;
                    accessible-item-selectable: true;
                    accessible-item-selected: row.selected;
                    accessible-action-default => { keys.focus(); root.select-entry(row.path, index, false, false); }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                            keys.focus();
                            root.select-entry(row.path, index,
                                event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                        }
                    }
                    double-clicked => {
                        if row.available { root.open-entry(row.path); }
                    }
                }
                if !row.is-group : HistoryActionMenu {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    can-play: row.available || root.has-playable-selection;
                    can-reveal: row.local-file || root.has-local-selection;
                    has-playing-destination: root.has-playing-destination;
                    action(selected) => { root.context-action(selected, row.path); }
                }
            }
            if root.rows.length == 0 : Text {
                x: 12px; y: 18px; width: parent.width - 24px; height: 30px;
                text: root.search-text == "" ? @tr("No playback history") : @tr("No matching history");
                color: Theme.history-secondary-text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }

    keyboard-menu := HistoryActionMenu {
        x: 0; y: 0; width: 0; height: 0;
        can-play: root.has-playable-selection;
        can-reveal: root.has-local-selection;
        has-playing-destination: root.has-playing-destination;
        action(selected) => { root.context-action(selected, ""); }
    }

    if root.status-text != "" : Text {
        x: 16px; y: root.height - 32px; width: root.width - 32px; height: 24px;
        text: root.status-text; color: Theme.history-secondary-text;
        font-size: 11px; vertical-alignment: center; overflow: elide;
    }

    key-pressed(event) => {
        if root.confirmation-visible { return accept; }
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F") {
            search-input.focus(); return accept;
        }
        if search-input.has-focus { return reject; }
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "a" || event.text == "A") {
            if !event.repeat { root.select-all(); }
            return accept;
        }
        if !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta
            && (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
            if root.selected-menu-row >= 0 && !event.repeat {
                root.reveal-row(root.selected-menu-row);
                let row-bottom = (root.selected-menu-row + 1) * 46px + outline.content-y;
                keyboard-menu.show({ x: outline.x + 40px,
                    y: outline.y + clamp(row-bottom, 0px, outline.visible-height) });
            }
            return accept;
        }
        if !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta && (
            event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Home
            || event.text == Key.End || event.text == Key.PageUp || event.text == Key.PageDown) {
            let direction = event.text == Key.UpArrow ? PlaybackHistoryNavigation.previous
                : event.text == Key.DownArrow ? PlaybackHistoryNavigation.next
                : event.text == Key.Home ? PlaybackHistoryNavigation.first
                : event.text == Key.End ? PlaybackHistoryNavigation.last
                : event.text == Key.PageUp ? PlaybackHistoryNavigation.page-up : PlaybackHistoryNavigation.page-down;
            root.navigate(direction, event.modifiers.shift, max(1, floor(outline.visible-height / 46px)));
            return accept;
        }
        if event.modifiers.alt || event.modifiers.shift { return reject; }
        if (event.modifiers.control || event.modifiers.meta) && event.text == Key.Return {
            if !event.repeat { root.context-action(PlaybackHistoryAction.play-in-new-window, ""); }
            return accept;
        }
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "l" || event.text == "L") {
            if !event.repeat { root.context-action(PlaybackHistoryAction.reveal, ""); }
            return accept;
        }
        if (event.modifiers.control || event.modifiers.meta)
            && (event.text == Key.Backspace || event.text == Key.Delete) {
            if !event.repeat { root.context-action(PlaybackHistoryAction.trash, ""); }
            return accept;
        }
        if event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return {
            if !event.repeat { root.context-action(PlaybackHistoryAction.play, ""); }
            return accept;
        }
        if event.text == Key.Backspace || event.text == Key.Delete {
            if !event.repeat { root.context-action(PlaybackHistoryAction.remove, ""); }
            return accept;
        }
        return reject;
    }
    }

    confirmation := ConfirmationSheet {
        width: root.width;
        height: root.height;
        visible: root.confirmation-visible;
        title: root.confirmation-title;
        description: root.confirmation-description;
        action: root.confirmation-button;
        answered(accepted) => { root.answer-confirmation(accepted); }
    }
}
