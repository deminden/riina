import { Theme } from "theme.slint";
import { Button, ComboBox, ScrollView } from "std-widgets.slint";
import { NativeTypography, AuxiliaryPalette } from "shared-controls.slint";

export struct PlaybackHistoryRow {
    is-group: bool,
    collapsed: bool,
    label: string,
    detail: string,
    progress: string,
    played-at: string,
    path: string,
    progress-ratio: float,
    available: bool,
    local-file: bool,
    selected: bool,
}

export enum PlaybackHistoryNavigation { previous, next, first, last, page-up, page-down }

component HistoryConfirmation inherits FocusScope {
    in property <string> title;
    in property <string> description;
    in property <string> action;
    callback answered(bool);
    forward-focus: cancel;

    TouchArea {
        width: parent.width;
        height: parent.height;
        scroll-event(_) => { return accept; }
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #0005;
    }
    Rectangle {
        width: min(460px, parent.width - 32px);
        x: (parent.width - self.width) / 2;
        y: 0px;
        height: content.preferred-height + 36px;
        border-radius: 9px;
        background: Theme.auxiliary-light-window-surface;
        border-color: Theme.history-column-header;
        border-width: 1px;

        content := VerticalLayout {
            x: 18px;
            y: 16px;
            width: parent.width - 36px;
            height: self.preferred-height;
            spacing: 12px;
            Text {
                text: root.title;
                color: Theme.history-media-title(true);
                font-size: 16px;
                font-weight: 600;
            }
            Text {
                text: root.description;
                color: Theme.history-secondary-text;
                font-size: 13px;
                wrap: word-wrap;
                max-height: 70px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                cancel := Button {
                    text: "Cancel";
                    clicked => { root.answered(false); }
                }
                proceed := Button {
                    text: root.action;
                    clicked => { root.answered(true); }
                }
            }
        }
    }

    key-pressed(event) => {
        if event.text == Key.Escape {
            root.answered(false);
            return accept;
        }
        if event.text == Key.Tab || event.text == Key.Backtab {
            if cancel.has-focus { proceed.focus(); } else { cancel.focus(); }
            return accept;
        }
        return reject;
    }
}

export component PlaybackHistoryWindow inherits Window {
    default-font-family: NativeTypography.system-font-family;
    title: "Playback History";
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 520px;
    min-height: 340px;
    in-out property <bool> acrylic-backdrop-enabled: false;
    background: acrylic-backdrop-enabled ? transparent : Theme.auxiliary-light-window-surface;

    in property <[PlaybackHistoryRow]> rows: [];
    in-out property <string> search-text: "";
    in property <[string]> recent-searches: ["Recent Searches"];
    in property <string> status-text;
    in-out property <int> group-mode: 0;
    in-out property <int> search-mode: 1;
    in-out property <string> selected-path: "";
    in property <[string]> selected-paths: [];
    in property <bool> has-playable-selection;
    in property <bool> has-local-selection;
    in property <bool> has-collapsed-groups;
    in property <bool> has-expanded-groups;
    in property <bool> confirmation-visible;
    in property <string> confirmation-title;
    in property <string> confirmation-description;
    in property <string> confirmation-button;
    callback search-changed();
    callback search-accepted();
    callback recent-search-selected(int);
    callback history-key(int);
    callback navigate(PlaybackHistoryNavigation, bool, int);
    callback select-entry(string, int, bool, bool);
    callback context-action(int, string);
    callback open-entry(string);
    callback clear-history();
    callback answer-confirmation(bool);
    callback toggle-group(string);
    callback expand-all-groups();
    callback collapse-all-groups();
    changed search-text => { root.search-changed(); }
    changed search-mode => { root.search-changed(); }
    changed group-mode => { root.search-changed(); }
    changed confirmation-visible => {
        if root.confirmation-visible { confirmation.focus(); }
        else { keys.focus(); }
    }
    init => { keys.focus(); }

    public function reveal-row(index: int) {
        let top = index * 46px;
        if top + outline.content-y < 0px {
            outline.content-y = -top;
        } else if top + 46px + outline.content-y > outline.visible-height {
            outline.content-y = outline.visible-height - top - 46px;
        }
        outline.content-y = clamp(outline.content-y,
            min(0px, outline.visible-height - outline.content-height), 0px);
    }

    keys := FocusScope {
    width: root.width; height: root.height;
    Rectangle {
        x: 0; y: 0; width: parent.width; height: 84px;
        background: root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.auxiliary-light-toolbar-surface;
        HorizontalLayout {
            x: 16px; y: 7px; width: parent.width - 32px; height: 32px; spacing: 6px;
            Button {
                text: "Date";
                checkable: true;
                checked: root.group-mode == 0;
                clicked => { root.group-mode = 0; }
            }
            Button {
                text: "Folder & Website";
                checkable: true;
                checked: root.group-mode == 1;
                clicked => { root.group-mode = 1; }
            }
            Rectangle { horizontal-stretch: 1; }
            search-box := Rectangle {
                width: max(110px, min(190px, parent.width * 0.26)); height: 28px;
                border-radius: 5px;
                border-width: 1px;
                border-color: search-input.has-focus
                    ? Theme.player-focus-accent : Theme.history-column-header;
                TouchArea { clicked => { search-input.focus(); } }
                Text {
                    x: 6px; height: parent.height;
                    visible: root.search-text == "";
                    text: "Search History"; font-size: 12px;
                    color: Theme.history-secondary-text;
                    vertical-alignment: center;
                }
                search-input := TextInput {
                    x: 6px; width: parent.width - 12px; height: parent.height;
                    text <=> root.search-text;
                    font-size: 12px;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-label: "Search playback history";
                    accepted => { root.search-accepted(); }
                    key-pressed(event) => {
                        if event.text != Key.Escape { return reject; }
                        if root.search-text == "" { keys.focus(); }
                        else { root.search-text = ""; }
                        return accept;
                    }
                }
            }
            ComboBox {
                width: 96px;
                accessible-label: "Search in";
                model: ["Filename", "Full Path"];
                current-index <=> root.search-mode;
            }
            Button { text: "Clear History"; clicked => { root.clear-history(); } }
        }
        HorizontalLayout {
            x: 16px; y: 45px; width: parent.width - 32px; height: 30px; spacing: 6px;
            Button { text: "Expand All"; enabled: root.has-collapsed-groups; clicked => { root.expand-all-groups(); } }
            Button { text: "Collapse All"; enabled: root.has-expanded-groups; clicked => { root.collapse-all-groups(); } }
            Rectangle { horizontal-stretch: 1; }
            recents := ComboBox {
                width: 170px;
                accessible-label: "Recent History searches";
                enabled: root.recent-searches.length > 1;
                model: root.recent-searches;
                current-index: 0;
                selected => {
                    let index = self.current-index;
                    self.current-index = 0;
                    if index > 0 { root.recent-search-selected(index); }
                }
            }
        }
    }

    Rectangle {
        x: 16px; y: 92px; width: parent.width - 32px; height: 28px;
        background: root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.history-column-header;
        Text { x: 34px; y: 0; width: parent.width - 390px; height: parent.height;
            text: "Media"; font-size: 11px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
        Text { x: parent.width - 350px; y: 0; width: 130px; height: parent.height;
            text: "Progress"; font-size: 11px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
        Text { x: parent.width - 205px; y: 0; width: 190px; height: parent.height;
            text: "Played At"; font-size: 11px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
    }

    outline := ScrollView {
        x: 16px; y: 120px; width: parent.width - 32px;
        height: parent.height - (root.status-text == "" ? 132px : 156px);
        content-height: max(1px, root.rows.length * 46px);
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        Rectangle {
            width: parent.width; height: max(1px, root.rows.length * 46px);
            background: root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.auxiliary-light-list-surface;
            for row[index] in root.rows : Rectangle {
                x: 0; y: index * 46px; width: parent.width; height: 46px;
                background: row.selected ? Theme.auxiliary-light-row-selection : row.is-group
                    ? (root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.history-group-fill)
                    : root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill
                    : (Math.mod(index, 2) == 0 ? Theme.auxiliary-light-list-surface : Theme.auxiliary-light-list-alternate);
                if row.is-group : Text {
                    x: 10px; y: 0; width: 12px; height: parent.height;
                    text: row.collapsed ? "▸" : "▾";
                    color: Theme.history-group-text; font-size: 11px; vertical-alignment: center;
                }
                if row.is-group : Text {
                    x: 24px; y: 0; width: parent.width - 36px; height: parent.height;
                    text: row.label; color: Theme.history-group-text; font-size: 11px; font-weight: 600;
                    vertical-alignment: center; overflow: elide;
                }
                if row.is-group : TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { keys.focus(); root.toggle-group(row.label); }
                }
                if !row.is-group : Rectangle {
                    x: 10px; y: 11px; width: 22px; height: 22px;
                    border-radius: 4px; background: Theme.history-availability-surface(row.available);
                    Text { width: parent.width; height: parent.height;
                        text: row.available ? "▶" : "•"; color: Theme.history-availability-glyph; font-size: 11px;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                if !row.is-group : VerticalLayout {
                    x: 40px; y: 5px; width: parent.width - 400px; height: 36px; spacing: 1px;
                    Text { text: row.label; color: Theme.history-media-title(row.available);
                        font-size: 12px; vertical-alignment: center; overflow: elide; }
                    if row.detail != "" : Text { text: row.detail; color: Theme.history-secondary-text; font-size: 10px;
                        vertical-alignment: center; overflow: elide; }
                }
                if !row.is-group : Text {
                    x: parent.width - 350px; y: 0; width: 130px; height: parent.height;
                    text: row.progress; color: Theme.history-progress-text(row.available);
                    font-size: 11px; vertical-alignment: center; overflow: elide;
                }
                if !row.is-group && row.progress != "" : Rectangle {
                    x: parent.width - 350px; y: parent.height - 8px; width: 112px; height: 3px;
                    border-radius: 2px; background: Theme.history-progress-track;
                    Rectangle {
                        x: 0; y: 0; width: parent.width * row.progress-ratio; height: parent.height;
                        border-radius: 2px; background: Theme.history-progress-value;
                    }
                }
                if !row.is-group : Rectangle {
                    x: parent.width - 205px; y: 0; width: 190px; height: parent.height; background: transparent;
                    Text { x: 0; y: 0; width: parent.width; height: parent.height;
                        text: row.played-at; color: Theme.auxiliary-light-secondary-text; font-size: 11px;
                        vertical-alignment: center; overflow: elide; }
                }
                if !row.is-group : TouchArea {
                    width: parent.width; height: parent.height;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                            keys.focus();
                            root.select-entry(row.path, index,
                                event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                        }
                    }
                    double-clicked => {
                        if row.available { root.open-entry(row.path); }
                    }
                }
                if !row.is-group : ContextMenuArea {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    Menu {
                        MenuItem {
                            title: "Play"; enabled: row.available || root.has-playable-selection;
                            activated => { root.context-action(0, row.path); }
                        }
                        MenuItem {
                            title: "Play in New Window"; enabled: row.available || root.has-playable-selection;
                            activated => { root.context-action(1, row.path); }
                        }
                        MenuSeparator {}
                        MenuItem {
                            title: "Show in File Manager"; enabled: row.local-file || root.has-local-selection;
                            activated => { root.context-action(2, row.path); }
                        }
                        MenuSeparator {}
                        MenuItem {
                            title: "Remove from History";
                            activated => { root.context-action(3, row.path); }
                        }
                        MenuItem {
                            title: "Move to Trash…"; enabled: row.local-file || root.has-local-selection;
                            activated => { root.context-action(4, row.path); }
                        }
                    }
                }
            }
            if root.rows.length == 0 : Text {
                x: 12px; y: 18px; width: parent.width - 24px; height: 30px;
                text: root.search-text == "" ? "No playback history" : "No matching history";
                color: Theme.history-secondary-text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }

    if root.status-text != "" : Text {
        x: 16px; y: root.height - 32px; width: root.width - 32px; height: 24px;
        text: root.status-text; color: Theme.history-secondary-text;
        font-size: 11px; vertical-alignment: center; overflow: elide;
    }

    key-pressed(event) => {
        if root.confirmation-visible { return accept; }
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F") {
            search-input.focus(); return accept;
        }
        if search-input.has-focus { return reject; }
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "a" || event.text == "A") {
            root.history-key(0); return accept;
        }
        if !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta && (
            event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Home
            || event.text == Key.End || event.text == Key.PageUp || event.text == Key.PageDown) {
            let direction = event.text == Key.UpArrow ? PlaybackHistoryNavigation.previous
                : event.text == Key.DownArrow ? PlaybackHistoryNavigation.next
                : event.text == Key.Home ? PlaybackHistoryNavigation.first
                : event.text == Key.End ? PlaybackHistoryNavigation.last
                : event.text == Key.PageUp ? PlaybackHistoryNavigation.page-up : PlaybackHistoryNavigation.page-down;
            root.navigate(direction, event.modifiers.shift, max(1, floor(outline.visible-height / 46px)));
            return accept;
        }
        if event.modifiers.alt || event.modifiers.shift { return reject; }
        if (event.modifiers.control || event.modifiers.meta) && event.text == Key.Return {
            root.history-key(2); return accept;
        }
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "l" || event.text == "L") {
            root.history-key(3); return accept;
        }
        if (event.modifiers.control || event.modifiers.meta)
            && (event.text == Key.Backspace || event.text == Key.Delete) {
            root.history-key(5); return accept;
        }
        if event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return { root.history-key(1); return accept; }
        if event.text == Key.Backspace || event.text == Key.Delete {
            root.history-key(4); return accept;
        }
        return reject;
    }
    }

    confirmation := HistoryConfirmation {
        width: root.width;
        height: root.height;
        visible: root.confirmation-visible;
        title: root.confirmation-title;
        description: root.confirmation-description;
        action: root.confirmation-button;
        answered(accepted) => { root.answer-confirmation(accepted); }
    }
}
