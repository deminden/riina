import { Theme } from "theme.slint";
import { SidebarFocusRegion } from "player-sidebar-controls.slint";

export component LayoutChoice inherits SidebarFocusRegion {
    in property <string> label;
    in property <int> position;
    in property <bool> selected;
    in property <bool> dark-theme: true;
    in property <bool> platform-windows: false;
    in property <color> accent-color: Theme.playback-progress-accent;
    in property <length> card-width;
    callback activated();
    height: 74px;
    width: card-width;
    accessible-role: button;
    accessible-label: label;
    accessible-checked: selected;
    accessible-action-default => { activated(); }
    Rectangle {
        // IINA keeps a one-point inactive outline and eight-point corners.
        border-radius: 8px;
        border-width: selected ? 2px : 1px;
        border-color: selected || root.has-focus ? root.accent-color
            : Theme.layout-choice-border(root.dark-theme);
        background: selected
            ? Theme.layout-choice-selection(root.dark-theme, root.platform-windows)
            : touch.has-hover
            ? Theme.layout-choice-hover(root.dark-theme)
            : Theme.layout-choice-surface(root.dark-theme);
        VerticalLayout {
            alignment: center; cross-axis-alignment: center; spacing: 8px;
            preview := Rectangle {
                width: 40px; height: 28px; background: transparent;
                Rectangle {
                    x: 4px; y: 1.5px; width: 32px; height: 25px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.layout-choice-diagram(root.dark-theme);
                    background: transparent;
                    Rectangle {
                        x: position == 0 ? parent.width / 2 - 6px : 2px;
                        y: position == 1 ? 2px : parent.height - 5px;
                        width: position == 0 ? 12px : parent.width - 4px;
                        height: 3px; border-radius: 1px;
                        background: selected
                            ? (root.platform-windows ? root.accent-color : Theme.player-focus-accent) : Theme.layout-choice-inactive-indicator;
                    }
                }
            }
            Text { text: root.label; color: root.platform-windows
                ? Theme.layout-choice-selected-text(root.dark-theme) : selected ? Theme.layout-choice-accent-text
                : Theme.layout-choice-text(root.dark-theme);
                font-size: 11px; horizontal-alignment: center; }
        }
        touch := TouchArea { clicked => { root.focus(); root.activated(); } }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { activated(); return accept; }
        return reject;
    }
}
