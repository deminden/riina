import { PlayerCropState } from "player-crop-state.slint";
import { PlayerMusicModeState } from "player-music-mode-state.slint";
import { PlayerPreferences } from "player-preferences.slint";

// The visible messages and captures belong to the owning player.
export global PlayerOsdState {
    in-out property <bool> seek-osd-visible: false;
    in-out property <bool> video-osd-visible: false;
    in-out property <bool> video-osd-required: false;
    in-out property <bool> screenshot-preview-visible: false;
    in-out property <image> screenshot-preview-image;
    in-out property <float> screenshot-preview-width: 300;
    in-out property <float> screenshot-preview-height: 200;
    in-out property <string> screenshot-preview-path;
    in-out property <string> video-osd-text;
    in-out property <string> video-osd-detail;
    in-out property <float> video-osd-progress: -1;
    in-out property <string> fullscreen-info-time: "";
    in-out property <string> fullscreen-info-battery: "";
    in-out property <float> fullscreen-info-battery-level: 0;
    in-out property <string> plugin-osd-message: "";
    in-out property <bool> stream-opening;
    in-out property <bool> stream-buffering;
    in-out property <bool> stream-seeking;
    in-out property <string> stream-fill-percent;
    in-out property <string> stream-cached-amount;
    in-out property <string> stream-input-rate;
    out property <bool> stream-activity-visible: !PlayerMusicModeState.music-mode && !PlayerCropState.crop-editing
        && (stream-opening || (stream-buffering && PlayerPreferences.network-show-buffering-throbber)
            || (stream-seeking && PlayerPreferences.network-show-seeking-throbber));
    out property <string> stream-activity-label: stream-opening ? @tr("Opening stream…") : stream-buffering
        ? (stream-fill-percent == "" ? @tr("Buffering…") : @tr("Buffering… {}%", stream-fill-percent))
        : stream-seeking ? @tr("Seeking…") : "";
    out property <string> stream-activity-detail: stream-cached-amount == "" ? ""
        : @tr("{} ({}/s)", stream-cached-amount, stream-input-rate);
}
