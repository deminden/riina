import { Theme } from "theme.slint";
import { PreferenceSwitch, PreferenceChoiceRow, PreferenceSensitivityRow } from "preferences-controls.slint";
import { ScrollView } from "std-widgets.slint";

export global ControlSettingsState {
    in-out property <int> control-pinch-index: 0;
    in-out property <int> control-force-touch-choice: 0;
    in-out property <int> control-single-click-choice: 2;
    in-out property <int> control-double-click-choice: 1;
    in-out property <int> control-right-click-choice: 1;
    in-out property <int> control-middle-click-choice: 0;
    in-out property <bool> control-accepts-first-mouse: false;
    in-out property <int> control-vertical-scroll-index: 0;
    in-out property <int> control-horizontal-scroll-index: 1;
    in-out property <bool> control-disable-play-slider-scrolling: false;
    in-out property <bool> control-disable-volume-slider-scrolling: false;
    in-out property <int> control-seek-type-index: 0;
    in-out property <int> control-relative-seek-amount: 3;
    in-out property <int> control-volume-sensitivity: 3;
    in-out property <int> control-speed-sensitivity: 3;
}

export component ControlPreferencesPage inherits ScrollView {
    in property <length> control-content-height;
    in-out property <length> control-scroll-position;
    in property <length> control-mouse-y;
    in property <length> control-scroll-y;
    in property <length> control-sensitivity-y;
    in property <bool> mica-backdrop-enabled;
    callback settings-changed();

    content-height: root.control-content-height; content-width: self.visible-width;
    content-y <=> root.control-scroll-position;
    horizontal-scrollbar-policy: always-off;
    Rectangle { width: parent.width; height: root.control-content-height;
        background: Theme.settings-content-surface(root.mica-backdrop-enabled);
        Text { x: 28px; y: 16px; text: @tr("Control"); font-size: 15px; font-weight: 600; color: Theme.settings-page-heading; }
        Text { x: 28px; y: 52px; text: @tr("Trackpad"); font-size: 13px; font-weight: 600; color: Theme.settings-section-heading; }
        Rectangle { x: 20px; y: 78px; width: parent.width - 40px; height: 82px;
            border-width: 1px; border-color: Theme.settings-input-card-border; border-radius: 10px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            VerticalLayout { spacing: 0px;
                PreferenceChoiceRow { label: @tr("Pinch to"); options: [@tr("Adjust window size"), @tr("Fullscreen"), @tr("None")];
                    selected-index <=> ControlSettingsState.control-pinch-index;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: @tr("Force Touch to"); options: [@tr("None"), @tr("Enter/Exit full screen"), @tr("Pause/Resume"), @tr("Hide OSC")];
                    selected-index <=> ControlSettingsState.control-force-touch-choice;
                    selected => { root.settings-changed(); }
                }
            }
        }

        Text { x: 28px; y: root.control-mouse-y; text: @tr("Mouse"); font-size: 13px; font-weight: 600; color: Theme.settings-section-heading; }
        Rectangle { x: 20px; y: root.control-mouse-y + 26px; width: parent.width - 40px; height: 204px;
            border-width: 1px; border-color: Theme.settings-input-card-border; border-radius: 10px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            VerticalLayout { spacing: 0px;
                PreferenceChoiceRow { label: @tr("Single click to"); options: [@tr("None"), @tr("Pause/Resume"), @tr("Hide OSC")];
                    selected-index <=> ControlSettingsState.control-single-click-choice;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: @tr("Double click to"); options: [@tr("None"), @tr("Enter/Exit full screen"), @tr("Pause/Resume"), @tr("Hide OSC"), @tr("Enter/Exit picture-in-picture"), @tr("A-B loop"), @tr("Reset speed")];
                    selected-index <=> ControlSettingsState.control-double-click-choice;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: @tr("Right click to"); options: [@tr("None"), @tr("Pause/Resume"), @tr("Hide OSC"), @tr("Enter/Exit picture-in-picture"), @tr("A-B loop"), @tr("Reset speed")];
                    selected-index <=> ControlSettingsState.control-right-click-choice;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: @tr("Middle click to"); options: [@tr("None"), @tr("Enter/Exit full screen"), @tr("Pause/Resume"), @tr("Hide OSC"), @tr("Enter/Exit picture-in-picture"), @tr("A-B loop"), @tr("Reset speed")];
                    selected-index <=> ControlSettingsState.control-middle-click-choice;
                    selected => { root.settings-changed(); }
                }
                Rectangle { height: 28px;
                PreferenceSwitch { x: 35px; width: parent.width - 47px; wrap-label: true;
                    label: @tr("Accepts first mouse click when not focused");
                    checked <=> ControlSettingsState.control-accepts-first-mouse;
                    toggled => { root.settings-changed(); }
                }
                }
            }
        }

        Text { x: 28px; y: root.control-scroll-y; text: @tr("Scroll"); font-size: 13px; font-weight: 600; color: Theme.settings-section-heading; }
        Rectangle { x: 20px; y: root.control-scroll-y + 26px; width: parent.width - 40px; height: 80px;
            border-width: 1px; border-color: Theme.settings-input-card-border; border-radius: 10px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            VerticalLayout { spacing: 0px;
                PreferenceChoiceRow { label: @tr("Scroll vertically to"); options: [@tr("Adjust volume"), @tr("Seek"), @tr("None"), @tr("Adjust playback speed")];
                    selected-index <=> ControlSettingsState.control-vertical-scroll-index;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: @tr("Scroll horizontally to"); options: [@tr("Adjust volume"), @tr("Seek"), @tr("None"), @tr("Adjust playback speed")];
                    selected-index <=> ControlSettingsState.control-horizontal-scroll-index;
                    selected => { root.settings-changed(); }
                }
            }
        }

        Text { x: 28px; y: root.control-sensitivity-y; text: @tr("Scrolling sensitivity"); font-size: 13px; font-weight: 600; color: Theme.settings-section-heading; }
        Rectangle { x: 20px; y: root.control-sensitivity-y + 26px; width: parent.width - 40px; height: 152px;
            border-width: 1px; border-color: Theme.settings-input-card-border; border-radius: 10px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            VerticalLayout { spacing: 0px;
                PreferenceChoiceRow { label: @tr("Seek type"); options: [@tr("Keyframe seek"), @tr("Exact seek"), @tr("Auto")];
                    selected-index <=> ControlSettingsState.control-seek-type-index;
                    selected => { root.settings-changed(); }
                }
                PreferenceSensitivityRow { label: @tr("Relative seek amount"); value <=> ControlSettingsState.control-relative-seek-amount;
                    changed => { root.settings-changed(); }
                }
                PreferenceSensitivityRow { label: @tr("Sensitivity for speed"); value <=> ControlSettingsState.control-speed-sensitivity;
                    changed => { root.settings-changed(); }
                }
                PreferenceSensitivityRow { label: @tr("Sensitivity for volume"); value <=> ControlSettingsState.control-volume-sensitivity;
                    changed => { root.settings-changed(); }
                }
            }
        }
    }
}
