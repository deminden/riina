import { PreferenceSwitch, PreferenceChoiceRow, PreferenceSensitivityRow } from "preferences-controls.slint";
import { ScrollView } from "std-widgets.slint";

export global ControlSettingsState {
    in-out property <int> control-pinch-index: 0;
    in-out property <int> control-force-touch-choice: 0;
    in-out property <int> control-single-click-choice: 2;
    in-out property <int> control-double-click-choice: 1;
    in-out property <int> control-right-click-choice: 1;
    in-out property <int> control-middle-click-choice: 0;
    in-out property <bool> control-accepts-first-mouse: false;
    in-out property <int> control-vertical-scroll-index: 0;
    in-out property <int> control-horizontal-scroll-index: 1;
    in-out property <bool> control-disable-play-slider-scrolling: false;
    in-out property <bool> control-disable-volume-slider-scrolling: false;
    in-out property <int> control-seek-type-index: 0;
    in-out property <int> control-relative-seek-amount: 3;
    in-out property <int> control-volume-sensitivity: 3;
    in-out property <int> control-speed-sensitivity: 3;
}

export component ControlPreferencesPage inherits ScrollView {
    in property <bool> mica-backdrop-enabled;
    callback settings-changed();

    content-height: 760px; content-width: self.visible-width;
    horizontal-scrollbar-policy: always-off;
    Rectangle { width: parent.width; height: 760px;
        background: root.mica-backdrop-enabled ? #ffffff80 : #ffffff;
        Text { x: 28px; y: 16px; text: "Control"; font-size: 15px; font-weight: 600; color: #222222; }
        Text { x: 28px; y: 52px; text: "Trackpad"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: 78px; width: parent.width - 40px; height: 82px;
            border-width: 1px; border-color: #e4e4e7; border-radius: 10px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            VerticalLayout { spacing: 0px;
                PreferenceChoiceRow { label: "Pinch to"; options: ["Adjust window size", "Fullscreen", "None"];
                    selected-index <=> ControlSettingsState.control-pinch-index;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: "Force Touch to"; options: ["None", "Enter/Exit full screen", "Pause/Resume", "Hide OSC"];
                    selected-index <=> ControlSettingsState.control-force-touch-choice;
                    selected => { root.settings-changed(); }
                }
            }
        }

        Text { x: 28px; y: 174px; text: "Mouse"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: 200px; width: parent.width - 40px; height: 204px;
            border-width: 1px; border-color: #e4e4e7; border-radius: 10px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            VerticalLayout { spacing: 0px;
                PreferenceChoiceRow { label: "Single click to"; options: ["None", "Pause/Resume", "Hide OSC"];
                    selected-index <=> ControlSettingsState.control-single-click-choice;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: "Double click to"; options: ["None", "Enter/Exit full screen", "Pause/Resume", "Hide OSC", "Enter/Exit picture-in-picture", "A-B loop", "Reset speed"];
                    selected-index <=> ControlSettingsState.control-double-click-choice;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: "Right click to"; options: ["None", "Pause/Resume", "Hide OSC", "Enter/Exit picture-in-picture", "A-B loop", "Reset speed"];
                    selected-index <=> ControlSettingsState.control-right-click-choice;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: "Middle click to"; options: ["None", "Enter/Exit full screen", "Pause/Resume", "Hide OSC", "Enter/Exit picture-in-picture", "A-B loop", "Reset speed"];
                    selected-index <=> ControlSettingsState.control-middle-click-choice;
                    selected => { root.settings-changed(); }
                }
                Rectangle { height: 28px;
                PreferenceSwitch { x: 35px; width: parent.width - 47px; label: "Accepts first mouse click when not focused";
                    checked <=> ControlSettingsState.control-accepts-first-mouse;
                    toggled => { root.settings-changed(); }
                }
                }
            }
        }

        Text { x: 28px; y: 418px; text: "Scroll"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: 444px; width: parent.width - 40px; height: 80px;
            border-width: 1px; border-color: #e4e4e7; border-radius: 10px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            VerticalLayout { spacing: 0px;
                PreferenceChoiceRow { label: "Scroll vertically to"; options: ["Adjust volume", "Seek", "None", "Adjust playback speed"];
                    selected-index <=> ControlSettingsState.control-vertical-scroll-index;
                    selected => { root.settings-changed(); }
                }
                PreferenceChoiceRow { label: "Scroll horizontally to"; options: ["Adjust volume", "Seek", "None", "Adjust playback speed"];
                    selected-index <=> ControlSettingsState.control-horizontal-scroll-index;
                    selected => { root.settings-changed(); }
                }
            }
        }

        Text { x: 28px; y: 538px; text: "Scrolling sensitivity"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: 564px; width: parent.width - 40px; height: 152px;
            border-width: 1px; border-color: #e4e4e7; border-radius: 10px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            VerticalLayout { spacing: 0px;
                PreferenceChoiceRow { label: "Seek type"; options: ["Keyframe seek", "Exact seek", "Auto"];
                    selected-index <=> ControlSettingsState.control-seek-type-index;
                    selected => { root.settings-changed(); }
                }
                PreferenceSensitivityRow { label: "Relative seek amount"; value <=> ControlSettingsState.control-relative-seek-amount;
                    changed => { root.settings-changed(); }
                }
                PreferenceSensitivityRow { label: "Sensitivity for speed"; value <=> ControlSettingsState.control-speed-sensitivity;
                    changed => { root.settings-changed(); }
                }
                PreferenceSensitivityRow { label: "Sensitivity for volume"; value <=> ControlSettingsState.control-volume-sensitivity;
                    changed => { root.settings-changed(); }
                }
            }
        }
    }
}
