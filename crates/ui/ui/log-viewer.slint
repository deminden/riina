import { Theme } from "theme.slint";
import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { NativeTypography, AuxiliaryPalette } from "shared-controls.slint";

export struct LogViewerRow {
    level: string,
    timestamp: string,
    subsystem: string,
    message: string,
    level-color: color,
    selected: bool,
}

export enum LogNavigation { previous, next, first, last }

export struct LogSubsystemChoice {
    name: string,
    selected: bool,
}

component LogSubsystemMenu inherits Rectangle {
    in property <[LogSubsystemChoice]> choices;
    in property <int> selected-count;
    callback toggled(string);
    callback cleared();

    Button {
        width: parent.width;
        height: parent.height;
        text: root.selected-count == 0 ? "All Subsystems" : root.selected-count + " Subsystems";
        clicked => { menu.show(); }
    }

    menu := PopupWindow {
        x: 0px; y: root.height;
        width: 254px;
        height: min(308px, 52px + root.choices.length * 28px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.auxiliary-light-window-surface;
            border-color: Theme.history-column-header;
            border-width: 1px;
            border-radius: 6px;

            init => { clear.focus(); }
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        menu.close();
                        return accept;
                    }
                    return reject;
                }
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    clear := Button {
                        text: "Clear Selections";
                        height: 30px;
                        clicked => { root.cleared(); }
                    }
                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        content-height: root.choices.length * 28px;
                        VerticalLayout {
                            for subsystem in root.choices : CheckBox {
                                height: 28px;
                                text: subsystem.name;
                                checked: subsystem.selected;
                                toggled => { root.toggled(subsystem.name); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component LogViewerWindow inherits Window {
    default-font-family: NativeTypography.system-font-family;
    title: "Log Viewer";
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    preferred-width: 980px;
    preferred-height: 620px;
    min-width: 900px;
    min-height: 360px;
    in-out property <bool> acrylic-backdrop-enabled: false;
    background: acrylic-backdrop-enabled ? transparent : Theme.auxiliary-light-window-surface;

    in property <[LogViewerRow]> rows: [];
    in property <[LogSubsystemChoice]> subsystems: [];
    in property <int> selected-subsystem-count: 0;
    in property <[string]> level-options: ["All Levels", "Fatal", "Error", "Warning", "Info", "Verbose", "Debug", "Trace"];
    in-out property <int> level-index: 0;
    in-out property <string> search-text: "";
    in-out property <bool> follow-latest: false;
    in-out property <length> log-scroll-y: 0px;
    in property <bool> has-selection: false;
    in property <bool> save-in-progress: false;
    in property <string> status-text: "";
    in property <string> feedback-text: "";
    private property <length> row-height: 21px;
    callback filters-changed();
    callback subsystem-toggled(string);
    callback subsystem-filter-cleared();
    callback refresh-logs();
    callback save-logs(bool);
    callback select-row(int, bool, bool);
    callback select-all-rows();
    callback navigate-rows(LogNavigation, bool);
    callback copy-rows(int);
    callback open-log-folder();
    changed search-text => { root.filters-changed(); }
    function bottom-offset() -> length {
        return min(0px, scroll.visible-height - root.rows.length * root.row-height);
    }
    public function logs-changed() {
        if root.follow-latest {
            root.log-scroll-y = root.bottom-offset();
        }
    }
    public function reveal-row(index: int) {
        let top = index * root.row-height;
        if top < -root.log-scroll-y {
            root.log-scroll-y = -top;
        } else if top + root.row-height > -root.log-scroll-y + scroll.visible-height {
            root.log-scroll-y = scroll.visible-height - top - root.row-height;
        }
        root.follow-latest = root.log-scroll-y <= root.bottom-offset() + 2px;
    }

    Rectangle {
        x: 0; y: 0; width: parent.width; height: 48px;
        background: root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.auxiliary-light-toolbar-surface;
        HorizontalLayout {
            x: 12px; y: 7px; width: parent.width - 24px; height: 34px; spacing: 5px;
            Button {
                text: "Follow Latest";
                width: 96px;
                checkable: true;
                checked: root.follow-latest;
                clicked => {
                    root.follow-latest = true;
                    root.log-scroll-y = root.bottom-offset();
                }
            }
            ComboBox {
                width: 112px; height: 28px;
                model: root.level-options;
                current-index <=> root.level-index;
                selected => { root.filters-changed(); }
            }
            LogSubsystemMenu {
                width: 170px; height: 28px;
                choices: root.subsystems;
                selected-count: root.selected-subsystem-count;
                toggled(name) => { root.subsystem-toggled(name); }
                cleared => { root.subsystem-filter-cleared(); }
            }
            search := LineEdit {
                width: 120px;
                horizontal-stretch: 1;
                height: 28px;
                placeholder-text: "Search logs";
                accessible-label: "Search logs";
                text <=> root.search-text;
            }
            Button { text: "Refresh"; width: 70px; clicked => { root.refresh-logs(); } }
            Button { text: "Save All"; width: 72px; enabled: !root.save-in-progress;
                clicked => { root.save-logs(false); } }
            Button { text: "Save Filtered"; width: 104px; enabled: !root.save-in-progress;
                clicked => { root.save-logs(true); } }
            Button {
                text: "Copy";
                width: 60px;
                enabled: root.has-selection;
                clicked => { root.copy-rows(-1); }
            }
            Button { text: "Open Folder"; width: 94px; clicked => { root.open-log-folder(); } }
        }
    }

    Rectangle {
        x: 12px; y: 55px; width: parent.width - 24px; height: 24px;
        background: root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.log-column-header;
        Text { x: 6px; width: 72px; height: parent.height; text: "Level"; font-size: 10px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
        Text { x: 78px; width: 86px; height: parent.height; text: "Time"; font-size: 10px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
        Text { x: 166px; width: 126px; height: parent.height; text: "Subsystem"; font-size: 10px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
        Text { x: 296px; width: parent.width - 302px; height: parent.height; text: "Message"; font-size: 10px; font-weight: 600; color: Theme.auxiliary-light-column-label; vertical-alignment: center; }
    }

    table-keys := FocusScope {
        x: 12px; y: 79px; width: parent.width - 24px; height: parent.height - 112px;
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.meta {
                if event.text == "a" || event.text == "A" { root.select-all-rows(); return accept; }
                if event.text == "c" || event.text == "C" { root.copy-rows(-1); return accept; }
                if event.text == "f" || event.text == "F" { search.focus(); return accept; }
                return reject;
            }
            if !event.modifiers.alt && (event.text == Key.UpArrow || event.text == Key.DownArrow
                    || event.text == Key.Home || event.text == Key.End) {
                let action = event.text == Key.UpArrow ? LogNavigation.previous
                    : event.text == Key.DownArrow ? LogNavigation.next
                    : event.text == Key.Home ? LogNavigation.first : LogNavigation.last;
                root.navigate-rows(action, event.modifiers.shift);
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: root.acrylic-backdrop-enabled
                ? AuxiliaryPalette.light-acrylic-fill : Theme.auxiliary-light-list-surface;
        }
        scroll := ListView {
            width: parent.width;
            // Keep large jumps to the newest record on a row boundary.
            height: floor(parent.height / root.row-height) * root.row-height;
            content-y <=> root.log-scroll-y;
            horizontal-scrollbar-policy: always-off;
            scrolled => { root.follow-latest = root.log-scroll-y <= root.bottom-offset() + 2px; }
            for row[index] in root.rows : Rectangle {
                width: scroll.visible-width - 14px;
                height: root.row-height;
                accessible-role: list-item;
                accessible-label: row.level + " " + row.subsystem + " " + row.message;
                accessible-checked: row.selected;
                accessible-action-default => { root.select-row(index, false, false); }
                background: row.selected ? Theme.auxiliary-light-row-selection
                    : root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill
                    : (Math.mod(index, 2) == 0 ? Theme.auxiliary-light-list-surface : Theme.auxiliary-light-list-alternate);
                Text { x: 6px; width: 72px; height: parent.height; text: row.level; color: row.level-color; font-size: 10px; font-family: "monospace"; vertical-alignment: center; overflow: elide; }
                Text { x: 78px; width: 86px; height: parent.height; text: row.timestamp; color: Theme.log-timestamp; font-size: 10px; font-family: "monospace"; vertical-alignment: center; overflow: elide; }
                Text { x: 166px; width: 126px; height: parent.height; text: row.subsystem; color: Theme.log-subsystem; font-size: 10px; font-family: "monospace"; vertical-alignment: center; overflow: elide; }
                Text { x: 296px; width: parent.width - 302px; height: parent.height; text: row.message; color: Theme.auxiliary-light-content-text; font-size: 10px; font-family: "monospace"; vertical-alignment: center; overflow: elide; }
                TouchArea {
                    width: parent.width; height: parent.height;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                            table-keys.focus();
                            root.select-row(index, event.modifiers.control || event.modifiers.meta,
                                event.modifiers.shift);
                        }
                    }
                    double-clicked => { root.copy-rows(index); }
                }
                ContextMenuArea {
                    width: parent.width; height: parent.height;
                    Menu {
                        MenuItem { title: "Copy"; activated => { root.copy-rows(index); } }
                    }
                }
            }
        }
        if root.rows.length == 0 : Text {
            x: 10px; y: 12px; width: parent.width - 20px; height: 28px;
            text: "No matching log entries";
            color: Theme.auxiliary-light-secondary-text; font-size: 12px;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    Rectangle {
        x: 0; y: parent.height - 28px; width: parent.width; height: 28px;
        background: root.acrylic-backdrop-enabled ? AuxiliaryPalette.light-acrylic-fill : Theme.auxiliary-light-toolbar-surface;
        Text {
            x: 12px; width: parent.width - 24px; height: parent.height;
            text: root.feedback-text.is-empty ? root.status-text : root.feedback-text;
            color: Theme.log-footer-text; font-size: 10px; vertical-alignment: center; overflow: elide;
        }
    }
}
