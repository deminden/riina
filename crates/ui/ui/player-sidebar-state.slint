import { PlayerCatalogState } from "player-catalog-state.slint";
import { PlayerCropState } from "player-crop-state.slint";
import { PlayerMenuActions } from "player-menu-actions.slint";
import { PlayerMusicModeState } from "player-music-mode-state.slint";
import { PlaylistDropViewport } from "playlist-drop-viewport.slint";
import { PlaylistInteraction } from "playlist-interaction.slint";

// The leading and trailing sidebars retain their own pane and width.
export global PlayerSidebarState {
    in-out property <bool> layout-scrollbar-visible: false;
    in-out property <int> sidebar: 0;
    in-out property <int> leading-sidebar: 0;
    in-out property <int> remembered-settings-pane: 6;
    in-out property <int> remembered-playlist-pane: 4;
    // Metadata can change the row height on entering Music Mode.
    in-out property <float> playlist-scroll-row;
    out property <length> playlist-row-stride: PlayerCatalogState.playlist-metadata-visible ? 39px : 31px;
    out property <length> playlist-scroll-y: root.playlist-scroll-row * root.playlist-row-stride;
    in-out property <length> chapters-scroll-y;
    in-out property <int> chapter-cursor: -1;
    in-out property <bool> settings-at-leading: false;
    in-out property <bool> playlist-at-leading: true;
    in-out property <bool> plugins-at-leading: true;
    in-out property <float> leading-sidebar-width: 360;
    in-out property <float> trailing-sidebar-width: 360;
    in-out property <[string]> plugin-sidebar-identifiers: [];
    in-out property <[string]> plugin-sidebar-labels: [];
    in-out property <string> plugin-sidebar-selected-identifier: "";
    in-out property <int> plugin-sidebar-selected-index: -1;
    in-out property <PlaylistDropViewport> leading-list-drop-viewport;
    in-out property <PlaylistDropViewport> trailing-list-drop-viewport;
    in-out property <PlaylistDropViewport> music-list-drop-viewport;
    out property <int> playlist-reorder-slot: PlaylistInteraction.playlist-drag-active
        ? root.playlist-drop-slot(PlaylistInteraction.playlist-drag-x / 1px,
            PlaylistInteraction.playlist-drag-y / 1px) : -1;
    out property <int> playlist-insertion-slot: PlaylistInteraction.playlist-drag-active ? root.playlist-reorder-slot
        : PlaylistInteraction.external-drop-hover.active
            ? root.playlist-drop-slot(PlaylistInteraction.external-drop-hover.x, PlaylistInteraction.external-drop-hover.y) : -1;
    out property <bool> quick-settings-visible: !PlayerMusicModeState.music-mode && !PlayerCropState.crop-editing
        && (root.is-quick-settings(root.sidebar) || root.is-quick-settings(root.leading-sidebar));
    private property <int> main-catalog-pane: root.playlist-at-leading ? root.leading-sidebar : root.sidebar;
    out property <int> visible-catalog-pane: PlayerCropState.crop-editing ? 0
        : PlayerMusicModeState.music-mode
            ? (PlayerMusicModeState.music-mode-show-playlist ? root.remembered-playlist-pane : 0)
            : (root.main-catalog-pane == 3 || root.main-catalog-pane == 4 ? root.main-catalog-pane : 0);

    public pure function is-quick-settings(pane: int) -> bool {
        return pane == 1 || pane == 2 || pane == 5 || pane == 6;
    }

    public function save-playlist-scroll(offset: length) {
        root.playlist-scroll-row = offset / root.playlist-row-stride;
    }

    changed sidebar => { PlaylistInteraction.cancel-playlist-drag(); }
    changed leading-sidebar => { PlaylistInteraction.cancel-playlist-drag(); }
    changed remembered-playlist-pane => { PlaylistInteraction.cancel-playlist-drag(); }
    changed visible-catalog-pane => { PlayerMenuActions.video-menu-changed(); }

    pure function drop-slot-in(view: PlaylistDropViewport, x: length, y: length) -> int {
        let local-x = x - view.x;
        let local-y = y - view.y;
        if local-x < 0px || local-x >= view.width || local-y < 0px || local-y >= view.height {
            return -1;
        }
        // Row midpoints divide gaps for insertion. Both views use a 1px row gap.
        return clamp(floor((local-y - view.content-y) / root.playlist-row-stride + 0.5),
            0, PlayerCatalogState.playlist.length);
    }

    public pure function playlist-drop-slot(x: float, y: float) -> int {
        if PlayerCropState.crop-editing { return -1; }
        if PlayerMusicModeState.music-mode {
            return root.visible-catalog-pane == 4
                ? root.drop-slot-in(root.music-list-drop-viewport, x * 1px, y * 1px) : -1;
        }
        if root.sidebar != 0 && root.sidebar != 5 {
            let slot = root.drop-slot-in(root.trailing-list-drop-viewport, x * 1px, y * 1px);
            if slot >= 0 { return root.sidebar == 4 ? slot : -1; }
        }
        return root.leading-sidebar == 4
            ? root.drop-slot-in(root.leading-list-drop-viewport, x * 1px, y * 1px) : -1;
    }
}
