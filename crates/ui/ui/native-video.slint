import { ApplicationMenuText } from "application-menu-text.slint";
import { PlaybackMenuText } from "playback-menu-text.slint";
import { PlayerEdit } from "player-menu-actions.slint";
export struct MenuCatalogRow { token: string, label: string, selected: bool }
export struct PluginMenuRow {
    token: string, label: string, enabled: bool, selected: bool, key-binding: string, shortcut: keys,
    section-header: bool, depth: int, submenu: bool, separator: bool,
}

export global PluginMenuDisplay {
    public pure function root-title() -> string {
        return "\u{1f}riina-plugin-menu:" + ApplicationMenuText.plugin-title + "\u{1f}" + ApplicationMenuText.more;
    }

    public pure function conflict-title(count: int) -> string {
        return @tr("Conflicting key shortcuts… ({})", count);
    }

    public pure function menu-title(row: PluginMenuRow) -> string {
        if row.token == "\u{1f}group-separator" { return row.label; }
        let kind = row.separator ? "s" : row.section-header ? "h" : row.submenu ? "b" : "a";
        return "\u{1f}riina-plugin-row:" + row.depth + ":" + kind + ":" + row.label;
    }
}
export struct SavedFilterMenuRow {
    token: string,
    label: string,
    selected: bool,
    shortcut: keys,
    shortcut-label: string,
    shortcut-key: string,
    shortcut-modifiers: int,
}
export struct MenuShortcutRow { shortcut: keys }

// The native video window owns OS-level menus while the shared chrome provides controls.
export component NativeVideoHost inherits Window {

    callback edit(PlayerEdit);
    callback window-minimized-changed(bool);
    changed minimized => { root.window-minimized-changed(root.minimized); }
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    callback open-preferences();
    callback manage-plugins();
    callback reload-plugins();
    callback activate-plugin-menu-item(string);
    callback open-plugin-developer-tool(string);
    in property <[PluginMenuRow]> plugin-menu-rows: [];
    in property <int> plugin-menu-conflicts;
    in property <[MenuCatalogRow]> plugin-developer-rows: [];
    callback open-media-file();
    callback open-file-alternative();
    callback reveal-current-media();
    callback delete-current-media();
    callback save-current-playlist();
    callback save-downloaded-subtitle();
    callback show-about();
    callback check-for-updates();
    callback open-help-link(string);
    callback dump-debug-info();
    callback show-playback-history();
    callback show-inspector();
    callback show-log-viewer();
    callback show-release-highlights();
    callback close-player();
    callback quit-riina();
    callback hide-riina();
    callback minimize-window();
    callback zoom-window();
    callback bring-all-to-front();
    callback select-player-window(string);
    in property <[MenuCatalogRow]> window-menu-rows: [];
    in property <bool> bring-all-to-front-available: false;
    in property <[MenuShortcutRow]> menu-shortcuts: [];
    in-out property <bool> mica-backdrop-enabled: false;
    callback menu-shortcuts-changed();
    changed menu-shortcuts => { root.menu-shortcuts-changed(); }
    function menu-shortcut(index: int) -> keys {
        if index < 0 || index >= root.menu-shortcuts.length { return @keys(); }
        return root.menu-shortcuts[index].shortcut;
    }
    callback open-url-dialog();
    callback open-url-alternative();
    in property <bool> primary-shortcut-is-meta: false;
    callback open-recent-path(string);
    callback clear-open-recent();
    callback open-jump-time-dialog();
    in property <bool> record-recent-files: true;
    in property <bool> enable-new-window-shortcut;
    callback create-welcome-window();
    in property <bool> open-in-new-player: true;
    in property <[MenuCatalogRow]> recent-open-menu-rows: [];
    in property <bool> playback-loaded: false;
    in property <int> open-subtitles-provider-index: 0;
    in property <string> open-subtitles-plugin-provider-label;
    in property <[MenuCatalogRow]> plugin-subtitle-providers;
    in property <bool> video-panel-open: false;
    in property <int> visible-catalog-pane;
    in property <bool> audio-panel-open: false;
    in property <bool> subtitles-panel-open: false;
    in property <bool> plugins-panel-open: false;
    in property <bool> reveal-current-media-available: false;
    in property <bool> delete-current-media-available: false;
    in property <bool> save-current-playlist-available: false;
    in property <bool> downloaded-subtitle-save-available: false;
    in property <string> current-file-manager-name: "File Manager";
    in property <bool> video-resize-available: false;
    in property <bool> playback-paused: true;
    in property <bool> menu-alternates-visible: false;
    in property <bool> playback-muted: false;
    in property <string> loop-label: "Off";
    callback toggle-pause();
    callback stop();
    callback seek-relative(float);
    callback seek(float);
    callback frame-step();
    callback frame-back-step();
    callback set-speed(float);
    callback reset-speed();
    callback cycle-ab-loop();
    callback toggle-file-loop();
    callback toggle-playlist-loop();
    callback playlist-next();
    callback playlist-previous();
    in property <[MenuCatalogRow]> playlist-menu-rows: [];
    callback select-menu-playlist-item(string);
    callback show-playlist-panel();
    callback show-chapters-panel();
    in property <[MenuCatalogRow]> chapter-menu-rows: [];
    callback select-menu-chapter-item(string);
    callback adjust-chapter(int);
    callback show-video-panel();
    callback show-plugins-panel();
    callback cycle-audio-tracks();
    callback select-menu-audio-track(string);
    callback load-external-audio();
    in property <[MenuCatalogRow]> audio-track-menu-rows: [];
    in property <[MenuCatalogRow]> audio-device-menu-rows: [];
    callback select-audio-device(string);
    callback adjust-volume(float);
    callback toggle-mute();
    callback show-audio-panel();
    callback adjust-audio-delay(float);
    callback reset-audio-delay();
    callback cycle-subtitles();
    callback toggle-subtitle-visibility();
    callback show-subtitles-panel();
    in property <bool> subtitle-visible: true;
    in property <[MenuCatalogRow]> subtitle-track-menu-rows: [];
    in property <[MenuCatalogRow]> secondary-subtitle-menu-rows: [];
    in property <[MenuCatalogRow]> subtitle-encoding-menu-rows: [];
    in property <bool> secondary-subtitle-visible: false;
    in property <bool> secondary-subtitle-visibility-known: false;
    in property <bool> subtitle-scale-known: false;
    in property <string> subtitle-default-encoding: "auto";
    callback select-subtitle-track(string);
    callback select-secondary-subtitle(string);
    callback toggle-secondary-subtitle-visibility();
    callback load-external-subtitle();
    callback find-online-subtitles();
    callback find-online-subtitles-with-provider(int);
    callback find-online-subtitles-with-plugin(string);
    callback set-subtitle-encoding(string);
    callback multiply-subtitle-scale(float);
    callback reset-subtitle-scale();
    callback adjust-subtitle-delay(float);
    callback reset-subtitle-delay();
    callback choose-subtitle-font();
    callback cycle-video-track();
    in property <[MenuCatalogRow]> video-track-menu-rows: [];
    callback select-video-track(string);
    callback fit-window-to-video();
    callback resize-window-command(int);
    callback toggle-fullscreen();
    callback toggle-float-on-top();
    callback toggle-window-aspect-lock();
    callback toggle-live-text();
    in property <bool> live-text-available: false;
    in property <bool> live-text-enabled: false;
    in property <bool> always-float-on-top: false;
    in property <bool> unlock-window-aspect-ratio: false;
    callback toggle-picture-in-picture();
    in property <bool> picture-in-picture-active: false;
    in property <bool> picture-in-picture-available: false;
    in property <bool> music-mode-available: false;
    in property <bool> music-mode: false;
    callback toggle-music-mode();
    in property <bool> screenshot-available: false;
    in property <bool> screenshot-folder-enabled: true;
    callback take-screenshot();
    callback open-screenshot-folder();
    in property <bool> deinterlace-menu-enabled: false;
    in property <bool> deinterlace-enabled: false;
    callback toggle-deinterlace();
    in property <bool> delogo-menu-enabled: false;
    in property <bool> delogo-active: false;
    callback toggle-delogo();
    in property <[SavedFilterMenuRow]> saved-video-filter-rows: [];
    callback toggle-saved-video-filter(string, string);
    callback open-video-filters();
    in property <[SavedFilterMenuRow]> saved-audio-filter-rows: [];
    callback toggle-saved-audio-filter(string, string);
    callback open-audio-filters();
    in property <bool> aspect-menu-enabled: false;
    in property <[string]> aspect-menu-labels;
    in property <int> video-aspect-menu-index: 0;
    callback set-menu-video-aspect(int);
    in property <bool> reflection-menu-enabled: false;
    in property <bool> video-mirrored: false;
    in property <bool> video-flipped: false;
    callback toggle-video-reflection(bool);
    in property <bool> crop-menu-enabled: false;
    in property <[string]> crop-menu-labels;
    in property <int> crop-menu-index: -1;
    callback set-menu-video-crop(int);
    in property <bool> rotation-menu-enabled: false;
    in property <int> video-rotation-index: -1;
    callback set-menu-video-rotation(int);
    in property <bool> fullscreen-mode: false;
    callback set-fullscreen-window(bool) -> bool;
    // Windows detaches this stable native menu for fullscreen and Music Mode.
    // Destroying its Slint tree also tears down the host's menu/compositor state.
    MenuBar {
        Menu { title: "riina";
            MenuItem { title: ApplicationMenuText.about; activated => { root.show-about(); } }
            MenuItem { title: ApplicationMenuText.check-updates; activated => { root.check-for-updates(); } }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.preferences;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + ",") : @keys(Control + ",");
                activated => { root.open-preferences(); } }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.services-title; enabled: false; }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.hide;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + H) : @keys(Control + H);
                activated => { root.hide-riina(); } }
            MenuItem { title: ApplicationMenuText.quit;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Q) : @keys(Control + Q);
                activated => { root.quit-riina(); }
            }
        }
        Menu { title: ApplicationMenuText.file-title;
            MenuItem { title: root.open-in-new-player ? ApplicationMenuText.open-in-new-window : ApplicationMenuText.open;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + O) : @keys(Control + O);
                activated => { root.open-media-file(); } }
            MenuItem { title: root.open-in-new-player ? ApplicationMenuText.open : ApplicationMenuText.open-in-new-window;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Alt + O) : @keys(Control + Alt + O);
                activated => { root.open-file-alternative(); } }
            MenuItem { title: root.open-in-new-player ? ApplicationMenuText.open-url-in-new-window : ApplicationMenuText.open-url;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + O) : @keys(Control + Shift + O);
                activated => { root.open-url-dialog(); } }
            MenuItem { title: root.open-in-new-player ? ApplicationMenuText.open-url : ApplicationMenuText.open-url-in-new-window;
                shortcut: root.primary-shortcut-is-meta
                    ? @keys(Meta + Alt + Shift + O) : @keys(Control + Alt + Shift + O);
                activated => { root.open-url-alternative(); } }
            if root.record-recent-files : Menu {
                title: ApplicationMenuText.open-recent;
                enabled: root.recent-open-menu-rows.length > 0;
                for row in root.recent-open-menu-rows : MenuItem {
                    title: row.label;
                    activated => { root.open-recent-path(row.token); }
                }
                MenuSeparator {}
                MenuItem { title: ApplicationMenuText.clear-recent; enabled: root.recent-open-menu-rows.length > 0;
                    activated => { root.clear-open-recent(); } }
            }
            if root.enable-new-window-shortcut : MenuSeparator {}
            if root.enable-new-window-shortcut : MenuItem {
                title: ApplicationMenuText.new-window;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + N) : @keys(Control + N);
                activated => { root.create-welcome-window(); }
            }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.playback-history;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + H) : @keys(Control + Shift + H);
                activated => { root.show-playback-history(); } }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.reveal-current(root.current-file-manager-name);
                    shortcut: root.menu-shortcut(56);
                enabled: root.reveal-current-media-available;
                activated => { root.reveal-current-media(); } }
            MenuItem { title: ApplicationMenuText.delete-current;
                enabled: root.delete-current-media-available;
                activated => { root.delete-current-media(); } }
            MenuItem { title: ApplicationMenuText.save-current-playlist;
                    shortcut: root.menu-shortcut(57);
                enabled: root.save-current-playlist-available;
                activated => { root.save-current-playlist(); } }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.close;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + W) : @keys(Control + W);
                activated => { root.close-player(); } }
        }
        Menu { title: ApplicationMenuText.edit-title;
            MenuItem { title: ApplicationMenuText.undo; enabled: false;
                activated => { root.edit(PlayerEdit.undo); }
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Z) : @keys(Control + Z); }
            MenuItem { title: ApplicationMenuText.redo; enabled: false;
                activated => { root.edit(PlayerEdit.redo); }
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + Z) : @keys(Control + Shift + Z); }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.cut; enabled: false;
                activated => { root.edit(PlayerEdit.cut); }
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + X) : @keys(Control + X); }
            MenuItem { title: ApplicationMenuText.copy; enabled: false;
                activated => { root.edit(PlayerEdit.copy); }
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + C) : @keys(Control + C); }
            MenuItem { title: ApplicationMenuText.paste; enabled: false;
                activated => { root.edit(PlayerEdit.paste); }
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + V) : @keys(Control + V); }
            MenuItem { title: ApplicationMenuText.delete; enabled: false;
                activated => { root.edit(PlayerEdit.delete); } }
            MenuItem { title: ApplicationMenuText.select-all; enabled: false;
                activated => { root.edit(PlayerEdit.select-all); }
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + A) : @keys(Control + A); }
        }
        Menu { title: @tr("Playback");
            MenuItem { title: root.playback-paused ? @tr("Resume") : @tr("Pause");
                enabled: root.playback-loaded; shortcut: root.menu-shortcut(0);
                activated => { root.toggle-pause(); } }
            MenuItem { title: @tr("Stop and Clear Playlists"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(1);
                activated => { root.stop(); } }
            MenuSeparator {}
            MenuItem { title: root.menu-alternates-visible ? @tr("Next Frame") : @tr("Step Forward 5s");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 4 : 2);
                activated => { if root.menu-alternates-visible { root.frame-step(); } else { root.seek-relative(5); } } }
            MenuItem { title: root.menu-alternates-visible ? @tr("Previous Frame") : @tr("Step Backward 5s");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 5 : 3);
                activated => { if root.menu-alternates-visible { root.frame-back-step(); } else { root.seek-relative(-5); } } }
            MenuItem { title: @tr("Jump to Beginning"); enabled: root.playback-loaded;
                activated => { root.seek(0); } }
            MenuItem { title: @tr("Jump to…"); enabled: root.playback-loaded;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + J) : @keys(Control + J);
                activated => { root.open-jump-time-dialog(); } }
            MenuSeparator {}
            MenuItem { title: PlaybackMenuText.speed("1"); enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? @tr("Speed Up by 1.1x") : @tr("Speed Up by 2x");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 9 : 7);
                activated => { root.set-speed(root.menu-alternates-visible ? 1.1 : 2); } }
            MenuItem { title: root.menu-alternates-visible ? @tr("Speed Down by 0.9x") : @tr("Speed Down by 0.5x");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 10 : 8);
                activated => { root.set-speed(root.menu-alternates-visible ? 0.9 : 0.5); } }
            MenuItem { title: @tr("Reset Speed"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(6);
                activated => { root.reset-speed(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Take a Screenshot"); enabled: root.screenshot-available;
                shortcut: root.menu-shortcut(11);
                activated => { root.take-screenshot(); } }
            MenuItem { title: @tr("Go to Screenshot Folder"); enabled: root.screenshot-folder-enabled;
                activated => { root.open-screenshot-folder(); } }
            MenuSeparator {}
            MenuItem { title: @tr("A-B Loop"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(46);
                activated => { root.cycle-ab-loop(); } }
            MenuItem { title: @tr("File Loop"); checkable: true; checked: root.loop-label == "File";
                shortcut: root.menu-shortcut(47);
                enabled: root.playback-loaded; activated => { root.toggle-file-loop(); } }
            MenuSeparator {}
            MenuItem { title: root.visible-catalog-pane == 4 ? @tr("Hide Playlist Panel") : @tr("Show Playlist Panel");
                shortcut: root.menu-shortcut(12);
                activated => { root.show-playlist-panel(); } }
            MenuItem { title: @tr("Playlist Loop"); checkable: true; checked: root.loop-label == "Playlist";
                enabled: root.playback-loaded; activated => { root.toggle-playlist-loop(); } }
            Menu { title: @tr("Playlist"); enabled: root.playback-loaded && root.playlist-menu-rows.length > 0;
                for row in root.playlist-menu-rows : MenuItem {
                    title: row.label;
                    checkable: true; checked: row.selected;
                    activated => { root.select-menu-playlist-item(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Next Media"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(13);
                activated => { root.playlist-next(); } }
            MenuItem { title: @tr("Previous Media"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(14);
                activated => { root.playlist-previous(); } }
            MenuItem { title: root.visible-catalog-pane == 3 ? @tr("Hide Chapters Panel") : @tr("Show Chapters Panel");
                shortcut: root.menu-shortcut(15);
                activated => { root.show-chapters-panel(); } }
            Menu { title: @tr("Chapters"); enabled: root.playback-loaded && root.chapter-menu-rows.length > 0;
                for row in root.chapter-menu-rows : MenuItem {
                    title: row.label;
                    checkable: true; checked: row.selected;
                    activated => { root.select-menu-chapter-item(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Next Chapter"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(16);
                activated => { root.adjust-chapter(1); } }
            MenuItem { title: @tr("Previous Chapter"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(17);
                activated => { root.adjust-chapter(-1); } }
        }
        Menu { title: @tr("Video");
            MenuItem { title: root.video-panel-open ? @tr("Hide Video Panel") : @tr("Show Video Panel"); shortcut: root.menu-shortcut(18);
                activated => { root.show-video-panel(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Cycle Video Tracks"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(19);
                activated => { root.cycle-video-track(); } }
            Menu { title: @tr("Video Track"); enabled: root.playback-loaded && root.video-track-menu-rows.length > 0;
                for row in root.video-track-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-video-track(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Half Size"); enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(20);
                activated => { root.resize-window-command(0); } }
            MenuItem { title: @tr("Normal Size"); enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(21);
                activated => { root.resize-window-command(1); } }
            MenuItem { title: @tr("Double Size"); enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(22);
                activated => { root.resize-window-command(2); } }
            MenuItem { title: @tr("Fit to Screen"); shortcut: root.menu-shortcut(23);
                activated => { root.resize-window-command(3); } }
            MenuSeparator {}
            MenuItem { title: @tr("Bigger Size"); enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(24);
                activated => { root.resize-window-command(4); } }
            MenuItem { title: @tr("Smaller Size"); enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(25);
                activated => { root.resize-window-command(5); } }
            MenuSeparator {}
            MenuItem {
                title: root.picture-in-picture-active ? @tr("Exit Picture in Picture") : @tr("Enter Picture in Picture");
                enabled: root.picture-in-picture-active || root.picture-in-picture-available;
                shortcut: root.menu-shortcut(26);
                activated => { root.toggle-picture-in-picture(); }
            }
            MenuItem { title: root.fullscreen-mode ? @tr("Exit Full Screen") : @tr("Enter Full Screen");
                checkable: true; checked: root.fullscreen-mode;
                shortcut: root.menu-shortcut(27);
                activated => { root.toggle-fullscreen(); } }
            MenuItem { title: @tr("Float on Top"); checkable: true; checked: root.always-float-on-top;
                shortcut: root.menu-shortcut(28);
                activated => { root.toggle-float-on-top(); } }
            MenuItem { title: @tr("Lock Window Aspect Ratio"); checkable: true;
                checked: !root.unlock-window-aspect-ratio;
                activated => { root.toggle-window-aspect-lock(); } }
            MenuItem { title: @tr("Live Text");
                checkable: true; checked: root.live-text-enabled;
                enabled: root.live-text-available;
                shortcut: root.menu-shortcut(29);
                activated => { root.toggle-live-text(); } }
            MenuSeparator {}
            MenuItem { title: root.music-mode ? @tr("Exit Music Mode") : @tr("Enter Music Mode");
                checkable: true; checked: root.music-mode;
                enabled: root.music-mode-available;
                shortcut: root.menu-shortcut(30);
                activated => { root.toggle-music-mode(); } }
            MenuSeparator {}
            Menu { title: @tr("Aspect Ratio"); enabled: root.aspect-menu-enabled;
                for label[index] in root.aspect-menu-labels : MenuItem {
                    title: index == 0 ? @tr("Default") : label; checkable: true; checked: root.video-aspect-menu-index == index;
                    activated => { root.set-menu-video-aspect(index); }
                }
            }
            Menu { title: @tr("Crop"); enabled: root.crop-menu-enabled;
                for label[index] in root.crop-menu-labels : MenuItem {
                    title: index == 0 ? @tr("None") : label; checkable: true; checked: root.crop-menu-index == index;
                    activated => { root.set-menu-video-crop(index); }
                }
                MenuSeparator {}
                MenuItem { title: @tr("Custom…"); checkable: true; checked: root.crop-menu-index == 10;
                    activated => { root.set-menu-video-crop(10); } }
            }
            Menu { title: @tr("Rotation"); enabled: root.rotation-menu-enabled;
                MenuItem { title: "0°"; checkable: true; checked: root.video-rotation-index == 0;
                    activated => { root.set-menu-video-rotation(0); } }
                MenuItem { title: "90°"; checkable: true; checked: root.video-rotation-index == 1;
                    activated => { root.set-menu-video-rotation(90); } }
                MenuItem { title: "180°"; checkable: true; checked: root.video-rotation-index == 2;
                    activated => { root.set-menu-video-rotation(180); } }
                MenuItem { title: "270°"; checkable: true; checked: root.video-rotation-index == 3;
                    activated => { root.set-menu-video-rotation(270); } }
            }
            Menu { title: @tr("Flip"); enabled: root.reflection-menu-enabled;
                MenuItem { title: @tr("Horizontal (Mirror)");
                    shortcut: root.menu-shortcut(58); checkable: true; checked: root.video-mirrored;
                    activated => { root.toggle-video-reflection(true); } }
                MenuItem { title: @tr("Vertical (Flip)");
                    shortcut: root.menu-shortcut(59); checkable: true; checked: root.video-flipped;
                    activated => { root.toggle-video-reflection(false); } }
            }
            MenuItem { title: @tr("Deinterlace"); checkable: true; checked: root.deinterlace-enabled;
                enabled: root.deinterlace-menu-enabled;
                activated => { root.toggle-deinterlace(); } }
            MenuItem { title: @tr("Delogo"); checkable: true; checked: root.delogo-active;
                enabled: root.delogo-menu-enabled;
                activated => { root.toggle-delogo(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Video Filters…");
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + F) : @keys(Control + Shift + F);
                activated => { root.open-video-filters(); } }
            Menu { title: @tr("Saved Video Filters"); enabled: root.playback-loaded;
                for row in root.saved-video-filter-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    shortcut: row.shortcut;
                    activated => { root.toggle-saved-video-filter(row.token, row.label); }
                }
            }
        }
        Menu { title: PlaybackMenuText.audio-title;
            MenuItem { title: root.audio-panel-open ? @tr("Hide Audio Panel") : @tr("Show Audio Panel"); shortcut: root.menu-shortcut(31);
                activated => { root.show-audio-panel(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Cycle Audio Tracks"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(32);
                activated => { root.cycle-audio-tracks(); } }
            Menu { title: PlaybackMenuText.audio-track-title; enabled: root.playback-loaded;
                for row in root.audio-track-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-menu-audio-track(row.token); }
                }
            }
            MenuItem { title: PlaybackMenuText.load-external-audio-title; enabled: root.playback-loaded;
                activated => { root.load-external-audio(); } }
            MenuSeparator {}
            // The Windows menu adapter refreshes this label in place on opening.
            MenuItem { title: PlaybackMenuText.volume("100", false); enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? @tr("Volume + 1%") : @tr("Volume + 5%");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 35 : 33);
                activated => { root.adjust-volume(root.menu-alternates-visible ? 1 : 5); } }
            MenuItem { title: root.menu-alternates-visible ? @tr("Volume - 1%") : @tr("Volume - 5%");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 36 : 34);
                activated => { root.adjust-volume(root.menu-alternates-visible ? -1 : -5); } }
            MenuItem { title: @tr("Mute"); checkable: true; checked: root.playback-muted;
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(37);
                activated => { root.toggle-mute(); } }
            MenuSeparator {}
            MenuItem { title: PlaybackMenuText.audio-delay("0"); enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? @tr("Audio Delay + 0.1s") : @tr("Audio Delay + 0.5s");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 40 : 38);
                activated => { root.adjust-audio-delay(root.menu-alternates-visible ? 0.1 : 0.5); } }
            MenuItem { title: root.menu-alternates-visible ? @tr("Audio Delay - 0.1s") : @tr("Audio Delay - 0.5s");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 41 : 39);
                activated => { root.adjust-audio-delay(root.menu-alternates-visible ? -0.1 : -0.5); } }
            MenuItem { title: @tr("Reset Audio Delay"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(48);
                activated => { root.reset-audio-delay(); } }
            MenuSeparator {}
            Menu { title: @tr("Audio Device");
                enabled: root.playback-loaded && root.audio-device-menu-rows.length > 0;
                for row in root.audio-device-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-audio-device(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Audio Filters…");
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + G) : @keys(Control + Shift + G);
                activated => { root.open-audio-filters(); } }
            Menu { title: @tr("Saved Audio Filters"); enabled: root.playback-loaded;
                for row in root.saved-audio-filter-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    shortcut: row.shortcut;
                    activated => { root.toggle-saved-audio-filter(row.token, row.label); }
                }
            }
        }
        Menu { title: @tr("Subtitles");
            MenuItem { title: root.subtitles-panel-open ? @tr("Hide Subtitles Panel") : @tr("Show Subtitles Panel"); shortcut: root.menu-shortcut(42);
                activated => { root.show-subtitles-panel(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Cycle Subtitles"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(43);
                activated => { root.cycle-subtitles(); } }
            Menu { title: @tr("Subtitle"); enabled: root.playback-loaded;
                for row in root.subtitle-track-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-subtitle-track(row.token); }
                }
            }
            MenuItem { title: root.subtitle-visible ? @tr("Hide Subtitles") : @tr("Show Subtitles");
                checkable: true; checked: root.subtitle-visible; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(44);
                activated => { root.toggle-subtitle-visibility(); } }
            Menu { title: @tr("Secondary Subtitle"); enabled: root.playback-loaded;
                for row in root.secondary-subtitle-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-secondary-subtitle(row.token); }
                }
            }
            MenuItem { title: root.secondary-subtitle-visible ? @tr("Hide Secondary Subtitles") : @tr("Show Secondary Subtitles");
                checkable: true; checked: root.secondary-subtitle-visible;
                enabled: root.playback-loaded && root.secondary-subtitle-visibility-known;
                shortcut: root.menu-shortcut(54);
                activated => { root.toggle-secondary-subtitle-visibility(); }
            }
            MenuItem { title: @tr("Load External Subtitle…"); enabled: root.playback-loaded;
                activated => { root.load-external-subtitle(); } }
            MenuSeparator {}
            MenuItem { title: PlaybackMenuText.online-subtitles(root.open-subtitles-plugin-provider-label,
                    root.open-subtitles-provider-index); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(55);
                activated => { root.find-online-subtitles(); } }
            Menu { title: @tr("Find Online Subtitles from"); enabled: root.playback-loaded;
                MenuItem { title: "opensubtitles.com"; activated => { root.find-online-subtitles-with-provider(0); } }
                MenuItem { title: "assrt.net"; activated => { root.find-online-subtitles-with-provider(1); } }
                MenuItem { title: "shooter.cn"; activated => { root.find-online-subtitles-with-provider(2); } }
                for provider in root.plugin-subtitle-providers : MenuItem {
                    title: provider.label;
                    activated => { root.find-online-subtitles-with-plugin(provider.token); }
                }
            }
            MenuItem { title: @tr("Save Downloaded Subtitle…");
                    shortcut: root.menu-shortcut(60);
                enabled: root.downloaded-subtitle-save-available;
                activated => { root.save-downloaded-subtitle(); }
            }
            MenuSeparator {}
            Menu { title: @tr("Encoding"); enabled: root.playback-loaded;
                for row in root.subtitle-encoding-menu-rows : MenuItem {
                    title: row.token == "auto" ? @tr("Auto detect") : row.label; checkable: true;
                    checked: root.subtitle-default-encoding == row.token;
                    activated => { root.set-subtitle-encoding(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: @tr("Scale Up"); enabled: root.playback-loaded && root.subtitle-scale-known;
                activated => { root.multiply-subtitle-scale(1.1); } }
            MenuItem { title: @tr("Scale Down"); enabled: root.playback-loaded && root.subtitle-scale-known;
                activated => { root.multiply-subtitle-scale(0.9); } }
            MenuItem { title: @tr("Reset Subtitle Scale"); enabled: root.playback-loaded && root.subtitle-scale-known;
                activated => { root.reset-subtitle-scale(); } }
            MenuSeparator {}
            MenuItem { title: PlaybackMenuText.subtitle-delay("0"); enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? @tr("Subtitle Delay + 0.1s") : @tr("Subtitle Delay + 0.5s");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 52 : 49);
                activated => { root.adjust-subtitle-delay(root.menu-alternates-visible ? 0.1 : 0.5); } }
            MenuItem { title: root.menu-alternates-visible ? @tr("Subtitle Delay - 0.1s") : @tr("Subtitle Delay - 0.5s");
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 53 : 50);
                activated => { root.adjust-subtitle-delay(root.menu-alternates-visible ? -0.1 : -0.5); } }
            MenuItem { title: @tr("Reset Subtitle Delay"); enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(51);
                activated => { root.reset-subtitle-delay(); } }
            MenuSeparator {}
            MenuItem { title: @tr("Font…"); activated => { root.choose-subtitle-font(); } }
        }
        Menu { title: PluginMenuDisplay.root-title();
            if root.plugin-menu-conflicts > 0 : MenuItem {
                title: PluginMenuDisplay.conflict-title(root.plugin-menu-conflicts); enabled: false;
            }
            MenuItem { title: ApplicationMenuText.manage-plugins; activated => { root.manage-plugins(); } }
            MenuItem { title: root.plugins-panel-open ? ApplicationMenuText.hide-plugin-panel : ApplicationMenuText.show-plugin-panel; shortcut: root.menu-shortcut(45);
                activated => { root.show-plugins-panel(); } }
            MenuSeparator {}
            for row in root.plugin-menu-rows : MenuItem {
                title: PluginMenuDisplay.menu-title(row);
                enabled: row.enabled;
                checkable: false;
                checked: row.selected;
                shortcut: row.shortcut;
                activated => { root.activate-plugin-menu-item(row.token); }
            }
            if root.plugin-menu-rows.length > 0 : MenuSeparator {}
            Menu { title: ApplicationMenuText.developer-tool; enabled: root.plugin-developer-rows.length > 0;
                for row in root.plugin-developer-rows : MenuItem {
                    title: row.label;
                    activated => { root.open-plugin-developer-tool(row.token); }
                }
            }
            MenuItem { title: ApplicationMenuText.reload-plugins; activated => { root.reload-plugins(); } }
        }
        Menu { title: ApplicationMenuText.window-title;
            MenuItem { title: ApplicationMenuText.minimize;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + M) : @keys(Control + M);
                activated => { root.minimize-window(); }
            }
            MenuItem { title: ApplicationMenuText.zoom; activated => { root.zoom-window(); } }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.inspector;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + I) : @keys(Control + I);
                activated => { root.show-inspector(); }
            }
            MenuItem { title: ApplicationMenuText.log-viewer;
                shortcut: root.primary-shortcut-is-meta
                    ? @keys(Control + Meta + L) : @keys(Control + Alt + L);
                activated => { root.show-log-viewer(); }
            }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.bring-to-front;
                enabled: root.bring-all-to-front-available;
                activated => { root.bring-all-to-front(); } }
            if root.window-menu-rows.length > 0 : MenuSeparator {}
            for row in root.window-menu-rows : MenuItem {
                title: row.label; checkable: true; checked: row.selected;
                activated => { root.select-player-window(row.token); }
            }
        }
        Menu { title: ApplicationMenuText.help-title;
            MenuItem { title: ApplicationMenuText.help;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + "/") : @keys(Control + Shift + "/");
                activated => { root.open-help-link("help"); } }
            MenuItem { title: ApplicationMenuText.dump-debug; activated => { root.dump-debug-info(); } }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.new-settings; checkable: true; checked: true;
                activated => { root.open-preferences(); } }
            MenuSeparator {}
            MenuItem { title: ApplicationMenuText.release-highlights; activated => { root.show-release-highlights(); } }
            MenuSeparator {}
            MenuItem { title: "GitHub"; activated => { root.open-help-link("github"); } }
            MenuItem { title: ApplicationMenuText.website; activated => { root.open-help-link("website"); } }
        }
    }
    in property <string> display-title: "riina";
    title: display-title;
    preferred-width: 960px;
    preferred-height: 600px;
    min-width: 285px;
    min-height: 120px;
    // The native video target must stay opaque: transparency here exposes
    // unrelated desktop windows through decoded video on some DWM paths.
    // Controls keep their own transparent HWND and can still use video-backed
    // materials without making the playback surface itself see-through.
    background: black;
}
