import { Theme } from "theme.slint";
import { PlayerCatalogState } from "player-catalog-state.slint";
import { CatalogRow } from "catalog-row.slint";

import { PlaylistInteraction, PlaylistMenuOrigin } from "playlist-interaction.slint";
import { PlaylistContextMenu } from "playlist-context-menu.slint";

export component CatalogSidebarRow inherits Rectangle {
    in property <CatalogRow> entry;
    in property <int> index;
    in property <int> pane-kind;
    in property <bool> dark-theme;
    in property <color> interactive-accent-color;
    callback select-row(string);
    callback select-playlist-row(int, bool, bool) -> [string];
    callback reorder-playlist([string], int);

    property <int> current-playlist-focus-index: PlaylistInteraction.playlist-focus-index;
    height: pane-kind < 3 || pane-kind == 6 ? 26px : pane-kind == 3 ? 40px
        : (PlayerCatalogState.playlist-metadata-visible ? 38px : 30px);
    background: (pane-kind == 2 || pane-kind == 6) ? transparent
        : entry.selected ? Theme.sidebar-row-selection(root.dark-theme) : transparent;
    accessible-role: button; accessible-label: pane-kind == 4 && entry.path != ""
        ? entry.label + (entry.detail != "" ? ", " + entry.detail : "") + ", " + entry.path : entry.label;
    if pane-kind == 2 || pane-kind == 6 : Rectangle {
        x: 0; y: parent.height - 1px; width: parent.width; height: 1px;
        background: Theme.sidebar-material-border(root.dark-theme);
    }
    if pane-kind == 4 && PlaylistInteraction.playlist-drag-active && PlaylistInteraction.playlist-drop-index == index : Rectangle {
        x: 0; y: 0; width: parent.width; height: 2px; background: root.interactive-accent-color;
    }
    if pane-kind == 4 && PlaylistInteraction.playlist-drag-active && PlaylistInteraction.playlist-drop-index == PlayerCatalogState.playlist.length && index == PlayerCatalogState.playlist.length - 1 : Rectangle {
        x: 0; y: parent.height - 2px; width: parent.width; height: 2px; background: root.interactive-accent-color;
    }
    accessible-action-default => { root.select-row(entry.token); }
    if row-focus.has-focus : Rectangle { border-width: 1px; border-color: root.interactive-accent-color; border-radius: 3px; background: transparent; }
    if (pane-kind == 4 ? entry.playing : entry.selected) : Rectangle { x: 0; width: 4px; y: 5px; height: parent.height - 10px; background: root.interactive-accent-color; border-radius: 2px; }
    if pane-kind == 4 && entry.detail != "" : VerticalLayout {
        x: 12px; y: 3px; width: parent.width - 18px; height: parent.height - 6px;
        spacing: 0px;
        Text { text: entry.label; color: Theme.sidebar-heading-text(root.dark-theme); font-size: 12px;
            vertical-alignment: center; overflow: elide; }
        Text { text: entry.detail; color: Theme.sidebar-playlist-metadata(root.dark-theme); font-size: 10px;
            vertical-alignment: center; overflow: elide; }
    }
    if pane-kind != 4 || entry.detail == "" : Text { x: 12px;
        width: parent.width - 18px - (entry.language != "" ? 42px : 0px);
        text: entry.label;
        color: entry.token == "no"
            ? Theme.sidebar-no-track-text(root.dark-theme)
            : (Theme.sidebar-heading-text(root.dark-theme));
        font-size: 12px;
        vertical-alignment: center; overflow: elide; }
    if entry.language != "" : Rectangle { width: 38px; height: 16px; x: parent.width - self.width - 3px;
        y: (parent.height - self.height) / 2; border-radius: 3px;
        background: Theme.sidebar-language-badge(root.dark-theme);
        Text { text: entry.language; color: Theme.sidebar-heading-text(root.dark-theme);
            font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
    TouchArea {
        clicked => { row-focus.focus(); if pane-kind < 3 || pane-kind == 6 { root.select-row(entry.token); }
            if pane-kind == 4 { PlaylistInteraction.selected-playlist-token = entry.token; } }
        double-clicked => { if pane-kind >= 3 { root.select-row(entry.token); PlaylistInteraction.selected-playlist-token = ""; PlaylistInteraction.selected-playlist-tokens = []; } }
        pointer-event(event) => {
            if pane-kind == 4 && event.button == PointerEventButton.right
                && event.kind == PointerEventKind.up
                && self.mouse-x >= 0px && self.mouse-x < self.width
                && self.mouse-y >= 0px && self.mouse-y < self.height {
                row-menu.open-at(self.mouse-x, self.mouse-y);
            } else if pane-kind == 4 && event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                PlaylistInteraction.playlist-drag-token = entry.token;
                PlaylistInteraction.playlist-focus-index = index;
                PlaylistInteraction.playlist-drag-start-x = self.mouse-x / 1px;
                PlaylistInteraction.playlist-drag-start-y = self.mouse-y / 1px;
                PlaylistInteraction.playlist-drag-active = false;
                PlaylistInteraction.playlist-drag-extend = event.modifiers.control || event.modifiers.meta;
                PlaylistInteraction.playlist-drag-range = event.modifiers.shift;
                PlaylistInteraction.playlist-drop-index = index;
            } else if pane-kind == 4 && event.button == PointerEventButton.left && event.kind == PointerEventKind.up && PlaylistInteraction.playlist-drag-token == entry.token {
                if PlaylistInteraction.playlist-drag-active {
                    root.reorder-playlist(PlaylistInteraction.selected-playlist-tokens, PlaylistInteraction.playlist-drop-index);
                } else {
                    PlaylistInteraction.selected-playlist-tokens = root.select-playlist-row(index,
                        PlaylistInteraction.playlist-drag-extend, PlaylistInteraction.playlist-drag-range);
                }
                PlaylistInteraction.selected-playlist-token = entry.token;
                PlaylistInteraction.playlist-drag-token = "";
                PlaylistInteraction.playlist-drag-active = false;
                PlaylistInteraction.playlist-drop-index = -1;
            }
        }
        moved => {
            if pane-kind == 4 && self.pressed && PlaylistInteraction.playlist-drag-token == entry.token {
                let distance-x = abs(self.mouse-x / 1px - PlaylistInteraction.playlist-drag-start-x);
                let distance-y = abs(self.mouse-y / 1px - PlaylistInteraction.playlist-drag-start-y);
                if distance-x + distance-y >= 5 {
                    if !entry.selected
                        || PlaylistInteraction.playlist-drag-extend || PlaylistInteraction.playlist-drag-range {
                        PlaylistInteraction.selected-playlist-tokens = root.select-playlist-row(index,
                            PlaylistInteraction.playlist-drag-extend, PlaylistInteraction.playlist-drag-range);
                    }
                    PlaylistInteraction.selected-playlist-token = entry.token;
                    PlaylistInteraction.playlist-drag-active = true;
                    // The layout's 1px gap is included in the displayed row stride.
                    let content-y = (parent.y + self.mouse-y)
                        / (PlayerCatalogState.playlist-metadata-visible ? 39px : 31px);
                    PlaylistInteraction.playlist-drop-index = clamp(floor(content-y), 0, PlayerCatalogState.playlist.length);
                }
            }
        }
    }
    row-menu := PlaylistContextMenu {
        origin: PlaylistMenuOrigin.sidebar;
        token: root.entry.token;
        index: root.index;
        network: root.entry.network;
    }
    row-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if pane-kind == 4 && event.text == Key.F10 && event.modifiers.shift
                && !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
                row-menu.open-at(12px, root.height);
                return accept;
            }
            // Preserve global playback shortcuts while a catalog row has focus.
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return {
                root.select-row(entry.token);
                PlaylistInteraction.selected-playlist-token = "";
                return accept;
            }
            if pane-kind == 4 && (event.text == Key.UpArrow || event.text == Key.DownArrow)
                && PlayerCatalogState.playlist.length > 0 {
                let next-index = event.text == Key.UpArrow
                    ? max(0, index - 1)
                    : min(PlayerCatalogState.playlist.length - 1, index + 1);
                PlaylistInteraction.playlist-focus-index = next-index;
                PlaylistInteraction.selected-playlist-tokens = root.select-playlist-row(next-index,
                    event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                PlaylistInteraction.selected-playlist-token = PlayerCatalogState.playlist[next-index].token;
                return accept;
            }
            return reject;
        }
    }
    changed current-playlist-focus-index => {
        if pane-kind == 4 && current-playlist-focus-index == index { row-focus.focus(); }
    }
}
