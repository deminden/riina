import { ScrollView } from "std-widgets.slint";
import { PlaylistInteraction } from "playlist-interaction.slint";

export struct PlaylistDropViewport {
    x: length,
    y: length,
    width: length,
    height: length,
    content-y: length,
}

// The visible list and its scroll offset move independently of the sidebar frame.
export component PlaylistDropScrollView inherits ScrollView {
    in property <bool> playlist-drop-enabled;
    out property <PlaylistDropViewport> drop-viewport: {
        x: root.absolute-position.x,
        y: root.absolute-position.y,
        width: root.visible-width,
        height: root.visible-height,
        content-y: root.content-y,
    };
    callback playlist-auto-scrolled();

    private property <bool> row-drag: PlaylistInteraction.playlist-drag-active;
    private property <length> drag-x: (root.row-drag ? PlaylistInteraction.playlist-drag-x
        : PlaylistInteraction.external-drop-hover.x * 1px) - root.absolute-position.x;
    private property <length> drag-y: (root.row-drag ? PlaylistInteraction.playlist-drag-y
        : PlaylistInteraction.external-drop-hover.y * 1px) - root.absolute-position.y;
    private property <length> edge-band: min(24px, root.visible-height / 3);
    private property <bool> tracking-drag: root.playlist-drop-enabled
        && (root.row-drag || PlaylistInteraction.external-drop-hover.active)
        && root.drag-x >= 0px && root.drag-x < root.visible-width
        && root.drag-y >= 0px && root.drag-y < root.visible-height;
    private property <length> drag-step: !root.tracking-drag ? 0px
        : root.drag-y < root.edge-band ? 3px + (root.edge-band - root.drag-y) / 2
        : root.drag-y >= root.visible-height - root.edge-band
            ? -3px - (root.drag-y + root.edge-band - root.visible-height) / 2 : 0px;
    private property <length> drag-scroll-y: clamp(root.content-y + root.drag-step,
        min(0px, root.visible-height - root.content-height), 0px);

    Timer {
        interval: 32ms;
        running: root.drag-step != 0px && root.drag-scroll-y != root.content-y;
        triggered => {
            root.playlist-auto-scrolled();
            root.content-y = root.drag-scroll-y;
        }
    }
}
