import { PlayerLayoutState } from "player-layout-state.slint";
import { PlayerAppearance } from "player-appearance.slint";
import { PlayerRenderedVideo } from "player-rendered-video.slint";
import { Theme } from "theme.slint";
import { TopmostPin } from "player-chrome-controls.slint";
import { Tool } from "player-tool.slint";

export component PlayerTitleBar inherits Rectangle {
    in property <bool> native-video;
    in property <length> video-inset-leading;
    in property <length> video-inset-top;
    in property <length> render-width;
    in property <length> render-height;
    in property <bool> engine-ready;
    in property <string> media-title;
    callback hover-changed(bool);
    callback open-file();
    callback window-level-toggle-requested(bool);
    callback toggle-settings-pane(int);
    callback toggle-playlist-pane(int);
    callback toggle-fullscreen();

    background: Theme.title-bar-surface(
        PlayerAppearance.dark-theme, PlayerAppearance.active-liquid-glass-osc, PlayerAppearance.platform-windows, root.native-video);
    if PlayerAppearance.active-liquid-glass-osc : Image {
        source: PlayerRenderedVideo.video-blurred-frame;
        x: root.video-inset-leading - parent.x;
        y: root.video-inset-top - parent.y;
        width: root.render-width;
        height: root.render-height;
        opacity: PlayerAppearance.video-material-sample-opacity(root.native-video);
        image-fit: contain;
    }
    TouchArea {
        width: parent.width; height: parent.height;
        changed has-hover => { root.hover-changed(self.has-hover); }
        HorizontalLayout { width: parent.width; height: parent.height;
            padding-left: 12px; padding-right: 12px;
            Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; icon: @image-url("../../../assets/icons/add.svg"); hint: "Open file"; enabled: root.engine-ready; activated => { root.open-file(); } }
            Text { text: root.media-title; color: Theme.title-bar-text(PlayerAppearance.dark-theme); font-size: 12px;
                horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            if PlayerLayoutState.always-float-on-top || PlayerLayoutState.always-show-on-top-icon : TopmostPin {
                dark-theme: PlayerAppearance.dark-theme;
                pinned: PlayerLayoutState.always-float-on-top;
                changed(value) => {
                    root.window-level-toggle-requested(value);
                }
            }
            Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; icon: @image-url("../../../assets/icons/video.svg"); hint: "Video settings"; activated => { root.toggle-settings-pane(6); } }
            Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; icon: @image-url("../../../assets/icons/audio.svg"); hint: "Audio tracks"; activated => { root.toggle-settings-pane(1); } }
            Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; label: "CC"; hint: "Subtitle tracks"; activated => { root.toggle-settings-pane(2); } }
            Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; icon: @image-url("../../../assets/icons/chapters.svg"); hint: "Chapters"; activated => { root.toggle-playlist-pane(3); } }
            Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; icon: @image-url("../../../assets/icons/playlist.svg"); hint: "Playlist"; activated => { root.toggle-playlist-pane(4); } }
            Tool { accent-color: PlayerAppearance.interactive-accent-color; dark-theme: PlayerAppearance.dark-theme; icon: @image-url("../../../assets/icons/fullscreen.svg"); hint: "Fullscreen"; activated => { root.toggle-fullscreen(); } }
        }
    }
}
