import { PlayerControlActions, PlayerPluginPointerPhase } from "player-control-actions.slint";
import { PlayerControlsState } from "player-controls-state.slint";
import { PlayerPreferences } from "player-preferences.slint";
import { PlayerMusicModeState } from "player-music-mode-state.slint";
import { PlayerSidebarState } from "player-sidebar-state.slint";

export component PlayerVideoInput inherits TouchArea {
    callback restore-player-focus();
    private property <bool> clicked-on-release;
    private property <bool> double-clicked-on-release;

    moved => { PlayerControlsState.controls-visible = true; PlayerControlActions.activity(); }
    // TouchArea reports click recognition before the corresponding pointer-up.
    clicked => { clicked-on-release = true; }
    double-clicked => { double-clicked-on-release = true; }

    function perform-left-click(single: bool, double: bool) {
        if !single { return; }
        PlayerControlActions.activity();
        PlayerControlActions.single-click-action(PlayerPreferences.control-single-click-index);
        if PlayerSidebarState.sidebar != 0 || PlayerSidebarState.leading-sidebar != 0 {
            root.restore-player-focus(); PlayerSidebarState.sidebar = 0; PlayerSidebarState.leading-sidebar = 0;
        }
        if double { PlayerControlActions.double-click-action(PlayerPreferences.control-double-click-index); }
    }

    pointer-event(event) => {
        let phase = event.kind == PointerEventKind.up ? PlayerPluginPointerPhase.up
            : event.kind == PointerEventKind.down ? PlayerPluginPointerPhase.down
            : event.kind == PointerEventKind.cancel ? PlayerPluginPointerPhase.cancel
            : PlayerPluginPointerPhase.move;
        let code = event.button == PointerEventButton.left ? "*mouse"
            : event.button == PointerEventButton.right ? "*rightMouse" : "*otherMouse";
        let clicks = double-clicked-on-release ? 2 : clicked-on-release ? 1 : 0;
        let button = event.button == PointerEventButton.left ? 1
            : event.button == PointerEventButton.right ? 3 : event.button == PointerEventButton.middle ? 2 : 0;
        let handled = event.touch-finger-id == 0 && (
            PlayerControlActions.plugin-overlay-pointer(phase, button, self.mouse-x / 1px, self.mouse-y / 1px)
            || PlayerControlActions.plugin-pointer(phase, code, self.mouse-x / 1px, (self.height - self.mouse-y) / 1px, clicks)
        );
        if event.kind == PointerEventKind.up {
            clicked-on-release = false;
            double-clicked-on-release = false;
            if !handled {
                if event.button == PointerEventButton.left {
                    root.perform-left-click(clicks > 0, clicks > 1);
                } else if event.button == PointerEventButton.right {
                    PlayerControlActions.activity(); PlayerControlActions.mouse-button-action(PlayerPreferences.control-right-click-index);
                } else if event.button == PointerEventButton.middle {
                    PlayerControlActions.activity(); PlayerControlActions.mouse-button-action(PlayerPreferences.control-middle-click-index);
                }
            }
        }
    }
    scroll-event(event) => {
        if PlayerMusicModeState.music-mode &&
            self.mouse-y >= self.height - PlayerMusicModeState.displayed-catalog-height {
            return accept;
        }
        if PlayerControlActions.scroll-action-request(event.delta-x / 1px, event.delta-y / 1px) {
            return accept;
        }
        return reject;
    }
}
