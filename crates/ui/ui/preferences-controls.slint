export component PreferenceOptionCard inherits FocusScope {
    in property <string> title;
    in property <string> description;
    in property <bool> selected: false;
    callback activated();
    height: 54px;
    accessible-role: radio-button;
    accessible-label: title + ". " + description;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? #168bff : #d6d6da;
        border-radius: 6px;
        background: root.selected ? #f5f9ff : #f3f3f5;
    }
    Text { x: 12px; y: 6px; width: parent.width - 24px; height: 16px;
        text: root.title; font-size: 11px; color: #252529; }
    Text { x: 12px; y: 22px; width: parent.width - 24px; height: 26px;
        text: root.description; font-size: 9px; color: #707076;
        vertical-alignment: top; wrap: word-wrap; }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

export component PreferenceSensitivityRow inherits Rectangle {
    in property <string> label;
    in-out property <int> value: 3;
    callback changed();
    height: 38px;
    Text { x: 36px; y: 0; width: 158px; height: parent.height;
        text: root.label; font-size: 12px; color: #252529;
        vertical-alignment: center; overflow: elide; }
    PlayerSlider { x: 190px; y: 9px; width: 124px; height: 20px;
        minimum: 1; maximum: 4; value: root.value;
        hint: root.label;
        changed(value) => { root.value = round(value); root.changed(); }
    }
}

export component PreferenceDisclosure inherits FocusScope {
    in property <string> label;
    in property <bool> expanded: false;
    callback toggled();
    width: 480px;
    height: 21px;
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: expanded;
    accessible-action-default => { root.toggled(); }
    Text { x: 0; y: 0; width: 13px; height: parent.height;
        text: root.expanded ? "▾" : "▸";
        font-size: 11px; color: #44444a; vertical-alignment: center;
    }
    Text { x: 15px; y: 0; width: parent.width - 15px; height: parent.height;
        text: root.label; font-size: 13px; color: #222222;
        vertical-alignment: center;
    }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #168bff;
        border-radius: 3px; background: transparent;
    }
    touch := TouchArea { clicked => { focus.focus(); root.toggled(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
            if event.text == Key.Return || event.text == " " {
                root.toggled(); return accept;
            }
            return reject;
        }
    }
}

