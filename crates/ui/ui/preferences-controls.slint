import { Theme } from "theme.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";
import { PlayerSlider } from "shared-controls.slint";

export global MotionSettings {
    in-out property <bool> animations-disabled: false;
}

export struct AdvancedMpvOptionRow {
    name: string,
    value: string,
}

export component FolderChooser inherits FocusScope {
    callback activated();
    accessible-role: button;
    accessible-label: "Choose screenshot save path";
    accessible-action-default => { if root.enabled { root.activated(); } }
    key-pressed(event) => {
        if root.enabled && (event.text == Key.Return || event.text == " ") {
            root.activated(); return accept;
        }
        return reject;
    }
    Rectangle { width: parent.width; height: parent.height;
        border-radius: 4px;
        background: root.enabled ? (touch.pressed ? #dddddd : #fafafa) : #eeeeee;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? #168bff : #b8b8b8;
        Text { text: "…"; font-size: 13px; color: root.enabled ? #222222 : #999999;
            horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea { enabled: root.enabled;
            clicked => { root.focus(); root.activated(); } }
    }
}

export component PreferenceSwitch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <bool> show-label: true;
    callback toggled();
    height: 28px;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    if root.show-label : Text { x: 0; y: 0; width: parent.width - 52px; height: parent.height;
        text: root.label; font-size: 12px; color: root.enabled ? #252529 : #98989e;
        vertical-alignment: center; overflow: elide; }
    Rectangle { x: parent.width - 40px; y: 5px; width: 36px; height: 18px;
        border-radius: 9px; background: root.checked ? #198cff : #d6d6da;
        animate background { duration: MotionSettings.animations-disabled ? 0ms : 120ms; }
        opacity: root.enabled ? 1 : 0.55;
        Rectangle { x: root.checked ? parent.width - 16px : 2px; y: 2px;
            width: 14px; height: 14px; border-radius: 7px; background: #ffffff;
            animate x { duration: MotionSettings.animations-disabled ? 0ms : 120ms; }
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.checked = !root.checked; root.toggled(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == " ") {
                root.checked = !root.checked; root.toggled(); return accept;
            }
            return reject;
        }
    }
}

export component OverrideLaneButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback activated();
    width: 150px;
    height: 21px;
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { root.activated(); }
    Rectangle {
        border-radius: 4px;
        background: root.selected ? #d0d0d5 : touch.has-hover ? #ffffffb8 : transparent;
        border-width: focus.has-focus ? 1px : 0px;
        border-color: #168bff;
        Text { text: root.label; font-size: 11px; color: #242428;
            horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

export component PreferenceActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback activated();
    width: 78px;
    height: 24px;
    border-radius: 4px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? #168bff : #b8b8b8;
    background: !root.enabled ? #f1f1f2 : touch.pressed ? #d9d9dd : #f7f7f8;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
    Text { text: root.label; font-size: 11px; color: root.enabled ? #222222 : #99999e;
        horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

component ToolbarOrderButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback activated();
    width: 26px; height: 22px;
    border-radius: 4px;
    border-width: 1px;
    border-color: focus.has-focus ? #168bff : #b8b8b8;
    background: !root.enabled ? #f1f1f2 : touch.pressed ? #d9d9dd : #f7f7f8;
    accessible-role: button;
    accessible-label: root.label == "↑" ? "Move toolbar action up" : "Move toolbar action down";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Text { text: root.label; font-size: 12px; color: root.enabled ? #333337 : #a0a0a4;
        horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { if root.enabled { root.activated(); } return accept; }
            return reject;
        }
    }
}

export component ToolbarPreferenceRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;
    in property <int> position;
    in property <int> count;
    in property <int> drag-index: -1;
    in property <int> drop-index: -1;
    in property <length> drag-start-y: 0px;
    in property <bool> drag-active: false;
    callback toggled(bool);
    callback move-requested(int, int);
    callback drag-started(int, length);
    callback drag-target-changed(int);
    callback drag-finished();
    height: 28px; spacing: 4px;
    PreferenceSwitch {
        width: 208px; label: root.label;
        checked <=> root.checked;
        toggled => { root.toggled(self.checked); }
    }
    Rectangle {
        width: 20px; height: 22px; border-radius: 4px;
        background: drag-handle.pressed ? #d9d9dd : #f7f7f8;
        accessible-role: button;
        accessible-label: "Drag to reorder " + root.label;
        Text { text: "⠿"; font-size: 15px; color: #68686e;
            horizontal-alignment: center; vertical-alignment: center; }
        drag-handle := TouchArea {
            mouse-cursor: root.drag-active ? move : grab;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.drag-started(root.position, self.mouse-y);
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up &&
                    root.drag-active && root.drag-index == root.position {
                    root.drag-finished();
                }
            }
            moved => {
                if self.pressed && root.drag-index == root.position {
                    let delta = self.mouse-y - root.drag-start-y;
                    let steps = floor(abs(delta) / 28px);
                    if abs(delta) >= 6px {
                        let target = clamp(root.drag-index + (delta < 0px ? -steps : steps), 0, root.count - 1);
                        root.drag-target-changed(target);
                    }
                }
            }
        }
    }
    Rectangle { horizontal-stretch: 1; background: transparent; }
    if root.drag-active && root.drop-index == root.position : Rectangle {
        width: 2px; height: 20px; border-radius: 1px; background: #168bff;
    }
    ToolbarOrderButton { label: "↑"; enabled: root.position > 0;
        activated => { root.move-requested(root.position, root.position - 1); } }
    ToolbarOrderButton { label: "↓"; enabled: root.position + 1 < root.count;
        activated => { root.move-requested(root.position, root.position + 1); } }
}

// AppKit draws number formatters as bounded editable cells; give shared values
// the same visible affordance even when the Windows widget theme omits a bezel.

export component PreferenceNumericInput inherits Rectangle {
    in-out property <string> text: "";
    in property <length> font-size: 11px;
    in property <bool> enabled: true;
    in property <string> label: "";
    callback accepted();
    clip: true;
    border-radius: 2px;
    border-width: 1px;
    border-color: root.enabled ? Theme.settings-field-border : #d7d7da;
    background: root.enabled ? #ffffff : #eeeeef;
    TextInput {
        x: 3px; y: 1px; width: parent.width - 6px; height: parent.height - 2px;
        text <=> root.text;
        accessible-label: root.label;
        single-line: true;
        font-size: root.font-size;
        color: root.enabled ? #222222 : #8d8d92;
        enabled: root.enabled;
        accepted => { root.accepted(); }
    }
}

export component LanguageTokenEditor inherits Rectangle {
    in property <[string]> tokens;
    in-out property <string> draft: "";
    callback add-token(string);
    callback remove-token(int);
    border-radius: 2px;
    border-width: 1px;
    border-color: Theme.settings-field-border;
    background: #ffffff;

    ScrollView {
        x: 2px; y: 1px; width: parent.width - 4px; height: parent.height - 2px;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        HorizontalLayout {
            width: root.tokens.length * 48px + 70px;
            height: parent.height;
            spacing: 3px;
            for token[index] in root.tokens : Rectangle {
                width: 45px; height: 18px;
                border-radius: 9px; background: #e9e9ec;
                accessible-role: list-item;
                accessible-label: token;
                Text { x: 5px; y: 0px; width: 26px; height: parent.height;
                    text: token; font-size: 10px; color: #303036;
                    vertical-alignment: center; overflow: elide; }
                Rectangle { x: 30px; y: 2px; width: 13px; height: 14px;
                    border-radius: 7px; background: transparent;
                    Text { x: 0px; y: 0px; width: parent.width; height: parent.height;
                        text: "×"; font-size: 11px; color: #66666d;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        accessible-role: button;
                        accessible-label: "Remove preferred language " + token;
                        clicked => { root.remove-token(index); }
                    }
                }
            }
            TextInput {
                width: 64px; height: parent.height;
                text <=> root.draft;
                font-size: 10px; color: #222222;
                accepted => {
                    if root.draft != "" {
                        root.add-token(root.draft);
                        root.draft = "";
                    }
                }
            }
        }
    }
}

export component PreferenceChoiceRow inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in-out property <int> selected-index: 0;
    callback selected();
    height: 40px;
    Text { x: 36px; y: 0; width: 158px; height: parent.height;
        text: root.label; font-size: 12px; color: #252529;
        vertical-alignment: center; overflow: elide; }
    ComboBox { x: 180px; y: 7px; width: max(100px, parent.width - 192px); height: 25px;
        model: root.options;
        current-index <=> root.selected-index;
        selected => { root.selected(); }
    }
}

export component PreferenceRadioRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    callback activated();
    height: 22px;
    accessible-role: radio-button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { root.activated(); }
    Rectangle { x: 1px; y: 5px; width: 12px; height: 12px;
        border-radius: 6px; border-width: 1px;
        border-color: root.checked ? #168bff : #77777d; background: #ffffff;
        if root.checked : Rectangle { x: 3px; y: 3px; width: 6px; height: 6px;
            border-radius: 3px; background: #168bff; }
    }
    Text { x: 20px; y: 0; width: parent.width - 20px; height: parent.height;
        text: root.label; font-size: 11px; color: #252529;
        vertical-alignment: center; overflow: elide; }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

export component PreferenceToggle inherits FocusScope {
    in property <string> label;
    in-out property <bool> checked: false;
    callback toggled();
    height: 32px;
    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { if root.enabled { root.checked = !root.checked; root.toggled(); } }
    Text { x: 8px; y: 0; width: parent.width - 60px; height: parent.height;
        text: root.label; font-size: 12px; color: root.enabled ? #252529 : #89898f;
        vertical-alignment: center; overflow: elide; }
    Rectangle { x: parent.width - 46px; y: 8px; width: 36px; height: 18px;
        border-radius: 9px; background: !root.enabled ? #e6e6e8 : root.checked ? #168bff : #d2d2d7;
        Rectangle { x: root.checked ? 19px : 2px; y: 2px; width: 14px; height: 14px;
            border-radius: 7px; background: #ffffff; }
    }
    if root.has-focus : Rectangle { width: parent.width; height: parent.height;
        border-width: 1px; border-color: #168bff; border-radius: 4px;
        background: transparent;
    }
    touch := TouchArea { enabled: root.enabled;
        clicked => { focus.focus(); root.checked = !root.checked; root.toggled(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height; enabled: root.enabled;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == " ") {
                root.checked = !root.checked; root.toggled(); return accept;
            }
            return reject;
        }
    }
}

