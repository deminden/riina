        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.toggled(); return accept;
            }
            return reject;
        }
    }
}

// The trailing action keeps a fixed hit target when a descriptive label wraps.

export component UtilitiesActionRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> description: "";
    in property <string> trailing: "→";
    in property <string> metric: "";
    in property <bool> trash: false;
    in property <bool> action-enabled: true;
    callback activated();
    height: description.is-empty ? 48px : 70px;
    background: transparent;
    accessible-role: list-item;
    accessible-label: root.title + (root.description.is-empty ? "" : ", " + root.description);
    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.settings-card-border; }
    Image { x: 12px; y: (parent.height - 18px) / 2; width: 18px; height: 18px;
        source: root.icon; colorize: Theme.settings-utility-icon; image-fit: contain; }
    Text { x: 36px; y: root.description.is-empty ? (parent.height - 20px) / 2 : 8px;
        width: parent.width - 108px; height: 20px; text: root.title;
        font-size: 12px; color: root.action-enabled ? Theme.settings-card-title : Theme.settings-disabled-description;
        vertical-alignment: center; overflow: elide; }
    if !root.description.is-empty : Text {
        x: 36px; y: 28px; width: parent.width - 116px; height: parent.height - 32px;
        text: root.description; font-size: 10px; color: Theme.settings-card-description;
        vertical-alignment: top; wrap: word-wrap; overflow: elide;
    }
    action-button := FocusScope {
        x: parent.width - 50px; y: 0; width: 40px; height: parent.height;
        enabled: root.action-enabled;
        accessible-role: button; accessible-label: root.title;
        accessible-action-default => { if root.action-enabled { root.activated(); } }
        Rectangle { x: 0px; y: (parent.height - 26px) / 2;
            width: 40px; height: 26px; border-radius: 7px;
            background: (touch.has-hover || action-button.has-focus) && root.action-enabled ? Theme.settings-utility-hover : Theme.settings-utility-action-surface; }
        Text { x: -58px; y: 0; width: 56px; height: parent.height;
            text: root.metric; font-size: 10px; color: Theme.settings-utility-metric;
            horizontal-alignment: right; vertical-alignment: center; }
        if root.trash : Rectangle { x: 15px; y: (parent.height - 12px) / 2;
            width: 8px; height: 10px; border-width: 1px; border-color: root.action-enabled ? Theme.settings-section-heading : Theme.settings-utility-disabled-glyph;
            border-radius: 1px; background: transparent; }
        if root.trash : Rectangle { x: 13px; y: (parent.height - 16px) / 2;
            width: 12px; height: 2px; background: root.action-enabled ? Theme.settings-section-heading : Theme.settings-utility-disabled-glyph; }
        if root.trash : Rectangle { x: 17px; y: (parent.height - 19px) / 2;
            width: 4px; height: 1px; background: root.action-enabled ? Theme.settings-section-heading : Theme.settings-utility-disabled-glyph; }
        if !root.trash : Text { x: 0px; y: (parent.height - 26px) / 2;
            width: 40px; height: 26px; text: root.trailing; font-size: 14px;
            color: root.action-enabled ? Theme.settings-utility-action-glyph : Theme.settings-utility-disabled-glyph;
            horizontal-alignment: center; vertical-alignment: center; }
        if self.has-focus : Rectangle { x: -2px; y: (parent.height - 30px) / 2;
            width: 44px; height: 30px; border-width: 1px; border-color: Theme.settings-accent;
            border-radius: 8px; background: transparent; }
        touch := TouchArea {
            enabled: root.action-enabled;
            clicked => { action-button.focus(); root.activated(); }
        }
        key-pressed(event) => {
            if root.action-enabled && (event.text == Key.Return || event.text == " ") {
                root.activated(); return accept;
            }
            return reject;
        }
    }
}
