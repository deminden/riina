import { PlayerCatalogState } from "player-catalog-state.slint";
import { PlaylistInteraction, PlaylistMenuOrigin } from "playlist-interaction.slint";
import { PlaylistInsertionIndicator } from "playlist-row-input.slint";

export component PlaylistContextMenu inherits Rectangle {
    in property <PlaylistMenuOrigin> origin;
    in property <string> token;
    x: 0px; y: 0px; width: 0px; height: 0px;

    public function open-at(x: length, y: length) {
        PlaylistInteraction.request-playlist-menu(root.origin, root.token,
            (root.absolute-position.x + x) / 1px, (root.absolute-position.y + y) / 1px);
    }
}

export component PlaylistBlankMenuArea inherits Rectangle {
    in property <PlaylistMenuOrigin> origin;
    in property <color> accent;

    if PlayerCatalogState.playlist.length == 0 : PlaylistInsertionIndicator {
        width: parent.width;
        height: 2px;
        index: 0;
        accent: root.accent;
    }

    blank-menu := PlaylistContextMenu { origin: root.origin; }
    TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up
                && self.mouse-x >= 0px && self.mouse-x < self.width
                && self.mouse-y >= 0px && self.mouse-y < self.height {
                blank-menu.open-at(self.mouse-x, self.mouse-y);
            }
        }
    }
}
