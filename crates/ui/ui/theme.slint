// Each caller supplies its own theme because player windows can differ.
export global Theme {
    out property <color> settings-field-border: #b8b8bc;

    out property <color> settings-card-border: #dedee1;
    out property <color> settings-page-heading: #222222;
    out property <color> settings-section-heading: #77777d;
    out property <color> settings-card-title: #29292d;
    out property <color> settings-card-description: #74747a;
    out property <color> settings-disabled-description: #8a8a90;
    out property <color> settings-status-text: #69696f;

    public pure function settings-content-surface(material: bool) -> color {
        return material ? #ffffff80 : #ffffff;
    }

    public pure function settings-card-surface(material: bool) -> color {
        return material ? #ffffff80 : #f8f8f8;
    }

    public pure function sidebar-card-border(dark: bool) -> color {
        return dark ? #ffffff18 : #00000014;
    }

    public pure function sidebar-section-divider(dark: bool) -> color {
        return dark ? #ffffff28 : #00000020;
    }

    public pure function sidebar-section-caption(dark: bool) -> color {
        return dark ? #bdbdc5 : #707078;
    }

    out property <duration> osd-fade-time: 500ms;
    out property <length> playback-osd-left: 8px;
    out property <length> playback-osd-top: 49px;
    out property <length> playback-osd-corner: 14px;
    out property <color> seek-osd-duration-text: #b0b0b0;
    out property <color> plugin-osd-border: #ffffff24;
    out property <color> fullscreen-info-border: #ffffff22;
    out property <color> fullscreen-info-symbol: #d0d0d4;

    public pure function playback-osd-surface(material: bool, native-tint: bool) -> color {
        return material ? (native-tint ? #181818c4 : #181818dc) : #181818;
    }

    public pure function plugin-osd-surface(native-video: bool, material: bool) -> color {
        return native-video ? (material ? #17171bc8 : #17171b) : #17171be8;
    }

    public pure function fullscreen-info-surface(material: bool, native-tint: bool) -> color {
        return material ? (native-tint ? #1b1b20c8 : #1b1b20d8) : #1b1b20;
    }

    out property <color> controller-border: #ffffff25;
    out property <color> music-mode-volume-border: #ffffff30;
    out property <duration> controller-reposition-duration: 240ms;
    out property <duration> controller-visibility-duration: 250ms;
    out property <duration> controller-content-fade-duration: 200ms;
    out property <length> controller-toolbar-button-size: 24px;

    public pure function controller-surface(dark: bool, material: bool, windows: bool, native-video: bool) -> color {
        return material
            ? (dark
                ? (windows ? #15151528 : native-video ? #15151599 : #202025e8)
                : (windows || native-video ? #f2f2f2c8 : #f2f2f2ed))
            : (dark ? #202025 : #f2f2f2);
    }

    public pure function controller-time-text(dark: bool) -> color {
        return dark ? #d4d4d4 : #29292d;
    }

    public pure function music-mode-title-text(dark: bool) -> color {
        return dark ? #ffffff : #202024;
    }

    public pure function music-mode-metadata-text(dark: bool) -> color {
        return dark ? #d0d0d4 : #505056;
    }

    public pure function music-mode-volume-surface(dark: bool, material: bool) -> color {
        return material ? (dark ? #25252beF : #f5f5f7f0) : (dark ? #303036 : #eeeeF2);
    }

    out property <color> player-empty-surface: #111111;
    out property <color> windows-default-accent: #0078d4;
    out property <color> windows-default-accent-text: #ffffff;
    out property <color> player-focus-accent: #90b7ef;
    out property <color> playback-progress-accent: #168bff;
    out property <color> subtitle-text-default: #ffffff;
    out property <color> subtitle-background-default: #00000000;
    out property <color> subtitle-outline-default: #000000;
    out property <color> subtitle-shadow-default: #00000000;

    public pure function player-status-text(dark: bool) -> color {
        return dark ? #bbbbbb : #55555b;
    }

    public pure function sidebar-card-layer(dark: bool, windows-material: bool) -> color {
        return windows-material ? (dark ? #ffffff09 : #ffffff40) : (dark ? #ffffff08 : #ffffff88);
    }

    public pure function sidebar-control-layer(dark: bool, windows-material: bool) -> color {
        return windows-material ? (dark ? #ffffff0f : #f9f9f94d) : (dark ? #ffffff15 : #0000000b);
    }

    public pure function sidebar-category-selection(dark: bool) -> color {
        return dark ? #ffffff1f : #00000014;
    }

    public pure function sidebar-category-text(dark: bool) -> color {
        return dark ? #ffffff : #29292d;
    }

    public pure function sidebar-heading-text(dark: bool) -> color {
        return dark ? #dddddd : #29292d;
    }

    public pure function sidebar-empty-caption(dark: bool) -> color {
        return dark ? #aaaaaa : #66666b;
    }

    out property <color> sidebar-light-tint: #f2f2f2c8;
    out property <color> sidebar-catalog-accent: #0a84ff;
    out property <color> sidebar-catalog-accent-text: #ffffff;

    public pure function title-bar-text(dark: bool) -> color {
        return dark ? #dddddd : #29292d;
    }

    public pure function title-bar-surface(dark: bool, material: bool, windows: bool, native-video: bool) -> color {
        return material
            // Use REF-20's measured controller luminance for the sampled-video title surface.
            ? (dark ? (windows ? #15151528 : native-video ? #15151599 : #151515b0)
                    : (windows || native-video ? #f2f2f2c8 : #f2f2f2ed))
            : (dark ? #151519 : #f2f2f2);
    }

    public pure function sidebar-material-border(dark: bool) -> color {
        return dark ? #ffffff20 : #00000020;
    }

    public pure function sidebar-frame-surface(
        dark: bool, material: bool, macos: bool, windows: bool, native-video: bool, sample-ready: bool
    ) -> color {
        return material
            ? (windows && !sample-ready
                ? (dark ? #151519 : #f2f2f2)
                // REF-24 keeps about 53% of flat-video linear luminance. The Windows
                // sidebar measured 54.2% at 28% tint and 49.1% at 32%, giving 29%.
                : dark
                    ? (macos ? #1515156b : windows ? #1515154a : native-video ? #15151599 : #151515b0)
                    : (windows || native-video ? #f2f2f2c8 : #f2f2f2ed))
            : (dark ? #151519 : #f2f2f2);
    }
}
