    public pure function welcome-button-surface(enabled: bool, hovered: bool) -> color {
        return !enabled ? #ffffff08 : hovered ? #ffffff24 : #ffffff18;
    }

    public pure function welcome-button-text(enabled: bool) -> color {
        return enabled ? #f1f1f4 : #77777f;
    }

    public pure function welcome-history-surface(hovered: bool, selected: bool, prominent: bool) -> color {
        return hovered ? #ffffff14 : selected ? #ffffff18 : prominent ? #ffffff0c : transparent;
    }

    public pure function welcome-resume-surface(selected: bool, hovered: bool) -> color {
        return selected ? #ffffff28 : hovered ? #ffffff10 : #ffffff0c;
    }

    // WinUI's dark LayerFillColorDefault (#4C3A3A3A in ARGB) lets
    // the system Mica show through while preserving a dark Welcome.
    public pure function welcome-window-surface(mica: bool) -> color {
        return mica ? #3a3a3a4c : #17171b;
    }

    public pure function welcome-url-border(focused: bool) -> color {
        return focused ? #6195d8 : #ffffff24;
    }

