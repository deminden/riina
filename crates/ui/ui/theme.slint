    public pure function sidebar-toggle-track(dark: bool) -> color {
        return dark ? #55555e : #d0d0d4;
    }

    public pure function sidebar-layout-stepper-surface(dark: bool) -> color {
        return dark ? #ffffff16 : #0000000d;
    }

