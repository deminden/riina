    }

    public pure function sidebar-action-button-surface(dark: bool, material: bool, hovered: bool) -> color {
        return material ? (dark ? (hovered ? #ffffff15 : #ffffff0f) : (hovered ? #f9f9f980 : #f9f9f94d)) : (hovered ? #ffffff18 : #ffffff0a);
    }

    public pure function sidebar-inline-button-surface(dark: bool) -> color {
        return dark ? #ffffff10 : #0000000a;
    }

