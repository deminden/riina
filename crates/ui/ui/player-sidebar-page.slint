import { PlayerSidebarState } from "player-sidebar-state.slint";
import { PlayerCatalogState } from "player-catalog-state.slint";
import { PlaybackTimelineState } from "playback-timeline-state.slint";
import { PlayerAppearance } from "player-appearance.slint";
import { AudioQuickSettingsPage } from "quick-settings-audio.slint";
import { SubtitleQuickSettingsPage } from "quick-settings-subtitles.slint";
import { VideoQuickSettingsPage } from "quick-settings-video.slint";
import { PlayerMenuActions } from "player-menu-actions.slint";
import { Theme } from "theme.slint";
import { CatalogRow, CatalogSelection } from "catalog-row.slint";
import { DelayLane } from "delay-lane.slint";
import { PlayerPreferences } from "player-preferences.slint";
import { CatalogSidebarRow } from "playlist-sidebar-row.slint";
import { PlayerSidebarActions } from "player-sidebar-actions.slint";

export component PlayerSidebarPage inherits VerticalLayout {
    in property <int> pane-kind;
    in property <bool> quick-settings-pane;
    in property <length> sidebar-width;
    in property <bool> loaded;
    callback restore-player-focus();

    pure function selection-for-pane(kind: int) -> CatalogSelection {
        return kind == 1 ? CatalogSelection.audio-track :
            kind == 2 ? CatalogSelection.primary-subtitle :
            kind == 3 ? CatalogSelection.chapter :
            kind == 4 ? CatalogSelection.playlist :
            kind == 5 ? CatalogSelection.secondary-subtitle :
            kind == 6 ? CatalogSelection.video-track : CatalogSelection.unknown;
    }

    alignment: start; spacing: 1px;
    cross-axis-alignment: quick-settings-pane ? center : start;
    if pane-kind == 1 : AudioQuickSettingsPage {
        card-width: root.sidebar-width - (PlayerAppearance.compact-ui ? 28px : 32px);
        compact-ui: PlayerAppearance.compact-ui;
        dark-theme: PlayerAppearance.dark-theme;
        delete-audio-equalizer-profile => { PlayerSidebarActions.delete-audio-equalizer-profile(); }
        interactive-accent-color: PlayerAppearance.interactive-accent-color;
        load-external-audio => { PlayerMenuActions.browse-files(1); }
        loaded: root.loaded;
        platform-windows: PlayerAppearance.platform-windows;
        preview-audio-delay(value-1) => { PlayerSidebarActions.preview-audio-delay(value-1); }
        rename-audio-equalizer-profile(value-1) => { return PlayerSidebarActions.rename-audio-equalizer-profile(value-1); }
        reset-audio-delay => { PlayerMenuActions.reset-audio-delay(); }
        restore-player-focus => { root.restore-player-focus(); }
        save-audio-equalizer-profile(value-1) => { return PlayerSidebarActions.save-audio-equalizer-profile(value-1); }
        select-audio-equalizer-profile(value-1) => { PlayerSidebarActions.select-audio-equalizer-profile(value-1); }
        set-audio-equalizer(value-1, value-2) => { PlayerSidebarActions.set-audio-equalizer(value-1, value-2); }
        set-delay(value-1) => { PlayerSidebarActions.set-delay(DelayLane.audio, value-1); }
        set-delay-text(value-1) => { return PlayerSidebarActions.set-delay-text(DelayLane.audio, value-1); }
        set-volume-boost(value-1) => { PlayerSidebarActions.set-volume-boost(value-1); }
        sidebar-card-material-fill: PlayerAppearance.sidebar-card-material-fill;
        sidebar-control-material-fill: PlayerAppearance.sidebar-control-material-fill;
        track-selected(value-1, value-2) => { PlayerMenuActions.select-item(root.selection-for-pane(value-1), value-2); }
        validate-audio-equalizer-profile-name(value-1, value-2) => { return PlayerSidebarActions.validate-audio-equalizer-profile-name(value-1, value-2); }
        volume-boost: PlayerPreferences.volume-boost;
        windows-accent-color: PlayerAppearance.windows-accent-color;
        windows-sidebar-material-active: PlayerAppearance.windows-sidebar-material-active;
    }
    if pane-kind == 7 && PlayerSidebarState.plugin-sidebar-selected-identifier == "" : VerticalLayout {
        spacing: 6px;
        Text { text: "Plugins can provide content in this panel.";
            color: Theme.sidebar-heading-text(PlayerAppearance.dark-theme);
            font-size: 12px; wrap: word-wrap; }
        if PlayerSidebarState.plugin-sidebar-labels.length == 0 : Text {
            text: "Enabled plugins with sidebar tabs appear here.";
            color: Theme.sidebar-secondary-text(PlayerAppearance.dark-theme);
            font-size: 11px; wrap: word-wrap; }
    }
    for row[index] in (pane-kind == 3 ? PlayerCatalogState.chapters : pane-kind == 4 ? PlayerCatalogState.playlist : []): CatalogSidebarRow {
        width: parent.width;
        entry: row;
        index: index;
        pane-kind: root.pane-kind;
        dark-theme: PlayerAppearance.dark-theme;
        interactive-accent-color: PlayerAppearance.interactive-accent-color;
        select-row(token) => { PlayerMenuActions.select-item(root.selection-for-pane(pane-kind), token); }
    }
    if pane-kind == 6 : VideoQuickSettingsPage {
        sidebar-width: root.sidebar-width;
        animations-disabled: PlayerAppearance.animations-disabled;
        compact-ui: PlayerAppearance.compact-ui;
        dark-theme: PlayerAppearance.dark-theme;
        interactive-accent-color: PlayerAppearance.interactive-accent-color;
        loaded: root.loaded;
        platform-windows: PlayerAppearance.platform-windows;
        reset-speed => { PlayerMenuActions.reset-speed(); }
        restore-player-focus => { root.restore-player-focus(); }
        set-hardware-decoding(value) => { PlayerSidebarActions.set-hardware-decoding(value); }
        set-hdr-enabled(value) => { PlayerSidebarActions.set-hdr-enabled(value); }
        set-speed-slider(value) => { PlayerSidebarActions.set-speed-slider(value); }
        set-speed-text(text) => { return PlayerSidebarActions.set-speed-text(text); }
        set-video-aspect(text) => { PlayerSidebarActions.set-video-aspect(text); }
        set-video-crop(value) => { PlayerSidebarActions.set-video-crop(value); }
        set-video-equalizer(band, value) => { PlayerSidebarActions.set-video-equalizer(band, value); }
        set-video-rotation(value) => { PlayerSidebarActions.set-video-rotation(value); }
        sidebar-card-material-fill: PlayerAppearance.sidebar-card-material-fill;
        speed-edit-value: PlaybackTimelineState.speed-edit-value;
        speed-slider-position: PlaybackTimelineState.speed-slider-position;
        speed-value: PlaybackTimelineState.speed-value;
        track-selected(kind, token) => { PlayerMenuActions.select-item(root.selection-for-pane(kind), token); }
        windows-accent-color: PlayerAppearance.windows-accent-color;
        windows-accent-foreground: PlayerAppearance.windows-accent-foreground;
        windows-sidebar-material-active: PlayerAppearance.windows-sidebar-material-active;
    }
    if pane-kind == 2 : SubtitleQuickSettingsPage {
        sidebar-width: root.sidebar-width;
        choose-subtitle-font => { PlayerMenuActions.choose-subtitle-font(); }
        compact-ui: PlayerAppearance.compact-ui;
        dark-theme: PlayerAppearance.dark-theme;
        find-online-subtitles => { PlayerMenuActions.find-online-subtitles(); }
        interactive-accent-color: PlayerAppearance.interactive-accent-color;
        load-subtitle => { PlayerMenuActions.browse-files(2); }
        loaded: root.loaded;
        platform-windows: PlayerAppearance.platform-windows;
        reset-subtitle-delay => { PlayerMenuActions.reset-subtitle-delay(); }
        restore-player-focus => { root.restore-player-focus(); }
        set-delay(lane, seconds) => { PlayerSidebarActions.set-delay(lane, seconds); }
        set-delay-text(lane, text) => { return PlayerSidebarActions.set-delay-text(lane, text); }
        set-subtitle-color(component, color) => { PlayerSidebarActions.set-subtitle-color(component, color); }
        set-subtitle-font-size(value) => { PlayerSidebarActions.set-subtitle-font-size(value); }
        set-subtitle-outline-size(value) => { PlayerSidebarActions.set-subtitle-outline-size(value); }
        set-subtitle-position(secondary, position) => { PlayerSidebarActions.set-subtitle-position(secondary, position); }
        set-subtitle-scale-slider(value) => { PlayerMenuActions.set-subtitle-scale-slider(value); }
        sidebar-card-material-fill: PlayerAppearance.sidebar-card-material-fill;
        sidebar-control-material-fill: PlayerAppearance.sidebar-control-material-fill;
        toggle-secondary-subtitle-visibility => { PlayerMenuActions.toggle-secondary-subtitle-visibility(); }
        toggle-subtitle-visibility => { PlayerMenuActions.toggle-subtitle-visibility(); }
        track-selected(kind, token) => { PlayerMenuActions.select-item(root.selection-for-pane(kind), token); }
        windows-accent-color: PlayerAppearance.windows-accent-color;
        windows-accent-foreground: PlayerAppearance.windows-accent-foreground;
        windows-sidebar-material-active: PlayerAppearance.windows-sidebar-material-active;
    }
}
