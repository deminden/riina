export enum PlaylistMenuOrigin { sidebar, music-mode }

// Selection and keyboard focus belong to the player, not a recycled row.
export global PlaylistInteraction {
    in-out property <int> playlist-menu-generation: 0;
    callback request-playlist-menu(PlaylistMenuOrigin, string, float, float) -> bool;
    in-out property <string> selected-playlist-token: "";
    in-out property <[string]> selected-playlist-tokens: [];
    in-out property <string> playlist-drag-token: "";
    in-out property <float> playlist-drag-start-x: 0;
    in-out property <float> playlist-drag-start-y: 0;
    in-out property <bool> playlist-drag-active: false;
    in-out property <int> playlist-drop-index: -1;
    in-out property <bool> playlist-drag-extend: false;
    in-out property <bool> playlist-drag-range: false;
    in-out property <int> playlist-focus-index: -1;
}
