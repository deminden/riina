import { PlayerSidebarActions } from "player-sidebar-actions.slint";

export enum PlaylistMenuOrigin { sidebar, music-mode }
export enum PlaylistSubtitleAction { add, clear }

export struct PlaylistSubtitleTargets {
    single: bool,
    matched: int,
}

export struct PlaylistDropHover {
    active: bool,
    x: float,
    y: float,
}

// Selection and keyboard focus belong to the player, not a recycled row.
export global PlaylistInteraction {
    in-out property <int> playlist-menu-generation: 0;
    callback request-playlist-menu(PlaylistMenuOrigin, string, float, float);
    callback subtitle-targets(string) -> PlaylistSubtitleTargets;
    callback subtitle-action(PlaylistSubtitleAction, string);
    callback toggle-series-prefix(string);
    in property <string> reveal-action-label: "Show in File Manager";
    in-out property <string> selected-playlist-token: "";
    in-out property <[string]> selected-playlist-tokens: [];
    in-out property <string> playlist-drag-token: "";
    in-out property <bool> playlist-drag-active: false;
    in-out property <length> playlist-drag-x;
    in-out property <length> playlist-drag-y;
    in-out property <PlaylistDropHover> external-drop-hover;
    public function cancel-playlist-drag() {
        root.playlist-drag-token = "";
        root.playlist-drag-active = false;
    }

    public function select-row(index: int, token: string, extend: bool, range: bool) {
        root.selected-playlist-tokens = PlayerSidebarActions.select-playlist-row(index, extend, range);
        root.selected-playlist-token = token;
    }

    public function clear-selection() {
        root.selected-playlist-token = "";
        root.selected-playlist-tokens = [];
        PlayerSidebarActions.clear-playlist-selection();
    }
}
