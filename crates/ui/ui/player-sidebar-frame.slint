import { PlayerControlActions } from "player-control-actions.slint";
import { PlayerAppearance } from "player-appearance.slint";
import { PlayerRenderedVideo } from "player-rendered-video.slint";
import { Theme } from "theme.slint";
export component PlayerSidebarFrame inherits Rectangle {
    in property <bool> native-video;
    in property <length> render-height;
    in property <length> render-width;
    in property <length> video-inset-leading;
    in property <length> video-inset-top;

    in property <bool> leading;
    in property <length> viewport-width;
    in property <bool> sidebar-open;
    in property <bool> reduce-motion-fade;

    // Keep every category and the close control reachable when the
    // upstream 80% sidebar limit leaves too little room for tab text.
    out property <bool> expanded-tab-labels: self.width >= 280px;

    private property <bool> close-transition-pending: false;
    changed sidebar-open => {
        root.close-transition-pending = !sidebar-open && !PlayerAppearance.animations-disabled;
    }
    changed reduce-motion-fade => {
        if PlayerAppearance.animations-disabled { root.close-transition-pending = false; }
    }
    Timer {
        interval: 260ms; running: parent.close-transition-pending;
        triggered => { parent.close-transition-pending = false; }
    }
    visible: sidebar-open || (close-transition-pending && !PlayerAppearance.animations-disabled);
    x: root.leading
        ? ((sidebar-open || reduce-motion-fade) ? 0px : -self.width)
        : ((sidebar-open || reduce-motion-fade) ? root.viewport-width - self.width : root.viewport-width);
    animate x { duration: PlayerAppearance.animations-disabled || reduce-motion-fade ? 0ms : 240ms; }
    opacity: !reduce-motion-fade || sidebar-open ? 1 : 0;
    animate opacity { duration: reduce-motion-fade ? 240ms : 0ms; }

    clip: true;
    border-radius: PlayerAppearance.windows-sidebar-material-active ? 12px : 0px;
    border-width: PlayerAppearance.windows-sidebar-material-active ? 1px : 0px;
    border-color: Theme.sidebar-material-border(PlayerAppearance.dark-theme);
    // The transparent Windows host would otherwise reveal the desktop
    // during the video-sample startup gap or after a stale frame expires.
    background: Theme.sidebar-frame-surface(
        PlayerAppearance.dark-theme, PlayerAppearance.active-liquid-glass-sidebar, PlayerAppearance.platform-macos,
        PlayerAppearance.platform-windows, root.native-video, PlayerRenderedVideo.video-material-sample-ready);
    if PlayerAppearance.active-liquid-glass-sidebar &&
        (!PlayerAppearance.platform-windows || PlayerRenderedVideo.video-material-sample-ready) : sidebar-video-sample := Image {
        source: PlayerRenderedVideo.video-blurred-frame;
        x: root.video-inset-leading - parent.x;
        y: root.video-inset-top - parent.y;
        width: root.render-width;
        height: root.render-height;
        opacity: PlayerAppearance.sidebar-material-sample-opacity(root.native-video);
        image-fit: contain;
    }
    // A light material needs its tint above the sampled video. Drawing
    // the sample over that tint made labels depend on the movie's color.
    if PlayerAppearance.windows-sidebar-material-active && !PlayerAppearance.dark-theme &&
        PlayerRenderedVideo.video-material-sample-ready : sidebar-light-tint := Rectangle {
        width: parent.width; height: parent.height;
        background: Theme.sidebar-light-tint;
    }
    // Track row height and None entry follow SidebarTrackSelector.swift.
    // Saved widths are independent; opening clamps to 80% without overwriting intent.
    // Playlist/chapters default leading; settings default trailing.
    // REF-21 supplies Layout and tab-header insets; live Windows Acrylic
    // pixels still need a matched capture before material tuning is closed.
    // Unhandled input belongs to this panel, not the video behind it.
    // In particular, a wheel at a scroll boundary must not change volume.
    TouchArea {
        clicked => { PlayerControlActions.activity(); }
        scroll-event(event) => { return accept; }
    }
    @children
}
