import { PlayerDialogState } from "player-dialog-state.slint";
import { PlayerAppearance } from "player-appearance.slint";
import { JumpDialogButton } from "player-chrome-controls.slint";

export component PlayerEntryDialogs inherits Rectangle {


    private property <bool> jump-time-dialog-visible: PlayerDialogState.jump-time-dialog-visible;
    private property <bool> url-dialog-visible: PlayerDialogState.url-dialog-visible;
    changed jump-time-dialog-visible => {
        PlayerDialogState.dialog-open = jump-time-dialog-visible || url-dialog-visible;
        if jump-time-dialog-visible { jump-time-input.focus(); }
    }
    changed url-dialog-visible => {
        PlayerDialogState.dialog-open = jump-time-dialog-visible || url-dialog-visible;
        if url-dialog-visible { url-input.focus(); }
    }

    jump-time-dialog := Rectangle {
        visible: PlayerDialogState.jump-time-dialog-visible;
        width: parent.width; height: parent.height;
        background: #00000070;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - 340px) / 2;
            y: (parent.height - 172px) / 2;
            width: 340px; height: 172px; border-radius: 9px;
            background: PlayerAppearance.dark-theme ? #29292e : #f5f5f7;
            border-width: 1px; border-color: PlayerAppearance.dark-theme ? #55555d : #d4d4d8;
            Text { x: 18px; y: 14px; width: parent.width - 36px; height: 22px;
                text: "Jump to"; color: PlayerAppearance.dark-theme ? #f1f1f3 : #242428;
                font-size: 14px; font-weight: 600; }
            Text { x: 18px; y: 39px; width: parent.width - 36px; height: 32px;
                text: "Enter a time such as 20:35 or 1:02:03.500.";
                color: PlayerAppearance.dark-theme ? #c8c8cd : #55555b; font-size: 12px; }
            Rectangle {
                x: 18px; y: 78px; width: parent.width - 36px; height: 30px;
                border-radius: 5px; border-width: 1px;
                border-color: jump-time-input.has-focus ? #6094dc : (PlayerAppearance.dark-theme ? #5c5c64 : #c8c8cd);
                background: PlayerAppearance.dark-theme ? #1e1e22 : #ffffff;
                jump-time-input := TextInput {
                    x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px;
                    text <=> PlayerDialogState.jump-time-draft; single-line: true;
                    font-size: 13px; color: PlayerAppearance.dark-theme ? #f3f3f5 : #202024;
                    accessible-label: "Playback time";
                    accepted => { PlayerDialogState.jump-to-time(self.text); }
                }
            }
            Text { x: 18px; y: 111px; width: parent.width - 36px; height: 17px;
                text: PlayerDialogState.jump-time-error; color: #c43d36; font-size: 11px; }
            HorizontalLayout {
                x: parent.width - 182px; y: 136px; width: 164px; height: 25px; spacing: 8px;
                JumpDialogButton { dark-theme: PlayerAppearance.dark-theme; label: "Cancel";
                    activated => { PlayerDialogState.jump-time-dialog-visible = false; PlayerDialogState.jump-time-error = ""; } }
                JumpDialogButton { dark-theme: PlayerAppearance.dark-theme; label: "Jump";
                    activated => { PlayerDialogState.jump-to-time(PlayerDialogState.jump-time-draft); } }
            }
        }
    }
    url-dialog := Rectangle {
        visible: PlayerDialogState.url-dialog-visible;
        width: parent.width; height: parent.height;
        background: #00000070;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            x: (parent.width - 390px) / 2;
            y: (parent.height - 176px) / 2;
            width: 390px; height: 176px; border-radius: 9px;
            background: PlayerAppearance.dark-theme ? #29292e : #f5f5f7;
            border-width: 1px; border-color: PlayerAppearance.dark-theme ? #55555d : #d4d4d8;
            Text { x: 18px; y: 14px; width: parent.width - 36px; height: 22px;
                text: "Open URL"; color: PlayerAppearance.dark-theme ? #f1f1f3 : #242428;
                font-size: 14px; font-weight: 600; }
            Text { x: 18px; y: 39px; width: parent.width - 36px; height: 32px;
                text: "Enter a media URL to open in Riina.";
                color: PlayerAppearance.dark-theme ? #c8c8cd : #55555b; font-size: 12px; }
            Rectangle {
                x: 18px; y: 78px; width: parent.width - 36px; height: 30px;
                border-radius: 5px; border-width: 1px;
                border-color: url-input.has-focus ? #6094dc : (PlayerAppearance.dark-theme ? #5c5c64 : #c8c8cd);
                background: PlayerAppearance.dark-theme ? #1e1e22 : #ffffff;
                url-input := TextInput {
                    x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px;
                    text <=> PlayerDialogState.url-dialog-draft; single-line: true;
                    font-size: 13px; color: PlayerAppearance.dark-theme ? #f3f3f5 : #202024;
                    accessible-label: "Media URL";
                    accepted => {
                        PlayerDialogState.open-url(self.text);
                        PlayerDialogState.url-dialog-visible = false;
                    }
                }
            }
            HorizontalLayout {
                x: parent.width - 182px; y: 130px; width: 164px; height: 25px; spacing: 8px;
                JumpDialogButton { dark-theme: PlayerAppearance.dark-theme; label: "Cancel";
                    activated => { PlayerDialogState.url-dialog-visible = false; } }
                JumpDialogButton { dark-theme: PlayerAppearance.dark-theme; label: "Open";
                    activated => {
                        PlayerDialogState.open-url(PlayerDialogState.url-dialog-draft);
                        PlayerDialogState.url-dialog-visible = false;
                    } }
            }
        }
    }
}
