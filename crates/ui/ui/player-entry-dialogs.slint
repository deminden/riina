import { Theme } from "theme.slint";
import { PlayerDialogState, TrackAttachmentError } from "player-dialog-state.slint";
import { PlayerAppearance } from "player-appearance.slint";
import { JumpDialogButton } from "player-chrome-controls.slint";
import { JumpTimeDialog } from "jump-time-dialog.slint";
import { TrackAttachmentAlert } from "track-attachment-alert.slint";

export component PlayerEntryDialogs inherits Rectangle {
    callback restore-player-focus();

    private property <bool> jump-time-dialog-visible: PlayerDialogState.jump-time-dialog-visible;
    private property <bool> url-dialog-visible: PlayerDialogState.url-dialog-visible;
    changed jump-time-dialog-visible => {
        PlayerDialogState.dialog-open = jump-time-dialog-visible || url-dialog-visible;
        if jump-time-dialog-visible { jump-time-dialog.edit(); }
        else if !url-dialog-visible { root.restore-player-focus(); }
    }
    changed url-dialog-visible => {
        PlayerDialogState.dialog-open = jump-time-dialog-visible || url-dialog-visible;
        if url-dialog-visible { url-input.focus(); }
    }

    TrackAttachmentAlert {
        visible: PlayerDialogState.track-error != TrackAttachmentError.none;
        width: parent.width; height: parent.height;
        changed visible => {
            if self.visible { self.focus-default(); }
            else if !PlayerDialogState.dialog-open { root.restore-player-focus(); }
        }
    }

    jump-time-dialog := JumpTimeDialog {
        visible: PlayerDialogState.jump-time-dialog-visible;
        width: parent.width; height: parent.height;
    }
    url-dialog := Rectangle {
        function submit() {
            if PlayerDialogState.append-playlist-url(PlayerDialogState.url-dialog-draft) {
                PlayerDialogState.url-dialog-visible = false;
            }
        }
        visible: PlayerDialogState.url-dialog-visible;
        width: parent.width; height: parent.height;
        background: Theme.player-dialog-scrim;
        TouchArea { width: parent.width; height: parent.height; }
        Rectangle {
            width: min(390px, max(0px, parent.width - 24px));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: 176px; border-radius: 9px;
            background: Theme.player-dialog-surface(PlayerAppearance.dark-theme);
            border-width: 1px; border-color: Theme.player-dialog-border(PlayerAppearance.dark-theme);
            Text { x: 18px; y: 14px; width: parent.width - 36px; height: 22px;
                text: "Add URL to Playlist";
                color: Theme.player-dialog-title(PlayerAppearance.dark-theme);
                font-size: 14px; font-weight: 600; }
            Text { x: 18px; y: 39px; width: parent.width - 36px; height: 32px;
                text: "Enter a media URL to add to the playlist."; wrap: word-wrap;
                color: Theme.player-dialog-instructions(PlayerAppearance.dark-theme); font-size: 12px; }
            Rectangle {
                x: 18px; y: 78px; width: parent.width - 36px; height: 30px;
                border-radius: 5px; border-width: 1px;
                border-color: url-input.has-focus ? Theme.player-dialog-field-focus : (Theme.player-dialog-field-border(PlayerAppearance.dark-theme));
                background: Theme.player-dialog-field-surface(PlayerAppearance.dark-theme);
                url-input := TextInput {
                    x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px;
                    text <=> PlayerDialogState.url-dialog-draft; single-line: true;
                    font-size: 13px; color: Theme.player-dialog-field-text(PlayerAppearance.dark-theme);
                    accessible-label: "Media URL";
                    accepted => { url-dialog.submit(); }
                }
            }
            Text { x: 18px; y: 110px; width: parent.width - 36px; height: 17px;
                text: PlayerDialogState.url-dialog-error; overflow: elide;
                color: Theme.player-dialog-title(PlayerAppearance.dark-theme); font-size: 11px; }
            HorizontalLayout {
                x: parent.width - 182px; y: 130px; width: 164px; height: 25px; spacing: 8px;
                JumpDialogButton { dark-theme: PlayerAppearance.dark-theme; label: "Cancel";
                    activated => { PlayerDialogState.url-dialog-visible = false; } }
                JumpDialogButton { dark-theme: PlayerAppearance.dark-theme;
                    label: "Add";
                    activated => { url-dialog.submit(); } }
            }
        }
    }
}
