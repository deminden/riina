import { KeyBindingSettingsState, KeyBindingActionRow, KeyBindingIconButton, KeyBindingProfileMenuItem } from "preferences-key-bindings.slint";
import { PreferenceSwitch } from "preferences-controls.slint";
import { ComboBox, ScrollView } from "std-widgets.slint";

export component KeyBindingsPreferencesPage inherits ScrollView {
    in property <length> window-height;
    in property <bool> mica-backdrop-enabled;
    callback key-binding-settings-changed();
    callback settings-changed();
    callback key-binding-profile-selected(string);
    callback key-binding-search-changed(string);
    callback key-binding-add-requested();
    callback key-binding-row-selected(int);
    callback key-binding-edit-requested(int);
    callback key-binding-remove-requested(int);
    callback key-binding-import-profile-requested();
    callback key-binding-reveal-profile();

    content-width: self.visible-width;
    content-height: max(root.window-height, KeyBindingSettingsState.key-binding-rows.length == 0 ? 310px : 290px + KeyBindingSettingsState.key-binding-rows.length * 32px);
    vertical-scrollbar-policy: as-needed;
    horizontal-scrollbar-policy: always-off;
    Rectangle {
        width: parent.width; height: max(parent.height, KeyBindingSettingsState.key-binding-rows.length == 0 ? 310px : 290px + KeyBindingSettingsState.key-binding-rows.length * 32px);
        background: root.mica-backdrop-enabled ? #ffffff80 : #ffffff;
        Text { x: 28px; y: 16px; text: "Key Bindings";
            font-size: 15px; font-weight: 600; color: #222222; }
        Rectangle {
            x: 20px; y: 52px; width: parent.width - 40px; height: 42px;
            border-width: 1px; border-color: #e4e4e7; border-radius: 12px;
            background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            Image { x: 12px; y: 13px; width: 16px; height: 16px;
                source: @image-url("../../../assets/icons/keybindings.svg"); }
            Text { x: 37px; y: 0; width: 178px; height: parent.height;
                text: "Use system media control"; font-size: 12px; color: #252529;
                vertical-alignment: center; }
            Text { x: 206px; y: 11px; width: 18px; height: 18px;
                text: "?"; font-size: 11px; color: #55555b;
                horizontal-alignment: center; vertical-alignment: center; }
            PreferenceSwitch {
                x: parent.width - 52px; y: 7px; width: 44px;
                label: "Use system media control"; show-label: false;
                checked <=> KeyBindingSettingsState.key-binding-use-system-media-controls;
                toggled => { root.key-binding-settings-changed(); root.settings-changed(); }
            }
        }
        Rectangle {
            x: 20px; y: 110px; width: parent.width - 40px;
            height: KeyBindingSettingsState.key-binding-rows.length == 0 ? 200px : 180px + KeyBindingSettingsState.key-binding-rows.length * 32px;
            border-width: 1px; border-color: #e4e4e7; border-radius: 12px;
            background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            Text { x: 12px; y: 8px; width: 66px; height: 36px;
                text: "Key binding set"; font-size: 11px; color: #29292d;
                vertical-alignment: center; wrap: word-wrap; }
            ComboBox {
                x: 82px; y: 8px; width: parent.width - 182px; height: 28px;
                model: KeyBindingSettingsState.key-binding-profiles;
                current-index <=> KeyBindingSettingsState.key-binding-profile-index;
                selected => {
                    if KeyBindingSettingsState.key-binding-profile-index >= 0
                        && KeyBindingSettingsState.key-binding-profile-index < KeyBindingSettingsState.key-binding-profiles.length {
                        KeyBindingSettingsState.key-binding-current-profile = KeyBindingSettingsState.key-binding-profiles[KeyBindingSettingsState.key-binding-profile-index];
                        root.key-binding-profile-selected(KeyBindingSettingsState.key-binding-current-profile);
                        root.settings-changed();
                    }
                }
            }
            KeyBindingIconButton {
                x: parent.width - 82px; y: 4px; label: "Delete profile"; icon-kind: 0;
                enabled: KeyBindingSettingsState.key-binding-profile-index >= 5;
                activated => { KeyBindingSettingsState.key-binding-profile-delete-confirm-open = true; }
            }
            KeyBindingIconButton {
                x: parent.width - 44px; y: 4px; label: "Add key binding set"; icon-kind: 3;
                activated => { KeyBindingSettingsState.key-binding-profile-menu-open = !KeyBindingSettingsState.key-binding-profile-menu-open; }
            }
            Rectangle { x: 1px; y: 52px; width: parent.width - 2px; height: 1px; background: #e3e3e6; }
            Rectangle {
                x: 28px; y: 62px; width: parent.width - 136px; height: 28px;
                border-width: 1px; border-color: #dedee2; border-radius: 14px;
                background: #ffffff;
                Image { x: 8px; y: 6px; width: 16px; height: 16px;
                    source: @image-url("../../../assets/icons/search.svg"); }
                if KeyBindingSettingsState.key-binding-search-query.is-empty : Text {
                    x: 30px; y: 0; width: parent.width - 38px; height: parent.height;
                    text: "Search"; font-size: 11px; color: #89898f; vertical-alignment: center;
                }
                TextInput {
                    x: 30px; y: 0; width: parent.width - 38px; height: parent.height;
                    text <=> KeyBindingSettingsState.key-binding-search-query; single-line: true;
                    font-size: 11px; color: #29292d; vertical-alignment: center;
                    accessible-label: "Search key bindings";
                    changed text => { root.key-binding-search-changed(self.text); }
                }
            }
            KeyBindingIconButton {
                x: parent.width - 96px; y: 58px; width: 40px; height: 36px;
                label: "Add key binding"; icon-kind: 1;
                enabled: KeyBindingSettingsState.key-binding-profile-index >= 5;
                activated => { root.key-binding-add-requested(); }
            }
            if KeyBindingSettingsState.key-binding-rows.length == 0 : Text {
                x: 28px; y: 100px; width: parent.width - 52px; height: 44px;
                text: "No mappings in this configuration";
                font-size: 11px; color: #77777d; vertical-alignment: center;
            }
            if KeyBindingSettingsState.key-binding-rows.length > 0 : VerticalLayout {
                x: 20px; y: 96px; width: parent.width - 40px;
                spacing: 0px;
                for row[index] in KeyBindingSettingsState.key-binding-rows : KeyBindingActionRow {
                    entry: row; row-index: index; row-count: KeyBindingSettingsState.key-binding-rows.length;
                    editable: KeyBindingSettingsState.key-binding-profile-index >= 5;
                    selected-index: KeyBindingSettingsState.key-binding-selected-row;
                    selected: KeyBindingSettingsState.key-binding-selected-row == index;
                    activated(selected-row) => {
                        KeyBindingSettingsState.key-binding-selected-row = selected-row;
                        root.key-binding-row-selected(selected-row);
                    }
                    edit-requested(row-index) => { root.key-binding-edit-requested(row-index); }
                    remove-requested(row-index) => { root.key-binding-remove-requested(row-index); }
                }
            }
            Rectangle {
                x: 1px; y: KeyBindingSettingsState.key-binding-rows.length == 0 ? 152px : 132px + KeyBindingSettingsState.key-binding-rows.length * 32px;
                width: parent.width - 2px; height: 1px; background: #e3e3e6;
            }
            Text {
                x: 20px; y: KeyBindingSettingsState.key-binding-rows.length == 0 ? 164px : 144px + KeyBindingSettingsState.key-binding-rows.length * 32px;
                width: parent.width - 88px; height: 28px;
                text: "Display raw values"; font-size: 11px; color: #29292d;
                vertical-alignment: center;
            }
            PreferenceSwitch {
                x: parent.width - 68px; y: KeyBindingSettingsState.key-binding-rows.length == 0 ? 164px : 144px + KeyBindingSettingsState.key-binding-rows.length * 32px;
                width: 44px; height: 28px; label: "Display raw values"; show-label: false;
                checked <=> KeyBindingSettingsState.key-binding-display-raw-values;
                toggled => { root.key-binding-settings-changed(); root.settings-changed(); }
            }
            if KeyBindingSettingsState.key-binding-profile-menu-open : Rectangle {
                x: parent.width - 194px; y: 34px; width: 188px; height: KeyBindingSettingsState.key-binding-profile-index >= 5 ? 158px : 128px;
                border-width: 1px; border-color: #d4d4d8; border-radius: 8px;
                background: #ffffff;
                KeyBindingProfileMenuItem {
                    x: 2px; y: 3px; label: "Create empty set";
                    activated => {
                        KeyBindingSettingsState.key-binding-profile-menu-open = false;
                        KeyBindingSettingsState.key-binding-profile-editor-mode = 0;
                        KeyBindingSettingsState.key-binding-profile-editor-name = "";
                        KeyBindingSettingsState.key-binding-profile-editor-open = true;
                    }
                }
                KeyBindingProfileMenuItem {
                    x: 2px; y: 33px; label: "Duplicate current set";
                    activated => {
                        KeyBindingSettingsState.key-binding-profile-menu-open = false;
                        KeyBindingSettingsState.key-binding-profile-editor-mode = 1;
                        KeyBindingSettingsState.key-binding-profile-editor-name = "";
                        KeyBindingSettingsState.key-binding-profile-editor-open = true;
                    }
                }
                if KeyBindingSettingsState.key-binding-profile-index >= 5 : KeyBindingProfileMenuItem {
                    x: 2px; y: 63px; label: "Rename current set…";
                    activated => {
                        KeyBindingSettingsState.key-binding-profile-menu-open = false;
                        KeyBindingSettingsState.key-binding-profile-editor-mode = 2;
                        KeyBindingSettingsState.key-binding-profile-editor-name = KeyBindingSettingsState.key-binding-current-profile;
                        KeyBindingSettingsState.key-binding-profile-editor-open = true;
                    }
                }
                KeyBindingProfileMenuItem {
                    x: 2px; y: KeyBindingSettingsState.key-binding-profile-index >= 5 ? 93px : 63px; label: "Import configuration…";
                    activated => {
                        KeyBindingSettingsState.key-binding-profile-menu-open = false;
                        root.key-binding-import-profile-requested();
                    }
                }
                Rectangle { x: 8px; y: KeyBindingSettingsState.key-binding-profile-index >= 5 ? 124px : 94px; width: parent.width - 16px; height: 1px; background: #e5e5e8; }
                KeyBindingProfileMenuItem {
                    x: 2px; y: KeyBindingSettingsState.key-binding-profile-index >= 5 ? 126px : 96px; label: "Show profile file";
                    activated => {
                        KeyBindingSettingsState.key-binding-profile-menu-open = false;
                        root.key-binding-reveal-profile();
                    }
                }
            }
        }
    }
}
