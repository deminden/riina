import { Theme } from "theme.slint";
import { FolderChooser, GeneralDisclosureRow, GeneralSettingToggle } from "preferences-controls.slint";
import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";

export enum UpdatePreference { automatic, interval, prereleases }
export enum PlaybackPowerPreference { prevent-screen-saver, allow-audio }

export global GeneralSettingsState {
    in-out property <bool> when-media-opened-expanded: false;
    in-out property <bool> pause-resume-when-expanded: false;
    in-out property <int> format-index: 0;
    in-out property <bool> include-subtitles: true;
    in-out property <bool> show-preview: true;
    in-out property <bool> save-to-file: true;
    in-out property <bool> copy-to-clipboard: false;
    in-out property <int> launch-action-index: 0;
    in-out property <bool> allow-multiple-windows: true;
    in-out property <bool> group-simultaneous-opens-in-playlist: false;
    in-out property <bool> allow-duplicate-players: false;
    in-out property <bool> playlist-auto-add: true;
    in-out property <bool> playlist-auto-play-next: true;
    in-out property <bool> playlist-show-metadata: true;
    in-out property <bool> playlist-show-metadata-in-music-mode: true;
    in-out property <bool> auto-repeat: false;
    in-out property <int> default-repeat-mode-index: 0;
    in-out property <bool> pause-when-open: false;
    in-out property <bool> play-when-entering-fullscreen: false;
    in-out property <bool> pause-when-leaving-fullscreen: false;
    in-out property <bool> pause-when-inactive: false;
    in-out property <bool> pause-when-minimized: false;
    in-out property <bool> pause-when-goes-to-sleep: true;
    in-out property <bool> pause-policies-available: false;
    in-out property <bool> quit-when-no-opened-window: false;
    in-out property <bool> keep-open-on-file-end: true;
    in-out property <bool> prevent-screen-saver: true;
    in-out property <bool> allow-screen-saver-for-audio: false;
    callback playback-power-setting-changed(PlaybackPowerPreference);
    in-out property <bool> automatic-update-checks: false;
    in-out property <int> update-interval-index: 1;
    in-out property <bool> receive-prerelease-updates: false;
    callback update-setting-changed(UpdatePreference);
    in-out property <bool> fullscreen-when-open: false;
    in-out property <bool> resume-last-position: true;
    in-out property <bool> record-playback-history: true;
    in-out property <bool> record-recent-files: true;
    in-out property <bool> track-all-files-in-recent-open-menu: true;
    in-out property <bool> auto-switch-to-music-mode: true;
    in-out property <bool> music-mode-show-playlist: false;
    in-out property <bool> music-mode-show-album-art: true;
    in-out property <string> directory;
    in-out property <bool> folder-dialog-open: false;
}

export component GeneralPreferencesPage inherits ScrollView {
    in property <length> general-content-height;
    in-out property <length> general-scroll-position;
    in property <length> general-history-target;
    in-out property <int> selected-general-section;
    in property <length> general-playlist-target;
    in property <length> general-screenshots-target;
    in property <bool> mica-backdrop-enabled;
    callback settings-changed();
    in property <length> general-window-y;
    in property <length> general-power-y;
    in property <length> general-updates-y;
    in property <length> general-history-y;
    in property <length> general-playlist-y;
    in property <length> general-screenshots-y;
    callback choose-folder();

    content-height: root.general-content-height;
    content-width: self.visible-width;
    content-y <=> root.general-scroll-position;
    horizontal-scrollbar-policy: always-off;
    changed content-y => {
        if root.general-scroll-position > (13px - root.general-updates-y + root.general-history-target) / 2 {
            root.selected-general-section = 0;
        }
        else if root.general-scroll-position > (root.general-history-target + root.general-playlist-target) / 2 { root.selected-general-section = 1; }
        else if root.general-scroll-position > (root.general-playlist-target + root.general-screenshots-target) / 2 { root.selected-general-section = 2; }
        else { root.selected-general-section = 3; }
    }
    Rectangle {
    width: parent.width;
    height: root.general-content-height;
    background: Theme.settings-content-surface(root.mica-backdrop-enabled);
    Text { x: 20px; y: 16px; text: @tr("General"); font-size: 15px; font-weight: 600; color: Theme.settings-page-heading; }
    Text { x: 20px; y: 52px; text: @tr("Behavior"); font-weight: 600; font-size: 13px; color: Theme.settings-general-section-heading; }
    Rectangle {
        x: 12px; y: 81px; width: parent.width - 24px;
        height: 122px + (GeneralSettingsState.when-media-opened-expanded ? 166px : 0px)
            + (GeneralSettingsState.pause-resume-when-expanded ? (GeneralSettingsState.pause-policies-available ? 168px : 104px) : 0px);
        border-width: 1px; border-color: Theme.settings-general-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        Text { x: 38px; y: 0; width: 120px; height: 40px; text: @tr("At launch");
            font-size: 13px; color: Theme.settings-page-heading; vertical-alignment: center; }
        ComboBox { x: 180px; y: 7px; width: parent.width - 192px; height: 26px;
            model: [@tr("Show welcome window"), @tr("Show open file panel"), @tr("Do nothing")];
            current-index <=> GeneralSettingsState.launch-action-index;
            selected => { root.settings-changed(); }
        }
        Rectangle { x: 12px; y: 40px; width: parent.width - 24px; height: 1px; background: Theme.settings-general-divider; }
        GeneralDisclosureRow { x: 0; y: 41px; width: parent.width; label: @tr("When media is opened");
            expanded: GeneralSettingsState.when-media-opened-expanded;
            activated => { GeneralSettingsState.when-media-opened-expanded = !GeneralSettingsState.when-media-opened-expanded; } }
        Rectangle { x: 12px; y: 81px + (GeneralSettingsState.when-media-opened-expanded ? 166px : 0px);
            width: parent.width - 24px; height: 1px; background: Theme.settings-general-divider; }
        if GeneralSettingsState.when-media-opened-expanded : GeneralSettingToggle {
            x: 12px; y: 82px; width: parent.width - 24px; height: 32px;
            label: @tr("Pause"); checked <=> GeneralSettingsState.pause-when-open;
            toggled => { root.settings-changed(); }
        }
        if GeneralSettingsState.when-media-opened-expanded : GeneralSettingToggle {
            x: 12px; y: 114px; width: parent.width - 24px; height: 32px;
            label: @tr("Enter fullscreen"); checked <=> GeneralSettingsState.fullscreen-when-open;
            toggled => { root.settings-changed(); }
        }
        if GeneralSettingsState.when-media-opened-expanded : GeneralSettingToggle {
            x: 12px; y: 146px; width: parent.width - 24px; height: 32px;
            label: @tr("Automatically switch to Music Mode");
            checked <=> GeneralSettingsState.auto-switch-to-music-mode; toggled => { root.settings-changed(); }
        }
        if GeneralSettingsState.when-media-opened-expanded : GeneralSettingToggle {
            x: 12px; y: 178px; width: parent.width - 24px; height: 32px;
            label: @tr("Show playlist in Music Mode");
            checked <=> GeneralSettingsState.music-mode-show-playlist; toggled => { root.settings-changed(); }
        }
        if GeneralSettingsState.when-media-opened-expanded : GeneralSettingToggle {
            x: 12px; y: 210px; width: parent.width - 24px; height: 32px;
            label: @tr("Show album artwork in Music Mode");
            checked <=> GeneralSettingsState.music-mode-show-album-art; toggled => { root.settings-changed(); }
        }
        GeneralDisclosureRow {
            x: 0; y: 82px + (GeneralSettingsState.when-media-opened-expanded ? 166px : 0px);
            width: parent.width; label: @tr("Pause/resume when");
            expanded: GeneralSettingsState.pause-resume-when-expanded;
            activated => { GeneralSettingsState.pause-resume-when-expanded = !GeneralSettingsState.pause-resume-when-expanded; }
        }
        if GeneralSettingsState.pause-resume-when-expanded : GeneralSettingToggle {
            x: 12px; y: 122px + (GeneralSettingsState.when-media-opened-expanded ? 166px : 0px);
            width: parent.width - 24px; height: 32px;
            label: @tr("Play when entering fullscreen");
            checked <=> GeneralSettingsState.play-when-entering-fullscreen;
            toggled => { root.settings-changed(); }
        }
        if GeneralSettingsState.pause-resume-when-expanded : GeneralSettingToggle {
            x: 12px; y: 154px + (GeneralSettingsState.when-media-opened-expanded ? 166px : 0px);
            width: parent.width - 24px; height: 32px;
            label: @tr("Pause when leaving fullscreen");
            checked <=> GeneralSettingsState.pause-when-leaving-fullscreen;
            toggled => { root.settings-changed(); }
        }
        if GeneralSettingsState.pause-resume-when-expanded && GeneralSettingsState.pause-policies-available : GeneralSettingToggle {
            x: 12px; y: 186px + (GeneralSettingsState.when-media-opened-expanded ? 166px : 0px);
            width: parent.width - 24px; height: 32px;
            label: @tr("Window becomes inactive/active");
            checked <=> GeneralSettingsState.pause-when-inactive;
            toggled => { root.settings-changed(); }
        }
        if GeneralSettingsState.pause-resume-when-expanded : GeneralSettingToggle {
            x: 12px; y: (GeneralSettingsState.pause-policies-available ? 218px : 186px) + (GeneralSettingsState.when-media-opened-expanded ? 166px : 0px);
            width: parent.width - 24px; height: 32px;
            label: @tr("Minimized/un-minimized");
            checked <=> GeneralSettingsState.pause-when-minimized;
            toggled => { root.settings-changed(); }
        }
        if GeneralSettingsState.pause-resume-when-expanded && GeneralSettingsState.pause-policies-available : GeneralSettingToggle {
            x: 12px; y: 250px + (GeneralSettingsState.when-media-opened-expanded ? 166px : 0px);
            width: parent.width - 24px; height: 32px;
            label: @tr("Pause when machine goes to sleep");
            checked <=> GeneralSettingsState.pause-when-goes-to-sleep;
            toggled => { root.settings-changed(); }
        }
    }
    Rectangle {
        x: 12px; y: root.general-window-y;
        width: parent.width - 24px; height: 212px;
        border-width: 1px; border-color: Theme.settings-general-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        GeneralSettingToggle { x: 12px; y: 8px; width: parent.width - 24px; height: 36px;
            label: @tr("Always open media in new window");
            checked <=> GeneralSettingsState.allow-multiple-windows; toggled => { root.settings-changed(); } }
        Rectangle { x: 24px; y: 47px; width: parent.width - 36px; height: 1px; background: Theme.settings-general-divider; }
        GeneralSettingToggle { x: 32px; y: 48px; width: parent.width - 44px; height: 40px;
            label: @tr("Group media in playlist when opening multiple files at once");
            checked <=> GeneralSettingsState.group-simultaneous-opens-in-playlist;
            enabled: GeneralSettingsState.allow-multiple-windows; toggled => { root.settings-changed(); } }
        Rectangle { x: 24px; y: 89px; width: parent.width - 36px; height: 1px; background: Theme.settings-general-divider; }
        GeneralSettingToggle { x: 32px; y: 90px; width: parent.width - 44px; height: 40px;
            label: @tr("Allow opening the same file in multiple windows");
            checked <=> GeneralSettingsState.allow-duplicate-players;
            enabled: GeneralSettingsState.allow-multiple-windows; toggled => { root.settings-changed(); } }
        Rectangle { x: 12px; y: 131px; width: parent.width - 24px; height: 1px; background: Theme.settings-general-divider; }
        GeneralSettingToggle { x: 12px; y: 132px; width: parent.width - 24px; height: 36px;
            label: @tr("Quit after all windows are closed");
            checked <=> GeneralSettingsState.quit-when-no-opened-window; toggled => { root.settings-changed(); } }
        Rectangle { x: 12px; y: 169px; width: parent.width - 24px; height: 1px; background: Theme.settings-general-divider; }
        GeneralSettingToggle { x: 12px; y: 170px; width: parent.width - 24px; height: 36px;
            label: @tr("Keep window open after playback finishes");
            checked <=> GeneralSettingsState.keep-open-on-file-end; toggled => { root.settings-changed(); } }
    }
    Rectangle {
        x: 12px; y: root.general-power-y; width: parent.width - 24px; height: 82px;
        border-width: 1px; border-color: Theme.settings-general-card-border; border-radius: 12px;
        background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        GeneralSettingToggle {
            x: 12px; y: 4px; width: parent.width - 24px; height: 36px;
            label: @tr("Prevent screen saver");
            checked <=> GeneralSettingsState.prevent-screen-saver;
            toggled => { GeneralSettingsState.playback-power-setting-changed(PlaybackPowerPreference.prevent-screen-saver); }
        }
        Rectangle {
            x: 12px; y: 41px; width: parent.width - 24px; height: 1px;
            background: Theme.settings-general-divider;
        }
        GeneralSettingToggle {
            x: 32px; y: 43px; width: parent.width - 44px; height: 36px;
            label: @tr("Allow screen saver for audio playback");
            enabled: GeneralSettingsState.prevent-screen-saver;
            checked <=> GeneralSettingsState.allow-screen-saver-for-audio;
            toggled => { GeneralSettingsState.playback-power-setting-changed(PlaybackPowerPreference.allow-audio); }
        }
    }
    Rectangle {
        x: 12px; y: root.general-updates-y; width: parent.width - 24px; height: 124px;
        border-width: 1px; border-color: Theme.settings-general-card-border; border-radius: 12px;
        background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        GeneralSettingToggle {
            x: 12px; y: 4px; width: parent.width - 24px; height: 36px;
            label: @tr("Check for updates automatically");
            checked <=> GeneralSettingsState.automatic-update-checks;
            toggled => { GeneralSettingsState.update-setting-changed(UpdatePreference.automatic); }
        }
        Rectangle {
            x: 12px; y: 41px; width: parent.width - 24px; height: 1px;
            background: Theme.settings-general-divider;
        }
        Text {
            x: 38px; y: 43px; width: 120px; height: 37px; text: @tr("Check every");
            font-size: 13px; vertical-alignment: center;
            color: Theme.settings-page-heading;
        }
        ComboBox {
            x: 166px; y: 48px; width: parent.width - 182px; height: 27px;
            model: [@tr("Hour"), @tr("Day"), @tr("Week"), @tr("Month")];
            accessible-label: @tr("Update check interval");
            current-index <=> GeneralSettingsState.update-interval-index;
            enabled: GeneralSettingsState.automatic-update-checks;
            selected => { GeneralSettingsState.update-setting-changed(UpdatePreference.interval); }
        }
        Rectangle {
            x: 12px; y: 81px; width: parent.width - 24px; height: 1px;
            background: Theme.settings-general-divider;
        }
        GeneralSettingToggle {
            x: 12px; y: 83px; width: parent.width - 24px; height: 36px;
            label: @tr("Receive beta updates");
            checked <=> GeneralSettingsState.receive-prerelease-updates;
            toggled => { GeneralSettingsState.update-setting-changed(UpdatePreference.prereleases); }
        }
    }
    Text { x: 20px; y: root.general-history-y;
        text: @tr("History"); font-weight: 600; font-size: 13px; color: Theme.settings-general-section-heading; }
    Rectangle { x: 12px; y: root.general-history-y + 29px;
        width: parent.width - 24px; height: 164px;
        border-width: 1px; border-color: Theme.settings-general-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        CheckBox { x: 16px; y: 6px; height: 32px; text: @tr("Resume last position");
            checked <=> GeneralSettingsState.resume-last-position; toggled => { root.settings-changed(); } }
        Rectangle { x: 12px; y: 43px; width: parent.width - 24px; height: 1px; background: Theme.settings-general-divider; }
        CheckBox { x: 16px; y: 48px; height: 32px; text: @tr("Record playback history");
            checked <=> GeneralSettingsState.record-playback-history; toggled => { root.settings-changed(); } }
        Rectangle { x: 12px; y: 83px; width: parent.width - 24px; height: 1px; background: Theme.settings-general-divider; }
        CheckBox { x: 16px; y: 88px; height: 32px; text: @tr("Enable \"Open Recent\" menu");
            checked <=> GeneralSettingsState.record-recent-files; toggled => { root.settings-changed(); } }
        Rectangle { x: 24px; y: 123px; width: parent.width - 36px; height: 1px; background: Theme.settings-general-divider; }
        CheckBox { x: 32px; y: 128px; width: parent.width - 48px; height: 32px;
            text: @tr("Track all played files in \"Open Recent\" menu");
            checked <=> GeneralSettingsState.track-all-files-in-recent-open-menu;
            enabled: GeneralSettingsState.record-recent-files; toggled => { root.settings-changed(); } }
    }
    Text { x: 20px; y: root.general-playlist-y;
        text: @tr("Playlist"); font-weight: 600; font-size: 13px; color: Theme.settings-general-section-heading; }
    Rectangle { x: 12px; y: root.general-playlist-y + 28px;
        width: parent.width - 24px; height: 192px;
        border-width: 1px; border-color: Theme.settings-general-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
        CheckBox { x: 16px; y: 2px; height: 28px; text: @tr("Add files in the same folder automatically");
            checked <=> GeneralSettingsState.playlist-auto-add; toggled => { root.settings-changed(); } }
        Rectangle { x: 12px; y: 32px; width: parent.width - 24px; height: 1px; background: Theme.settings-general-divider; }
        CheckBox { x: 16px; y: 34px; height: 28px; text: @tr("Play next item automatically");
            checked <=> GeneralSettingsState.playlist-auto-play-next; toggled => { root.settings-changed(); } }
        Rectangle { x: 12px; y: 64px; width: parent.width - 24px; height: 1px; background: Theme.settings-general-divider; }
        CheckBox { x: 16px; y: 66px; width: parent.width - 32px; height: 28px;
            text: @tr("Show artist and track name for audio files when available");
            checked <=> GeneralSettingsState.playlist-show-metadata; toggled => { root.settings-changed(); } }
        CheckBox { x: 36px; y: 94px; width: parent.width - 52px; height: 28px;
            text: @tr("Only in Music Mode"); enabled: GeneralSettingsState.playlist-show-metadata;
            checked <=> GeneralSettingsState.playlist-show-metadata-in-music-mode;
            toggled => { root.settings-changed(); } }
        Rectangle { x: 12px; y: 124px; width: parent.width - 24px; height: 1px; background: Theme.settings-general-divider; }
        CheckBox { x: 16px; y: 128px; width: parent.width - 32px; height: 28px;
            text: @tr("Loop when a file is opened manually");
            checked <=> GeneralSettingsState.auto-repeat; toggled => { root.settings-changed(); } }
        ComboBox { x: 36px; y: 158px; width: parent.width - 52px; height: 26px;
            model: [@tr("Loop playlist"), @tr("Loop file")];
            current-index <=> GeneralSettingsState.default-repeat-mode-index;
            enabled: GeneralSettingsState.auto-repeat;
            selected => { root.settings-changed(); }
        }
    }
    Text { x: 20px; y: root.general-screenshots-y;
        text: @tr("Screenshots"); font-weight: 600; font-size: 13px; color: Theme.settings-general-section-heading; }
    Rectangle { x: 12px; y: root.general-screenshots-y + 28px;
        width: parent.width - 24px; height: 184px;
    border-width: 1px; border-color: Theme.settings-general-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
    Text { x: 16px; y: 8px; text: @tr("Destination:"); font-size: 13px; color: Theme.settings-page-heading; }
    Text { x: 16px; y: 112px; text: @tr("Options:"); font-size: 13px; color: Theme.settings-page-heading; }
    CheckBox { x: 120px; y: 28px; height: 24px; text: @tr("Save to");
        checked <=> GeneralSettingsState.save-to-file;
        toggled => { root.settings-changed(); }
    }
    Text { x: 198px; y: 32px; width: 112px; text: GeneralSettingsState.directory;
        overflow: elide; font-size: 13px; color: Theme.settings-screenshot-folder-text; }
    FolderChooser { x: parent.width - 43px; y: 29px; width: 24px; height: 22px;
        enabled: GeneralSettingsState.save-to-file && !GeneralSettingsState.folder-dialog-open;
        activated => { root.choose-folder(); } }
    Text { x: 137px; y: 56px; text: @tr("Format:"); font-size: 13px; color: Theme.settings-page-heading; }
    ComboBox {
        x: 194px; y: 52px; width: 132px; height: 24px;
        model: ["PNG", "JPEG (.jpg)", "JPEG (.jpeg)", "WebP (.webp)", "JPEG XL (.jxl)"];
        current-index <=> GeneralSettingsState.format-index;
        enabled: GeneralSettingsState.save-to-file;
        selected => { root.settings-changed(); }
    }
    CheckBox { x: 120px; y: 80px; height: 24px; text: @tr("Copy to clipboard");
        checked <=> GeneralSettingsState.copy-to-clipboard;
        toggled => { root.settings-changed(); }
    }
    CheckBox { x: 120px; y: 136px; height: 24px; text: @tr("Include subtitles");
        checked <=> GeneralSettingsState.include-subtitles;
        toggled => { root.settings-changed(); }
    }
    CheckBox { x: 120px; y: 160px; height: 24px; text: @tr("Show previews after taking screenshots");
        checked <=> GeneralSettingsState.show-preview;
        toggled => { root.settings-changed(); }
    }
    }
    }
}
