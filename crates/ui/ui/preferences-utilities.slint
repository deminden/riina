import { Theme } from "theme.slint";
import { ConfirmationSheet } from "confirmation-sheet.slint";
import { CheckBox, ScrollView } from "std-widgets.slint";
import { PreferenceActionButton, UtilitiesActionRow } from "preferences-controls.slint";

export enum BrowserExtension { chromium, firefox, safari }
export enum UtilityAction { none, restore-alerts, clear-progress, clear-history, clear-thumbnails }

export global UtilitySettingsState {
    in-out property <string> utilities-progress-size: "0 B";
    in-out property <string> utilities-thumbnail-size: "0 B";
    in-out property <string> utilities-status: "";
    in-out property <bool> utilities-default-app-sheet-open: false;
    in-out property <bool> utilities-default-video: true;
    in-out property <bool> utilities-default-audio: true;
    in-out property <bool> utilities-default-playlist: true;
    in-out property <bool> utilities-safari-available: false;
}

export component UtilitiesPreferencesPage inherits ScrollView {
    in property <bool> mica-backdrop-enabled;
    callback utilities-open-default-apps();
    callback utility-requested(UtilityAction);
    callback utilities-browser-extension(BrowserExtension);

    content-height: 700px; content-width: self.visible-width;
    horizontal-scrollbar-policy: always-off;
    Rectangle { width: parent.width; height: 700px;
        background: Theme.settings-content-surface(root.mica-backdrop-enabled);
        Text { x: 28px; y: 16px; text: "Utilities"; font-size: 15px; font-weight: 600; color: Theme.settings-page-heading; }
        Text { x: 20px; y: 52px; text: "Default Application"; font-size: 12px; font-weight: 600; color: Theme.settings-section-heading; }
        Rectangle { x: 20px; y: 81px; width: parent.width - 40px; height: 42px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            UtilitiesActionRow { width: parent.width; height: parent.height;
                icon: @image-url("../../../assets/icons/interface.svg"); title: "Set Riina as the Default Application";
                activated => { root.utilities-open-default-apps(); }
            }
        }
        Text { x: 20px; y: 144px; text: "Restore Alerts"; font-size: 12px; font-weight: 600; color: Theme.settings-section-heading; }
        Rectangle { x: 20px; y: 168px; width: parent.width - 40px; height: 76px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            UtilitiesActionRow { width: parent.width; height: parent.height;
                icon: @image-url("../../../assets/icons/resume-history.svg"); title: "Restore Suppressed Alerts";
                description: "Restore alerts hidden with ‘Do not show this message again’.";
                activated => { root.utility-requested(UtilityAction.restore-alerts); }
            }
        }
        Text { x: 20px; y: 268px; text: "Clear Cache"; font-size: 12px; font-weight: 600; color: Theme.settings-section-heading; }
        Rectangle { x: 20px; y: 290px; width: parent.width - 40px; height: 202px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            UtilitiesActionRow { y: 0px; width: parent.width; height: 87px;
                icon: @image-url("../../../assets/icons/resume-history.svg"); title: "Clear Saved Playback Progress";
                description: "Delete all files in the \"watch later\" folder. These files contain all saved playback progress and settings applied during playback.";
                trash: true; activated => { root.utility-requested(UtilityAction.clear-progress); }
            }
            UtilitiesActionRow { y: 87px; width: parent.width; height: 74px;
                icon: @image-url("../../../assets/icons/playlist.svg"); title: "Clear Playback History";
                description: "Delete all playback histories and entries in \"Open Recent\".";
                trash: true;
                activated => { root.utility-requested(UtilityAction.clear-history); }
            }
            UtilitiesActionRow { y: 161px; width: parent.width; height: 41px;
                icon: @image-url("../../../assets/icons/photo.svg"); title: "Clear Thumbnail Cache";
                metric: UtilitySettingsState.utilities-thumbnail-size; trash: true;
                activated => { root.utility-requested(UtilityAction.clear-thumbnails); }
            }
        }
        Text { x: 20px; y: 514px; text: "Browser Extensions"; font-size: 12px; font-weight: 600; color: Theme.settings-section-heading; }
        Rectangle { x: 20px; y: 536px; width: parent.width - 40px; height: 116px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 12px; background: Theme.settings-card-surface(root.mica-backdrop-enabled);
            Image { x: 15px; y: 16px; width: 20px; height: 20px;
                source: @image-url("../../../assets/icons/network.svg");
                colorize: Theme.settings-card-title; }
            Text { x: 47px; y: 12px; width: parent.width - 63px; height: 20px;
                text: "Get Browser Extensions for Riina"; font-size: 12px; color: Theme.settings-card-title; }
            Text { x: 47px; y: 34px; width: parent.width - 63px; height: 34px;
                text: "Send a link or the current webpage to the player."; font-size: 10px; color: Theme.settings-card-description; wrap: word-wrap; }
            HorizontalLayout { x: 47px; y: 76px; spacing: 8px; alignment: start;
                if UtilitySettingsState.utilities-safari-available : PreferenceActionButton {
                    label: "Safari";
                    activated => { root.utilities-browser-extension(BrowserExtension.safari); }
                }
                PreferenceActionButton {
                    width: 96px; label: "Chrome / Edge";
                    activated => { root.utilities-browser-extension(BrowserExtension.chromium); }
                }
                PreferenceActionButton {
                    label: "Firefox";
                    activated => { root.utilities-browser-extension(BrowserExtension.firefox); }
                }
            }
        }
        if !UtilitySettingsState.utilities-status.is-empty : Text {
            x: 20px; y: 660px; width: parent.width - 40px; height: 20px;
            text: UtilitySettingsState.utilities-status; font-size: 10px; color: Theme.settings-status-text; wrap: word-wrap;
        }
    }
}

export component UtilityActionDialog inherits ConfirmationSheet {
    private property <UtilityAction> pending: UtilityAction.none;
    private property <string> result;
    callback confirmed(UtilityAction) -> string;

    public function open(action: UtilityAction) {
        root.pending = action;
        root.result = "";
        root.focus();
    }

    public function dismiss() {
        root.pending = UtilityAction.none;
        root.result = "";
    }

    visible: root.pending != UtilityAction.none;
    acknowledgement-only: !root.result.is-empty;
    title: root.pending == UtilityAction.restore-alerts ? "Restore Suppressed Alerts"
        : root.pending == UtilityAction.clear-progress ? "Clear Saved Playback Progress"
        : root.pending == UtilityAction.clear-history ? "Clear Playback History"
        : "Clear Thumbnail Cache";
    description: root.acknowledgement-only ? root.result
        : root.pending == UtilityAction.restore-alerts ? "Restore suppressed alerts?"
        : root.pending == UtilityAction.clear-progress ?
            "Delete saved playback positions and settings for all media? Current size: "
                + UtilitySettingsState.utilities-progress-size + "."
        : root.pending == UtilityAction.clear-history ?
            "Clear Playback History, Open Recent, and the Welcome window’s Resume item?"
        : "Delete all cached thumbnails? Current size: "
            + UtilitySettingsState.utilities-thumbnail-size + ".";
    action: root.pending == UtilityAction.restore-alerts ? "Restore"
        : root.pending == UtilityAction.clear-history ? "Clear History" : "Clear";
    answered(accepted) => {
        if accepted && !root.acknowledgement-only {
            root.result = root.confirmed(root.pending);
            if root.result.is-empty { root.dismiss(); } else { root.focus(); }
        } else {
            root.dismiss();
        }
    }
}

export component DefaultAppDialog inherits Rectangle {
    in-out property <bool> video;
    in-out property <bool> audio;
    in-out property <bool> playlist;
    callback cancelled();
    callback confirmed(bool, bool, bool);

    background: Theme.settings-modal-scrim;
    Rectangle {
        x: (parent.width - 440px) / 2; y: (parent.height - 252px) / 2;
        width: 440px; height: 252px;
        border-radius: 10px; border-width: 1px; border-color: Theme.settings-modal-border;
        background: Theme.settings-modal-surface;
        Text { x: 20px; y: 16px; width: parent.width - 40px; height: 22px;
            text: "Set Riina as the Default Application";
            font-size: 14px; font-weight: 600; color: Theme.settings-modal-title; }
        Text { x: 20px; y: 47px; width: parent.width - 40px; height: 38px;
            text: "Choose the media types you want Riina to open. Your system controls the final default selection.";
            font-size: 11px; color: Theme.settings-modal-message; wrap: word-wrap; }
        CheckBox { x: 24px; y: 96px; width: parent.width - 48px; height: 22px;
            text: "Video"; checked <=> root.video; }
        CheckBox { x: 24px; y: 122px; width: parent.width - 48px; height: 22px;
            text: "Audio"; checked <=> root.audio; }
        CheckBox { x: 24px; y: 148px; width: parent.width - 48px; height: 22px;
            text: "Playlists"; checked <=> root.playlist; }
        PreferenceActionButton {
            x: parent.width - 178px; y: 204px; label: "Cancel";
            activated => { root.cancelled(); }
        }
        PreferenceActionButton {
            x: parent.width - 92px; y: 204px; label: "OK";
            activated => { root.confirmed(root.video, root.audio, root.playlist); }
        }
    }
}
