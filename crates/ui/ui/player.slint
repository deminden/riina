    pure function selection-for-pane(kind: int) -> CatalogSelection {
        return kind == 1 ? CatalogSelection.audio-track :
            kind == 2 ? CatalogSelection.primary-subtitle :
            kind == 3 ? CatalogSelection.chapter :
            kind == 4 ? CatalogSelection.playlist :
            kind == 5 ? CatalogSelection.secondary-subtitle :
            kind == 6 ? CatalogSelection.video-track : CatalogSelection.unknown;
    }
    private property <OsdMaterial> osd-material: {
        active: root.active-liquid-glass-osd,
        native-tint: root.platform-windows || root.native-video,
        frame: root.video-blurred-frame,
        video-x: root.video-inset-leading,
        video-y: root.video-inset-top,
        video-width: root.render-width,
        video-height: root.render-height,
        sample-opacity: root.video-material-sample-opacity,
    };

    callback set-delay(DelayLane, float);
    callback set-delay-text(DelayLane, string) -> bool;
    callback preview-audio-delay(float);
    callback reorder-playlist([string], int);
    callback toggle-playlist-shuffle();
    callback sort-playlist(int);

    // Keys bubble from focused controls through this scope, including sliders.
    // A sibling key scope would lose fullscreen/escape after toolbar navigation.
    keys := FocusScope {
        width: root.width;
        height: root.menu-content-height;
        VideoSurface {
            width: parent.width; height: parent.height;
            crop-editing: root.crop-editing;
            native-video: root.native-video;
            video-inset-leading: root.video-inset-leading;
            video-inset-top: root.video-inset-top;
            video-inset-trailing: root.video-inset-trailing;
            video-inset-bottom: root.video-inset-bottom;
            crop-picture-x: root.crop-picture-x;
            crop-picture-y: root.crop-picture-y;
            render-width: root.render-width;
            render-height: root.render-height;
            video-width: root.video-width;
            video-height: root.video-height;
            music-mode: root.music-mode;
            music-mode-show-album-art: root.music-mode-show-album-art;
            music-mode-is-audio: root.music-mode-is-audio;
            music-mode-has-album-art: root.music-mode-has-album-art;
            music-mode-has-visible-subtitles: root.music-mode-has-visible-subtitles;
            native-transition-frame: root.native-transition-frame;
            video-frame: root.video-frame;
            live-text-enabled: root.live-text-enabled;
            paused: root.paused;
            live-text-regions: root.live-text-regions;
            live-text-selectable: root.live-text-selectable;
            edge-to-edge-video: root.edge-to-edge-video;
            copy-live-text(text) => { root.copy-live-text(text); }
        }
        TouchArea { moved => { root.controls-visible = true; root.activity(); }
            clicked => {
                root.activity();
                root.single-click-action(root.control-single-click-index);
                if root.sidebar != 0 || root.leading-sidebar != 0 {
                    keys.focus(); root.sidebar = 0; root.leading-sidebar = 0;
                }
            }
            double-clicked => { root.double-click-action(root.control-double-click-index); }
            pointer-event(event) => {
                if event.kind == PointerEventKind.up {
                    if event.button == PointerEventButton.right {
                        root.activity(); root.mouse-button-action(root.control-right-click-index);
                    } else if event.button == PointerEventButton.middle {
                        root.activity(); root.mouse-button-action(root.control-middle-click-index);
                    }
                }
            }
            scroll-event(event) => {
                if root.scroll-action-request(event.delta-x / 1px, event.delta-y / 1px) {
                    return accept;
                }
                return reject;
            }
        }

        if root.show-player-title-row && controls-rendered && loaded && !crop-editing && !music-mode : PlayerTitleBar {
            clip: true;
            x: macos-sidebar-leading-inset;
            width: max(0px, parent.width - macos-sidebar-leading-inset - macos-sidebar-trailing-inset);
            animate x { duration: root.animations-disabled ? 0ms : 240ms; }
            animate width { duration: root.animations-disabled ? 0ms : 240ms; }
            y: 0; height: root.compact-ui ? 30px : 34px;
            opacity: root.controls-visible ? 1 : 0;
            animate opacity { duration: root.animations-disabled ? 0ms : 250ms; }
            active-liquid-glass-osc: root.active-liquid-glass-osc;
            dark-theme: root.dark-theme;
            platform-windows: root.platform-windows;
            native-video: root.native-video;
            video-blurred-frame: root.video-blurred-frame;
            video-inset-leading: root.video-inset-leading;
            video-inset-top: root.video-inset-top;
            render-width: root.render-width;
            render-height: root.render-height;
            video-material-sample-opacity: root.video-material-sample-opacity;
            interactive-accent-color: root.interactive-accent-color;
            engine-ready: root.engine-ready;
            media-title: root.media-title;
            always-float-on-top: root.always-float-on-top;
            always-show-on-top-icon: root.always-show-on-top-icon;
            hover-changed(hovered) => { root.title-bar-hovered = hovered; }
            open-file => { root.open-file(); }
            window-level-toggle-requested(value) => {
                root.always-float-on-top = value;
                root.window-level-toggle-requested(value);
            }
            toggle-settings-pane(pane) => { root.toggle-settings-pane(pane); }
            toggle-playlist-pane(pane) => { root.toggle-playlist-pane(pane); }
            toggle-fullscreen => { root.toggle-fullscreen(); }
        }
        if (!controls-visible || !loaded) && !crop-editing && !fullscreen &&
            (root.always-float-on-top || root.always-show-on-top-icon) : TopmostPin {
            x: parent.width - 36px;
            y: 2px;
            dark-theme: root.dark-theme;
            pinned: root.always-float-on-top;
            changed(value) => {
                root.always-float-on-top = value;
                root.window-level-toggle-requested(value);
            }
        }
        for side in [0, 1] : sidebar-frame := PlayerSidebarFrame {
            // Each side owns its selected pane; catalog callbacks retain their original kind.
            private property <int> pane-kind: side == 0 ? root.leading-sidebar : root.sidebar;
            private property <bool> quick-settings-pane:
                pane-kind == 1 || pane-kind == 2 || pane-kind == 5 || pane-kind == 6;
            private property <bool> sidebar-open: pane-kind != 0 && !root.crop-editing;
            // Keep every category and the close control reachable when the
            // upstream 80% sidebar limit leaves too little room for tab text.
            private property <bool> expanded-tab-labels: self.width >= 280px;
            private property <bool> reduce-motion-fade: root.macos-sidebar-reduce-motion-fade;
            private property <bool> close-transition-pending: false;
            changed sidebar-open => {
                self.close-transition-pending = !sidebar-open && !root.animations-disabled;
            }
            changed reduce-motion-fade => {
                if root.animations-disabled { self.close-transition-pending = false; }
            }
            Timer {
                interval: 260ms; running: parent.close-transition-pending;
                triggered => { parent.close-transition-pending = false; }
            }
            visible: sidebar-open || (close-transition-pending && !root.animations-disabled);
            x: side == 0
                ? ((sidebar-open || reduce-motion-fade) ? 0px : -self.width)
                : ((sidebar-open || reduce-motion-fade) ? parent.width - self.width : parent.width);
            animate x { duration: root.animations-disabled || reduce-motion-fade ? 0ms : 240ms; }
            opacity: !reduce-motion-fade || sidebar-open ? 1 : 0;
            animate opacity { duration: reduce-motion-fade ? 240ms : 0ms; }
            y: root.title-row-height + (root.osc-position == 1 ? root.osc-height : 0px);
            width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, parent.width * 0.8);
            height: parent.height - (root.show-player-title-row ? (root.compact-ui ? 60px : 68px) : 0px) -
                (root.osc-position == 1 ? root.osc-height : root.osc-position == 2 ? root.osc-height / 2 : 0px);
            active-liquid-glass-sidebar: root.active-liquid-glass-sidebar;
            dark-theme: root.dark-theme;
            native-video: root.native-video;
            platform-macos: root.platform-macos;
            platform-windows: root.platform-windows;
            render-height: root.render-height;
            render-width: root.render-width;
            sidebar-material-sample-opacity: root.sidebar-material-sample-opacity;
            video-blurred-frame: root.video-blurred-frame;
            video-inset-leading: root.video-inset-leading;
            video-inset-top: root.video-inset-top;
            video-material-sample-ready: root.video-material-sample-ready;
            windows-sidebar-material-active: root.windows-sidebar-material-active;
            activity => { root.activity(); }
            scroll-memory := SidebarScrollMemory {}
            sidebar-content := VerticalLayout {
                // IINA's tab row uses 10-point side margins; card widths are
                // explicit, so this does not change their measured insets.
                padding-left: quick-settings-pane ? 10px : (root.compact-ui ? 9px : 12px);
                padding-right: quick-settings-pane ? 10px : (root.compact-ui ? 9px : 12px);
                padding-top: root.compact-ui ? 9px : 12px;
                padding-bottom: root.compact-ui ? 9px : 12px;
                width: parent.width;
                spacing: root.compact-ui ? 6px : 8px;
                cross-axis-alignment: pane-kind == 1 ? center : start;
                PlayerSidebarTabs {
                    width: parent.width - 2px * (quick-settings-pane ? 10 : root.compact-ui ? 9 : 12);
                    leading: side == 0;
                    pane-kind: sidebar-frame.pane-kind;
                    expanded-tab-labels: sidebar-frame.expanded-tab-labels;
                    compact-ui: root.compact-ui;
                    dark-theme: root.dark-theme;
                    interactive-accent-color: root.interactive-accent-color;
                    platform-windows: root.platform-windows;
                    plugin-sidebar-identifiers: root.plugin-sidebar-identifiers;
                    plugin-sidebar-labels: root.plugin-sidebar-labels;
                    plugin-sidebar-selected-index: root.plugin-sidebar-selected-index;
                    quick-settings-tab-selected-fill: root.quick-settings-tab-selected-fill;
                    quick-settings-tab-selected-foreground: root.quick-settings-tab-selected-foreground;
                    windows-accent-color: root.windows-accent-color;
                    windows-accent-foreground: root.windows-accent-foreground;
                    windows-sidebar-material-active: root.windows-sidebar-material-active;
                    close-pane => {
                        // Retire focus before hiding a pane so later shortcuts reach the player.
                        keys.focus();
                        if side == 0 { root.leading-sidebar = 0; } else { root.sidebar = 0; }
                    }
                    select-settings-pane(pane) => { root.select-settings-pane(pane); }
                    select-playlist-pane(pane) => { root.select-playlist-pane(pane); }
                    select-plugin-sidebar-tab(id) => { root.select-plugin-sidebar-tab(id); }
                }
                if pane-kind == 5 : layout-scroll := LayoutSidebarPage {
                    width: parent.width - 20px;
                    appearance-mode <=> root.appearance-mode;
                    compact-ui <=> root.compact-ui;
                    dark-theme: root.dark-theme;
                    docked-controls <=> root.docked-controls;
                    edge-to-edge-video <=> root.edge-to-edge-video;
                    fit-window-to-video => { root.fit-window-to-video(); }
                    fullscreen: root.fullscreen;
                    interactive-accent-color: root.interactive-accent-color;
                    layout-scrollbar-visible <=> root.layout-scrollbar-visible;
                    layout-settings-changed => { root.layout-settings-changed(); }
                    liquid-glass-osc <=> root.liquid-glass-osc;
                    liquid-glass-osd <=> root.liquid-glass-osd;
                    liquid-glass-sidebar <=> root.liquid-glass-sidebar;
                    loaded: root.loaded;
                    osc-position <=> root.osc-position;
                    platform-windows: root.platform-windows;
                    playlist-at-leading <=> root.playlist-at-leading;
                    plugins-at-leading <=> root.plugins-at-leading;
                    settings-at-leading <=> root.settings-at-leading;
                    sidebar-card-material-fill: root.sidebar-card-material-fill;
                    surface-material-title: root.surface-material-title;
                    unlock-window-aspect-ratio <=> root.unlock-window-aspect-ratio;
                    windows-accent-color: root.windows-accent-color;
                    windows-accent-foreground: root.windows-accent-foreground;
                    windows-sidebar-material-active: root.windows-sidebar-material-active;
                }
                if pane-kind != 5 : QuickSettingsScrollPage {
                    page-kind: pane-kind;
                    audio-y: scroll-memory.audio-y;
                    video-y: scroll-memory.video-y;
                    subtitles-y: scroll-memory.subtitles-y;
                    playlist-y: scroll-memory.playlist-y;
                    chapters-y: scroll-memory.chapters-y;
                    position-changed(kind, offset) => {
                        if kind == 1 { scroll-memory.audio-y = offset; }
                        else if kind == 6 { scroll-memory.video-y = offset; }
                        else if kind == 2 { scroll-memory.subtitles-y = offset; }
                        else if kind == 4 { scroll-memory.playlist-y = offset; }
                        else if kind == 3 { scroll-memory.chapters-y = offset; }
                    }
                    width: parent.width - (quick-settings-pane
                        ? 20px : (root.compact-ui ? 18px : 24px));
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, sidebar-page.preferred-height);
                    // IINA's sidebar scroll indicators hide at rest. Keep the
                    // content scrollable without a persistent Windows gutter.
                    vertical-scrollbar-policy: always-off;
                    sidebar-page := VerticalLayout {
                        width: parent.width;
                        alignment: start; spacing: 1px;
                        cross-axis-alignment: quick-settings-pane ? center : start;
                        if pane-kind == 1 : AudioQuickSettingsPage {
                            card-width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px,
                                root.width * 0.8) - (root.compact-ui ? 28px : 32px);
                            compact-ui: root.compact-ui;
                            dark-theme: root.dark-theme;
                            delete-audio-equalizer-profile => { root.delete-audio-equalizer-profile(); }
                            interactive-accent-color: root.interactive-accent-color;
                            load-external-audio => { root.browse-files(1); }
                            loaded: root.loaded;
                            platform-windows: root.platform-windows;
                            preview-audio-delay(value-1) => { root.preview-audio-delay(value-1); }
                            rename-audio-equalizer-profile(value-1) => { return root.rename-audio-equalizer-profile(value-1); }
                            reset-audio-delay => { root.reset-audio-delay(); }
                            restore-player-focus => { keys.focus(); }
                            save-audio-equalizer-profile(value-1) => { return root.save-audio-equalizer-profile(value-1); }
                            select-audio-equalizer-profile(value-1) => { root.select-audio-equalizer-profile(value-1); }
                            set-audio-equalizer(value-1, value-2) => { root.set-audio-equalizer(value-1, value-2); }
                            set-delay(value-1) => { root.set-delay(DelayLane.audio, value-1); }
                            set-delay-text(value-1) => { return root.set-delay-text(DelayLane.audio, value-1); }
                            set-volume-boost(value-1) => { root.set-volume-boost(value-1); }
                            sidebar-card-material-fill: root.sidebar-card-material-fill;
                            sidebar-control-material-fill: root.sidebar-control-material-fill;
                            track-selected(value-1, value-2) => { root.select-item(root.selection-for-pane(value-1), value-2); }
                            validate-audio-equalizer-profile-name(value-1, value-2) => { return root.validate-audio-equalizer-profile-name(value-1, value-2); }
                            volume-boost: root.volume-boost;
                            windows-accent-color: root.windows-accent-color;
                            windows-sidebar-material-active: root.windows-sidebar-material-active;
                        }
                        if pane-kind == 7 && root.plugin-sidebar-selected-identifier == "" : VerticalLayout {
                            spacing: 6px;
                            Text { text: "Plugins can provide content in this panel.";
                                color: Theme.sidebar-heading-text(root.dark-theme);
                                font-size: 12px; wrap: word-wrap; }
                            if root.plugin-sidebar-labels.length == 0 : Text {
                                text: "Enabled plugins with sidebar tabs appear here.";
                                color: Theme.sidebar-empty-caption(root.dark-theme);
                                font-size: 11px; wrap: word-wrap; }
                        }
                        for row[index] in (pane-kind == 3 ? chapters : pane-kind == 4 ? playlist : []): CatalogSidebarRow {
                            width: parent.width;
                            entry: row;
                            index: index;
                            pane-kind: pane-kind;
                            playlist: root.playlist;
                            dark-theme: root.dark-theme;
                            interactive-accent-color: root.interactive-accent-color;
                            playlist-metadata-visible: root.playlist-metadata-visible;
                            select-row(token) => { root.select-item(root.selection-for-pane(pane-kind), token); }
                            select-playlist-row(index, extend, range) => { root.select-playlist-row(index, extend, range) }
                            reorder-playlist(tokens, index) => { root.reorder-playlist(tokens, index); }
                            playlist-action(action, token) => { root.playlist-action(action, token); }
                        }
                        if pane-kind == 6 : VideoQuickSettingsPage {
                            sidebar-width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8);
                            animations-disabled: root.animations-disabled;
                            compact-ui: root.compact-ui;
                            dark-theme: root.dark-theme;
                            interactive-accent-color: root.interactive-accent-color;
                            loaded: root.loaded;
                            platform-windows: root.platform-windows;
                            reset-speed => { root.reset-speed(); }
                            restore-player-focus => { keys.focus(); }
                            set-hardware-decoding(value) => { root.set-hardware-decoding(value); }
                            set-hdr-enabled(value) => { root.set-hdr-enabled(value); }
                            set-speed-slider(value) => { root.set-speed-slider(value); }
                            set-speed-text(text) => { return root.set-speed-text(text); }
                            set-video-aspect(text) => { root.set-video-aspect(text); }
                            set-video-crop(value) => { root.set-video-crop(value); }
                            set-video-equalizer(band, value) => { root.set-video-equalizer(band, value); }
                            set-video-rotation(value) => { root.set-video-rotation(value); }
                            sidebar-card-material-fill: root.sidebar-card-material-fill;
                            speed-edit-value: root.speed-edit-value;
                            speed-slider-position: root.speed-slider-position;
                            speed-value: root.speed-value;
                            track-selected(kind, token) => { root.select-item(root.selection-for-pane(kind), token); }
                            windows-accent-color: root.windows-accent-color;
                            windows-accent-foreground: root.windows-accent-foreground;
                            windows-sidebar-material-active: root.windows-sidebar-material-active;
                        }
                        if pane-kind == 2 : SubtitleQuickSettingsPage {
                            sidebar-width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8);
                            choose-subtitle-font => { root.choose-subtitle-font(); }
                            compact-ui: root.compact-ui;
                            dark-theme: root.dark-theme;
                            find-online-subtitles => { root.find-online-subtitles(); }
                            interactive-accent-color: root.interactive-accent-color;
                            load-subtitle => { root.browse-files(2); }
                            loaded: root.loaded;
                            platform-windows: root.platform-windows;
                            reset-subtitle-delay => { root.reset-subtitle-delay(); }
                            restore-player-focus => { keys.focus(); }
                            set-delay(lane, seconds) => { root.set-delay(lane, seconds); }
                            set-delay-text(lane, text) => { return root.set-delay-text(lane, text); }
                            set-subtitle-color(component, color) => { root.set-subtitle-color(component, color); }
                            set-subtitle-font-size(value) => { root.set-subtitle-font-size(value); }
                            set-subtitle-outline-size(value) => { root.set-subtitle-outline-size(value); }
                            set-subtitle-position(secondary, position) => { root.set-subtitle-position(secondary, position); }
                            set-subtitle-scale-slider(value) => { root.set-subtitle-scale-slider(value); }
                            sidebar-card-material-fill: root.sidebar-card-material-fill;
                            sidebar-control-material-fill: root.sidebar-control-material-fill;
                            toggle-secondary-subtitle-visibility => { root.toggle-secondary-subtitle-visibility(); }
                            toggle-subtitle-visibility => { root.toggle-subtitle-visibility(); }
                            track-selected(kind, token) => { root.select-item(root.selection-for-pane(kind), token); }
                            windows-accent-color: root.windows-accent-color;
                            windows-accent-foreground: root.windows-accent-foreground;
                            windows-sidebar-material-active: root.windows-sidebar-material-active;
                        }
                    }
                }
                if pane-kind == 4 : HorizontalLayout { spacing: 8px;
                    width: parent.width - (root.compact-ui ? 18px : 24px);
                    Tool { width: 24px; dark-theme: root.dark-theme; accent-color: root.interactive-accent-color;
                        label: loop-label == "File" ? "↻₁" : "↻"; hint: "Cycle repeat: " + loop-label;
                        activated => { root.playlist-action(5, ""); } }
                    Tool { width: 24px; dark-theme: root.dark-theme; accent-color: root.interactive-accent-color;
                        icon: @image-url("../../../assets/icons/shuffle.svg");
                        hint: root.playlist-shuffled ? "Turn off shuffle" : "Shuffle playlist";
                        selected: root.playlist-shuffled; activated => { root.toggle-playlist-shuffle(); } }
                    PlaylistSortButton { dark-theme: root.dark-theme; accent-color: root.interactive-accent-color;
                        sort-requested(index) => { root.sort-playlist(index); } }
                    Rectangle { horizontal-stretch: 1; }
                    Tool { width: 24px; dark-theme: root.dark-theme; accent-color: root.interactive-accent-color;
                        icon: @image-url("../../../assets/icons/add.svg"); hint: "Add files to playlist";
                        activated => { root.browse-files(4); } }
                    Tool { width: 24px; dark-theme: root.dark-theme; accent-color: root.interactive-accent-color;
                        label: "−"; hint: "Remove selected playlist entries"; enabled: root.selected-playlist-token != "";
                        activated => { root.playlist-action(1, root.selected-playlist-token); } }
                    Tool { width: 24px; dark-theme: root.dark-theme; accent-color: root.interactive-accent-color;
                        icon: @image-url("../../../assets/icons/trash.svg"); hint: "Clear playlist except current file";
                        activated => { root.playlist-action(4, ""); } }
                }
            }
        }
        for side in [0, 1] : TouchArea {
            visible: !root.crop-editing && (side == 0 ? root.leading-sidebar != 0 : root.sidebar != 0);
            private property <length> panel-width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8);
            x: side == 0 ? panel-width : root.width - panel-width - 4px;
            y: (root.compact-ui ? 30px : 34px) + (root.osc-position == 1 ? root.osc-height : 0px); width: 4px;
            height: root.menu-content-height - (root.compact-ui ? 60px : 68px) -
                (root.osc-position == 1 ? root.osc-height : root.osc-position == 2 ? root.osc-height / 2 : 0px);
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed {
                    // Recover window-space pointer position from the moving handle.
                    let root-width = root.width;
                    let pointer-x = self.x + self.mouse-x;
                    let requested = (side == 0 ? pointer-x : root-width - pointer-x) / 1px - 2;
                    let bounded = clamp(requested, 300, max(300, min(500, root-width / 1px * 0.8)));
                    if side == 0 { root.leading-sidebar-width = bounded; }
                    else { root.trailing-sidebar-width = bounded; }
                }
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.sidebar-resize-finished();
                }
            }
        }
        if controls-rendered && loaded && !crop-editing : osc-bar := PlayerController {
            geometry: {
                window-width: root.width,
                window-height: root.menu-content-height,
                available-width: parent.width,
                available-height: parent.height,
                video-width: root.video-width,
                video-inset-leading: root.video-inset-leading,
                video-inset-top: root.video-inset-top,
                sidebar-leading-extent: root.sidebar-leading-extent,
                sidebar-trailing-extent: root.sidebar-trailing-extent,
                edge-to-edge-video: root.edge-to-edge-video,
                osc-position: root.osc-position,
                osc-height: root.osc-height,
            };
            layout: {
                osc-row-gap: root.osc-row-gap,
                osc-row-height: root.osc-row-height,
                osc-row-inline-inset: root.osc-row-inline-inset,
                osc-timeline-gap: root.osc-timeline-gap,
                osc-timeline-height: root.osc-timeline-height,
                osc-timeline-inline-inset: root.osc-timeline-inline-inset,
                transport-neighbor-actions-fit: root.transport-neighbor-actions-fit,
                small-video-controller: root.small-video-controller,
                music-mode-time-label-min-width: root.music-mode-time-label-min-width,
            };
            appearance: {
                animations-disabled: root.animations-disabled,
                active-liquid-glass-osc: root.active-liquid-glass-osc,
                dark-theme: root.dark-theme,
                platform-windows: root.platform-windows,
                native-video: root.native-video,
                interactive-accent-color: root.interactive-accent-color,
                compact-ui: root.compact-ui,
            };
            material: {
                video-blurred-frame: root.video-blurred-frame,
                render-width: root.render-width,
                render-height: root.render-height,
                video-material-sample-opacity: root.video-material-sample-opacity,
            };
            audio: {
                has-active-audio-track: PlaybackAudioState.has-active-audio-track,
                muted: root.muted,
                volume: PlaybackAudioState.volume,
                volume-limit: root.volume-limit,
                control-disable-volume-slider-scrolling: root.control-disable-volume-slider-scrolling,
            };
            timeline: {
                seekable: PlaybackTimelineState.seekable,
                position: PlaybackTimelineState.position,
                duration: PlaybackTimelineState.duration,
                position-label: PlaybackTimelineState.position-label,
                duration-label: PlaybackTimelineState.duration-label,
                ab-loop-a: root.ab-loop-a,
                ab-loop-b: root.ab-loop-b,
                ab-loop-a-known: root.ab-loop-a-known,
                ab-loop-b-known: root.ab-loop-b-known,
                chapter-times: root.chapter-times,
                show-chapter-pos: root.show-chapter-pos,
                thumbnail-preview-enabled: root.thumbnail-preview-enabled,
                thumbnail-preview-width: root.thumbnail-preview-width,
                timeline-preview-label: root.timeline-preview-label,
                timeline-thumbnail-image: root.timeline-thumbnail-image,
                video-display-aspect-ratio: root.video-display-aspect-ratio,
                control-disable-play-slider-scrolling: root.control-disable-play-slider-scrolling,
            };
            toolbar: {
                toolbar-visible-order: root.toolbar-visible-order,
                loaded: root.loaded,
                subtitle-tracks: PlaybackSubtitleState.subtitle-tracks,
                screenshot-available: root.screenshot-available,
                live-text-available: root.live-text-available,
                live-text-enabled: root.live-text-enabled,
                picture-in-picture-active: root.picture-in-picture-active,
                fullscreen: root.fullscreen,
                sidebar: root.sidebar,
                leading-sidebar: root.leading-sidebar,
                remembered-settings-pane: root.remembered-settings-pane,
                remembered-playlist-pane: root.remembered-playlist-pane,
            };
            music: {
                music-mode: root.music-mode,
                media-title: root.media-title,
                music-album: root.music-album,
                music-artist: root.music-artist,
            };
            control-bar-dragging <=> root.control-bar-dragging;
            control-bar-hovered <=> root.control-bar-hovered;
            control-bar-position-horizontal <=> root.control-bar-position-horizontal;
            control-bar-position-vertical <=> root.control-bar-position-vertical;
            controls-visible <=> root.controls-visible;
            music-mode-show-album-art <=> root.music-mode-show-album-art;
            music-mode-show-playlist <=> root.music-mode-show-playlist;
            music-mode-volume-open <=> root.music-mode-volume-open;
            paused: root.paused;
            activity => { root.activity(); }
            cycle-subtitle-track => { root.cycle-subtitle-track(); }
            layout-settings-changed => { root.layout-settings-changed(); }
            playlist-next => { root.playlist-next(); }
            playlist-previous => { root.playlist-previous(); }
            seek(value) => { root.seek(value); }
            seek-scroll-action-request(delta-x, delta-y) => { return root.seek-scroll-action-request(delta-x, delta-y); }
            set-ab-loop-point(point, value) => { root.set-ab-loop-point(point, value); }
            set-volume(value) => { root.set-volume(value); }
            speed(value) => { root.speed(value); }
            take-screenshot => { root.take-screenshot(); }
            timeline-hovered(value) => { root.timeline-hovered(value); }
            toggle-fullscreen => { root.toggle-fullscreen(); }
            toggle-live-text => { root.toggle-live-text(); }
            toggle-music-mode => { root.toggle-music-mode(); }
            toggle-mute => { root.toggle-mute(); }
            toggle-pause => { root.toggle-pause(); }
            toggle-picture-in-picture => { root.toggle-picture-in-picture(); }
            toggle-playlist-pane(pane) => { root.toggle-playlist-pane(pane); }
            toggle-plugins-pane => { root.toggle-plugins-pane(); }
            toggle-settings-pane(pane) => { root.toggle-settings-pane(pane); }
            volume-scroll-action-request(delta-x, delta-y) => { return root.volume-scroll-action-request(delta-x, delta-y); }
        }
        if root.music-mode && root.loaded : MusicModeWindowActions {
            x: 8px; y: 6px;
            artwork-visible: root.music-mode-show-album-art;
            dark-theme: root.dark-theme;
            translucent: root.active-liquid-glass-osc;
            accent-color: root.interactive-accent-color;
            opacity: root.controls-visible ? 1 : 0;
            animate opacity { duration: root.animations-disabled ? 0ms : 200ms; }
            close-requested => { root.close-player(); }
            back-requested => { root.toggle-music-mode(); }
        }
        if loaded && !crop-editing : SeekOsd {
            material: root.osd-material;
            progress-color: root.platform-windows ? root.windows-accent-color : Theme.playback-progress-accent;
            osd-enabled: root.osd-enabled;
            osd-text-size: root.osd-text-size;
            osd-fade-duration: root.osd-fade-duration;
        }
        if !PlayerOsdState.plugin-osd-message.is-empty && !crop-editing : PluginOsd {
            x: (parent.width - self.width) / 2;
            y: max(8px,
                parent.height - (root.music-mode && root.music-mode-show-playlist ? 300px : 0px) - 112px);
            width: min(420px, parent.width - 32px);
            material: root.osd-material;
            native-video: root.native-video;
        }
        if status != "" || startup-status != "" : Text { x: 16px; y: parent.height - 27px; width: parent.width - 32px;
            text: startup-status == "" ? status : startup-status;
            color: Theme.player-status-text(root.dark-theme); font-size: 11px; overflow: elide; }
        if music-mode && music-mode-show-playlist : MusicModePlaylist {
            x: 0px; y: parent.height - 300px; width: parent.width; height: 300px;
            dark-theme: root.dark-theme;
            playlist-metadata-visible: root.playlist-metadata-visible;
            playlist: root.playlist;
            selected-playlist-token: root.selected-playlist-token;
            platform-windows: root.platform-windows;
            windows-accent-color: root.windows-accent-color;
            select-row(token) => {
                root.selected-playlist-token = token;
                root.selected-playlist-tokens = [token];
            }
            play-row(token) => {
                root.selected-playlist-token = "";
                root.selected-playlist-tokens = [];
                root.select-item(CatalogSelection.playlist, token);
            }
        }
        if fullscreen && loaded && controls-visible && display-time-and-battery-in-fullscreen && !crop-editing : FullscreenInfoOsd {
            private property <length> card-width: min(340px, parent.width - 16px -
                (root.sidebar != 0 ? min(root.trailing-sidebar-width * 1px, parent.width * 0.8) : 0px));
            x: parent.width - self.card-width -
                (root.sidebar != 0 ? min(root.trailing-sidebar-width * 1px, parent.width * 0.8) : 0px) - 8px;
            y: (root.compact-ui ? 38px : 42px) +
                (root.osc-position == 1 ? root.osc-height : 0px);
            width: self.card-width;
            material: root.osd-material;
            media-title: root.media-title;
        }
        if loaded : PlaybackOsd {
            material: root.osd-material;
            progress-color: root.platform-windows ? root.windows-accent-color : Theme.playback-progress-accent;
            osd-enabled: root.osd-enabled;
            osd-text-size: root.osd-text-size;
            osd-fade-duration: root.osd-fade-duration;
        }
        if loaded && !crop-editing : ScreenshotPreview {
            x: Theme.playback-osd-left; y: Theme.playback-osd-top;
            active: PlayerOsdState.screenshot-preview-visible && root.osd-enabled;
            opacity: PlayerOsdState.screenshot-preview-visible && root.osd-enabled ? 1 : 0;
            animate opacity { duration: root.osd-fade-duration; }
            capture: PlayerOsdState.screenshot-preview-image;
            has-file: PlayerOsdState.screenshot-preview-path != "";
            image-width: PlayerOsdState.screenshot-preview-width * 1px;
            image-height: PlayerOsdState.screenshot-preview-height * 1px;
            delete-capture => { root.screenshot-preview-action(0); }
            edit-capture => { root.screenshot-preview-action(1); }
            reveal-capture => { root.screenshot-preview-action(2); }
        }
        crop-editor := CropEditor {
            width:parent.width; height:parent.height;
            editing:root.crop-editing; ready:root.crop-ready; description:root.crop-description;
            delogo:root.crop-delogo;
            box-x:root.crop-box-x; box-y:root.crop-box-y;
            box-width:root.crop-box-width; box-height:root.crop-box-height;
            preset-index <=> root.crop-preset-index;
            preset(index) => { root.crop-preset(index); }
            finish(confirm) => { root.finish-custom-crop(confirm); }
            begin-drag(kind,x,y) => { root.begin-crop-drag(kind,x,y); }
            move-drag(x,y) => { root.move-crop-drag(x,y); }
            end-drag => { root.end-crop-drag(); }
        }
        entry-dialogs := PlayerEntryDialogs {
            width: parent.width; height: parent.height;
            dark-theme: root.dark-theme;
            jump-time-dialog-visible <=> root.jump-time-dialog-visible;
            jump-time-draft <=> root.jump-time-draft;
            jump-time-error <=> root.jump-time-error;
            url-dialog-visible <=> root.url-dialog-visible;
            url-dialog-draft <=> root.url-dialog-draft;
            jump-to-time(text) => { root.jump-to-time(text); }
            open-url(url) => { root.open-url(url); }
        }
        key-released(event) => {
            if (event.text == Key.Alt || !event.modifiers.alt) && menu-alternates-visible {
                menu-alternates-visible = false;
            }
            if native-video && !crop-editing && event.text == Key.F10 { root.open-application-menu(); return accept; }
            return reject;
        }
        key-pressed(event) => {
            if menu-alternates-visible != event.modifiers.alt {
                menu-alternates-visible = event.modifiers.alt;
            }
            if crop-editing { if event.text == Key.Escape { root.finish-custom-crop(false); } if event.text == Key.Tab { return reject; } return accept; }
            if jump-time-dialog-visible {
                if event.text == Key.Escape { jump-time-dialog-visible = false; jump-time-error = ""; return accept; }
                return accept;
            }
            if url-dialog-visible {
                if event.text == Key.Escape { url-dialog-visible = false; return accept; }
                return accept;
            }
            if native-video && event.text == Key.F10 { return accept; }
            if root.activate-saved-filter-shortcut(event.text, event.modifiers.control,
                    event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                return accept;
            }
            if root.dispatch-key-binding(event.text, event.modifiers.control,
                    event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                return accept;
            }
            root.controls-visible = true; root.activity();
            if (primary-shortcut-is-meta ? event.modifiers.meta : event.modifiers.control) {
                if event.text == "," && !event.modifiers.shift && !event.modifiers.alt {
                    root.open-preferences(); return accept;
                }
                if event.modifiers.shift {
                    if event.modifiers.alt || (primary-shortcut-is-meta && event.modifiers.control) { return reject; }
                    if event.text == "L" { root.toggle-file-loop(); return accept; }
                    if event.text == ">" { root.adjust-chapter(1); return accept; }
                    if event.text == "<" { root.adjust-chapter(-1); return accept; }
                    if event.text == "C" { root.toggle-playlist-pane(3); return accept; }
                    if event.text == "P" { root.toggle-playlist-pane(4); return accept; }
                    if event.text == "A" { root.toggle-settings-pane(1); return accept; }
                    if event.text == "S" { root.take-screenshot(); return accept; }
                    if event.text == "V" { root.toggle-settings-pane(6); return accept; }
                    return reject;
                }
                // Windows/Linux map the extra macOS Control modifier to Alt;
                // primary itself is already Control on those platforms.
                if (primary-shortcut-is-meta ? event.modifiers.control : event.modifiers.alt) {
                    if primary-shortcut-is-meta && event.modifiers.alt { return reject; }
                    if event.text == "a" { root.cycle-audio-track(); return accept; }
                    if event.text == "s" { root.cycle-subtitle-track(); return accept; }
                    if event.text == "v" { root.cycle-video-track(); return accept; }
                    if primary-shortcut-is-meta { return reject; }
                }
                if event.modifiers.alt {
                    if event.text == "[" { root.speed(1 / 1.1); return accept; }
                    if event.text == "]" { root.speed(1.1); return accept; }
                    return reject;
                }
                if event.text == "l" { root.cycle-ab-loop(); return accept; }
                if event.text == "." { root.stop(); return accept; }
                if event.text == Key.RightArrow { root.playlist-next(); return accept; }
                if event.text == Key.LeftArrow { root.playlist-previous(); return accept; }
                if event.text == "o" { root.open-file(); return accept; }
                if event.text == "/" { root.toggle-mute(); return accept; }
                if event.text == "[" { root.speed(0.5); return accept; }
                if event.text == "]" { root.speed(2); return accept; }
                if event.text == "\\" { root.reset-speed(); return accept; }
                return reject;
            }
            if event.modifiers.alt && !event.modifiers.shift {
                if !event.modifiers.control && !event.modifiers.meta && event.text == "v" { root.toggle-secondary-subtitle-visibility(); return accept; }
                if event.text == Key.RightArrow { root.frame-step(); return accept; }
                if event.text == Key.LeftArrow { root.frame-back-step(); return accept; }
                if event.text == Key.UpArrow { root.adjust-volume(1); return accept; }
                if event.text == Key.DownArrow { root.adjust-volume(-1); return accept; }
            }
            if !event.modifiers.control && !event.modifiers.meta {
                if event.modifiers.shift {
                    if event.text == "(" { root.adjust-audio-delay(event.modifiers.alt ? 0.1 : 0.5); return accept; }
                    if event.text == ")" { root.adjust-audio-delay(event.modifiers.alt ? -0.1 : -0.5); return accept; }
                    if event.text == "_" && !event.modifiers.alt { root.reset-audio-delay(); return accept; }
                }
                if event.text == "Z" { root.adjust-subtitle-delay(event.modifiers.alt ? -0.1 : -0.5); return accept; }
                if event.text == "X" { root.adjust-subtitle-delay(event.modifiers.alt ? 0.1 : 0.5); return accept; }
                if event.text == "C" && !event.modifiers.alt { root.reset-subtitle-delay(); return accept; }
            }
            if event.modifiers.shift && !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
                if event.text == Key.PageUp { root.seek-relative(600); return accept; }
                if event.text == Key.PageDown { root.seek-relative(-600); return accept; }
                if event.text == Key.RightArrow { root.subtitle-seek(1); return accept; }
                if event.text == Key.LeftArrow { root.subtitle-seek(-1); return accept; }
            }
            if !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
                if event.text == "G" { root.adjust-subtitle-scale(0.1); return accept; }
                if event.text == "F" { root.adjust-subtitle-scale(-0.1); return accept; }
                if event.text == "R" { root.adjust-subtitle-position(1); return accept; }
            }
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == " " || event.text == "p" { root.toggle-pause(); return accept; }
            if event.text == Key.RightArrow { root.seek-relative(5); return accept; }
            if event.text == Key.LeftArrow { root.seek-relative(-5); return accept; }
            if event.text == Key.UpArrow { root.adjust-volume(5); return accept; }
            if event.text == Key.DownArrow { root.adjust-volume(-5); return accept; }
            if event.text == "m" { root.toggle-mute(); return accept; }
            if event.text == "j" && root.loaded { root.open-jump-time-dialog(); return accept; }
            if event.text == "v" { root.toggle-subtitle-visibility(); return accept; }
            if event.text == "r" { root.adjust-subtitle-position(-1); return accept; }
            if event.text == "t" { root.adjust-subtitle-position(1); return accept; }
            if event.text == "." { root.frame-step(); return accept; }
            if event.text == "," { root.frame-back-step(); return accept; }
            if event.text == "f" { root.toggle-fullscreen(); return accept; }
            if event.text == Key.Return { if !root.fullscreen { root.toggle-fullscreen(); } return accept; }
            if event.text == Key.Escape && root.fullscreen { root.toggle-fullscreen(); return accept; }
            if event.text == Key.Escape && (root.sidebar != 0 || root.leading-sidebar != 0) { root.sidebar = 0; root.leading-sidebar = 0; return accept; }
            return reject;
        }
    }
    // Removing the focused OSC on Stop/auto-hide must leave shortcuts available.
    changed loaded => { root.video-menu-changed(); if !root.loaded { keys.focus(); } root.refresh-fullscreen-info(); }
    changed controls-visible => {
        if root.plugin-ui-disabled && root.controls-visible {
            root.controls-visible = false;
            return;
        }
        // A sidebar stays interactive when only the transport tray disappears.
        // Moving focus here would discard a delay/speed edit after the idle timeout.
        if !root.controls-visible && root.sidebar == 0 && root.leading-sidebar == 0 { keys.focus(); }
        root.refresh-fullscreen-info();
        root.controls-visibility-changed(root.controls-visible);
    }
    changed fullscreen => { root.refresh-fullscreen-info(); root.video-menu-changed(); }
    changed display-time-and-battery-in-fullscreen => { root.refresh-fullscreen-info(); }
    changed dark-theme => { Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    init => { keys.focus(); Palette.color-scheme = root.dark-theme ? ColorScheme.dark : ColorScheme.light; }
}
