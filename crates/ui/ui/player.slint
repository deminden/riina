                                font-size: 12px; wrap: word-wrap; }
                            if root.plugin-sidebar-labels.length == 0 : Text {
                                text: "Enabled plugins with sidebar tabs appear here.";
                                color: root.dark-theme ? #aaaaaa : #66666b;
                                font-size: 11px; wrap: word-wrap; }
                        }
                        if pane-kind == 1 : Rectangle {
                            width: min(
                                (side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px,
                                root.width * 0.8
                            ) - (root.compact-ui ? 28px : 32px);
                            height: 246px + (equalizer-scroll.content-width > equalizer-scroll.visible-width ? 16px : 0px); border-radius: 8px; border-width: 1px;
                            border-color: Theme.sidebar-card-border(root.dark-theme);
                            background: root.sidebar-card-material-fill;
                            VerticalLayout {
                                padding: root.compact-ui ? 10px : 12px;
                                spacing: root.compact-ui ? 8px : 12px;
                            // IINA stacks the heading and a padded, full-width preset picker.
                            HorizontalLayout { height: 18px; spacing: 8px;
                                Image { source: @image-url("../../../assets/icons/equalizer.svg");
                                    image-fit: contain; width: 16px; height: 16px;
                                    colorize: root.dark-theme ? #dddddd : #29292d; }
                                Text { text: "Equalizer"; color: root.dark-theme ? #dddddd : #29292d; font-size: 12px;
                                    font-weight: 700; vertical-alignment: center; }
                            }
                            AudioEqualizerProfilePicker {
                                    width: parent.width - (root.compact-ui ? 20px : 24px);
                                    dark-theme: root.dark-theme;
                                    windows-acrylic-surface: root.windows-sidebar-material-active;
                                    profile-names: root.audio-equalizer-profile-names;
                                    selected-index: root.audio-equalizer-profile-index;
                                    user-profile-start-index: root.audio-equalizer-user-profile-start-index;
                                    can-save: root.audio-equalizer-can-save-profile;
                                    can-edit: root.audio-equalizer-can-edit-profile;
                                    can-delete: root.audio-equalizer-can-delete-profile;
                                    selected(index) => { root.select-audio-equalizer-profile(index); }
                                    validate-name(name, mode) => { root.validate-audio-equalizer-profile-name(name, mode) }
                                    save-requested(name) => { root.save-audio-equalizer-profile(name) }
                                    rename-requested(name) => { root.rename-audio-equalizer-profile(name) }
                                    delete-requested => { root.delete-audio-equalizer-profile(); }
                            }
                            equalizer-scroll := ScrollView {
                                width: parent.width - (root.compact-ui ? 20px : 24px);
                                height: (root.compact-ui ? 142px : 146px)
                                    + (self.content-width > self.visible-width ? 16px : 0px);
                                content-width: max(self.visible-width, 300px);
                                content-height: root.compact-ui ? 142px : 146px;
                                vertical-scrollbar-policy: always-off;
                                horizontal-scrollbar-policy: as-needed;
                                VerticalLayout {
                                    width: equalizer-scroll.content-width; height: root.compact-ui ? 142px : 146px;
                                    spacing: root.compact-ui ? 8px : 12px;
                            HorizontalLayout { height: 120px; spacing: 1px;
                                for label[index] in ["32", "64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"] : VerticalLayout {
                                    width: 24px;
                                    VerticalEqualizerSlider { horizontal-stretch: 1; vertical-stretch: 1;
                                        dark-theme: root.dark-theme; minimum: -12; maximum: 12;
                                        step: 0.1; value: root.audio-equalizer-values[index];
                                        hint: label + " Hz equalizer gain";
                                        changed(value) => { root.set-audio-equalizer(index, value); }
                                    }
                                }
                                Rectangle { width: 48px; height: 120px; background: transparent;
                                    Text { x: 0px; y: -3px; width: parent.width; text: "+12 dB"; height: 14px;
                                        color: root.dark-theme ? #aaaaaa : #66666b;
                                        font-size: 10px; vertical-alignment: center;
                                        horizontal-alignment: right; }
                                    Text { x: 0px; y: 45px; width: parent.width; text: "0 dB"; height: 14px;
                                        color: root.dark-theme ? #aaaaaa : #66666b;
                                        font-size: 10px; vertical-alignment: center;
                                        horizontal-alignment: right; }
                                    Text { x: 0px; y: 93px; width: parent.width; text: "-12 dB"; height: 14px;
                                        color: root.dark-theme ? #aaaaaa : #66666b;
                                        font-size: 10px; vertical-alignment: center;
                                        horizontal-alignment: right; }
                                }
                            }
                            HorizontalLayout { height: 14px; spacing: 1px;
                                for label in ["32", "64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"] : Text {
                                    width: 24px; text: label;
                                    color: root.dark-theme ? #aaaaaa : #66666b;
                                    font-size: 10px; horizontal-alignment: center;
                                }
                                Rectangle { width: 48px; background: transparent; }
                            }
                                }
                            }
                            }
                        }
                        for row[index] in (pane-kind == 3 ? chapters : pane-kind == 4 ? playlist : []): CatalogSidebarRow {
                            width: parent.width;
                            entry: row;
                            index: index;
                            pane-kind: pane-kind;
                            playlist: root.playlist;
                            dark-theme: root.dark-theme;
                            interactive-accent-color: root.interactive-accent-color;
                            playlist-metadata-visible: root.playlist-metadata-visible;
                            select-row(token) => { root.select-item(root.selection-for-pane(pane-kind), token); }
                            select-playlist-row(index, extend, range) => { root.select-playlist-row(index, extend, range) }
                            reorder-playlist(tokens, index) => { root.reorder-playlist(tokens, index); }
                            playlist-action(action, token) => { root.playlist-action(action, token); }
                        }
                        if pane-kind == 6 : VerticalLayout {
                            width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px,
                                root.width * 0.8) - (root.compact-ui ? 28px : 32px);
                            spacing: root.compact-ui ? 16px : 18px;
                            QuickSettingsTrackList {
                                width: parent.width;
                                tracks: root.video-tracks; observed-index: root.video-track-selected-index;
                                track-kind: 6; hint: "Video tracks"; enabled: root.loaded;
                                dark-theme: root.dark-theme;
                                accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                                focus-accent-color: root.interactive-accent-color;
                                card-fill: root.sidebar-card-material-fill;
                                card-edge: root.dark-theme ? #ffffff18 : #00000014;
                                selected(kind, token) => { root.select-item(root.selection-for-pane(kind), token); }
                            }
                        if pane-kind == 6 : VideoControls {
                            width: parent.width;
                            compact-ui: root.compact-ui;
                            animations-disabled: root.animations-disabled;
                            dark-theme: root.dark-theme;
                            windows-acrylic-surface: root.windows-sidebar-material-active;
                            accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                            focus-accent-color: root.interactive-accent-color;
                            accent-foreground: root.windows-accent-foreground;
                            card-fill: root.sidebar-card-material-fill;
                            card-edge: root.dark-theme ? #ffffff18 : #00000014;
                            aspect-presets: root.video-aspect-presets;
                            aspect-index: root.video-aspect-index;
                            rotation-index: root.video-rotation-index;
                            crop-presets: root.video-crop-presets;
                            crop-index: root.video-crop-index;
                            crop-enabled: root.loaded && root.video-crop-known;
                            crop-changed(value) => { root.set-video-crop(value); }
                            aspect-enabled: root.loaded && root.video-aspect-known;
                            rotation-enabled: root.loaded && root.video-rotation-known;
                            aspect-changed(value) => { root.set-video-aspect(value); }
                            rotation-changed(value) => { root.set-video-rotation(value); }
                        }
                        if pane-kind == 6 : Rectangle {
                            // Match IINA's 12/10-point container inset and its
                            // title-to-slider and slider-to-tick-mark spacing.
                            height: root.compact-ui ? 88px : 92px;
                            border-radius: 8px; border-width: 1px;
                            border-color: Theme.sidebar-card-border(root.dark-theme);
                            background: root.sidebar-card-material-fill;
                            VerticalLayout {
                                padding-left: root.compact-ui ? 10px : 12px;
                                padding-right: root.compact-ui ? 10px : 12px;
                                padding-top: root.compact-ui ? 9px : 11px;
                                padding-bottom: root.compact-ui ? 9px : 11px;
                                spacing: 0px;
                                HorizontalLayout { height: 16px; spacing: 8px;
                                    Image { width: 16px; height: 16px;
                                        source: @image-url("../../../assets/icons/playback-speed.svg");
                                        image-fit: contain; colorize: root.dark-theme ? #dddddd : #29292d; }
                                    Text { text: "Speed"; font-size: 12px; font-weight: 700;
                                        color: root.dark-theme ? #dddddd : #29292d;
                                        vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    if root.speed-value != 1 : Tool {
                                        accent-color: root.interactive-accent-color;
                                        dark-theme: root.dark-theme; width: 16px; height: 16px;
                                        icon-size: 14px;
                                        icon: @image-url("../../../assets/icons/reset.svg");
                                        hint: "Reset playback speed";
                                        activated => { root.reset-speed(); }
                                    }
                                }
                                Rectangle { height: 18px; background: transparent; }
                                HorizontalLayout { spacing: 8px; height: 20px;
                                    PlayerSlider { dark-theme: root.dark-theme; height: 20px;
                                        minimum: 0; maximum: 24; step: 1;
                                        value: root.speed-slider-position; hint: "Playback speed";
                                        show-value-label: true;
                                        value-label-above-control: true;
                                        knob-width: 10px; knob-height: 18px; knob-radius: 5px;
                                        value-label: root.speed-edit-value + "x";
                                        enabled: root.loaded;
                                        changed(value) => { root.set-speed-slider(value); }
                                    }
                                    QuickSettingsInput { width: 50px; height: 18px;
                                        accent-color: root.interactive-accent-color;
                                        dark-theme: root.dark-theme;
                                        windows-acrylic-surface: root.windows-sidebar-material-active;
                                        observed-value: root.speed-edit-value;
                                        enabled: root.loaded; hint: "Custom playback speed";
                                        committed(text) => { return root.set-speed-text(text); }
                                        editing-finished => { keys.focus(); }
                                    }
                                }
                                // The source slider's final two points separate
                                // its knob from the 14-point tick-label row.
                                HorizontalLayout { spacing: 8px; height: 14px;
                                    Rectangle { horizontal-stretch: 1; height: 14px;
                                        background: transparent;
                                        Text { text: "0.25x"; x: 0px; width: 35px; height: 14px;
                                            font-size: 10px; vertical-alignment: center;
                                            color: root.dark-theme ? #bbbbbb : #66666b; }
                                        Text { text: "1x"; width: 30px; height: 14px;
                                            x: (parent.width - 10px) / 3 - self.width / 2 + 5px;
                                            font-size: 10px; horizontal-alignment: center;
                                            vertical-alignment: center;
                                            color: root.dark-theme ? #bbbbbb : #66666b; }
                                        Text { text: "4x"; width: 30px; height: 14px;
                                            x: (parent.width - 10px) * 2 / 3 - self.width / 2 + 5px;
                                            font-size: 10px; horizontal-alignment: center;
                                            vertical-alignment: center;
                                            color: root.dark-theme ? #bbbbbb : #66666b; }
                                        Text { text: "16x"; width: 35px; height: 14px;
                                            x: parent.width - self.width; font-size: 10px;
                                            horizontal-alignment: right; vertical-alignment: center;
                                            color: root.dark-theme ? #bbbbbb : #66666b; }
                                    }
                                    Rectangle { width: 50px; background: transparent; }
                                }
                            }
                        }
                        if pane-kind == 6 : Rectangle {
                            // IINA wraps hardware decode and optional HDR in one
                            // card, with the same sidebar spacing as its other rows.
                            height: root.hdr-source-detected && root.hdr-display-active
                                ? (root.compact-ui ? 66px : 74px)
                                : (root.compact-ui ? 40px : 44px);
                            border-radius: 8px; border-width: 1px;
                            border-color: Theme.sidebar-card-border(root.dark-theme);
                            background: root.sidebar-card-material-fill;
                            VerticalLayout {
                                padding: root.compact-ui ? 10px : 12px;
                                spacing: root.compact-ui ? 8px : 12px;
                                HardwareDecodingControls {
                                    dark-theme: root.dark-theme;
                                    windows-acrylic-surface: root.windows-sidebar-material-active;
                                    accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                                    focus-accent-color: root.interactive-accent-color;
                                    hardware-enabled: root.hardware-decoding-enabled;
                                    hardware-known: root.hardware-decoding-known;
                                    hardware-changed(value) => { root.set-hardware-decoding(value); }
                                }
                                if root.hdr-source-detected && root.hdr-display-active : HdrControls {
                                    dark-theme: root.dark-theme;
                                    windows-acrylic-surface: root.windows-sidebar-material-active;
                                    accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                                    focus-accent-color: root.interactive-accent-color;
                                    hdr-enabled: root.hdr-enabled;
                                    hdr-available: true;
                                    hdr-changed(value) => { root.set-hdr-enabled(value); }
                                }
                            }
                        }
                        if pane-kind == 6 : Rectangle {
                            // Match IINA's small slider rows, source-spaced
                            // gaps, card padding, and 2-point inner inset.
                            height: root.compact-ui ? 126px : 146px;
                            border-radius: 8px; border-width: 1px;
                            border-color: Theme.sidebar-card-border(root.dark-theme);
                            background: root.sidebar-card-material-fill;
                            VerticalLayout {
                                padding-left: root.compact-ui ? 11px : 13px;
                                padding-right: root.compact-ui ? 11px : 13px;
                                padding-top: root.compact-ui ? 12px : 14px;
                                padding-bottom: root.compact-ui ? 12px : 14px;
                                spacing: root.compact-ui ? 8px : 12px;
                            for label[index] in ["Brightness", "Contrast", "Saturation", "Gamma", "Hue"] : HorizontalLayout {
                                height: 14px; spacing: 8px;
                                // REF-24 places the first slider 65 pt after
                                // the label origin: a 56 pt label column plus
                                // the source's 8 pt row gap.
                                Text { text: label; width: 56px; font-size: 11px;
                                    color: root.dark-theme ? #dddddd : #29292d;
                                    vertical-alignment: center; }
                                PlayerSlider { dark-theme: root.dark-theme; height: 14px; minimum: -100; maximum: 100; step: 1;
                                    neutral-mark: true;
                                    value: root.video-equalizer-values[index]; hint: label;
                                    enabled: root.video-equalizer-known[index];
                                    changed(value) => { root.set-video-equalizer(index, value); }
                                }
                                Tool { accent-color: root.interactive-accent-color; dark-theme: root.dark-theme; width: 16px; height: 14px; icon-size: 14px;
                                    windows-acrylic-surface: root.windows-sidebar-material-active;
                                    icon: @image-url("../../../assets/icons/reset.svg");
                                    hint: "Reset " + label; enabled: root.video-equalizer-known[index];
                                    activated => { root.set-video-equalizer(index, 0); }
                                }
                            }
                            }
                        }
                        }
                        if pane-kind == 2 : VerticalLayout {
                            width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px,
                                root.width * 0.8) - (root.compact-ui ? 28px : 32px);
                            spacing: root.compact-ui ? 16px : 18px;
                            VerticalLayout { width: parent.width; spacing: root.compact-ui ? 8px : 12px;
                                SubtitleVisibilityRow { label: "Primary"; number: "1";
                                    checked: root.subtitle-visible; enabled: root.loaded;
                                    dark-theme: root.dark-theme;
                                    accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                                    changed(value) => { root.toggle-subtitle-visibility(); } }
                                QuickSettingsTrackList { width: parent.width; tracks: root.subtitle-tracks;
                                    observed-index: root.subtitle-track-selected-index;
                                    hint: "Primary subtitle tracks"; label-prefix: "Primary subtitle: ";
                                    focus-accent-color: root.interactive-accent-color;
                                    track-kind: 2; dark-theme: root.dark-theme; enabled: root.loaded;
                                    accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                                    card-fill: root.sidebar-card-material-fill;
                                    card-edge: root.dark-theme ? #ffffff18 : #00000014;
                                    selected(kind, token) => { root.select-item(root.selection-for-pane(kind), token); } }
                            }
                            VerticalLayout { width: parent.width; spacing: root.compact-ui ? 8px : 12px;
                                SubtitleVisibilityRow { label: "Secondary"; number: "2";
                                    checked: root.secondary-subtitle-visible;
                                    enabled: root.loaded && root.secondary-subtitle-visibility-known;
                                    dark-theme: root.dark-theme;
                                    accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                                    changed(value) => { root.toggle-secondary-subtitle-visibility(); } }
                                QuickSettingsTrackList { width: parent.width;
                                    tracks: root.secondary-subtitle-tracks;
                                    observed-index: root.secondary-subtitle-track-selected-index;
                                    hint: "Secondary subtitle tracks"; label-prefix: "Secondary subtitle: ";
                                    focus-accent-color: root.interactive-accent-color; track-kind: 5;
                                    dark-theme: root.dark-theme; enabled: root.loaded;
                                    accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                                    card-fill: root.sidebar-card-material-fill;
                                    card-edge: root.dark-theme ? #ffffff18 : #00000014;
                                    selected(kind, token) => { root.select-item(root.selection-for-pane(kind), token); } }
                            }
                        if pane-kind == 2 : Rectangle {
                            width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px,
                                root.width * 0.8) - (root.compact-ui ? 30px : 36px);
                            height: 48px; border-radius: 8px; border-width: 1px;
                            border-color: Theme.sidebar-card-border(root.dark-theme);
                            background: root.sidebar-card-material-fill;
                            HorizontalLayout { padding: 8px; spacing: 8px;
                                Rectangle { horizontal-stretch: 1; height: 30px; border-radius: 4px;
                                    background: root.sidebar-control-material-fill;
                                    accessible-role: button; accessible-label: "Load subtitle";
                                    accessible-enabled: root.loaded;
                                    accessible-action-default => { if root.loaded { root.browse-files(2); } }
                                    Text { text: "Load Subtitle…";
                                        color: root.loaded
                                            ? (root.dark-theme ? #eeeeee : #29292d)
                                            : (root.dark-theme ? #777777 : #8a8a90);
                                        font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                    if subtitle-load-focus.has-focus : Rectangle { border-width: 1px;
                                        border-color: root.interactive-accent-color; border-radius: 4px; background: transparent; }
                                    TouchArea { enabled: root.loaded;
                                        clicked => { subtitle-load-focus.focus(); root.browse-files(2); } }
                                    subtitle-load-focus := FocusScope {
                                        enabled: root.loaded;
                                        key-pressed(event) => {
                                            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                            if event.text == Key.Return || event.text == " " { root.browse-files(2); return accept; }
                                            return reject;
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; height: 30px; border-radius: 4px;
                                    background: root.sidebar-control-material-fill;
                                    accessible-role: button; accessible-label: "Search online subtitles";
                                    accessible-enabled: root.loaded;
                                    accessible-action-default => { if root.loaded { root.find-online-subtitles(); } }
                                    Text { text: "Search Online…";
                                        color: root.loaded
                                            ? (root.dark-theme ? #eeeeee : #29292d)
                                            : (root.dark-theme ? #777777 : #8a8a90);
                                        font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                    if online-subtitle-focus.has-focus : Rectangle { border-width: 1px;
                                        border-color: root.interactive-accent-color; border-radius: 4px; background: transparent; }
                                    TouchArea { enabled: root.loaded;
                                        clicked => { online-subtitle-focus.focus(); root.find-online-subtitles(); } }
                                    online-subtitle-focus := FocusScope {
                                        enabled: root.loaded;
                                        key-pressed(event) => {
                                            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                            if event.text == Key.Return || event.text == " " { root.find-online-subtitles(); return accept; }
                                            return reject;
                                        }
                                    }
                                }
                            }
                        }
                        if pane-kind == 2 : Rectangle {
                            width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px,
                                root.width * 0.8) - (root.compact-ui ? 28px : 32px);
                            height: 190px; border-radius: 8px; border-width: 1px;
                            border-color: Theme.sidebar-card-border(root.dark-theme);
                            background: root.sidebar-card-material-fill;
                            VerticalLayout { padding: 8px; spacing: 8px;
                                Rectangle { height: 28px; border-radius: 5px;
                                    background: root.dark-theme ? #ffffff0c : #0000000d;
                                    HorizontalLayout { padding: 2px; spacing: 1px;
                                        SubtitleLaneSegment { focus-accent-color: root.interactive-accent-color; label: "Primary"; hint: "Edit primary subtitle timing and position";
                                            selected: !root.edit-secondary-subtitle;
                                            dark-theme: root.dark-theme;
                                            windows-acrylic-surface: root.windows-sidebar-material-active;
                                            accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                                            accent-foreground: root.windows-accent-foreground;
                                            activated => { root.edit-secondary-subtitle = false; } }
                                        SubtitleLaneSegment { focus-accent-color: root.interactive-accent-color; label: "Secondary"; hint: "Edit secondary subtitle timing and position";
                                            selected: root.edit-secondary-subtitle;
                                            dark-theme: root.dark-theme;
                                            windows-acrylic-surface: root.windows-sidebar-material-active;
                                            accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff;
                                            accent-foreground: root.windows-accent-foreground;
                                            activated => { root.edit-secondary-subtitle = true; } }
                                    }
                                }
                                HorizontalLayout { height: 20px; spacing: 8px;
                                    Image { source: @image-url("../../../assets/icons/resume-history.svg");
                                        width: 14px; height: 14px; colorize: root.dark-theme ? #d0d0d6 : #55555d; }
                                    Text { text: "Delay"; color: root.dark-theme ? #bbbbbb : #66666b;
                                        font-size: 11px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Tool { accent-color: root.interactive-accent-color; dark-theme: root.dark-theme; label: "↺"; hint: "Reset subtitle delay";
                                        enabled: root.loaded && (!root.edit-secondary-subtitle || root.secondary-subtitle-delay-known);
                                        windows-acrylic-surface: root.windows-sidebar-material-active;
                                        activated => {
                                            if root.edit-secondary-subtitle { root.set-delay(DelayLane.secondary-subtitle, 0); }
                                            else { root.reset-subtitle-delay(); }
                                        } }
                                }
                                HorizontalLayout { height: 24px; spacing: 8px;
                                    subtitle-delay-slider := PlayerSlider { dark-theme: root.dark-theme;
                                        minimum: -5; maximum: 5; step: 0.1;
                                        value: root.edit-secondary-subtitle ? root.secondary-subtitle-delay : root.subtitle-delay;
                                        enabled: root.loaded && (!root.edit-secondary-subtitle || root.secondary-subtitle-delay-known);
                                        hint: root.edit-secondary-subtitle ? "Secondary subtitle delay" : "Subtitle delay";
                                        changed(value) => { root.set-delay(root.edit-secondary-subtitle ? DelayLane.secondary-subtitle : DelayLane.primary-subtitle, value); } }
                                    QuickSettingsInput { accent-color: root.interactive-accent-color;
                                        dark-theme: root.dark-theme;
                                        windows-acrylic-surface: root.windows-sidebar-material-active;
                                        observed-value: root.edit-secondary-subtitle
                                            ? root.secondary-subtitle-delay-text : root.subtitle-delay-text;
                                        secondary: root.edit-secondary-subtitle;
                                        enabled: root.loaded && (!root.edit-secondary-subtitle || root.secondary-subtitle-delay-known);
                                        hint: root.edit-secondary-subtitle ? "Secondary subtitle delay in seconds" : "Subtitle delay in seconds";
                                        committed(text) => {
                                            return root.set-delay-text(root.edit-secondary-subtitle ? DelayLane.secondary-subtitle : DelayLane.primary-subtitle, text);
                                        }
                                        editing-finished => { keys.focus(); } }
                                }
