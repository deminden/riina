export component PlayerWindow inherits PlayerMenuWindow {

    callback window-minimized-changed(bool);
    changed minimized => { root.window-minimized-changed(root.minimized); }
    default-font-family: NativeTypography.system-font-family;
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    in property <bool> reflection-known: false;
    in property <bool> deinterlace-known: false;
    in property <bool> deinterlace-enabled: false;
    in property <bool> screenshot-available: false;
    changed screenshot-available => { root.video-menu-changed(); }
    changed deinterlace-known => { root.video-menu-changed(); }
    changed deinterlace-enabled => { root.video-menu-changed(); }
    in-out property <bool> video-osd-request-feedback: false;
    in-out property <bool> scroll-input-suppressed: false;
    private property <bool> layout-scrollbar-visible: false;
    in property <bool> video-mirrored: false;
    in property <bool> video-flipped: false;
    callback video-menu-changed();
    in property <[MenuShortcutRow]> menu-shortcuts: [];
    changed menu-shortcuts => { root.video-menu-changed(); }
    changed key-binding-current-profile => { root.video-menu-changed(); }
    callback window-title-changed(string);
    callback open-application-menu();
    in-out property <int> preferences-target-pane: -1;
    callback plugin-menu-will-open();
    callback native-menu-will-open();
    changed reflection-known => { root.video-menu-changed(); }
    changed video-mirrored => { root.video-menu-changed(); }
    changed video-flipped => { root.video-menu-changed(); }
    callback crop-window-controls-changed();
    changed crop-editing => { root.video-menu-changed(); root.crop-window-controls-changed(); root.refresh-fullscreen-info(); }

    menu-bar-visible: !native-video && !(root.platform-windows && root.music-mode);
    menu-value-menu-shortcuts: root.menu-shortcuts;
    menu-value-always-float-on-top <=> root.always-float-on-top;
    menu-value-audio-delay-text: root.audio-delay-text;
    menu-value-audio-device-menu-rows: root.audio-device-menu-rows;
    menu-value-audio-tracks: PlaybackAudioState.audio-tracks;
    menu-value-chapters: root.chapters;
    menu-value-crop-editing: root.crop-editing;
    menu-value-current-file-manager-name: root.current-file-manager-name;
    menu-value-deinterlace-enabled: root.deinterlace-enabled;
    menu-value-deinterlace-known: root.deinterlace-known;
    menu-value-delete-current-media-available: root.delete-current-media-available;
    menu-value-delogo-active: root.delogo-active;
    menu-value-delogo-enabled: root.delogo-enabled;
    menu-value-downloaded-subtitle-save-available: root.downloaded-subtitle-save-available;
    menu-value-fullscreen: root.fullscreen;
    menu-value-in-process-player-manager: root.in-process-player-manager;
    menu-value-leading-sidebar: root.leading-sidebar;
    menu-value-live-text-available: root.live-text-available;
    menu-value-live-text-enabled: root.live-text-enabled;
    menu-value-loaded: root.loaded;
    menu-value-loop-label: root.loop-label;
    menu-value-menu-alternates-visible: root.menu-alternates-visible;
    menu-value-music-mode: root.music-mode;
    menu-value-muted: root.muted;
    menu-value-open-subtitles-provider-index: root.open-subtitles-provider-index;
    menu-value-paused: root.paused;
    menu-value-picture-in-picture-active: root.picture-in-picture-active;
    menu-value-picture-in-picture-available: root.picture-in-picture-available;
    menu-value-playlist: root.playlist;
    menu-value-plugin-menu-rows: root.plugin-menu-rows;
    menu-value-preferences-target-pane <=> root.preferences-target-pane;
    menu-value-primary-shortcut-is-meta: root.primary-shortcut-is-meta;
    menu-value-recent-open-menu-rows: root.recent-open-menu-rows;
    menu-value-record-recent-files: root.record-recent-files;
    menu-value-reflection-known: root.reflection-known;
    menu-value-reveal-current-media-available: root.reveal-current-media-available;
    menu-value-save-current-playlist-available: root.save-current-playlist-available;
    menu-value-saved-audio-filter-rows: root.saved-audio-filter-rows;
    menu-value-saved-video-filter-rows: root.saved-video-filter-rows;
    menu-value-screenshot-available: root.screenshot-available;
    menu-value-secondary-subtitle-tracks: PlaybackSubtitleState.secondary-subtitle-tracks;
    menu-value-secondary-subtitle-visibility-known: PlaybackSubtitleState.secondary-subtitle-visibility-known;
    menu-value-secondary-subtitle-visible: PlaybackSubtitleState.secondary-subtitle-visible;
    menu-value-settings-at-leading: root.settings-at-leading;
    menu-value-sidebar: root.sidebar;
    menu-value-speed-edit-value: root.speed-edit-value;
    menu-value-subtitle-default-encoding: root.subtitle-default-encoding;
    menu-value-subtitle-delay-text: PlaybackSubtitleState.subtitle-delay-text;
    menu-value-subtitle-encoding-options: PlaybackSubtitleState.subtitle-encoding-options;
    menu-value-subtitle-scale-known: PlaybackSubtitleState.subtitle-scale-known;
    menu-value-subtitle-tracks: PlaybackSubtitleState.subtitle-tracks;
    menu-value-subtitle-visible: PlaybackSubtitleState.subtitle-visible;
    menu-value-unlock-window-aspect-ratio <=> root.unlock-window-aspect-ratio;
    menu-value-video-aspect-known: root.video-aspect-known;
    menu-value-video-aspect-menu-index: root.video-aspect-menu-index;
    menu-value-video-aspect-menu-labels: root.video-aspect-menu-labels;
    menu-value-video-crop-known: root.video-crop-known;
    menu-value-video-crop-menu-index: root.video-crop-menu-index;
    menu-value-video-crop-menu-labels: root.video-crop-menu-labels;
    menu-value-video-flipped: root.video-flipped;
    menu-value-video-mirrored: root.video-mirrored;
    menu-value-video-rotation-index: root.video-rotation-index;
    menu-value-video-rotation-known: root.video-rotation-known;
    menu-value-video-tracks: root.video-tracks;
    menu-value-video-window-height: root.video-window-height;
    menu-value-video-window-width: root.video-window-width;
    menu-value-volume-menu-title: root.volume-menu-title;

    callback activate-plugin-menu-item <=> root.menu-action-activate-plugin-menu-item;
    callback adjust-audio-delay <=> root.menu-action-adjust-audio-delay;
    callback adjust-chapter <=> root.menu-action-adjust-chapter;
    callback adjust-subtitle-delay <=> root.menu-action-adjust-subtitle-delay;
    callback adjust-volume <=> root.menu-action-adjust-volume;
    callback bring-all-to-front <=> root.menu-action-bring-all-to-front;
    callback browse-files <=> root.menu-action-browse-files;
    callback choose-subtitle-font <=> root.menu-action-choose-subtitle-font;
    callback clear-open-recent <=> root.menu-action-clear-open-recent;
    callback close-player <=> root.menu-action-close-player;
    callback cycle-ab-loop <=> root.menu-action-cycle-ab-loop;
    callback cycle-audio-track <=> root.menu-action-cycle-audio-track;
    callback cycle-subtitle-track <=> root.menu-action-cycle-subtitle-track;
    callback cycle-video-track <=> root.menu-action-cycle-video-track;
    callback delete-current-media <=> root.menu-action-delete-current-media;
    callback dump-debug-info <=> root.menu-action-dump-debug-info;
    callback find-online-subtitles <=> root.menu-action-find-online-subtitles;
    callback find-online-subtitles-with-provider <=> root.menu-action-find-online-subtitles-with-provider;
    callback frame-back-step <=> root.menu-action-frame-back-step;
    callback frame-step <=> root.menu-action-frame-step;
    callback hide-riina <=> root.menu-action-hide-riina;
    callback minimize-window <=> root.menu-action-minimize-window;
    callback multiply-subtitle-scale <=> root.menu-action-multiply-subtitle-scale;
    callback open-audio-filters <=> root.menu-action-open-audio-filters;
    callback open-file <=> root.menu-action-open-file;
    callback open-help-link <=> root.menu-action-open-help-link;
    callback open-in-new-window <=> root.menu-action-open-in-new-window;
    callback open-jump-time-dialog <=> root.menu-action-open-jump-time-dialog;
    callback open-preferences <=> root.menu-action-open-preferences;
    callback open-recent-path <=> root.menu-action-open-recent-path;
    callback open-screenshot-folder <=> root.menu-action-open-screenshot-folder;
    callback open-url-dialog <=> root.menu-action-open-url-dialog;
    callback open-video-filters <=> root.menu-action-open-video-filters;
    callback playlist-action <=> root.menu-action-playlist-action;
    callback playlist-next <=> root.menu-action-playlist-next;
    callback playlist-previous <=> root.menu-action-playlist-previous;
    callback quit-riina <=> root.menu-action-quit-riina;
    callback reload-plugins <=> root.menu-action-reload-plugins;
    callback reset-audio-delay <=> root.menu-action-reset-audio-delay;
    callback reset-speed <=> root.menu-action-reset-speed;
    callback reset-subtitle-delay <=> root.menu-action-reset-subtitle-delay;
    callback resize-window-command <=> root.menu-action-resize-window-command;
    callback reveal-current-media <=> root.menu-action-reveal-current-media;
    callback save-current-playlist <=> root.menu-action-save-current-playlist;
    callback save-downloaded-subtitle <=> root.menu-action-save-downloaded-subtitle;
    callback seek <=> root.menu-action-seek;
    callback seek-relative <=> root.menu-action-seek-relative;
    callback select-item <=> root.menu-action-select-item;
    callback set-audio-device <=> root.menu-action-set-audio-device;
    callback set-menu-video-aspect <=> root.menu-action-set-menu-video-aspect;
    callback set-menu-video-crop <=> root.menu-action-set-menu-video-crop;
    callback set-menu-video-rotation <=> root.menu-action-set-menu-video-rotation;
    callback set-subtitle-encoding <=> root.menu-action-set-subtitle-encoding;
    callback set-subtitle-scale-slider <=> root.menu-action-set-subtitle-scale-slider;
    callback show-about <=> root.menu-action-show-about;
    callback show-playback-history <=> root.menu-action-show-playback-history;
    callback speed <=> root.menu-action-speed;
    callback stop <=> root.menu-action-stop;
    callback take-screenshot <=> root.menu-action-take-screenshot;
    callback toggle-deinterlace <=> root.menu-action-toggle-deinterlace;
    callback toggle-delogo <=> root.menu-action-toggle-delogo;
    callback toggle-file-loop <=> root.menu-action-toggle-file-loop;
    callback toggle-fullscreen <=> root.menu-action-toggle-fullscreen;
    callback toggle-live-text <=> root.menu-action-toggle-live-text;
    callback toggle-music-mode <=> root.menu-action-toggle-music-mode;
    callback toggle-mute <=> root.menu-action-toggle-mute;
    callback toggle-pause <=> root.menu-action-toggle-pause;
    callback toggle-picture-in-picture <=> root.menu-action-toggle-picture-in-picture;
    callback toggle-playlist-pane <=> root.menu-action-toggle-playlist-pane;
    callback toggle-plugins-pane <=> root.menu-action-toggle-plugins-pane;
    callback toggle-saved-audio-filter <=> root.menu-action-toggle-saved-audio-filter;
    callback toggle-saved-video-filter <=> root.menu-action-toggle-saved-video-filter;
    callback toggle-secondary-subtitle-visibility <=> root.menu-action-toggle-secondary-subtitle-visibility;
    callback toggle-settings-pane <=> root.menu-action-toggle-settings-pane;
    callback toggle-subtitle-visibility <=> root.menu-action-toggle-subtitle-visibility;
    callback toggle-video-reflection <=> root.menu-action-toggle-video-reflection;
    callback zoom-window <=> root.menu-action-zoom-window;

    in property <string> window-title: "riina";
    title: root.window-title;
    changed window-title => { root.window-title-changed(root.window-title); }
    preferred-width: 960px; preferred-height: 600px;
    min-width: music-mode ? 260px : 285px;
    min-height: music-mode ? 90px : 120px;
    // The native VO lives in the owner window; this surface supplies only chrome.
    // Native mode must begin frameless so Winit creates its transparent surface
    // before the owner window is attached. The shared-GL entry point opts out.
    // Start in overlay mode so the native video window can request a genuinely
    // transparent renderer before Slint discovers the conditional native menu.
    // Shared-window entry points opt into their opaque menu surface before show().
    in property <bool> native-video: true;
    in-out property <bool> system-materials-enabled: true;
    private property <bool> active-liquid-glass-osc:
        liquid-glass-osc && (!platform-windows || system-materials-enabled);
    private property <bool> active-liquid-glass-sidebar:
        liquid-glass-sidebar && (!platform-windows || system-materials-enabled);
    private property <bool> active-liquid-glass-osd:
        liquid-glass-osd && (!platform-windows || system-materials-enabled);
    // Both Windows renderer paths use the calibrated video-backed Acrylic
    // strength; the weaker shared-renderer layer made Windows surfaces opaque.
    private property <float> video-material-sample-opacity: platform-windows || native-video ? 0.58 : 0.32;
    // Match the measured IINA Quick Settings sidebar after accounting for the
    // native Windows tint's own alpha.
    // Keep high-contrast motion from reading as a sharp second image through
    // Windows' video-backed Acrylic approximation; the independent tint still
    // sets the calibrated flat-frame luminance.
    private property <float> sidebar-material-sample-opacity: platform-windows ? 0.8
        : native-video ? 0.53 : 0.32;
    // WinUI's LayerOnAcrylicFillColorDefault is 3.5% white in dark mode and
    // 25% in light mode. Use it only for cards over an active Windows video blur.
    private property <color> sidebar-card-material-fill:
        Theme.sidebar-card-layer(dark-theme, windows-sidebar-material-active);
    private property <bool> windows-sidebar-material-active:
        platform-windows && active-liquid-glass-sidebar;
    private property <color> sidebar-control-material-fill:
        Theme.sidebar-control-layer(dark-theme, windows-sidebar-material-active);
    // IINA keeps selected category tabs neutral; appearance and preset choices
    // retain their blue/accent selection treatment on each platform.
    private property <color> quick-settings-tab-selected-fill:
        Theme.sidebar-category-selection(dark-theme);
    private property <color> quick-settings-tab-selected-foreground:
        Theme.sidebar-category-text(dark-theme);
    in property <bool> native-transition-frame: false;
    in property <bool> show-player-title-row: false;
    in-out property <bool> dialog-open: false;
    in-out property <bool> jump-time-dialog-visible: false;
    in-out property <string> jump-time-draft: "";
    in-out property <string> jump-time-error: "";
    in-out property <bool> url-dialog-visible: false;
    in-out property <string> url-dialog-draft: "";
    changed jump-time-dialog-visible => {
        root.dialog-open = jump-time-dialog-visible || url-dialog-visible;
        if jump-time-dialog-visible { entry-dialogs.focus-jump-time(); }
    }
    changed url-dialog-visible => {
        root.dialog-open = jump-time-dialog-visible || url-dialog-visible;
        if url-dialog-visible { entry-dialogs.focus-url(); }
    }
    in-out property <int> media-request-generation: 0;
    no-frame: native-video;
    // Native output sits behind this window even while loading or between files.
    background: native-video ? transparent : Theme.player-empty-surface;
    in property <image> video-frame;
    in property <image> video-blurred-frame;
    in property <bool> video-material-sample-ready: false;
    in property <bool> loaded: false;
    in-out property <bool> reveal-current-media-available: false;
    in-out property <bool> delete-current-media-available: false;
    in-out property <bool> save-current-playlist-available: false;
    in property <bool> downloaded-subtitle-save-available: false;
    in property <string> current-file-manager-name: "File Manager";
    in property <image> timeline-thumbnail-image;
    in property <string> timeline-preview-label: "";
    in property <float> thumbnail-preview-width: 120;
    callback timeline-hovered(float);
    in property <[PluginMenuRow]> plugin-menu-rows: [];
    in property <[string]> plugin-menu-order: [];
    changed plugin-menu-rows => { root.video-menu-changed(); }
    in-out property <bool> default-hdr-mode-enabled: true;
    in-out property <bool> load-icc-profile: true;
    callback refresh-hdr-output();
    callback reset-hdr-output();
    in-out property <bool> live-text-enabled: false;
    changed live-text-enabled => { root.video-menu-changed(); root.toolbar-settings-changed(); }
    in-out property <bool> live-text-available: false;
    changed live-text-available => { root.video-menu-changed(); root.toolbar-settings-changed(); }
    in property <bool> live-text-selectable: false;
    in-out property <bool> disable-animations: false;
    in property <bool> system-reduce-motion: false;
    in property <bool> platform-macos: false;
    in property <bool> platform-windows: false;
    in-out property <color> windows-accent-color: Theme.windows-default-accent;
    in-out property <color> windows-accent-foreground: Theme.windows-default-accent-text;
    private property <color> interactive-accent-color:
        root.platform-windows ? root.windows-accent-color : Theme.player-focus-accent;
    private property <bool> animations-disabled: root.disable-animations ||
        (root.system-reduce-motion && !root.platform-macos);
    private property <bool> macos-sidebar-reduce-motion-fade:
        root.platform-macos && root.system-reduce-motion && !root.disable-animations;
    in property <duration> osd-fade-duration: animations-disabled || !osd-enabled ? 0ms : Theme.osd-fade-time;
    in property <[LiveTextRegion]> live-text-regions: [];
    callback copy-live-text(string);
    callback set-hdr-enabled(bool);
    in-out property <bool> music-mode: false;
    in-out property <bool> auto-switch-to-music-mode: true;
    in-out property <bool> music-mode-show-playlist: false;
    in-out property <bool> music-mode-show-album-art: true;
    in-out property <float> music-mode-artwork-aspect-ratio: 0;
    in-out property <bool> music-mode-is-audio: false;
    in-out property <bool> music-mode-has-album-art: false;
    in-out property <bool> music-mode-has-visible-subtitles: false;
    private property <bool> music-mode-volume-open: false;
    callback window-will-close();
    in-out property <bool> in-process-player-manager: false;
    callback open-player-requested([string], float);
    callback music-mode-changed();
    callback auto-switch-music-mode-changed(bool);
    changed music-mode => {
        if root.music-mode {
            // IINA's compact audio surface is independent of main-window sidebars.
            root.leading-sidebar = 0;
            root.sidebar = 0;
        }
        if !root.music-mode { root.music-mode-volume-open = false; }
        root.music-mode-changed(); root.video-menu-changed();
    }
    changed auto-switch-to-music-mode => { root.auto-switch-music-mode-changed(root.auto-switch-to-music-mode); }
    out property <bool> observe-automatic-music-mode: root.loaded && root.auto-switch-to-music-mode;
    callback automatic-music-observation-changed(bool);
    changed observe-automatic-music-mode => { root.automatic-music-observation-changed(root.observe-automatic-music-mode); }
    changed music-mode-show-playlist => { if root.music-mode { root.music-mode-changed(); } }
    changed music-mode-show-album-art => { if root.music-mode { root.music-mode-changed(); } }
    changed music-mode-artwork-aspect-ratio => { if root.music-mode { root.music-mode-changed(); } }
    callback renderer-ready();
    changed engine-ready => { if root.engine-ready { root.renderer-ready(); } }
    callback media-opened(string, string);
    in property <bool> crop-editing: false;
    in property <bool> crop-delogo: false;
    in property <bool> delogo-enabled: false;
    in property <bool> delogo-active: false;
    changed delogo-enabled => { root.video-menu-changed(); }
    changed delogo-active => { root.video-menu-changed(); }
    in property <[SavedFilterMenuRow]> saved-video-filter-rows: [];
    changed saved-video-filter-rows => { root.video-menu-changed(); }
    in property <[SavedFilterMenuRow]> saved-audio-filter-rows: [];
    changed saved-audio-filter-rows => { root.video-menu-changed(); }
    in property <bool> crop-ready: false;
    in property <string> crop-description;
    in property <float> crop-box-x;
    in property <float> crop-box-y;
    in property <float> crop-box-width;
    in property <float> crop-box-height;
    in-out property <int> crop-preset-index: -1;
    callback begin-custom-crop();
    callback begin-delogo();
    callback activate-saved-filter-shortcut(string, bool, bool, bool, bool) -> bool;
    callback finish-custom-crop(bool);
    callback crop-preset(int);
    callback begin-crop-drag(int,float,float);
    callback move-crop-drag(float,float);
    callback end-crop-drag();
    callback crop-viewport-changed();
    callback focus-crop-editor();
    focus-crop-editor => { crop-editor.focus-editor(); }
    callback focus-player();
    focus-player => { keys.focus(); }
    in property <bool> paused: true;
    changed paused => { root.video-menu-changed(); }
    in-out property <bool> menu-alternates-visible: false;
    changed menu-alternates-visible => { root.video-menu-changed(); }
    in property <bool> playing: false;
    private property <bool> muted: PlaybackAudioState.muted;
    changed muted => { root.video-menu-changed(); }
    in-out property <bool> fullscreen: false;
    in-out property <bool> picture-in-picture-active: false;
    private property <bool> picture-in-picture-available: loaded && !crop-editing;
    in property <string> media-title: "riina";
    in property <string> music-artist: "";
    in property <string> music-album: "";
