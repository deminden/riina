                            activated => { root.select-playlist-pane(4); } }
                        SidebarTab { min-width: 76px; dark-theme: root.dark-theme; accent-color: root.platform-windows ? root.windows-accent-color : #0a84ff; accent-foreground: root.platform-windows ? root.windows-accent-foreground : #ffffff; focus-accent-color: root.interactive-accent-color; label: "Chapters"; selected: pane-kind == 3;
                            activated => { root.select-playlist-pane(3); } }
