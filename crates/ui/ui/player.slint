export enum PlayerWindowMode { fullscreen, music-mode, picture-in-picture }
export enum PlaybackPowerActivity { idle, audio, video }

export component PlayerWindow inherits PlayerMenuWindow {
    in property <[string]> player-menu-labels;
    out property <bool> compact-menu-visible: root.use-compact-menu;
    callback open-player-menu(int, float, float);
    player-menu-captions: root.player-menu-labels;
    request-player-menu(index, x, y) => { root.open-player-menu(index, x, y); }

    in property <string> plugin-input-bindings: "{}";
    callback plugin-input-bindings-changed(string);

    callback window-minimized-changed(bool);
    changed minimized => { root.window-minimized-changed(root.minimized); }
    default-font-family: NativeTypography.system-font-family;
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    in property <bool> reflection-known: false;
    in property <bool> deinterlace-known: false;
    in property <bool> deinterlace-enabled: false;
    in property <bool> screenshot-available: false;
    changed screenshot-available => { PlayerMenuActions.video-menu-changed(); }
    changed deinterlace-known => { PlayerMenuActions.video-menu-changed(); }
    changed deinterlace-enabled => { PlayerMenuActions.video-menu-changed(); }
    in-out property <bool> video-osd-request-feedback: false;
    in-out property <bool> scroll-input-suppressed: false;
    in property <bool> video-mirrored: false;
    in property <bool> video-flipped: false;
    in property <[MenuShortcutRow]> menu-shortcuts: [];
    changed menu-shortcuts => { PlayerMenuActions.video-menu-changed(); }
    callback window-title-changed(string);
    in-out property <int> preferences-target-pane: -1;
    callback open-plugin-archive(string) -> bool;
    callback plugin-menu-will-open();
    callback plugin-host-wake();
    callback update-plugin-windows();
    callback plugin-subtitle-catalog-changed();
    callback native-menu-will-open();
    changed reflection-known => { PlayerMenuActions.video-menu-changed(); }
    changed video-mirrored => { PlayerMenuActions.video-menu-changed(); }
    changed video-flipped => { PlayerMenuActions.video-menu-changed(); }
    callback crop-window-controls-changed();
    changed crop-editing => {
        PlayerMenuActions.video-menu-changed();
        root.crop-window-controls-changed();
        root.refresh-fullscreen-info();
        if root.crop-editing { PlaylistInteraction.cancel-playlist-drag(); }
    }

    in property <bool> snapshot-menu-shortcuts;
    menu-bar-visible: !native-video && !(PlayerAppearance.platform-windows && PlayerMusicModeState.music-mode);
    menu-value-snapshot-shortcuts: root.snapshot-menu-shortcuts;
    menu-value-menu-shortcuts: root.menu-shortcuts;
    menu-value-crop-editing: PlayerCropState.crop-editing;
    menu-value-current-file-manager-name: root.current-file-manager-name;
    menu-value-deinterlace-enabled: root.deinterlace-enabled;
    menu-value-deinterlace-known: root.deinterlace-known;
    menu-value-delete-current-media-available: root.delete-current-media-available;
    menu-value-delogo-active: root.delogo-active;
    menu-value-delogo-enabled: root.delogo-enabled;
    menu-value-downloaded-subtitle-save-available: root.downloaded-subtitle-save-available;
    menu-value-fullscreen: root.fullscreen;
    menu-value-in-process-player-manager: root.in-process-player-manager;
    menu-value-live-text-available: root.live-text-available;
    menu-value-live-text-enabled: root.live-text-enabled;
    menu-value-loaded: root.loaded;
    menu-value-menu-alternates-visible: root.menu-alternates-visible;
    menu-value-paused: root.paused;
    menu-value-picture-in-picture-active: root.picture-in-picture-active;
    menu-value-picture-in-picture-available: root.picture-in-picture-available;
    menu-value-plugin-menu-rows: root.plugin-menu-rows;
    menu-value-plugin-menu-conflicts: root.plugin-menu-conflicts;
    menu-value-plugin-developer-rows: root.plugin-developer-rows;
    menu-value-preferences-target-pane <=> root.preferences-target-pane;
    menu-value-primary-shortcut-is-meta: root.primary-shortcut-is-meta;
    menu-value-reflection-known: root.reflection-known;
    menu-value-reveal-current-media-available: root.reveal-current-media-available;
    menu-value-save-current-playlist-available: root.save-current-playlist-available;
    menu-value-saved-audio-filter-rows: root.saved-audio-filter-rows;
    menu-value-saved-video-filter-rows: root.saved-video-filter-rows;
    menu-value-screenshot-available: root.screenshot-available;
    menu-value-video-flipped: root.video-flipped;
    menu-value-video-mirrored: root.video-mirrored;
    menu-value-video-window-height: root.video-window-height;
    menu-value-video-window-width: root.video-window-width;

    in property <string> window-title: "riina";
    title: root.window-title;
    changed window-title => { root.window-title-changed(root.window-title); }
    preferred-width: 960px; preferred-height: 600px;
    min-width: music-mode ? 300px : 285px;
    min-height: music-mode ? 90px : 120px;
    // The native VO lives in the owner window; this surface supplies only chrome.
    // Native mode must begin frameless so Winit creates its transparent surface
    // before the owner window is attached. The shared-GL entry point opts out.
    // Start in overlay mode so the native video window can request a genuinely
    // transparent renderer before Slint discovers the conditional native menu.
    // Shared-window entry points opt into their opaque menu surface before show().
    in property <bool> native-video: true;
    in property <bool> show-player-title-row: false;
    in-out property <int> media-request-generation: 0;
    no-frame: native-video;
    // Native output sits behind this window even while loading or between files.
    background: native-video ? transparent : Theme.player-empty-surface;
    in property <bool> loaded: false;
    in-out property <bool> reveal-current-media-available: false;
    in-out property <bool> delete-current-media-available: false;
    in-out property <bool> save-current-playlist-available: false;
    in property <bool> downloaded-subtitle-save-available: false;
    in property <string> current-file-manager-name: "File Manager";
    in property <[PluginMenuRow]> plugin-menu-rows: [];
    in property <int> plugin-menu-conflicts;
    callback profile-has-shortcut(string) -> bool;
    in property <[MenuCatalogRow]> plugin-developer-rows: [];
    changed plugin-developer-rows => { PlayerMenuActions.video-menu-changed(); }
    in property <[string]> plugin-menu-order: [];
    changed plugin-menu-rows => { PlayerMenuActions.video-menu-changed(); }
    callback refresh-hdr-output();
    callback reset-hdr-output();
    in-out property <bool> live-text-enabled: false;
    changed live-text-enabled => { PlayerMenuActions.video-menu-changed(); root.toolbar-settings-changed(); }
    in-out property <bool> live-text-available: false;
    changed live-text-available => { PlayerMenuActions.video-menu-changed(); root.toolbar-settings-changed(); }
    in property <bool> live-text-selectable: false;
    in property <bool> live-text-frame-paused: false;
    out property <bool> observe-live-text: live-text-enabled && live-text-available && loaded && live-text-frame-paused && !crop-editing && !music-mode;
    callback live-text-observation-changed(bool);
    changed observe-live-text => { root.live-text-observation-changed(root.observe-live-text); }
    callback copy-live-text(string);
    private property <bool> music-mode: PlayerMusicModeState.music-mode;
    private property <bool> auto-switch-to-music-mode: PlayerMusicModeState.auto-switch-to-music-mode;
    private property <bool> music-mode-show-playlist: PlayerMusicModeState.music-mode-show-playlist;
    private property <bool> music-mode-show-album-art: PlayerMusicModeState.music-mode-show-album-art;
    private property <float> music-mode-artwork-aspect-ratio: PlayerMusicModeState.music-mode-artwork-aspect-ratio;
    callback window-will-close();
    callback window-mode-confirmed(PlayerWindowMode, bool);
    callback history-player-activated();
    callback inspector-player-activated();
    in-out property <bool> in-process-player-manager: false;
    callback open-player-requested([string], string, float, bool);
    callback music-mode-changed();
    callback music-mode-resize-finished();
    callback auto-switch-music-mode-changed(bool);
    changed music-mode => {
        PlaylistInteraction.cancel-playlist-drag();
        if PlayerMusicModeState.music-mode {
            // IINA's compact audio surface is independent of main-window sidebars.
            keys.focus();
            PlayerSidebarState.leading-sidebar = 0;
            PlayerSidebarState.sidebar = 0;
        }
        if !PlayerMusicModeState.music-mode {
            PlayerMusicModeState.music-mode-volume-open = false;
            PlayerMusicModeState.music-mode-live-catalog-height = -1px;
        }
        root.music-mode-changed(); PlayerMenuActions.video-menu-changed();
    }
    changed auto-switch-to-music-mode => { root.auto-switch-music-mode-changed(PlayerMusicModeState.auto-switch-to-music-mode); }
    out property <bool> observe-automatic-music-mode: root.loaded && PlayerMusicModeState.auto-switch-to-music-mode;
    callback automatic-music-observation-changed(bool);
    changed observe-automatic-music-mode => { root.automatic-music-observation-changed(root.observe-automatic-music-mode); }
    changed music-mode-show-playlist => {
        if PlayerMusicModeState.music-mode {
            if !root.music-mode-show-playlist { PlaylistInteraction.cancel-playlist-drag(); }
            root.music-mode-changed();
        }
    }
    changed music-mode-show-album-art => { if PlayerMusicModeState.music-mode { root.music-mode-changed(); } }
    changed music-mode-artwork-aspect-ratio => { if PlayerMusicModeState.music-mode { root.music-mode-changed(); } }
    callback renderer-ready();
    changed engine-ready => { if root.engine-ready { root.renderer-ready(); } }
    callback media-opened(string, string);
    private property <bool> crop-editing: PlayerCropState.crop-editing;
    in property <bool> delogo-enabled: false;
    in property <bool> delogo-active: false;
    changed delogo-enabled => { PlayerMenuActions.video-menu-changed(); }
    changed delogo-active => { PlayerMenuActions.video-menu-changed(); }
    in property <[SavedFilterMenuRow]> saved-video-filter-rows: [];
    changed saved-video-filter-rows => { PlayerMenuActions.video-menu-changed(); }
    in property <[SavedFilterMenuRow]> saved-audio-filter-rows: [];
    changed saved-audio-filter-rows => { PlayerMenuActions.video-menu-changed(); }
    callback begin-custom-crop();
    callback begin-delogo();
    callback crop-viewport-changed();
    callback focus-crop-editor();
    focus-crop-editor => { crop-editor.focus-editor(); }
    callback focus-player();
    focus-player => { keys.focus(); }
    in property <bool> paused: true;
    changed paused => {
        if root.paused { PlayerControlActions.reset-controller-arrow(); }
        PlayerMenuActions.video-menu-changed();
    }
    in-out property <bool> menu-alternates-visible: false;
    changed menu-alternates-visible => { PlayerMenuActions.video-menu-changed(); }
    in property <bool> playing: false;
    private property <PlaybackPowerActivity> playback-power-activity: !root.playing ? PlaybackPowerActivity.idle
        : ((root.music-mode || PlayerMusicModeState.music-mode-is-audio)
            ? PlaybackPowerActivity.audio : PlaybackPowerActivity.video);
    callback playback-power-changed(PlaybackPowerActivity);
    changed playback-power-activity => { root.playback-power-changed(root.playback-power-activity); }
    in-out property <bool> fullscreen: false;
    in property <bool> entering-fullscreen: false;
    callback native-fullscreen-observed(bool, bool);
    in-out property <bool> picture-in-picture-active: false;
    callback picture-in-picture-monitor-changed(bool);
    changed picture-in-picture-active => { root.picture-in-picture-monitor-changed(root.picture-in-picture-active); }
    out property <bool> observe-pip-owner-minimization: PlayerPreferences.pip-toggle-by-minimizing;
    callback pip-owner-minimization-observation-changed(bool);
    changed observe-pip-owner-minimization => {
        root.pip-owner-minimization-observation-changed(root.observe-pip-owner-minimization);
    }
    private property <bool> picture-in-picture-available: loaded && !crop-editing;
    in property <string> media-title: "riina";
    callback show-screenshot-preview();
    callback screenshot-preview-action(int);
    private property <bool> osd-enabled: PlayerPreferences.osd-enabled;
    callback osd-enabled-changed(bool);
    changed osd-enabled => { root.osd-enabled-changed(PlayerPreferences.osd-enabled); }
    private property <bool> display-time-and-battery-in-fullscreen: PlayerPreferences.display-time-and-battery-in-fullscreen;
    callback pause-when-open-changed(bool);
    callback resume-last-position-changed(bool);
    callback record-playback-history-changed(bool);
    callback remember-recent-path(string);
    in property <bool> primary-shortcut-is-meta: false;
    in property <string> status: "Open a file to begin";
    in property <string> startup-status;
    private property <bool> open-subtitles-auto-search: loaded && PlayerPreferences.open-subtitles-auto-search;
    callback open-subtitles-auto-search-changed(bool);
    changed open-subtitles-auto-search => { root.open-subtitles-auto-search-changed(root.open-subtitles-auto-search); }
    out property <bool> show-playlist-metadata: PlayerPreferences.playlist-show-metadata && (!PlayerPreferences.playlist-show-metadata-in-music-mode || music-mode);
    out property <bool> prefetch-playlist-durations: PlayerPreferences.prefetch-playlist-video-duration
        && (music-mode ? PlayerSidebarState.visible-catalog-pane == 4
            : PlayerSidebarState.sidebar == 4 || PlayerSidebarState.leading-sidebar == 4);
    callback refresh-playlist-metadata();
    changed show-playlist-metadata => { root.refresh-playlist-metadata(); }
    changed prefetch-playlist-durations => { root.refresh-playlist-metadata(); }
    out property <bool> native-video-material-visible: PlayerAppearance.native-video-material-visible(native-video, loaded, fullscreen);
    callback native-video-material-visibility-changed(bool);
    changed native-video-material-visible => { root.native-video-material-visibility-changed(root.native-video-material-visible); }
    private property <float> volume-limit: PlayerPreferences.volume-boost ? 200 : 100;
    in property <bool> engine-ready: false;
    private property <int> sidebar: PlayerSidebarState.sidebar;
    private property <int> leading-sidebar: PlayerSidebarState.leading-sidebar;
    private property <bool> settings-at-leading: PlayerSidebarState.settings-at-leading;
    private property <float> leading-sidebar-width: PlayerSidebarState.leading-sidebar-width;
    private property <float> trailing-sidebar-width: PlayerSidebarState.trailing-sidebar-width;
    private property <bool> always-float-on-top: PlayerLayoutState.always-float-on-top;
    in-out property <float> video-window-width: 0;
    in-out property <float> video-window-height: 0;
    in-out property <int> video-window-rotation: 0;
    in-out property <int> window-size-adjusted-event: 0;
    changed always-float-on-top => { root.window-level-changed(); PlayerMenuActions.video-menu-changed(); }
    private property <bool> edge-to-edge-video: PlayerLayoutState.edge-to-edge-video;
    private property <bool> docked-controls: PlayerLayoutState.docked-controls;
    private property <bool> unlock-window-aspect-ratio: PlayerLayoutState.unlock-window-aspect-ratio;
    in property <float> video-display-aspect-ratio: 0;
    callback layout-settings-changed();
    callback window-aspect-changed();
    callback window-level-changed();
    callback window-level-toggle-requested(bool);
    callback resize-window-for-media();
    callback initial-media-loaded();
    callback fit-window-to-video();
    callback sidebar-resize-finished();
    private property <bool> controls-visible: PlayerControlsState.controls-visible;
    callback toolbar-settings-changed();
    callback controls-visibility-changed(bool);
    out property <length> window-width: viewport.window-width;
    out property <length> window-height: viewport.window-height;
    out property <length> video-origin-x: viewport.video-origin-x;
    out property <length> video-origin-y: viewport.video-origin-y;
    out property <length> video-width: viewport.video-width;
    out property <length> video-height: viewport.video-height;
    out property <length> plugin-sidebar-view-x: viewport.plugin-sidebar-view-x;
    out property <length> plugin-sidebar-view-y: viewport.plugin-sidebar-view-y;
    out property <length> plugin-sidebar-view-width: viewport.plugin-sidebar-view-width;
    out property <length> plugin-sidebar-view-height: viewport.plugin-sidebar-view-height;
    out property <length> render-width: viewport.render-width;
    out property <length> render-height: viewport.render-height;

    viewport := PlayerGeometry {
        visible: false;
        width: root.width;
        height: root.menu-content-height;
        compact-ui: PlayerAppearance.compact-ui;
        platform-macos: PlayerAppearance.platform-macos;
        macos-sidebar-reduce-motion-fade: PlayerAppearance.macos-sidebar-reduce-motion-fade;
        show-player-title-row: root.show-player-title-row;
        native-video: root.native-video;
    }
    changed video-width => { root.crop-viewport-changed(); }
    changed video-height => { root.crop-viewport-changed(); }
    changed edge-to-edge-video => { root.crop-viewport-changed(); root.window-aspect-changed(); }
    changed unlock-window-aspect-ratio => { root.window-aspect-changed(); PlayerMenuActions.video-menu-changed(); }
    changed video-display-aspect-ratio => {
        root.window-aspect-changed();
    }
    changed docked-controls => { root.crop-viewport-changed(); }
    changed sidebar => {
        PlayerSidebarState.layout-scrollbar-visible = false;
        root.crop-viewport-changed();
        PlayerMenuActions.video-menu-changed();
    }
    changed leading-sidebar => {
        PlayerSidebarState.layout-scrollbar-visible = false;
        root.crop-viewport-changed();
        PlayerMenuActions.video-menu-changed();
    }
    changed settings-at-leading => { PlayerMenuActions.video-menu-changed(); }
    changed leading-sidebar-width => { root.crop-viewport-changed(); }
    changed trailing-sidebar-width => { root.crop-viewport-changed(); }
    callback open-recent(int);
    callback recent-files-visibility-changed();
    callback subtitle-font-selected(string);
    callback dismiss-font-picker();
    callback refresh-fullscreen-info();

    // Keys bubble from focused controls through this scope, including sliders.
    // A sibling key scope would lose fullscreen/escape after toolbar navigation.
    keys := PlayerKeyScope {
        menu-alternates-visible <=> root.menu-alternates-visible;
        native-video: root.native-video;
        primary-shortcut-is-meta: root.primary-shortcut-is-meta;
        loaded: root.loaded;
        fullscreen: root.fullscreen || root.entering-fullscreen;
        width: root.width;
        height: root.menu-content-height;
        VideoSurface {
            width: parent.width; height: parent.height;
            native-video: root.native-video;
            video-inset-leading: viewport.video-inset-leading;
            video-inset-top: viewport.video-inset-top;
            video-inset-trailing: viewport.video-inset-trailing;
            video-inset-bottom: viewport.video-inset-bottom;
            render-width: root.render-width;
            render-height: root.render-height;
            video-width: root.video-width;
            video-height: root.video-height;
            live-text-enabled: root.live-text-enabled;
            paused: root.paused;
            live-text-selectable: root.live-text-selectable;
            copy-live-text(text) => { root.copy-live-text(text); }
        }
        PlayerVideoInput { restore-player-focus => { keys.focus(); } }

        if root.show-player-title-row && PlayerControlsState.controls-rendered && loaded && !crop-editing && !music-mode : PlayerTitleBar {
            clip: true;
            x: viewport.macos-sidebar-leading-inset;
            width: max(0px, parent.width - viewport.macos-sidebar-leading-inset - viewport.macos-sidebar-trailing-inset);
            animate x { duration: PlayerAppearance.animations-disabled ? 0ms : 240ms; }
            animate width { duration: PlayerAppearance.animations-disabled ? 0ms : 240ms; }
            y: 0; height: PlayerAppearance.compact-ui ? 30px : 34px;
            opacity: PlayerControlsState.controls-visible ? 1 : 0;
            animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : 250ms; }
            native-video: root.native-video;
            video-inset-leading: viewport.video-inset-leading;
            video-inset-top: viewport.video-inset-top;
            render-width: root.render-width;
            render-height: root.render-height;
            engine-ready: root.engine-ready;
            media-title: root.media-title;
            hover-changed(hovered) => { PlayerControlsState.title-bar-hovered = hovered; }
            open-file => { PlayerMenuActions.open-file(); }
            window-level-toggle-requested(value) => {
                PlayerLayoutState.always-float-on-top = value;
                root.window-level-toggle-requested(value);
            }
            toggle-settings-pane(pane) => { PlayerMenuActions.toggle-settings-pane(pane); }
            toggle-playlist-pane(pane) => { PlayerMenuActions.toggle-playlist-pane(pane); }
            toggle-fullscreen => { PlayerMenuActions.toggle-fullscreen(); }
        }
        if (!controls-visible || !loaded) && !crop-editing && !fullscreen &&
            (PlayerLayoutState.always-float-on-top || PlayerLayoutState.always-show-on-top-icon) : TopmostPin {
            x: parent.width - 36px;
            y: 2px;
            dark-theme: PlayerAppearance.dark-theme;
            pinned: PlayerLayoutState.always-float-on-top;
            changed(value) => {
                PlayerLayoutState.always-float-on-top = value;
                root.window-level-toggle-requested(value);
            }
        }
        for side in [0, 1] : sidebar-frame := PlayerSidebarFrame {
            // Each side owns its selected pane; catalog callbacks retain their original kind.
            private property <int> pane-kind: side == 0 ? PlayerSidebarState.leading-sidebar : PlayerSidebarState.sidebar;
            private property <bool> quick-settings-pane: PlayerSidebarState.is-quick-settings(pane-kind);
            leading: side == 0;
            viewport-width: parent.width;
            sidebar-open: pane-kind != 0 && !root.music-mode && !PlayerCropState.crop-editing;
            reduce-motion-fade: PlayerAppearance.macos-sidebar-reduce-motion-fade;
            y: viewport.title-row-height + (PlayerLayoutState.osc-position == 1 ? viewport.osc-height : 0px);
            width: min((side == 0 ? PlayerSidebarState.leading-sidebar-width : PlayerSidebarState.trailing-sidebar-width) * 1px, parent.width * 0.8);
            height: parent.height - (root.show-player-title-row ? (PlayerAppearance.compact-ui ? 60px : 68px) : 0px) -
                (PlayerLayoutState.osc-position == 1 ? viewport.osc-height : PlayerLayoutState.osc-position == 2 ? viewport.osc-height / 2 : 0px);
            native-video: root.native-video;
            render-height: root.render-height;
            render-width: root.render-width;
            video-inset-leading: viewport.video-inset-leading;
            video-inset-top: viewport.video-inset-top;
            scroll-memory := SidebarScrollMemory {}
            sidebar-content := PlayerSidebarContent {
                width: parent.width; height: parent.height;
                pane-kind: sidebar-frame.pane-kind;
                quick-settings-pane: quick-settings-pane;
                leading: side == 0;
                expanded-tab-labels: sidebar-frame.expanded-tab-labels;
                fullscreen: root.fullscreen;
                loaded: root.loaded;
                close-pane => {
                    // Retire focus before hiding a pane so later shortcuts reach the player.
                    keys.focus();
                    if side == 0 { PlayerSidebarState.leading-sidebar = 0; } else { PlayerSidebarState.sidebar = 0; }
                }
                fit-window-to-video => { root.fit-window-to-video(); }
                layout-settings-changed => { root.layout-settings-changed(); }
                if pane-kind != 5 && (pane-kind != 7 || !PlayerPluginSidebarState.composited) : scroll-page := QuickSettingsScrollPage {
                    page-kind: pane-kind;
                    playlist-drop-enabled: pane-kind == 4 && sidebar-frame.sidebar-open && !root.music-mode;
                    changed drop-viewport => {
                        if side == 0 { PlayerSidebarState.leading-list-drop-viewport = self.drop-viewport; }
                        else { PlayerSidebarState.trailing-list-drop-viewport = self.drop-viewport; }
                    }
                    audio-y: scroll-memory.audio-y;
                    video-y: scroll-memory.video-y;
                    subtitles-y: scroll-memory.subtitles-y;
                    playlist-y: PlayerSidebarState.playlist-scroll-y;
                    chapters-y: PlayerSidebarState.chapters-scroll-y;
                    position-changed(kind, offset) => {
                        if kind == 1 { scroll-memory.audio-y = offset; }
                        else if kind == 6 { scroll-memory.video-y = offset; }
                        else if kind == 2 { scroll-memory.subtitles-y = offset; }
                        else if kind == 4 { PlayerSidebarState.save-playlist-scroll(offset); }
                        else if kind == 3 { PlayerSidebarState.chapters-scroll-y = offset; }
                    }
                    width: parent.width - (quick-settings-pane
                        ? 20px : (PlayerAppearance.compact-ui ? 18px : 24px));
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, sidebar-page.preferred-height);
                    // IINA's sidebar scroll indicators hide at rest. Keep the
                    // content scrollable without a persistent Windows gutter.
                    vertical-scrollbar-policy: always-off;
                    sidebar-page := PlayerSidebarPage {
                        width: parent.width;
                        pane-kind: pane-kind;
                        quick-settings-pane: quick-settings-pane;
                        sidebar-width: min((side == 0 ? PlayerSidebarState.leading-sidebar-width : PlayerSidebarState.trailing-sidebar-width) * 1px, root.width * 0.8);
                        loaded: root.loaded;
                        viewport-height: scroll-page.visible-height;
                        focus-entered(top, height) => { scroll-page.reveal-control(top, height); }
                        restore-player-focus => { keys.focus(); }
                    }
                    if pane-kind == 4 : PlaylistBlankMenuArea {
                        origin: PlaylistMenuOrigin.sidebar;
                        accent: PlayerAppearance.interactive-accent-color;
                        y: sidebar-page.preferred-height;
                        width: parent.width;
                        height: max(0px, parent.height - self.y);
                    }
                }
            }
        }
        for side in [0, 1] : TouchArea {
            visible: !PlayerCropState.crop-editing && (side == 0 ? PlayerSidebarState.leading-sidebar != 0 : PlayerSidebarState.sidebar != 0);
            private property <length> panel-width: min((side == 0 ? PlayerSidebarState.leading-sidebar-width : PlayerSidebarState.trailing-sidebar-width) * 1px, root.width * 0.8);
            x: side == 0 ? panel-width : root.width - panel-width - 4px;
            y: (PlayerAppearance.compact-ui ? 30px : 34px) + (PlayerLayoutState.osc-position == 1 ? viewport.osc-height : 0px); width: 4px;
            height: root.menu-content-height - (PlayerAppearance.compact-ui ? 60px : 68px) -
                (PlayerLayoutState.osc-position == 1 ? viewport.osc-height : PlayerLayoutState.osc-position == 2 ? viewport.osc-height / 2 : 0px);
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed {
                    // Recover window-space pointer position from the moving handle.
                    let root-width = root.width;
                    let pointer-x = self.x + self.mouse-x;
                    let requested = (side == 0 ? pointer-x : root-width - pointer-x) / 1px - 2;
                    let bounded = clamp(requested, 300, max(300, min(500, root-width / 1px * 0.8)));
                    if side == 0 { PlayerSidebarState.leading-sidebar-width = bounded; }
                    else { PlayerSidebarState.trailing-sidebar-width = bounded; }
                }
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.sidebar-resize-finished();
                }
            }
        }
        if PlayerControlsState.controls-rendered && loaded && !crop-editing : osc-bar := PlayerController {
            geometry: {
                window-width: root.width,
                window-height: root.menu-content-height,
                available-width: parent.width,
                available-height: parent.height,
                video-width: root.video-width,
                video-inset-leading: viewport.video-inset-leading,
                video-inset-top: viewport.video-inset-top,
                sidebar-leading-extent: viewport.sidebar-leading-extent,
                sidebar-trailing-extent: viewport.sidebar-trailing-extent,
                osc-height: viewport.osc-height,
            };
            layout: {
                osc-row-gap: viewport.osc-row-gap,
                osc-row-height: viewport.osc-row-height,
                osc-row-inline-inset: viewport.osc-row-inline-inset,
                osc-timeline-gap: viewport.osc-timeline-gap,
                osc-timeline-height: viewport.osc-timeline-height,
                osc-timeline-inline-inset: viewport.osc-timeline-inline-inset,
                transport-neighbor-actions-fit: viewport.transport-neighbor-actions-fit,
                small-video-controller: viewport.small-video-controller,
                music-mode-time-label-min-width: viewport.music-mode-time-label-min-width,
            };
            native-video: root.native-video;
            material: {
                video-blurred-frame: PlayerRenderedVideo.video-blurred-frame,
                render-width: root.render-width,
                render-height: root.render-height,
                video-material-sample-opacity: PlayerAppearance.video-material-sample-opacity(root.native-video),
            };
            audio: {
                volume-limit: root.volume-limit,
                control-disable-volume-slider-scrolling: PlayerPreferences.control-disable-volume-slider-scrolling,
            };
            video-display-aspect-ratio: root.video-display-aspect-ratio;
            toolbar: {
                loaded: root.loaded,
                screenshot-available: root.screenshot-available,
                live-text-available: root.live-text-available,
                live-text-enabled: root.live-text-enabled,
                picture-in-picture-active: root.picture-in-picture-active,
                fullscreen: root.fullscreen,
                sidebar: PlayerSidebarState.sidebar,
                leading-sidebar: PlayerSidebarState.leading-sidebar,
                remembered-settings-pane: PlayerSidebarState.remembered-settings-pane,
                remembered-playlist-pane: PlayerSidebarState.remembered-playlist-pane,
            };
            media-title: root.media-title;
            paused: root.paused;
            layout-settings-changed => { root.layout-settings-changed(); }
        }
        if PlayerMusicModeState.music-mode && root.loaded : MusicModeWindowActions {
            x: 8px; y: 6px;
            artwork-visible: PlayerMusicModeState.music-mode-show-album-art;
            dark-theme: PlayerAppearance.dark-theme;
            translucent: PlayerAppearance.active-liquid-glass-osc;
            accent-color: PlayerAppearance.interactive-accent-color;
            opacity: PlayerControlsState.controls-visible ? 1 : 0;
            animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : 200ms; }
            close-requested => { PlayerMenuActions.close-player(); }
            back-requested => { PlayerMenuActions.toggle-music-mode(); }
        }
        PlayerFeedbackLayer {
            width: parent.width; height: parent.height;
            loaded: root.loaded;
            native-video: root.native-video;
            fullscreen: root.fullscreen;
            status: root.status;
            startup-status: root.startup-status;
            osc-height: viewport.osc-height;
            media-title: root.media-title;
            video-inset-leading: viewport.video-inset-leading;
            video-inset-top: viewport.video-inset-top;
            render-width: root.render-width;
            render-height: root.render-height;
            screenshot-preview-action(action) => { root.screenshot-preview-action(action); }
            if music-mode && PlayerMusicModeState.displayed-catalog-height > 0px : MusicModeCatalog {
                x: 0px; y: parent.height - self.height; width: parent.width;
                height: PlayerMusicModeState.displayed-catalog-height;
                clip: true;
                play-row(token) => {
                    PlaylistInteraction.clear-selection();
                    PlayerMenuActions.select-item(CatalogSelection.playlist, token);
                }
            }
        }
        crop-editor := CropEditor { width: parent.width; height: parent.height; }
        PlayerEntryDialogs { width: parent.width; height: parent.height; }
        playlist-popup := PlaylistPluginPopup {
            width: parent.width; height: parent.height;
            restore-player-focus => { keys.focus(); }
        }
        FocusScope {
            visible: PlayerDialogState.plugin-interaction-visible;
            width: parent.width; height: parent.height;
            changed visible => { if self.visible { self.focus(); } else { keys.focus(); } }
            key-pressed(_) => { return accept; }
            key-released(_) => { return accept; }
            TouchArea {
                width: parent.width; height: parent.height;
                scroll-event(_) => { return accept; }
            }
        }
    }
    public pure function playlist-popup-bounds() -> PlaylistPopupBounds {
        return { x: playlist-popup.absolute-position.x / 1px, y: playlist-popup.absolute-position.y / 1px,
            width: playlist-popup.width / 1px, height: playlist-popup.height / 1px };
    }
    changed width => {
        if PlaylistPluginPopupState.shown { PlaylistPluginPopupState.input(PlaylistPopupInput.dismiss, 0, 0, 0); }
    }
    changed height => {
        if PlaylistPluginPopupState.shown { PlaylistPluginPopupState.input(PlaylistPopupInput.dismiss, 0, 0, 0); }
    }
    // Removing the focused OSC on Stop/auto-hide must leave shortcuts available.
    changed loaded => {
        if PlaylistPluginPopupState.shown && PlaylistPluginPopupState.player-menu {
            PlaylistPluginPopupState.input(PlaylistPopupInput.dismiss, 0, 0, 0);
        }
        PlayerMenuActions.video-menu-changed();
        if !root.loaded {
            PlayerControlActions.reset-controller-arrow();
            PlayerSidebarActions.dismiss-native-subtitle-color();
            keys.focus();
        }
        root.refresh-fullscreen-info();
    }
    changed controls-visible => {
        if !root.controls-visible { PlayerControlActions.controller-arrow(false, ControllerArrowPhase.cancelled); }
        if PlayerControlsState.plugin-ui-disabled && PlayerControlsState.controls-visible {
            PlayerControlsState.controls-visible = false;
            return;
        }
        // A sidebar stays interactive when only the transport tray disappears.
        // Moving focus here would discard a delay/speed edit after the idle timeout.
        if !PlaylistPluginPopupState.shown && !PlayerControlsState.controls-visible &&
            PlayerSidebarState.sidebar == 0 && PlayerSidebarState.leading-sidebar == 0 { keys.focus(); }
        root.refresh-fullscreen-info();
        root.controls-visibility-changed(PlayerControlsState.controls-visible);
    }
    in property <bool> escape-exits-fullscreen: false;
    private property <int> touch-bar-time-precision: PlayerPreferences.control-time-precision;
    private property <bool> touch-bar-scale-remaining-time: PlayerPreferences.control-scale-remaining-time;
    callback touch-bar-presentation-changed();
    changed escape-exits-fullscreen => { root.touch-bar-presentation-changed(); }
    changed touch-bar-time-precision => { root.touch-bar-presentation-changed(); }
    changed touch-bar-scale-remaining-time => { root.touch-bar-presentation-changed(); }
    changed fullscreen => {
        root.refresh-fullscreen-info();
        PlayerMenuActions.video-menu-changed();
        root.touch-bar-presentation-changed();
    }
    changed display-time-and-battery-in-fullscreen => { root.refresh-fullscreen-info(); }
    private property <bool> dark-theme: PlayerAppearance.dark-theme;
    changed dark-theme => { Palette.color-scheme = PlayerAppearance.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    init => { keys.focus(); Palette.color-scheme = PlayerAppearance.dark-theme ? ColorScheme.dark : ColorScheme.light; }
}
