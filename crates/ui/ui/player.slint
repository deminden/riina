                                root.width * 0.8) - (root.compact-ui ? 28px : 32px);
                            height: 92px; border-radius: 8px; border-width: 1px;
                            border-color: Theme.sidebar-card-border(root.dark-theme);
                            background: root.sidebar-card-material-fill;
                            VerticalLayout { padding: 8px; spacing: 4px;
                            HorizontalLayout { height: 24px; spacing: 8px;
                                Image { source: @image-url("../../../assets/icons/delay.svg");
                                    image-fit: contain; width: 16px; height: 16px;
                                    colorize: root.dark-theme ? #dddddd : #29292d; }
                                Text { text: "Delay"; color: root.dark-theme ? #dddddd : #29292d;
                                    font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Tool { accent-color: root.interactive-accent-color; dark-theme: root.dark-theme; label: "↺"; hint: "Reset audio delay";
