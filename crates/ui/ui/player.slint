    out property <length> plugin-sidebar-view-y: viewport.plugin-sidebar-view-y;
    out property <length> plugin-sidebar-view-width: viewport.plugin-sidebar-view-width;
    out property <length> plugin-sidebar-view-height: viewport.plugin-sidebar-view-height;
    out property <length> render-width: viewport.render-width;
    out property <length> render-height: viewport.render-height;

    viewport := PlayerGeometry {
        visible: false;
        width: root.width;
        height: root.menu-content-height;
        music-mode: root.music-mode;
        compact-ui: PlayerAppearance.compact-ui;
        leading-sidebar: root.leading-sidebar;
        sidebar: root.sidebar;
        leading-sidebar-width: root.leading-sidebar-width;
        trailing-sidebar-width: root.trailing-sidebar-width;
        platform-macos: PlayerAppearance.platform-macos;
        macos-sidebar-reduce-motion-fade: PlayerAppearance.macos-sidebar-reduce-motion-fade;
        osc-position: root.osc-position;
        edge-to-edge-video: root.edge-to-edge-video;
        show-player-title-row: root.show-player-title-row;
        docked-controls: root.docked-controls;
        music-mode-show-playlist: root.music-mode-show-playlist;
        crop-editing: root.crop-editing;
        native-video: root.native-video;
        crop-picture-width: root.crop-picture-width;
        crop-picture-height: root.crop-picture-height;
    }
    changed video-width => { root.crop-viewport-changed(); }
    changed video-height => { root.crop-viewport-changed(); }
    changed edge-to-edge-video => { root.crop-viewport-changed(); root.window-aspect-changed(); }
    changed unlock-window-aspect-ratio => { root.window-aspect-changed(); root.video-menu-changed(); }
    changed video-display-aspect-ratio => {
        root.window-aspect-changed();
    }
    changed docked-controls => { root.crop-viewport-changed(); }
    changed sidebar => {
        root.layout-scrollbar-visible = false;
        root.crop-viewport-changed();
        root.video-menu-changed();
    }
    changed leading-sidebar => {
        root.layout-scrollbar-visible = false;
        root.crop-viewport-changed();
        root.video-menu-changed();
    }
    changed settings-at-leading => { root.video-menu-changed(); }
    changed leading-sidebar-width => { root.crop-viewport-changed(); }
    changed trailing-sidebar-width => { root.crop-viewport-changed(); }
    callback open-url(string);
    callback open-recent(int);
    callback set-paused(bool);
    callback execute-mpv-input-action(string);
    callback jump-to-time(string);
    callback set-volume(float);
    callback subtitle-seek(int);
    callback adjust-subtitle-scale(float);
    callback subtitle-font-selected(string);
    callback dismiss-font-picker();
    callback adjust-subtitle-position(float);
    callback activity();
    callback single-click-action(int);
    callback double-click-action(int);
    callback mouse-button-action(int);
    callback scroll-action-request(float, float) -> bool;
    callback seek-scroll-action-request(float, float) -> bool;
    callback volume-scroll-action-request(float, float) -> bool;
    callback refresh-fullscreen-info();
    callback show-seek-osd();
    callback show-video-osd();
    callback set-ab-loop-point(int, float);

    callback toggle-playlist-shuffle();
    callback sort-playlist(int);

    // Keys bubble from focused controls through this scope, including sliders.
    // A sibling key scope would lose fullscreen/escape after toolbar navigation.
    keys := PlayerKeyScope {
        menu-alternates-visible <=> root.menu-alternates-visible;
        native-video: root.native-video;
        crop-editing: root.crop-editing;
        jump-time-dialog-visible <=> root.jump-time-dialog-visible;
        jump-time-error <=> root.jump-time-error;
        url-dialog-visible <=> root.url-dialog-visible;
        controls-visible <=> root.controls-visible;
        primary-shortcut-is-meta: root.primary-shortcut-is-meta;
        loaded: root.loaded;
        fullscreen: root.fullscreen;
        sidebar <=> root.sidebar;
        leading-sidebar <=> root.leading-sidebar;
        activate-saved-filter-shortcut(value1, value2, value3, value4, value5) => { return root.activate-saved-filter-shortcut(value1, value2, value3, value4, value5); }
        activity => { root.activity(); }
        adjust-subtitle-position(value1) => { root.adjust-subtitle-position(value1); }
        adjust-subtitle-scale(value1) => { root.adjust-subtitle-scale(value1); }
        dispatch-key-binding(value1, value2, value3, value4, value5) => { return root.dispatch-key-binding(value1, value2, value3, value4, value5); }
        finish-custom-crop(value1) => { root.finish-custom-crop(value1); }
        open-application-menu => { root.open-application-menu(); }
        subtitle-seek(value1) => { root.subtitle-seek(value1); }
        width: root.width;
        height: root.menu-content-height;
        VideoSurface {
            width: parent.width; height: parent.height;
            crop-editing: root.crop-editing;
            native-video: root.native-video;
            video-inset-leading: viewport.video-inset-leading;
            video-inset-top: viewport.video-inset-top;
            video-inset-trailing: viewport.video-inset-trailing;
            video-inset-bottom: viewport.video-inset-bottom;
            crop-picture-x: root.crop-picture-x;
            crop-picture-y: root.crop-picture-y;
            render-width: root.render-width;
            render-height: root.render-height;
            video-width: root.video-width;
            video-height: root.video-height;
            music-mode: root.music-mode;
            music-mode-show-album-art: root.music-mode-show-album-art;
            music-mode-is-audio: root.music-mode-is-audio;
            music-mode-has-album-art: root.music-mode-has-album-art;
            music-mode-has-visible-subtitles: root.music-mode-has-visible-subtitles;
            live-text-enabled: root.live-text-enabled;
            paused: root.paused;
            live-text-selectable: root.live-text-selectable;
            edge-to-edge-video: root.edge-to-edge-video;
            copy-live-text(text) => { root.copy-live-text(text); }
        }
        TouchArea { moved => { root.controls-visible = true; root.activity(); }
            clicked => {
                root.activity();
                root.single-click-action(PlayerPreferences.control-single-click-index);
                if root.sidebar != 0 || root.leading-sidebar != 0 {
                    keys.focus(); root.sidebar = 0; root.leading-sidebar = 0;
                }
            }
            double-clicked => { root.double-click-action(PlayerPreferences.control-double-click-index); }
            pointer-event(event) => {
                if event.kind == PointerEventKind.up {
                    if event.button == PointerEventButton.right {
                        root.activity(); root.mouse-button-action(PlayerPreferences.control-right-click-index);
                    } else if event.button == PointerEventButton.middle {
                        root.activity(); root.mouse-button-action(PlayerPreferences.control-middle-click-index);
                    }
                }
            }
            scroll-event(event) => {
                if root.scroll-action-request(event.delta-x / 1px, event.delta-y / 1px) {
                    return accept;
                }
                return reject;
            }
        }

        if root.show-player-title-row && controls-rendered && loaded && !crop-editing && !music-mode : PlayerTitleBar {
            clip: true;
            x: viewport.macos-sidebar-leading-inset;
            width: max(0px, parent.width - viewport.macos-sidebar-leading-inset - viewport.macos-sidebar-trailing-inset);
            animate x { duration: PlayerAppearance.animations-disabled ? 0ms : 240ms; }
            animate width { duration: PlayerAppearance.animations-disabled ? 0ms : 240ms; }
            y: 0; height: PlayerAppearance.compact-ui ? 30px : 34px;
            opacity: root.controls-visible ? 1 : 0;
            animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : 250ms; }
            native-video: root.native-video;
            video-inset-leading: viewport.video-inset-leading;
            video-inset-top: viewport.video-inset-top;
            render-width: root.render-width;
            render-height: root.render-height;
            engine-ready: root.engine-ready;
            media-title: root.media-title;
            always-float-on-top: root.always-float-on-top;
            always-show-on-top-icon: root.always-show-on-top-icon;
            hover-changed(hovered) => { root.title-bar-hovered = hovered; }
            open-file => { PlayerMenuActions.open-file(); }
            window-level-toggle-requested(value) => {
                root.always-float-on-top = value;
                root.window-level-toggle-requested(value);
            }
            toggle-settings-pane(pane) => { PlayerMenuActions.toggle-settings-pane(pane); }
            toggle-playlist-pane(pane) => { PlayerMenuActions.toggle-playlist-pane(pane); }
            toggle-fullscreen => { PlayerMenuActions.toggle-fullscreen(); }
        }
        if (!controls-visible || !loaded) && !crop-editing && !fullscreen &&
            (root.always-float-on-top || root.always-show-on-top-icon) : TopmostPin {
            x: parent.width - 36px;
            y: 2px;
            dark-theme: PlayerAppearance.dark-theme;
            pinned: root.always-float-on-top;
            changed(value) => {
                root.always-float-on-top = value;
                root.window-level-toggle-requested(value);
            }
        }
        for side in [0, 1] : sidebar-frame := PlayerSidebarFrame {
            // Each side owns its selected pane; catalog callbacks retain their original kind.
            private property <int> pane-kind: side == 0 ? root.leading-sidebar : root.sidebar;
            private property <bool> quick-settings-pane:
                pane-kind == 1 || pane-kind == 2 || pane-kind == 5 || pane-kind == 6;
            leading: side == 0;
            viewport-width: parent.width;
            sidebar-open: pane-kind != 0 && !root.crop-editing;
            reduce-motion-fade: PlayerAppearance.macos-sidebar-reduce-motion-fade;
            y: viewport.title-row-height + (root.osc-position == 1 ? viewport.osc-height : 0px);
            width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, parent.width * 0.8);
            height: parent.height - (root.show-player-title-row ? (PlayerAppearance.compact-ui ? 60px : 68px) : 0px) -
                (root.osc-position == 1 ? viewport.osc-height : root.osc-position == 2 ? viewport.osc-height / 2 : 0px);
            native-video: root.native-video;
            render-height: root.render-height;
            render-width: root.render-width;
            video-inset-leading: viewport.video-inset-leading;
            video-inset-top: viewport.video-inset-top;
            activity => { root.activity(); }
            scroll-memory := SidebarScrollMemory {}
            sidebar-content := VerticalLayout {
                // IINA's tab row uses 10-point side margins; card widths are
                // explicit, so this does not change their measured insets.
                padding-left: quick-settings-pane ? 10px : (PlayerAppearance.compact-ui ? 9px : 12px);
                padding-right: quick-settings-pane ? 10px : (PlayerAppearance.compact-ui ? 9px : 12px);
                padding-top: PlayerAppearance.compact-ui ? 9px : 12px;
                padding-bottom: PlayerAppearance.compact-ui ? 9px : 12px;
                width: parent.width;
                spacing: PlayerAppearance.compact-ui ? 6px : 8px;
                cross-axis-alignment: pane-kind == 1 ? center : start;
                PlayerSidebarTabs {
                    width: parent.width - 2px * (quick-settings-pane ? 10 : PlayerAppearance.compact-ui ? 9 : 12);
                    leading: side == 0;
                    pane-kind: sidebar-frame.pane-kind;
                    expanded-tab-labels: sidebar-frame.expanded-tab-labels;
                    plugin-sidebar-identifiers: root.plugin-sidebar-identifiers;
                    plugin-sidebar-labels: root.plugin-sidebar-labels;
                    plugin-sidebar-selected-index: root.plugin-sidebar-selected-index;
                    close-pane => {
                        // Retire focus before hiding a pane so later shortcuts reach the player.
                        keys.focus();
                        if side == 0 { root.leading-sidebar = 0; } else { root.sidebar = 0; }
                    }
                    select-settings-pane(pane) => { root.select-settings-pane(pane); }
                    select-playlist-pane(pane) => { root.select-playlist-pane(pane); }
                    select-plugin-sidebar-tab(id) => { root.select-plugin-sidebar-tab(id); }
                }
                if pane-kind == 5 : layout-scroll := LayoutSidebarPage {
                    width: parent.width - 20px;
                    appearance-mode <=> PlayerAppearance.appearance-mode;
                    compact-ui <=> PlayerAppearance.compact-ui;
                    dark-theme: PlayerAppearance.dark-theme;
                    docked-controls <=> root.docked-controls;
                    edge-to-edge-video <=> root.edge-to-edge-video;
                    fit-window-to-video => { root.fit-window-to-video(); }
                    fullscreen: root.fullscreen;
                    interactive-accent-color: PlayerAppearance.interactive-accent-color;
                    layout-scrollbar-visible <=> root.layout-scrollbar-visible;
                    layout-settings-changed => { root.layout-settings-changed(); }
                    liquid-glass-osc <=> PlayerAppearance.liquid-glass-osc;
                    liquid-glass-osd <=> PlayerAppearance.liquid-glass-osd;
                    liquid-glass-sidebar <=> PlayerAppearance.liquid-glass-sidebar;
                    loaded: root.loaded;
                    osc-position <=> root.osc-position;
                    platform-windows: PlayerAppearance.platform-windows;
                    playlist-at-leading <=> root.playlist-at-leading;
                    plugins-at-leading <=> root.plugins-at-leading;
                    settings-at-leading <=> root.settings-at-leading;
                    sidebar-card-material-fill: PlayerAppearance.sidebar-card-material-fill;
                    surface-material-title: PlayerAppearance.surface-material-title;
                    unlock-window-aspect-ratio <=> root.unlock-window-aspect-ratio;
                    windows-accent-color: PlayerAppearance.windows-accent-color;
                    windows-accent-foreground: PlayerAppearance.windows-accent-foreground;
                    windows-sidebar-material-active: PlayerAppearance.windows-sidebar-material-active;
                }
                if pane-kind != 5 : QuickSettingsScrollPage {
                    page-kind: pane-kind;
                    audio-y: scroll-memory.audio-y;
                    video-y: scroll-memory.video-y;
                    subtitles-y: scroll-memory.subtitles-y;
                    playlist-y: scroll-memory.playlist-y;
                    chapters-y: scroll-memory.chapters-y;
                    position-changed(kind, offset) => {
                        if kind == 1 { scroll-memory.audio-y = offset; }
                        else if kind == 6 { scroll-memory.video-y = offset; }
                        else if kind == 2 { scroll-memory.subtitles-y = offset; }
                        else if kind == 4 { scroll-memory.playlist-y = offset; }
                        else if kind == 3 { scroll-memory.chapters-y = offset; }
                    }
                    width: parent.width - (quick-settings-pane
                        ? 20px : (PlayerAppearance.compact-ui ? 18px : 24px));
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, sidebar-page.preferred-height);
                    // IINA's sidebar scroll indicators hide at rest. Keep the
                    // content scrollable without a persistent Windows gutter.
                    vertical-scrollbar-policy: always-off;
                    sidebar-page := PlayerSidebarPage {
                        width: parent.width;
                        pane-kind: pane-kind;
                        quick-settings-pane: quick-settings-pane;
                        sidebar-width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8);
                        loaded: root.loaded;
                        plugin-sidebar-selected-identifier: root.plugin-sidebar-selected-identifier;
                        plugin-sidebar-labels: root.plugin-sidebar-labels;
                        playlist-metadata-visible: root.playlist-metadata-visible;
                        chapters: root.chapters;
                        playlist: root.playlist;
                        speed-edit-value: root.speed-edit-value;
                        speed-slider-position: root.speed-slider-position;
                        speed-value: root.speed-value;
                        restore-player-focus => { keys.focus(); }
                    }
                }
                if pane-kind == 4 : HorizontalLayout { spacing: 8px;
                    width: parent.width - (PlayerAppearance.compact-ui ? 18px : 24px);
                    Tool { width: 24px; dark-theme: PlayerAppearance.dark-theme; accent-color: PlayerAppearance.interactive-accent-color;
                        label: loop-label == "File" ? "↻₁" : "↻"; hint: "Cycle repeat: " + loop-label;
                        activated => { PlayerMenuActions.playlist-action(5, ""); } }
                    Tool { width: 24px; dark-theme: PlayerAppearance.dark-theme; accent-color: PlayerAppearance.interactive-accent-color;
                        icon: @image-url("../../../assets/icons/shuffle.svg");
                        hint: root.playlist-shuffled ? "Turn off shuffle" : "Shuffle playlist";
                        selected: root.playlist-shuffled; activated => { root.toggle-playlist-shuffle(); } }
                    PlaylistSortButton { dark-theme: PlayerAppearance.dark-theme; accent-color: PlayerAppearance.interactive-accent-color;
                        sort-requested(index) => { root.sort-playlist(index); } }
                    Rectangle { horizontal-stretch: 1; }
                    Tool { width: 24px; dark-theme: PlayerAppearance.dark-theme; accent-color: PlayerAppearance.interactive-accent-color;
                        icon: @image-url("../../../assets/icons/add.svg"); hint: "Add files to playlist";
                        activated => { PlayerMenuActions.browse-files(4); } }
                    Tool { width: 24px; dark-theme: PlayerAppearance.dark-theme; accent-color: PlayerAppearance.interactive-accent-color;
                        label: "−"; hint: "Remove selected playlist entries"; enabled: root.selected-playlist-token != "";
                        activated => { PlayerMenuActions.playlist-action(1, root.selected-playlist-token); } }
                    Tool { width: 24px; dark-theme: PlayerAppearance.dark-theme; accent-color: PlayerAppearance.interactive-accent-color;
                        icon: @image-url("../../../assets/icons/trash.svg"); hint: "Clear playlist except current file";
                        activated => { PlayerMenuActions.playlist-action(4, ""); } }
                }
            }
        }
        for side in [0, 1] : TouchArea {
            visible: !root.crop-editing && (side == 0 ? root.leading-sidebar != 0 : root.sidebar != 0);
            private property <length> panel-width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8);
            x: side == 0 ? panel-width : root.width - panel-width - 4px;
            y: (PlayerAppearance.compact-ui ? 30px : 34px) + (root.osc-position == 1 ? viewport.osc-height : 0px); width: 4px;
            height: root.menu-content-height - (PlayerAppearance.compact-ui ? 60px : 68px) -
                (root.osc-position == 1 ? viewport.osc-height : root.osc-position == 2 ? viewport.osc-height / 2 : 0px);
            mouse-cursor: ew-resize;
            moved => {
                if self.pressed {
                    // Recover window-space pointer position from the moving handle.
                    let root-width = root.width;
                    let pointer-x = self.x + self.mouse-x;
                    let requested = (side == 0 ? pointer-x : root-width - pointer-x) / 1px - 2;
                    let bounded = clamp(requested, 300, max(300, min(500, root-width / 1px * 0.8)));
                    if side == 0 { root.leading-sidebar-width = bounded; }
                    else { root.trailing-sidebar-width = bounded; }
                }
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.sidebar-resize-finished();
                }
            }
        }
        if controls-rendered && loaded && !crop-editing : osc-bar := PlayerController {
            geometry: {
                window-width: root.width,
                window-height: root.menu-content-height,
                available-width: parent.width,
                available-height: parent.height,
                video-width: root.video-width,
                video-inset-leading: viewport.video-inset-leading,
                video-inset-top: viewport.video-inset-top,
                sidebar-leading-extent: viewport.sidebar-leading-extent,
                sidebar-trailing-extent: viewport.sidebar-trailing-extent,
                edge-to-edge-video: root.edge-to-edge-video,
                osc-position: root.osc-position,
                osc-height: viewport.osc-height,
            };
            layout: {
                osc-row-gap: viewport.osc-row-gap,
                osc-row-height: viewport.osc-row-height,
                osc-row-inline-inset: viewport.osc-row-inline-inset,
                osc-timeline-gap: viewport.osc-timeline-gap,
                osc-timeline-height: viewport.osc-timeline-height,
                osc-timeline-inline-inset: viewport.osc-timeline-inline-inset,
                transport-neighbor-actions-fit: viewport.transport-neighbor-actions-fit,
                small-video-controller: viewport.small-video-controller,
                music-mode-time-label-min-width: viewport.music-mode-time-label-min-width,
            };
            native-video: root.native-video;
            material: {
                video-blurred-frame: PlayerRenderedVideo.video-blurred-frame,
                render-width: root.render-width,
                render-height: root.render-height,
                video-material-sample-opacity: PlayerAppearance.video-material-sample-opacity(root.native-video),
            };
            audio: {
                volume-limit: root.volume-limit,
                control-disable-volume-slider-scrolling: PlayerPreferences.control-disable-volume-slider-scrolling,
            };
            timeline: {
                ab-loop-a: root.ab-loop-a,
                ab-loop-b: root.ab-loop-b,
                ab-loop-a-known: root.ab-loop-a-known,
                ab-loop-b-known: root.ab-loop-b-known,
                chapter-times: root.chapter-times,
                show-chapter-pos: PlayerPreferences.show-chapter-pos,
                thumbnail-preview-enabled: PlayerPreferences.thumbnail-preview-enabled,
                thumbnail-preview-width: root.thumbnail-preview-width,
                timeline-preview-label: root.timeline-preview-label,
                timeline-thumbnail-image: root.timeline-thumbnail-image,
                video-display-aspect-ratio: root.video-display-aspect-ratio,
                control-disable-play-slider-scrolling: PlayerPreferences.control-disable-play-slider-scrolling,
            };
            toolbar: {
                toolbar-visible-order: root.toolbar-visible-order,
                loaded: root.loaded,
                screenshot-available: root.screenshot-available,
                live-text-available: root.live-text-available,
                live-text-enabled: root.live-text-enabled,
                picture-in-picture-active: root.picture-in-picture-active,
                fullscreen: root.fullscreen,
                sidebar: root.sidebar,
                leading-sidebar: root.leading-sidebar,
                remembered-settings-pane: root.remembered-settings-pane,
                remembered-playlist-pane: root.remembered-playlist-pane,
            };
            music: {
                music-mode: root.music-mode,
                media-title: root.media-title,
                music-album: root.music-album,
                music-artist: root.music-artist,
            };
            control-bar-dragging <=> root.control-bar-dragging;
            control-bar-hovered <=> root.control-bar-hovered;
            control-bar-position-horizontal <=> root.control-bar-position-horizontal;
            control-bar-position-vertical <=> root.control-bar-position-vertical;
            controls-visible <=> root.controls-visible;
            music-mode-show-album-art <=> root.music-mode-show-album-art;
            music-mode-show-playlist <=> root.music-mode-show-playlist;
            music-mode-volume-open <=> root.music-mode-volume-open;
            paused: root.paused;
            activity => { root.activity(); }
            layout-settings-changed => { root.layout-settings-changed(); }
            seek-scroll-action-request(delta-x, delta-y) => { return root.seek-scroll-action-request(delta-x, delta-y); }
            set-ab-loop-point(point, value) => { root.set-ab-loop-point(point, value); }
            set-volume(value) => { root.set-volume(value); }
            timeline-hovered(value) => { root.timeline-hovered(value); }
            volume-scroll-action-request(delta-x, delta-y) => { return root.volume-scroll-action-request(delta-x, delta-y); }
        }
        if root.music-mode && root.loaded : MusicModeWindowActions {
            x: 8px; y: 6px;
            artwork-visible: root.music-mode-show-album-art;
            dark-theme: PlayerAppearance.dark-theme;
            translucent: PlayerAppearance.active-liquid-glass-osc;
            accent-color: PlayerAppearance.interactive-accent-color;
            opacity: root.controls-visible ? 1 : 0;
            animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : 200ms; }
            close-requested => { PlayerMenuActions.close-player(); }
            back-requested => { PlayerMenuActions.toggle-music-mode(); }
        }
        PlayerFeedbackLayer {
            width: parent.width; height: parent.height;
            loaded: root.loaded;
            crop-editing: root.crop-editing;
            native-video: root.native-video;
            controls-visible: root.controls-visible;
            fullscreen: root.fullscreen;
            music-mode: root.music-mode;
            music-mode-show-playlist: root.music-mode-show-playlist;
            status: root.status;
            startup-status: root.startup-status;
            sidebar: root.sidebar;
            trailing-sidebar-width: root.trailing-sidebar-width;
            osc-position: root.osc-position;
            osc-height: viewport.osc-height;
            media-title: root.media-title;
            video-inset-leading: viewport.video-inset-leading;
            video-inset-top: viewport.video-inset-top;
            render-width: root.render-width;
            render-height: root.render-height;
            screenshot-preview-action(action) => { root.screenshot-preview-action(action); }
            if music-mode && music-mode-show-playlist : MusicModePlaylist {
                x: 0px; y: parent.height - 300px; width: parent.width; height: 300px;
                dark-theme: PlayerAppearance.dark-theme;
                playlist-metadata-visible: root.playlist-metadata-visible;
                playlist: root.playlist;
                selected-playlist-token: root.selected-playlist-token;
                platform-windows: PlayerAppearance.platform-windows;
                windows-accent-color: PlayerAppearance.windows-accent-color;
                select-row(token) => {
                    root.selected-playlist-token = token;
                    root.selected-playlist-tokens = [token];
                }
                play-row(token) => {
                    root.selected-playlist-token = "";
                    root.selected-playlist-tokens = [];
                    PlayerMenuActions.select-item(CatalogSelection.playlist, token);
                }
            }
        }
        crop-editor := CropEditor {
            width:parent.width; height:parent.height;
            editing:root.crop-editing; ready:root.crop-ready; description:root.crop-description;
            delogo:root.crop-delogo;
            box-x:root.crop-box-x; box-y:root.crop-box-y;
            box-width:root.crop-box-width; box-height:root.crop-box-height;
            preset-index <=> root.crop-preset-index;
            preset(index) => { root.crop-preset(index); }
            finish(confirm) => { root.finish-custom-crop(confirm); }
            begin-drag(kind,x,y) => { root.begin-crop-drag(kind,x,y); }
            move-drag(x,y) => { root.move-crop-drag(x,y); }
            end-drag => { root.end-crop-drag(); }
        }
        entry-dialogs := PlayerEntryDialogs {
            width: parent.width; height: parent.height;
            dark-theme: PlayerAppearance.dark-theme;
            jump-time-dialog-visible <=> root.jump-time-dialog-visible;
            jump-time-draft <=> root.jump-time-draft;
            jump-time-error <=> root.jump-time-error;
            url-dialog-visible <=> root.url-dialog-visible;
            url-dialog-draft <=> root.url-dialog-draft;
            jump-to-time(text) => { root.jump-to-time(text); }
            open-url(url) => { root.open-url(url); }
        }
    }
    // Removing the focused OSC on Stop/auto-hide must leave shortcuts available.
    changed loaded => { root.video-menu-changed(); if !root.loaded { keys.focus(); } root.refresh-fullscreen-info(); }
    changed controls-visible => {
        if root.plugin-ui-disabled && root.controls-visible {
            root.controls-visible = false;
            return;
        }
        // A sidebar stays interactive when only the transport tray disappears.
        // Moving focus here would discard a delay/speed edit after the idle timeout.
        if !root.controls-visible && root.sidebar == 0 && root.leading-sidebar == 0 { keys.focus(); }
        root.refresh-fullscreen-info();
        root.controls-visibility-changed(root.controls-visible);
    }
    changed fullscreen => { root.refresh-fullscreen-info(); root.video-menu-changed(); }
    changed display-time-and-battery-in-fullscreen => { root.refresh-fullscreen-info(); }
    private property <bool> dark-theme: PlayerAppearance.dark-theme;
    changed dark-theme => { Palette.color-scheme = PlayerAppearance.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    init => { keys.focus(); Palette.color-scheme = PlayerAppearance.dark-theme ? ColorScheme.dark : ColorScheme.light; }
}
