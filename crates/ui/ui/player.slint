                                    editing-finished => { keys.focus(); } }
                            }
                            HorizontalLayout { height: 12px; spacing: 8px;
                                HorizontalLayout { horizontal-stretch: 1;
                                    Text { width: 32px; text: "-5s"; color: root.dark-theme ? #aaaaaa : #66666b; font-size: 10px; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { width: 32px; text: "0s"; color: root.dark-theme ? #aaaaaa : #66666b; font-size: 10px; horizontal-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { width: 32px; text: "+5s"; color: root.dark-theme ? #aaaaaa : #66666b; font-size: 10px; horizontal-alignment: right; }
