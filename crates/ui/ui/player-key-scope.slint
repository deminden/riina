import { PlayerDialogState } from "player-dialog-state.slint";
import { PlayerControlActions } from "player-control-actions.slint";
import { PlayerCropState } from "player-crop-state.slint";
import { PlayerControlsState } from "player-controls-state.slint";
import { PlayerSidebarState } from "player-sidebar-state.slint";
import { PlayerMenuActions } from "player-menu-actions.slint";
import { PlayerPreferences } from "player-preferences.slint";
import { MusicModeVolumePanel, PlayerMusicModeState } from "player-music-mode-state.slint";
import { PlaylistPluginPopupState } from "playlist-plugin-popup.slint";

// The same focus scope owns the child controls and the remaining player shortcuts.
export component PlayerKeyScope inherits FocusScope {
    in-out property <bool> menu-alternates-visible;
    in property <bool> native-video;
    in property <bool> primary-shortcut-is-meta;
    in property <bool> loaded;
    in property <bool> fullscreen;
    in property <bool> compact-menu-available;
    private property <bool> application-menu-key-armed;
    out property <bool> music-mode-hovered: surface.has-hover &&
        surface.mouse-y < surface.height - PlayerMusicModeState.displayed-catalog-height;
    callback open-compact-menu();

    // Observe the compact player's artwork and strip through their child controls.
    // The list starts below the tracking area and owns its own interaction.
    surface := TouchArea {
        width: root.width; height: root.height;
        enabled: root.loaded && PlayerMusicModeState.music-mode;
        @children
    }

    capture-key-pressed(event) => {
        if PlayerControlActions.held-control-key != "" && event.text == PlayerControlActions.held-control-key {
            if event.repeat { return accept; }
            PlayerControlActions.held-control-key = "";
        }
        if event.text == Key.F10 && !event.repeat { root.application-menu-key-armed = false; }
        if PlaylistPluginPopupState.shown {
            if !event.repeat || (event.text != Key.Return && event.text != " ") {
                PlaylistPluginPopupState.handle-key(event.text);
            }
            return accept;
        }
        if !PlayerCropState.crop-editing && !PlayerDialogState.dialog-open
            && PlayerControlActions.forward-mpv-script-key(event.text, event.modifiers.control,
                event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, false) {
            return accept;
        }
        return reject;
    }
    capture-key-released(event) => {
        if PlayerControlActions.held-control-key != "" && event.text == PlayerControlActions.held-control-key {
            PlayerControlActions.held-control-key = "";
            return accept;
        }
        if PlaylistPluginPopupState.shown { return accept; }
        if !PlayerCropState.crop-editing && !PlayerDialogState.dialog-open
            && PlayerControlActions.forward-mpv-script-key(event.text, event.modifiers.control,
                event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, true) {
            return accept;
        }
        return reject;
    }

    key-released(event) => {
        if (event.text == Key.Alt || !event.modifiers.alt) && menu-alternates-visible {
            menu-alternates-visible = false;
        }
        if event.text == Key.F10 && root.application-menu-key-armed {
            root.application-menu-key-armed = false;
            if !PlayerCropState.crop-editing && !PlayerDialogState.dialog-open {
                if native-video { PlayerControlActions.open-application-menu(); }
                else if root.compact-menu-available { root.open-compact-menu(); }
            }
            return accept;
        }
        if !PlayerCropState.crop-editing && !PlayerDialogState.dialog-open
            && PlayerControlActions.begin-plugin-key(event.text, event.modifiers.control, event.modifiers.alt,
                event.modifiers.shift, event.modifiers.meta, event.repeat, true) {
            return accept;
        }
        return reject;
    }
    key-pressed(event) => {
        if menu-alternates-visible != event.modifiers.alt {
            menu-alternates-visible = event.modifiers.alt;
        }
        if PlayerCropState.crop-editing { if event.text == Key.Escape { PlayerCropState.finish-custom-crop(false); } if event.text == Key.Tab { return reject; } return accept; }
        if PlayerDialogState.jump-time-dialog-visible {
            if event.text == Key.Escape { PlayerDialogState.jump-time-dialog-visible = false; PlayerDialogState.jump-time-error = ""; return accept; }
            return accept;
        }
        if PlayerDialogState.url-dialog-visible {
            if event.text == Key.Escape { PlayerDialogState.url-dialog-visible = false; return accept; }
            return accept;
        }
        if event.text == Key.Escape && PlayerMusicModeState.music-mode-volume-panel != MusicModeVolumePanel.closed {
            PlayerMusicModeState.close-volume-panel();
            return accept;
        }
        if (native-video || root.compact-menu-available) && event.text == Key.F10
            && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift {
            if !event.repeat { root.application-menu-key-armed = true; }
            return accept;
        }
        let route-to-plugins = !PlayerDialogState.dialog-open;
        if route-to-plugins && PlayerControlActions.begin-plugin-key(event.text, event.modifiers.control, event.modifiers.alt,
                event.modifiers.shift, event.modifiers.meta, event.repeat, false) {
            return accept;
        }
        let mapped = PlayerControlActions.activate-saved-filter-shortcut(event.text, event.modifiers.control,
            event.modifiers.alt, event.modifiers.shift, event.modifiers.meta)
            || PlayerControlActions.dispatch-key-binding(event.text, event.modifiers.control,
                event.modifiers.alt, event.modifiers.shift, event.modifiers.meta, event.repeat);
        let handled = route-to-plugins && PlayerControlActions.finish-plugin-key();
        if mapped || handled {
            return accept;
        }
        PlayerControlsState.controls-visible = true; PlayerControlActions.activity();
        let primary = primary-shortcut-is-meta ? event.modifiers.meta : event.modifiers.control;
        let alternate = PlayerPreferences.key-binding-current-profile == "mpv Default"
            || PlayerPreferences.key-binding-current-profile == "VLC Default"
            || PlayerPreferences.key-binding-current-profile == "Movist Default"
            || PlayerPreferences.key-binding-current-profile == "Movist v2 Default";
        if primary && !event.modifiers.shift && !event.modifiers.alt {
            if event.text == "," {
                PlayerMenuActions.open-preferences(); return accept;
            }
            if event.text == "o" && alternate {
                PlayerMenuActions.open-file(); return accept;
            }
        }
        if alternate {
            if event.text == Key.Escape && !event.modifiers.shift && !event.modifiers.alt
                && !event.modifiers.control && !event.modifiers.meta {
                if root.fullscreen { PlayerMenuActions.toggle-fullscreen(); return accept; }
                if PlayerSidebarState.sidebar != 0 || PlayerSidebarState.leading-sidebar != 0 {
                    PlayerSidebarState.sidebar = 0; PlayerSidebarState.leading-sidebar = 0; return accept;
                }
            }
            return reject;
        }
        if primary {
            if event.modifiers.shift {
                if event.modifiers.alt || (primary-shortcut-is-meta && event.modifiers.control) { return reject; }
                if event.text == "L" { PlayerMenuActions.toggle-file-loop(); return accept; }
                if event.text == ">" { PlayerMenuActions.adjust-chapter(1); return accept; }
                if event.text == "<" { PlayerMenuActions.adjust-chapter(-1); return accept; }
                if event.text == "C" { PlayerMenuActions.toggle-playlist-pane(3); return accept; }
                if event.text == "P" { PlayerMenuActions.toggle-playlist-pane(4); return accept; }
                if event.text == "A" { PlayerMenuActions.toggle-settings-pane(1); return accept; }
                if event.text == "S" { PlayerMenuActions.take-screenshot(); return accept; }
                if event.text == "V" { PlayerMenuActions.toggle-settings-pane(6); return accept; }
                return reject;
            }
            // Windows/Linux map the extra macOS Control modifier to Alt;
            // primary itself is already Control on those platforms.
            if (primary-shortcut-is-meta ? event.modifiers.control : event.modifiers.alt) {
                if primary-shortcut-is-meta && event.modifiers.alt { return reject; }
                if event.text == "a" { PlayerMenuActions.cycle-audio-track(); return accept; }
                if event.text == "s" { PlayerMenuActions.cycle-subtitle-track(); return accept; }
                if event.text == "v" { PlayerMenuActions.cycle-video-track(); return accept; }
                if primary-shortcut-is-meta { return reject; }
            }
            if event.modifiers.alt {
                if event.text == "[" { PlayerMenuActions.speed(1 / 1.1); return accept; }
                if event.text == "]" { PlayerMenuActions.speed(1.1); return accept; }
                return reject;
            }
            if event.text == "l" { PlayerMenuActions.cycle-ab-loop(); return accept; }
            if event.text == "." { PlayerMenuActions.stop(); return accept; }
            if event.text == Key.RightArrow { PlayerMenuActions.playlist-next(); return accept; }
            if event.text == Key.LeftArrow { PlayerMenuActions.playlist-previous(); return accept; }
            if event.text == "o" { PlayerMenuActions.open-file(); return accept; }
            if event.text == "/" { PlayerMenuActions.toggle-mute(); return accept; }
            if event.text == "[" { PlayerMenuActions.speed(0.5); return accept; }
            if event.text == "]" { PlayerMenuActions.speed(2); return accept; }
            if event.text == "\\" { PlayerMenuActions.reset-speed(); return accept; }
            return reject;
        }
        if event.modifiers.alt && !event.modifiers.shift {
            if !event.modifiers.control && !event.modifiers.meta && event.text == "v" { PlayerMenuActions.toggle-secondary-subtitle-visibility(); return accept; }
            if event.text == Key.RightArrow { PlayerMenuActions.frame-step(); return accept; }
            if event.text == Key.LeftArrow { PlayerMenuActions.frame-back-step(); return accept; }
            if event.text == Key.UpArrow { PlayerMenuActions.adjust-volume(1); return accept; }
            if event.text == Key.DownArrow { PlayerMenuActions.adjust-volume(-1); return accept; }
        }
        if !event.modifiers.control && !event.modifiers.meta {
            if event.modifiers.shift {
                if event.text == "(" { PlayerMenuActions.adjust-audio-delay(event.modifiers.alt ? 0.1 : 0.5); return accept; }
                if event.text == ")" { PlayerMenuActions.adjust-audio-delay(event.modifiers.alt ? -0.1 : -0.5); return accept; }
                if event.text == "_" && !event.modifiers.alt { PlayerMenuActions.reset-audio-delay(); return accept; }
            }
            if event.text == "Z" { PlayerMenuActions.adjust-subtitle-delay(event.modifiers.alt ? -0.1 : -0.5); return accept; }
            if event.text == "X" { PlayerMenuActions.adjust-subtitle-delay(event.modifiers.alt ? 0.1 : 0.5); return accept; }
            if event.text == "C" && !event.modifiers.alt { PlayerMenuActions.reset-subtitle-delay(); return accept; }
        }
        if event.modifiers.shift && !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
            if event.text == Key.PageUp { PlayerMenuActions.seek-relative(600); return accept; }
            if event.text == Key.PageDown { PlayerMenuActions.seek-relative(-600); return accept; }
            if event.text == Key.RightArrow { PlayerControlActions.subtitle-seek(1); return accept; }
            if event.text == Key.LeftArrow { PlayerControlActions.subtitle-seek(-1); return accept; }
        }
        if !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
            if event.text == "G" { PlayerControlActions.adjust-subtitle-scale(0.1); return accept; }
            if event.text == "F" { PlayerControlActions.adjust-subtitle-scale(-0.1); return accept; }
            if event.text == "R" { PlayerControlActions.adjust-subtitle-position(1); return accept; }
        }
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
        if event.text == " " || event.text == "p" { PlayerMenuActions.toggle-pause(); return accept; }
        if event.text == Key.RightArrow { PlayerMenuActions.seek-relative(5); return accept; }
        if event.text == Key.LeftArrow { PlayerMenuActions.seek-relative(-5); return accept; }
        if event.text == Key.UpArrow { PlayerMenuActions.adjust-volume(5); return accept; }
        if event.text == Key.DownArrow { PlayerMenuActions.adjust-volume(-5); return accept; }
        if event.text == "m" { PlayerMenuActions.toggle-mute(); return accept; }
        if event.text == "j" && root.loaded { PlayerMenuActions.open-jump-time-dialog(); return accept; }
        if event.text == "v" { PlayerMenuActions.toggle-subtitle-visibility(); return accept; }
        if event.text == "r" { PlayerControlActions.adjust-subtitle-position(-1); return accept; }
        if event.text == "t" { PlayerControlActions.adjust-subtitle-position(1); return accept; }
        if event.text == "." { PlayerMenuActions.frame-step(); return accept; }
        if event.text == "," { PlayerMenuActions.frame-back-step(); return accept; }
        if event.text == "f" { PlayerMenuActions.toggle-fullscreen(); return accept; }
        if event.text == Key.Return { if !root.fullscreen { PlayerMenuActions.toggle-fullscreen(); } return accept; }
        if event.text == Key.Escape && root.fullscreen { PlayerMenuActions.toggle-fullscreen(); return accept; }
        if event.text == Key.Escape && (PlayerSidebarState.sidebar != 0 || PlayerSidebarState.leading-sidebar != 0) { PlayerSidebarState.sidebar = 0; PlayerSidebarState.leading-sidebar = 0; return accept; }
        return reject;
    }
}
