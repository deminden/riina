import { PlayerLayoutState } from "player-layout-state.slint";
import { PlayerSidebarState } from "player-sidebar-state.slint";
import { PlayerCatalogState } from "player-catalog-state.slint";
import { PlayerMusicModeState } from "player-music-mode-state.slint";
import { PlaylistPluginPopupState } from "playlist-plugin-popup.slint";
import { PlayerPluginSidebarState } from "player-plugin-sidebar.slint";
import { PlaybackTimelineState } from "playback-timeline-state.slint";
import { PlaybackAudioState } from "playback-audio-state.slint";
import { PlaybackSubtitleState } from "playback-subtitle-state.slint";
import { PlaybackVideoState } from "playback-video-state.slint";
import { PlayerPreferences } from "player-preferences.slint";
import { PlayerMenuActions } from "player-menu-actions.slint";
import { CatalogRow, CatalogSelection } from "catalog-row.slint";
import { MenuCatalogRow, MenuShortcutRow, PluginMenuDisplay, PluginMenuRow, SavedFilterMenuRow } from "native-video.slint";

// Slint attaches its menus to the window. Menu items and player controls
// share the same actions, which Rust registers on PlayerWindow.
export component PlayerMenuWindow inherits Window {
    in property <bool> menu-bar-visible;
    in property <[MenuShortcutRow]> menu-value-menu-shortcuts;
    in property <bool> menu-value-crop-editing;
    in property <string> menu-value-current-file-manager-name;
    in property <bool> menu-value-deinterlace-enabled;
    in property <bool> menu-value-deinterlace-known;
    in property <bool> menu-value-delete-current-media-available;
    in property <bool> menu-value-delogo-active;
    in property <bool> menu-value-delogo-enabled;
    in property <bool> menu-value-downloaded-subtitle-save-available;
    in property <bool> menu-value-fullscreen;
    in property <bool> menu-value-in-process-player-manager;
    in property <bool> menu-value-live-text-available;
    in property <bool> menu-value-live-text-enabled;
    in property <bool> menu-value-loaded;
    in property <bool> menu-value-menu-alternates-visible;
    in property <bool> menu-value-paused;
    in property <bool> menu-value-picture-in-picture-active;
    in property <bool> menu-value-picture-in-picture-available;
    in property <[PluginMenuRow]> menu-value-plugin-menu-rows;
    in property <int> menu-value-plugin-menu-conflicts;
    in property <[MenuCatalogRow]> menu-value-plugin-developer-rows;
    in-out property <int> menu-value-preferences-target-pane;
    in property <bool> menu-value-primary-shortcut-is-meta;
    in property <bool> menu-value-reflection-known;
    in property <bool> menu-value-reveal-current-media-available;
    in property <bool> menu-value-save-current-playlist-available;
    in property <[SavedFilterMenuRow]> menu-value-saved-audio-filter-rows;
    in property <[SavedFilterMenuRow]> menu-value-saved-video-filter-rows;
    in property <bool> menu-value-screenshot-available;
    in property <bool> menu-value-video-flipped;
    in property <bool> menu-value-video-mirrored;
    in property <float> menu-value-video-window-height;
    in property <float> menu-value-video-window-width;

    function menu-shortcut(index: int) -> keys {
        if index < 0 || index >= root.menu-value-menu-shortcuts.length { return @keys(); }
        return root.player-shortcut(root.menu-value-menu-shortcuts[index].shortcut);
    }

    // Slint dispatches menu-bar shortcuts before visiting the focused item.
    function player-shortcut(shortcut: keys) -> keys {
        return PlaylistPluginPopupState.shown ||
            (PlayerPluginSidebarState.composited && PlayerPluginSidebarState.keyboard-focused)
            ? @keys() : shortcut;
    }

    // Slint binds this height to the window area below its menu bar.
    out property <length> menu-content-height: root.height;
    Rectangle {
        width: root.width;
        height: root.menu-content-height;
        @children
    }

    if root.menu-bar-visible : MenuBar {
        Menu { title: "riina";
            MenuItem { title: "About Riina"; activated => { PlayerMenuActions.show-about(); } }
            MenuItem { title: "Check for Updates…";
                activated => { PlayerMenuActions.check-for-updates(); } }
            MenuSeparator {}
            MenuItem { title: root.menu-value-primary-shortcut-is-meta ? "Settings…" : "Preferences…";
                enabled: !root.menu-value-crop-editing;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + ",") : @keys(Control + ","));
                activated => { PlayerMenuActions.open-preferences(); } }
            MenuSeparator {}
            MenuItem { title: "Services"; enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Hide Riina";
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + H) : @keys(Control + H));
                activated => { PlayerMenuActions.hide-riina(); } }
            MenuItem { title: "Quit Riina";
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + Q) : @keys(Control + Q));
                activated => { PlayerMenuActions.quit-riina(); }
            }
        }
        Menu { title: "File";
            MenuItem { title: PlayerPreferences.open-in-new-player ? "Open in New Window…" : "Open…"; enabled: !root.menu-value-crop-editing;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + O) : @keys(Control + O));
                activated => { PlayerMenuActions.open-file(); } }
            MenuItem { title: PlayerPreferences.open-in-new-player ? "Open…" : "Open in New Window…"; enabled: !root.menu-value-crop-editing;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + Alt + O) : @keys(Control + Alt + O));
                activated => { PlayerMenuActions.open-file-alternative(); } }
            MenuItem { title: PlayerPreferences.open-in-new-player ? "Open URL in New Window…" : "Open URL…"; enabled: !root.menu-value-crop-editing;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + Shift + O) : @keys(Control + Shift + O));
                activated => { PlayerMenuActions.open-url-dialog(); } }
            MenuItem { title: PlayerPreferences.open-in-new-player ? "Open URL…" : "Open URL in New Window…"; enabled: !root.menu-value-crop-editing;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta
                    ? @keys(Meta + Alt + Shift + O) : @keys(Control + Alt + Shift + O));
                activated => { PlayerMenuActions.open-url-alternative(); } }
            if PlayerPreferences.record-recent-files : Menu {
                title: "Open Recent";
                enabled: PlayerCatalogState.recent-open-menu-rows.length > 0;
                for row in PlayerCatalogState.recent-open-menu-rows : MenuItem {
                    title: row.label;
                    activated => { PlayerMenuActions.open-recent-path(row.token); }
                }
                MenuSeparator {}
                MenuItem { title: "Clear Menu"; enabled: PlayerCatalogState.recent-open-menu-rows.length > 0;
                    activated => { PlayerMenuActions.clear-open-recent(); } }
            }
            if PlayerPreferences.enable-new-window-shortcut : MenuSeparator {}
            if PlayerPreferences.enable-new-window-shortcut : MenuItem {
                title: "New Window"; enabled: !root.menu-value-crop-editing;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta
                    ? @keys(Meta + N) : @keys(Control + N));
                activated => { PlayerMenuActions.create-welcome-window(); }
            }
            MenuSeparator {}
            MenuItem { title: "Playback History";
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + Shift + H) : @keys(Control + Shift + H));
                activated => { PlayerMenuActions.show-playback-history(); } }
            MenuSeparator {}
            MenuItem {
                title: "Show Current File in " + root.menu-value-current-file-manager-name;
                enabled: root.menu-value-reveal-current-media-available;
                activated => { PlayerMenuActions.reveal-current-media(); } }
            MenuItem { title: "Delete Current File";
                enabled: root.menu-value-delete-current-media-available;
                activated => { PlayerMenuActions.delete-current-media(); } }
            MenuItem { title: "Save Current Playlist…";
                enabled: root.menu-value-save-current-playlist-available;
                activated => { PlayerMenuActions.save-current-playlist(); } }
            MenuSeparator {}
            MenuItem { title: "Close";
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + W) : @keys(Control + W));
                activated => { PlayerMenuActions.close-player(); } }
        }
        Menu { title: "Edit";
            MenuItem { title: "Undo"; enabled: false;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + Z) : @keys(Control + Z)); }
            MenuItem { title: "Redo"; enabled: false;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + Shift + Z) : @keys(Control + Shift + Z)); }
            MenuSeparator {}
            MenuItem { title: "Cut"; enabled: false;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + X) : @keys(Control + X)); }
            MenuItem { title: "Copy"; enabled: false;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + C) : @keys(Control + C)); }
            MenuItem { title: "Paste"; enabled: false;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + V) : @keys(Control + V)); }
            MenuItem { title: "Select All"; enabled: false;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + A) : @keys(Control + A)); }
        }
        Menu { title: "Playback";
            MenuItem { title: root.menu-value-paused ? "Resume" : "Pause";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(0);
                activated => { PlayerMenuActions.toggle-pause(); } }
            MenuItem { title: "Stop and Clear Playlists"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(1);
                activated => { PlayerMenuActions.stop(); } }
            MenuSeparator {}
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Next Frame" : "Step Forward 5s";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 4 : 2);
                activated => { if root.menu-value-menu-alternates-visible { PlayerMenuActions.frame-step(); } else { PlayerMenuActions.seek-relative(5); } } }
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Previous Frame" : "Step Backward 5s";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 5 : 3);
                activated => { if root.menu-value-menu-alternates-visible { PlayerMenuActions.frame-back-step(); } else { PlayerMenuActions.seek-relative(-5); } } }
            MenuItem { title: "Jump to Beginning"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.seek(0); } }
            MenuItem { title: "Jump to…"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + J) : @keys(Control + J));
                activated => { PlayerMenuActions.open-jump-time-dialog(); } }
            MenuSeparator {}
            MenuItem { title: "Speed: " + PlaybackTimelineState.speed-edit-value + "x"; enabled: false; }
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Speed Up by 1.1x" : "Speed Up by 2x";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 9 : 7);
                activated => { PlayerMenuActions.speed(root.menu-value-menu-alternates-visible ? 1.1 : 2); } }
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Speed Down by 0.9x" : "Speed Down by 0.5x";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 10 : 8);
                activated => { PlayerMenuActions.speed(root.menu-value-menu-alternates-visible ? 0.9 : 0.5); } }
            MenuItem { title: "Reset Speed"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(6);
                activated => { PlayerMenuActions.reset-speed(); } }
            MenuSeparator {}
            MenuItem { title: "Take a Screenshot"; enabled: root.menu-value-screenshot-available && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(11);
                activated => { PlayerMenuActions.take-screenshot(); } }
            MenuItem { title: "Go to Screenshot Folder"; enabled: !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.open-screenshot-folder(); } }
            MenuSeparator {}
            MenuItem { title: "A-B Loop"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(46);
                activated => { PlayerMenuActions.cycle-ab-loop(); } }
            MenuItem { title: "File Loop"; checkable: true; checked: PlayerCatalogState.loop-label == "File";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(47);
                activated => { PlayerMenuActions.toggle-file-loop(); } }
            MenuSeparator {}
            MenuItem { title: "Show Playlist Panel"; enabled: !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(12);
                activated => { PlayerMenuActions.toggle-playlist-pane(4); } }
            MenuItem { title: "Playlist Loop"; checkable: true; checked: PlayerCatalogState.loop-label == "Playlist";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.playlist-action(5, ""); } }
            Menu { title: "Playlist"; enabled: root.menu-value-loaded && PlayerCatalogState.playlist.length > 0 && !root.menu-value-crop-editing;
                for row in PlayerCatalogState.playlist : MenuItem {
                    title: row.label; checkable: true; checked: row.playing;
                    activated => { PlayerMenuActions.playlist-action(12, row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Next Media"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(13);
                activated => { PlayerMenuActions.playlist-next(); } }
            MenuItem { title: "Previous Media"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(14);
                activated => { PlayerMenuActions.playlist-previous(); } }
            MenuItem { title: "Show Chapters Panel"; enabled: !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(15);
                activated => { PlayerMenuActions.toggle-playlist-pane(3); } }
            Menu { title: "Chapters"; enabled: root.menu-value-loaded && PlayerCatalogState.chapters.length > 0 && !root.menu-value-crop-editing;
                for row in PlayerCatalogState.chapters : MenuItem {
                    title: row.label;
                    checkable: true; checked: row.selected;
                    activated => { PlayerMenuActions.select-item(CatalogSelection.chapter, row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Next Chapter"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(16);
                activated => { PlayerMenuActions.adjust-chapter(1); } }
            MenuItem { title: "Previous Chapter"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(17);
                activated => { PlayerMenuActions.adjust-chapter(-1); } }
        }
        Menu { title: "Video";
            MenuItem { title: (PlayerSidebarState.settings-at-leading ? PlayerSidebarState.leading-sidebar == 6 : PlayerSidebarState.sidebar == 6) ? "Hide Video Panel" : "Show Video Panel"; enabled: !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(18);
                activated => { PlayerMenuActions.toggle-settings-pane(6); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Video Tracks"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(19);
                activated => { PlayerMenuActions.cycle-video-track(); } }
            Menu { title: "Video Track"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                for row in PlaybackVideoState.video-tracks : MenuItem {
                    title: row.label;
                    checkable: true; checked: row.selected;
                    activated => { PlayerMenuActions.select-item(CatalogSelection.video-track, row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Half Size"; enabled: root.menu-value-loaded && root.menu-value-video-window-width > 0
                    && root.menu-value-video-window-height > 0 && !PlayerMusicModeState.music-mode && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(20);
                activated => { PlayerMenuActions.resize-window-command(0); } }
            MenuItem { title: "Normal Size"; enabled: root.menu-value-loaded && root.menu-value-video-window-width > 0
                    && root.menu-value-video-window-height > 0 && !PlayerMusicModeState.music-mode && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(21);
                activated => { PlayerMenuActions.resize-window-command(1); } }
            MenuItem { title: "Double Size"; enabled: root.menu-value-loaded && root.menu-value-video-window-width > 0
                    && root.menu-value-video-window-height > 0 && !PlayerMusicModeState.music-mode && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(22);
                activated => { PlayerMenuActions.resize-window-command(2); } }
            MenuItem { title: "Fit to Screen"; enabled: !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(23);
                activated => { PlayerMenuActions.resize-window-command(3); } }
            MenuSeparator {}
            MenuItem { title: "Bigger Size"; enabled: root.menu-value-loaded && root.menu-value-video-window-width > 0
                    && root.menu-value-video-window-height > 0 && !PlayerMusicModeState.music-mode && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(24);
                activated => { PlayerMenuActions.resize-window-command(4); } }
            MenuItem { title: "Smaller Size"; enabled: root.menu-value-loaded && root.menu-value-video-window-width > 0
                    && root.menu-value-video-window-height > 0 && !PlayerMusicModeState.music-mode && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(25);
                activated => { PlayerMenuActions.resize-window-command(5); } }
            MenuSeparator {}
            MenuItem { title: root.menu-value-picture-in-picture-active ? "Exit Picture in Picture" : "Enter Picture in Picture";
                enabled: root.menu-value-picture-in-picture-active || root.menu-value-picture-in-picture-available;
                shortcut: root.menu-shortcut(26);
                activated => { PlayerMenuActions.toggle-picture-in-picture(); } }
            MenuItem { title: root.menu-value-fullscreen ? "Exit Full Screen" : "Enter Full Screen";
                checkable: true; checked: root.menu-value-fullscreen; enabled: !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(27);
                activated => { PlayerMenuActions.toggle-fullscreen(); } }
            MenuItem { title: "Float on Top"; checkable: true;
                checked: PlayerLayoutState.always-float-on-top; enabled: !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(28);
                activated => { PlayerLayoutState.always-float-on-top = !PlayerLayoutState.always-float-on-top; } }
            MenuItem { title: "Lock Window Aspect Ratio"; checkable: true;
                checked: !PlayerLayoutState.unlock-window-aspect-ratio; enabled: !root.menu-value-crop-editing;
                activated => { PlayerLayoutState.unlock-window-aspect-ratio = !PlayerLayoutState.unlock-window-aspect-ratio; } }
            MenuItem { title: "Live Text";
                checkable: true; checked: root.menu-value-live-text-enabled;
                enabled: root.menu-value-live-text-available && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(29);
                activated => { PlayerMenuActions.toggle-live-text(); } }
            MenuSeparator {}
            MenuItem { title: PlayerMusicModeState.music-mode ? "Exit Music Mode" : "Enter Music Mode";
                checkable: true; checked: PlayerMusicModeState.music-mode;
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(30);
                activated => { PlayerMenuActions.toggle-music-mode(); } }
            MenuSeparator {}
            Menu { title: "Aspect Ratio"; enabled: root.menu-value-loaded && PlaybackVideoState.video-aspect-known && !root.menu-value-crop-editing;
                for label[index] in PlaybackVideoState.video-aspect-menu-labels : MenuItem {
                    title: label; checkable: true; checked: PlaybackVideoState.video-aspect-menu-index == index;
                    activated => { PlayerMenuActions.set-menu-video-aspect(index); }
                }
            }
            Menu { title: "Crop"; enabled: root.menu-value-loaded && PlaybackVideoState.video-crop-known && !root.menu-value-crop-editing;
                for label[index] in PlaybackVideoState.video-crop-menu-labels : MenuItem {
                    title: label; checkable: true; checked: PlaybackVideoState.video-crop-menu-index == index;
                    activated => { PlayerMenuActions.set-menu-video-crop(index); }
                }
                MenuSeparator {}
                MenuItem { title: "Custom…"; checkable: true; checked: PlaybackVideoState.video-crop-menu-index == 10;
                    activated => { PlayerMenuActions.set-menu-video-crop(10); } }
            }
            Menu { title: "Rotation"; enabled: root.menu-value-loaded && PlaybackVideoState.video-rotation-known && !root.menu-value-crop-editing;
                MenuItem { title: "0°"; checkable: true; checked: PlaybackVideoState.video-rotation-index == 0;
                    activated => { PlayerMenuActions.set-menu-video-rotation(0); } }
                MenuItem { title: "90°"; checkable: true; checked: PlaybackVideoState.video-rotation-index == 1;
                    activated => { PlayerMenuActions.set-menu-video-rotation(90); } }
                MenuItem { title: "180°"; checkable: true; checked: PlaybackVideoState.video-rotation-index == 2;
                    activated => { PlayerMenuActions.set-menu-video-rotation(180); } }
                MenuItem { title: "270°"; checkable: true; checked: PlaybackVideoState.video-rotation-index == 3;
                    activated => { PlayerMenuActions.set-menu-video-rotation(270); } }
            }
            Menu { title: "Flip"; enabled: root.menu-value-loaded && root.menu-value-reflection-known && !root.menu-value-crop-editing;
                MenuItem { title: "Horizontal (Mirror)"; checkable: true; checked: root.menu-value-video-mirrored;
                    activated => { PlayerMenuActions.toggle-video-reflection(true); } }
                MenuItem { title: "Vertical (Flip)"; checkable: true; checked: root.menu-value-video-flipped;
                    activated => { PlayerMenuActions.toggle-video-reflection(false); } }
            }
            MenuItem { title: "Deinterlace"; checkable: true; checked: root.menu-value-deinterlace-enabled;
                enabled: root.menu-value-loaded && root.menu-value-deinterlace-known && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.toggle-deinterlace(); } }
            MenuItem { title: "Delogo"; checkable: true; checked: root.menu-value-delogo-active;
                enabled: root.menu-value-delogo-enabled && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.toggle-delogo(); } }
            MenuSeparator {}
            MenuItem { title: "Video Filters…"; enabled: !root.menu-value-crop-editing;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + Shift + F) : @keys(Control + Shift + F));
                activated => { PlayerMenuActions.open-video-filters(); } }
            Menu { title: "Saved Video Filters"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                for row in root.menu-value-saved-video-filter-rows : MenuItem {
                    title: row.label; shortcut: root.player-shortcut(row.shortcut);
                    checkable: true; checked: row.selected;
                    activated => { PlayerMenuActions.toggle-saved-video-filter(row.token); }
                }
            }
        }
        Menu { title: "Audio";
            MenuItem { title: (PlayerSidebarState.settings-at-leading ? PlayerSidebarState.leading-sidebar == 1 : PlayerSidebarState.sidebar == 1) ? "Hide Audio Panel" : "Show Audio Panel"; enabled: !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(31);
                activated => { PlayerMenuActions.toggle-settings-pane(1); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Audio Tracks"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(32);
                activated => { PlayerMenuActions.cycle-audio-track(); } }
            Menu { title: "Audio Track"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                for row in PlaybackAudioState.audio-tracks : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { PlayerMenuActions.select-item(CatalogSelection.audio-track, row.token); }
                }
            }
            MenuItem { title: "Load External Audio…"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.browse-files(1); } }
            MenuSeparator {}
            MenuItem { title: PlaybackAudioState.volume-menu-title; enabled: false; }
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Volume + 1%" : "Volume + 5%";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 35 : 33);
                activated => { PlayerMenuActions.adjust-volume(root.menu-value-menu-alternates-visible ? 1 : 5); } }
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Volume - 1%" : "Volume - 5%";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 36 : 34);
                activated => { PlayerMenuActions.adjust-volume(root.menu-value-menu-alternates-visible ? -1 : -5); } }
            MenuItem { title: "Mute"; checkable: true; checked: PlaybackAudioState.muted;
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(37);
                activated => { PlayerMenuActions.toggle-mute(); } }
            MenuSeparator {}
            MenuItem { title: "Audio Delay: " + PlaybackAudioState.audio-delay-text + "s"; enabled: false; }
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Audio Delay + 0.1s" : "Audio Delay + 0.5s";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 40 : 38);
                activated => { PlayerMenuActions.adjust-audio-delay(root.menu-value-menu-alternates-visible ? 0.1 : 0.5); } }
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Audio Delay - 0.1s" : "Audio Delay - 0.5s";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 41 : 39);
                activated => { PlayerMenuActions.adjust-audio-delay(root.menu-value-menu-alternates-visible ? -0.1 : -0.5); } }
            MenuItem { title: "Reset Audio Delay"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(48);
                activated => { PlayerMenuActions.reset-audio-delay(); } }
            MenuSeparator {}
            Menu { title: "Audio Device";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing && PlaybackAudioState.audio-device-menu-rows.length > 0;
                for row in PlaybackAudioState.audio-device-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { PlayerMenuActions.set-audio-device(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Audio Filters…"; enabled: !root.menu-value-crop-editing;
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + Shift + G) : @keys(Control + Shift + G));
                activated => { PlayerMenuActions.open-audio-filters(); } }
            Menu { title: "Saved Audio Filters"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                for row in root.menu-value-saved-audio-filter-rows : MenuItem {
                    title: row.label; shortcut: root.player-shortcut(row.shortcut);
                    checkable: true; checked: row.selected;
                    activated => { PlayerMenuActions.toggle-saved-audio-filter(row.token); }
                }
            }
        }
        Menu { title: "Subtitles";
            MenuItem { title: (PlayerSidebarState.settings-at-leading ? PlayerSidebarState.leading-sidebar == 2 : PlayerSidebarState.sidebar == 2) ? "Hide Subtitles Panel" : "Show Subtitles Panel"; enabled: !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(42);
                activated => { PlayerMenuActions.toggle-settings-pane(2); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Subtitles"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(43);
                activated => { PlayerMenuActions.cycle-subtitle-track(); } }
            Menu { title: "Subtitle"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                for row in PlaybackSubtitleState.subtitle-tracks : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { PlayerMenuActions.select-item(CatalogSelection.primary-subtitle, row.token); }
                }
            }
            MenuItem { title: PlaybackSubtitleState.subtitle-visible ? "Hide Subtitles" : "Show Subtitles";
                checkable: true; checked: PlaybackSubtitleState.subtitle-visible;
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(44);
                activated => { PlayerMenuActions.toggle-subtitle-visibility(); } }
            Menu { title: "Secondary Subtitle"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                for row in PlaybackSubtitleState.secondary-subtitle-tracks : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { PlayerMenuActions.select-item(CatalogSelection.secondary-subtitle, row.token); }
                }
            }
            MenuItem { title: PlaybackSubtitleState.secondary-subtitle-visible ? "Hide Secondary Subtitles" : "Show Secondary Subtitles";
                checkable: true; checked: PlaybackSubtitleState.secondary-subtitle-visible;
                enabled: root.menu-value-loaded && PlaybackSubtitleState.secondary-subtitle-visibility-known && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(54);
                activated => { PlayerMenuActions.toggle-secondary-subtitle-visibility(); }
            }
            MenuItem { title: "Load External Subtitle…"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.browse-files(2); } }
            MenuSeparator {}
            MenuItem { title: PlayerPreferences.open-subtitles-plugin-provider-label != "" ? "Find Online Subtitles from " + PlayerPreferences.open-subtitles-plugin-provider-label : PlayerPreferences.open-subtitles-provider-index == 1 ? "Find Online Subtitles from assrt.net" : PlayerPreferences.open-subtitles-provider-index == 2 ? "Find Online Subtitles from shooter.cn" : "Find Online Subtitles from opensubtitles.com"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(55);
                activated => { PlayerMenuActions.find-online-subtitles(); } }
            Menu { title: "Find Online Subtitles from"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                MenuItem { title: "opensubtitles.com"; activated => { PlayerMenuActions.find-online-subtitles-with-provider(0); } }
                MenuItem { title: "assrt.net"; activated => { PlayerMenuActions.find-online-subtitles-with-provider(1); } }
                MenuItem { title: "shooter.cn"; activated => { PlayerMenuActions.find-online-subtitles-with-provider(2); } }
                for provider in PlayerPreferences.plugin-subtitle-providers : MenuItem {
                    title: provider.label;
                    activated => { PlayerMenuActions.find-online-subtitles-with-plugin(provider.token); }
                }
            }
            MenuItem { title: "Save Downloaded Subtitle…";
                enabled: root.menu-value-downloaded-subtitle-save-available && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.save-downloaded-subtitle(); }
            }
            MenuSeparator {}
            Menu { title: "Encoding"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                for row in PlaybackSubtitleState.subtitle-encoding-options : MenuItem {
                    title: row.label; checkable: true;
                    checked: PlayerPreferences.subtitle-default-encoding == row.token;
                    activated => { PlayerMenuActions.set-subtitle-encoding(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Scale Up"; enabled: root.menu-value-loaded && PlaybackSubtitleState.subtitle-scale-known && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.multiply-subtitle-scale(1.1); } }
            MenuItem { title: "Scale Down"; enabled: root.menu-value-loaded && PlaybackSubtitleState.subtitle-scale-known && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.multiply-subtitle-scale(0.9); } }
            MenuItem { title: "Reset Subtitle Scale"; enabled: root.menu-value-loaded && PlaybackSubtitleState.subtitle-scale-known && !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.set-subtitle-scale-slider(0); } }
            MenuSeparator {}
            MenuItem { title: "Subtitle Delay: " + PlaybackSubtitleState.subtitle-delay-text + "s"; enabled: false; }
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Subtitle Delay + 0.1s" : "Subtitle Delay + 0.5s";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 52 : 49);
                activated => { PlayerMenuActions.adjust-subtitle-delay(root.menu-value-menu-alternates-visible ? 0.1 : 0.5); } }
            MenuItem { title: root.menu-value-menu-alternates-visible ? "Subtitle Delay - 0.1s" : "Subtitle Delay - 0.5s";
                enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(root.menu-value-menu-alternates-visible ? 53 : 50);
                activated => { PlayerMenuActions.adjust-subtitle-delay(root.menu-value-menu-alternates-visible ? -0.1 : -0.5); } }
            MenuItem { title: "Reset Subtitle Delay"; enabled: root.menu-value-loaded && !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(51);
                activated => { PlayerMenuActions.reset-subtitle-delay(); } }
            MenuSeparator {}
            MenuItem { title: "Font…"; enabled: !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.choose-subtitle-font(); } }
        }
        Menu { title: "\u{1f}riina-plugin-menu";
            if root.menu-value-plugin-menu-conflicts > 0 : MenuItem {
                title: PluginMenuDisplay.conflict-title(root.menu-value-plugin-menu-conflicts); enabled: false;
            }
            MenuItem { title: "Manage Plugins…"; enabled: !root.menu-value-crop-editing;
                activated => { root.menu-value-preferences-target-pane = 9; PlayerMenuActions.open-preferences(); } }
            MenuItem { title: (PlayerSidebarState.sidebar == 7 || PlayerSidebarState.leading-sidebar == 7) ? "Hide Plugins Panel" : "Show Plugins Panel"; enabled: !root.menu-value-crop-editing;
                shortcut: root.menu-shortcut(45);
                activated => { PlayerMenuActions.toggle-plugins-pane(); } }
            MenuSeparator {}
            for row in root.menu-value-plugin-menu-rows : MenuItem {
                title: PluginMenuDisplay.menu-title(row);
                enabled: row.enabled && !root.menu-value-crop-editing;
                checkable: false;
                checked: row.selected;
                shortcut: root.player-shortcut(row.shortcut);
                activated => { PlayerMenuActions.activate-plugin-menu-item(row.token); }
            }
            if root.menu-value-plugin-menu-rows.length > 0 : MenuSeparator {}
            Menu { title: "Developer Tool"; enabled: root.menu-value-plugin-developer-rows.length > 0;
                for row in root.menu-value-plugin-developer-rows : MenuItem {
                    title: row.label;
                    activated => { PlayerMenuActions.open-plugin-developer-tool(row.token); }
                }
            }
            MenuItem { title: "Reload All Plugins"; enabled: !root.menu-value-crop-editing;
                activated => { PlayerMenuActions.reload-plugins(); } }
        }
        Menu { title: "Window";
            MenuItem { title: "Minimize";
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + M) : @keys(Control + M));
                activated => { PlayerMenuActions.minimize-window(); }
            }
            MenuItem { title: "Zoom"; activated => { PlayerMenuActions.zoom-window(); } }
            MenuSeparator {}
            MenuItem { title: "Inspector";
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta
                    ? @keys(Meta + I) : @keys(Control + I));
                activated => { PlayerMenuActions.show-inspector(); }
            }
            MenuItem { title: "Log Viewer";
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta
                    ? @keys(Control + Meta + L) : @keys(Control + Alt + L));
                activated => { PlayerMenuActions.show-log-viewer(); }
            }
            MenuSeparator {}
            MenuItem { title: "Bring All to Front";
                enabled: root.menu-value-in-process-player-manager;
                activated => { PlayerMenuActions.bring-all-to-front(); }
            }
            if PlayerCatalogState.window-menu-rows.length > 0 : MenuSeparator {}
            for row in PlayerCatalogState.window-menu-rows : MenuItem {
                title: row.label; checkable: true; checked: row.selected;
                activated => { PlayerMenuActions.select-player-window(row.token); }
            }
        }
        Menu { title: "Help";
            MenuItem { title: "Riina Help";
                shortcut: root.player-shortcut(root.menu-value-primary-shortcut-is-meta ? @keys(Meta + Shift + "/") : @keys(Control + Shift + "/"));
                activated => { PlayerMenuActions.open-help-link("help"); } }
            MenuItem { title: "Dump Debug Info"; activated => { PlayerMenuActions.dump-debug-info(); } }
            MenuSeparator {}
            MenuItem { title: "Use New Settings Window"; checkable: true; checked: true;
                activated => { PlayerMenuActions.open-preferences(); } }
            MenuSeparator {}
            MenuItem { title: "Release Highlights"; activated => { PlayerMenuActions.show-release-highlights(); } }
            MenuSeparator {}
            MenuItem { title: "GitHub"; activated => { PlayerMenuActions.open-help-link("github"); } }
            MenuItem { title: "Website"; activated => { PlayerMenuActions.open-help-link("website"); } }
        }
    }
}
