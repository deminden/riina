import { Theme } from "theme.slint";
import { PlaylistInteraction, PlaylistMenuOrigin } from "playlist-interaction.slint";
import { PlaylistBlankMenuArea, PlaylistContextMenu } from "playlist-context-menu.slint";
import { PlayerCatalogState } from "player-catalog-state.slint";
import { CatalogRow } from "catalog-row.slint";
import { PlayerSidebarState } from "player-sidebar-state.slint";
import { PlaylistDropScrollView } from "playlist-drop-viewport.slint";
import { PlaylistInsertionIndicator, PlaylistRowInput } from "playlist-row-input.slint";

export component MusicModePlaylist inherits Rectangle {
    in property <bool> dark-theme;
    in property <bool> platform-windows;
    in property <color> windows-accent-color;
    callback select-row(string);
    callback play-row(string);
    private property <length> summary-height: PlayerCatalogState.playlist-duration-summary == "" ? 0px : 20px;

    background: Theme.music-mode-playlist-surface(root.dark-theme);
    PlaylistDropScrollView {
        width: parent.width; height: parent.height - summary-height;
        playlist-drop-enabled: true;
        content-width: self.visible-width;
        content-height: max(self.visible-height, music-rows.preferred-height);
        init => { PlayerSidebarState.music-list-drop-viewport = self.drop-viewport; }
        changed drop-viewport => { PlayerSidebarState.music-list-drop-viewport = self.drop-viewport; }
        music-rows := VerticalLayout {
            spacing: 1px;
            for row[index] in PlayerCatalogState.playlist : Rectangle {
                private property <length> duration-width: row.duration-label == "" ? 0px : 60px;
                height: PlayerCatalogState.playlist-metadata-visible ? 38px : 30px; horizontal-stretch: 1;
                accessible-role: button;
                accessible-label: row.label;
                accessible-action-default => { root.select-row(row.token); }
                background: row.selected || PlaylistInteraction.selected-playlist-token == row.token
                    ? Theme.music-mode-playlist-selection(root.dark-theme) :
                    music-row-touch.has-hover ? Theme.music-mode-playlist-hover(root.dark-theme) : transparent;
                PlaylistInsertionIndicator {
                    width: parent.width;
                    height: parent.height;
                    index: index;
                    accent: root.platform-windows ? root.windows-accent-color : Theme.playback-progress-accent;
                }
                if row.playing : Image {
                    x: 8px; y: 8px; width: 14px; height: 14px;
                    source: @image-url("../../../assets/icons/play.svg");
                    image-fit: contain; colorize: root.platform-windows ? root.windows-accent-color : Theme.playback-progress-accent;
                }
                if row.detail != "" : VerticalLayout {
                    x: row.playing ? 28px : 10px; y: 3px;
                    width: parent.width - (row.playing ? 38px : 20px) - duration-width; height: parent.height - 6px;
                    spacing: 0px;
                    Text { text: row.label; color: Theme.music-mode-playlist-title(root.dark-theme);
                        font-size: 12px; vertical-alignment: center; overflow: elide; }
                    Text { text: row.detail; color: Theme.music-mode-playlist-detail(root.dark-theme);
                        font-size: 10px; vertical-alignment: center; overflow: elide; }
                }
                if row.detail == "" : Text { x: row.playing ? 28px : 10px;
                    width: parent.width - (row.playing ? 38px : 20px) - duration-width; text: row.label;
                    color: Theme.music-mode-playlist-title(root.dark-theme); font-size: 12px;
                    vertical-alignment: center; overflow: elide; }
                if duration-width > 0px : Text {
                    x: parent.width - duration-width - 10px; width: duration-width; height: parent.height;
                    text: row.duration-label; font-size: 11px;
                    color: Theme.music-mode-playlist-detail(root.dark-theme);
                    horizontal-alignment: right; vertical-alignment: center;
                }
                music-row-touch := PlaylistRowInput {
                    index: index;
                    token: row.token;
                    selected: row.selected;
                    focus-row => { music-row-focus.focus(); }
                    double-clicked => {
                        if !PlaylistInteraction.playlist-drag-active {
                            music-row-touch.cancel-drag();
                            root.play-row(row.token);
                        }
                    }
                    open-menu(x, y) => { music-row-menu.open-at(x, y); }
                }
                music-row-menu := PlaylistContextMenu {
                    origin: PlaylistMenuOrigin.music-mode;
                    index: index; token: row.token; network: row.network;
                }
                music-row-focus := FocusScope {
                    width: 0px;
                    key-pressed(event) => {
                        if event.text == Key.Escape && music-row-touch.cancel-drag() { return accept; }
                        if event.text == Key.F10 && event.modifiers.shift && !event.modifiers.alt
                            && !event.modifiers.control && !event.modifiers.meta {
                            music-row-menu.open-at(12px, parent.height);
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }
        PlaylistBlankMenuArea {
            origin: PlaylistMenuOrigin.music-mode;
            accent: root.platform-windows ? root.windows-accent-color : Theme.playback-progress-accent;
            y: music-rows.preferred-height;
            width: parent.width;
            height: max(0px, parent.height - self.y);
        }
    }
    if summary-height > 0px : Text {
        y: root.height - summary-height; width: root.width; height: summary-height;
        text: PlayerCatalogState.playlist-duration-summary;
        color: Theme.music-mode-playlist-detail(root.dark-theme);
        font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
    }
}
