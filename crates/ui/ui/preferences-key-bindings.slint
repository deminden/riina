import { Theme } from "theme.slint";

export struct KeyBindingRow {
    key: string,
    action: string,
    comment: string,
}

export global KeyBindingSettingsState {
    in-out property <string> key-binding-current-profile: "IINA Default";
    in-out property <int> key-binding-profile-index: 0;
    in-out property <[string]> key-binding-profiles: ["IINA Default", "mpv Default", "VLC Default", "Movist Default", "Movist v2 Default"];
    in-out property <[KeyBindingRow]> key-binding-rows: [];
    out property <length> key-binding-content-height: key-binding-rows.length == 0
        ? 310px : 290px + key-binding-rows.length * 32px;
    in-out property <string> key-binding-search-query: "";
    in-out property <bool> key-binding-use-system-media-controls: true;
    in-out property <bool> key-binding-display-raw-values: false;
    in-out property <int> key-binding-selected-row: -1;
    in-out property <bool> key-binding-editor-open: false;
    in-out property <bool> key-binding-profile-menu-open: false;
    in-out property <bool> key-binding-profile-editor-open: false;
    in-out property <bool> key-binding-profile-delete-confirm-open: false;
    in-out property <int> key-binding-profile-editor-mode: 0;
    in-out property <string> key-binding-profile-editor-name: "";
    in-out property <int> key-binding-editor-row: -1;
    in-out property <string> key-binding-editor-key: "";
    in-out property <string> key-binding-editor-action: "";
    in-out property <string> key-binding-editor-comment: "";
    in-out property <int> key-binding-editor-kind: 0;
    pure callback build-binding-action(string, string, string, string) -> string;
}

export component KeyBindingActionRow inherits Rectangle {
    in property <KeyBindingRow> entry;
    in property <bool> selected: false;
    in property <int> row-index;
    in property <int> selected-index: -1;
    in property <int> row-count: 0;
    in property <bool> editable: false;
    callback activated(int);
    callback edit-requested(int);
    callback remove-requested(int);
    key-label-measure := Text { text: root.entry.key; font-size: 12px; visible: false; }
    private property <length> keycap-width: min(160px, max(48px, key-label-measure.preferred-width + 14px));
    height: 32px;
    background: root.selected ? Theme.settings-key-binding-row-selection : touch.has-hover ? Theme.settings-field-surface : transparent;
    accessible-role: list-item;
    accessible-label: root.entry.action + ", " + root.entry.key;
    accessible-action-default => { root.activated(root.row-index); }
    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.settings-key-binding-row-divider; }
    Text { x: 12px; y: 0; width: max(0px, parent.width - root.keycap-width - 32px); height: parent.height;
        text: root.entry.action; font-size: 12px; color: Theme.settings-card-title;
        vertical-alignment: center; overflow: elide; }
    Rectangle { x: parent.width - root.keycap-width - 10px; y: 4px; width: root.keycap-width; height: 24px;
        border-radius: 5px; border-width: 1px; border-color: Theme.settings-keycap-border; background: Theme.settings-field-surface; }
    Text { x: parent.width - root.keycap-width - 6px; y: 4px; width: root.keycap-width - 8px; height: 24px;
        text: root.entry.key; font-size: 12px; color: Theme.settings-card-title;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    if focus.has-focus : Rectangle {
        width: parent.width; height: parent.height; border-width: 1px;
        border-color: Theme.settings-key-binding-focus; border-radius: 3px; background: transparent;
    }
    touch := TouchArea {
        clicked => { focus.focus(); root.activated(root.row-index); }
        double-clicked => { if root.editable { root.edit-requested(root.row-index); } }
    }
    focus := FocusScope {
        focus-on-click: false;
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return && root.selected && root.editable {
                root.edit-requested(root.row-index); return accept;
            }
            if (event.text == Key.Delete || event.text == Key.Backspace) && root.selected && root.editable {
                root.remove-requested(root.row-index); return accept;
            }
            if event.text == Key.DownArrow && root.row-count > 0 {
                root.activated(min(root.row-count - 1, root.selected-index + 1)); return accept;
            }
            if event.text == Key.UpArrow && root.row-count > 0 {
                root.activated(max(0, root.selected-index - 1)); return accept;
            }
            return reject;
        }
    }
}

export component KeyBindingIconButton inherits FocusScope {
    in property <string> label;
    in property <int> icon-kind;
    callback activated();
    width: 40px;
    height: 36px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Rectangle { x: 2px; y: 1px; width: parent.width - 4px; height: parent.height - 2px;
        border-radius: 6px;
        background: !root.enabled ? transparent : touch.has-hover ? Theme.settings-key-binding-action-hover : transparent; }
    if root.icon-kind == 0 : Rectangle {
        x: 14px; y: 13px; width: 12px; height: 10px;
        border-width: 1px; border-color: Theme.settings-key-binding-action-outline(root.enabled); border-radius: 2px;
        background: transparent;
        Rectangle { x: -2px; y: -3px; width: 14px; height: 1px; background: Theme.settings-key-binding-action-outline(root.enabled); }
        Rectangle { x: 2px; y: -6px; width: 6px; height: 2px; background: Theme.settings-key-binding-action-outline(root.enabled); }
        Rectangle { x: 3px; y: 2px; width: 1px; height: 5px; background: Theme.settings-key-binding-delete-detail(root.enabled); }
        Rectangle { x: 8px; y: 2px; width: 1px; height: 5px; background: Theme.settings-key-binding-delete-detail(root.enabled); }
    }
    if root.icon-kind == 1 : Image {
        x: 12px; y: 10px; width: 16px; height: 16px;
        source: @image-url("../../../assets/icons/keybindings.svg");
    }
    if root.icon-kind == 1 : Rectangle {
        x: 26px; y: 9px; width: 8px; height: 8px;
        border-radius: 4px; background: Theme.settings-key-binding-action-surface;
        Rectangle { x: 3px; y: 1px; width: 1px; height: 6px; background: Theme.settings-key-binding-help; }
        Rectangle { x: 1px; y: 3px; width: 5px; height: 1px; background: Theme.settings-key-binding-help; }
    }
    if root.icon-kind == 2 : Rectangle {
        x: 15px; y: 15px; width: 10px; height: 8px;
        border-width: 1px; border-color: Theme.settings-key-binding-action-outline(true); border-radius: 2px;
        background: transparent;
        Rectangle { x: 2px; y: -6px; width: 1px; height: 6px; background: Theme.settings-key-binding-action-outline(true); }
        Rectangle { x: 7px; y: -6px; width: 1px; height: 6px; background: Theme.settings-key-binding-action-outline(true); }
        Rectangle { x: 2px; y: -6px; width: 6px; height: 1px; background: Theme.settings-key-binding-action-outline(true); }
        Rectangle { x: 4px; y: 2px; width: 2px; height: 2px; border-radius: 1px; background: Theme.settings-key-binding-action-outline(true); }
    }
    if root.icon-kind == 3 : Image {
        x: 11px; y: 10px; width: 18px; height: 18px;
        source: @image-url("../../../assets/icons/config-directory.svg");
    }
    if root.icon-kind == 3 : Rectangle {
        x: 25px; y: 18px; width: 11px; height: 11px; border-radius: 6px;
        background: Theme.settings-key-binding-action-surface;
        Rectangle { x: 5px; y: 2px; width: 1px; height: 7px; background: Theme.settings-key-binding-action-outline(true); }
        Rectangle { x: 2px; y: 5px; width: 7px; height: 1px; background: Theme.settings-key-binding-action-outline(true); }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        focus-on-click: false;
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == " ") {
                root.activated(); return accept;
            }
            return reject;
        }
    }
}

export component KeyBindingProfileMenuItem inherits FocusScope {
    in property <string> label;
    callback activated();
    width: 184px;
    height: 30px;
    Rectangle {
        x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
        border-radius: 5px; background: touch.has-hover ? Theme.settings-key-binding-menu-hover : transparent;
    }
    Text {
        x: 12px; width: parent.width - 24px; height: parent.height;
        text: root.label; font-size: 11px; color: Theme.settings-card-title; vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.activated(); } }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
        return reject;
    }
}

// Native toolkit button padding can consume a 24px chooser's entire label.
// Keep this small reference control explicit, including keyboard activation.
