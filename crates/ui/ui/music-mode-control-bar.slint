import { ControllerTimeline } from "controller-timeline.slint";
import { MusicModeControls } from "music-mode-controls.slint";
import { MusicModeMetadata } from "music-mode-metadata.slint";
import { MusicModeVolumeControl } from "music-mode-volume-control.slint";
import { PlayerAppearance } from "player-appearance.slint";
import { PlayerControlsState } from "player-controls-state.slint";
import { PlayerMenuActions } from "player-menu-actions.slint";
import { MusicModeVolumePanel, PlayerMusicModeState } from "player-music-mode-state.slint";
import { PlayerPreferences } from "player-preferences.slint";
import { Theme } from "theme.slint";

export component MusicModeControlBar inherits Rectangle {
    in property <bool> hovered;
    in property <bool> native-video;
    in property <bool> paused;
    in property <string> title;
    in property <float> aspect-ratio;
    in property <float> volume-limit;
    in property <image> sampled-video;
    in property <length> sample-width;
    in property <length> sample-height;
    private property <bool> transport-visible: root.hovered || transport.keyboard-focused
        || volume.keyboard-focused || volume.expanded;
    private property <int> wheel-volume-revision: PlayerMusicModeState.music-mode-wheel-volume-revision;
    private property <bool> keep-manual-volume: volume.keyboard-focused || PlayerControlsState.control-bar-dragging
        || (strip.has-hover && strip.mouse-x >= volume.x && strip.mouse-x < volume.x + volume.width
            && strip.mouse-y >= volume.y && strip.mouse-y < volume.y + volume.height);

    changed keep-manual-volume => {
        if !root.keep-manual-volume && PlayerMusicModeState.music-mode-volume-panel == MusicModeVolumePanel.manual {
            PlayerMusicModeState.close-volume-panel();
        }
    }
    changed wheel-volume-revision => {
        if PlayerMusicModeState.music-mode-volume-panel == MusicModeVolumePanel.wheel {
            if volume-timeout.running { volume-timeout.restart(); }
            else { volume-timeout.start(); }
        }
    }
    volume-timeout := Timer {
        interval: PlayerPreferences.osd-timeout-secs * 1s;
        running: false;
        triggered => {
            if PlayerMusicModeState.music-mode-volume-panel == MusicModeVolumePanel.wheel {
                PlayerMusicModeState.close-volume-panel();
            }
            self.stop();
        }
    }

    background: Theme.controller-surface(PlayerAppearance.dark-theme,
        PlayerAppearance.active-liquid-glass-osc, PlayerAppearance.platform-windows, root.native-video);
    border-width: 1px;
    border-color: Theme.controller-border;
    clip: true;
    if PlayerAppearance.active-liquid-glass-osc : Image {
        source: root.sampled-video;
        x: 0px; y: -root.y;
        width: root.sample-width; height: root.sample-height;
        opacity: PlayerAppearance.video-material-sample-opacity(root.native-video);
        image-fit: contain;
    }

    strip := TouchArea {
        width: root.width; height: root.height;
        // The seek and volume sliders get first use of the wheel. The rest of
        // the strip keeps wheel gestures away from the artwork's shortcuts.
        scroll-event(_) => { return accept; }
        MusicModeMetadata {
            width: parent.width; height: parent.height;
            title: root.title;
            controls-visible: root.transport-visible;
        }
        volume := MusicModeVolumeControl {
            x: (parent.width - 28px) / 2 - 98px;
            y: transport.y - 4px;
            volume-limit: root.volume-limit;
            opacity: root.transport-visible ? 1 : 0;
            animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-content-fade-duration; }
        }
        transport := MusicModeControls {
            y: PlayerAppearance.compact-ui ? 12px : 16px; width: parent.width;
            paused: root.paused; volume-open: volume.expanded; dark-theme: PlayerAppearance.dark-theme;
            accent-color: PlayerAppearance.interactive-accent-color;
            playlist-visible: PlayerMusicModeState.music-mode-show-playlist;
            artwork-visible: PlayerMusicModeState.music-mode-show-album-art;
            opacity: root.transport-visible ? 1 : 0;
            animate opacity { duration: PlayerAppearance.animations-disabled ? 0ms : Theme.controller-content-fade-duration; }
            pause-requested => { PlayerMenuActions.toggle-pause(); }
            previous-requested => { PlayerMenuActions.playlist-previous(); }
            next-requested => { PlayerMenuActions.playlist-next(); }
            playlist-requested => { PlayerMusicModeState.set-catalog-visible(!PlayerMusicModeState.music-mode-show-playlist); }
            artwork-requested => { PlayerMusicModeState.set-artwork-visible(!PlayerMusicModeState.music-mode-show-album-art); }
        }
        ControllerTimeline {
            x: 0px; width: parent.width; height: 20px; y: parent.height - 27px;
            music-mode: true;
            inline-inset: 6px;
            item-gap: 6px;
            aspect-ratio: root.aspect-ratio;
        }
    }
}
