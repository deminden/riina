import { PreferenceSwitch, OverrideLaneButton, PreferenceActionButton, PreferenceNumericInput, LanguageTokenEditor, GeneralDisclosureRow, PreferenceOptionCard } from "preferences-controls.slint";
import { Theme } from "theme.slint";
import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { SubtitleColorWell } from "shared-controls.slint";

export component SubtitlesPreferencesPage inherits ScrollView {
    in-out property <length> subtitle-scroll-position;
    in property <length> subtitle-content-height;
    in property <length> subtitle-ass-y;
    in-out property <int> selected-subtitle-section;
    in property <length> subtitle-text-y;
    in property <length> subtitle-position-y;
    in property <length> subtitle-online-y;
    in property <length> subtitle-other-y;
    in property <bool> mica-backdrop-enabled;
    in property <length> subtitle-autoload-height;
    in property <[string]> subtitle-auto-load-mode-options;
    in-out property <int> subtitle-auto-load-mode-index;
    callback settings-changed();
    in-out property <bool> subtitle-auto-load-advanced-expanded;
    in-out property <string> subtitle-auto-load-priority-text;
    in-out property <string> subtitle-search-paths-text;
    in-out property <int> subtitle-ass-override-lane;
    in property <[string]> subtitle-override-descriptions;
    in property <int> subtitle-ass-override-primary-index;
    in property <int> subtitle-ass-override-secondary-index;
    callback choose-subtitle-override(int);
    in property <length> subtitle-text-height;
    in property <string> subtitle-font;
    callback choose-subtitle-font();
    in-out property <string> subtitle-font-size-text;
    in-out property <bool> subtitle-bold;
    in-out property <bool> subtitle-italic;
    in-out property <color> subtitle-text-color;
    in property <bool> platform-macos;
    callback native-subtitle-color-requested(int, color);
    in-out property <color> subtitle-background-color;
    in-out property <color> subtitle-shadow-color;
    in-out property <string> subtitle-outline-size-text;
    in-out property <color> subtitle-outline-color;
    in-out property <string> subtitle-shadow-offset-text;
    in-out property <bool> subtitle-text-advanced-expanded;
    in-out property <string> subtitle-blur-text;
    in-out property <string> subtitle-spacing-text;
    in-out property <int> subtitle-align-x-index;
    in-out property <int> subtitle-align-y-index;
    in-out property <string> subtitle-margin-x-text;
    in-out property <string> subtitle-margin-y-text;
    in-out property <string> subtitle-position-text;
    in-out property <bool> subtitle-display-in-letterbox;
    in-out property <bool> subtitle-scale-with-window;
    in property <length> subtitle-online-height;
    in property <[string]> open-subtitles-provider-options;
    in-out property <int> open-subtitles-provider-index;
    in-out property <string> open-subtitles-api-key;
    in-out property <string> assrt-token;
    callback open-assrt-token-page();
    in-out property <bool> open-subtitles-auto-search;
    in-out property <string> open-subtitles-threshold-text;
    in property <[string]> subtitle-language-tokens;
    callback add-subtitle-language-token(string);
    callback remove-subtitle-language-token(int);
    in property <[string]> subtitle-encoding-options;
    in-out property <int> subtitle-encoding-index;

    content-y <=> root.subtitle-scroll-position;
    content-height: root.subtitle-content-height;
    content-width: self.visible-width;
    horizontal-scrollbar-policy: always-off;
    changed content-y => {
        if root.subtitle-scroll-position > 16px - root.subtitle-ass-y { root.selected-subtitle-section = 0; }
        else if root.subtitle-scroll-position > 16px - root.subtitle-text-y { root.selected-subtitle-section = 1; }
        else if root.subtitle-scroll-position > 16px - root.subtitle-position-y { root.selected-subtitle-section = 2; }
        else if root.subtitle-scroll-position > 16px - root.subtitle-online-y { root.selected-subtitle-section = 3; }
        else if root.subtitle-scroll-position > 16px - root.subtitle-other-y { root.selected-subtitle-section = 4; }
        else { root.selected-subtitle-section = 5; }
    }
    Rectangle { x: 0px; y: 0px; width: parent.width; height: root.subtitle-content-height;
        background: root.mica-backdrop-enabled ? #ffffff80 : #ffffff;
        Text { x: 28px; y: 16px; text: "Subtitles"; font-size: 15px; font-weight: 600; color: #222222; }
        Text { x: 28px; y: 52px; text: "Auto Load"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: 78px; width: parent.width - 40px; height: root.subtitle-autoload-height;
            border-width: 1px; border-color: #dedee1; border-radius: 12px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            Text { x: 14px; y: 6px; width: 80px; height: 28px; text: "Auto load"; font-size: 12px; color: #252529; vertical-alignment: center; }
            ComboBox { x: 102px; y: 8px; width: parent.width - 116px; height: 26px;
                model: root.subtitle-auto-load-mode-options; current-index <=> root.subtitle-auto-load-mode-index;
                selected => { root.settings-changed(); }
            }
            Rectangle { x: 14px; y: 40px; width: parent.width - 28px; height: 1px; background: #dedee1; }
            GeneralDisclosureRow { x: 0px; y: 41px; width: parent.width; label: "Advanced";
                expanded: root.subtitle-auto-load-advanced-expanded;
                activated => { root.subtitle-auto-load-advanced-expanded = !root.subtitle-auto-load-advanced-expanded; }
            }
            if root.subtitle-auto-load-advanced-expanded : Rectangle { x: 14px; y: 82px; width: parent.width - 28px; height: 150px; background: transparent;
                Text { x: 0px; y: 8px; width: parent.width; height: 18px; text: "Filename priority keywords"; font-size: 12px; color: #252529; }
                Rectangle { x: 0px; y: 30px; width: parent.width; height: 24px; border-width: 1px; border-color: Theme.settings-field-border; border-radius: 3px; background: #ffffff; clip: true;
                    TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px; single-line: true;
                        accessible-label: "Subtitle filename priority keywords"; text <=> root.subtitle-auto-load-priority-text;
                        accepted => { root.settings-changed(); }
                    }
                }
                Text { x: 0px; y: 58px; width: parent.width; height: 20px; text: "Comma-separated strings, in priority order."; font-size: 10px; color: #77777d; }
                Text { x: 0px; y: 84px; width: parent.width; height: 18px; text: "Also search these directories"; font-size: 12px; color: #252529; }
                Rectangle { x: 0px; y: 106px; width: parent.width; height: 24px; border-width: 1px; border-color: Theme.settings-field-border; border-radius: 3px; background: #ffffff; clip: true;
                    TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px; single-line: true;
                        accessible-label: "Subtitle search paths"; text <=> root.subtitle-search-paths-text;
                        accepted => { root.settings-changed(); }
                    }
                }
            }
        }
        Text { x: 28px; y: root.subtitle-ass-y; text: "ASS Subtitles"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: root.subtitle-ass-y + 26px; width: parent.width - 40px; height: 354px;
            border-width: 1px; border-color: #dedee1; border-radius: 12px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            Text { x: 14px; y: 12px; width: 150px; height: 26px; text: "Override level"; font-size: 12px; color: #252529; vertical-alignment: center; }
            OverrideLaneButton { x: parent.width - 178px; y: 12px; width: 80px; height: 26px; label: "Primary"; accessible-label: "Primary subtitles";
                selected: root.subtitle-ass-override-lane == 0; activated => { root.subtitle-ass-override-lane = 0; }
            }
            OverrideLaneButton { x: parent.width - 94px; y: 12px; width: 80px; height: 26px; label: "Secondary"; accessible-label: "Secondary subtitles";
                selected: root.subtitle-ass-override-lane == 1; activated => { root.subtitle-ass-override-lane = 1; }
            }
            for option[index] in ["no", "yes", "scale", "force", "strip"] : PreferenceOptionCard {
                x: 14px; y: 54px + index * 58px; width: parent.width - 28px;
                title: option; description: root.subtitle-override-descriptions[index];
                selected: (root.subtitle-ass-override-lane == 0 ? root.subtitle-ass-override-primary-index : root.subtitle-ass-override-secondary-index) == index;
                activated => { root.choose-subtitle-override(index); }
            }
        }
        Text { x: 28px; y: root.subtitle-text-y; text: "Text Subtitles"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: root.subtitle-text-y + 26px; width: parent.width - 40px; height: root.subtitle-text-height;
            border-width: 1px; border-color: #dedee1; border-radius: 12px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            Text { x: 14px; y: 12px; width: 70px; height: 26px; text: "Font"; font-size: 12px; color: #252529; vertical-alignment: center; }
            PreferenceActionButton { x: 90px; y: 12px; width: parent.width - 104px; label: root.subtitle-font; accessible-label: "Choose subtitle font";
                activated => { root.choose-subtitle-font(); }
            }
            Text { x: 14px; y: 52px; width: 70px; height: 24px; text: "Size"; font-size: 12px; color: #252529; vertical-alignment: center; }
            PreferenceNumericInput { x: 90px; y: 52px; width: 44px; height: 24px; label: "Subtitle font size"; text <=> root.subtitle-font-size-text; accepted => { root.settings-changed(); } }
            CheckBox { x: 150px; y: 52px; width: 72px; height: 24px; text: "Bold"; checked <=> root.subtitle-bold; toggled => { root.settings-changed(); } }
            CheckBox { x: 236px; y: 52px; width: 72px; height: 24px; text: "Italic"; checked <=> root.subtitle-italic; toggled => { root.settings-changed(); } }
            Text { x: 14px; y: 92px; width: 70px; height: 24px; text: "Color"; font-size: 12px; color: #252529; vertical-alignment: center; }
            SubtitleColorWell { x: 90px; y: 92px; observed-color: root.subtitle-text-color; hint: "Subtitle text color"; native-color-panel: root.platform-macos; color-target: 1;
                native-color-requested(target, color) => { root.native-subtitle-color-requested(target, color); }
                edited(value) => { root.subtitle-text-color = value; root.settings-changed(); }
            }
            Text { x: 150px; y: 92px; width: 100px; height: 24px; text: "Background"; font-size: 12px; color: #252529; vertical-alignment: center; }
            SubtitleColorWell { x: parent.width - 54px; y: 92px; observed-color: root.subtitle-background-color; hint: "Subtitle background color"; native-color-panel: root.platform-macos; color-target: 2;
                native-color-requested(target, color) => { root.native-subtitle-color-requested(target, color); }
                edited(value) => { root.subtitle-background-color = value; root.subtitle-shadow-color = value; root.settings-changed(); }
            }
            Text { x: 14px; y: 132px; width: 70px; height: 24px; text: "Border"; font-size: 12px; color: #252529; vertical-alignment: center; }
            PreferenceNumericInput { x: 90px; y: 132px; width: 44px; height: 24px; label: "Subtitle border size"; text <=> root.subtitle-outline-size-text; accepted => { root.settings-changed(); } }
            Text { x: 166px; y: 132px; width: 74px; height: 24px; text: "Color"; font-size: 12px; color: #252529; vertical-alignment: center; }
            SubtitleColorWell { x: parent.width - 54px; y: 132px; observed-color: root.subtitle-outline-color; hint: "Subtitle border color"; native-color-panel: root.platform-macos; color-target: 3;
                native-color-requested(target, color) => { root.native-subtitle-color-requested(target, color); }
                edited(value) => { root.subtitle-outline-color = value; root.settings-changed(); }
            }
            Text { x: 14px; y: 172px; width: 70px; height: 24px; text: "Shadow"; font-size: 12px; color: #252529; vertical-alignment: center; }
            PreferenceNumericInput { x: 90px; y: 172px; width: 44px; height: 24px; label: "Subtitle shadow offset"; text <=> root.subtitle-shadow-offset-text; accepted => { root.settings-changed(); } }
            Text { x: 166px; y: 172px; width: 74px; height: 24px; text: "Color"; font-size: 12px; color: #252529; vertical-alignment: center; }
            SubtitleColorWell { x: parent.width - 54px; y: 172px; observed-color: root.subtitle-shadow-color; hint: "Subtitle shadow color"; native-color-panel: root.platform-macos; color-target: 4;
                native-color-requested(target, color) => { root.native-subtitle-color-requested(target, color); }
                edited(value) => { root.subtitle-shadow-color = value; root.subtitle-background-color = value; root.settings-changed(); }
            }
            GeneralDisclosureRow { x: 0px; y: 204px; width: parent.width; label: "Other styles"; expanded: root.subtitle-text-advanced-expanded;
                activated => { root.subtitle-text-advanced-expanded = !root.subtitle-text-advanced-expanded; }
            }
            if root.subtitle-text-advanced-expanded : Rectangle { x: 14px; y: 248px; width: parent.width - 28px; height: 26px; background: transparent;
                Text { x: 0px; y: 0px; width: 40px; height: 24px; text: "Blur"; font-size: 12px; color: #252529; vertical-alignment: center; }
                PreferenceNumericInput { x: 44px; y: 0px; width: 44px; height: 24px; label: "Subtitle blur"; text <=> root.subtitle-blur-text; accepted => { root.settings-changed(); } }
                Text { x: 108px; y: 0px; width: 100px; height: 24px; text: "Font spacing"; font-size: 12px; color: #252529; vertical-alignment: center; }
                PreferenceNumericInput { x: parent.width - 56px; y: 0px; width: 56px; height: 24px; label: "Subtitle font spacing"; text <=> root.subtitle-spacing-text; accepted => { root.settings-changed(); } }
            }
        }
        Text { x: 28px; y: root.subtitle-position-y; text: "Position"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: root.subtitle-position-y + 26px; width: parent.width - 40px; height: 248px;
            border-width: 1px; border-color: #dedee1; border-radius: 12px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            Text { x: 14px; y: 12px; width: 126px; height: 24px; text: "Horizontal alignment"; font-size: 12px; color: #252529; vertical-alignment: center; }
            ComboBox { x: 150px; y: 12px; width: parent.width - 164px; height: 26px; model: ["Left", "Center", "Right"]; current-index <=> root.subtitle-align-x-index; selected => { root.settings-changed(); } }
            Text { x: 14px; y: 52px; width: 126px; height: 24px; text: "Vertical alignment"; font-size: 12px; color: #252529; vertical-alignment: center; }
            ComboBox { x: 150px; y: 52px; width: parent.width - 164px; height: 26px; model: ["Top", "Center", "Bottom"]; current-index <=> root.subtitle-align-y-index; selected => { root.settings-changed(); } }
            Text { x: 14px; y: 92px; width: 64px; height: 24px; text: "Margin X"; font-size: 12px; color: #252529; vertical-alignment: center; }
            PreferenceNumericInput { x: 80px; y: 92px; width: 54px; height: 24px; label: "Horizontal subtitle margin"; text <=> root.subtitle-margin-x-text; accepted => { root.settings-changed(); } }
            Text { x: 166px; y: 92px; width: 64px; height: 24px; text: "Margin Y"; font-size: 12px; color: #252529; vertical-alignment: center; }
            PreferenceNumericInput { x: parent.width - 68px; y: 92px; width: 54px; height: 24px; label: "Vertical subtitle margin"; text <=> root.subtitle-margin-y-text; accepted => { root.settings-changed(); } }
            Text { x: 14px; y: 132px; width: 150px; height: 24px; text: "Vertical position"; font-size: 12px; color: #252529; vertical-alignment: center; }
            PreferenceNumericInput { x: 180px; y: 132px; width: 64px; height: 24px; label: "Subtitle vertical position percent"; text <=> root.subtitle-position-text; accepted => { root.settings-changed(); } }
            Text { x: 250px; y: 132px; width: 24px; height: 24px; text: "%"; font-size: 12px; color: #252529; vertical-alignment: center; }
            PreferenceSwitch { x: 14px; y: 168px; width: parent.width - 28px; label: "Display subtitles in fullscreen letterboxes"; checked <=> root.subtitle-display-in-letterbox; toggled => { root.settings-changed(); } }
            PreferenceSwitch { x: 14px; y: 204px; width: parent.width - 28px; label: "Scale subtitles with window size"; checked <=> root.subtitle-scale-with-window; toggled => { root.settings-changed(); } }
        }
        Text { x: 28px; y: root.subtitle-online-y; text: "Online Subtitles"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: root.subtitle-online-y + 26px; width: parent.width - 40px; height: root.subtitle-online-height;
            border-width: 1px; border-color: #dedee1; border-radius: 12px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            Text { x: 14px; y: 12px; width: 104px; height: 26px; text: "Provider"; font-size: 12px; color: #252529; vertical-alignment: center; }
            ComboBox { x: 130px; y: 12px; width: parent.width - 144px; height: 26px; model: root.open-subtitles-provider-options; current-index <=> root.open-subtitles-provider-index; selected => { root.settings-changed(); } }
            if root.open-subtitles-provider-index != 2 : Rectangle { x: 14px; y: 48px; width: parent.width - 28px; height: 84px; background: transparent;
                Text { x: 0px; y: 0px; width: parent.width; height: 18px; text: root.open-subtitles-provider-index == 1 ? "Assrt.net token" : "OpenSubtitles API key"; font-size: 12px; color: #252529; }
                Rectangle { x: 0px; y: 22px; width: parent.width; height: 24px; background: #ffffff; border-width: 1px; border-color: Theme.settings-field-border; border-radius: 3px; clip: true;
                    TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px; single-line: true; input-type: password; visible: root.open-subtitles-provider-index == 0;
                        accessible-label: "OpenSubtitles API key"; text <=> root.open-subtitles-api-key; accepted => { root.settings-changed(); }
                    }
                    TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px; single-line: true; input-type: password; visible: root.open-subtitles-provider-index == 1;
                        accessible-label: "Assrt.net token"; text <=> root.assrt-token; accepted => { root.settings-changed(); }
                    }
                }
                Text { x: 0px; y: 52px; width: parent.width; height: 30px; text: "Stored in your system credential store."; font-size: 10px; color: #77777d; wrap: word-wrap; }
            }
            if root.open-subtitles-provider-index == 1 : PreferenceActionButton { x: 14px; y: 136px; width: 176px; label: "Get an Assrt API token"; activated => { root.open-assrt-token-page(); } }
            if root.open-subtitles-provider-index == 2 : Text { x: 14px; y: 48px; width: parent.width - 28px; height: 54px; text: "Shooter matches local videos using file samples and their path. Searching sends both to Shooter.cn; no account is needed."; font-size: 10px; color: #77777d; wrap: word-wrap; }
            PreferenceSwitch { x: 14px; y: root.open-subtitles-provider-index == 1 ? 168px : root.open-subtitles-provider-index == 2 ? 116px : 136px; width: parent.width - 28px;
                label: "Search online subtitles automatically"; checked <=> root.open-subtitles-auto-search; toggled => { root.settings-changed(); }
            }
            Text { x: 14px; y: root.subtitle-online-height - 68px; width: parent.width - 28px; height: 20px; text: "Only search when media is longer than"; font-size: 11px; color: #252529; }
            PreferenceNumericInput { x: 14px; y: root.subtitle-online-height - 40px; width: 64px; height: 24px; label: "Online subtitle search minimum minutes"; text <=> root.open-subtitles-threshold-text; accepted => { root.settings-changed(); } }
            Text { x: 88px; y: root.subtitle-online-height - 40px; width: 80px; height: 24px; text: "minutes"; font-size: 12px; color: #252529; vertical-alignment: center; }
        }
        Text { x: 28px; y: root.subtitle-other-y; text: "Other"; font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle { x: 20px; y: root.subtitle-other-y + 26px; width: parent.width - 40px; height: 168px;
            border-width: 1px; border-color: #dedee1; border-radius: 12px; background: root.mica-backdrop-enabled ? #ffffff80 : #f8f8f8;
            Text { x: 14px; y: 12px; width: parent.width - 28px; height: 20px; text: "Preferred languages"; font-size: 12px; color: #252529; }
            LanguageTokenEditor { x: 14px; y: 36px; width: parent.width - 28px; height: 26px; tokens: root.subtitle-language-tokens;
                add-token(entry) => { root.add-subtitle-language-token(entry); }
                remove-token(index) => { root.remove-subtitle-language-token(index); }
            }
            Text { x: 14px; y: 68px; width: parent.width - 28px; height: 34px; text: "Comma-separated language codes, in preference order."; font-size: 10px; color: #77777d; wrap: word-wrap; }
            Text { x: 14px; y: 116px; width: 120px; height: 26px; text: "Default encoding"; font-size: 12px; color: #252529; vertical-alignment: center; }
            ComboBox { x: 148px; y: 116px; width: parent.width - 162px; height: 26px; model: root.subtitle-encoding-options; current-index <=> root.subtitle-encoding-index; selected => { root.settings-changed(); } }
        }
    }
}
