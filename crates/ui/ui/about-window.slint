import { Theme } from "theme.slint";
import { Button } from "std-widgets.slint";
import { NativeTypography } from "shared-controls.slint";

export enum EngineVersionStatus { checking, reading, unavailable }

export component AboutWindow inherits Window {
    default-font-family: NativeTypography.system-font-family;
    title: @tr("About Riina");
    width: 640px;
    height: 400px;
    in-out property <bool> acrylic-backdrop-enabled: false;
    // Keep the native surface alpha-capable from creation; the full-size
    // content rectangle below supplies the opaque fallback until DWM accepts
    // Desktop Acrylic.
    background: transparent;
    in property <string> app-version;
    in property <string> engine-version;
    in property <string> ffmpeg-version;
    in property <EngineVersionStatus> engine-version-status: EngineVersionStatus.checking;
    out property <string> engine-label: !root.engine-version.is-empty ? "libmpv " + root.engine-version
        : root.engine-version-status == EngineVersionStatus.unavailable ? @tr("libmpv version unavailable")
        : root.engine-version-status == EngineVersionStatus.reading ? @tr("Reading libmpv version…")
        : @tr("Checking libmpv version…");
    out property <string> ffmpeg-label: !root.ffmpeg-version.is-empty ? "FFmpeg " + root.ffmpeg-version
        : root.engine-version-status == EngineVersionStatus.unavailable ? @tr("FFmpeg version unavailable")
        : root.engine-version-status == EngineVersionStatus.reading ? @tr("Reading FFmpeg version…")
        : @tr("Checking FFmpeg version…");
    in property <bool> dark-theme: false;
    in-out property <int> selected-tab: 0;
    in property <string> link-status;
    callback open-license();
    callback open-project();
    callback open-contributors();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.acrylic-backdrop-enabled
            ? transparent
            : (Theme.about-content-surface(root.dark-theme));
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 220px;
                background: root.acrylic-backdrop-enabled
                    ? transparent
                    : (Theme.about-summary-surface(root.dark-theme));
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    Image {
                        source: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
                        width: 80px;
                        height: 80px;
                        image-fit: contain;
                    }
                    Text { text: "Riina"; font-size: 30px; font-weight: 300;
                        color: Theme.about-title(root.dark-theme); horizontal-alignment: center; }
                    Text { text: @tr("Version {}", root.app-version); font-size: 12px;
                        color: Theme.about-summary-detail(root.dark-theme); horizontal-alignment: center; }
                    Text { text: root.engine-label; font-size: 11px;
                        color: Theme.about-summary-detail(root.dark-theme); horizontal-alignment: center; }
                    Text { text: root.ffmpeg-label; font-size: 10px;
                        color: Theme.about-summary-detail(root.dark-theme); horizontal-alignment: center; }
                    Rectangle { height: 12px; background: transparent; }
                    Button { text: @tr("License"); clicked => { root.selected-tab = 0; } }
                    Button { text: @tr("Contributors"); clicked => { root.selected-tab = 1; } }
                    Button { text: @tr("Credits"); clicked => { root.selected-tab = 2; } }
                }
            }
            Rectangle {
                background: root.acrylic-backdrop-enabled
                    ? transparent
                    : (Theme.about-content-surface(root.dark-theme));
                VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    if root.selected-tab == 0 : VerticalLayout {
                        spacing: 14px;
                        Text { text: @tr("License"); font-size: 20px; font-weight: 600;
                            color: Theme.about-title(root.dark-theme); }
                        Text {
                            text: @tr("Original Riina source is MIT-licensed. The combined application package is distributed under GPLv3.");
                            font-size: 13px; color: Theme.about-body(root.dark-theme); wrap: word-wrap;
                        }
                        Button { text: @tr("View License"); clicked => { root.open-license(); } }
                    }
                    if root.selected-tab == 1 : VerticalLayout {
                        spacing: 14px;
                        Text { text: @tr("Contributors"); font-size: 20px; font-weight: 600;
                            color: Theme.about-title(root.dark-theme); }
                        Text {
                            text: @tr("See the project contributor graph for the people and accounts that have contributed to Riina.");
                            font-size: 13px; color: Theme.about-body(root.dark-theme); wrap: word-wrap;
                        }
                        Button { text: @tr("View Contributors"); clicked => { root.open-contributors(); } }
                    }
                    if root.selected-tab == 2 : VerticalLayout {
                        spacing: 14px;
                        Text { text: @tr("Credits"); font-size: 20px; font-weight: 600;
                            color: Theme.about-title(root.dark-theme); }
                        Text {
                            text: @tr("Riina is an independent Rust media player built around libmpv, Slint, and other open-source dependencies.");
                            font-size: 13px; color: Theme.about-body(root.dark-theme); wrap: word-wrap;
                        }
                        Button { text: @tr("Project Website"); clicked => { root.open-project(); } }
                    }
                    if !root.link-status.is-empty : Text {
                        text: root.link-status;
                        font-size: 12px;
                        wrap: word-wrap;
                        color: Theme.about-body(root.dark-theme);
                    }
                }
            }
        }
    }
}
