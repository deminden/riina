import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { NativeTypography } from "shared-controls.slint";

export struct RecentMediaRow { title: string, position-label: string }

component WelcomeAction inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> enabled: true;
    callback activated();
    width: 112px; height: 36px; border-radius: 5px;
    background: Theme.welcome-button-surface(enabled, touch.has-hover);
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.welcome-outline-focus;
    accessible-role: button;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { activated(); } }
    Text { text: root.label; color: Theme.welcome-button-text(root.enabled);
        font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.activated(); }
    }
    focus := FocusScope {
        focus-on-click: false;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

component RecentMediaEntry inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> prominent: false;
    in property <bool> selected: false;
    callback activated();
    height: 28px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: Theme.welcome-history-surface(touch.has-hover, selected, prominent);
    accessible-role: button;
    accessible-label: detail == "" ? label : label + ", " + detail;
    accessible-action-default => { activated(); }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        Text { text: root.label; color: Theme.welcome-history-title; font-size: 12px;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.detail; color: Theme.welcome-history-detail; font-size: 11px;
            vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        focus-on-click: false;
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

// The reference gives Resume its own action row above the document table.
// Keeping title and time separate preserves its truncation and alignment rules.

component ResumeMediaEntry inherits Rectangle {
    in property <string> media-title;
    in property <string> position-label;
    in property <bool> selected: false;
    callback activated();
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: Theme.welcome-resume-surface(selected, touch.has-hover);
    accessible-role: button;
    accessible-label: "Resume " + root.media-title + ", " + root.position-label;
    accessible-action-default => { root.activated(); }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px;
        Image { source: @image-url("../../../assets/icons/resume-history.svg");
            width: 16px; height: 16px; }
        Text { text: "Resume"; color: Theme.welcome-history-title; font-size: 12px;
            vertical-alignment: center; }
        Text { text: root.media-title; color: Theme.welcome-history-title; font-size: 12px;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.position-label; color: Theme.welcome-history-detail; font-size: 11px;
            vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        focus-on-click: false;
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

export component WelcomeWindow inherits Window {
    default-font-family: NativeTypography.system-font-family;
    title: "Riina";
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    // Match IINA v1.5.0's fixed 560 x 440 point welcome window.
    preferred-width: 560px; preferred-height: 440px;
    min-width: 560px; min-height: 440px;
    max-width: 560px; max-height: 440px;
    in-out property <bool> mica-backdrop-enabled: false;
    // Keep the native surface alpha-capable from creation; the full-size
    // content rectangle below supplies the opaque fallback until DWM accepts
    // Mica.
    background: transparent;
    in property <string> app-version: "0.2.1";
    in property <string> drop-error;
    in property <[RecentMediaRow]> recent-media;
    in property <[RecentMediaRow]> recent-documents;
    in-out property <int> selection-index: -1;
    callback open-file();
    callback open-url();
    callback open-recent(int);
    callback show-playback-history();
    init => { keys.focus(); }

    keys := FocusScope {
        width: root.width; height: root.height;
        Rectangle {
            width: parent.width; height: parent.height;
            background: Theme.welcome-window-surface(root.mica-backdrop-enabled);
            VerticalLayout {
                padding-left: 30px; padding-right: 30px;
                padding-top: 48px; padding-bottom: 24px; spacing: 0px;
            HorizontalLayout {
                alignment: start; spacing: 14px; height: 76px;
                Image {
                    width: 68px; height: 68px;
                    source: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
                    image-fit: contain;
                    accessible-label: "Riina";
                }
                VerticalLayout {
                    alignment: center; spacing: 3px;
                    Text { text: "Riina"; color: Theme.welcome-title; font-size: 20px; font-weight: 700; }
                    Text { text: "Version " + root.app-version; color: Theme.welcome-version; font-size: 11px; }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    alignment: center; spacing: 12px;
                    WelcomeAction { label: "Open File…"; hint: "Open a media file";
                        activated => { root.open-file(); } }
                    WelcomeAction { label: "Open URL…"; hint: "Open media from a URL";
                        activated => { root.open-url(); } }
                }
            }
            Rectangle { height: 16px; }
            if root.drop-error != "" : Text {
                text: root.drop-error; color: Theme.welcome-url-error; font-size: 11px;
                wrap: word-wrap;
            }
            Rectangle { height: 16px; }
            if root.recent-media.length > 0 : VerticalLayout {
                spacing: 2px; vertical-stretch: 1;
                ResumeMediaEntry {
                    media-title: root.recent-media[0].title;
                    position-label: root.recent-media[0].position-label;
                    selected: root.selection-index < 0;
                    activated => { root.selection-index = -1; root.open-recent(-1); }
                }
                if root.recent-documents.length > 0 : ScrollView {
                    horizontal-stretch: 1; vertical-stretch: 1;
                    VerticalLayout { spacing: 1px;
                        for row[index] in root.recent-documents : RecentMediaEntry {
                            label: row.title; detail: row.position-label;
                            selected: root.selection-index == index;
                            activated => { root.selection-index = index; root.open-recent(index); }
                        }
                    }
                }
            }
        }
        }
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.meta) && event.modifiers.shift
                && !event.modifiers.alt && (event.text == "h" || event.text == "H") {
                root.show-playback-history(); return accept;
            }
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.DownArrow {
                if root.selection-index < root.recent-documents.length - 1 {
                    root.selection-index += 1;
                }
                return accept;
            }
            if event.text == Key.UpArrow {
                if root.selection-index > 0 {
                    root.selection-index -= 1;
                } else if root.selection-index == 0 && root.recent-media.length > 0 {
                    root.selection-index = -1;
                }
                return accept;
            }
            if event.text == Key.Return {
                if root.recent-media.length > 0 || root.recent-documents.length > 0 {
                    root.open-recent(root.selection-index);
                }
                return accept;
            }
            return reject;
        }
    }
}
