import { Theme } from "theme.slint";
export component Tool inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <length> icon-size: 17px;
    in property <length> icon-optical-offset-x: 0px;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> dark-theme: true;
    in property <bool> selected: false;
    in property <bool> circular: false;
    in property <length> circular-size: 34px;
    in property <bool> windows-acrylic-surface: false;
    in property <color> accent-color: Theme.player-focus-accent;
    callback activated();
    in property <bool> pointer-handles-activation: false;
    callback pointer-input(PointerEvent, bool);
    callback focus-entered(length, length);
    width: circular ? circular-size : 30px; height: circular ? circular-size : 28px;
    border-radius: circular ? circular-size / 2 : 5px;
    border-width: circular && windows-acrylic-surface ? 1px : 0px;
    border-color: Theme.player-tool-border(dark-theme);
    background: selected ? Theme.player-tool-selection(dark-theme) :
        touch.has-hover && enabled ? Theme.player-tool-hover(dark-theme, windows-acrylic-surface) :
            circular ? Theme.player-tool-circle(dark-theme, windows-acrylic-surface)
            : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { activated(); } }
    if icon.width == 0 : Text { text: label; color: !enabled ? Theme.player-tool-disabled-glyph : selected ? root.accent-color : Theme.sidebar-action-text(dark-theme, true); font-size: 17px;
        horizontal-alignment: center; vertical-alignment: center; }
    if icon.width > 0 : glyph := Image {
        source: icon; image-fit: contain;
        width: min(root.icon-size, root.width); height: min(root.icon-size, root.height);
        x: (parent.width - self.width) / 2 + root.icon-optical-offset-x;
        y: (parent.height - self.height) / 2;
        colorize: !enabled ? Theme.player-tool-disabled-glyph : selected ? root.accent-color : Theme.sidebar-action-text(dark-theme, true);
    }
    if focus.has-focus : Rectangle {
        border-width: 1px; border-color: root.accent-color;
        border-radius: circular ? circular-size / 2 : 5px; background: transparent;
    }
    focus := FocusScope {
        focus-changed-event => { if self.has-focus { root.focus-entered(root.absolute-position.y, root.height); } }
        enabled: root.enabled;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " {
                root.activated(); return accept;
            }
            return reject;
        }
    }
    // Keep pointer activation above the focus helper in Slint's stacking order;
    // otherwise a mouse press can focus a toolbar item without activating it.
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            if !root.pointer-handles-activation { root.activated(); }
        }
        pointer-event(event) => {
            if root.pointer-handles-activation {
                root.pointer-input(event, self.mouse-x >= 0px && self.mouse-x <= self.width
                    && self.mouse-y >= 0px && self.mouse-y <= self.height);
            }
        }
    }
}
