import { PreferenceActionButton } from "preferences-controls.slint";
import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PluginPreferencesRow, PluginPageIconButton, PluginPreferencesRowView, PluginPageActionButton } from "preferences-plugins.slint";

export component PluginsPreferencesPage inherits ScrollView {
    in-out property <length> scroll-position;
    in property <bool> mica-backdrop-enabled;
    callback plugin-request-github-install();
    callback plugin-request-local-install();
    in property <string> plugin-update-status;
    callback plugin-refresh();
    in property <[PluginPreferencesRow]> plugin-rows;
    pure callback plugin-id-transfer(string) -> data-transfer;
    pure callback plugin-id-from-transfer(data-transfer) -> string;
    callback plugin-enabled-changed(int, bool);
    callback plugin-row-about(int);
    callback plugin-row-actions(int);
    callback plugin-row-uninstall(int);
    callback plugin-row-settings(int);
    callback plugin-reordered(string, string);

    content-width: self.visible-width;
    content-height: max(self.visible-height, 208px + root.plugin-rows.length * 60px);
    content-y <=> root.scroll-position;
    horizontal-scrollbar-policy: always-off;

    Rectangle {
        width: parent.width; height: root.content-height;
        background: Theme.settings-content-surface(root.mica-backdrop-enabled);
        Text { x: 20px; y: 16px; text: @tr("Plugins"); font-size: Theme.settings-page-title-size; font-weight: 600; color: Theme.settings-page-heading; }
        Rectangle {
            x: 12px; y: 52px; width: parent.width - 24px; height: 104px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 13px; background: Theme.settings-network-card-surface(root.mica-backdrop-enabled);
            Text {
                x: 12px; y: 10px; width: parent.width - 24px; height: 42px;
                text: @tr("You can install a new plugin from GitHub or a local .iinaplgz package. Plugins installed from GitHub can be updated automatically.");
                font-size: 11px; color: Theme.settings-section-heading; wrap: word-wrap;
                vertical-alignment: center;
            }
            PluginPageActionButton {
                x: 12px; y: 67px; width: 104px; label: @tr("Get Plugins…");
                activated => { root.plugin-request-github-install(); }
            }
            PluginPageActionButton {
                x: 124px; y: 67px; width: 160px; label: @tr("Install Local Package…");
                activated => { root.plugin-request-local-install(); }
            }
        }
        Text {
            x: 12px; y: 163px; width: parent.width - 56px; height: 28px;
            text: root.plugin-update-status; font-size: 11px; font-weight: 600;
            color: Theme.settings-plugin-status; vertical-alignment: center; overflow: elide;
        }
        PluginPageIconButton {
            x: parent.width - 47px; y: 165px; width: 28px; height: 24px;
            icon-kind: 2; label: @tr("Check for plugin updates");
            activated => { root.plugin-refresh(); }
        }
        if root.plugin-rows.length > 0 : Rectangle {
            x: 12px; y: 196px; width: parent.width - 24px;
            height: root.plugin-rows.length * 60px;
            border-width: 1px; border-color: Theme.settings-card-border; border-radius: 13px; background: Theme.settings-network-card-surface(root.mica-backdrop-enabled);
            for row[index] in root.plugin-rows : PluginPreferencesRowView {
                x: 0px; y: index * 60px; width: parent.width;
                entry: row; row-index: index; last-row: index == root.plugin-rows.length - 1;
                plugin-id-transfer(identifier) => { root.plugin-id-transfer(identifier); }
                plugin-id-from-transfer(transfer) => { root.plugin-id-from-transfer(transfer); }
                enabled-toggled(index, enabled) => { root.plugin-enabled-changed(index, enabled); }
                about-requested(index) => { root.plugin-row-about(index); }
                actions-requested(index) => { root.plugin-row-actions(index); }
                uninstall-requested(index) => { root.plugin-row-uninstall(index); }
                settings-requested(index) => { root.plugin-row-settings(index); }
                reorder-requested(dragged, target) => { root.plugin-reordered(dragged, target); }
            }
        }
    }
}

export component PluginInstallDialog inherits Rectangle {
    in-out property <string> repository;
    in property <bool> installing;
    callback install-requested(string);
    callback cancelled();

    background: Theme.settings-modal-scrim;
    Rectangle {
        x: (parent.width - 440px) / 2; y: (parent.height - 372px) / 2;
        width: 440px; height: 372px;
        border-radius: Theme.settings-modal-corner; border-width: 1px; border-color: Theme.settings-modal-border;
        background: Theme.settings-modal-surface;
        Text { x: 20px; y: 14px; width: parent.width - 40px; height: 22px;
            text: @tr("Get Plugins"); font-size: Theme.settings-modal-title-size; font-weight: 600; color: Theme.settings-modal-title; }
        Text { x: 20px; y: 42px; width: parent.width - 40px; height: 34px;
            text: @tr("Install a plugin from GitHub by entering its repository. Official plugins are listed below.");
            font-size: 11px; color: Theme.settings-modal-message; wrap: word-wrap; }
        Text { x: 20px; y: 82px; width: 80px; height: 26px; text: @tr("GitHub URL");
            font-size: 11px; color: Theme.settings-card-title; vertical-alignment: center; }
        Rectangle { x: 102px; y: 82px; width: parent.width - 122px; height: 26px;
            border-radius: 4px; border-width: 1px; border-color: Theme.settings-field-border; background: Theme.settings-field-surface;
            TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                text <=> root.repository; single-line: true;
                font-size: 11px; color: Theme.settings-modal-title; enabled: !root.installing;
                accessible-label: @tr("GitHub repository URL");
                accepted => { root.install-requested(root.repository); }
            }
        }
        Text { x: 20px; y: 122px; width: parent.width - 40px; height: 18px;
            text: @tr("Official Plugins"); font-size: 11px; font-weight: 600; color: Theme.settings-section-heading; }
        for official[index] in ["Online Media", "Userscript", "OpenSubtitles"] : Rectangle {
            x: 20px; y: 145px + index * 38px; width: parent.width - 40px; height: 34px;
            border-radius: 5px; border-width: 1px; border-color: Theme.settings-card-border; background: Theme.settings-field-surface;
            Text { x: 10px; width: parent.width - 106px; height: parent.height;
                text: official; font-size: 11px; color: Theme.settings-card-title;
                vertical-alignment: center; }
            PluginPageActionButton {
                x: parent.width - 90px; y: 4px; width: 78px; label: @tr("Install");
                enabled: !root.installing;
                activated => {
                    root.repository = index == 0 ? "iina/plugin-online-media" :
                        index == 1 ? "iina/plugin-userscript" : "iina/plugin-opensub";
                    root.install-requested(root.repository);
                }
            }
        }
        Text { x: 20px; y: 265px; width: parent.width - 40px; height: 22px;
            text: root.installing ? @tr("Downloading and validating plugin…") : @tr("Plugins remain disabled until you enable them.");
            font-size: 10px; color: Theme.settings-section-heading; vertical-alignment: center; }
        PreferenceActionButton {
            x: parent.width - 178px; y: 328px; label: @tr("Cancel");
            enabled: !root.installing;
            activated => { root.cancelled(); }
        }
        PreferenceActionButton {
            x: parent.width - 92px; y: 328px; label: @tr("Install");
            enabled: !root.installing && !root.repository.is-empty;
            activated => { root.install-requested(root.repository); }
        }
    }
}
