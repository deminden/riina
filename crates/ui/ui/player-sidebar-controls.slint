import { Theme } from "theme.slint";

export component SidebarTab inherits FocusScope {
    in property <string> label;
    in property <bool> selected;
    in property <bool> dark-theme: true;
    in property <color> accent-color: Theme.sidebar-catalog-accent;
    in property <color> accent-foreground: Theme.sidebar-catalog-accent-text;
    in property <color> focus-accent-color: Theme.player-focus-accent;
    private property <bool> focus-visible: false;
    private property <bool> pointer-focus-request: false;
    callback activated();
    height: 30px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: label;
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-action-default => { activated(); }
    Rectangle {
        border-radius: 5px;
        background: root.selected ? root.accent-color :
            touch.has-hover ? (Theme.sidebar-tab-hover(root.dark-theme)) : transparent;
        border-width: root.has-focus && root.focus-visible ? 1px : 0px;
        border-color: root.selected ? root.accent-foreground : root.focus-accent-color;
        Text { text: root.label; color: root.selected ? root.accent-foreground :
                (Theme.sidebar-inactive-tab-text(root.dark-theme));
            font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea {
            clicked => {
                root.pointer-focus-request = true;
                root.focus();
                root.focus-visible = false;
                root.activated();
            }
        }
    }
    changed has-focus => {
        if self.has-focus && !root.pointer-focus-request { root.focus-visible = true; }
        else if !self.has-focus { root.pointer-focus-request = false; }
    }
    key-pressed(event) => {
        root.pointer-focus-request = false;
        root.focus-visible = true;
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { activated(); return accept; }
        return reject;
    }
}

export component SidebarSectionTitle inherits Rectangle {
    in property <string> label;
    in property <bool> dark-theme: true;
    height: 18px;
    background: transparent;
    HorizontalLayout {
        spacing: 8px; cross-axis-alignment: center;
        leading-rule := Rectangle { height: 1px; background: Theme.sidebar-section-divider(root.dark-theme);
            horizontal-stretch: 1; }
        caption := Text { text: root.label; color: Theme.sidebar-section-caption(root.dark-theme);
            font-size: 12px; font-weight: 700; vertical-alignment: center; }
        trailing-rule := Rectangle { height: 1px; background: Theme.sidebar-section-divider(root.dark-theme);
            horizontal-stretch: 1; }
    }
}

export component SidebarPositionToggle inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    in property <length> icon-size: 16px;
    in property <bool> leading;
    in property <bool> dark-theme: true;
    in property <bool> mini: false;
    in property <color> accent-color: Theme.sidebar-layout-toggle-accent;
    callback changed(bool);
    height: mini ? 16px : 30px;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: leading;
    accessible-action-default => { changed(!leading); }
    HorizontalLayout {
        spacing: 8px; cross-axis-alignment: center;
        if root.icon.width > 0 : symbol := Image {
            source: root.icon; image-fit: contain;
            width: root.icon-size; height: root.icon-size;
            colorize: Theme.sidebar-layout-control-icon(root.dark-theme);
        }
        caption := Text { text: root.label; color: Theme.sidebar-heading-text(root.dark-theme);
            font-size: root.mini ? 11px : 12px; vertical-alignment: center; horizontal-stretch: 1; }
        switch-track := Rectangle {
            width: root.mini ? 36px : 38px; height: root.mini ? 16px : 22px;
            border-radius: self.height / 2;
            background: root.leading ? root.accent-color : (Theme.sidebar-toggle-track(root.dark-theme));
            Rectangle {
                x: root.leading ? parent.width - self.width - 2px : 2px;
                y: (parent.height - self.height) / 2;
                width: root.mini ? 12px : 18px; height: root.mini ? 12px : 18px;
                border-radius: self.height / 2;
                background: Theme.sidebar-toggle-thumb;
            }
        }
    }
    TouchArea { clicked => { root.changed(!root.leading); } }
    if root.has-focus : Rectangle {
        background: transparent; border-width: 1px;
        border-color: root.accent-color; border-radius: 3px;
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { changed(!leading); return accept; }
        return reject;
    }
}

export component SidebarSideChoice inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    in property <bool> leading;
    in property <bool> dark-theme: true;
    in property <color> accent-color: Theme.sidebar-layout-choice-accent;
    in property <color> accent-foreground: Theme.sidebar-catalog-accent-text;
    callback changed(bool);
    height: 24px;
    accessible-role: checkbox;
    accessible-label: label + " on leading side";
    accessible-checkable: true;
    accessible-checked: leading;
    accessible-action-default => { changed(!leading); }
    HorizontalLayout {
        spacing: 8px; cross-axis-alignment: center;
        symbol := Image { source: root.icon; image-fit: contain; width: 16px; height: 16px;
            colorize: Theme.sidebar-layout-control-icon(root.dark-theme); }
        caption := Text { text: root.label; color: Theme.sidebar-heading-text(root.dark-theme);
            font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
        switch-track := Rectangle {
            width: 58px; height: 24px; border-radius: 7px;
            background: Theme.sidebar-layout-stepper-surface(root.dark-theme);
            HorizontalLayout {
                padding: 2px; spacing: 2px;
                for side in [true, false] : Rectangle {
                    width: 25px; height: 20px; border-radius: 5px;
                    background: (root.leading == side) ? root.accent-color : transparent;
                    Rectangle {
                        x: 5px; y: 4px; width: 15px; height: 12px;
                        border-radius: 2px; border-width: 1px;
                        border-color: (root.leading == side) ? root.accent-foreground :
                            (Theme.sidebar-layout-stepper-glyph(root.dark-theme));
                        background: transparent;
                        Rectangle {
                            x: side ? 1px : parent.width - 3px;
                            width: 2px; height: parent.height - 2px;
                            background: (root.leading == side) ? root.accent-foreground :
                                (Theme.sidebar-layout-stepper-glyph(root.dark-theme));
                        }
                    }
                    TouchArea { clicked => { root.changed(side); } }
                }
            }
        }
    }
    if root.has-focus : Rectangle {
        background: transparent; border-width: 1px;
        border-color: root.accent-color; border-radius: 3px;
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.LeftArrow { changed(true); return accept; }
        if event.text == Key.RightArrow { changed(false); return accept; }
        if event.text == Key.Return || event.text == " " { changed(!leading); return accept; }
        return reject;
    }
}

export component SubtitleVisibilityRow inherits FocusScope {
    in property <string> label;
    in property <string> number;
    in property <bool> checked;
    in property <bool> dark-theme: true;
    in property <color> accent-color: Theme.sidebar-layout-choice-accent;
    callback changed(bool);
    height: 16px;
    accessible-role: checkbox;
    accessible-label: label + " subtitles";
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { if root.enabled { changed(!checked); } }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 16px; height: 16px; border-radius: 3px;
            background: Theme.sidebar-layout-control-icon(root.dark-theme);
            Text { text: root.number; color: Theme.sidebar-layout-stepper-number(root.dark-theme);
                font-size: 10px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { text: root.label; color: Theme.sidebar-heading-text(root.dark-theme);
            font-size: 12px; font-weight: 700; vertical-alignment: center;
            horizontal-stretch: 1; }
        Rectangle {
            width: 36px; height: 16px; border-radius: 8px;
            background: root.checked ? root.accent-color
                : Theme.sidebar-toggle-track(root.dark-theme);
            animate background { duration: Theme.sidebar-toggle-motion; }
            Rectangle {
                x: root.checked ? parent.width - self.width - 2px : 2px;
                y: 2px; width: 12px; height: 12px; border-radius: 6px;
                background: Theme.sidebar-toggle-thumb;
                animate x { duration: Theme.sidebar-toggle-motion; }
            }
        }
    }
    TouchArea { enabled: root.enabled; clicked => { root.focus(); root.changed(!root.checked); } }
    key-pressed(event) => {
        if !root.enabled { return reject; }
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { changed(!checked); return accept; }
        return reject;
    }
}

export component SidebarAction inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    in property <bool> dark-theme: true;
    in property <bool> windows-acrylic-surface: false;
    in property <color> accent-color: Theme.player-focus-accent;
    callback activated();
    height: 32px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { activated(); } }
    Rectangle {
        border-radius: 5px;
        background: Theme.sidebar-action-button-surface(root.dark-theme, root.windows-acrylic-surface, touch.has-hover && root.enabled);
        Image { source: root.icon; image-fit: contain; x: 8px; y: 8px;
            width: 16px; height: 16px;
            colorize: !root.enabled ? Theme.player-tool-disabled-glyph :
                (Theme.sidebar-heading-text(root.dark-theme || !root.windows-acrylic-surface)); }
        Text { x: 32px; width: parent.width - 38px; text: root.label;
            color: !root.enabled ? Theme.player-tool-disabled-glyph :
                (Theme.sidebar-heading-text(root.dark-theme || !root.windows-acrylic-surface));
            font-size: 12px; vertical-alignment: center; }
        if root.has-focus : Rectangle { border-width: 1px; border-color: root.accent-color;
            border-radius: 5px; background: transparent; }
        touch := TouchArea { enabled: root.enabled; clicked => { root.focus(); root.activated(); } }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { if root.enabled { activated(); } return accept; }
        return reject;
    }
}

export component SubtitleLaneSegment inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> selected;
    in property <bool> dark-theme: true;
    in property <bool> windows-acrylic-surface: false;
    in property <color> accent-color: Theme.sidebar-catalog-accent;
    in property <color> accent-foreground: Theme.sidebar-catalog-accent-text;
    in property <color> focus-accent-color: Theme.player-focus-accent;
    callback activated();
    height: 24px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: selected ? accent-color
        : touch.has-hover
            ? (windows-acrylic-surface
                ? (Theme.sidebar-input-surface(root.dark-theme, true))
                : (Theme.sidebar-inline-button-surface(root.dark-theme)))
            : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { activated(); }
    Text { text: label; font-size: 12px;
        color: root.selected ? root.accent-foreground : Theme.sidebar-action-text(root.dark-theme, true);
        horizontal-alignment: center; vertical-alignment: center; }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: root.focus-accent-color;
        border-radius: 4px; background: transparent; }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            // Lane choice is idempotent; modified player shortcuts still bubble.
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}
