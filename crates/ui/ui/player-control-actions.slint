
// Key, pointer, and transport intents are dispatched by the active player.
export enum PlayerPluginPointerPhase { down, up, move, cancel }
export enum ControllerArrowPhase { pressed, released, cancelled, activated }

export global PlayerControlActions {
    in-out property <string> held-control-key;
    callback open-application-menu();
    callback timeline-hovered(float);
    callback timeline-gesture(bool);
    callback seek-timeline(float);
    callback toggle-time-display();
    callback select-time-precision(int);
    callback publish-controller-options();
    callback refresh-controller-options();
    callback controller-snap-aligned();
    callback controller-arrow(bool, ControllerArrowPhase);
    callback controller-arrow-pressure(int) -> bool;
    callback reset-controller-arrow();
    callback activate-saved-filter-shortcut(string, bool, bool, bool, bool) -> bool;
    callback dispatch-key-binding(string, bool, bool, bool, bool, bool) -> bool;
    callback begin-plugin-key(string, bool, bool, bool, bool, bool, bool) -> bool;
    callback finish-plugin-key() -> bool;
    callback plugin-pointer(PlayerPluginPointerPhase, string, float, float, int) -> bool;
    callback plugin-overlay-pointer(PlayerPluginPointerPhase, int, float, float) -> bool;
    callback plugin-pointer-location(float, float);
    callback set-paused(bool);
    callback execute-mpv-input-action(string);
    callback open-mpv-console();
    callback forward-mpv-script-key(string, bool, bool, bool, bool, bool) -> bool;
    callback mpv-console-keys-ready();
    in-out property <bool> mpv-console-ready;
    callback take-key-screenshot(string);
    callback set-volume(float);
    callback subtitle-seek(int);
    callback adjust-subtitle-scale(float);
    callback adjust-subtitle-position(float);
    callback activity();
    callback single-click-action(int);
    callback double-click-action(int);
    callback mouse-button-action(int);
    callback scroll-action-request(float, float) -> bool;
    callback seek-scroll-action-request(float, float) -> bool;
    callback volume-scroll-action-request(float, float) -> bool;
    callback show-seek-osd();
    callback show-video-osd();
    callback set-ab-loop-point(int, float);
}
