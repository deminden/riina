        x: 3px; y: 1px; width: parent.width - 6px; height: parent.height - 2px;
        text <=> root.text;
        font-size: root.font-size;
        color: root.enabled ? #222222 : #8d8d92;
        enabled: root.enabled;
        accepted => { root.accepted(); }
    }
}

component LanguageTokenEditor inherits Rectangle {
    in property <[string]> tokens;
    in-out property <string> draft: "";
    callback add-token(string);
    callback remove-token(int);
    border-radius: 2px;
    border-width: 1px;
    border-color: #b8b8bc;
    background: #ffffff;

    ScrollView {
        x: 2px; y: 1px; width: parent.width - 4px; height: parent.height - 2px;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        HorizontalLayout {
            width: root.tokens.length * 48px + 70px;
            height: parent.height;
            spacing: 3px;
            for token[index] in root.tokens : Rectangle {
                width: 45px; height: 18px;
                border-radius: 9px; background: #e9e9ec;
                accessible-role: list-item;
                accessible-label: token;
                Text { x: 5px; y: 0px; width: 26px; height: parent.height;
                    text: token; font-size: 10px; color: #303036;
                    vertical-alignment: center; overflow: elide; }
                Rectangle { x: 30px; y: 2px; width: 13px; height: 14px;
                    border-radius: 7px; background: transparent;
                    Text { x: 0px; y: 0px; width: parent.width; height: parent.height;
                        text: "×"; font-size: 11px; color: #66666d;
                        horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        accessible-role: button;
                        accessible-label: "Remove preferred language " + token;
                        clicked => { root.remove-token(index); }
                    }
                }
            }
            TextInput {
                width: 64px; height: parent.height;
                text <=> root.draft;
                font-size: 10px; color: #222222;
                accepted => {
                    if root.draft != "" {
                        root.add-token(root.draft);
                        root.draft = "";
                    }
                }
            }
        }
    }
}

