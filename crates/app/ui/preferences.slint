import { CheckBox, ComboBox } from "std-widgets.slint";

// Original controls follow the reference General screenshot section's 120px
// label column. Toolkit metrics remain provisional until rendered comparison.
export component PreferencesWindow inherits Window {
    title: "Preferences";
    preferred-width: 520px;
    preferred-height: 260px;
    background: #ededed;
    in-out property <int> format-index: 0;
    in-out property <bool> include-subtitles: true;
    in-out property <bool> show-preview: true;
    callback settings-changed();
    Text { x: 20px; y: 16px; text: "General"; font-size: 15px; font-weight: 600; color: #222222; }
    Rectangle { x: 20px; y: 52px; width: 480px; height: 184px; background: transparent;
        Text { x: 0px; y: 8px; text: "Screenshots:"; font-weight: 600; font-size: 13px; color: #222222; }
        Text { x: 137px; y: 56px; text: "Format:"; font-size: 13px; color: #222222; }
        ComboBox {
            x: 194px; y: 52px; width: 132px; height: 24px;
            model: ["PNG", "JPEG (.jpg)", "JPEG (.jpeg)", "WebP (.webp)", "JPEG XL (.jxl)"];
            current-index <=> root.format-index;
            selected => { root.settings-changed(); }
        }
        CheckBox { x: 120px; y: 136px; height: 24px; text: "Include subtitles";
            checked <=> root.include-subtitles;
            toggled => { root.settings-changed(); }
        }
        CheckBox { x: 120px; y: 160px; height: 24px; text: "Show previews after taking screenshots";
            checked <=> root.show-preview;
            toggled => { root.settings-changed(); }
        }
    }
}
