                PreferenceSwitch { height: 28px; label: "On-Screen Display";
                    checked <=> root.liquid-glass-osd;
                    toggled => { root.settings-changed(); }
                }
                PreferenceSwitch { height: 28px; label: "On-Screen Controller";
                    checked <=> root.liquid-glass-osc;
                    toggled => { root.settings-changed(); }
                }
                PreferenceSwitch { height: 28px; label: "Sidebar";
                    checked <=> root.liquid-glass-sidebar;
                    toggled => { root.settings-changed(); }
