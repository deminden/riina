import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { PlayerSlider, SubtitleColorWell } from "shared-controls.slint";

// Native toolkit button padding can consume a 24px chooser's entire label.
// Keep this small reference control explicit, including keyboard activation.
component FolderChooser inherits FocusScope {
    callback activated();
    accessible-role: button;
    accessible-label: "Choose screenshot save path";
    accessible-action-default => { if root.enabled { root.activated(); } }
    key-pressed(event) => {
        if root.enabled && (event.text == Key.Return || event.text == " ") {
            root.activated(); return accept;
        }
        return reject;
    }
    Rectangle { width: parent.width; height: parent.height;
        border-radius: 4px;
        background: root.enabled ? (touch.pressed ? #dddddd : #fafafa) : #eeeeee;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? #168bff : #b8b8b8;
        Text { text: "…"; font-size: 13px; color: root.enabled ? #222222 : #999999;
            horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea { enabled: root.enabled;
            clicked => { root.focus(); root.activated(); } }
    }
}

component PreferenceNavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback activated();
    height: 36px;
    horizontal-stretch: 1;
    border-radius: 5px;
    background: selected ? #c9c9cf : touch.has-hover ? #ffffffb8 : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { root.activated(); }
    Text { x: 30px; width: parent.width - 40px; height: parent.height;
        text: root.label; font-size: 13px; color: #242428;
        vertical-alignment: center; }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

component OverrideLaneButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback activated();
    width: 150px;
    height: 21px;
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { root.activated(); }
    Rectangle {
        border-radius: 4px;
        background: root.selected ? #d0d0d5 : touch.has-hover ? #ffffffb8 : transparent;
        border-width: focus.has-focus ? 1px : 0px;
        border-color: #168bff;
        Text { text: root.label; font-size: 11px; color: #242428;
            horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

component PreferenceActionButton inherits Rectangle {
    in property <string> label;
    callback activated();
    width: 78px;
    height: 24px;
    border-radius: 4px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? #168bff : #b8b8b8;
    background: touch.pressed ? #d9d9dd : #f7f7f8;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
    Text { text: root.label; font-size: 11px; color: #222222;
        horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

// AppKit draws number formatters as bounded editable cells; give shared values
// the same visible affordance even when the Windows widget theme omits a bezel.
component PreferenceNumericInput inherits Rectangle {
    in-out property <string> text: "";
    in property <length> font-size: 11px;
    callback accepted();
    border-radius: 2px;
    border-width: 1px;
    border-color: #b8b8bc;
    background: #ffffff;
    TextInput {
        x: 3px; y: 1px; width: parent.width - 6px; height: parent.height - 2px;
        text <=> root.text;
        font-size: root.font-size;
        color: #222222;
        accepted => { root.accepted(); }
    }
}

component PreferenceDisclosure inherits FocusScope {
    in property <string> label;
    in property <bool> expanded: false;
    callback toggled();
    width: 480px;
    height: 21px;
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: expanded;
    accessible-action-default => { root.toggled(); }
    Text { x: 0; y: 0; width: 13px; height: parent.height;
        text: root.expanded ? "▾" : "▸";
        font-size: 11px; color: #44444a; vertical-alignment: center;
    }
    Text { x: 15px; y: 0; width: parent.width - 15px; height: parent.height;
        text: root.label; font-size: 13px; color: #222222;
        vertical-alignment: center;
    }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #168bff;
        border-radius: 3px; background: transparent;
    }
    touch := TouchArea { clicked => { focus.focus(); root.toggled(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
            if event.text == Key.Return || event.text == " " {
                root.toggled(); return accept;
            }
            return reject;
        }
    }
}

component AssOverrideSlider inherits Rectangle {
    in property <float> value: 2;
    callback changed(float);
    width: 124px;
    height: 20px;
    background: transparent;
    accessible-role: slider;
    accessible-label: "ASS subtitle override level";
    accessible-value: value;
    accessible-value-minimum: 0;
    accessible-value-maximum: 4;
    accessible-value-step: 1;
    accessible-action-set-value(text) => {
        if text.is-float() { root.changed(round(clamp(text.to-float(), 0, 4))); }
    }
    accessible-action-increment => { root.changed(min(4, value + 1)); }
    accessible-action-decrement => { root.changed(max(0, value - 1)); }
    Rectangle { x: 7px; y: 7px; width: parent.width - 14px; height: 2px;
        border-radius: 1px; background: #a7a7ad; }
    Rectangle { x: 7px; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: parent.width * 0.25; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: parent.width * 0.5; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: parent.width * 0.75; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: parent.width - 7px; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: 4px + (parent.width - 8px) * root.value / 4; y: 3px;
        width: 7px; height: 8px; border-radius: 3px; background: #55555d; }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #168bff;
        border-radius: 4px; background: transparent; }
    touch := TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                focus.focus();
                root.changed(round(clamp((self.mouse-x - 4px) / (root.width - 8px), 0, 1) * 4));
            }
        }
        moved => { if self.pressed {
            root.changed(round(clamp((self.mouse-x - 4px) / (root.width - 8px), 0, 1) * 4));
        } }
    }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.RightArrow { root.changed(min(4, root.value + 1)); return accept; }
            if event.text == Key.LeftArrow { root.changed(max(0, root.value - 1)); return accept; }
            return reject;
        }
    }
}

// Original controls follow the reference General screenshot section's 120px
// label column. Toolkit metrics remain provisional until rendered comparison.
export component PreferencesWindow inherits Window {
    title: "Settings";
    preferred-width: 820px;
    preferred-height: 480px;
    min-width: 820px;
    min-height: 320px;
    background: #ededed;
    in-out property <int> selected-pane: 0;
    in-out property <int> osc-position: 0;
    in-out property <int> hardware-decoder-index: 1;
    in-out property <int> subtitle-ass-override-lane: 0;
    in-out property <int> subtitle-ass-override-primary-index: 2;
    in-out property <int> subtitle-ass-override-secondary-index: 2;
    in-out property <int> subtitle-align-x-index: 1;
    in-out property <int> subtitle-align-y-index: 2;
    in-out property <string> subtitle-position-text: "100";
    in-out property <bool> subtitle-display-in-letterbox: true;
    in-out property <bool> subtitle-scale-with-window: true;
    in-out property <string> subtitle-margin-x-text: "25";
    in-out property <string> subtitle-margin-y-text: "22";
    in-out property <string> subtitle-preferred-languages-text: "";
    in-out property <int> subtitle-encoding-index: 0;
    in property <[string]> subtitle-encoding-options;
    in-out property <int> subtitle-auto-load-mode-index: 2;
    in property <[string]> subtitle-auto-load-mode-options;
    in-out property <string> subtitle-auto-load-priority-text;
    in-out property <string> subtitle-search-paths-text: "./*";
    in-out property <bool> subtitle-auto-load-advanced-expanded: false;
    in-out property <string> subtitle-font: "sans-serif";
    in-out property <string> subtitle-font-size-text: "55";
    in-out property <color> subtitle-text-color: #ffffff;
    in-out property <bool> subtitle-bold: false;
    in-out property <bool> subtitle-italic: false;
    in-out property <color> subtitle-background-color: #00000000;
    in-out property <string> subtitle-outline-size-text: "3";
    in-out property <color> subtitle-outline-color: #000000;
    in-out property <string> subtitle-shadow-offset-text: "0";
    in-out property <color> subtitle-shadow-color: #00000000;
    in-out property <string> subtitle-blur-text: "0";
    in-out property <string> subtitle-spacing-text: "0";
    in-out property <bool> subtitle-text-advanced-expanded: false;
    in-out property <bool> volume-boost: false;
    in-out property <bool> compact-ui: false;
    in-out property <bool> docked-controls: false;
    in-out property <bool> edge-to-edge-video: true;
    in-out property <bool> osd-enabled: true;
    in-out property <bool> disable-osd-speed: false;
    in-out property <bool> disable-osd-seek: false;
    in-out property <int> format-index: 0;
    in-out property <bool> include-subtitles: true;
    in-out property <bool> show-preview: true;
    in-out property <bool> save-to-file: true;
    in-out property <bool> copy-to-clipboard: false;
    in-out property <bool> pause-when-open: false;
    in-out property <bool> fullscreen-when-open: false;
    in-out property <bool> resume-last-position: true;
    callback settings-changed();
    callback choose-folder();
    callback choose-subtitle-font();
    in-out property <string> directory;
    in-out property <bool> custom-directory: false;
    in-out property <bool> folder-dialog-open: false;
    // IINA v1.5.0 enables its newer settings window by default; preserve its
    // page order even while some individual Riina pages are still in progress.
    Rectangle { x: 0; y: 0; width: 200px; height: parent.height; background: #e3e3e7;
        PreferenceNavItem { x: 10px; y: 52px; width: 180px; label: "General";
            selected: root.selected-pane == 0; activated => { root.selected-pane = 0; } }
        PreferenceNavItem { x: 10px; y: 88px; width: 180px; label: "UI";
            selected: root.selected-pane == 1; activated => { root.selected-pane = 1; } }
        PreferenceNavItem { x: 10px; y: 124px; width: 180px; label: "Video";
            selected: root.selected-pane == 2; activated => { root.selected-pane = 2; } }
        PreferenceNavItem { x: 10px; y: 160px; width: 180px; label: "Audio";
            selected: root.selected-pane == 3; activated => { root.selected-pane = 3; } }
        PreferenceNavItem { x: 10px; y: 196px; width: 180px; label: "Subtitles";
            selected: root.selected-pane == 4; activated => { root.selected-pane = 4; } }
        PreferenceNavItem { x: 10px; y: 232px; width: 180px; label: "Network";
            selected: root.selected-pane == 5; activated => { root.selected-pane = 5; } }
        PreferenceNavItem { x: 10px; y: 268px; width: 180px; label: "Control";
            selected: root.selected-pane == 6; activated => { root.selected-pane = 6; } }
        PreferenceNavItem { x: 10px; y: 304px; width: 180px; label: "Key Bindings";
            selected: root.selected-pane == 7; activated => { root.selected-pane = 7; } }
        PreferenceNavItem { x: 10px; y: 340px; width: 180px; label: "Advanced";
            selected: root.selected-pane == 8; activated => { root.selected-pane = 8; } }
        PreferenceNavItem { x: 10px; y: 376px; width: 180px; label: "Plugin";
            selected: root.selected-pane == 9; activated => { root.selected-pane = 9; } }
        PreferenceNavItem { x: 10px; y: 412px; width: 180px; label: "Utilities";
            selected: root.selected-pane == 10; activated => { root.selected-pane = 10; } }
    }
    if root.selected-pane == 0 : ScrollView {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        content-height: 386px;
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        Rectangle {
        width: parent.width; height: 386px; background: #ededed;
        Text { x: 22px; y: 16px; text: "General"; font-size: 15px; font-weight: 600; color: #222222; }
        Rectangle { x: 20px; y: 52px; width: 480px; height: 64px; background: transparent;
        Text { x: 0px; y: 8px; text: "Behavior:"; font-weight: 600; font-size: 13px; color: #222222; }
        Text { x: 118px; y: 8px; text: "When media is opened:"; font-size: 13px; color: #222222; }
        CheckBox { x: 120px; y: 28px; height: 24px; text: "Pause";
            checked <=> root.pause-when-open;
            toggled => { root.settings-changed(); }
        }
        CheckBox { x: 187px; y: 28px; height: 24px; text: "Enter fullscreen";
            checked <=> root.fullscreen-when-open;
            toggled => { root.settings-changed(); }
        }
        }
        Rectangle { x: 20px; y: 132px; width: 480px; height: 184px; background: transparent;
        Text { x: 0px; y: 8px; text: "Screenshots:"; font-weight: 600; font-size: 13px; color: #222222; }
        Text { x: 118px; y: 8px; text: "Destination:"; font-size: 13px; color: #222222; }
        Text { x: 118px; y: 112px; text: "Options:"; font-size: 13px; color: #222222; }
        CheckBox { x: 120px; y: 28px; height: 24px; text: "Save to";
            checked <=> root.save-to-file;
            toggled => { root.settings-changed(); }
        }
        Text { x: 198px; y: 32px; width: 154px; text: root.directory;
            overflow: elide; font-size: 13px; color: #666666; }
        FolderChooser { x: 357px; y: 29px; width: 24px; height: 22px;
            enabled: root.save-to-file && !root.folder-dialog-open;
            activated => { root.choose-folder(); } }
        Text { x: 137px; y: 56px; text: "Format:"; font-size: 13px; color: #222222; }
        ComboBox {
            x: 194px; y: 52px; width: 132px; height: 24px;
            model: ["PNG", "JPEG (.jpg)", "JPEG (.jpeg)", "WebP (.webp)", "JPEG XL (.jxl)"];
            current-index <=> root.format-index;
            enabled: root.save-to-file;
            selected => { root.settings-changed(); }
        }
        CheckBox { x: 120px; y: 80px; height: 24px; text: "Copy to clipboard";
            checked <=> root.copy-to-clipboard;
            toggled => { root.settings-changed(); }
        }
        CheckBox { x: 120px; y: 136px; height: 24px; text: "Include subtitles";
            checked <=> root.include-subtitles;
            toggled => { root.settings-changed(); }
        }
        CheckBox { x: 120px; y: 160px; height: 24px; text: "Show previews after taking screenshots";
            checked <=> root.show-preview;
            toggled => { root.settings-changed(); }
        }
        }
        Rectangle { x: 20px; y: 326px; width: 480px; height: 48px; background: transparent;
            Text { x: 0px; y: 8px; text: "History:"; font-weight: 600; font-size: 13px; color: #222222; }
            CheckBox { x: 120px; y: 4px; height: 24px; text: "Resume last position";
                checked <=> root.resume-last-position;
                toggled => { root.settings-changed(); }
            }
        }
        }
    }
    if root.selected-pane == 1 : Rectangle {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        background: #ededed;
        Text { x: 22px; y: 16px; text: "UI"; font-size: 15px; font-weight: 600; color: #222222; }
        Rectangle { x: 20px; y: 52px; width: 576px; height: 138px; background: transparent;
            Text { x: 0; y: 8px; text: "On-Screen Controller:";
                font-weight: 600; font-size: 13px; color: #222222; }
            ComboBox { x: 160px; y: 4px; width: 150px; height: 24px;
                model: ["Floating", "Top", "Bottom"];
                current-index <=> root.osc-position;
                selected => { root.settings-changed(); }
            }
            CheckBox { x: 160px; y: 42px; height: 24px; text: "Compact interface";
                checked <=> root.compact-ui;
                toggled => { root.settings-changed(); }
            }
            CheckBox { x: 160px; y: 72px; height: 24px; text: "Dock control bar and titlebar";
                checked <=> root.docked-controls;
                enabled: !root.edge-to-edge-video;
                toggled => { root.settings-changed(); }
            }
        }
        Rectangle { x: 20px; y: 204px; width: 350px; height: 92px; background: transparent;
            Text { x: 0; y: 8px; text: "On-Screen Display:";
                font-weight: 600; font-size: 13px; color: #222222; }
            CheckBox { x: 160px; y: 4px; height: 24px; text: "Show OSD messages";
                checked <=> root.osd-enabled;
                toggled => { root.settings-changed(); }
            }
            CheckBox { x: 160px; y: 32px; height: 24px; text: "Suppress speed messages";
                checked <=> root.disable-osd-speed;
                toggled => { root.settings-changed(); }
            }
            CheckBox { x: 160px; y: 60px; height: 24px; text: "Suppress seek messages";
                checked <=> root.disable-osd-seek;
                toggled => { root.settings-changed(); }
            }
        }
    }
    if root.selected-pane == 2 : Rectangle {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        background: #ededed;
        Text {
            x: 22px; y: 16px; text: "Video";
            font-size: 15px; font-weight: 600; color: #222222;
        }
        Rectangle { x: 20px; y: 52px; width: 576px; height: 92px; background: transparent;
            Text { x: 0; y: 8px; text: "Video:";
                font-weight: 600; font-size: 13px; color: #222222; }
            Text { x: 98px; y: 8px; text: "Hardware decoder:";
                font-size: 13px; color: #222222; }
            ComboBox { x: 220px; y: 4px; width: 150px; height: 24px;
                model: ["Disabled", "Auto", "Auto (Copy)"];
                current-index <=> root.hardware-decoder-index;
                selected => { root.settings-changed(); }
            }
        }
    }
    if root.selected-pane == 4 : ScrollView {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        content-height: 850px;
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        Rectangle { width: parent.width;
        height: 1050px;
        background: #ededed;
        Text { x: 22px; y: 16px; text: "Subtitles"; font-size: 15px; font-weight: 600; color: #222222; }
        Rectangle { x: 20px; y: 52px; width: 480px; height: 193px; background: transparent;
            Text { x: 0; y: 8px; text: "Auto Load:";
                font-weight: 600; font-size: 13px; color: #222222; }
            ComboBox { x: 98px; y: 4px; width: 255px; height: 25px;
                model: root.subtitle-auto-load-mode-options;
                current-index <=> root.subtitle-auto-load-mode-index;
                selected => { root.settings-changed(); }
            }
            PreferenceDisclosure { x: 98px; y: 38px;
                label: "Advanced"; expanded: root.subtitle-auto-load-advanced-expanded;
                toggled => { root.subtitle-auto-load-advanced-expanded = !root.subtitle-auto-load-advanced-expanded; }
            }
            if root.subtitle-auto-load-advanced-expanded : Rectangle {
                x: 98px; y: 58px; width: 366px; height: 132px; background: transparent;
                Text { x: -2px; y: 13px; text: "Subtitles have priority when filename containing:";
                    font-size: 10px; color: #222222; }
                Rectangle { x: 0; y: 22px; width: 360px; height: 19px;
                    border-width: 1px; border-color: #b8b8bc; border-radius: 2px;
                    background: #ffffff;
                    TextInput { x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
                        text <=> root.subtitle-auto-load-priority-text;
                        font-size: 11px; color: #222222;
                        accepted => { root.settings-changed(); }
                    }
                }
                Text { x: -2px; y: 43px; text: "Please enter a comma-separated list of strings.";
                    font-size: 10px; color: #77777d; }
                Text { x: -2px; y: 65px; text: "Also search subtitles in following directories:";
                    font-size: 10px; color: #222222; }
                Rectangle { x: 0; y: 83px; width: 360px; height: 19px;
                    border-width: 1px; border-color: #b8b8bc; border-radius: 2px;
                    background: #ffffff;
                    TextInput { x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
                        text <=> root.subtitle-search-paths-text;
                        font-size: 11px; color: #222222;
                        accepted => { root.settings-changed(); }
                    }
                }
            }
        }
        Rectangle { x: 20px; y: 245px; width: 480px; height: 99px; background: transparent;
            Text { x: 0; y: 8px; text: "ASS Subtitles:";
                font-weight: 600; font-size: 13px; color: #222222; }
            Rectangle { x: 98px; y: 6px; width: 366px; height: 89px;
                border-width: 1px; border-color: #c4c4c8; border-radius: 4px;
                background: #f1f1f3;
                OverrideLaneButton { x: 49px; y: 10px; label: "Primary Subtitles";
                    selected: root.subtitle-ass-override-lane == 0;
                    activated => { root.subtitle-ass-override-lane = 0; }
                }
                OverrideLaneButton { x: 201px; y: 10px; label: "Secondary Subtitles";
                    selected: root.subtitle-ass-override-lane == 1;
                    activated => { root.subtitle-ass-override-lane = 1; }
                }
                Text { x: 41px; y: 40px; text: "Override level:";
                    font-size: 12px; color: #222222; vertical-alignment: center; }
                AssOverrideSlider { x: 137px; y: 36px;
                    value: root.subtitle-ass-override-lane == 0 ? root.subtitle-ass-override-primary-index : root.subtitle-ass-override-secondary-index;
                    changed(value) => {
                        if root.subtitle-ass-override-lane == 0 {
                            root.subtitle-ass-override-primary-index = value;
                        } else {
                            root.subtitle-ass-override-secondary-index = value;
                        }
                        root.settings-changed();
                    }
                }
                Text { x: 269px; y: 40px; width: 50px;
                    text: (root.subtitle-ass-override-lane == 0 ? root.subtitle-ass-override-primary-index : root.subtitle-ass-override-secondary-index) == 0 ? "no" :
                        (root.subtitle-ass-override-lane == 0 ? root.subtitle-ass-override-primary-index : root.subtitle-ass-override-secondary-index) == 1 ? "yes" :
                        (root.subtitle-ass-override-lane == 0 ? root.subtitle-ass-override-primary-index : root.subtitle-ass-override-secondary-index) == 2 ? "scale" :
                        (root.subtitle-ass-override-lane == 0 ? root.subtitle-ass-override-primary-index : root.subtitle-ass-override-secondary-index) == 3 ? "force" : "strip";
                    font-family: "monospace"; font-size: 11px; color: #222222;
                    vertical-alignment: center;
                }
                Text { x: 10px; y: 62px; width: parent.width - 20px; height: 20px;
                    text: root.subtitle-ass-override-lane == 0 ?
                        (root.subtitle-ass-override-primary-index == 0 ? "Render subtitles as specified by their scripts, without overrides." :
                        root.subtitle-ass-override-primary-index == 1 ? "Apply all style settings in this section." :
                        root.subtitle-ass-override-primary-index == 2 ? "Apply scale together with the style settings in this section." :
                        root.subtitle-ass-override-primary-index == 3 ? "Apply all subtitle styles." : "Remove all ASS tags and styles.") :
                        (root.subtitle-ass-override-secondary-index == 0 ? "Render subtitles as specified by their scripts, without overrides." :
                        root.subtitle-ass-override-secondary-index == 1 ? "Apply all style settings in this section." :
                        root.subtitle-ass-override-secondary-index == 2 ? "Apply scale together with the style settings in this section." :
                        root.subtitle-ass-override-secondary-index == 3 ? "Apply all subtitle styles." : "Remove all ASS tags and styles.");
                    font-size: 10px; color: #77777d; vertical-alignment: center;
                }
            }
        }
        Rectangle { x: 20px; y: 359px; width: 480px; height: 115px; background: transparent;
            Text { x: 0; y: 8px; text: "Text Subtitles:";
                font-weight: 600; font-size: 13px; color: #222222; }
            Rectangle { x: 98px; y: 4px; width: 366px; height: 105px;
                border-width: 1px; border-color: #c4c4c8; border-radius: 4px;
                background: #f1f1f3;
                Text { x: 12px; y: 5px; text: "Font";
                    font-size: 11px; font-weight: 600; color: #55555d; }
                Text { x: 16px; y: 28px; text: "Font:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                Text { x: 60px; y: 25px; width: 186px; height: 20px;
                    text: root.subtitle-font; overflow: elide;
                    font-size: 11px; color: #666666; vertical-alignment: center;
                }
                PreferenceActionButton { x: 278px; y: 22px; label: "Choose...";
                    activated => { root.choose-subtitle-font(); }
                }
                Text { x: 16px; y: 60px; text: "Size:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                PreferenceNumericInput { x: 60px; y: 55px; width: 38px; height: 24px;
                    text <=> root.subtitle-font-size-text;
                    accepted => { root.settings-changed(); }
                }
                CheckBox { x: 104px; y: 55px; width: 54px; height: 24px;
                    text: "Bold"; checked <=> root.subtitle-bold;
                    toggled => { root.settings-changed(); }
                }
                CheckBox { x: 168px; y: 55px; width: 55px; height: 24px;
                    text: "Italic"; checked <=> root.subtitle-italic;
                    toggled => { root.settings-changed(); }
                }
                Text { x: 16px; y: 87px; text: "Color:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                SubtitleColorWell { x: 60px; y: 80px; observed-color: root.subtitle-text-color;
                    hint: "Subtitle text color";
                    edited(value) => { root.subtitle-text-color = value; root.settings-changed(); }
                }
                Text { x: 116px; y: 87px; text: "Background:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                SubtitleColorWell { x: 188px; y: 80px; observed-color: root.subtitle-background-color;
                    hint: "Subtitle background color";
                    edited(value) => {
                        root.subtitle-background-color = value;
                        root.subtitle-shadow-color = value;
                        root.settings-changed();
                    }
                }
            }
        }
        Rectangle { x: 20px; y: 484px; width: 480px; height: 58px; background: transparent;
            Text { x: 0; y: 8px; text: "Border:";
                font-weight: 600; font-size: 13px; color: #222222; }
            Rectangle { x: 98px; y: 0; width: 366px; height: 56px;
                border-width: 1px; border-color: #c4c4c8; border-radius: 4px;
                background: #f1f1f3;
                Text { x: 12px; y: 21px; text: "Size:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                PreferenceNumericInput { x: 52px; y: 15px; width: 38px; height: 24px;
                    text <=> root.subtitle-outline-size-text;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 112px; y: 21px; text: "Color:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                SubtitleColorWell { x: 157px; y: 15px; observed-color: root.subtitle-outline-color;
                    hint: "Subtitle border color";
                    edited(value) => { root.subtitle-outline-color = value; root.settings-changed(); }
                }
            }
        }
        PreferenceDisclosure { x: 20px; y: 550px;
            label: "Advanced"; expanded: root.subtitle-text-advanced-expanded;
            toggled => { root.subtitle-text-advanced-expanded = !root.subtitle-text-advanced-expanded; }
        }
        if root.subtitle-text-advanced-expanded : Rectangle { x: 20px; y: 578px; width: 480px; height: 58px; background: transparent;
            Text { x: 0; y: 8px; text: "Shadow:";
                font-weight: 600; font-size: 13px; color: #222222; }
            Rectangle { x: 98px; y: 0; width: 366px; height: 56px;
                border-width: 1px; border-color: #c4c4c8; border-radius: 4px;
                background: #f1f1f3;
                Text { x: 12px; y: 21px; text: "Offset:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                PreferenceNumericInput { x: 56px; y: 15px; width: 38px; height: 24px;
                    text <=> root.subtitle-shadow-offset-text;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 119px; y: 21px; text: "Color:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                SubtitleColorWell { x: 164px; y: 15px; observed-color: root.subtitle-shadow-color;
                    hint: "Subtitle shadow color";
                    edited(value) => {
                        root.subtitle-shadow-color = value;
                        root.subtitle-background-color = value;
                        root.settings-changed();
                    }
                }
            }
        }
        if root.subtitle-text-advanced-expanded : Rectangle { x: 20px; y: 640px; width: 480px; height: 58px; background: transparent;
            Text { x: 0; y: 8px; text: "Other Styles:";
                font-weight: 600; font-size: 13px; color: #222222; }
            Rectangle { x: 98px; y: 0; width: 366px; height: 56px;
                border-width: 1px; border-color: #c4c4c8; border-radius: 4px;
                background: #f1f1f3;
                Text { x: 12px; y: 21px; text: "Blur:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                PreferenceNumericInput { x: 48px; y: 15px; width: 38px; height: 24px;
                    text <=> root.subtitle-blur-text;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 109px; y: 21px; text: "Font spacing:";
                    font-size: 11px; color: #222222; vertical-alignment: center; }
                PreferenceNumericInput { x: 190px; y: 15px; width: 38px; height: 24px;
                    text <=> root.subtitle-spacing-text;
                    accepted => { root.settings-changed(); }
                }
            }
        }
        Rectangle { x: 20px; y: 714px; width: 480px; height: 208px; background: transparent;
            Text { x: 0; y: 8px; text: "Position:";
                font-weight: 600; font-size: 13px; color: #222222; }
            Rectangle { x: 98px; y: 6px; width: 366px; height: 56px;
                border-width: 1px; border-color: #c4c4c8; border-radius: 4px;
                background: #f1f1f3;
                Text { x: 12px; y: 20px; text: "X:"; font-size: 11px; color: #222222; }
                ComboBox { x: 28px; y: 15px; width: 88px; height: 24px;
                    model: ["Left", "Center", "Right"];
                    current-index <=> root.subtitle-align-x-index;
                    selected => { root.settings-changed(); }
                }
                Text { x: 126px; y: 20px; text: "Y:"; font-size: 11px; color: #222222; }
                ComboBox { x: 143px; y: 15px; width: 88px; height: 24px;
                    model: ["Top", "Center", "Bottom"];
                    current-index <=> root.subtitle-align-y-index;
                    selected => { root.settings-changed(); }
                }
            }
            Rectangle { x: 98px; y: 68px; width: 366px; height: 56px;
                border-width: 1px; border-color: #c4c4c8; border-radius: 4px;
                background: #f1f1f3;
                Text { x: 12px; y: 5px; text: "Margin";
                    font-size: 11px; font-weight: 600; color: #55555d; }
                Text { x: 16px; y: 28px; text: "X:"; font-size: 11px; color: #222222; }
                PreferenceNumericInput { x: 34px; y: 21px; width: 80px; height: 24px;
                    text <=> root.subtitle-margin-x-text;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 125px; y: 28px; text: "Y:"; font-size: 11px; color: #222222; }
                PreferenceNumericInput { x: 143px; y: 21px; width: 80px; height: 24px;
                    text <=> root.subtitle-margin-y-text;
                    accepted => { root.settings-changed(); }
                }
            }
            Text { x: 98px; y: 132px; text: "Vertical position:";
                font-size: 12px; color: #222222; vertical-alignment: center; }
            PreferenceNumericInput { x: 210px; y: 128px; width: 80px; height: 24px;
                text <=> root.subtitle-position-text;
                accepted => { root.settings-changed(); }
            }
            Text { x: 291px; y: 132px; text: "%";
                font-size: 12px; color: #222222; vertical-alignment: center; }
            CheckBox { x: 98px; y: 158px; width: 360px; height: 22px;
                text: "Display subtitles in letterboxes while in full screen";
                checked <=> root.subtitle-display-in-letterbox;
                toggled => { root.settings-changed(); }
            }
            CheckBox { x: 98px; y: 182px; width: 280px; height: 22px;
                text: "Scale subtitles with window size";
                checked <=> root.subtitle-scale-with-window;
                toggled => { root.settings-changed(); }
            }
        }
        Rectangle { x: 20px; y: 938px; width: 480px; height: 90px; background: transparent;
            Text { x: 0; y: 8px; text: "Other:";
                font-weight: 600; font-size: 13px; color: #222222; }
            Text { x: 98px; y: 8px; text: "Preferred language:";
                font-size: 13px; color: #222222; vertical-alignment: center; }
            Rectangle { x: 228px; y: 4px; width: 232px; height: 23px;
                border-width: 1px; border-color: #b8b8bc; border-radius: 2px;
                background: #ffffff;
                TextInput { x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
                    text <=> root.subtitle-preferred-languages-text;
                    font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
            }
            Text { x: 98px; y: 30px; width: 364px; height: 28px;
                text: "Use comma-separated ISO 639-2 language codes. These preferences also guide subtitle track selection.";
                font-size: 10px; color: #77777d; wrap: word-wrap;
            }
            Text { x: 98px; y: 66px; text: "Default encoding:";
                font-size: 13px; color: #222222; vertical-alignment: center; }
            ComboBox { x: 213px; y: 62px; width: 147px; height: 25px;
                model: root.subtitle-encoding-options;
                current-index <=> root.subtitle-encoding-index;
                selected => { root.settings-changed(); }
            }
        }
        }
    }
    if root.selected-pane == 3 : Rectangle {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        background: #ededed;
        Text { x: 22px; y: 16px; text: "Audio"; font-size: 15px; font-weight: 600; color: #222222; }
        // Keep the opt-in extension with IINA's Audio > Volume settings; leaving
        // it here makes the 0–100 default cap difficult to discover and reverse.
        Rectangle { x: 20px; y: 52px; width: 576px; height: 92px; background: transparent;
            Text { x: 0; y: 8px; text: "Volume";
                font-weight: 600; font-size: 13px; color: #222222; }
            CheckBox { x: 98px; y: 4px; height: 24px;
                text: "Allow volume boost (up to 200%)";
                checked <=> root.volume-boost;
                toggled => { root.settings-changed(); }
            }
        }
    }
    if root.selected-pane == 5 : Rectangle {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        background: #ededed;
        Text { x: 22px; y: 16px; text: "Network"; font-size: 15px; font-weight: 600; color: #222222; }
    }
    if root.selected-pane == 6 : Rectangle {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        background: #ededed;
        Text { x: 22px; y: 16px; text: "Control"; font-size: 15px; font-weight: 600; color: #222222; }
    }
    if root.selected-pane == 7 : Rectangle {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        background: #ededed;
        Text { x: 22px; y: 16px; text: "Key Bindings"; font-size: 15px; font-weight: 600; color: #222222; }
    }
    if root.selected-pane == 8 : Rectangle {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        background: #ededed;
        Text { x: 22px; y: 16px; text: "Advanced"; font-size: 15px; font-weight: 600; color: #222222; }
    }
    if root.selected-pane == 9 : Rectangle {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        background: #ededed;
        Text { x: 22px; y: 16px; text: "Plugin"; font-size: 15px; font-weight: 600; color: #222222; }
    }
    if root.selected-pane == 10 : Rectangle {
        x: 202px; y: 0; width: parent.width - 202px; height: parent.height;
        background: #ededed;
        Text { x: 22px; y: 16px; text: "Utilities"; font-size: 15px; font-weight: 600; color: #222222; }
    }
}
