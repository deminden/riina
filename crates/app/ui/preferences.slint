// The trailing action keeps a fixed hit target when a descriptive label wraps.
component UtilitiesActionRow inherits Rectangle {
    in property <string> symbol;
    in property <string> title;
    in property <string> description: "";
    in property <string> trailing: "→";
    in property <string> metric: "";
    in property <bool> trash: false;
    in property <bool> action-enabled: true;
    callback activated();
    height: description.is-empty ? 48px : 70px;
    background: transparent;
    accessible-role: list-item;
    accessible-label: root.title + (root.description.is-empty ? "" : ", " + root.description);
    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #dedee1; }
    Text { x: 12px; y: 0; width: 22px; height: parent.height;
        text: root.symbol; font-size: 16px; color: #77777e;
        horizontal-alignment: center; vertical-alignment: center; }
    Text { x: 36px; y: root.description.is-empty ? 0px : 8px;
        width: parent.width - 108px; height: 20px; text: root.title;
        font-size: 12px; color: root.action-enabled ? #29292d : #8a8a90;
        vertical-alignment: center; overflow: elide; }
    if !root.description.is-empty : Text {
        x: 36px; y: 28px; width: parent.width - 116px; height: parent.height - 32px;
        text: root.description; font-size: 10px; color: #74747a;
        vertical-alignment: top; wrap: word-wrap; overflow: elide;
    }
    action-button := FocusScope {
        x: parent.width - 50px; y: 0; width: 40px; height: parent.height;
        enabled: root.action-enabled;
        accessible-role: button; accessible-label: root.title;
        accessible-action-default => { if root.action-enabled { root.activated(); } }
        Rectangle { x: 0px; y: (parent.height - 26px) / 2;
            width: 40px; height: 26px; border-radius: 7px;
            background: (touch.has-hover || action-button.has-focus) && root.action-enabled ? #dcdcdf : #e6e6e9; }
        Text { x: -58px; y: 0; width: 56px; height: parent.height;
            text: root.metric; font-size: 10px; color: #85858b;
            horizontal-alignment: right; vertical-alignment: center; }
        if root.trash : Rectangle { x: 15px; y: (parent.height - 12px) / 2;
            width: 8px; height: 10px; border-width: 1px; border-color: root.action-enabled ? #77777d : #a8a8ad;
            border-radius: 1px; background: transparent; }
        if root.trash : Rectangle { x: 13px; y: (parent.height - 16px) / 2;
            width: 12px; height: 2px; background: root.action-enabled ? #77777d : #a8a8ad; }
        if root.trash : Rectangle { x: 17px; y: (parent.height - 19px) / 2;
            width: 4px; height: 1px; background: root.action-enabled ? #77777d : #a8a8ad; }
        if !root.trash : Text { x: 0px; y: (parent.height - 26px) / 2;
            width: 40px; height: 26px; text: root.trailing; font-size: 14px;
            color: root.action-enabled ? #4e4e54 : #a8a8ad;
            horizontal-alignment: center; vertical-alignment: center; }
        if self.has-focus : Rectangle { x: -2px; y: (parent.height - 30px) / 2;
            width: 44px; height: 30px; border-width: 1px; border-color: #168bff;
            border-radius: 8px; background: transparent; }
        touch := TouchArea {
            enabled: root.action-enabled;
            clicked => { action-button.focus(); root.activated(); }
        }
        key-pressed(event) => {
            if root.action-enabled && (event.text == Key.Return || event.text == " ") {
                root.activated(); return accept;
            }
            return reject;
        }
    }
}

component AssOverrideSlider inherits Rectangle {
    in property <float> value: 2;
    callback changed(float);
    width: 124px;
    height: 20px;
    background: transparent;
    accessible-role: slider;
    accessible-label: "ASS subtitle override level";
    accessible-value: value;
    accessible-value-minimum: 0;
    accessible-value-maximum: 4;
    accessible-value-step: 1;
    accessible-action-set-value(text) => {
        if text.is-float() { root.changed(round(clamp(text.to-float(), 0, 4))); }
    }
    accessible-action-increment => { root.changed(min(4, value + 1)); }
    accessible-action-decrement => { root.changed(max(0, value - 1)); }
    Rectangle { x: 7px; y: 7px; width: parent.width - 14px; height: 2px;
        border-radius: 1px; background: #a7a7ad; }
    Rectangle { x: 7px; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: parent.width * 0.25; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: parent.width * 0.5; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: parent.width * 0.75; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: parent.width - 7px; y: 6px; width: 1px; height: 5px; background: #77777e; }
    Rectangle { x: 4px + (parent.width - 8px) * root.value / 4; y: 3px;
        width: 7px; height: 8px; border-radius: 3px; background: #55555d; }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #168bff;
        border-radius: 4px; background: transparent; }
    touch := TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                focus.focus();
                root.changed(round(clamp((self.mouse-x - 4px) / (root.width - 8px), 0, 1) * 4));
            }
        }
        moved => { if self.pressed {
            root.changed(round(clamp((self.mouse-x - 4px) / (root.width - 8px), 0, 1) * 4));
        } }
    }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.RightArrow { root.changed(min(4, root.value + 1)); return accept; }
            if event.text == Key.LeftArrow { root.changed(max(0, root.value - 1)); return accept; }
            return reject;
        }
    }
}

// The captured IINA settings window has a 600×480 client area and 200px sidebar.
// Keep those measured content coordinates independent of platform title bars.
export component PreferencesWindow inherits Window {
    title: "Settings";
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    preferred-width: 600px;
    preferred-height: 480px;
    min-width: 600px;
    min-height: 480px;
    background: #ffffff;
    in-out property <int> selected-pane: 0;
    in-out property <bool> disable-animations: false;
    in property <bool> system-reduce-motion: false;
    in property <bool> platform-macos: false;
    in-out property <length> general-scroll-position: 0px;
    in-out property <bool> when-media-opened-expanded: false;
    in-out property <bool> pause-resume-when-expanded: false;
    in-out property <int> appearance-index: 0;
    in-out property <bool> liquid-glass-expanded: false;
    in-out property <bool> liquid-glass-osd: true;
    in-out property <bool> liquid-glass-osc: true;
    in-out property <bool> liquid-glass-sidebar: true;
    in property <string> surface-material-title: "Translucent Surfaces";
    in-out property <int> selected-interface-section: 0;
    in-out property <bool> control-auto-hide-enabled: true;
    in-out property <string> control-auto-hide-timeout-text: "2.5";
    in-out property <bool> toolbar-show-plugins: true;
    in-out property <bool> toolbar-show-pip: true;
    in-out property <bool> toolbar-show-playlist: true;
    in-out property <bool> toolbar-show-quick-settings: true;
    in-out property <bool> toolbar-show-fullscreen: false;
    in-out property <bool> toolbar-show-music-mode: false;
    in-out property <bool> toolbar-show-subtitle-track: false;
    in-out property <bool> toolbar-show-screenshot: false;
    in-out property <bool> toolbar-show-live-text: false;
    in-out property <[int]> toolbar-order: [7, 2, 1, 0, 3, 4, 5, 6, 8];
    in-out property <int> toolbar-drag-index: -1;
    in-out property <int> toolbar-drop-index: -1;
    in-out property <length> toolbar-drag-start-y: 0px;
    in-out property <bool> toolbar-drag-active: false;
    in-out property <bool> osd-suppression-expanded: false;
    in-out property <bool> disable-osd-file-start: false;
    in-out property <bool> disable-osd-pause-resume: false;
