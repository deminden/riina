    callback settings-changed();
    callback open-assrt-token-page();
    callback toolbar-move(int, int);
    callback toolbar-drag-finished();
    callback toolbar-reset();
    changed disable-animations => {
        MotionSettings.animations-disabled = root.disable-animations ||
            (root.system-reduce-motion && !root.platform-macos);
    }
    changed system-reduce-motion => {
        MotionSettings.animations-disabled = root.disable-animations ||
            (root.system-reduce-motion && !root.platform-macos);
    }
    changed platform-macos => {
        MotionSettings.animations-disabled = root.disable-animations ||
            (root.system-reduce-motion && !root.platform-macos);
    }
    callback choose-folder();
