component ToolbarPreferenceRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;
    in property <int> position;
    in property <int> count;
    in property <int> drag-index: -1;
    in property <int> drop-index: -1;
    in property <length> drag-start-y: 0px;
    in property <bool> drag-active: false;
    callback toggled(bool);
    callback move-requested(int, int);
    callback drag-started(int, length);
    callback drag-target-changed(int);
    callback drag-finished();
    height: 28px; spacing: 4px;
    PreferenceSwitch {
        width: 208px; label: root.label;
        checked <=> root.checked;
        toggled => { root.toggled(self.checked); }
    }
    Rectangle {
        width: 20px; height: 22px; border-radius: 4px;
        background: drag-handle.pressed ? #d9d9dd : #f7f7f8;
        accessible-role: button;
        accessible-label: "Drag to reorder " + root.label;
        Text { text: "⠿"; font-size: 15px; color: #68686e;
            horizontal-alignment: center; vertical-alignment: center; }
        drag-handle := TouchArea {
            mouse-cursor: root.drag-active ? move : grab;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.drag-started(root.position, self.mouse-y);
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up &&
                    root.drag-active && root.drag-index == root.position {
                    root.drag-finished();
                }
            }
            moved => {
                if self.pressed && root.drag-index == root.position {
                    let delta = self.mouse-y - root.drag-start-y;
                    let steps = floor(abs(delta) / 28px);
                    if abs(delta) >= 6px {
                        let target = clamp(root.drag-index + (delta < 0px ? -steps : steps), 0, root.count - 1);
                        root.drag-target-changed(target);
                    }
                }
            }
        }
    }
    Rectangle { horizontal-stretch: 1; background: transparent; }
    if root.drag-active && root.drop-index == root.position : Rectangle {
        width: 2px; height: 20px; border-radius: 1px; background: #168bff;
    }
    ToolbarOrderButton { label: "↑"; enabled: root.position > 0;
        activated => { root.move-requested(root.position, root.position - 1); } }
    ToolbarOrderButton { label: "↓"; enabled: root.position + 1 < root.count;
        activated => { root.move-requested(root.position, root.position + 1); } }
}

// AppKit draws number formatters as bounded editable cells; give shared values
// the same visible affordance even when the Windows widget theme omits a bezel.
component PreferenceNumericInput inherits Rectangle {
    in-out property <string> text: "";
    in property <length> font-size: 11px;
