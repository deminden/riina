            CheckBox { x: 194px; y: 158px; text: "DTS-HD"; checked <=> root.audio-spdif-dts-hd; toggled => { root.settings-changed(); } }
            CheckBox { x: 14px; y: 188px; text: "E-AC-3"; checked <=> root.audio-spdif-eac3; toggled => { root.settings-changed(); } }
            CheckBox { x: 104px; y: 188px; text: "TrueHD"; checked <=> root.audio-spdif-truehd; toggled => { root.settings-changed(); } }
        }
        if root.selected-audio-section == 1 : Rectangle {
