                    accepted => { root.settings-changed(); }
                }
                Text { x: 44px; y: 27px; width: parent.width - 62px; height: 20px;
                    text: "Default: 36,000"; font-size: 10px; color: #77777d; vertical-alignment: center; }
            }
            Rectangle { x: 0; y: 250px; width: parent.width; height: 52px; background: transparent;
                Text { x: 44px; y: 0; width: parent.width - 170px; height: 30px;
