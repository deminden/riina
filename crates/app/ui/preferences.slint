    Rectangle { x: 1px; y: 8px; width: 6px; height: 6px; border-radius: 3px;
        background: root.selected ? #7a7a80 : #9a9a9f; }
    Text { x: 20px; width: parent.width - 24px; height: parent.height;
        text: root.label; font-size: 11px; font-weight: root.selected ? 600 : 400;
        color: #55555b; vertical-alignment: center; overflow: elide; }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
