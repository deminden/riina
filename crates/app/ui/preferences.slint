                Text { x: 42px; y: 34px; width: parent.width - 58px; height: 40px;
                    text: root.network-ytdl-plugin-active ? "The plugin adds quality selection and video downloads. mpv's built-in extractor is disabled while the plugin is enabled." : "The plugin adds quality selection and video downloads. The settings below configure mpv's built-in extractor.";
                    font-size: 10px; color: #77777d; wrap: word-wrap; }
            }
