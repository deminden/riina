                TextInput { x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
                    text <=> root.subtitle-preferred-languages-text;
                    font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
            }
            Text { x: 98px; y: 30px; width: parent.width - 102px; height: 28px;
                text: "Use comma-separated ISO 639-2 language codes. These preferences also guide subtitle track selection.";
                font-size: 10px; color: #77777d; wrap: word-wrap;
            }
            Text { x: 98px; y: 66px; text: "Default encoding:";
                font-size: 13px; color: #222222; vertical-alignment: center; }
            ComboBox { x: 213px; y: 62px; width: 147px; height: 25px;
                model: root.subtitle-encoding-options;
                current-index <=> root.subtitle-encoding-index;
                selected => { root.settings-changed(); }
            }
        }
        }
    }
    if root.selected-pane == 3 : Rectangle {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        background: #ededed;
        Text { x: 28px; y: 16px; text: "Audio"; font-size: 15px; font-weight: 600; color: #222222; }
        // Keep the opt-in extension with IINA's Audio > Volume settings; leaving
        // it here makes the 0–100 default cap difficult to discover and reverse.
        Rectangle { x: 20px; y: 52px; width: parent.width - 40px; height: 92px; background: transparent;
            Text { x: 0; y: 8px; text: "Volume";
                font-weight: 600; font-size: 13px; color: #222222; }
            CheckBox { x: 98px; y: 4px; height: 24px;
                text: "Allow volume boost (up to 200%)";
                checked <=> root.volume-boost;
                toggled => { root.settings-changed(); }
            }
        }
    }
    if root.selected-pane == 5 : Rectangle {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        background: #ededed;
        Text { x: 28px; y: 16px; text: "Network"; font-size: 15px; font-weight: 600; color: #222222; }
        Text { x: 28px; y: 54px; text: root.selected-network-section == 0 ? "Cache" : root.selected-network-section == 1 ? "Network" : "Online Videos (yt-dlp)"; font-size: 13px; font-weight: 600; color: #77777d; }
        if root.selected-network-section == 0 : Rectangle {
        Rectangle { x: 20px; y: 80px; width: parent.width - 40px; height: 390px;
            border-radius: 12px; border-width: 1px; border-color: #e4e4e8; background: #fafafa;
            // Match the reference's compact rows; explanations stay with the control they qualify.
            Rectangle { x: 0; y: 0; width: parent.width; height: 40px; background: transparent;
                Text { x: 12px; y: 0; width: 18px; height: parent.height; text: "▤"; font-size: 14px; color: #77777d; vertical-alignment: center; }
                PreferenceSwitch { x: 36px; y: 6px; width: parent.width - 48px;
                    label: "Prefetch and buffer network data";
                    checked <=> root.network-cache-enabled;
                    toggled => { root.settings-changed(); }
                }
            }
            Rectangle { x: 0; y: 40px; width: parent.width; height: 94px; background: transparent;
                border-width: 0px; border-color: #dedee2;
                PreferenceSwitch { x: 44px; y: 0; width: parent.width - 58px; height: 26px;
                    label: "Buffer before starting playback";
                    enabled: root.network-cache-enabled;
                    checked <=> root.network-cache-pause-initial; toggled => { root.settings-changed(); }
                }
                Text { x: 44px; y: 26px; width: parent.width - 62px; height: 48px;
                    text: "Enter buffering mode before playback starts. This can be useful to ensure playback starts smoothly, in exchange for waiting some time to prefetch and buffer network data.";
                    font-size: 10px; color: #77777d; wrap: word-wrap;
                }
                Text { x: 44px; y: 75px; width: parent.width - 62px; height: 16px;
                    text: "Default: 1"; font-size: 10px; color: #77777d; vertical-alignment: center; }
            }
            Rectangle { x: 0; y: 134px; width: parent.width; height: 64px; background: transparent;
                Text { x: 44px; y: 0; width: parent.width - 170px; height: 32px;
                    text: "Seconds to buffer before restarting"; font-size: 12px; color: #252529; vertical-alignment: center; wrap: word-wrap; }
                TextInput { x: parent.width - 94px; y: 9px; width: 66px; height: 24px;
                    enabled: root.network-cache-enabled;
                    text <=> root.network-cache-pause-wait-text; font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 44px; y: 32px; width: parent.width - 62px; height: 25px;
                    text: "Number of seconds the cache should have buffered before starting playback again if buffering mode was entered. Increase this setting if playback quickly reenters buffering mode.";
                    font-size: 10px; color: #77777d; wrap: word-wrap;
                }
            }
            Rectangle { x: 0; y: 198px; width: parent.width; height: 52px; background: transparent;
                Text { x: 44px; y: 0; width: parent.width - 170px; height: 30px;
                    text: "Seconds to prefetch"; font-size: 12px; color: #252529; vertical-alignment: center; }
                TextInput { x: parent.width - 94px; y: 4px; width: 66px; height: 24px;
                    enabled: root.network-cache-enabled;
                    text <=> root.network-cache-prefetch-secs-text; font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 44px; y: 27px; width: parent.width - 62px; height: 20px;
                    text: "Default: 36,000"; font-size: 10px; color: #77777d; vertical-alignment: center; }
            }
            Rectangle { x: 0; y: 250px; width: parent.width; height: 52px; background: transparent;
                Text { x: 44px; y: 0; width: parent.width - 170px; height: 30px;
                    text: "Cache buffer size (KiB)"; font-size: 12px; color: #252529; vertical-alignment: center; }
                TextInput { x: parent.width - 94px; y: 4px; width: 66px; height: 24px;
                    enabled: root.network-cache-enabled;
                    text <=> root.network-cache-size-kib-text; font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 44px; y: 27px; width: parent.width - 62px; height: 20px;
                    text: "Default: 153,600"; font-size: 10px; color: #77777d; vertical-alignment: center; }
            }
            Rectangle { x: 0; y: 302px; width: parent.width; height: 40px; background: transparent;
                PreferenceSwitch { x: 36px; y: 6px; width: parent.width - 48px;
                    label: "Show throbber when buffering";
                    checked <=> root.network-show-buffering-throbber;
                    toggled => { root.settings-changed(); }
                }
            }
            Rectangle { x: 0; y: 342px; width: parent.width; height: 40px; background: transparent;
                PreferenceSwitch { x: 36px; y: 6px; width: parent.width - 48px;
                    label: "Show throbber when seeking";
                    checked <=> root.network-show-seeking-throbber;
                    toggled => { root.settings-changed(); }
                }
            }
        }
        }
        if root.selected-network-section == 1 : Rectangle {
            x: 20px; y: 80px; width: parent.width - 40px; height: 205px;
            border-radius: 12px; border-width: 1px; border-color: #e4e4e8; background: #fafafa;
            Text { x: 12px; y: 8px; text: "Network"; font-size: 13px; font-weight: 600; color: #252529; }
            Text { x: 12px; y: 44px; width: 94px; height: 24px; text: "User agent";
                font-size: 12px; color: #252529; vertical-alignment: center; }
            Rectangle { x: 108px; y: 44px; width: parent.width - 122px; height: 24px;
                border-radius: 4px; border-width: 1px; border-color: #c8c8cd; background: #ffffff;
                TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                    text <=> root.network-user-agent; font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
            }
            Text { x: 12px; y: 82px; width: 94px; height: 24px; text: "HTTP proxy";
                font-size: 12px; color: #252529; vertical-alignment: center; }
            Rectangle { x: 108px; y: 82px; width: parent.width - 122px; height: 24px;
                border-radius: 4px; border-width: 1px; border-color: #c8c8cd; background: #ffffff;
                TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                    text <=> root.network-http-proxy; font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
            }
            Text { x: 108px; y: 108px; width: parent.width - 122px; height: 30px;
                text: "Enter a proxy URL, such as http://proxy.example:8080.";
                font-size: 10px; color: #77777d; wrap: word-wrap; }
            Text { x: 12px; y: 146px; width: 94px; height: 24px; text: "RTSP transport";
                font-size: 12px; color: #252529; vertical-alignment: center; }
            ComboBox { x: 108px; y: 146px; width: parent.width - 122px; height: 25px;
                model: root.network-rtsp-transport-options;
                current-index <=> root.network-rtsp-transport-index;
                selected => { root.settings-changed(); }
            }
            Text { x: 108px; y: 177px; width: parent.width - 122px; height: 16px;
                text: "Changes take effect after restarting riina.";
                font-size: 10px; color: #77777d; vertical-alignment: center; }
        }
        if root.selected-network-section == 2 : Rectangle {
            x: 0; y: 0; width: parent.width; height: parent.height; background: #ededed;
            Rectangle { x: 20px; y: 80px; width: parent.width - 40px; height: 78px;
                border-radius: 12px; border-width: 1px; border-color: #e4e4e8; background: #fafafa;
                Image { x: 12px; y: 14px; width: 18px; height: 18px;
                    source: @image-url("../../../assets/icons/plugins.svg"); image-fit: contain; }
                Text { x: 42px; y: 10px; width: parent.width - 58px; height: 22px;
                    text: "The Online Media plugin is recommended"; font-size: 12px; font-weight: 600; color: #252529; }
                Text { x: 42px; y: 34px; width: parent.width - 58px; height: 40px;
                    text: "The plugin adds quality selection and video downloads. The settings below configure mpv's built-in extractor.";
                    font-size: 10px; color: #77777d; wrap: word-wrap; }
            }
            Rectangle { x: 20px; y: 170px; width: parent.width - 40px; height: 220px;
                border-radius: 12px; border-width: 1px; border-color: #e4e4e8; background: #fafafa;
                PreferenceSwitch { x: 12px; y: 6px; width: parent.width - 24px;
                    label: "Enable mpv's youtube-dl script";
                    checked <=> root.network-ytdl-enabled;
                    toggled => { root.settings-changed(); }
                }
                Text { x: 12px; y: 43px; width: parent.width - 24px; height: 32px;
                    text: "Custom youtube-dl path"; font-size: 12px; color: #252529; }
                Rectangle { x: 12px; y: 63px; width: parent.width - 24px; height: 24px;
                    border-radius: 4px; border-width: 1px; border-color: #c8c8cd; background: #ffffff;
                    TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                        text <=> root.network-ytdl-search-path; font-size: 11px; color: #222222;
                        enabled: root.network-ytdl-enabled;
                        accepted => { root.settings-changed(); }
                    }
                }
                Text { x: 12px; y: 90px; width: parent.width - 24px; height: 24px;
                    text: "Search this folder at startup. Restart required.";
                    font-size: 10px; color: #77777d; }
                Text { x: 12px; y: 119px; width: parent.width - 24px; height: 22px;
                    text: "Raw options"; font-size: 12px; color: #252529; }
                Rectangle { x: 12px; y: 141px; width: parent.width - 24px; height: 24px;
                    border-radius: 4px; border-width: 1px; border-color: #c8c8cd; background: #ffffff;
                    TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                        text <=> root.network-ytdl-raw-options; font-size: 11px; color: #222222;
                        enabled: root.network-ytdl-enabled;
                        accepted => { root.settings-changed(); }
                    }
                }
                Text { x: 12px; y: 168px; width: parent.width - 24px; height: 28px;
                    text: "Format: <key>=<value>[,<key>=<value>[,…]]";
                    font-size: 10px; color: #77777d; }
            }
        }
    }
    if root.selected-pane == 6 : Rectangle {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        background: #ededed;
        Text { x: 28px; y: 16px; text: "Control"; font-size: 15px; font-weight: 600; color: #222222; }
    }
    if root.selected-pane == 7 : Rectangle {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        background: #ededed;
        Text { x: 28px; y: 16px; text: "Key Bindings"; font-size: 15px; font-weight: 600; color: #222222; }
    }
    if root.selected-pane == 8 : Rectangle {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        background: #ededed;
        Text { x: 28px; y: 16px; text: "Advanced"; font-size: 15px; font-weight: 600; color: #222222; }
    }
    if root.selected-pane == 9 : Rectangle {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        background: #ededed;
        Text { x: 28px; y: 16px; text: "Plugins"; font-size: 15px; font-weight: 600; color: #222222; }
    }
    if root.selected-pane == 10 : Rectangle {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        background: #ededed;
        Text { x: 28px; y: 16px; text: "Utilities"; font-size: 15px; font-weight: 600; color: #222222; }
    }

    if !root.search-query.is-empty : Rectangle {
        x: 8px; y: 48px; width: 340px;
        height: min(400px, max(120px, root.search-results.length * 38px));
        border-radius: 8px; border-width: 1px; border-color: #d0d0d5;
        background: #fbfbfc;
        ScrollView {
            width: parent.width; height: parent.height;
            content-height: max(120px, root.search-results.length * 38px);
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            if root.search-results.length == 0 : Text {
                width: parent.width; height: parent.height;
                text: "No Results"; font-size: 13px; color: #77777d;
                horizontal-alignment: center; vertical-alignment: center;
            }
            if root.search-results.length > 0 : VerticalLayout {
                width: parent.width; spacing: 0px;
                for result[index] in root.search-results : PreferenceSearchResultCell {
                    result: result;
                    selected: root.selected-search-index == index;
                    activated(page-index, section-name, title, anchor-y) => {
                        root.search-result-activated(page-index, section-name, title, anchor-y);
                    }
                }
            }
        }
    }
}
