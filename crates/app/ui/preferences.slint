import { CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { PlayerSlider, SubtitleColorWell } from "shared-controls.slint";

global MotionSettings {
    in-out property <bool> animations-disabled: false;
}

export struct PreferencesSearchResult {
    page-index: int,
    page-name: string,
    section-name: string,
    title: string,
    is-header: bool,
    icon: image,
    anchor-y: int,
}

export struct KeyBindingRow {
    key: string,
    action: string,
    comment: string,
}

export struct AdvancedMpvOptionRow {
    name: string,
    value: string,
}

export struct PluginPreferencesRow {
    identifier: string,
    name: string,
    version: string,
    description: string,
    enabled: bool,
    runtime-ready: bool,
}

component KeyBindingActionRow inherits Rectangle {
    in property <KeyBindingRow> entry;
    in property <bool> selected: false;
    in property <int> row-index;
    in property <int> selected-index: -1;
    in property <int> row-count: 0;
    in property <bool> editable: false;
    callback activated(int);
    callback edit-requested(int);
    callback remove-requested(int);
    height: 32px;
    background: root.selected ? #e5edf7 : touch.has-hover ? #ffffff : transparent;
    accessible-role: list-item;
    accessible-label: root.entry.action + ", " + root.entry.key;
    accessible-action-default => { root.activated(root.row-index); }
    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #eeeeef; }
    Text { x: 12px; y: 0; width: parent.width - 76px; height: parent.height;
        text: root.entry.action; font-size: 12px; color: #29292d;
        vertical-alignment: center; overflow: elide; }
    Rectangle { x: parent.width - 58px; y: 4px; width: 48px; height: 24px;
        border-radius: 5px; border-width: 1px; border-color: #e1e1e5; background: #ffffff; }
    Text { x: parent.width - 56px; y: 4px; width: 44px; height: 24px;
        text: root.entry.key; font-size: 12px; color: #29292d;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    if focus.has-focus : Rectangle {
        width: parent.width; height: parent.height; border-width: 1px;
        border-color: #90b7ef; border-radius: 3px; background: transparent;
    }
    touch := TouchArea {
        clicked => { focus.focus(); root.activated(root.row-index); }
        double-clicked => { if root.editable { root.edit-requested(root.row-index); } }
    }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return && root.selected && root.editable {
                root.edit-requested(root.row-index); return accept;
            }
            if (event.text == Key.Delete || event.text == Key.Backspace) && root.selected && root.editable {
                root.remove-requested(root.row-index); return accept;
            }
            if event.text == Key.DownArrow && root.row-count > 0 {
                root.activated(min(root.row-count - 1, root.selected-index + 1)); return accept;
            }
            if event.text == Key.UpArrow && root.row-count > 0 {
                root.activated(max(0, root.selected-index - 1)); return accept;
            }
            return reject;
        }
    }
}

component PluginEnabledSwitch inherits FocusScope {
    in-out property <bool> checked: false;
    in property <bool> switch-enabled: true;
    in property <string> label: "Plugin enabled";
    callback toggled(bool);
    width: 36px;
    height: 18px;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-value: root.checked ? "On" : "Off";
    accessible-action-default => { if root.switch-enabled { root.checked = !root.checked; root.toggled(root.checked); } }
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 9px;
        background: root.checked ? #1684f8 : #d6d6d9;
        animate background { duration: MotionSettings.animations-disabled ? 0ms : 120ms; }
    }
    Rectangle {
        x: root.checked ? parent.width - 17px : 1px; y: 1px; width: 16px; height: 16px;
        border-radius: 8px; background: #ffffff;
        drop-shadow-color: #00000033; drop-shadow-blur: 2px; drop-shadow-offset-y: 1px;
        animate x { duration: MotionSettings.animations-disabled ? 0ms : 120ms; }
    }
    touch := TouchArea {
        enabled: root.switch-enabled;
        clicked => { focus.focus(); root.checked = !root.checked; root.toggled(root.checked); }
    }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if root.switch-enabled && (event.text == Key.Space || event.text == Key.Return) {
                root.checked = !root.checked; root.toggled(root.checked); return accept;
            }
            return reject;
        }
    }
    if focus.has-focus : Rectangle {
        x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px;
        border-width: 1px; border-color: #78a9f5; border-radius: 11px; background: transparent;
    }
}

component PluginPageIconButton inherits FocusScope {
    in property <int> icon-kind: 0;
    in property <string> label;
    callback activated();
    width: 24px;
    height: 24px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 6px;
        background: touch.has-hover ? #ededf0 : transparent;
    }
    if root.icon-kind == 0 : Rectangle {
        x: 6px; y: 11px; width: 2px; height: 2px; border-radius: 1px; background: #77777d;
        Rectangle { x: 5px; y: 0px; width: 2px; height: 2px; border-radius: 1px; background: #77777d; }
        Rectangle { x: 10px; y: 0px; width: 2px; height: 2px; border-radius: 1px; background: #77777d; }
    }
    if root.icon-kind == 1 : Rectangle {
        x: 5px; y: 5px; width: 13px; height: 13px;
        border-width: 1px; border-color: #85858a; border-radius: 7px; background: transparent;
        Rectangle { x: 5px; y: 4px; width: 1px; height: 1px; border-radius: 1px; background: #85858a; }
        Rectangle { x: 5px; y: 7px; width: 1px; height: 4px; border-radius: 1px; background: #85858a; }
    }
    if root.icon-kind == 2 : Text {
        width: parent.width; height: parent.height; text: "↻";
        font-size: 14px; color: #85858a; horizontal-alignment: center; vertical-alignment: center;
    }
    if root.has-focus : Rectangle {
        border-width: 1px; border-color: #7daaf0; border-radius: 7px; background: transparent;
    }
    touch := TouchArea { clicked => { root.focus(); root.activated(); } }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
        return reject;
    }
}

component PluginPreferencesRowView inherits Rectangle {
    in property <PluginPreferencesRow> entry;
    in property <int> row-index;
    in property <bool> last-row: false;
    callback enabled-toggled(int, bool);
    callback about-requested(int);
    callback actions-requested(int);
    pure callback plugin-id-transfer(string) -> data-transfer;
    pure callback plugin-id-from-transfer(data-transfer) -> string;
    callback reorder-requested(string, string);
    height: 60px;
    background: transparent;
    drag-area := DragArea {
        x: 0; y: 0; width: parent.width; height: parent.height;
        data: root.plugin-id-transfer(root.entry.identifier);
        allow-move: true;
    }
    drop-area := DropArea {
        x: 0; y: 0; width: parent.width; height: parent.height;
        can-drop(event) => {
            root.plugin-id-from-transfer(event.data) != "" ? DragAction.move : DragAction.none
        }
        dropped(event) => {
            root.reorder-requested(root.plugin-id-from-transfer(event.data), root.entry.identifier);
            return event.proposed-action;
        }
    }
    if drop-area.has-drag : Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #e5edf7;
    }
    if !root.last-row : Rectangle {
        x: 0px; y: parent.height - 1px; width: parent.width; height: 1px;
        background: #e1e1e1;
    }
    PluginEnabledSwitch {
        x: 16px; y: 12px; checked: root.entry.enabled;
        switch-enabled: root.entry.runtime-ready;
        label: root.entry.name + " enabled";
        toggled(checked) => { root.enabled-toggled(root.row-index, checked); }
    }
    Text {
        x: 61px; y: 10px; width: 94px; height: 20px;
        text: root.entry.name; font-size: 13px; font-weight: 600; color: #28282c;
        vertical-alignment: center; overflow: elide;
    }
    Text {
        x: 61px; y: 32px; width: parent.width - 102px; height: 18px;
        text: root.entry.description; font-size: 11px; color: #75757a;
        vertical-alignment: center; overflow: elide;
    }
    Text {
        x: 162px; y: 10px; width: 34px; height: 20px;
        text: root.entry.version; font-size: 10px; color: #96969a;
        horizontal-alignment: right; vertical-alignment: center;
    }
    PluginPageIconButton {
        x: 196px; y: 8px; icon-kind: 0; label: "Plugin actions";
        activated => { root.actions-requested(root.row-index); }
    }
    PluginPageIconButton {
        x: parent.width - 34px; y: 28px; icon-kind: 1; label: "Plugin information";
        activated => { root.about-requested(root.row-index); }
    }
}

component PluginPageActionButton inherits FocusScope {
    in property <string> label;
    callback activated();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    width: 120px;
    height: 27px;
    Rectangle {
        width: parent.width; height: parent.height; border-radius: 6px;
        border-width: 1px; border-color: #dedee1;
        background: touch.has-hover || root.has-focus ? #e7e7e9 : #e9e9eb;
    }
    Text {
        width: parent.width; height: parent.height; text: root.label;
        font-size: 11px; color: #252529; horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.focus(); root.activated(); } }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
        return reject;
    }
    if root.has-focus : Rectangle {
        x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px;
        border-width: 1px; border-color: #7daaf0; border-radius: 8px; background: transparent;
    }
}

component KeyBindingIconButton inherits FocusScope {
    in property <string> label;
    in property <int> icon-kind;
    callback activated();
    width: 40px;
    height: 36px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if root.enabled { root.activated(); } }
    Rectangle { x: 2px; y: 1px; width: parent.width - 4px; height: parent.height - 2px;
        border-radius: 6px;
        background: !root.enabled ? transparent : touch.has-hover ? #ededf0 : transparent; }
    if root.icon-kind == 0 : Rectangle {
        x: 14px; y: 13px; width: 12px; height: 10px;
        border-width: 1px; border-color: root.enabled ? #64646a : #a8a8ad; border-radius: 2px;
        background: transparent;
        Rectangle { x: -2px; y: -3px; width: 14px; height: 1px; background: root.enabled ? #64646a : #a8a8ad; }
        Rectangle { x: 2px; y: -6px; width: 6px; height: 2px; background: root.enabled ? #64646a : #a8a8ad; }
        Rectangle { x: 3px; y: 2px; width: 1px; height: 5px; background: root.enabled ? #8a8a90 : #bcbcc0; }
        Rectangle { x: 8px; y: 2px; width: 1px; height: 5px; background: root.enabled ? #8a8a90 : #bcbcc0; }
    }
    if root.icon-kind == 1 : Image {
        x: 12px; y: 10px; width: 16px; height: 16px;
        source: @image-url("../../../assets/icons/keybindings.svg");
    }
    if root.icon-kind == 1 : Rectangle {
        x: 26px; y: 9px; width: 8px; height: 8px;
        border-radius: 4px; background: #f8f8f8;
        Rectangle { x: 3px; y: 1px; width: 1px; height: 6px; background: #55555b; }
        Rectangle { x: 1px; y: 3px; width: 5px; height: 1px; background: #55555b; }
    }
    if root.icon-kind == 2 : Rectangle {
        x: 15px; y: 15px; width: 10px; height: 8px;
        border-width: 1px; border-color: #64646a; border-radius: 2px;
        background: transparent;
        Rectangle { x: 2px; y: -6px; width: 1px; height: 6px; background: #64646a; }
        Rectangle { x: 7px; y: -6px; width: 1px; height: 6px; background: #64646a; }
        Rectangle { x: 2px; y: -6px; width: 6px; height: 1px; background: #64646a; }
        Rectangle { x: 4px; y: 2px; width: 2px; height: 2px; border-radius: 1px; background: #64646a; }
    }
    if root.icon-kind == 3 : Image {
        x: 11px; y: 10px; width: 18px; height: 18px;
        source: @image-url("../../../assets/icons/config-directory.svg");
    }
    if root.icon-kind == 3 : Rectangle {
        x: 25px; y: 18px; width: 11px; height: 11px; border-radius: 6px;
        background: #f8f8f8;
        Rectangle { x: 5px; y: 2px; width: 1px; height: 7px; background: #64646a; }
        Rectangle { x: 2px; y: 5px; width: 7px; height: 1px; background: #64646a; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == " ") {
                root.activated(); return accept;
            }
            return reject;
        }
    }
}

component KeyBindingProfileMenuItem inherits FocusScope {
    in property <string> label;
    callback activated();
    width: 184px;
    height: 30px;
    Rectangle {
        x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
        border-radius: 5px; background: touch.has-hover ? #e9e9ec : transparent;
    }
    Text {
        x: 12px; width: parent.width - 24px; height: parent.height;
        text: root.label; font-size: 11px; color: #29292d; vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.activated(); } }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == Key.Space { root.activated(); return accept; }
        return reject;
    }
}

// Native toolkit button padding can consume a 24px chooser's entire label.
// Keep this small reference control explicit, including keyboard activation.
component FolderChooser inherits FocusScope {
    callback activated();
    accessible-role: button;
    accessible-label: "Choose screenshot save path";
    accessible-action-default => { if root.enabled { root.activated(); } }
    key-pressed(event) => {
        if root.enabled && (event.text == Key.Return || event.text == " ") {
            root.activated(); return accept;
        }
        return reject;
    }
    Rectangle { width: parent.width; height: parent.height;
        border-radius: 4px;
        background: root.enabled ? (touch.pressed ? #dddddd : #fafafa) : #eeeeee;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? #168bff : #b8b8b8;
        Text { text: "…"; font-size: 13px; color: root.enabled ? #222222 : #999999;
            horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea { enabled: root.enabled;
            clicked => { root.focus(); root.activated(); } }
    }
}

component PreferenceNavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected: false;
    callback activated();
    height: 36px;
    horizontal-stretch: 1;
    border-radius: 5px;
    background: selected ? #e7e7eb : touch.has-hover ? #ffffffb8 : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { root.activated(); }
    Image { x: 5px; y: 8px; width: 20px; height: 20px; source: root.icon; }
    Text { x: 34px; width: parent.width - 42px; height: parent.height;
        text: root.label; font-size: 13px; font-weight: 600; color: #242428;
        vertical-alignment: center; }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

