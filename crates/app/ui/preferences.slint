    in-out property <string> directory;
    in-out property <bool> custom-directory: false;
    in-out property <bool> folder-dialog-open: false;
    // IINA v1.5.0 enables its newer settings window by default; preserve its
    // page order even while some individual Riina pages are still in progress.
    Rectangle { x: 0; y: 0; width: 200px; height: parent.height; background: #f6f6f6;
        PreferenceSearchField { x: 8px; y: 10px; query <=> root.search-query;
            result-count: root.search-results.length;
            selected-index: root.selected-search-index;
            query-changed(query) => {
                root.selected-search-index = -1;
                root.search-query-changed(query);
            }
            move-selection(direction) => { root.search-selection-moved(direction); }
            activate-selection => { root.search-selection-activated(); }
        }
        ScrollView { x: 0; y: 52px; width: parent.width; height: parent.height - 52px;
            content-height: root.selected-pane == 1 ? 564px : (root.selected-pane == 0 || root.selected-pane == 3 || root.selected-pane == 5) ? 488px : 416px;
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            Rectangle { width: parent.width; height: root.selected-pane == 1 ? 564px : (root.selected-pane == 0 || root.selected-pane == 3 || root.selected-pane == 5) ? 488px : 416px; background: transparent;
        PreferenceNavItem { x: 10px; y: 0px; width: 180px; label: "General";
            icon: @image-url("../../../assets/icons/settings.svg");
            selected: root.selected-pane == 0; activated => { root.selected-pane = 0; root.general-scroll-position = 0px; } }
        PreferenceNavItem { x: 10px; y: 36px; width: 180px; label: "Interface";
            icon: @image-url("../../../assets/icons/interface.svg");
            selected: root.selected-pane == 1; activated => { root.selected-pane = 1; root.selected-interface-section = 0; root.interface-scroll-position = 0px; } }
        if root.selected-pane == 1 : Rectangle { x: 24px; y: 76px; width: 2px; height: 144px; background: #d3d3d7; }
        if root.selected-pane == 1 : PreferenceSubNavItem { x: 32px; y: 72px; width: 158px; label: "Appearance";
            selected: root.selected-interface-section == 0;
            activated => { root.selected-interface-section = 0; root.interface-scroll-position = 0px; } }
        if root.selected-pane == 1 : PreferenceSubNavItem { x: 32px; y: 96px; width: 158px; label: "Window";
            selected: root.selected-interface-section == 1;
