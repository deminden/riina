        if root.selected-network-section == 0 : Rectangle {
        Rectangle { x: 20px; y: 80px; width: parent.width - 40px; height: 390px;
            border-radius: 12px; border-width: 1px; border-color: #e4e4e8; background: #fafafa;
            // Match the reference's compact rows; explanations stay with the control they qualify.
            Rectangle { x: 0; y: 0; width: parent.width; height: 40px; background: transparent;
                Text { x: 12px; y: 0; width: 18px; height: parent.height; text: "▤"; font-size: 14px; color: #77777d; vertical-alignment: center; }
                PreferenceSwitch { x: 36px; y: 6px; width: parent.width - 48px;
                    label: "Prefetch and buffer network data";
                    checked <=> root.network-cache-enabled;
                    toggled => { root.settings-changed(); }
