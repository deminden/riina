    in-out property <bool> thumbnail-remote-enabled: false;
    in-out property <string> thumbnail-width-text: "120";
    in-out property <bool> display-time-and-battery-in-fullscreen: false;
    in-out property <length> interface-scroll-position: 0px;
    in-out property <bool> always-float-on-top: false;
    in-out property <bool> always-show-on-top-icon: false;
    in-out property <int> window-resize-option-index: 2;
    in-out property <int> window-resize-timing-index: 1;
    in-out property <bool> use-physical-resolution: true;
    in-out property <bool> initial-window-size-enabled: false;
    in-out property <int> initial-window-size-axis-index: 0;
    in-out property <string> initial-window-size-value-text: "1280";
    in-out property <int> initial-window-size-unit-index: 0;
    in-out property <bool> initial-window-position-enabled: false;
    in-out property <int> initial-window-x-anchor-index: 0;
    in-out property <string> initial-window-x-offset-text: "20";
    in-out property <int> initial-window-x-unit-index: 0;
    in-out property <int> initial-window-y-anchor-index: 1;
    in-out property <string> initial-window-y-offset-text: "20";
    in-out property <int> initial-window-y-unit-index: 0;
    // Expanded source rows move every following SettingsList and its scroll target.
    out property <length> interface-appearance-card-y: 81px;
    out property <length> liquid-glass-detail-height: liquid-glass-expanded ? 96px : 0px;
    out property <length> interface-appearance-card-height: 122px + liquid-glass-detail-height;
    out property <length> interface-window-title-y: interface-appearance-card-y + interface-appearance-card-height + 17px;
    out property <length> interface-window-y: interface-window-title-y + 28px;
    out property <length> initial-window-size-detail-height: initial-window-size-enabled ? 34px : 0px;
    out property <length> initial-window-position-detail-height: initial-window-position-enabled ? 100px : 0px;
    out property <length> interface-window-card-height: 82px + initial-window-size-detail-height + initial-window-position-detail-height;
    out property <length> interface-resize-y: interface-window-y + interface-window-card-height + 16px;
    out property <length> interface-physical-resolution-y: interface-resize-y + 134px;
    out property <length> interface-float-y: interface-physical-resolution-y + 56px;
    out property <length> interface-osc-y: interface-float-y + 96px;
    out property <length> interface-osc-card-height: 500px;
    out property <length> interface-osd-y: interface-osc-y + interface-osc-card-height + 16px;
    out property <length> osd-suppression-detail-height: osd-suppression-expanded ? 112px : 0px;
    out property <length> interface-thumbnail-y: interface-osd-y + 108px + osd-suppression-detail-height + 128px;
    out property <length> interface-pip-y: interface-thumbnail-y + 236px;
    out property <length> interface-pip-card-height: 148px;
    out property <length> interface-accessibility-y: interface-pip-y + interface-pip-card-height + 44px;
    out property <length> interface-content-height: interface-accessibility-y + root.height - 13px;
    out property <length> interface-window-target: 0px - (interface-window-title-y - 13px);
    out property <length> interface-osc-target: 0px - (interface-osc-y - 13px);
    out property <length> interface-osd-target: 0px - (interface-osd-y - 13px);
    out property <length> interface-thumbnail-target: 0px - (interface-thumbnail-y - 13px);
    out property <length> interface-pip-target: 0px - (interface-pip-y - 13px);
    out property <length> interface-accessibility-target: 0px - (interface-accessibility-y - 13px);
    out property <length> general-history-target: 0px - ((459px
        + (root.when-media-opened-expanded ? 166px : 0px)
        + (root.pause-resume-when-expanded ? (root.pause-policies-available ? 168px : 104px) : 0px)) - 13px);
    out property <length> general-playlist-target: 0px - ((604px
        + (root.when-media-opened-expanded ? 166px : 0px)
        + (root.pause-resume-when-expanded ? (root.pause-policies-available ? 168px : 104px) : 0px)) - 13px);
    out property <length> general-screenshots-target: 0px - ((820px
        + (root.when-media-opened-expanded ? 166px : 0px)
        + (root.pause-resume-when-expanded ? (root.pause-policies-available ? 168px : 104px) : 0px)) - 13px);
    out property <length> interface-appearance-threshold: interface-window-target / 2;
    out property <length> interface-window-threshold: (interface-window-target + interface-osc-target) / 2;
    out property <length> interface-osc-threshold: (interface-osc-target + interface-osd-target) / 2;
    out property <length> interface-osd-threshold: (interface-osd-target + interface-thumbnail-target) / 2;
    out property <length> interface-thumbnail-threshold: (interface-thumbnail-target + interface-pip-target) / 2;
    out property <length> interface-pip-threshold: (interface-pip-target + interface-accessibility-target) / 2;
    in-out property <int> selected-network-section: 0;
    in-out property <int> selected-audio-section: 0;
    in-out property <string> search-query: "";
    in property <[PreferencesSearchResult]> search-results: [];
    in-out property <int> selected-search-index: -1;
    in-out property <length> subtitle-scroll-position: 0px;
    callback search-query-changed(string);
