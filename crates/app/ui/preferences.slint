        content-y <=> root.interface-scroll-position;
        horizontal-scrollbar-policy: always-off;
        scrolled => {
            if root.interface-scroll-position > root.interface-appearance-threshold { root.selected-interface-section = 0; }
            else if root.interface-scroll-position > root.interface-window-threshold { root.selected-interface-section = 1; }
            else if root.interface-scroll-position > root.interface-osc-threshold { root.selected-interface-section = 2; }
            else if root.interface-scroll-position > root.interface-osd-threshold { root.selected-interface-section = 3; }
            else if root.interface-scroll-position > root.interface-thumbnail-threshold { root.selected-interface-section = 4; }
            else if root.interface-scroll-position > root.interface-pip-threshold { root.selected-interface-section = 5; }
            else { root.selected-interface-section = 6; }
        }
