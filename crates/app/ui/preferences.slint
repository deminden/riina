    if root.selected-pane == 6 : ScrollView {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        content-height: 760px; content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        Rectangle { width: parent.width; height: 760px; background: #ffffff;
            Text { x: 28px; y: 16px; text: "Control"; font-size: 15px; font-weight: 600; color: #222222; }
            Text { x: 28px; y: 52px; text: "Trackpad"; font-size: 13px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 78px; width: parent.width - 40px; height: 82px;
                border-width: 1px; border-color: #e4e4e7; border-radius: 10px; background: #f8f8f8;
                VerticalLayout { spacing: 0px;
                    PreferenceChoiceRow { label: "Pinch to"; options: ["Adjust window size", "Fullscreen", "None"];
                        selected-index <=> root.control-pinch-index;
                        selected => { root.settings-changed(); }
                    }
                    PreferenceChoiceRow { label: "Force Touch to"; options: ["None", "Enter/Exit full screen", "Pause/Resume", "Hide OSC"];
                        selected-index <=> root.control-force-touch-choice;
                        selected => { root.settings-changed(); }
                    }
                }
            }

            Text { x: 28px; y: 174px; text: "Mouse"; font-size: 13px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 200px; width: parent.width - 40px; height: 204px;
                border-width: 1px; border-color: #e4e4e7; border-radius: 10px; background: #f8f8f8;
                VerticalLayout { spacing: 0px;
                    PreferenceChoiceRow { label: "Single click to"; options: ["None", "Pause/Resume", "Hide OSC"];
                        selected-index <=> root.control-single-click-choice;
                        selected => { root.settings-changed(); }
                    }
                    PreferenceChoiceRow { label: "Double click to"; options: ["None", "Enter/Exit full screen", "Pause/Resume", "Hide OSC", "Enter/Exit picture-in-picture", "A-B loop", "Reset speed"];
                        selected-index <=> root.control-double-click-choice;
                        selected => { root.settings-changed(); }
                    }
                    PreferenceChoiceRow { label: "Right click to"; options: ["None", "Pause/Resume", "Hide OSC", "Enter/Exit picture-in-picture", "A-B loop", "Reset speed"];
                        selected-index <=> root.control-right-click-choice;
                        selected => { root.settings-changed(); }
                    }
                    PreferenceChoiceRow { label: "Middle click to"; options: ["None", "Enter/Exit full screen", "Pause/Resume", "Hide OSC", "Enter/Exit picture-in-picture", "A-B loop", "Reset speed"];
                        selected-index <=> root.control-middle-click-choice;
                        selected => { root.settings-changed(); }
                    }
                    PreferenceSwitch { label: "Accepts first mouse click when not focused";
                        checked <=> root.control-accepts-first-mouse;
                        toggled => { root.settings-changed(); }
                    }
                }
            }

            Text { x: 28px; y: 418px; text: "Scroll"; font-size: 13px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 444px; width: parent.width - 40px; height: 80px;
                border-width: 1px; border-color: #e4e4e7; border-radius: 10px; background: #f8f8f8;
                VerticalLayout { spacing: 0px;
                    PreferenceChoiceRow { label: "Scroll vertically to"; options: ["Adjust volume", "Seek", "None", "Adjust playback speed"];
                        selected-index <=> root.control-vertical-scroll-index;
                        selected => { root.settings-changed(); }
                    }
                    PreferenceChoiceRow { label: "Scroll horizontally to"; options: ["Adjust volume", "Seek", "None", "Adjust playback speed"];
                        selected-index <=> root.control-horizontal-scroll-index;
                        selected => { root.settings-changed(); }
                    }
                }
            }

            Text { x: 28px; y: 538px; text: "Scrolling sensitivity"; font-size: 13px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 564px; width: parent.width - 40px; height: 152px;
                border-width: 1px; border-color: #e4e4e7; border-radius: 10px; background: #f8f8f8;
                VerticalLayout { spacing: 0px;
                    PreferenceChoiceRow { label: "Seek type"; options: ["Keyframe seek", "Exact seek", "Auto"];
                        selected-index <=> root.control-seek-type-index;
                        selected => { root.settings-changed(); }
                    }
                    PreferenceSensitivityRow { label: "Relative seek amount"; value <=> root.control-relative-seek-amount;
                        changed => { root.settings-changed(); }
                    }
                    PreferenceSensitivityRow { label: "Sensitivity for speed"; value <=> root.control-speed-sensitivity;
                        changed => { root.settings-changed(); }
                    }
                    PreferenceSensitivityRow { label: "Sensitivity for volume"; value <=> root.control-volume-sensitivity;
                        changed => { root.settings-changed(); }
                    }
                }
            }
        }
    }
    if root.selected-pane == 7 : ScrollView {
