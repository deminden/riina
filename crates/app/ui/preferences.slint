                        text <=> root.network-ytdl-search-path; font-size: 11px; color: #222222;
                        enabled: root.network-ytdl-enabled && !root.network-ytdl-plugin-active;
                        accepted => { root.settings-changed(); }
                    }
                }
                Text { x: 12px; y: 90px; width: parent.width - 24px; height: 24px;
