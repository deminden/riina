                        }
                    }
                }
                KeyBindingIconButton {
                    x: parent.width - 82px; y: 4px; label: "Delete profile"; icon-kind: 0;
                    enabled: root.key-binding-profile-index >= 5;
                    activated => { root.key-binding-profile-delete-confirm-open = true; }
                }
                KeyBindingIconButton {
                    x: parent.width - 44px; y: 4px; label: "Add key binding set"; icon-kind: 3;
                    activated => { root.key-binding-profile-menu-open = !root.key-binding-profile-menu-open; }
                }
                Rectangle { x: 1px; y: 52px; width: parent.width - 2px; height: 1px; background: #e3e3e6; }
                Rectangle {
                    x: 28px; y: 62px; width: parent.width - 136px; height: 28px;
                    border-width: 1px; border-color: #dedee2; border-radius: 14px;
                    background: #ffffff;
                    Image { x: 8px; y: 6px; width: 16px; height: 16px;
                        source: @image-url("../../../assets/icons/search.svg"); }
                    if root.key-binding-search-query.is-empty : Text {
                        x: 30px; y: 0; width: parent.width - 38px; height: parent.height;
                        text: "Search"; font-size: 11px; color: #89898f; vertical-alignment: center;
                    }
                    TextInput {
                        x: 30px; y: 0; width: parent.width - 38px; height: parent.height;
                        text <=> root.key-binding-search-query; single-line: true;
                        font-size: 11px; color: #29292d; vertical-alignment: center;
                        accessible-label: "Search key bindings";
                        changed text => { root.key-binding-search-changed(self.text); }
                    }
                }
                KeyBindingIconButton {
                    x: parent.width - 96px; y: 58px; width: 40px; height: 36px;
                    label: "Add key binding"; icon-kind: 1;
                    enabled: root.key-binding-profile-index >= 5;
                    activated => { root.key-binding-add-requested(); }
                }
                if root.key-binding-rows.length == 0 : Text {
                    x: 28px; y: 100px; width: parent.width - 52px; height: 44px;
                    text: "No mappings in this configuration";
                    font-size: 11px; color: #77777d; vertical-alignment: center;
                }
                if root.key-binding-rows.length > 0 : VerticalLayout {
                    x: 20px; y: 96px; width: parent.width - 40px;
                    spacing: 0px;
                    for row[index] in root.key-binding-rows : KeyBindingActionRow {
                        entry: row; row-index: index; row-count: root.key-binding-rows.length;
                        editable: root.key-binding-profile-index >= 5;
                        selected-index: root.key-binding-selected-row;
                        selected: root.key-binding-selected-row == index;
                        activated(selected-row) => {
                            root.key-binding-selected-row = selected-row;
                            root.key-binding-row-selected(selected-row);
                        }
                        edit-requested(row-index) => { root.key-binding-edit-requested(row-index); }
                        remove-requested(row-index) => { root.key-binding-remove-requested(row-index); }
                    }
                }
                Rectangle {
                    x: 1px; y: root.key-binding-rows.length == 0 ? 152px : 132px + root.key-binding-rows.length * 32px;
                    width: parent.width - 2px; height: 1px; background: #e3e3e6;
                }
                Text {
                    x: 20px; y: root.key-binding-rows.length == 0 ? 164px : 144px + root.key-binding-rows.length * 32px;
                    width: parent.width - 88px; height: 28px;
                    text: "Display raw values"; font-size: 11px; color: #29292d;
                    vertical-alignment: center;
                }
                PreferenceSwitch {
                    x: parent.width - 68px; y: root.key-binding-rows.length == 0 ? 164px : 144px + root.key-binding-rows.length * 32px;
                    width: 44px; height: 28px; label: "Display raw values"; show-label: false;
                    checked <=> root.key-binding-display-raw-values;
                    toggled => { root.key-binding-settings-changed(); root.settings-changed(); }
                }
                if root.key-binding-profile-menu-open : Rectangle {
                    x: parent.width - 194px; y: 34px; width: 188px; height: root.key-binding-profile-index >= 5 ? 158px : 128px;
                    border-width: 1px; border-color: #d4d4d8; border-radius: 8px;
                    background: #ffffff;
                    KeyBindingProfileMenuItem {
                        x: 2px; y: 3px; label: "Create empty set";
                        activated => {
                            root.key-binding-profile-menu-open = false;
                            root.key-binding-profile-editor-mode = 0;
                            root.key-binding-profile-editor-name = "";
                            root.key-binding-profile-editor-open = true;
                        }
                    }
                    KeyBindingProfileMenuItem {
                        x: 2px; y: 33px; label: "Duplicate current set";
                        activated => {
                            root.key-binding-profile-menu-open = false;
                            root.key-binding-profile-editor-mode = 1;
                            root.key-binding-profile-editor-name = "";
                            root.key-binding-profile-editor-open = true;
                        }
                    }
                    if root.key-binding-profile-index >= 5 : KeyBindingProfileMenuItem {
                        x: 2px; y: 63px; label: "Rename current set…";
                        activated => {
                            root.key-binding-profile-menu-open = false;
                            root.key-binding-profile-editor-mode = 2;
                            root.key-binding-profile-editor-name = root.key-binding-current-profile;
                            root.key-binding-profile-editor-open = true;
                        }
                    }
                    KeyBindingProfileMenuItem {
                        x: 2px; y: root.key-binding-profile-index >= 5 ? 93px : 63px; label: "Import configuration…";
                        activated => {
                            root.key-binding-profile-menu-open = false;
                            root.key-binding-import-profile-requested();
                        }
                    }
                    Rectangle { x: 8px; y: root.key-binding-profile-index >= 5 ? 124px : 94px; width: parent.width - 16px; height: 1px; background: #e5e5e8; }
                    KeyBindingProfileMenuItem {
                        x: 2px; y: root.key-binding-profile-index >= 5 ? 126px : 96px; label: "Show profile file";
                        activated => {
                            root.key-binding-profile-menu-open = false;
                            root.key-binding-reveal-profile();
                        }
                    }
                }
            }
        }
    }
    if root.selected-pane == 8 : ScrollView {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        content-height: 760px; content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        Rectangle { width: parent.width; height: 760px; background: #ffffff;
            Text { x: 28px; y: 16px; text: "Advanced"; font-size: 15px; font-weight: 600; color: #222222; }

            Rectangle { x: 20px; y: 53px; width: parent.width - 40px; height: 74px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                Image { x: 34px; y: 10px; width: 16px; height: 16px;
                    source: @image-url("../../../assets/icons/advanced.svg"); image-fit: contain; }
                Text { x: 57px; y: 8px; width: parent.width - 110px; height: 23px;
                    text: "Enable advanced settings"; font-size: 12px; color: #252529; vertical-alignment: center; }
                PreferenceSwitch { x: parent.width - 66px; y: 8px; width: 42px; height: 28px;
                    label: "Enable advanced settings"; checked: root.advanced-enabled;
                    toggled => { root.advanced-enabled = !root.advanced-enabled; root.advanced-settings-changed(); }
                }
                Text { x: 57px; y: 32px; width: parent.width - 80px; height: 34px;
                    text: "The following settings require restarting Riina to take effect.";
                    font-size: 10px; color: #74747a; wrap: word-wrap; vertical-alignment: top; }
            }

            Text { x: 28px; y: 146px; text: "Logging"; font-size: 13px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 181px; width: parent.width - 40px; height: 90px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                Image { x: 35px; y: 8px; width: 14px; height: 14px;
                    source: @image-url("../../../assets/icons/log-level.svg"); image-fit: contain; }
                Text { x: 57px; y: 0px; width: 120px; height: 40px;
                    text: "Log level"; font-size: 12px; color: root.advanced-enabled ? #252529 : #98989e; vertical-alignment: center; }
                ComboBox { x: 176px; y: 7px; width: parent.width - 190px; height: 25px;
                    model: ["Verbose", "Debug", "Warning", "Error"];
                    current-index <=> root.advanced-log-level-index; enabled: root.advanced-enabled;
                    selected => { root.advanced-settings-changed(); }
                }
                Text { x: 57px; y: 42px; width: 130px; height: 40px;
                    text: "Enable logging to file"; font-size: 12px;
                    color: root.advanced-enabled ? #252529 : #98989e; vertical-alignment: center; wrap: word-wrap; }
                PreferenceActionButton { x: 178px; y: 49px; width: 112px; label: "Open Log Directory";
                    enabled: root.advanced-enabled;
                    activated => { root.advanced-open-log-folder(); }
                }
                PreferenceSwitch { x: parent.width - 66px; y: 45px; width: 42px; height: 28px;
                    label: "Enable logging to file"; enabled: root.advanced-enabled;
                    checked: root.advanced-logging-enabled;
                    toggled => { root.advanced-logging-enabled = !root.advanced-logging-enabled; root.advanced-settings-changed(); }
                }
            }
            Rectangle { x: 20px; y: 287px; width: parent.width - 40px; height: 42px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                Image { x: 35px; y: 13px; width: 14px; height: 14px;
                    source: @image-url("../../../assets/icons/log-viewer.svg"); image-fit: contain; }
                Text { x: 57px; y: 0px; width: parent.width - 122px; height: parent.height;
                    text: "Open the log viewer"; font-size: 12px; color: root.advanced-enabled ? #252529 : #98989e; vertical-alignment: center; }
                PreferenceActionButton { x: parent.width - 60px; y: 9px; width: 36px; label: "→";
                    enabled: root.advanced-enabled; activated => { root.advanced-open-log-viewer(); }
                }
            }

            Text { x: 28px; y: 348px; text: "mpv Settings"; font-size: 13px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 375px; width: parent.width - 40px; height: 42px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                Image { x: 35px; y: 13px; width: 14px; height: 14px;
                    source: @image-url("../../../assets/icons/mpv-osd.svg"); image-fit: contain; }
                Text { x: 57px; y: 0px; width: parent.width - 110px; height: parent.height;
                    text: "Use mpv's OSD"; font-size: 12px; color: root.advanced-enabled ? #252529 : #98989e; vertical-alignment: center; }
                PreferenceSwitch { x: parent.width - 66px; y: 7px; width: 42px; height: 28px;
                    label: "Use mpv's OSD"; enabled: root.advanced-enabled;
                    checked: root.advanced-use-mpv-osd;
                    toggled => { root.advanced-use-mpv-osd = !root.advanced-use-mpv-osd; root.advanced-settings-changed(); }
                }
            }
            Rectangle { x: 20px; y: 433px; width: parent.width - 40px; height: 42px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                Image { x: 35px; y: 13px; width: 14px; height: 14px;
                    source: @image-url("../../../assets/icons/config-directory.svg"); image-fit: contain; }
                Text { x: 57px; y: 0px; width: 112px; height: parent.height;
                    text: "Use config directory"; font-size: 11px;
                    color: root.advanced-enabled ? #252529 : #98989e; vertical-alignment: center; }
                TextInput { x: 170px; y: 9px; width: parent.width - 260px; height: 24px;
                    text <=> root.advanced-config-directory-text;
                    enabled: root.advanced-enabled && root.advanced-use-config-directory;
                    accepted => { root.advanced-settings-changed(); }
                }
                PreferenceActionButton { x: parent.width - 119px; y: 8px; width: 53px; label: "Choose…";
                    enabled: root.advanced-enabled && root.advanced-use-config-directory;
                    activated => { root.advanced-choose-config-directory(); }
                }
                PreferenceSwitch { x: parent.width - 62px; y: 7px; width: 42px; height: 28px;
                    label: "Use config directory"; enabled: root.advanced-enabled;
                    checked: root.advanced-use-config-directory;
                    toggled => { root.advanced-use-config-directory = !root.advanced-use-config-directory; root.advanced-settings-changed(); }
                }
            }
            Text { x: 28px; y: 536px; text: "Additional mpv options"; font-size: 13px; font-weight: 600; color: #77777d; }
            Text { x: 28px; y: 558px; width: parent.width - 48px; height: 30px;
                text: "Paste an option in key=value format to fill both fields automatically. Changes take effect after restarting Riina.";
                font-size: 10px; color: #74747a; wrap: word-wrap; }
            Rectangle { x: 20px; y: 591px; width: parent.width - 40px; height: 150px;
                border-width: 1px; border-color: #dedee1; border-radius: 8px; background: #f8f8f8;
                Text { x: 8px; y: 3px; width: 164px; height: 20px; text: "Key"; font-size: 10px; font-weight: 600; color: #77777d; vertical-alignment: center; }
                Text { x: 179px; y: 3px; width: parent.width - 224px; height: 20px; text: "Value"; font-size: 10px; font-weight: 600; color: #77777d; vertical-alignment: center; }
                for option[index] in root.advanced-mpv-options: Rectangle {
                    x: 6px; y: 24px + index * 22px; width: parent.width - 12px; height: 20px;
                    background: root.advanced-mpv-option-selection == index ? #e5edf7 : transparent;
                    TextInput { x: 2px; y: 0px; width: 164px; height: parent.height;
                        text: option.name; font-size: 10px; color: #29292d; enabled: root.advanced-enabled;
                        accepted => { root.advanced-mpv-option-selection = index; root.advanced-option-edited(index, self.text, option.value); root.settings-changed(); }
                    }
                    TextInput { x: 173px; y: 0px; width: parent.width - 220px; height: parent.height;
                        text: option.value; font-size: 10px; color: #29292d; enabled: root.advanced-enabled;
                        accepted => { root.advanced-mpv-option-selection = index; root.advanced-option-edited(index, option.name, self.text); root.settings-changed(); }
                    }
                }
                PreferenceActionButton { x: 8px; y: parent.height - 29px; width: 26px; label: "+";
                    enabled: root.advanced-enabled; activated => { root.advanced-option-added(); }
                }
                PreferenceActionButton { x: 40px; y: parent.height - 29px; width: 26px; label: "−";
                    enabled: root.advanced-enabled && root.advanced-mpv-option-selection >= 0;
                    activated => { root.advanced-option-removed(root.advanced-mpv-option-selection); }
                }
            }
        }
    }
    if root.selected-pane == 9 : Rectangle {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        background: #ffffff;
        Text { x: 20px; y: 16px; text: "Plugins"; font-size: 15px; font-weight: 600; color: #222222; }
        Rectangle {
            x: 12px; y: 52px; width: parent.width - 24px; height: 104px;
            border-width: 1px; border-color: #dedee1; border-radius: 13px; background: #fafafa;
            Text {
                x: 12px; y: 10px; width: parent.width - 24px; height: 42px;
                text: "You can install a new plugin from GitHub or a local .iinaplgz package. Plugins installed from GitHub can be updated automatically.";
                font-size: 11px; color: #77777d; wrap: word-wrap;
                vertical-alignment: center;
            }
            PluginPageActionButton {
                x: 12px; y: 67px; width: 104px; label: "Get Plugins…";
                activated => { root.plugin-request-github-install(); }
            }
            PluginPageActionButton {
                x: 124px; y: 67px; width: 160px; label: "Install Local Package…";
                activated => { root.plugin-request-local-install(); }
            }
        }
        Text {
            x: 12px; y: 163px; width: parent.width - 56px; height: 28px;
            text: root.plugin-update-status; font-size: 11px; font-weight: 600;
            color: #85858a; vertical-alignment: center; overflow: elide;
        }
        PluginPageIconButton {
            x: parent.width - 47px; y: 165px; width: 28px; height: 24px;
            icon-kind: 2; label: "Check for plugin updates";
            activated => { root.plugin-refresh(); }
        }
        if root.plugin-rows.length > 0 : Rectangle {
            x: 12px; y: 196px; width: parent.width - 24px;
            height: root.plugin-rows.length * 60px;
            border-width: 1px; border-color: #dedee1; border-radius: 13px; background: #fafafa;
            for row[index] in root.plugin-rows : PluginPreferencesRowView {
                x: 0px; y: index * 60px; width: parent.width;
                entry: row; row-index: index; last-row: index == root.plugin-rows.length - 1;
                plugin-id-transfer(identifier) => { root.plugin-id-transfer(identifier); }
                plugin-id-from-transfer(transfer) => { root.plugin-id-from-transfer(transfer); }
                enabled-toggled(index, enabled) => { root.plugin-enabled-changed(index, enabled); }
                about-requested(index) => { root.plugin-row-about(index); }
                actions-requested(index) => { root.plugin-row-actions(index); }
                reorder-requested(dragged, target) => { root.plugin-reordered(dragged, target); }
            }
        }
    }
    if root.selected-pane == 10 : ScrollView {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        content-height: 700px; content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        Rectangle { width: parent.width; height: 700px; background: #ffffff;
            Text { x: 28px; y: 16px; text: "Utilities"; font-size: 15px; font-weight: 600; color: #222222; }
            Text { x: 20px; y: 52px; text: "Default Application"; font-size: 12px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 81px; width: parent.width - 40px; height: 42px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                UtilitiesActionRow { width: parent.width; height: parent.height;
                    symbol: "▣"; title: "Set Riina as the Default Application";
                    activated => { root.utilities-open-default-apps(); }
                }
            }
            Text { x: 20px; y: 144px; text: "Restore Alerts"; font-size: 12px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 168px; width: parent.width - 40px; height: 76px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                UtilitiesActionRow { width: parent.width; height: parent.height;
                    symbol: "↻"; title: "Restore Suppressed Alerts";
                    description: "Restore alerts hidden with ‘Do not show this message again’.";
                    activated => { root.utilities-restore-alerts(); }
                }
            }
            Text { x: 20px; y: 268px; text: "Clear Cache"; font-size: 12px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 290px; width: parent.width - 40px; height: 202px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                UtilitiesActionRow { width: parent.width; height: 87px;
                    symbol: "◷"; title: "Clear Saved Playback Progress";
                    description: "Delete all files in the \"watch later\" folder. These files contain all saved playback progress and settings applied during playback.";
                    trash: true; activated => { root.utilities-clear-progress(); }
                }
                UtilitiesActionRow { y: 87px; width: parent.width; height: 74px;
                    symbol: "▤"; title: "Clear Playback History";
                    description: "Delete all playback histories and entries in \"Open Recent\".";
                    trash: true;
                    activated => { root.utilities-clear-history(); }
                }
                UtilitiesActionRow { y: 161px; width: parent.width; height: 41px;
                    symbol: "▧"; title: "Clear Thumbnail Cache";
                    metric: root.utilities-thumbnail-size; trash: true;
                    activated => { root.utilities-clear-thumbnail-cache(); }
                }
            }
            Text { x: 20px; y: 514px; text: "Browser Extensions"; font-size: 12px; font-weight: 600; color: #77777d; }
            Rectangle { x: 20px; y: 536px; width: parent.width - 40px; height: 116px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                Text { x: 16px; y: 12px; width: parent.width - 32px; height: 20px;
                    text: "Get Browser Extensions for Riina"; font-size: 12px; color: #29292d; }
                Text { x: 16px; y: 34px; width: parent.width - 32px; height: 34px;
                    text: "Send a link or the current webpage to the player."; font-size: 10px; color: #74747a; wrap: word-wrap; }
                Text { x: 16px; y: 76px; width: parent.width - 32px; height: 24px;
                    text: "Browser integration is not available yet."; font-size: 10px; color: #8a8a90; vertical-alignment: center; }
            }
            if !root.utilities-status.is-empty : Text {
                x: 20px; y: 660px; width: parent.width - 40px; height: 20px;
                text: root.utilities-status; font-size: 10px; color: #69696f; wrap: word-wrap;
            }
        }
    }

    if !root.search-query.is-empty : Rectangle {
        x: 8px; y: 48px; width: 340px;
        height: min(400px, max(120px, root.search-results.length * 38px));
        border-radius: 8px; border-width: 1px; border-color: #d0d0d5;
        background: #fbfbfc;
        ScrollView {
            width: parent.width; height: parent.height;
            content-height: max(120px, root.search-results.length * 38px);
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            if root.search-results.length == 0 : Text {
                width: parent.width; height: parent.height;
                text: "No Results"; font-size: 13px; color: #77777d;
                horizontal-alignment: center; vertical-alignment: center;
            }
            if root.search-results.length > 0 : VerticalLayout {
                width: parent.width; spacing: 0px;
                for result[index] in root.search-results : PreferenceSearchResultCell {
                    result: result;
                    selected: root.selected-search-index == index;
                    activated(page-index, section-name, title, anchor-y) => {
                        root.search-result-activated(page-index, section-name, title, anchor-y);
                    }
                }
            }
        }
    }

    if root.key-binding-profile-editor-open : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000055;
        Rectangle {
            x: (parent.width - 340px) / 2; y: (parent.height - 168px) / 2;
            width: 340px; height: 168px;
            border-radius: 10px; border-width: 1px; border-color: #c8c8cd;
            background: #f7f7f8;
            Text {
                x: 20px; y: 14px; width: parent.width - 40px; height: 22px;
                text: root.key-binding-profile-editor-mode == 0 ? "Create key binding set" : root.key-binding-profile-editor-mode == 1 ? "Duplicate key binding set" : "Rename key binding set";
                font-size: 14px; font-weight: 600; color: #222226;
            }
            Text { x: 20px; y: 42px; width: parent.width - 40px; height: 18px;
                text: root.key-binding-profile-editor-mode == 2 ? "Enter a new name for this set." : "Enter a name for the new set."; font-size: 11px; color: #68686e; }
            Rectangle { x: 20px; y: 70px; width: parent.width - 40px; height: 30px;
                border-radius: 5px; border-width: 1px; border-color: #b8b8bc; background: #ffffff;
                TextInput { x: 7px; y: 1px; width: parent.width - 14px; height: parent.height - 2px;
                    text <=> root.key-binding-profile-editor-name; single-line: true;
                    font-size: 11px; color: #222226; accessible-label: "Key binding set name"; }
            }
            PreferenceActionButton {
                x: parent.width - 178px; y: 124px; label: "Cancel";
                activated => { root.key-binding-profile-editor-cancelled(); }
            }
            PreferenceActionButton {
                x: parent.width - 92px; y: 124px;
                label: root.key-binding-profile-editor-mode == 0 ? "Create" : root.key-binding-profile-editor-mode == 1 ? "Duplicate" : "Rename";
                activated => {
                    if !root.key-binding-profile-editor-name.is-empty {
                        root.key-binding-profile-created(root.key-binding-profile-editor-name,
                            root.key-binding-profile-editor-mode);
                    }
                }
            }
        }
    }

    if root.key-binding-profile-delete-confirm-open : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000055;
        Rectangle {
            x: (parent.width - 340px) / 2; y: (parent.height - 156px) / 2;
            width: 340px; height: 156px;
            border-radius: 10px; border-width: 1px; border-color: #c8c8cd;
            background: #f7f7f8;
            Text {
                x: 20px; y: 16px; width: parent.width - 40px; height: 22px;
                text: "Delete key binding set?";
                font-size: 14px; font-weight: 600; color: #222226;
            }
            Text {
                x: 20px; y: 45px; width: parent.width - 40px; height: 38px;
                text: "The selected set will be removed from this computer.";
                font-size: 11px; color: #68686e; wrap: word-wrap;
            }
            PreferenceActionButton {
                x: parent.width - 178px; y: 112px; label: "Cancel";
                activated => { root.key-binding-profile-delete-confirm-open = false; }
            }
            PreferenceActionButton {
                x: parent.width - 92px; y: 112px; label: "Delete";
                activated => {
                    root.key-binding-profile-delete-confirm-open = false;
                    root.key-binding-delete-profile();
                }
            }
        }
    }

    if root.key-binding-editor-open : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000055;
        Rectangle {
            x: (parent.width - 360px) / 2; y: (parent.height - 250px) / 2;
            width: 360px; height: 250px;
            border-radius: 10px; border-width: 1px; border-color: #c8c8cd;
            background: #f7f7f8;
            Text { x: 20px; y: 14px; width: parent.width - 40px; height: 22px;
                text: "Key Mapping"; font-size: 14px; font-weight: 600; color: #222226; }
            Text { x: 20px; y: 39px; width: parent.width - 40px; height: 18px;
                text: "Press a key, then choose what it should do.";
                font-size: 11px; color: #68686e; }
            Text { x: 20px; y: 67px; width: 52px; height: 26px; text: "Key";
                font-size: 11px; color: #29292d; vertical-alignment: center; }
            FocusScope {
                x: 76px; y: 67px; width: parent.width - 96px; height: 26px;
                accessible-role: button; accessible-label: "Press a key to record its shortcut";
                Rectangle { width: parent.width; height: parent.height;
                    border-radius: 4px; border-width: 1px;
                    border-color: parent.has-focus ? #168bff : #b8b8bc;
                    background: #ffffff;
                    Text { width: parent.width; height: parent.height;
                        text: root.key-binding-editor-key.is-empty ? "Press a key…" : root.key-binding-editor-key;
                        font-size: 11px; color: root.key-binding-editor-key.is-empty ? #85858b : #222226;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                key-pressed(event) => {
                    if event.text == Key.Escape { root.key-binding-editor-cancelled(); return accept; }
                    if event.text == Key.Tab { return reject; }
                    root.key-binding-key-recorded(event.text, event.modifiers.control,
                        event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                    return accept;
                }
                capture-touch := TouchArea { clicked => { parent.focus(); } }
            }
            Text { x: 20px; y: 101px; width: 52px; height: 26px; text: "Action";
                font-size: 11px; color: #29292d; vertical-alignment: center; }
            Rectangle { x: 76px; y: 101px; width: parent.width - 96px; height: 26px;
                border-radius: 4px; border-width: 1px; border-color: #b8b8bc; background: #ffffff;
                TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                    text <=> root.key-binding-editor-action; single-line: true;
                    font-size: 11px; color: #222226; accessible-label: "Mapping action"; }
            }
            Text { x: 20px; y: 135px; width: 52px; height: 26px; text: "Note";
                font-size: 11px; color: #29292d; vertical-alignment: center; }
            Rectangle { x: 76px; y: 135px; width: parent.width - 96px; height: 26px;
                border-radius: 4px; border-width: 1px; border-color: #b8b8bc; background: #ffffff;
                TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                    text <=> root.key-binding-editor-comment; single-line: true;
                    font-size: 11px; color: #222226; accessible-label: "Mapping comment"; }
            }
            CheckBox {
                x: 76px; y: 168px; width: 180px; height: 22px;
                text: "Riina action"; checked: root.key-binding-editor-kind == 1;
                toggled => { root.key-binding-editor-kind = self.checked ? 1 : 0; }
            }
            Text { x: 20px; y: 192px; width: parent.width - 40px; height: 18px;
                text: "Use an mpv command unless this is a player action.";
                font-size: 10px; color: #77777d; }
            PreferenceActionButton {
                x: parent.width - 178px; y: 214px; label: "Cancel";
                activated => { root.key-binding-editor-cancelled(); }
            }
            PreferenceActionButton {
                x: parent.width - 92px; y: 214px; label: "OK";
                activated => {
                    if !root.key-binding-editor-key.is-empty && !root.key-binding-editor-action.is-empty {
                        root.key-binding-mapping-submitted(root.key-binding-editor-key,
                            root.key-binding-editor-action, root.key-binding-editor-comment,
                            root.key-binding-editor-kind, root.key-binding-editor-row);
                    }
                }
            }
        }
    }

    if root.plugin-github-sheet-open : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000055;
        Rectangle {
            x: (parent.width - 440px) / 2; y: (parent.height - 372px) / 2;
            width: 440px; height: 372px;
            border-radius: 10px; border-width: 1px; border-color: #c8c8cd;
            background: #f7f7f8;
            Text { x: 20px; y: 14px; width: parent.width - 40px; height: 22px;
                text: "Get Plugins"; font-size: 14px; font-weight: 600; color: #222226; }
            Text { x: 20px; y: 42px; width: parent.width - 40px; height: 34px;
                text: "Install a plugin from GitHub by entering its repository. Official plugins are listed below.";
                font-size: 11px; color: #68686e; wrap: word-wrap; }
            Text { x: 20px; y: 82px; width: 80px; height: 26px; text: "GitHub URL";
                font-size: 11px; color: #29292d; vertical-alignment: center; }
            Rectangle { x: 102px; y: 82px; width: parent.width - 122px; height: 26px;
                border-radius: 4px; border-width: 1px; border-color: #b8b8bc; background: #ffffff;
                TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                    text <=> root.plugin-github-repository; single-line: true;
                    font-size: 11px; color: #222226; enabled: !root.plugin-github-installing;
                    accessible-label: "GitHub repository URL";
                    accepted => { root.plugin-github-install-requested(root.plugin-github-repository); }
                }
            }
            Text { x: 20px; y: 122px; width: parent.width - 40px; height: 18px;
                text: "Official Plugins"; font-size: 11px; font-weight: 600; color: #77777d; }
            for official[index] in ["Online Media", "Userscript", "OpenSubtitles"] : Rectangle {
                x: 20px; y: 145px + index * 38px; width: parent.width - 40px; height: 34px;
                border-radius: 5px; border-width: 1px; border-color: #dedee1; background: #ffffff;
                Text { x: 10px; width: parent.width - 106px; height: parent.height;
                    text: official; font-size: 11px; color: #29292d;
                    vertical-alignment: center; }
                PluginPageActionButton {
                    x: parent.width - 90px; y: 4px; width: 78px; label: "Install";
                    enabled: !root.plugin-github-installing;
                    activated => {
                        root.plugin-github-repository = index == 0 ? "iina/plugin-online-media" :
                            index == 1 ? "iina/plugin-userscript" : "iina/plugin-opensub";
                        root.plugin-github-install-requested(root.plugin-github-repository);
                    }
                }
            }
            Text { x: 20px; y: 265px; width: parent.width - 40px; height: 22px;
                text: root.plugin-github-installing ? "Downloading and validating plugin…" : "Plugins remain disabled until you enable them.";
                font-size: 10px; color: #77777d; vertical-alignment: center; }
            PreferenceActionButton {
                x: parent.width - 178px; y: 328px; label: "Cancel";
                enabled: !root.plugin-github-installing;
                activated => { root.plugin-github-sheet-open = false; }
            }
            PreferenceActionButton {
                x: parent.width - 92px; y: 328px; label: "Install";
                enabled: !root.plugin-github-installing && !root.plugin-github-repository.is-empty;
                activated => { root.plugin-github-install-requested(root.plugin-github-repository); }
            }
        }
    }

    if root.utilities-default-app-sheet-open : Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000055;
        Rectangle {
            x: (parent.width - 440px) / 2; y: (parent.height - 252px) / 2;
            width: 440px; height: 252px;
            border-radius: 10px; border-width: 1px; border-color: #c8c8cd;
            background: #f7f7f8;
            Text { x: 20px; y: 16px; width: parent.width - 40px; height: 22px;
                text: "Set Riina as the Default Application";
                font-size: 14px; font-weight: 600; color: #222226; }
            Text { x: 20px; y: 47px; width: parent.width - 40px; height: 38px;
                text: "Choose the media types you want Riina to open. Your system controls the final default selection.";
                font-size: 11px; color: #68686e; wrap: word-wrap; }
            CheckBox { x: 24px; y: 96px; width: parent.width - 48px; height: 22px;
                text: "Video"; checked <=> root.utilities-default-video; }
            CheckBox { x: 24px; y: 122px; width: parent.width - 48px; height: 22px;
                text: "Audio"; checked <=> root.utilities-default-audio; }
            CheckBox { x: 24px; y: 148px; width: parent.width - 48px; height: 22px;
                text: "Playlists"; checked <=> root.utilities-default-playlist; }
            PreferenceActionButton {
                x: parent.width - 178px; y: 204px; label: "Cancel";
                activated => { root.utilities-default-app-sheet-open = false; }
            }
            PreferenceActionButton {
                x: parent.width - 92px; y: 204px; label: "OK";
                activated => {
                    root.utilities-default-app-sheet-open = false;
                    root.utilities-default-apps-requested(root.utilities-default-video,
                        root.utilities-default-audio, root.utilities-default-playlist);
                }
            }
        }
    }
}
