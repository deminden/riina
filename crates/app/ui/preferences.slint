            }
            Rectangle { x: 0; y: 40px; width: parent.width; height: 94px; background: transparent;
                border-width: 0px; border-color: #dedee2;
                PreferenceSwitch { x: 44px; y: 0; width: parent.width - 58px; height: 26px;
                    label: "Buffer before starting playback";
                    enabled: root.network-cache-enabled;
                    checked <=> root.network-cache-pause-initial; toggled => { root.settings-changed(); }
                }
                Text { x: 44px; y: 26px; width: parent.width - 62px; height: 48px;
                    text: "Enter buffering mode before playback starts. This can be useful to ensure playback starts smoothly, in exchange for waiting some time to prefetch and buffer network data.";
                    font-size: 10px; color: #77777d; wrap: word-wrap;
                }
                Text { x: 44px; y: 75px; width: parent.width - 62px; height: 16px;
                    text: "Default: 1"; font-size: 10px; color: #77777d; vertical-alignment: center; }
            }
            Rectangle { x: 0; y: 134px; width: parent.width; height: 64px; background: transparent;
                Text { x: 44px; y: 0; width: parent.width - 170px; height: 32px;
                    text: "Seconds to buffer before restarting"; font-size: 12px; color: #252529; vertical-alignment: center; wrap: word-wrap; }
                TextInput { x: parent.width - 94px; y: 9px; width: 66px; height: 24px;
                    enabled: root.network-cache-enabled;
                    text <=> root.network-cache-pause-wait-text; font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 44px; y: 32px; width: parent.width - 62px; height: 25px;
                    text: "Number of seconds the cache should have buffered before starting playback again if buffering mode was entered. Increase this setting if playback quickly reenters buffering mode.";
                    font-size: 10px; color: #77777d; wrap: word-wrap;
                }
            }
            Rectangle { x: 0; y: 198px; width: parent.width; height: 52px; background: transparent;
                Text { x: 44px; y: 0; width: parent.width - 170px; height: 30px;
