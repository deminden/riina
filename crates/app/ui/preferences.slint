        Rectangle { x: 20px; y: root.interface-window-y; width: parent.width - 40px; height: root.interface-window-card-height;
            border-width: 1px; border-color: #d6d6da; border-radius: 12px; background: #f8f8f8;
            PreferenceToggle { x: 24px; y: 4px; width: parent.width - 48px;
                label: "Initial window size"; checked <=> root.initial-window-size-enabled;
                toggled => { root.settings-changed(); }
            }
            if root.initial-window-size-enabled : Rectangle {
                x: 32px; y: 42px; width: parent.width - 64px; height: 26px; background: transparent;
                ComboBox { x: 0; y: 1px; width: 92px; height: 23px;
                    model: ["Width", "Height"];
                    current-index <=> root.initial-window-size-axis-index;
                    selected => { root.settings-changed(); }
                }
                Rectangle { x: 100px; y: 1px; width: 82px; height: 23px;
                    border-width: 1px; border-color: #b8b8bc; border-radius: 3px; background: #ffffff;
                    TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                        text <=> root.initial-window-size-value-text; font-size: 11px; color: #222222;
                        accepted => { root.settings-changed(); }
                    }
                }
                ComboBox { x: 190px; y: 1px; width: 116px; height: 23px;
                    model: ["point", "% of screen"];
                    current-index <=> root.initial-window-size-unit-index;
                    selected => { root.settings-changed(); }
                }
            }
            PreferenceToggle { x: 24px; y: 44px + root.initial-window-size-detail-height;
                width: parent.width - 48px; label: "Initial window position";
                checked <=> root.initial-window-position-enabled;
                toggled => { root.settings-changed(); }
            }
            if root.initial-window-position-enabled : Rectangle {
                x: 32px; y: 80px + root.initial-window-size-detail-height;
                width: parent.width - 64px; height: 96px; background: transparent;
                Text { x: 0; y: 0; width: 60px; height: 23px; text: "X Offset:";
                    font-size: 11px; color: #252529; vertical-alignment: center; }
                Rectangle { x: 62px; y: 0; width: 56px; height: 23px;
                    border-width: 1px; border-color: #b8b8bc; border-radius: 3px; background: #ffffff;
                    TextInput { x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
                        text <=> root.initial-window-x-offset-text; font-size: 11px; color: #222222;
                        accepted => { root.settings-changed(); }
                    }
                }
                ComboBox { x: 122px; y: 0; width: 94px; height: 23px;
                    model: ["point", "% of screen"];
                    current-index <=> root.initial-window-x-unit-index;
                    selected => { root.settings-changed(); }
                }
                Text { x: 16px; y: 24px; width: 34px; height: 23px; text: "to the";
                    font-size: 11px; color: #252529; vertical-alignment: center; }
                ComboBox { x: 52px; y: 24px; width: 84px; height: 23px;
                    model: ["left", "right"];
                    current-index <=> root.initial-window-x-anchor-index;
                    selected => { root.settings-changed(); }
                }
                Text { x: 140px; y: 24px; width: 92px; height: 23px; text: "side of screen";
                    font-size: 11px; color: #252529; vertical-alignment: center; }
                Text { x: 0; y: 48px; width: 60px; height: 23px; text: "Y Offset:";
                    font-size: 11px; color: #252529; vertical-alignment: center; }
                Rectangle { x: 62px; y: 48px; width: 56px; height: 23px;
                    border-width: 1px; border-color: #b8b8bc; border-radius: 3px; background: #ffffff;
                    TextInput { x: 4px; y: 1px; width: parent.width - 8px; height: parent.height - 2px;
                        text <=> root.initial-window-y-offset-text; font-size: 11px; color: #222222;
                        accepted => { root.settings-changed(); }
                    }
                }
                ComboBox { x: 122px; y: 48px; width: 94px; height: 23px;
                    model: ["point", "% of screen"];
                    current-index <=> root.initial-window-y-unit-index;
                    selected => { root.settings-changed(); }
                }
                Text { x: 16px; y: 72px; width: 34px; height: 23px; text: "to the";
                    font-size: 11px; color: #252529; vertical-alignment: center; }
                ComboBox { x: 52px; y: 72px; width: 84px; height: 23px;
                    model: ["bottom", "top"];
                    current-index <=> root.initial-window-y-anchor-index;
                    selected => { root.settings-changed(); }
                }
                Text { x: 140px; y: 72px; width: 92px; height: 23px; text: "side of screen";
                    font-size: 11px; color: #252529; vertical-alignment: center; }
            }
        }
        Rectangle { x: 20px; y: root.interface-resize-y; width: parent.width - 40px; height: 118px;
            border-width: 1px; border-color: #d6d6da; border-radius: 12px; background: #f8f8f8;
            Text { x: 36px; y: 7px; width: 150px; height: 24px; text: "Resize window to:";
                font-size: 12px; color: #222222; vertical-alignment: center; }
            ComboBox { x: 232px; y: 4px; width: parent.width - 252px; height: 24px;
                model: ["Fit Screen", "0.5x Video Size", "1x Video Size", "1.5x Video Size", "2x Video Size"];
                current-index <=> root.window-resize-option-index;
                selected => { root.settings-changed(); }
            }
            PreferenceRadioRow { x: 28px; y: 40px; width: parent.width - 48px;
                label: "Always when playing a new file"; checked: root.window-resize-timing-index == 0;
                activated => { root.window-resize-timing-index = 0; root.settings-changed(); }
            }
            PreferenceRadioRow { x: 28px; y: 64px; width: parent.width - 48px;
                label: "When media is opened manually"; checked: root.window-resize-timing-index == 1;
                activated => { root.window-resize-timing-index = 1; root.settings-changed(); }
            }
            PreferenceRadioRow { x: 28px; y: 88px; width: parent.width - 48px;
                label: "Do not resize"; checked: root.window-resize-timing-index == 2;
                activated => { root.window-resize-timing-index = 2; root.settings-changed(); }
            }
        }
        Rectangle { x: 20px; y: root.interface-physical-resolution-y; width: parent.width - 40px; height: 40px;
            border-width: 1px; border-color: #d6d6da; border-radius: 12px; background: #f8f8f8;
            PreferenceSwitch { x: 36px; y: 6px; width: parent.width - 48px; label: "Use physical resolution on Retina displays";
                checked <=> root.use-physical-resolution;
                toggled => { root.settings-changed(); }
            }
        }
        Rectangle { x: 20px; y: root.interface-float-y; width: parent.width - 40px; height: 80px;
            border-width: 1px; border-color: #d6d6da; border-radius: 12px; background: #f8f8f8;
            PreferenceSwitch { x: 36px; y: 4px; width: parent.width - 48px; label: "Always float on top";
                checked <=> root.always-float-on-top;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { x: 36px; y: 44px; width: parent.width - 48px; label: "Always show float on top status in the title bar";
                checked <=> root.always-show-on-top-icon;
                toggled => { root.settings-changed(); }
            }
        }
        Rectangle { x: 20px; y: root.interface-osc-y; width: parent.width - 40px; height: root.interface-osc-card-height;
            border-width: 1px; border-color: #d6d6da; border-radius: 12px; background: #f8f8f8;
            Text { x: 0; y: 8px; text: "On-Screen Controller:";
                font-weight: 600; font-size: 13px; color: #222222; }
            ComboBox { x: 160px; y: 4px; width: 150px; height: 24px;
                model: ["Floating", "Top", "Bottom"];
                current-index <=> root.osc-position;
                selected => { root.settings-changed(); }
            }
            CheckBox { x: 160px; y: 42px; height: 24px; text: "Dock control bar and titlebar";
                checked <=> root.docked-controls;
                enabled: !root.edge-to-edge-video;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { x: 36px; y: 82px; width: parent.width - 48px;
                label: "Show chapter position in progress bar";
                checked <=> root.show-chapter-pos;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { x: 36px; y: 116px; width: 128px;
                label: "Auto hide after:";
                checked <=> root.control-auto-hide-enabled;
                toggled => { root.settings-changed(); }
            }
            Rectangle { x: 170px; y: 118px; width: 70px; height: 24px;
                border-width: 1px; border-color: #b8b8bc; border-radius: 3px; background: #ffffff;
                TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                    text <=> root.control-auto-hide-timeout-text; enabled: root.control-auto-hide-enabled;
                    font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
            }
            Text { x: 244px; y: 118px; width: 20px; height: 24px; text: "s";
                font-size: 11px; color: root.control-auto-hide-enabled ? #55555b : #a0a0a4;
                vertical-alignment: center; }
            PreferenceSwitch { x: 36px; y: 150px; width: parent.width - 48px;
                label: "Prevent scroll wheel from changing playback position";
                checked <=> root.control-disable-play-slider-scrolling;
                toggled => { root.settings-changed(); }
            }
            PreferenceSwitch { x: 36px; y: 186px; width: parent.width - 48px;
                label: "Prevent scroll wheel from changing volume";
                checked <=> root.control-disable-volume-slider-scrolling;
                toggled => { root.settings-changed(); }
            }
            Text { x: 36px; y: 218px; text: "Toolbar buttons";
                font-size: 12px; font-weight: 600; color: #222222; }
            PreferenceActionButton { x: parent.width - 112px; y: 214px;
                label: "Restore Default";
                activated => { root.toolbar-reset(); }
            }
            for action-kind[index] in root.toolbar-order : ToolbarPreferenceRow {
                x: 36px; y: 238px + index * 28px; width: parent.width - 72px;
                label: action-kind == 0 ? "Quick Settings" :
                    action-kind == 1 ? "Playlist and chapters" :
                    action-kind == 2 ? "Picture in Picture" :
                    action-kind == 3 ? "Full Screen" :
                    action-kind == 4 ? "Music Mode" :
                    action-kind == 5 ? "Subtitle Track" :
                    action-kind == 6 ? "Screenshot" :
                    action-kind == 7 ? "Plugins" : "Live Text";
                position: index; count: root.toolbar-order.length;
                drag-index: root.toolbar-drag-index;
                drop-index: root.toolbar-drop-index;
                drag-start-y: root.toolbar-drag-start-y;
                drag-active: root.toolbar-drag-active;
                checked: action-kind == 0 ? root.toolbar-show-quick-settings :
                    action-kind == 1 ? root.toolbar-show-playlist :
                    action-kind == 2 ? root.toolbar-show-pip :
                    action-kind == 3 ? root.toolbar-show-fullscreen :
                    action-kind == 4 ? root.toolbar-show-music-mode :
                    action-kind == 5 ? root.toolbar-show-subtitle-track :
                    action-kind == 6 ? root.toolbar-show-screenshot :
                    action-kind == 7 ? root.toolbar-show-plugins : root.toolbar-show-live-text;
                toggled(value) => {
                    if action-kind == 0 { root.toolbar-show-quick-settings = value; }
                    else if action-kind == 1 { root.toolbar-show-playlist = value; }
                    else if action-kind == 2 { root.toolbar-show-pip = value; }
                    else if action-kind == 3 { root.toolbar-show-fullscreen = value; }
                    else if action-kind == 4 { root.toolbar-show-music-mode = value; }
                    else if action-kind == 5 { root.toolbar-show-subtitle-track = value; }
                    else if action-kind == 6 { root.toolbar-show-screenshot = value; }
                    else if action-kind == 7 { root.toolbar-show-plugins = value; }
                    else { root.toolbar-show-live-text = value; }
                    root.settings-changed();
                }
                move-requested(position, destination) => { root.toolbar-move(position, destination); }
                drag-started(position, start-y) => {
                    root.toolbar-drag-index = position;
                    root.toolbar-drop-index = position;
                    root.toolbar-drag-start-y = start-y;
                    root.toolbar-drag-active = false;
                }
                drag-target-changed(destination) => {
                    root.toolbar-drag-active = true;
                    root.toolbar-drop-index = destination;
                }
                drag-finished => {
                    root.toolbar-drag-finished();
                    root.toolbar-drag-index = -1;
                    root.toolbar-drop-index = -1;
                    root.toolbar-drag-active = false;
                }
            }
        }
        Rectangle { x: 20px; y: root.interface-osd-y; width: parent.width - 40px;
            height: 92px + root.osd-suppression-detail-height;
            border-width: 1px; border-color: #d6d6da; border-radius: 12px; background: #f8f8f8;
            PreferenceSwitch { x: 36px; y: 4px; width: parent.width - 48px; label: "Enable OSD";
                checked <=> root.osd-enabled;
                toggled => { root.settings-changed(); }
            }
            PreferenceDisclosure { x: 36px; y: 40px; label: "Suppress messages for:";
                expanded: root.osd-suppression-expanded;
                toggled => { root.osd-suppression-expanded = !root.osd-suppression-expanded; }
            }
            if root.osd-suppression-expanded : VerticalLayout {
                x: 52px; y: 64px; width: parent.width - 68px; height: 108px; spacing: 0px;
                PreferenceSwitch { height: 27px; label: "File start";
                    checked <=> root.disable-osd-file-start;
                    toggled => { root.settings-changed(); }
                }
                PreferenceSwitch { height: 27px; label: "Pause / Resume";
                    checked <=> root.disable-osd-pause-resume;
                    toggled => { root.settings-changed(); }
                }
                PreferenceSwitch { height: 27px; label: "Seek";
                    checked <=> root.disable-osd-seek;
                    toggled => { root.settings-changed(); }
                }
                PreferenceSwitch { height: 27px; label: "Speed";
                    checked <=> root.disable-osd-speed;
                    toggled => { root.settings-changed(); }
                }
            }
        }
        Rectangle { x: 20px; y: root.interface-osd-y + 108px + root.osd-suppression-detail-height;
            width: parent.width - 40px; height: 112px;
            border-width: 1px; border-color: #d6d6da; border-radius: 12px; background: #f8f8f8;
            Text { x: 36px; y: 4px; text: "On-Screen Display";
                font-size: 12px; color: #222222; vertical-alignment: center; }
            Text { x: 36px; y: 39px; width: 132px; height: 24px; text: "Auto hide after:";
                font-size: 12px; color: #222222; vertical-alignment: center; }
            Rectangle { x: 170px; y: 39px; width: 70px; height: 24px;
                border-width: 1px; border-color: #b8b8bc; border-radius: 3px; background: #ffffff;
                TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                    text <=> root.osd-timeout-text; font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
            }
            Text { x: 244px; y: 39px; width: 20px; height: 24px; text: "s";
                font-size: 11px; color: #55555b; vertical-alignment: center; }
            Text { x: 36px; y: 68px; width: 132px; height: 24px; text: "Text size:";
                font-size: 12px; color: #222222; vertical-alignment: center; }
            Rectangle { x: 170px; y: 68px; width: 70px; height: 24px;
                border-width: 1px; border-color: #b8b8bc; border-radius: 3px; background: #ffffff;
                TextInput { x: 5px; y: 1px; width: parent.width - 10px; height: parent.height - 2px;
                    text <=> root.osd-text-size-text; font-size: 11px; color: #222222;
                    accepted => { root.settings-changed(); }
                }
            }
            Text { x: 244px; y: 68px; width: 24px; height: 24px; text: "pt";
                font-size: 11px; color: #55555b; vertical-alignment: center; }
            PreferenceSwitch { x: 270px; y: 67px; width: parent.width - 282px;
                label: "Time and battery in full screen";
                checked <=> root.display-time-and-battery-in-fullscreen;
                toggled => { root.settings-changed(); }
            }
        }
        Text { x: 28px; y: root.interface-pip-y; text: "Picture-in-Picture";
            font-size: 13px; font-weight: 600; color: #77777d; }
        Rectangle {
            x: 20px; y: root.interface-pip-y + 28px; width: parent.width - 40px;
            height: root.interface-pip-card-height;
            border-width: 1px; border-color: #e4e4e7; border-radius: 10px; background: #f8f8f8;
            VerticalLayout { x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px; spacing: 0px;
                PreferenceChoiceRow { width: parent.width; label: "Window after entering";
                    options: ["Do nothing", "Hide", "Minimize"];
                    selected-index <=> root.pip-window-behavior-index;
                    selected => { root.settings-changed(); }
                }
                PreferenceSwitch { width: parent.width; label: "Automatically pause playback";
                    checked <=> root.pip-pause-when-entering;
                    toggled => { root.settings-changed(); }
                }
                PreferenceSwitch { width: parent.width;
                    label: "Toggle Picture-in-Picture by minimizing/un-minimizing the window";
                    checked <=> root.pip-toggle-by-minimizing;
                    toggled => { root.settings-changed(); }
                }
                PreferenceSwitch { width: parent.width; label: "Only for video files";
                    enabled: root.pip-toggle-by-minimizing;
                    checked <=> root.pip-minimize-toggle-video-only;
                    toggled => { root.settings-changed(); }
                }
            }
        }
        Rectangle {
            x: 20px; y: root.interface-thumbnail-y;
            width: parent.width - 40px; height: 220px;
            border-width: 1px; border-color: #d6d6da; border-radius: 12px; background: #f8f8f8;
            Text { x: 0; y: 8px; text: "Thumbnail Preview";
                font-weight: 600; font-size: 13px; color: #222222; }
            PreferenceSwitch { x: 16px; y: 36px; width: parent.width - 32px;
                label: "Enable thumbnail preview";
                checked <=> root.thumbnail-preview-enabled;
                toggled => { root.settings-changed(); }
            }
            Text { x: 16px; y: 76px; width: 210px; height: 24px;
                text: "Maximum cache size"; font-size: 12px; color: #252529;
                vertical-alignment: center; }
            PreferenceNumericInput { x: parent.width - 91px; y: 76px; width: 57px; height: 24px;
                text <=> root.thumbnail-cache-size-text;
                enabled: root.thumbnail-preview-enabled;
                accepted => { root.settings-changed(); }
            }
            Text { x: parent.width - 29px; y: 76px; width: 24px; height: 24px;
                text: "MB"; font-size: 11px; color: #77777d; vertical-alignment: center; }
            PreferenceSwitch { x: 16px; y: 112px; width: parent.width - 32px;
                label: "Generate previews for files on remote volumes";
                checked <=> root.thumbnail-remote-enabled;
                enabled: root.thumbnail-preview-enabled;
                toggled => { root.settings-changed(); }
            }
            Text { x: 16px; y: 150px; width: 210px; height: 24px;
                text: "Thumbnail width"; font-size: 12px; color: #252529;
                vertical-alignment: center; }
            PreferenceNumericInput { x: parent.width - 91px; y: 150px; width: 57px; height: 24px;
                text <=> root.thumbnail-width-text;
                enabled: root.thumbnail-preview-enabled;
                accepted => { root.settings-changed(); }
            }
            Text { x: parent.width - 29px; y: 150px; width: 24px; height: 24px;
                text: "pt"; font-size: 11px; color: #77777d; vertical-alignment: center; }
            Text { x: 16px; y: 182px; width: parent.width - 32px;
                text: "Width is measured in points and applies to generated previews.";
                font-size: 10px; color: #77777d; }
        }
        Rectangle {
            x: 20px; y: root.interface-accessibility-y;
            width: parent.width - 40px; height: 80px;
            border-width: 1px; border-color: #d6d6da; border-radius: 12px; background: #f8f8f8;
            Text { x: 0; y: 8px; text: "Accessibility";
                font-weight: 600; font-size: 13px; color: #222222; }
            PreferenceSwitch { x: 16px; y: 29px; width: parent.width - 32px;
                label: "Disable animations"; checked <=> root.disable-animations;
                toggled => { root.settings-changed(); }
            }
            Text { x: 16px; y: 58px; text: "Turn off interface motion.";
                font-size: 10px; color: #77777d; }
        }
        }
    }
    if root.selected-pane == 2 : ScrollView {
        x: 200px; y: 0; width: parent.width - 200px; height: parent.height;
        content-y <=> root.video-scroll-position;
        content-height: root.tone-mapping-expanded
            ? (root.live-text-available ? 930px : 820px)
            : (root.live-text-available ? 670px : 560px);
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        Rectangle {
            width: parent.width;
            height: root.tone-mapping-expanded
                ? (root.live-text-available ? 930px : 820px)
                : (root.live-text-available ? 670px : 560px);
            Text { x: 22px; y: 16px; text: "Video";
                font-size: 15px; font-weight: 600; color: #222222; }
            Text { x: 20px; y: 52px; text: "Decoding";
                font-size: 12px; font-weight: 600; color: #737379; }
            Rectangle {
                x: 20px; y: 76px; width: parent.width - 40px; height: 282px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                Text { x: 16px; y: 10px; text: "Number of threads";
                    font-size: 11px; color: #252529; }
                PreferenceNumericInput { x: parent.width - 62px; y: 7px; width: 42px; height: 24px;
                    text <=> root.video-threads-text;
                    accepted => { root.settings-changed(); }
                }
                Text { x: 16px; y: 30px; text: "Default: 0 (Auto)";
                    font-size: 9px; color: #77777d; }
                Text { x: 16px; y: 56px; text: "Hardware decoder";
                    font-size: 11px; color: #252529; }
                VideoDecoderChoice { x: 36px; y: 78px; width: parent.width - 56px;
                    title: "Disabled"; description: "Disable hardware decoding.";
                    selected: root.hardware-decoder-index == 0;
                    activated => { root.hardware-decoder-index = 0; root.settings-changed(); }
                }
                VideoDecoderChoice { x: 36px; y: 136px; width: parent.width - 56px;
                    title: "Auto";
                    description: "Enable hardware decoding. However, most of the video filters won't work properly.";
                    selected: root.hardware-decoder-index == 1;
                    activated => { root.hardware-decoder-index = 1; root.settings-changed(); }
                }
                VideoDecoderChoice { x: 36px; y: 194px; width: parent.width - 56px;
                    title: "Auto (Copy)";
                    description: "Enable hardware decoding. It will consume double the memory but work with video filters.";
                    selected: root.hardware-decoder-index == 2;
                    activated => { root.hardware-decoder-index = 2; root.settings-changed(); }
                }
            }
            if root.live-text-available : Rectangle {
                x: 20px; y: 378px; width: parent.width - 40px; height: 88px;
                Text { x: 8px; y: 0px; text: "Live Text";
                    font-size: 12px; font-weight: 600; color: #737379; }
                Rectangle { x: 0px; y: 24px; width: parent.width; height: 64px;
                    border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
                    PreferenceSwitch { x: 16px; y: 7px; width: parent.width - 32px; height: 24px;
                        label: "Live Text"; checked <=> root.live-text-enabled;
                        toggled => { root.settings-changed(); }
                    }
                    Text { x: 16px; y: 32px; width: parent.width - 32px; height: 26px;
                        text: "Show a text-selection overlay when video is paused.";
                        font-size: 9px; color: #77777d; wrap: word-wrap; }
                }
            }
            Text { x: 20px; y: root.live-text-available ? 492px : 378px; text: "Color and HDR";
                font-size: 12px; font-weight: 600; color: #737379; }
            Rectangle {
                x: 20px; y: root.live-text-available ? 516px : 402px; width: parent.width - 40px;
                height: root.tone-mapping-expanded ? 376px : 84px;
                border-width: 1px; border-color: #dedee1; border-radius: 12px; background: #f8f8f8;
