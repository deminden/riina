import { Button, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { MenuCatalogRow, SavedFilterMenuRow } from "native-video.slint";
import { AuxiliaryPalette, NativeTypography, PlayerSlider } from "shared-controls.slint";

export struct VideoFilterWindowRow {
    token: string,
    name: string,
    detail: string,
    filter: string,
}

export struct VideoFilterParameterRow {
    label: string,
    kind: int,
    value: string,
    path-input: bool,
    number-value: float,
    minimum: float,
    maximum: float,
    step: float,
    choices: [string],
    choice-index: int,
}

export component VideoFiltersWindow inherits Window {
    default-font-family: NativeTypography.system-font-family;
    title: root.window-title;
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    preferred-width: 760px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 400px;
    in-out property <bool> acrylic-backdrop-enabled: false;
    background: acrylic-backdrop-enabled
        ? transparent
        : (dark-theme ? #1e1e22 : #f5f5f7);

    in property <[VideoFilterWindowRow]> current-filters: [];
    in property <[SavedFilterMenuRow]> saved-filters: [];
    in property <[string]> presets: [];
    in property <[VideoFilterParameterRow]> preset-parameters: [];
    in property <bool> dark-theme: true;
    in property <bool> is-audio: false;
    in property <string> window-title: "Video Filters";
    in-out property <int> preset-index: 0;
    in-out property <string> filter-string: "";
    in-out property <string> filter-name: "";
    in-out property <int> editing-current-index: -1;
    in-out property <string> editing-current-filter: "";
    in-out property <int> editing-saved-index: -1;
    in-out property <string> editing-saved-name: "";
    in-out property <string> editing-saved-filter: "";
    in-out property <string> editing-saved-shortcut-key: "";
    in-out property <string> editing-saved-shortcut-label: "";
    in-out property <int> editing-saved-shortcut-modifiers: 0;
    in-out property <bool> shortcut-recording: false;
    callback add-filter(string);
    callback select-preset(int);
    callback update-preset-text(int, string);
    callback update-preset-number(int, float);
    callback update-preset-choice(int, int);
    callback browse-filter-file();
    callback raw-filter-edited();
    callback remove-current-filter(string);
    callback apply-current-filter(int, string);
    callback save-current-filter(string, string);
    callback toggle-saved-filter(string);
    callback remove-saved-filter(int);
    callback update-saved-filter(int, string, string, string, int);

    Rectangle {
        x: 0; y: 0; width: parent.width; height: 46px;
        background: root.acrylic-backdrop-enabled
            ? (root.dark-theme ? AuxiliaryPalette.dark-acrylic-fill : AuxiliaryPalette.light-acrylic-fill)
            : (root.dark-theme ? #29292e : #ececf0);
        HorizontalLayout {
            x: 14px; y: 6px; width: parent.width - 28px; height: 34px; spacing: 7px;
            ComboBox {
                width: 140px; model: root.presets; current-index: root.preset-index;
                selected => { root.select-preset(self.current-index); }
            }
            LineEdit { text <=> root.filter-string; placeholder-text: "mpv filter string"; horizontal-stretch: 1;
                edited => { root.raw-filter-edited(); } }
            Button {
                text: root.is-audio ? "Add Audio Filter" : "Add Video Filter";
                enabled: !root.filter-string.is-empty;
                clicked => { root.add-filter(root.filter-string); }
            }
        }
    }

    Rectangle {
        x: 14px; y: 52px; width: parent.width - 28px; height: 146px;
        border-radius: 6px; background: root.acrylic-backdrop-enabled
            ? (root.dark-theme ? AuxiliaryPalette.dark-acrylic-fill : AuxiliaryPalette.light-acrylic-fill)
            : (root.dark-theme ? #232328 : #ececf0);
        ScrollView {
            x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px;
            content-height: max(1px, root.preset-parameters.length * 29px);
            content-width: self.visible-width;
            for parameter[index] in root.preset-parameters : HorizontalLayout {
                x: 0; y: index * 29px; width: parent.width; height: 26px; spacing: 8px;
                Text { width: 190px; height: 26px; text: parameter.label;
                    font-size: 11px; color: root.dark-theme ? #dddddf : #414146;
                    vertical-alignment: center; overflow: elide; }
                if parameter.kind == 0 && !parameter.path-input : LineEdit {
                    horizontal-stretch: 1; height: 24px; text: parameter.value;
                    edited(text) => { root.update-preset-text(index, text); }
                }
                if parameter.kind == 0 && parameter.path-input : HorizontalLayout {
                    horizontal-stretch: 1; spacing: 6px;
                    LineEdit { horizontal-stretch: 1; height: 24px; text: parameter.value;
                        edited(text) => { root.update-preset-text(index, text); } }
                    Button { text: "Browse…"; clicked => { root.browse-filter-file(); } }
                }
                if parameter.kind == 1 || parameter.kind == 2 : PlayerSlider {
                    dark-theme: root.dark-theme; horizontal-stretch: 1; height: 20px;
                    minimum: parameter.minimum; maximum: parameter.maximum; step: parameter.step;
                    value: parameter.number-value;
                    changed(value) => { root.update-preset-number(index, value); }
                }
                if parameter.kind == 1 || parameter.kind == 2 : Text {
                    width: 54px; height: 26px; text: parameter.value; font-size: 11px;
                    color: root.dark-theme ? #dddddf : #414146; vertical-alignment: center;
                }
                if parameter.kind == 3 : ComboBox {
                    horizontal-stretch: 1; model: parameter.choices; current-index: parameter.choice-index;
                    selected => { root.update-preset-choice(index, self.current-index); }
                }
            }
            if root.preset-parameters.length == 0 : Text {
                x: 8px; y: 8px; width: parent.width - 16px; height: 26px;
                text: "Choose a preset to configure its parameters"; font-size: 11px;
                color: root.dark-theme ? #a9a9b0 : #73737a; vertical-alignment: center;
            }
        }
    }

    HorizontalLayout {
        x: 14px; y: 208px; width: parent.width - 28px; height: parent.height - 222px; spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1; spacing: 6px;
            Text { text: root.is-audio ? "Current Audio Filters" : "Current Video Filters"; font-size: 15px; font-weight: 600; color: root.dark-theme ? #eeeeF2 : #25252a; }
            Rectangle {
                height: parent.height - 145px; border-radius: 6px;
                background: root.acrylic-backdrop-enabled
                    ? (root.dark-theme ? AuxiliaryPalette.dark-acrylic-fill : AuxiliaryPalette.light-acrylic-fill)
                    : (root.dark-theme ? #25252a : white);
                ScrollView {
                    width: parent.width; height: parent.height;
                    content-height: max(1px, root.current-filters.length * 92px);
                    content-width: self.visible-width;
                    for row[index] in root.current-filters : Rectangle {
                        x: 0; y: index * 92px; width: parent.width; height: 92px;
                        background: root.acrylic-backdrop-enabled
                            ? (root.dark-theme ? AuxiliaryPalette.dark-acrylic-fill : AuxiliaryPalette.light-acrylic-fill)
                            : (Math.mod(index, 2) == 0 ? (root.dark-theme ? #25252a : white) : (root.dark-theme ? #2b2b30 : #fafafa));
                        Rectangle { x: 10px; y: parent.height - 1px; width: parent.width - 20px; height: 1px; background: root.dark-theme ? #414148 : #dedee3; }
                        Text { x: 12px; y: 7px; width: parent.width - 24px; height: 18px;
                            text: row.name; color: root.dark-theme ? #eeeeF2 : #26262b; font-size: 12px; font-weight: 600; overflow: elide; }
                        if root.editing-current-index != index : Text { x: 12px; y: 27px; width: parent.width - 24px; height: 20px;
                            text: row.detail; color: root.dark-theme ? #aaaab1 : #66666d; font-size: 10px; overflow: elide; }
                        if root.editing-current-index == index : LineEdit {
                            x: 12px; y: 27px; width: parent.width - 24px; height: 24px;
                            text <=> root.editing-current-filter; placeholder-text: "mpv filter string";
                            accepted => { root.apply-current-filter(index, self.text); }
                        }
                        HorizontalLayout { x: 10px; y: 58px; width: parent.width - 20px; height: 25px; spacing: 6px;
                            LineEdit { text <=> root.filter-name; placeholder-text: "Saved name"; horizontal-stretch: 1; }
                            Button { text: "Save"; clicked => { root.save-current-filter(row.filter, root.filter-name); } }
                            if root.editing-current-index != index : Button { text: "Edit"; clicked => {
                                root.editing-current-index = index; root.editing-current-filter = row.filter;
                            } }
                            if root.editing-current-index == index : Button { text: "Apply"; clicked => {
                                root.apply-current-filter(index, root.editing-current-filter);
                            } }
                            if root.editing-current-index == index : Button { text: "Cancel"; clicked => {
                                root.editing-current-index = -1; root.editing-current-filter = "";
                            } }
                            Button { text: "Remove"; clicked => { root.remove-current-filter(row.token); } }
                        }
                    }
                    if root.current-filters.length == 0 : Text {
                        x: 14px; y: 14px; width: parent.width - 28px; height: 36px;
                        text: root.is-audio ? "No active audio filters" : "No active video filters";
                        color: root.dark-theme ? #a9a9b0 : #77777d; font-size: 12px;
                    }
                }
            }
        }

        VerticalLayout {
            width: 250px; spacing: 6px;
            Text { text: root.is-audio ? "Saved Audio Filters" : "Saved Video Filters"; font-size: 15px; font-weight: 600; color: root.dark-theme ? #eeeeF2 : #25252a; }
            Rectangle {
                vertical-stretch: 1; border-radius: 6px;
                background: root.acrylic-backdrop-enabled
                    ? (root.dark-theme ? AuxiliaryPalette.dark-acrylic-fill : AuxiliaryPalette.light-acrylic-fill)
                    : (root.dark-theme ? #25252a : white);
                ScrollView {
                    width: parent.width; height: parent.height;
                    content-height: max(1px, root.saved-filters.length * 54px);
                    content-width: self.visible-width;
                    for row[index] in root.saved-filters : Rectangle {
                        x: 0; y: index * 54px; width: parent.width; height: 54px;
                        background: root.acrylic-backdrop-enabled
                            ? (root.dark-theme ? AuxiliaryPalette.dark-acrylic-fill : AuxiliaryPalette.light-acrylic-fill)
                            : (Math.mod(index, 2) == 0 ? (root.dark-theme ? #25252a : white) : (root.dark-theme ? #2b2b30 : #fafafa));
                        Button {
                            x: 7px; y: 7px; width: parent.width - 14px; height: 38px;
                            text: (row.selected ? "✓  " : "     ") + row.label;
                            clicked => {
                                root.editing-saved-index = index;
                                root.editing-saved-name = row.label;
                                root.editing-saved-filter = row.token;
                                root.editing-saved-shortcut-key = row.shortcut-key;
                                root.editing-saved-shortcut-label = row.shortcut-label;
                                root.editing-saved-shortcut-modifiers = row.shortcut-modifiers;
                            }
                        }
                        TouchArea {
                            x: parent.width - 34px; y: 9px; width: 26px; height: 32px;
                            mouse-cursor: pointer;
                            Text { text: "×"; color: #77777d; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                            clicked => { root.remove-saved-filter(index); }
                        }
                    }
                    if root.saved-filters.length == 0 : Text {
                        x: 12px; y: 14px; width: parent.width - 24px; height: 36px;
                        text: "Save an active filter to use it here"; color: #77777d; font-size: 12px; wrap: word-wrap;
                    }
                }
            }
            LineEdit { text <=> root.editing-saved-name; placeholder-text: "Filter name"; }
            LineEdit { text <=> root.editing-saved-filter; placeholder-text: "mpv filter string"; }
            HorizontalLayout {
                height: 30px; spacing: 6px;
                Button {
                    horizontal-stretch: 1;
                    text: root.shortcut-recording ? "Press a shortcut…" :
                        (root.editing-saved-shortcut-label.is-empty ? "No Shortcut" : root.editing-saved-shortcut-label);
                    clicked => { root.shortcut-recording = true; shortcut-focus.focus(); }
                }
                Button { text: "Clear"; enabled: !root.editing-saved-shortcut-key.is-empty;
                    clicked => {
                        root.editing-saved-shortcut-key = "";
                        root.editing-saved-shortcut-label = "";
                        root.editing-saved-shortcut-modifiers = 0;
                    }
                }
            }
            HorizontalLayout {
                height: 30px; spacing: 6px;
                Button { text: "Toggle"; enabled: root.editing-saved-index >= 0;
                    clicked => { root.toggle-saved-filter(root.editing-saved-filter); } }
                Button { text: "Save Changes"; enabled: root.editing-saved-index >= 0;
                    clicked => { root.update-saved-filter(root.editing-saved-index,
                        root.editing-saved-name, root.editing-saved-filter,
                        root.editing-saved-shortcut-key, root.editing-saved-shortcut-modifiers); } }
            }
        }
    }

    shortcut-focus := FocusScope {
        width: 0px; height: 0px;
        key-pressed(event) => {
            if !root.shortcut-recording { return reject; }
            if event.text == Key.Escape { root.shortcut-recording = false; return accept; }
            if event.text == Key.Backspace || event.text == Key.Delete {
                root.editing-saved-shortcut-key = "";
                root.editing-saved-shortcut-label = "";
                root.editing-saved-shortcut-modifiers = 0;
                root.shortcut-recording = false;
                return accept;
            }
            if event.text.is-empty { return accept; }
            root.editing-saved-shortcut-key = event.text;
            root.editing-saved-shortcut-modifiers =
                (event.modifiers.control ? 1 : 0) + (event.modifiers.alt ? 2 : 0) +
                (event.modifiers.shift ? 4 : 0) + (event.modifiers.meta ? 8 : 0);
            root.editing-saved-shortcut-label =
                (event.modifiers.control ? "Ctrl+" : "") + (event.modifiers.alt ? "Alt+" : "") +
                (event.modifiers.shift ? "Shift+" : "") + (event.modifiers.meta ? "Meta+" : "") + event.text;
            root.shortcut-recording = false;
            return accept;
        }
    }
}
