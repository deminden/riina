import { ScrollView } from "std-widgets.slint";

// Original segmented controls. Native materials and text metrics need captures;
// sidebar option order and the 24px control row follow the pinned requirements.
component VideoSegment inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback chosen();
    callback navigate(int);
    height: 24px;
    border-radius: 3px;
    background: selected ? #ffffff28 : touch.has-hover && enabled ? #ffffff14 : #ffffff08;
    accessible-role: button;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-action-default => { if enabled { chosen(); } }
    Text { text: label; font-size: 12px; color: root.enabled ? #eeeeee : #777777;
        horizontal-alignment: center; vertical-alignment: center; }
    if focus.has-focus : Rectangle { background: transparent; border-radius: 3px;
        border-width: 1px; border-color: #90b7ef; }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.chosen(); } }
    focus := FocusScope { enabled: root.enabled;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " { root.chosen(); return accept; }
            if event.text == Key.LeftArrow { root.navigate(-1); return accept; }
            if event.text == Key.RightArrow { root.navigate(1); return accept; }
            return reject;
        }
    }
}

component ScrollArrow inherits Rectangle {
    in property <bool> overflow: false;
    in property <bool> toward-end: true;
    callback clicked(bool);
    width: 8px;
    height: 24px;
    background: transparent;
    visible: root.overflow;
    accessible-role: button;
    accessible-label: root.toward-end ? "Scroll to more choices" : "Scroll to earlier choices";
    accessible-action-default => { root.clicked(root.toward-end); }
    Text { text: root.toward-end ? "›" : "‹"; font-size: 16px; font-weight: 600;
        color: touch.has-hover ? #ffffff : #cccccc;
        horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.clicked(root.toward-end); } }
}

export component VideoControls inherits Rectangle {
    in property <[string]> aspect-presets;
    in property <int> aspect-index: 0;
    in property <int> rotation-index: -1;
    in property <[string]> crop-presets;
    in property <int> crop-index: -1;
    in property <bool> crop-enabled: false;
    callback crop-changed(int);
    in property <bool> aspect-enabled: false;
    in property <bool> rotation-enabled: false;
    callback aspect-changed(string);
    callback rotation-changed(int);
    height: 160px;
    background: transparent;
    VerticalLayout { spacing: 8px;
        HorizontalLayout { height: 16px; spacing: 8px;
            Image { source: @image-url("../../../assets/icons/video-aspect-ratio.svg"); width: 16px; height: 16px; }
            Text { text: "Aspect Ratio"; font-size: 12px; font-weight: 700; color: #dddddd; vertical-alignment: center; }
        }
        Rectangle { height: 24px;
            HorizontalLayout { spacing: 4px;
                aspect-scroll := ScrollView { horizontal-stretch: 1; min-width: 0px; height: 24px;
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: always-off;
                    content-height: self.visible-height;
                    HorizontalLayout { spacing: 8px;
                        HorizontalLayout { spacing: 1px;
                            for label[index] in root.aspect-presets : VideoSegment {
                                width: index == 0 ? 54px : 43px;
                                label: label; hint: "Aspect ratio " + label;
                                enabled: root.aspect-enabled;
                                selected: root.aspect-index == index;
                                chosen => { root.aspect-changed(label); }
                                navigate(direction) => {
                                    root.aspect-changed(root.aspect-presets[clamp(
                                        (root.aspect-index >= 0 ? root.aspect-index : index) + direction,
                                        0, root.aspect-presets.length - 1)]);
                                }
                            }
                        }
                        Rectangle { width: 40px; height: 24px; background: #ffffff10;
                            border-radius: 4px; border-width: 1px;
                            border-color: custom.has-focus ? #90b7ef : #ffffff20;
                            forward-focus: custom;
                            FocusScope {
                                width: parent.width; height: parent.height;
                                forward-focus: custom;
                                // Unmodified editing keys must not seek, pause or
                                // change volume when the text editor rejects them.
                                key-pressed(event) => {
                                    if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
                                    if event.text == Key.Escape { return reject; }
                                    if event.text == Key.Tab { return reject; }
                                    return accept;
                                }
                                custom := TextInput { x: 3px; width: parent.width - 6px; height: parent.height;
                                    single-line: true; enabled: root.aspect-enabled;
                                    color: root.aspect-enabled ? #eeeeee : #777777; font-size: 12px;
                                    vertical-alignment: center; accessible-label: "Custom aspect ratio";
                                    accessible-action-set-value(value) => { self.text = value; }
                                    accepted => { if self.text != "" { root.aspect-changed(self.text); } }
                                }
                            }
                        }
                    }
                }
                ScrollArrow {
                    toward-end: aspect-scroll.content-x >= -1px;
                    overflow: aspect-scroll.content-width > aspect-scroll.visible-width + 1px;
                    clicked(toward_end) => {
                        aspect-scroll.content-x = toward_end ?
                            min(0px, aspect-scroll.visible-width - aspect-scroll.content-width) : 0px;
                    }
                }
            }
        }
        HorizontalLayout { height: 16px; spacing: 8px;
            Image { source: @image-url("../../../assets/icons/video-crop.svg"); width: 16px; height: 16px; }
            Text { text: "Crop"; font-size: 12px; font-weight: 700; color: #dddddd; vertical-alignment: center; }
        }
        Rectangle { height: 24px;
            HorizontalLayout { spacing: 4px;
                crop-scroll := ScrollView { horizontal-stretch: 1; min-width: 0px; height: 24px;
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: always-off;
                    content-height: self.visible-height;
                    HorizontalLayout { spacing: 1px;
                        for label[index] in root.crop-presets : VideoSegment {
                            width: index == 6 ? 76px : 43px;
                            label: label; hint: "Crop " + label;
                            enabled: root.crop-enabled;
                            selected: root.crop-index == index;
                            chosen => { root.crop-changed(index); }
                            navigate(direction) => { root.crop-changed(clamp(
                                (root.crop-index >= 0 ? root.crop-index : index) + direction, 0, 6)); }
                        }
                    }
                }
                ScrollArrow {
                    toward-end: crop-scroll.content-x >= -1px;
                    overflow: crop-scroll.content-width > crop-scroll.visible-width + 1px;
                    clicked(toward_end) => {
                        crop-scroll.content-x = toward_end ?
                            min(0px, crop-scroll.visible-width - crop-scroll.content-width) : 0px;
                    }
                }
            }
        }
        HorizontalLayout { height: 16px; spacing: 8px;
            Image { source: @image-url("../../../assets/icons/video-rotate.svg"); width: 16px; height: 16px; }
            Text { text: "Rotation"; font-size: 12px; font-weight: 700; color: #dddddd; vertical-alignment: center; }
        }
        HorizontalLayout { height: 24px; spacing: 1px;
            for label[index] in ["0°", "90°", "180°", "270°"] : VideoSegment {
                label: label; hint: "Video rotation " + label;
                enabled: root.rotation-enabled;
                selected: root.rotation-index == index;
                chosen => { root.rotation-changed(index * 90); }
                navigate(direction) => { root.rotation-changed(clamp(
                    (root.rotation-index >= 0 ? root.rotation-index : index) + direction, 0, 3) * 90); }
            }
        }
    }
}

export component HardwareDecodingControls inherits Rectangle {
    in property <bool> hardware-enabled: false;
    in property <bool> hardware-known: false;
    callback hardware-changed(bool);
    height: 24px;
    background: transparent;
        HorizontalLayout { height: 24px; spacing: 8px;
            Text { text: "Hardware Decoding"; font-size: 12px; color: #dddddd;
                vertical-alignment: center; horizontal-stretch: 1; }
            hardware := Rectangle { width: 30px; height: 18px; border-radius: 9px;
                background: root.hardware-enabled ? #478adc : #ffffff28;
                accessible-role: switch; accessible-label: "Hardware Decoding";
                accessible-enabled: root.hardware-known;
                accessible-checkable: true; accessible-checked: root.hardware-enabled;
                accessible-action-default => { if root.hardware-known { root.hardware-changed(!root.hardware-enabled); } }
                Rectangle { x: root.hardware-enabled ? 14px : 2px; y: 2px;
                    width: 14px; height: 14px; border-radius: 7px;
                    background: root.hardware-known ? #eeeeee : #777777; }
                if hardware-focus.has-focus : Rectangle { background: transparent;
                    border-radius: 9px; border-width: 1px; border-color: #90b7ef; }
                TouchArea { enabled: root.hardware-known;
                    clicked => { hardware-focus.focus(); root.hardware-changed(!root.hardware-enabled); } }
                hardware-focus := FocusScope { enabled: root.hardware-known;
                    key-pressed(event) => {
                        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                        if event.text == " " || event.text == Key.Return {
                            root.hardware-changed(!root.hardware-enabled); return accept;
                        }
                        return reject;
                    }
                }
            }
        }
}

export component HdrControls inherits Rectangle {
    in property <bool> hdr-enabled: true;
    in property <bool> hdr-available: false;
    callback hdr-changed(bool);
    height: 24px;
    background: transparent;
    HorizontalLayout { height: 24px; spacing: 8px;
        Text { text: "HDR"; font-size: 12px; color: #dddddd;
            vertical-alignment: center; horizontal-stretch: 1; }
        toggle := Rectangle { width: 30px; height: 18px; border-radius: 9px;
            background: root.hdr-enabled ? #478adc : #ffffff28;
            accessible-role: switch; accessible-label: "HDR";
            accessible-enabled: root.hdr-available;
            accessible-checkable: true; accessible-checked: root.hdr-enabled;
            accessible-action-default => {
                if root.hdr-available { root.hdr-changed(!root.hdr-enabled); }
            }
            Rectangle { x: root.hdr-enabled ? 14px : 2px; y: 2px;
                width: 14px; height: 14px; border-radius: 7px;
                background: root.hdr-available ? #eeeeee : #777777; }
            if toggle-focus.has-focus : Rectangle { background: transparent;
                border-radius: 9px; border-width: 1px; border-color: #90b7ef; }
            toggle-focus := FocusScope { enabled: root.hdr-available;
                key-pressed(event) => {
                    if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                    if event.text == " " || event.text == Key.Return {
                        root.hdr-changed(!root.hdr-enabled); return accept;
                    }
                    return reject;
                }
            }
            // Keep the pointer hit target last in stacking order so the focus
            // helper cannot take the click without toggling HDR.
            TouchArea { enabled: root.hdr-available;
                clicked => { toggle-focus.focus(); root.hdr-changed(!root.hdr-enabled); } }
        }
    }
}
