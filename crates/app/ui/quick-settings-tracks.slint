import { ScrollView } from "std-widgets.slint";
import { CatalogRow } from "catalog-row.slint";

// One keyboard owner survives asynchronous track observations. Selection remains
// engine-owned; moving focus never paints an unconfirmed track as active.
export component QuickSettingsTrackList inherits Rectangle {
    in property <[CatalogRow]> tracks;
    in property <int> observed-index: 0;
    in property <int> track-kind;
    in property <string> hint;
    in property <string> label-prefix;
    in property <bool> dark-theme: true;
    in property <bool> enabled: true;
    in property <color> accent-color: #0a84ff;
    in property <color> focus-accent-color: #90b7ef;
    in property <color> card-fill: #ffffff08;
    in property <color> card-edge: #ffffff18;
    callback selected(int, string);
    private property <int> cursor: 0;
    private property <int> accessible-cursor: -1;
    private property <bool> focus-pending: false;
    private property <bool> available: root.enabled && root.tracks.length > 0;
    height: 98px;
    border-radius: 8px; border-width: 1px; border-color: card-edge;
    background: card-fill; clip: true;
    forward-focus: keys;
    accessible-role: list;
    accessible-label: hint;
    accessible-enabled: available;
    accessible-item-count: tracks.length;
    accessible-delegate-focus: accessible-cursor;

    function reveal() {
        let top = root.cursor * 27px;
        if top + rows.content-y < 0px { rows.content-y = -top; }
        else if top + 26px + rows.content-y > rows.visible-height {
            rows.content-y = rows.visible-height - top - 26px;
        }
        rows.content-y = clamp(rows.content-y, min(0px, rows.visible-height - rows.content-height), 0px);
    }
    function move(index: int, select: bool) {
        if !root.available { return; }
        root.accessible-cursor = -1;
        root.cursor = clamp(index, 0, root.tracks.length - 1);
        root.reveal();
        if select { root.selected(root.track-kind, root.tracks[root.cursor].token); }
        root.focus-pending = keys.has-focus;
    }
    changed observed-index => {
        if !keys.has-focus { root.cursor = root.observed-index; }
    }
    changed tracks => {
        root.accessible-cursor = -1;
        root.cursor = clamp(keys.has-focus ? root.cursor : root.observed-index, 0, max(0, root.tracks.length - 1));
        if keys.has-focus { root.reveal(); }
        root.focus-pending = keys.has-focus && root.available;
    }
    changed available => {
        if !root.available { root.accessible-cursor = -1; root.focus-pending = false; }
    }
    // AccessKit row IDs are installed after a model replacement. Delegate only
    // after that rebuild, as in the shared font list, to avoid a stale focus ID.
    Timer { interval: 32ms; running: root.focus-pending && keys.has-focus;
        triggered => {
            root.accessible-cursor = root.available ? root.cursor : -1;
            root.focus-pending = false;
        }
    }
    rows := ScrollView {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        accessible-role: none;
        content-height: root.tracks.length * 27px;
        content-width: self.visible-width;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout { width: parent.width; spacing: 1px;
            for row[index] in root.tracks : Rectangle {
                height: 26px; background: transparent;
                accessible-role: list-item;
                accessible-label: root.label-prefix + row.label;
                accessible-enabled: root.available;
                accessible-item-index: index;
                accessible-item-selectable: true;
                accessible-item-selected: row.selected;
                accessible-action-default => {
                    if root.available { keys.focus(); root.move(index, true); }
                }
                Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px;
                    background: root.dark-theme ? #ffffff20 : #00000020; }
                if row.selected : Rectangle { x: 0; width: 4px; y: 5px;
                    height: parent.height - 10px; background: root.accent-color; border-radius: 2px; }
                name-caption := Text { x: 12px;
                    accessible-role: none;
                    width: max(0px, parent.width - 18px - (row.language != "" ? language-tag.width + 4px : 0px));
                    text: row.label;
                    color: !root.enabled ? (root.dark-theme ? #777777 : #8a8a90)
                        : row.token == "no" ? (root.dark-theme ? #a7a7ad : #6b6b70)
                        : (root.dark-theme ? #dddddd : #29292d);
                    font-size: 12px; vertical-alignment: center; overflow: elide; }
                language-tag := Rectangle {
                    visible: row.language != "";
                    width: min(language-caption.preferred-width + 4px, parent.width * 0.45);
                    height: 16px; x: parent.width - self.width - 3px;
                    y: (parent.height - self.height) / 2; border-radius: 3px;
                    background: root.dark-theme ? #ffffff20 : #00000010;
                    language-caption := Text { x: 2px; width: parent.width - 4px;
                        accessible-role: none;
                        text: row.language; color: root.dark-theme ? #dddddd : #29292d;
                        font-size: 11px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                }
                if keys.has-focus && root.cursor == index : Rectangle {
                    border-width: 1px; border-color: root.focus-accent-color;
                    border-radius: 3px; background: transparent;
                }
                TouchArea { enabled: root.available;
                    clicked => { keys.focus(); root.move(index, true); }
                }
            }
        }
    }
    keys := FocusScope {
        width: 0px; enabled: root.available;
        focus-on-tab-navigation: root.available;
        focus-changed-event => {
            root.accessible-cursor = -1;
            root.focus-pending = false;
            rows.has-focus = self.has-focus;
            if self.has-focus { root.move(root.observed-index, false); }
        }
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " { root.move(root.cursor, true); return accept; }
            let page = max(1, floor(rows.visible-height / 27px));
            if event.text == Key.UpArrow { root.move(root.cursor - 1, true); return accept; }
            if event.text == Key.DownArrow { root.move(root.cursor + 1, true); return accept; }
            if event.text == Key.Home { root.move(0, true); return accept; }
            if event.text == Key.End { root.move(root.tracks.length - 1, true); return accept; }
            if event.text == Key.PageUp { root.move(root.cursor - page, true); return accept; }
            if event.text == Key.PageDown { root.move(root.cursor + page, true); return accept; }
            return reject;
        }
    }
}
