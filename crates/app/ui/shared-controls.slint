// Shared Slint controls keep playback and Preferences behavior aligned across
// the platform backends without tying widgets to a native window API.
export global NativeTypography {
    in-out property <string> system-font-family: "";
}

export component PlayerSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 0;
    in property <float> step: 1;
    in property <bool> enabled: true;
    in property <string> hint;
    in property <bool> neutral-mark: false;
    in property <int> tick-count: 0;
    in property <bool> show-value-label: false;
    in property <bool> value-label-above-control: false;
    in property <string> value-label: "";
    in property <bool> dark-theme: true;
    in property <length> knob-width: 6px;
    in property <length> knob-height: 8px;
    in property <length> knob-radius: 2px;
    in property <bool> loop-a-visible: false;
    in property <float> loop-a-value: 0;
    in property <bool> loop-b-visible: false;
    in property <float> loop-b-value: 0;
    in property <bool> show-chapter-positions: false;
    in property <[float]> chapter-times: [];
    in property <bool> preview-enabled: false;
    in property <image> preview-image;
    in property <string> preview-label;
    in property <float> preview-width: 120;
    in property <float> preview-aspect-ratio: 16 / 9;
    in property <bool> preview-above: true;
    in property <bool> scroll-override-enabled: false;
    in property <bool> scroll-disabled: false;
    in property <bool> commit-on-release: false;
    out property <bool> is-dragging: false;
    out property <bool> previewing: drag-value-active;
    callback changed(float);
    callback draft-changed(float);
    callback committed(float);
    callback loop-a-moved(float);
    callback loop-b-moved(float);
    callback preview-requested(float);
    callback preview-dismissed();
    callback scroll-request(float, float) -> bool;
    height: 20px;
    horizontal-stretch: 1;
    background: transparent;
    accessible-role: slider;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-value: display-value;
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    accessible-value-step: step;
    accessible-action-set-value(text) => {
        if enabled && text.is-float() { changed(clamp(text.to-float(), minimum, maximum)); }
    }
    accessible-action-increment => { if enabled { changed(min(maximum, value + step)); } }
    accessible-action-decrement => { if enabled { changed(max(minimum, value - step)); } }
    private property <float> drag-value: 0;
    private property <bool> drag-value-active: false;
    private property <bool> awaiting-native-commit: false;
    private property <float> display-value: drag-value-active ? drag-value : value;
    changed value => {
        if awaiting-native-commit {
            awaiting-native-commit = false;
            drag-value-active = false;
        }
    }
    Timer {
        interval: 750ms;
        running: root.awaiting-native-commit;
        triggered => {
            root.awaiting-native-commit = false;
            root.drag-value-active = false;
        }
    }
    private property <float> fraction: clamp((display-value - minimum) / max(0.001, maximum - minimum), 0, 1);
    private property <float> loop-a-fraction: clamp((loop-a-value - minimum) / max(0.001, maximum - minimum), 0, 1);
    private property <float> loop-b-fraction: clamp((loop-b-value - minimum) / max(0.001, maximum - minimum), 0, 1);
    private property <length> track-inset: root.knob-width / 2;
    private property <length> track-width: max(1px, root.width - root.knob-width);
    private property <length> track-center-y: show-value-label && value-label-above-control
        ? root.height / 2 - 1px
        : show-value-label ? root.height - 6px : root.height / 2;
    private property <color> loop-knob-color: root.dark-theme ? #a6a6a6 : #696969;
    private property <float> pointer-value: root.minimum + clamp((touch.mouse-x - track-inset) / track-width, 0, 1) * (root.maximum - root.minimum);
    private property <length> preview-height: root.preview-width * 1px / max(0.001, root.preview-aspect-ratio);
    private property <length> play-knob-x: clamp(track-inset + track-width * fraction - knob-width / 2,
        0px, root.width - knob-width);
    private property <length> loop-a-x: clamp(track-inset + track-width * loop-a-fraction - knob-width / 2,
        0px, root.width - knob-width);
    private property <length> loop-b-x: clamp(track-inset + track-width * loop-b-fraction - knob-width / 2,
        0px, root.width - knob-width);
    private property <length> loop-a-grab-offset: 0px;
    private property <length> loop-b-grab-offset: 0px;
    private property <length> loop-hit-width: max(8px, knob-width);
    Rectangle { x: track-inset; y: track-center-y - 1px; width: track-width; height: 2px;
        background: root.dark-theme ? #ffffff40 : #00000030; border-radius: 1px; }
    if neutral-mark : Rectangle { x: parent.width / 2 - 0.5px; y: track-center-y - 4px;
        width: 1px; height: 8px; background: root.dark-theme ? #ffffff60 : #00000060; }
    Rectangle { x: track-inset; y: track-center-y - 1px; width: track-width * fraction; height: 2px;
        background: enabled ? #dddde5 : #666666; border-radius: 1px; }
    for tick-index in root.tick-count : Rectangle {
        visible: root.tick-count > 1;
        x: track-inset - 1px + track-width * ((tick-index * 1.0) / (root.tick-count - 1));
        y: track-center-y + 2px; width: 2px; height: 2px; border-radius: 1px;
        background: root.dark-theme ? #ffffff30 : #00000035;
    }
    // Chapter ticks reveal the underlying track through both progress fills,
    // matching the reference's one-pixel cutouts without changing seek math.
    for chapter-time in root.chapter-times : Rectangle {
        visible: root.show-chapter-positions && chapter-time > root.minimum && chapter-time < root.maximum;
        x: clamp(track-inset + track-width *
            (chapter-time - root.minimum) / max(0.001, root.maximum - root.minimum) - 0.5px,
            track-inset, root.width - track-inset - 1px);
        y: track-center-y - 1px; width: 1px; height: 2px;
        background: root.dark-theme ? #202025 : #f2f2f2;
    }
    if loop-a-visible : Rectangle {
        x: loop-a-x; y: track-center-y - round(knob-height / 1px * 0.75) * 1px / 2;
        width: knob-width; height: round(knob-height / 1px * 0.75) * 1px;
        border-radius: knob-radius; background: root.loop-knob-color;
    }
    if loop-b-visible : Rectangle {
        x: loop-b-x; y: track-center-y - round(knob-height / 1px * 0.75) * 1px / 2;
        width: knob-width; height: round(knob-height / 1px * 0.75) * 1px;
        border-radius: knob-radius; background: root.loop-knob-color;
    }
    Rectangle {
        x: play-knob-x;
        y: track-center-y - root.knob-height / 2;
        width: root.knob-width; height: root.knob-height;
        border-radius: root.knob-radius;
        background: enabled ? (root.dark-theme ? #f4f4f7 : #3b3b40) : #777777;
    }
    if show-value-label : Text {
        x: clamp(track-inset + track-width * fraction - 18px, 0px, parent.width - 36px);
        y: value-label-above-control ? -12px : 0px;
        width: 36px; height: value-label-above-control ? 10px : 12px;
        text: root.value-label;
        color: root.dark-theme ? #aaaaaa : #66666b; font-size: 10px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 3px; background: transparent; }
    touch := TouchArea {
        enabled: root.enabled;
        changed has-hover => {
            if self.has-hover { root.preview-requested(pointer-value); }
            else { root.preview-dismissed(); }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.is-dragging = true;
                focus.focus();
                let pointer-value = root.minimum + clamp((self.mouse-x - root.track-inset) / root.track-width, 0, 1) * (root.maximum - root.minimum);
                if root.commit-on-release {
                    root.drag-value = clamp(round(pointer-value / max(0.0001, root.step)) * root.step,
                        root.minimum, root.maximum);
                    root.drag-value-active = true;
                    root.draft-changed(root.drag-value);
                } else {
                    root.changed(pointer-value);
                }
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.is-dragging = false;
                if root.commit-on-release && root.drag-value-active {
                    root.awaiting-native-commit = true;
                    root.committed(root.drag-value);
                }
            }
        }
        scroll-event(event) => {
            if root.enabled && root.scroll-disabled { return accept; }
            if root.enabled && root.scroll-override-enabled
                && root.scroll-request(event.delta-x / 1px, event.delta-y / 1px) {
                return accept;
            }
            return reject;
        }
        moved => {
            if self.pressed {
                let pointer-value = root.minimum + clamp((self.mouse-x - root.track-inset) / root.track-width, 0, 1) * (root.maximum - root.minimum);
                if root.commit-on-release {
                    root.drag-value = clamp(round(pointer-value / max(0.0001, root.step)) * root.step,
                        root.minimum, root.maximum);
                    root.drag-value-active = true;
                    root.draft-changed(root.drag-value);
                } else {
                    root.changed(pointer-value);
                }
            }
            if root.preview-enabled { root.preview-requested(pointer-value); }
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.RightArrow { root.changed(min(root.maximum, root.value + root.step)); return accept; }
            if event.text == Key.LeftArrow { root.changed(max(root.minimum, root.value - root.step)); return accept; }
            return reject;
        }
    }
    if root.preview-enabled && touch.has-hover : Rectangle {
        x: clamp(touch.mouse-x - root.preview-width * 1px / 2, 0px, max(0px, root.width - root.preview-width * 1px));
        y: root.preview-above ? 0px - preview-height - 8px : 24px;
        width: min(root.preview-width * 1px, root.width);
        height: preview-height + 20px;
        border-radius: 5px;
        border-width: 1px;
        border-color: root.dark-theme ? #ffffff4a : #00000038;
        background: root.dark-theme ? #17171bf2 : #f7f7f9f5;
        Image { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 21px;
            source: root.preview-image; image-fit: contain; }
        Text { x: 5px; y: parent.height - 19px; width: parent.width - 10px; height: 15px;
            text: root.preview-label; color: root.dark-theme ? #eeeeee : #29292d;
            font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
    }
    loop-a-touch := TouchArea {
        enabled: root.enabled && root.loop-a-visible
            && (root.loop-a-x + root.knob-width < root.play-knob-x
                || root.loop-a-x > root.play-knob-x + root.knob-width)
            && (!root.loop-b-visible
                || root.loop-a-x + root.knob-width < root.loop-b-x
                || root.loop-a-x > root.loop-b-x + root.knob-width);
        x: root.loop-a-x - (root.loop-hit-width - root.knob-width) / 2;
        width: root.loop-hit-width; height: parent.height;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                // Preserve the grabbed marker's offset so pressing its edge
                // starts a drag without moving the A point on mouse-down.
                loop-a-grab-offset =
                    self.x + self.mouse-x - root.loop-a-x - root.knob-width / 2;
            }
        }
        moved => { if self.pressed {
            root.loop-a-moved(root.minimum + clamp((self.x + self.mouse-x - loop-a-grab-offset - root.track-inset)
                / root.track-width, 0, 1) * (root.maximum - root.minimum));
        } }
    }
    loop-b-touch := TouchArea {
        enabled: root.enabled && root.loop-b-visible
            && (root.loop-b-x + root.knob-width < root.play-knob-x
                || root.loop-b-x > root.play-knob-x + root.knob-width);
        x: root.loop-b-x - (root.loop-hit-width - root.knob-width) / 2;
        width: root.loop-hit-width; height: parent.height;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                // B receives a click when the A and B markers overlap, matching
                // the reference's marker priority; keep its initial value stable.
                loop-b-grab-offset =
                    self.x + self.mouse-x - root.loop-b-x - root.knob-width / 2;
            }
        }
        moved => { if self.pressed {
            root.loop-b-moved(root.minimum + clamp((self.x + self.mouse-x - loop-b-grab-offset - root.track-inset)
                / root.track-width, 0, 1) * (root.maximum - root.minimum));
        } }
    }
}

export component VerticalEqualizerSlider inherits Rectangle {
    in property <float> minimum: -12;
    in property <float> maximum: 12;
    in property <float> value: 0;
    in property <float> step: 0.1;
    in property <bool> enabled: true;
    in property <bool> dark-theme: true;
    in property <string> hint;
    callback changed(float);
    width: 22px;
    height: 104px;
    accessible-role: slider;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-value: value;
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    accessible-value-step: step;
    accessible-action-set-value(text) => {
        if enabled && text.is-float() { changed(clamp(text.to-float(), minimum, maximum)); }
    }
    accessible-action-increment => { if enabled { changed(min(maximum, value + step)); } }
    accessible-action-decrement => { if enabled { changed(max(minimum, value - step)); } }
    property <length> center-y: root.height / 2;
    property <length> knob-y: 4px + (root.height - 8px) * (maximum - value) / max(0.001, maximum - minimum);
    Rectangle { x: root.width / 2 - 1px; y: 4px; width: 2px; height: root.height - 8px;
        border-radius: 1px; background: root.dark-theme ? #ffffff45 : #00000035; }
    for tick in [0, 1, 2, 3, 4] : Rectangle {
        x: root.width / 2 + 2px; y: 4px + (root.height - 8px) * (tick / 4.0);
        width: 3px; height: 1px;
        background: root.dark-theme ? #ffffff55 : #00000045;
    }
    Rectangle { x: root.width / 2 - 1px;
        y: min(root.center-y, root.knob-y); width: 2px;
        height: max(1px, abs(root.center-y - root.knob-y));
        background: root.enabled ? #90b7ef : #777777; }
    Rectangle { x: 2px; y: root.knob-y - 2px; width: root.width - 4px; height: 4px;
        border-radius: 2px; background: root.enabled ? #f4f4f7 : #777777; }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef;
        border-radius: 3px; background: transparent; }
    TouchArea {
        x: 0; y: 0; width: root.width; height: root.height;
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left
                && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.up) {
                if event.kind == PointerEventKind.down { focus.focus(); }
                let fraction = clamp((root.height - self.mouse-y - 4px) / max(1px, root.height - 8px), 0, 1);
                root.changed(root.minimum + fraction * (root.maximum - root.minimum));
            }
        }
        moved => {
            if self.pressed {
                let fraction = clamp((root.height - self.mouse-y - 4px) / max(1px, root.height - 8px), 0, 1);
                root.changed(root.minimum + fraction * (root.maximum - root.minimum));
            }
        }
    }
    focus := FocusScope {
        x: 0; y: 0; width: root.width; height: root.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.RightArrow {
                root.changed(min(root.maximum, root.value + root.step)); return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.LeftArrow {
                root.changed(max(root.minimum, root.value - root.step)); return accept;
            }
            return reject;
        }
    }
}

export component SubtitleColorWell inherits Rectangle {
    in property <color> observed-color;
    in property <bool> enabled: true;
    in property <string> hint;
    in property <bool> native-color-panel: false;
    in property <int> color-target: 0;
    property <float> red-channel;
    property <float> green-channel;
    property <float> blue-channel;
    property <float> alpha-channel;
    callback edited(color);
    callback native-color-requested(int, color);
    function open-editor() {
        if self.native-color-panel {
            self.native-color-requested(self.color-target, self.observed-color);
        } else {
            self.red-channel = self.observed-color.red;
            self.green-channel = self.observed-color.green;
            self.blue-channel = self.observed-color.blue;
            self.alpha-channel = self.observed-color.alpha;
            editor.show();
        }
    }
    function submit() {
        self.edited(rgba(round(self.red-channel), round(self.green-channel),
            round(self.blue-channel), self.alpha-channel / 255));
    }
    width: 32px; height: 24px;
    border-radius: 4px; border-width: 1px;
    border-color: focus.has-focus ? #90b7ef : #888892;
    background: #dddddd;
    accessible-role: button; accessible-label: hint; accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.open-editor(); } }
    // Checkerboard distinguishes transparent black from opaque black.
    Rectangle { x: 4px; y: 4px; width: 12px; height: 8px; background: #777777; }
    Rectangle { x: 16px; y: 12px; width: 12px; height: 8px; background: #777777; }
    Rectangle { x: 4px; y: 4px; width: 24px; height: 16px;
        background: root.observed-color; opacity: root.enabled ? 1 : 0.4; }
    TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.open-editor(); } }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " { root.open-editor(); return accept; }
            return reject;
        }
    }
    editor := PopupWindow {
        x: root.width - self.width; y: root.height;
        width: 240px; height: 176px;
        close-policy: close-on-click-outside;
        Rectangle { background: #29292e; border-width: 1px; border-color: #ffffff30; border-radius: 6px; }
        FocusScope {
            width: 100%; height: 100%;
            key-pressed(event) => {
                if event.text == Key.Tab { return reject; }
                if event.text == Key.Escape { editor.close(); return accept; }
                return accept;
            }
            VerticalLayout { padding: 12px; spacing: 8px;
                Text { text: root.hint; color: #eeeeee; font-size: 12px; }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Red"; width: 48px; color: #dddddd; font-size: 11px; vertical-alignment: center; }
                    PlayerSlider { minimum: 0; maximum: 255; step: 1; value: root.red-channel; hint: root.hint + " red";
                        changed(value) => { root.red-channel = round(value); root.submit(); } }
                }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Green"; width: 48px; color: #dddddd; font-size: 11px; vertical-alignment: center; }
                    PlayerSlider { minimum: 0; maximum: 255; step: 1; value: root.green-channel; hint: root.hint + " green";
                        changed(value) => { root.green-channel = round(value); root.submit(); } }
                }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Blue"; width: 48px; color: #dddddd; font-size: 11px; vertical-alignment: center; }
                    PlayerSlider { minimum: 0; maximum: 255; step: 1; value: root.blue-channel; hint: root.hint + " blue";
                        changed(value) => { root.blue-channel = round(value); root.submit(); } }
                }
                HorizontalLayout { spacing: 8px;
                    Text { text: "Opacity"; width: 48px; color: #dddddd; font-size: 11px; vertical-alignment: center; }
                    PlayerSlider { minimum: 0; maximum: 255; step: 1; value: root.alpha-channel; hint: root.hint + " opacity";
                        changed(value) => { root.alpha-channel = round(value); root.submit(); } }
                }
            }
        }
    }
}
