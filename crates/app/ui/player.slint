                        accessible-checked: root.compact-ui;
                        accessible-action-default => { root.compact-ui = !root.compact-ui; root.layout-settings-changed(); }
                        Text { x: 26px; text: "Compact interface"; color: #dddddd;
                            font-size: 12px; vertical-alignment: center; }
                        Rectangle { x: 2px; y: 7px; width: 16px; height: 16px; border-radius: 3px;
                            border-width: 1px; border-color: #888892;
                            background: root.compact-ui ? #90b7ef : #ffffff10;
                            if root.compact-ui : Text { text: "✓"; color: #17202e;
                                horizontal-alignment: center; vertical-alignment: center; font-size: 12px; } }
                        TouchArea { clicked => { root.compact-ui = !root.compact-ui; root.layout-settings-changed(); } }
                    }
                    Text { text: "Video"; color: #bdbdc5; font-size: 11px; font-weight: 700; }
