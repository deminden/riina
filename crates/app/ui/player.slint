import { PlayerSlider, VerticalEqualizerSlider, SubtitleColorWell } from "shared-controls.slint";
import { VideoControls, HardwareDecodingControls, HdrControls } from "video-controls.slint";
import { CropEditor } from "crop-editor.slint";
import { ScreenshotPreview } from "screenshot-preview.slint";
import { MenuCatalogRow, PluginMenuRow, SavedFilterMenuRow, MenuShortcutRow } from "native-probe.slint";
export { NativeVideoHost, NativeProbeOverlay, MenuCatalogRow, PluginMenuRow, SavedFilterMenuRow, MenuShortcutRow } from "native-probe.slint";
export { PictureInPictureWindow } from "pip-window.slint";
export { FontPicker } from "font-picker.slint";
export { PreferencesWindow } from "preferences.slint";
export { OnlineSubtitlesWindow } from "online-subtitles.slint";
