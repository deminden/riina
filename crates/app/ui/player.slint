                        hint: "Mute"; activated => { root.toggle-mute(); } }
                    PlayerSlider { dark-theme: root.dark-theme; horizontal-stretch: 1; height: 17px;
                        minimum: 0; maximum: root.volume-limit; value: root.volume; hint: "Volume";
                        scroll-override-enabled: !root.control-disable-volume-slider-scrolling;
                        scroll-disabled: root.control-disable-volume-slider-scrolling;
                        scroll-request(delta-x, delta-y) => { root.volume-scroll-action-request(delta-x, delta-y); }
                        changed is-dragging => { root.control-bar-dragging = self.is-dragging; }
                        changed(value) => { root.set-volume(value); } }
                }
            }
            if root.music-mode && loaded : Rectangle {
                x: 8px; y: 6px; width: 28px; height: 54px;
                border-radius: 10px;
                background: root.liquid-glass-osc
                    ? (root.dark-theme ? #25252beF : #f5f5f7f0)
                    : (root.dark-theme ? #303036 : #eeeeF2);
                border-width: 1px; border-color: #ffffff30;
                opacity: root.controls-visible ? 1 : 0;
                animate opacity { duration: root.animations-disabled ? 0ms : 200ms; }
                VerticalLayout {
                    x: 3px; y: 3px; width: 22px; height: 48px; spacing: 4px;
                    Tool { dark-theme: root.dark-theme; width: 22px; height: 22px;
                        icon: @image-url("../../../assets/icons/music-mode-close.svg");
                        hint: "Close player"; activated => { root.close-player(); } }
                    Tool { dark-theme: root.dark-theme; width: 22px; height: 22px;
                        icon: @image-url("../../../assets/icons/music-mode-back.svg");
                        hint: "Return to player"; activated => { root.toggle-music-mode(); } }
                }
            }
        }
        // Geometry is estimated from the reviewed 320×180 reference capture.
        if loaded && !crop-editing : Rectangle {
            clip: true;
            x: 8px; y: 49px; width: max(147px, seek-clock.preferred-width + 32px); height: 50px;
            opacity: root.seek-osd-visible && root.osd-enabled ? 1 : 0;
            animate opacity { duration: root.osd-fade-duration; }
            border-radius: 14px;
            background: root.liquid-glass-osd ? #181818dc : #181818;
            if root.liquid-glass-osd && !root.native-video : Image {
                source: root.video-blurred-frame;
                x: video-inset-leading - parent.x;
                y: video-inset-top - parent.y;
                width: root.render-width;
                height: root.render-height;
                opacity: 0.32;
                image-fit: contain;
            }
            seek-clock := HorizontalLayout {
                x: 16px; y: 8px; width: parent.width - 32px; height: 25px; spacing: 5px;
                Text { text: seek-position-label; color: white; font-size: root.osd-text-size * 1px; font-weight: 600; }
                Text { text: "/ " + seek-duration-label; color: #b0b0b0; font-size: root.osd-text-size * 1px; font-weight: 600; }
            }
            Rectangle { x: 16px; y: 35px; height: 2px;
                width: (parent.width - 32px) * clamp(position / max(0.001, duration), 0, 1);
                background: #168bff; border-radius: 1px; }
        }
        if !root.plugin-osd-message.is-empty && !crop-editing : Rectangle {
            clip: true;
            x: (parent.width - self.width) / 2;
            y: max(8px,
                parent.height - (root.music-mode && root.music-mode-show-playlist ? 300px : 0px) - 112px);
            width: min(420px, parent.width - 32px); height: 40px;
            border-radius: 8px; background: #17171be8;
            border-width: 1px; border-color: #ffffff24;
            if root.liquid-glass-osd && !root.native-video : Image {
                source: root.video-blurred-frame;
                x: video-inset-leading - parent.x;
                y: video-inset-top - parent.y;
                width: root.render-width;
                height: root.render-height;
                opacity: 0.32;
                image-fit: contain;
            }
            Text {
                x: 14px; y: 5px; width: parent.width - 28px; height: parent.height - 10px;
                text: root.plugin-osd-message; color: #ffffff; font-size: 13px;
                vertical-alignment: center; overflow: elide;
            }
        }
        if status != "" : Text { x: 16px; y: parent.height - 27px; width: parent.width - 32px;
            text: status; color: root.dark-theme ? #bbbbbb : #55555b; font-size: 11px; overflow: elide; }
        if music-mode && music-mode-show-playlist : Rectangle {
            x: 0px; y: parent.height - 300px; width: parent.width; height: 300px;
            background: root.dark-theme ? #17171b : #f0f0f2;
            ScrollView {
                width: parent.width; height: parent.height;
                VerticalLayout {
                    spacing: 1px;
                    for row in root.playlist : Rectangle {
                        height: root.playlist-metadata-visible ? 38px : 30px; horizontal-stretch: 1;
                        background: row.selected || root.selected-playlist-token == row.token
                            ? (root.dark-theme ? #ffffff1c : #168bff24) :
                            music-row-touch.has-hover ? (root.dark-theme ? #ffffff10 : #0000000a) : transparent;
                        if row.playing : Image {
                            x: 8px; y: 8px; width: 14px; height: 14px;
                            source: @image-url("../../../assets/icons/play.svg");
                            image-fit: contain; colorize: #168bff;
                        }
                        if row.detail != "" : VerticalLayout {
                            x: row.playing ? 28px : 10px; y: 3px;
                            width: parent.width - (row.playing ? 38px : 20px); height: parent.height - 6px;
                            spacing: 0px;
                            Text { text: row.label; color: root.dark-theme ? #eeeeee : #29292d;
                                font-size: 12px; vertical-alignment: center; overflow: elide; }
                            Text { text: row.detail; color: root.dark-theme ? #a7a7ad : #6b6b72;
                                font-size: 10px; vertical-alignment: center; overflow: elide; }
                        }
                        if row.detail == "" : Text { x: row.playing ? 28px : 10px;
                            width: parent.width - (row.playing ? 38px : 20px); text: row.label;
                            color: root.dark-theme ? #eeeeee : #29292d; font-size: 12px;
                            vertical-alignment: center; overflow: elide; }
                        music-row-touch := TouchArea {
                            clicked => {
                                root.selected-playlist-token = row.token;
                                root.selected-playlist-tokens = [row.token];
                            }
                            double-clicked => {
                                root.selected-playlist-token = "";
                                root.selected-playlist-tokens = [];
                                root.select-item(4, row.token);
                            }
                        }
                    }
                }
            }
        }
        if fullscreen && loaded && controls-visible && display-time-and-battery-in-fullscreen && !crop-editing : Rectangle {
            clip: true;
            private property <length> card-width: min(340px, parent.width - 16px -
                (root.sidebar != 0 ? min(root.trailing-sidebar-width * 1px, parent.width * 0.8) : 0px));
            x: parent.width - self.card-width -
                (root.sidebar != 0 ? min(root.trailing-sidebar-width * 1px, parent.width * 0.8) : 0px) - 8px;
            y: (root.compact-ui ? 38px : 42px) +
                (root.osc-position == 1 ? root.osc-height : 0px);
            width: self.card-width; height: 77px;
            border-radius: root.liquid-glass-osd ? 16px : 10px;
            background: root.liquid-glass-osd ? #1b1b20d8 : #1b1b20;
            border-width: 1px; border-color: #ffffff22;
            if root.liquid-glass-osd && !root.native-video : Image {
                source: root.video-blurred-frame;
                x: video-inset-leading - parent.x;
                y: video-inset-top - parent.y;
                width: root.render-width;
                height: root.render-height;
                opacity: 0.32;
                image-fit: contain;
            }
            Text { x: 16px; y: 8px; width: parent.width - 32px; height: 24px;
                text: root.media-title; color: white; font-size: 18px; overflow: elide; }
            HorizontalLayout { x: 16px; y: 39px; width: parent.width - 32px; height: 24px; spacing: 4px;
                Rectangle { width: 22px; height: 22px; border-radius: 11px;
                    border-width: 2px; border-color: #d0d0d4;
                    Rectangle { x: 9px; y: 4px; width: 2px; height: 7px; background: #d0d0d4; }
                    Rectangle { x: 10px; y: 10px; width: 6px; height: 2px; background: #d0d0d4; }
                }
                Text { text: root.fullscreen-info-time; color: #d0d0d4; font-family: "monospace"; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 2px; height: 16px; background: #ffffff55; }
                if root.fullscreen-info-battery != "" : HorizontalLayout {
                    spacing: 4px;
                    Rectangle { width: 22px; height: 12px; border-radius: 2px;
                        border-width: 1px; border-color: #d0d0d4;
                        Rectangle { x: 3px; y: 3px; width: 15px * root.fullscreen-info-battery-level / 100; height: 4px; background: #d0d0d4; }
                        Rectangle { x: 22px; y: 4px; width: 2px; height: 4px; background: #d0d0d4; }
                    }
                    Text { text: root.fullscreen-info-battery; color: #d0d0d4; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                }
            }
        }
        if loaded : Rectangle {
            clip: true;
            x: 8px; y: 49px; width: video-message.preferred-width + 32px;
            height: video-osd-progress >= 0 ? 50px : 41px;
            opacity: root.video-osd-visible && root.osd-enabled ? 1 : 0;
            animate opacity { duration: root.osd-fade-duration; }
            border-radius: 14px;
            background: root.liquid-glass-osd ? #181818dc : #181818;
            if root.liquid-glass-osd && !root.native-video : Image {
                source: root.video-blurred-frame;
                x: video-inset-leading - parent.x;
                y: video-inset-top - parent.y;
                width: root.render-width;
                height: root.render-height;
                opacity: 0.32;
                image-fit: contain;
            }
            video-message := Text { x: 16px; y: 8px; text: root.video-osd-text;
                color: white; font-size: root.osd-text-size * 1px; font-weight: 600; }
            if root.video-osd-progress >= 0 : Rectangle { x: 16px; y: 35px;
                width: (parent.width - 32px) * clamp(root.video-osd-progress, 0, 1);
                height: 2px; background: #168bff; border-radius: 1px; }
        }
        if loaded && !crop-editing : ScreenshotPreview {
            x: 8px; y: 49px;
            active: root.screenshot-preview-visible && root.osd-enabled;
            opacity: root.screenshot-preview-visible && root.osd-enabled ? 1 : 0;
            animate opacity { duration: root.osd-fade-duration; }
            capture: root.screenshot-preview-image;
            has-file: root.screenshot-preview-path != "";
            image-width: root.screenshot-preview-width * 1px;
            image-height: root.screenshot-preview-height * 1px;
            delete-capture => { root.screenshot-preview-action(0); }
            edit-capture => { root.screenshot-preview-action(1); }
            reveal-capture => { root.screenshot-preview-action(2); }
        }
        crop-editor := CropEditor {
            width:parent.width; height:parent.height;
            editing:root.crop-editing; ready:root.crop-ready; description:root.crop-description;
            delogo:root.crop-delogo;
            box-x:root.crop-box-x; box-y:root.crop-box-y;
            box-width:root.crop-box-width; box-height:root.crop-box-height;
            preset-index <=> root.crop-preset-index;
            preset(index) => { root.crop-preset(index); }
            finish(confirm) => { root.finish-custom-crop(confirm); }
            begin-drag(kind,x,y) => { root.begin-crop-drag(kind,x,y); }
            move-drag(x,y) => { root.move-crop-drag(x,y); }
            end-drag => { root.end-crop-drag(); }
        }
        jump-time-dialog := Rectangle {
            visible: jump-time-dialog-visible;
            width: parent.width; height: parent.height;
            background: #00000070;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 340px) / 2;
                y: (parent.height - 172px) / 2;
                width: 340px; height: 172px; border-radius: 9px;
                background: root.dark-theme ? #29292e : #f5f5f7;
                border-width: 1px; border-color: root.dark-theme ? #55555d : #d4d4d8;
                Text { x: 18px; y: 14px; width: parent.width - 36px; height: 22px;
                    text: "Jump to"; color: root.dark-theme ? #f1f1f3 : #242428;
                    font-size: 14px; font-weight: 600; }
                Text { x: 18px; y: 39px; width: parent.width - 36px; height: 32px;
                    text: "Enter a time such as 20:35 or 1:02:03.500.";
                    color: root.dark-theme ? #c8c8cd : #55555b; font-size: 12px; }
                Rectangle {
                    x: 18px; y: 78px; width: parent.width - 36px; height: 30px;
                    border-radius: 5px; border-width: 1px;
                    border-color: jump-time-input.has-focus ? #6094dc : (root.dark-theme ? #5c5c64 : #c8c8cd);
                    background: root.dark-theme ? #1e1e22 : #ffffff;
                    jump-time-input := TextInput {
                        x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px;
                        text <=> root.jump-time-draft; single-line: true;
                        font-size: 13px; color: root.dark-theme ? #f3f3f5 : #202024;
                        accessible-label: "Playback time";
                        accepted => { root.jump-to-time(self.text); }
                    }
                }
                Text { x: 18px; y: 111px; width: parent.width - 36px; height: 17px;
                    text: root.jump-time-error; color: #c43d36; font-size: 11px; }
                HorizontalLayout {
                    x: parent.width - 182px; y: 136px; width: 164px; height: 25px; spacing: 8px;
                    JumpDialogButton { dark-theme: root.dark-theme; label: "Cancel";
                        activated => { root.jump-time-dialog-visible = false; root.jump-time-error = ""; } }
                    JumpDialogButton { dark-theme: root.dark-theme; label: "Jump";
                        activated => { root.jump-to-time(root.jump-time-draft); } }
                }
            }
        }
        url-dialog := Rectangle {
            visible: url-dialog-visible;
            width: parent.width; height: parent.height;
            background: #00000070;
            TouchArea { width: parent.width; height: parent.height; }
            Rectangle {
                x: (parent.width - 390px) / 2;
                y: (parent.height - 176px) / 2;
                width: 390px; height: 176px; border-radius: 9px;
                background: root.dark-theme ? #29292e : #f5f5f7;
                border-width: 1px; border-color: root.dark-theme ? #55555d : #d4d4d8;
                Text { x: 18px; y: 14px; width: parent.width - 36px; height: 22px;
                    text: "Open URL"; color: root.dark-theme ? #f1f1f3 : #242428;
                    font-size: 14px; font-weight: 600; }
                Text { x: 18px; y: 39px; width: parent.width - 36px; height: 32px;
                    text: "Enter a media URL to open in Riina.";
                    color: root.dark-theme ? #c8c8cd : #55555b; font-size: 12px; }
                Rectangle {
                    x: 18px; y: 78px; width: parent.width - 36px; height: 30px;
                    border-radius: 5px; border-width: 1px;
                    border-color: url-input.has-focus ? #6094dc : (root.dark-theme ? #5c5c64 : #c8c8cd);
                    background: root.dark-theme ? #1e1e22 : #ffffff;
                    url-input := TextInput {
                        x: 8px; y: 2px; width: parent.width - 16px; height: parent.height - 4px;
                        text <=> root.url-dialog-draft; single-line: true;
                        font-size: 13px; color: root.dark-theme ? #f3f3f5 : #202024;
                        accessible-label: "Media URL";
                        accepted => {
                            root.open-url(self.text);
                            root.url-dialog-visible = false;
                        }
                    }
                }
                HorizontalLayout {
                    x: parent.width - 182px; y: 130px; width: 164px; height: 25px; spacing: 8px;
                    JumpDialogButton { dark-theme: root.dark-theme; label: "Cancel";
                        activated => { root.url-dialog-visible = false; } }
                    JumpDialogButton { dark-theme: root.dark-theme; label: "Open";
                        activated => {
                            root.open-url(root.url-dialog-draft);
                            root.url-dialog-visible = false;
                        } }
                }
            }
        }
        key-released(event) => {
            if (event.text == Key.Alt || !event.modifiers.alt) && menu-alternates-visible {
                menu-alternates-visible = false;
            }
            if native-video && !crop-editing && event.text == Key.F10 { root.open-application-menu(); return accept; }
            return reject;
        }
        key-pressed(event) => {
            if menu-alternates-visible != event.modifiers.alt {
                menu-alternates-visible = event.modifiers.alt;
            }
            if crop-editing { if event.text == Key.Escape { root.finish-custom-crop(false); } if event.text == Key.Tab { return reject; } return accept; }
            if jump-time-dialog-visible {
                if event.text == Key.Escape { jump-time-dialog-visible = false; jump-time-error = ""; return accept; }
                return accept;
            }
            if url-dialog-visible {
                if event.text == Key.Escape { url-dialog-visible = false; return accept; }
                return accept;
            }
            if native-video && event.text == Key.F10 { return accept; }
            if root.activate-saved-filter-shortcut(event.text, event.modifiers.control,
                    event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                return accept;
            }
            if root.dispatch-key-binding(event.text, event.modifiers.control,
                    event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                return accept;
            }
            root.controls-visible = true; root.activity();
            if (primary-shortcut-is-meta ? event.modifiers.meta : event.modifiers.control) {
                if event.text == "," && !event.modifiers.shift && !event.modifiers.alt {
                    root.open-preferences(); return accept;
                }
                if event.modifiers.shift {
                    if event.modifiers.alt || (primary-shortcut-is-meta && event.modifiers.control) { return reject; }
                    if event.text == "L" { root.toggle-file-loop(); return accept; }
                    if event.text == ">" { root.adjust-chapter(1); return accept; }
                    if event.text == "<" { root.adjust-chapter(-1); return accept; }
                    if event.text == "C" { root.toggle-playlist-pane(3); return accept; }
                    if event.text == "P" { root.toggle-playlist-pane(4); return accept; }
                    if event.text == "A" { root.toggle-settings-pane(1); return accept; }
                    if event.text == "S" { root.take-screenshot(); return accept; }
                    if event.text == "V" { root.toggle-settings-pane(6); return accept; }
                    return reject;
                }
                // Windows/Linux map the extra macOS Control modifier to Alt;
                // primary itself is already Control on those platforms.
                if (primary-shortcut-is-meta ? event.modifiers.control : event.modifiers.alt) {
                    if primary-shortcut-is-meta && event.modifiers.alt { return reject; }
                    if event.text == "a" { root.cycle-audio-track(); return accept; }
                    if event.text == "s" { root.cycle-subtitle-track(); return accept; }
                    if event.text == "v" { root.cycle-video-track(); return accept; }
                    if primary-shortcut-is-meta { return reject; }
                }
                if event.modifiers.alt {
                    if event.text == "[" { root.speed(1 / 1.1); return accept; }
                    if event.text == "]" { root.speed(1.1); return accept; }
                    return reject;
                }
                if event.text == "l" { root.cycle-ab-loop(); return accept; }
                if event.text == "." { root.stop(); return accept; }
                if event.text == Key.RightArrow { root.playlist-next(); return accept; }
                if event.text == Key.LeftArrow { root.playlist-previous(); return accept; }
                if event.text == "o" { root.open-file(); return accept; }
                if event.text == "/" { root.toggle-mute(); return accept; }
                if event.text == "[" { root.speed(0.5); return accept; }
                if event.text == "]" { root.speed(2); return accept; }
                if event.text == "\\" { root.reset-speed(); return accept; }
                return reject;
            }
            if event.modifiers.alt && !event.modifiers.shift {
                if !event.modifiers.control && !event.modifiers.meta && event.text == "v" { root.toggle-secondary-subtitle-visibility(); return accept; }
                if event.text == Key.RightArrow { root.frame-step(); return accept; }
                if event.text == Key.LeftArrow { root.frame-back-step(); return accept; }
                if event.text == Key.UpArrow { root.adjust-volume(1); return accept; }
                if event.text == Key.DownArrow { root.adjust-volume(-1); return accept; }
            }
            if !event.modifiers.control && !event.modifiers.meta {
                if event.modifiers.shift {
                    if event.text == "(" { root.adjust-audio-delay(event.modifiers.alt ? 0.1 : 0.5); return accept; }
                    if event.text == ")" { root.adjust-audio-delay(event.modifiers.alt ? -0.1 : -0.5); return accept; }
                    if event.text == "_" && !event.modifiers.alt { root.reset-audio-delay(); return accept; }
                }
                if event.text == "Z" { root.adjust-subtitle-delay(event.modifiers.alt ? -0.1 : -0.5); return accept; }
                if event.text == "X" { root.adjust-subtitle-delay(event.modifiers.alt ? 0.1 : 0.5); return accept; }
                if event.text == "C" && !event.modifiers.alt { root.reset-subtitle-delay(); return accept; }
            }
            if event.modifiers.shift && !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
                if event.text == Key.PageUp { root.seek-relative(600); return accept; }
                if event.text == Key.PageDown { root.seek-relative(-600); return accept; }
                if event.text == Key.RightArrow { root.subtitle-seek(1); return accept; }
                if event.text == Key.LeftArrow { root.subtitle-seek(-1); return accept; }
            }
            if !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
                if event.text == "G" { root.adjust-subtitle-scale(0.1); return accept; }
                if event.text == "F" { root.adjust-subtitle-scale(-0.1); return accept; }
                if event.text == "R" { root.adjust-subtitle-position(1); return accept; }
            }
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == " " || event.text == "p" { root.toggle-pause(); return accept; }
            if event.text == Key.RightArrow { root.seek-relative(5); return accept; }
            if event.text == Key.LeftArrow { root.seek-relative(-5); return accept; }
            if event.text == Key.UpArrow { root.adjust-volume(5); return accept; }
            if event.text == Key.DownArrow { root.adjust-volume(-5); return accept; }
            if event.text == "m" { root.toggle-mute(); return accept; }
            if event.text == "j" && root.loaded { root.open-jump-time-dialog(); return accept; }
            if event.text == "v" { root.toggle-subtitle-visibility(); return accept; }
            if event.text == "r" { root.adjust-subtitle-position(-1); return accept; }
            if event.text == "t" { root.adjust-subtitle-position(1); return accept; }
            if event.text == "." { root.frame-step(); return accept; }
            if event.text == "," { root.frame-back-step(); return accept; }
            if event.text == "f" { root.toggle-fullscreen(); return accept; }
            if event.text == Key.Return { if !root.fullscreen { root.toggle-fullscreen(); } return accept; }
            if event.text == Key.Escape && root.fullscreen { root.toggle-fullscreen(); return accept; }
            if event.text == Key.Escape && (root.sidebar != 0 || root.leading-sidebar != 0) { root.sidebar = 0; root.leading-sidebar = 0; return accept; }
            return reject;
        }
    }
    // Removing the focused OSC on Stop/auto-hide must leave shortcuts available.
    changed loaded => { root.video-menu-changed(); if !root.loaded { keys.focus(); } root.refresh-fullscreen-info(); }
    changed controls-visible => {
        if root.plugin-ui-disabled && root.controls-visible {
            root.controls-visible = false;
            return;
        }
        if !root.controls-visible { keys.focus(); }
        root.refresh-fullscreen-info();
        root.controls-visibility-changed(root.controls-visible);
    }
    changed fullscreen => { root.refresh-fullscreen-info(); root.video-menu-changed(); }
    changed display-time-and-battery-in-fullscreen => { root.refresh-fullscreen-info(); }
    init => { keys.focus(); }
}
