    // Keys bubble from focused controls through this scope, including sliders.
    // A sibling key scope would lose fullscreen/escape after toolbar navigation.
    keys := FocusScope {
        width: root.width;
        height: root.height;
        if crop-editing && !native-video : Rectangle {
            x: video-inset-leading + crop-picture-x * 1px; y: video-inset-top + crop-picture-y * 1px;
            width: root.render-width; height: root.render-height;
            background: #000000;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-x: 0px; drop-shadow-offset-y: 0px;
        }
        if root.music-mode && !root.music-mode-show-album-art : Rectangle {
            x: video-inset-leading; y: video-inset-top;
            width: video-width; height: video-height; background: #111111;
        }
        if root.native-transition-frame : Rectangle {
            x: 0px; y: 0px; width: root.width; height: root.height;
            background: #000000;
        }
        Image {
            visible: !root.music-mode || root.music-mode-show-album-art;
            source: video-frame;
            x: root.native-transition-frame ? 0px : video-inset-leading + (crop-editing && !native-video ? crop-picture-x * 1px : 0px);
            y: root.native-transition-frame ? 0px : video-inset-top + (crop-editing && !native-video ? crop-picture-y * 1px : 0px);
            width: root.native-transition-frame ? root.width : root.render-width;
            height: root.native-transition-frame ? root.height : root.render-height;
            image-fit: contain;
        }
        if root.music-mode && root.music-mode-show-album-art
            && root.music-mode-is-audio && !root.music-mode-has-album-art
            && !root.music-mode-has-visible-subtitles : Image {
            x: video-inset-leading; y: video-inset-top;
            width: video-width; height: video-height;
            source: @image-url("../../../assets/icons/music-mode-placeholder.svg");
            image-fit: contain;
        }
        for region in (root.live-text-enabled && root.paused ? root.live-text-regions : []) : Rectangle {
            x: video-inset-leading + region.x * root.render-width;
            y: video-inset-top + region.y * root.render-height;
            width: max(1px, region.width * root.render-width);
            height: max(1px, region.height * root.render-height);
            border-width: 1px; border-color: #82b6ff; background: #82b6ff22;
            accessible-role: button; accessible-label: region.text;
            TouchArea { clicked => { root.copy-live-text(region.text); } }
            Rectangle { x: 0; y: -18px; width: max(parent.width, 120px); height: 18px;
                background: #151519e8;
                Text { x: 4px; width: parent.width - 8px; text: region.text;
                    color: #ffffff; font-size: 11px; overflow: elide; vertical-alignment: center; }
            }
        }
        if !root.edge-to-edge-video && root.native-video : Rectangle {
            x: 0px; y: 0px; width: root.video-inset-leading; height: root.height; background: #000000;
        }
        if !root.edge-to-edge-video && root.native-video && root.video-inset-trailing > 0px : Rectangle {
            x: root.width - root.video-inset-trailing; y: 0px;
            width: root.video-inset-trailing; height: root.height; background: #000000;
        }
        if !root.edge-to-edge-video && root.native-video && root.video-inset-top > 0px : Rectangle {
            x: 0px; y: 0px; width: root.width; height: root.video-inset-top; background: #000000;
        }
        if !root.edge-to-edge-video && root.native-video && root.video-inset-bottom > 0px : Rectangle {
            x: 0px; y: root.height - root.video-inset-bottom;
            width: root.width; height: root.video-inset-bottom; background: #000000;
        }
        TouchArea { moved => { root.controls-visible = true; root.activity(); }
            clicked => {
                root.activity();
                root.single-click-action(root.control-single-click-index);
                if root.sidebar != 0 || root.leading-sidebar != 0 {
                    keys.focus(); root.sidebar = 0; root.leading-sidebar = 0;
                }
            }
            double-clicked => { root.double-click-action(root.control-double-click-index); }
            pointer-event(event) => {
                if event.kind == PointerEventKind.up {
                    if event.button == PointerEventButton.right {
                        root.activity(); root.mouse-button-action(root.control-right-click-index);
                    } else if event.button == PointerEventButton.middle {
                        root.activity(); root.mouse-button-action(root.control-middle-click-index);
                    }
                }
            }
            scroll-event(event) => {
                if root.scroll-action-request(event.delta-x / 1px, event.delta-y / 1px) {
                    return accept;
                }
                return reject;
            }
        }

        if root.show-player-title-row && controls-rendered && loaded && !crop-editing && !music-mode : Rectangle {
            clip: true;
            x: macos-sidebar-leading-inset;
            width: max(0px, parent.width - macos-sidebar-leading-inset - macos-sidebar-trailing-inset);
            animate x { duration: root.animations-disabled ? 0ms : 240ms; }
            animate width { duration: root.animations-disabled ? 0ms : 240ms; }
            y: 0; height: root.compact-ui ? 30px : 34px;
            opacity: root.controls-visible ? 1 : 0;
            animate opacity { duration: root.animations-disabled ? 0ms : 250ms; }
            background: root.liquid-glass-osc
                ? (root.dark-theme ? #151515b0 : #f2f2f2ed)
                : (root.dark-theme ? #151519 : #f2f2f2);
            if root.liquid-glass-osc && !root.native-video : Image {
                source: root.video-blurred-frame;
                x: video-inset-leading - parent.x;
                y: video-inset-top - parent.y;
                width: root.render-width;
                height: root.render-height;
                opacity: 0.32;
                image-fit: contain;
            }
            TouchArea {
                width: parent.width; height: parent.height;
                changed has-hover => { root.title-bar-hovered = self.has-hover; }
                HorizontalLayout { width: parent.width; height: parent.height;
                padding-left: 12px; padding-right: 12px;
                Tool { dark-theme: root.dark-theme; icon: @image-url("../../../assets/icons/add.svg"); hint: "Open file"; enabled: engine-ready; activated => { root.open-file(); } }
                Text { text: media-title; color: root.dark-theme ? #dddddd : #29292d; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                if root.always-float-on-top || root.always-show-on-top-icon : TopmostPin {
                    dark-theme: root.dark-theme;
                    pinned: root.always-float-on-top;
                    changed(value) => {
                        root.always-float-on-top = value;
                        root.window-level-toggle-requested(value);
                    }
                }
                Tool { dark-theme: root.dark-theme; icon: @image-url("../../../assets/icons/video.svg"); hint: "Video settings"; activated => { root.toggle-settings-pane(6); } }
                Tool { dark-theme: root.dark-theme; icon: @image-url("../../../assets/icons/audio.svg"); hint: "Audio tracks"; activated => { root.toggle-settings-pane(1); } }
                Tool { dark-theme: root.dark-theme; label: "CC"; hint: "Subtitle tracks"; activated => { root.toggle-settings-pane(2); } }
                Tool { dark-theme: root.dark-theme; icon: @image-url("../../../assets/icons/chapters.svg"); hint: "Chapters"; activated => { root.toggle-playlist-pane(3); } }
                Tool { dark-theme: root.dark-theme; icon: @image-url("../../../assets/icons/playlist.svg"); hint: "Playlist"; activated => { root.toggle-playlist-pane(4); } }
                Tool { dark-theme: root.dark-theme; icon: @image-url("../../../assets/icons/fullscreen.svg"); hint: "Fullscreen"; activated => { root.toggle-fullscreen(); } }
                }
            }
        }
        if (!controls-visible || !loaded) && !crop-editing && !fullscreen &&
            (root.always-float-on-top || root.always-show-on-top-icon) : TopmostPin {
            x: parent.width - 36px;
            y: 2px;
            dark-theme: root.dark-theme;
            pinned: root.always-float-on-top;
            changed(value) => {
                root.always-float-on-top = value;
                root.window-level-toggle-requested(value);
            }
        }
        for side in [0, 1] : Rectangle {
            // Each side owns its selected pane; catalog callbacks retain their original kind.
            private property <int> pane-kind: side == 0 ? root.leading-sidebar : root.sidebar;
            private property <bool> sidebar-open: pane-kind != 0 && !root.crop-editing;
            private property <bool> reduce-motion-fade: root.macos-sidebar-reduce-motion-fade;
            private property <bool> close-transition-pending: false;
            changed sidebar-open => {
                self.close-transition-pending = !sidebar-open && !root.animations-disabled;
            }
            changed reduce-motion-fade => {
                if root.animations-disabled { self.close-transition-pending = false; }
            }
            Timer {
                interval: 260ms; running: parent.close-transition-pending;
                triggered => { parent.close-transition-pending = false; }
            }
            visible: sidebar-open || (close-transition-pending && !root.animations-disabled);
            x: side == 0
                ? ((sidebar-open || reduce-motion-fade) ? 0px : -self.width)
                : ((sidebar-open || reduce-motion-fade) ? parent.width - self.width : parent.width);
            animate x { duration: root.animations-disabled || reduce-motion-fade ? 0ms : 240ms; }
            opacity: !reduce-motion-fade || sidebar-open ? 1 : 0;
            animate opacity { duration: reduce-motion-fade ? 240ms : 0ms; }
            clip: true;
            background: root.liquid-glass-sidebar
                ? (root.dark-theme ? #151515b0 : #f2f2f2ed)
                : (root.dark-theme ? #151519 : #f2f2f2);
            y: root.title-row-height + (root.osc-position == 1 ? root.osc-height : 0px);
            width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, parent.width * 0.8);
            height: parent.height - (root.show-player-title-row ? (root.compact-ui ? 60px : 68px) : 0px) -
                (root.osc-position == 1 ? root.osc-height : root.osc-position == 2 ? root.osc-height / 2 : 0px);
            if root.liquid-glass-sidebar && !root.native-video : Image {
                source: root.video-blurred-frame;
                x: video-inset-leading - parent.x;
                y: video-inset-top - parent.y;
                width: root.render-width;
                height: root.render-height;
                opacity: 0.32;
                image-fit: contain;
            }
            // Track row height and None entry follow SidebarTrackSelector.swift.
            // Saved widths are independent; opening clamps to 80% without overwriting intent.
            // Playlist/chapters default leading; settings default trailing.
            // Insets and material remain provisional until reference captures exist.
            VerticalLayout { padding: root.compact-ui ? 9px : 12px;
                width: parent.width;
                spacing: root.compact-ui ? 6px : 8px;
                HorizontalLayout {
                    // Tabs switch the visible pane without closing it or changing catalog tokens.
                    // Layout is still pending; do not expose an empty reference tab.
                    if pane-kind == 1 || pane-kind == 2 || pane-kind == 5 || pane-kind == 6 : Rectangle {
                        width: 205px; height: 34px; border-radius: 17px;
                        background: root.dark-theme ? #ffffff14 : #0000000b;
                        HorizontalLayout { spacing: 2px; padding: 3px;
                            QuickSettingsTab { label: "Layout";
                                icon: @image-url("../../../assets/icons/interface.svg");
                                selected: pane-kind == 5; dark-theme: root.dark-theme;
                                activated => { root.select-settings-pane(5); } }
                            QuickSettingsTab { label: "Video";
                                icon: @image-url("../../../assets/icons/video.svg");
                                selected: pane-kind == 6; dark-theme: root.dark-theme;
                                activated => { root.select-settings-pane(6); } }
                            QuickSettingsTab { label: "Audio";
                                icon: @image-url("../../../assets/icons/audio.svg");
                                selected: pane-kind == 1; dark-theme: root.dark-theme;
                                activated => { root.select-settings-pane(1); } }
                            QuickSettingsTab { label: "Subtitles";
                                icon: @image-url("../../../assets/icons/subtitles-page.svg");
                                selected: pane-kind == 2; dark-theme: root.dark-theme;
                                activated => { root.select-settings-pane(2); } }
                        }
                    }
                    if pane-kind == 3 || pane-kind == 4 : HorizontalLayout {
                        spacing: 4px;
                        SidebarTab { label: "Playlist"; selected: pane-kind == 4;
                            activated => { root.select-playlist-pane(4); } }
                        SidebarTab { label: "Chapters"; selected: pane-kind == 3;
                            activated => { root.select-playlist-pane(3); } }
                    }
                    if pane-kind == 7 : HorizontalLayout {
                        Text { text: "Plugins"; color: root.dark-theme ? #dddddd : #29292d;
                            font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        if root.plugin-sidebar-labels.length > 0 : ComboBox {
                            horizontal-stretch: 1;
                            height: 24px;
                            model: root.plugin-sidebar-labels;
                            current-index: max(0, root.plugin-sidebar-selected-index);
                            selected => {
                                if self.current-index >= 0 && self.current-index < root.plugin-sidebar-identifiers.length {
                                    root.select-plugin-sidebar-tab(root.plugin-sidebar-identifiers[self.current-index]);
                                }
                            }
                        }
                    }
                    Tool { dark-theme: root.dark-theme; icon: @image-url("../../../assets/icons/close.svg"); hint: "Close sidebar";
                        activated => {
                            // Retire focus before hiding a pane so later shortcuts reach the player.
                            keys.focus();
                            if side == 0 { root.leading-sidebar = 0; } else { root.sidebar = 0; }
                        } }
                }
                if pane-kind == 5 : ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    content-height: 760px;
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8) - (root.compact-ui ? 30px : 36px);
                        height: 142px; border-radius: 10px;
                        border-width: 1px;
                        border-color: root.dark-theme ? #ffffff18 : #00000014;
                        background: root.dark-theme ? #ffffff08 : #ffffff88;
                        VerticalLayout {
                            padding: 10px; spacing: 5px;
                            HorizontalLayout {
                                height: 26px; spacing: 8px;
                                Image { source: @image-url("../../../assets/icons/interface.svg");
                                    image-fit: contain; width: 18px; height: 18px;
                                    colorize: root.dark-theme ? #d0d0d6 : #55555d; }
                                Text { text: "Theme"; color: root.dark-theme ? #dddddd : #29292d;
                                    font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                                Rectangle {
                                    width: 156px; height: 26px; border-radius: 7px;
                                    background: root.dark-theme ? #ffffff14 : #0000000d;
                                    HorizontalLayout {
                                        padding: 2px; spacing: 2px;
                                        SidebarTab { label: "Dark"; selected: root.appearance-mode == 0; dark-theme: root.dark-theme;
                                            activated => { root.appearance-mode = 0; root.layout-settings-changed(); } }
                                        SidebarTab { label: "Light"; selected: root.appearance-mode == 1; dark-theme: root.dark-theme;
                                            activated => { root.appearance-mode = 1; root.layout-settings-changed(); } }
                                        SidebarTab { label: "Auto"; selected: root.appearance-mode == 2; dark-theme: root.dark-theme;
                                            activated => { root.appearance-mode = 2; root.layout-settings-changed(); } }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 24px; spacing: 8px;
                                Image { source: @image-url("../../../assets/icons/settings.svg");
                                    image-fit: contain; width: 18px; height: 18px;
                                    colorize: root.dark-theme ? #d0d0d6 : #55555d; }
                                Text { text: root.surface-material-title; color: root.dark-theme ? #dddddd : #29292d;
                                    font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            VerticalLayout {
                                padding-left: 24px; spacing: 2px;
                                SidebarPositionToggle { label: "On Screen Display";
                                    icon: @image-url("../../../assets/icons/mpv-osd.svg");
                                    leading: root.liquid-glass-osd; dark-theme: root.dark-theme;
                                    height: 23px;
                                    changed(value) => { root.liquid-glass-osd = value; root.layout-settings-changed(); } }
                                SidebarPositionToggle { label: "On Screen Controller";
                                    icon: @image-url("../../../assets/icons/control.svg");
                                    leading: root.liquid-glass-osc; dark-theme: root.dark-theme;
                                    height: 23px;
                                    changed(value) => { root.liquid-glass-osc = value; root.layout-settings-changed(); } }
                                SidebarPositionToggle { label: "Sidebar";
                                    icon: @image-url("../../../assets/icons/playlist.svg");
                                    leading: root.liquid-glass-sidebar; dark-theme: root.dark-theme;
                                    height: 23px;
                                    changed(value) => { root.liquid-glass-sidebar = value; root.layout-settings-changed(); } }
                            }
                        }
                    }
                    Rectangle {
                        width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8) - (root.compact-ui ? 30px : 36px);
                        height: 48px; border-radius: 10px;
                        border-width: 1px;
                        border-color: root.dark-theme ? #ffffff18 : #00000014;
                        background: root.dark-theme ? #ffffff08 : #ffffff88;
                        VerticalLayout { padding: 9px; alignment: center;
                            SidebarPositionToggle { label: "Compact Interface";
                                icon: @image-url("../../../assets/icons/interface.svg");
                                leading: root.compact-ui; dark-theme: root.dark-theme;
                                changed(value) => { root.compact-ui = value; root.layout-settings-changed(); } }
                        }
                    }
                    Rectangle {
                        width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8) - (root.compact-ui ? 30px : 36px);
                        height: (root.unlock-window-aspect-ratio || !root.edge-to-edge-video) &&
                            root.video-display-aspect-ratio > 0 ? 112px : 78px;
                        border-radius: 10px; border-width: 1px;
                        border-color: root.dark-theme ? #ffffff18 : #00000014;
                        background: root.dark-theme ? #ffffff08 : #ffffff88;
                        VerticalLayout { padding: 9px; spacing: 1px;
                            SidebarPositionToggle { label: "Edge-to-Edge Video";
                                icon: @image-url("../../../assets/icons/video.svg");
                                leading: root.edge-to-edge-video; dark-theme: root.dark-theme;
                                changed(value) => { root.edge-to-edge-video = value; root.layout-settings-changed(); } }
                            if root.edge-to-edge-video : SidebarPositionToggle { label: "Lock Window Aspect Ratio";
                                icon: @image-url("../../../assets/icons/video-aspect-ratio.svg");
                                leading: !root.unlock-window-aspect-ratio; dark-theme: root.dark-theme;
                                changed(value) => { root.unlock-window-aspect-ratio = !value; root.layout-settings-changed(); } }
                            if !root.edge-to-edge-video : SidebarPositionToggle { label: "Dock Control Bar and Titlebar";
                                icon: @image-url("../../../assets/icons/control.svg");
                                leading: root.docked-controls; dark-theme: root.dark-theme;
                                changed(value) => { root.docked-controls = value; root.layout-settings-changed(); } }
                            if (root.unlock-window-aspect-ratio || !root.edge-to-edge-video) && root.video-display-aspect-ratio > 0 : SidebarAction {
                                label: "Fit Window to Video";
                                icon: @image-url("../../../assets/icons/fit-window-to-video.svg");
                                enabled: root.loaded && !root.fullscreen;
                                activated => { root.fit-window-to-video(); }
                            }
                        }
                    }
                    SidebarSectionTitle { label: "On Screen Controller"; dark-theme: root.dark-theme; }
                    HorizontalLayout {
                        width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8) - (root.compact-ui ? 30px : 36px);
                        spacing: 6px;
                        LayoutChoice { label: "Floating"; position: 0; dark-theme: root.dark-theme; card-width: (parent.width - 12px) / 3; selected: root.osc-position == 0;
                            activated => { root.osc-position = 0; root.layout-settings-changed(); } }
                        LayoutChoice { label: "Top"; position: 1; dark-theme: root.dark-theme; card-width: (parent.width - 12px) / 3; selected: root.osc-position == 1;
                            activated => { root.osc-position = 1; root.layout-settings-changed(); } }
                        LayoutChoice { label: "Bottom"; position: 2; dark-theme: root.dark-theme; card-width: (parent.width - 12px) / 3; selected: root.osc-position == 2;
                            activated => { root.osc-position = 2; root.layout-settings-changed(); } }
                    }
                    SidebarSectionTitle { label: "Sidebar Position"; dark-theme: root.dark-theme; }
                    Rectangle {
                        width: min((side == 0 ? root.leading-sidebar-width : root.trailing-sidebar-width) * 1px, root.width * 0.8) - (root.compact-ui ? 30px : 36px);
                        height: 116px; border-radius: 10px;
                        border-width: 1px;
                        border-color: root.dark-theme ? #ffffff18 : #00000014;
                        background: root.dark-theme ? #ffffff08 : #ffffff88;
                        VerticalLayout { padding: 8px; spacing: 2px;
                            SidebarSideChoice { label: "Settings"; icon: @image-url("../../../assets/icons/settings.svg");
                                leading: root.settings-at-leading; dark-theme: root.dark-theme;
                                changed(value) => { root.settings-at-leading = value; root.layout-settings-changed(); } }
                            SidebarSideChoice { label: "Playlist and Chapters"; icon: @image-url("../../../assets/icons/playlist.svg");
                                leading: root.playlist-at-leading; dark-theme: root.dark-theme;
                                changed(value) => { root.playlist-at-leading = value; root.layout-settings-changed(); } }
                            SidebarSideChoice { label: "Plugins"; icon: @image-url("../../../assets/icons/plugins.svg");
                                leading: root.plugins-at-leading; dark-theme: root.dark-theme;
                                changed(value) => { root.plugins-at-leading = value; root.layout-settings-changed(); } }
                        }
                    }
                    }
                }
                if pane-kind == 1 : ScrollView {
                    height: 98px; vertical-stretch: 0;
                    content-height: root.audio-tracks.length * 27px;
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout { width: parent.width; spacing: 1px;
                        for row[index] in root.audio-tracks : Rectangle {
                            height: 26px; background: transparent;
                            accessible-role: button; accessible-label: row.label;
                            accessible-action-default => { root.select-item(1, row.token); }
                            Rectangle { x: 0; y: parent.height - 1px;
                                width: parent.width; height: 1px;
                                background: root.dark-theme ? #ffffff20 : #00000020; }
                            if row.selected : Rectangle {
                                x: 0; width: 4px; y: 5px; height: parent.height - 10px;
                                background: #90b7ef; border-radius: 2px;
                            }
                            Text { x: 12px;
                                width: parent.width - 18px - (row.language != "" ? 42px : 0px);
                                text: row.label;
                                color: row.token == "no"
                                    ? (root.dark-theme ? #a7a7ad : #6b6b70)
                                    : (root.dark-theme ? #dddddd : #29292d);
                                font-size: 12px; vertical-alignment: center; overflow: elide;
                            }
                            if row.language != "" : Rectangle {
                                width: 38px; height: 16px; x: parent.width - self.width - 3px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 3px; background: root.dark-theme ? #ffffff20 : #00000010;
                                Text { text: row.language; color: root.dark-theme ? #dddddd : #29292d; font-size: 11px;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            TouchArea { clicked => {
                                audio-row-focus.focus();
                                root.audio-track-focus-index = index;
                                root.select-item(1, row.token);
                            } }
                            audio-row-focus := FocusScope {
                                key-pressed(event) => {
                                    if event.modifiers.alt || event.modifiers.control ||
                                        event.modifiers.meta || event.modifiers.shift { return reject; }
                                    if (event.text == Key.UpArrow || event.text == Key.DownArrow) &&
                                        root.audio-tracks.length > 0 {
                                        let next-index = event.text == Key.UpArrow
                                            ? max(0, index - 1)
                                            : min(root.audio-tracks.length - 1, index + 1);
                                        root.audio-track-focus-index = next-index;
                                        root.select-item(1, root.audio-tracks[next-index].token);
                                        return accept;
                                    }
                                    if event.text == Key.Return || event.text == " " {
                                        root.select-item(1, row.token); return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                    }
                }
                if pane-kind == 1 : HorizontalLayout {
                    Rectangle { height: 30px; horizontal-stretch: 1; border-radius: 4px; background: #ffffff15;
                        accessible-role: button; accessible-label: pane-kind == 1 ? "Load external audio" : "Load subtitle";
                        accessible-enabled: root.loaded;
                        accessible-action-default => { if root.loaded { root.browse-files(pane-kind); } }
                        Text { text: pane-kind == 1 ? "Load External Audio…" : "Load Subtitle…";
                            color: root.loaded ? #eeeeee : #777777; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        if load-focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 4px; background: transparent; }
                        TouchArea { enabled: root.loaded; clicked => { load-focus.focus(); root.browse-files(pane-kind); } }
                        load-focus := FocusScope {
                            enabled: root.loaded;
                            key-pressed(event) => {
                                if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                if event.text == Key.Return || event.text == " " { root.browse-files(pane-kind); return accept; }
                                return reject;
                            }
                        }
                    }
                }
                if pane-kind == 1 : VerticalLayout {
                    height: 68px; vertical-stretch: 0; spacing: 4px;
                    HorizontalLayout { height: 24px; spacing: 8px;
                        Text { text: "Delay"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Tool { dark-theme: root.dark-theme; label: "↺"; hint: "Reset audio delay";
                            visible: root.audio-delay != 0;
                            enabled: root.loaded && root.audio-delay != 0;
                            activated => { root.reset-audio-delay(); } }
                    }
                    HorizontalLayout { height: 24px; spacing: 8px;
                        audio-delay-slider := PlayerSlider { dark-theme: root.dark-theme; minimum: -5; maximum: 5; step: 0.05; value: root.audio-delay;
                            commit-on-release: true;
                            enabled: root.loaded; neutral-mark: true; hint: "Audio delay";
                            draft-changed(value) => { root.preview-audio-delay(value); }
                            changed(value) => { root.set-delay(1, round(value * 20) / 20); }
                            committed(value) => { root.set-delay(1, round(value * 20) / 20); } }
                        DelayInput { value: root.audio-delay;
                            formatted-value: audio-delay-slider.previewing
                                ? root.audio-delay-preview-text : root.audio-delay-text;
                            enabled: root.loaded; hint: "Audio delay in seconds";
                            committed(text) => { if root.set-delay-text(1, text) { keys.focus(); } } }
                    }
                    HorizontalLayout { height: 12px; spacing: 8px;
                        HorizontalLayout { horizontal-stretch: 1;
                            Text { width: 32px; text: "-5s"; color: #aaaaaa; font-size: 10px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { width: 32px; text: "0s"; color: #aaaaaa; font-size: 10px; horizontal-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { width: 32px; text: "+5s"; color: #aaaaaa; font-size: 10px; horizontal-alignment: right; }
                        }
                        Rectangle { width: 72px; background: transparent; }
                    }
                }
                if pane-kind == 1 : Rectangle {
                    height: 28px; background: transparent;
                    accessible-role: checkbox;
                    accessible-label: "Allow volume boost (up to 200%)";
                    accessible-checkable: true;
                    accessible-checked: root.volume-boost;
                    accessible-action-default => { root.set-volume-boost(!root.volume-boost); }
                    Rectangle { x: 2px; y: 6px; width: 16px; height: 16px;
                        border-radius: 3px; border-width: 1px; border-color: #888892;
                        background: root.volume-boost ? #90b7ef : #ffffff10;
                        if root.volume-boost : Text { text: "✓"; color: #17202e;
                            horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                    }
                    Text { x: 26px; width: parent.width - 26px;
                        text: "Allow volume boost (up to 200%)"; color: #dddddd;
                        font-size: 12px; vertical-alignment: center; }
                    if boost-focus.has-focus : Rectangle { border-width: 1px;
                        border-color: #90b7ef; border-radius: 4px; background: transparent; }
                    TouchArea { clicked => { boost-focus.focus(); root.set-volume-boost(!root.volume-boost); } }
                    boost-focus := FocusScope {
                        key-pressed(event) => {
                            if event.text == " " || event.text == Key.Return {
                                root.set-volume-boost(!root.volume-boost); return accept;
                            }
                            return reject;
                        }
                    }
                }
                if pane-kind != 5 : ScrollView {
                    VerticalLayout { alignment: start; spacing: 1px;
                        if pane-kind == 7 && root.plugin-sidebar-selected-identifier == "" : VerticalLayout {
                            spacing: 6px;
                            Text { text: "Plugins can provide content in this panel.";
                                color: root.dark-theme ? #dddddd : #29292d;
                                font-size: 12px; wrap: word-wrap; }
                            if root.plugin-sidebar-labels.length == 0 : Text {
                                text: "Enabled plugins with sidebar tabs appear here.";
                                color: root.dark-theme ? #aaaaaa : #66666b;
                                font-size: 11px; wrap: word-wrap; }
                        }
                        if pane-kind == 1 : VerticalLayout { spacing: 4px;
                            HorizontalLayout { height: 24px; spacing: 8px;
                                Text { text: "Equalizer"; color: #dddddd; font-size: 12px;
                                    font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                ComboBox { width: 150px; height: 23px;
                                    model: root.audio-equalizer-profile-names;
                                    current-index: root.audio-equalizer-profile-index;
                                    selected => { root.select-audio-equalizer-profile(self.current-index); }
                                }
                            }
                            HorizontalLayout { height: 122px; spacing: 2px;
                                for label[index] in ["32", "64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"] : VerticalLayout {
                                    width: 28px; spacing: 2px;
                                    VerticalEqualizerSlider { horizontal-stretch: 1;
                                        dark-theme: root.dark-theme; minimum: -12; maximum: 12;
                                        step: 0.1; value: root.audio-equalizer-values[index];
                                        hint: label + " Hz equalizer gain";
                                        changed(value) => { root.set-audio-equalizer(index, value); }
                                    }
                                    Text { text: label; width: parent.width; height: 14px;
                                        color: #aaaaaa; font-size: 9px;
                                        horizontal-alignment: center; }
                                }
                            }
                            HorizontalLayout { height: 24px; spacing: 6px;
                                Rectangle { horizontal-stretch: 1; height: 23px;
                                    border-radius: 4px; background: #ffffff10;
                                    TextInput { x: 6px; width: parent.width - 12px; height: parent.height;
                                        text <=> root.audio-equalizer-new-profile-name;
                                        single-line: true; color: #eeeeee; font-size: 11px;
                                        vertical-alignment: center; accessible-label: "New equalizer profile name"; }
                                }
                                Tool { dark-theme: root.dark-theme; width: 24px; label: "＋";
                                    hint: "Save equalizer profile";
                                    enabled: root.audio-equalizer-can-save-profile;
                                    activated => { root.save-audio-equalizer-profile(root.audio-equalizer-new-profile-name); } }
                                Tool { dark-theme: root.dark-theme; width: 24px; label: "✎";
                                    hint: "Rename selected user equalizer profile";
                                    enabled: root.audio-equalizer-can-edit-profile;
                                    activated => { root.rename-audio-equalizer-profile(root.audio-equalizer-new-profile-name); } }
                                Tool { dark-theme: root.dark-theme; width: 24px; label: "−";
                                    hint: "Delete selected user equalizer profile";
                                    enabled: root.audio-equalizer-can-delete-profile;
                                    activated => { root.delete-audio-equalizer-profile(); } }
                            }
                        }
                        if pane-kind == 2 : HorizontalLayout {
                            height: 28px;
                            Text { text: "Primary"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            Tool { dark-theme: root.dark-theme; label: root.subtitle-visible ? "●" : "○"; hint: "Toggle subtitle visibility";
                                enabled: root.loaded; activated => { root.toggle-subtitle-visibility(); } }
                        }
                        for row[index] in (pane-kind == 2 ? subtitle-tracks : pane-kind == 3 ? chapters : pane-kind == 6 ? video-tracks : pane-kind == 4 ? playlist : []): Rectangle {
                            property <int> current-playlist-focus-index: root.playlist-focus-index;
                            height: pane-kind < 3 || pane-kind == 6 ? 26px : pane-kind == 3 ? 40px
                                : (root.playlist-metadata-visible ? 38px : 30px);
                            background: (pane-kind == 2 || pane-kind == 6) ? transparent
                                : row.selected ? #ffffff15 : transparent;
                    accessible-role: button; accessible-label: pane-kind == 4 && row.path != ""
                        ? row.label + (row.detail != "" ? ", " + row.detail : "") + ", " + row.path : row.label;
                            if pane-kind == 2 || pane-kind == 6 : Rectangle {
                                x: 0; y: parent.height - 1px; width: parent.width; height: 1px;
                                background: root.dark-theme ? #ffffff20 : #00000020;
                            }
                            if pane-kind == 4 && root.playlist-drag-active && root.playlist-drop-index == index : Rectangle {
                                x: 0; y: 0; width: parent.width; height: 2px; background: #90b7ef;
                            }
                            if pane-kind == 4 && root.playlist-drag-active && root.playlist-drop-index == root.playlist.length && index == root.playlist.length - 1 : Rectangle {
                                x: 0; y: parent.height - 2px; width: parent.width; height: 2px; background: #90b7ef;
                            }
                            accessible-action-default => { root.select-item(pane-kind, row.token); }
                            if row-focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 3px; background: transparent; }
                            if (pane-kind == 4 ? row.playing : row.selected) : Rectangle { x: 0; width: 4px; y: 5px; height: parent.height - 10px; background: #90b7ef; border-radius: 2px; }
                            if pane-kind == 4 && row.detail != "" : VerticalLayout {
                                x: 12px; y: 3px; width: parent.width - 18px; height: parent.height - 6px;
                                spacing: 0px;
                                Text { text: row.label; color: #dddddd; font-size: 12px;
                                    vertical-alignment: center; overflow: elide; }
                                Text { text: row.detail; color: #a7a7ad; font-size: 10px;
                                    vertical-alignment: center; overflow: elide; }
                            }
                            if pane-kind != 4 || row.detail == "" : Text { x: 12px;
                                width: parent.width - 18px - (row.language != "" ? 42px : 0px);
                                text: row.label;
                                color: row.token == "no"
                                    ? (root.dark-theme ? #a7a7ad : #6b6b70)
                                    : (root.dark-theme ? #dddddd : #29292d);
                                font-size: 12px;
                                vertical-alignment: center; overflow: elide; }
                            if row.language != "" : Rectangle { width: 38px; height: 16px; x: parent.width - self.width - 3px;
                                y: (parent.height - self.height) / 2; border-radius: 3px;
                                background: root.dark-theme ? #ffffff20 : #00000010;
                                Text { text: row.language; color: root.dark-theme ? #dddddd : #29292d;
                                    font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                            TouchArea {
                                clicked => { row-focus.focus(); if pane-kind < 3 { root.select-item(pane-kind, row.token); }
                                    if pane-kind == 4 { root.selected-playlist-token = row.token; } }
                                double-clicked => { if pane-kind >= 3 { root.select-item(pane-kind, row.token); root.selected-playlist-token = ""; root.selected-playlist-tokens = []; } }
                                pointer-event(event) => {
                                    if pane-kind == 4 && event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        root.playlist-drag-token = row.token;
                                        root.playlist-focus-index = index;
                                        root.playlist-drag-start-x = self.mouse-x / 1px;
                                        root.playlist-drag-start-y = self.mouse-y / 1px;
                                        root.playlist-drag-active = false;
                                        root.playlist-drag-extend = event.modifiers.control || event.modifiers.meta;
                                        root.playlist-drag-range = event.modifiers.shift;
                                        root.playlist-drop-index = index;
                                    } else if pane-kind == 4 && event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.playlist-drag-token == row.token {
                                        if root.playlist-drag-active {
                                            root.reorder-playlist(root.selected-playlist-tokens, root.playlist-drop-index);
                                        } else {
                                            root.selected-playlist-tokens = root.select-playlist-row(index,
                                                root.playlist-drag-extend, root.playlist-drag-range);
                                        }
                                        root.selected-playlist-token = row.token;
                                        root.playlist-drag-token = "";
                                        root.playlist-drag-active = false;
                                        root.playlist-drop-index = -1;
                                    }
                                }
                                moved => {
                                    if pane-kind == 4 && self.pressed && root.playlist-drag-token == row.token {
                                        let distance-x = abs(self.mouse-x / 1px - root.playlist-drag-start-x);
                                        let distance-y = abs(self.mouse-y / 1px - root.playlist-drag-start-y);
                                        if distance-x + distance-y >= 5 {
                                            if !row.selected
                                                || root.playlist-drag-extend || root.playlist-drag-range {
                                                root.selected-playlist-tokens = root.select-playlist-row(index,
                                                    root.playlist-drag-extend, root.playlist-drag-range);
                                            }
                                            root.selected-playlist-token = row.token;
                                            root.playlist-drag-active = true;
                                            // The layout's 1px gap is included in the displayed row stride.
                                            let content-y = (parent.y + self.mouse-y)
                                                / (root.playlist-metadata-visible ? 39px : 31px);
                                            root.playlist-drop-index = clamp(floor(content-y), 0, root.playlist.length);
                                        }
                                    }
                                }
                            }
                            if pane-kind == 4 : ContextMenuArea {
                                enabled: row.network;
                                Menu {
                                    if row.network : MenuItem {
                                        title: "Open in Browser";
                                        activated => { root.playlist-action(10, row.token); }
                                    }
                                    if row.network : MenuItem {
                                        title: "Copy URL";
                                        activated => { root.playlist-action(11, row.token); }
                                    }
                                }
                            }
                            row-focus := FocusScope {
                                key-pressed(event) => {
                                    // Preserve global playback shortcuts while a catalog row has focus.
                                    if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                    if event.text == Key.Return {
                                        root.select-item(pane-kind, row.token);
                                        root.selected-playlist-token = "";
                                        return accept;
                                    }
                                    if pane-kind == 4 && (event.text == Key.UpArrow || event.text == Key.DownArrow)
                                        && root.playlist.length > 0 {
                                        let next-index = event.text == Key.UpArrow
                                            ? max(0, index - 1)
                                            : min(root.playlist.length - 1, index + 1);
                                        root.playlist-focus-index = next-index;
                                        root.selected-playlist-tokens = root.select-playlist-row(next-index,
                                            event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                        root.selected-playlist-token = root.playlist[next-index].token;
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            changed current-playlist-focus-index => {
                                if pane-kind == 4 && current-playlist-focus-index == index { row-focus.focus(); }
                            }
                        }
                        if pane-kind == 6 : VideoControls {
                            aspect-presets: root.video-aspect-presets;
                            aspect-index: root.video-aspect-index;
                            rotation-index: root.video-rotation-index;
                            crop-presets: root.video-crop-presets;
                            crop-index: root.video-crop-index;
                            crop-enabled: root.loaded && root.video-crop-known;
                            crop-changed(value) => { root.set-video-crop(value); }
                            aspect-enabled: root.loaded && root.video-aspect-known;
                            rotation-enabled: root.loaded && root.video-rotation-known;
                            aspect-changed(value) => { root.set-video-aspect(value); }
                            rotation-changed(value) => { root.set-video-rotation(value); }
                        }
                        if pane-kind == 6 : VerticalLayout { spacing: 8px;
                            Text { text: "Speed"; font-size: 12px; font-weight: 700; color: #dddddd; height: 14px; }
                            HorizontalLayout { spacing: 8px; height: 24px;
                                PlayerSlider { dark-theme: root.dark-theme; minimum: 0; maximum: 24; step: 1;
                                    value: root.speed-slider-position; hint: "Playback speed";
                                    enabled: root.loaded;
                                    changed(value) => { root.set-speed-slider(value); }
                                }
                                Rectangle { width: 76px; height: 24px; background: #ffffff10;
                                    border-radius: 4px; forward-focus: speed-input;
                                    property <string> observed-speed: root.speed-edit-value;
                                    changed observed-speed => { speed-input.text = self.observed-speed; }
                                    FocusScope { width: parent.width; height: parent.height; forward-focus: speed-input;
                                        key-pressed(event) => {
                                            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.text == Key.Tab || event.text == Key.Escape { return reject; }
                                            return accept;
                                        }
                                        speed-input := TextInput { x: 4px; width: parent.width - 8px; height: 24px;
                                            text: root.speed-edit-value; single-line: true;
                                            color: #eeeeee; font-size: 12px; vertical-alignment: center;
                                            enabled: root.loaded; accessible-label: "Custom playback speed";
                                            accessible-action-set-value(value) => { self.text = value; }
                                            accepted => { if root.set-speed-text(self.text) {
                                                self.text = root.speed-edit-value; keys.focus();
                                            } }
                                        }
                                    }
                                }
                                if root.speed-value != 1 : Tool { dark-theme: root.dark-theme; width: 20px; height: 24px;
                                    label: "↺"; hint: "Reset playback speed"; activated => { root.reset-speed(); } }
                            }
                            HorizontalLayout { height: 14px;
                                for label in ["0.25x", "1x", "4x", "16x"] : Text {
                                    text: label; font-size: 10px; color: #bbbbbb; horizontal-stretch: 1;
                                }
                            }
                        }
                        if pane-kind == 6 : HardwareDecodingControls {
                            hardware-enabled: root.hardware-decoding-enabled;
                            hardware-known: root.hardware-decoding-known;
                            hardware-changed(value) => { root.set-hardware-decoding(value); }
                        }
                        if pane-kind == 6 && root.hdr-source-detected && root.hdr-display-active : HdrControls {
                            hdr-enabled: root.hdr-enabled;
                            hdr-available: true;
                            hdr-changed(value) => { root.set-hdr-enabled(value); }
                        }
                        if pane-kind == 6 : VerticalLayout { spacing: 8px;
                            for label[index] in ["Brightness", "Contrast", "Saturation", "Gamma", "Hue"] : HorizontalLayout {
                                height: 20px; spacing: 8px;
                                Text { text: label; width: 65px; font-size: 11px; color: #dddddd;
                                    vertical-alignment: center; }
                                PlayerSlider { dark-theme: root.dark-theme; minimum: -100; maximum: 100; step: 1;
                                    neutral-mark: true;
                                    value: root.video-equalizer-values[index]; hint: label;
                                    enabled: root.video-equalizer-known[index];
                                    changed(value) => { root.set-video-equalizer(index, value); }
                                }
                                Tool { dark-theme: root.dark-theme; width: 20px; height: 20px; label: "↺";
                                    hint: "Reset " + label; enabled: root.video-equalizer-known[index];
                                    activated => { root.set-video-equalizer(index, 0); }
                                }
                            }
                        }
                        if pane-kind == 2 : HorizontalLayout {
                            height: 28px;
                            Text { text: "Secondary"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            Tool { dark-theme: root.dark-theme; label: root.secondary-subtitle-visible ? "●" : "○"; hint: "Toggle secondary subtitle visibility";
                                enabled: root.loaded && root.secondary-subtitle-visibility-known;
                                activated => { root.toggle-secondary-subtitle-visibility(); } }
                        }
                        for row in (pane-kind == 2 ? root.secondary-subtitle-tracks : []): Rectangle {
                            height: 26px;
                            background: row.selected ? #ffffff15 : transparent;
                            accessible-role: button; accessible-label: "Secondary subtitle: " + row.label;
                            accessible-enabled: root.loaded;
                            accessible-action-default => { if root.loaded { root.select-item(5, row.token); } }
                            if secondary-row-focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 3px; background: transparent; }
                            if row.selected : Rectangle { x: 0; width: 4px; y: 5px; height: parent.height - 10px; background: #90b7ef; border-radius: 2px; }
                            Text { x: 12px; width: parent.width - 18px - (row.language != "" ? 42px : 0px); text: row.label; color: #dddddd;
                                font-size: 12px; vertical-alignment: center; overflow: elide; }
                            if row.language != "" : Rectangle { width: 38px; height: 16px; x: parent.width - self.width - 3px;
                                y: (parent.height - self.height) / 2; border-radius: 3px; background: #ffffff20;
                                Text { text: row.language; color: #dddddd; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                            TouchArea { enabled: root.loaded; clicked => { secondary-row-focus.focus(); root.select-item(5, row.token); } }
                            secondary-row-focus := FocusScope {
                                enabled: root.loaded;
                                key-pressed(event) => {
                                    if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                    if event.text == Key.Return { root.select-item(5, row.token); return accept; }
                                    return reject;
                                }
                            }
                        }
                        if pane-kind == 2 : HorizontalLayout {
                            Rectangle { height: 30px; horizontal-stretch: 1; border-radius: 4px; background: #ffffff15;
                                accessible-role: button; accessible-label: pane-kind == 1 ? "Load external audio" : "Load subtitle";
                                accessible-enabled: root.loaded;
                                accessible-action-default => { if root.loaded { root.browse-files(pane-kind); } }
                                Text { text: pane-kind == 1 ? "Load External Audio…" : "Load Subtitle…";
                                    color: root.loaded ? #eeeeee : #777777; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                if subtitle-load-focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 4px; background: transparent; }
                                TouchArea { enabled: root.loaded; clicked => { subtitle-load-focus.focus(); root.browse-files(pane-kind); } }
                                subtitle-load-focus := FocusScope {
                                    enabled: root.loaded;
                                    key-pressed(event) => {
                                        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                        if event.text == Key.Return || event.text == " " { root.browse-files(pane-kind); return accept; }
                                        return reject;
                                    }
                                }
                            }
                        }
                        if pane-kind == 2 : VerticalLayout {
                            height: 124px; vertical-stretch: 0;
                            Rectangle { height: 28px; border-radius: 5px; background: #ffffff0c;
                                HorizontalLayout { padding: 2px; spacing: 1px;
                                    SubtitleLaneSegment { label: "Primary"; hint: "Edit primary subtitle timing and position";
                                        selected: !root.edit-secondary-subtitle;
                                        activated => { root.edit-secondary-subtitle = false; } }
                                    SubtitleLaneSegment { label: "Secondary"; hint: "Edit secondary subtitle timing and position";
                                        selected: root.edit-secondary-subtitle;
                                        activated => { root.edit-secondary-subtitle = true; } }
                                }
                            }
                            HorizontalLayout { height: 24px;
                                Text { text: "Delay"; color: #bbbbbb; font-size: 11px; vertical-alignment: center; }
                                DelayInput { value: root.edit-secondary-subtitle ? root.secondary-subtitle-delay : root.subtitle-delay;
                                    formatted-value: root.edit-secondary-subtitle ? root.secondary-subtitle-delay-text : root.subtitle-delay-text;
                                    secondary: root.edit-secondary-subtitle;
                                    enabled: root.loaded && (!root.edit-secondary-subtitle || root.secondary-subtitle-delay-known);
                                    hint: root.edit-secondary-subtitle ? "Secondary subtitle delay in seconds" : "Subtitle delay in seconds";
                                    committed(text) => {
                                        if root.set-delay-text(root.edit-secondary-subtitle ? 5 : 2, text) { keys.focus(); }
                                    } }
                                Text { text: "s"; color: #bbbbbb; font-size: 11px; vertical-alignment: center; }
                            }
                            PlayerSlider { dark-theme: root.dark-theme; minimum: -5; maximum: 5; step: 0.1; value: root.edit-secondary-subtitle ? root.secondary-subtitle-delay : root.subtitle-delay;
                                enabled: root.loaded && (!root.edit-secondary-subtitle || root.secondary-subtitle-delay-known);
                                hint: root.edit-secondary-subtitle ? "Secondary subtitle delay" : "Subtitle delay";
                                changed(value) => { root.set-delay(root.edit-secondary-subtitle ? 5 : 2, value); } }
                            Text { text: "Position";
                                color: #bbbbbb; font-size: 11px; }
                            // The reference slider ends at 100 even though the engine accepts 150.
                            PlayerSlider { dark-theme: root.dark-theme; minimum: 0; maximum: 100; step: 1; value: root.edit-secondary-subtitle ? root.secondary-subtitle-position : root.subtitle-position;
                                enabled: root.loaded && (root.edit-secondary-subtitle ? root.secondary-subtitle-position-known : root.subtitle-position-known);
                                hint: root.edit-secondary-subtitle ? "Secondary subtitle position" : "Subtitle position";
                                changed(value) => { root.set-subtitle-position(root.edit-secondary-subtitle, round(value)); } }
                        }
                        if pane-kind == 2 && root.subtitle-text-style-available : VerticalLayout {
                            height: 182px; vertical-stretch: 0; spacing: 8px;
                            HorizontalLayout { height: 30px; spacing: 8px;
                                Text { text: "Scale"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                PlayerSlider { dark-theme: root.dark-theme; minimum: -5; maximum: 5; step: 0.05; value: root.subtitle-scale-slider;
                                    enabled: root.loaded && root.subtitle-scale-known; hint: "Subtitle text scale";
