import { ScrollView, ComboBox } from "std-widgets.slint";
import { VideoControls, HardwareDecodingControls } from "video-controls.slint";
import { CropEditor } from "crop-editor.slint";
export { NativeVideoHost, NativeProbeOverlay } from "native-probe.slint";
export { FontPicker } from "font-picker.slint";
export struct CatalogRow { token: string, label: string, language: string, selected: bool }
// Source geometry: OSCFloatingView.swift (460 width, 67 height, bottom ratio 0.1).
// Colors and glyph metrics are estimates until matching macOS captures exist.
component PlayerSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 0;
    in property <float> step: 1;
    in property <bool> enabled: true;
    in property <string> hint;
    in property <bool> neutral-mark: false;
    callback changed(float);
    height: 20px;
    horizontal-stretch: 1;
    background: transparent;
    accessible-role: slider;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-value: value;
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    accessible-value-step: step;
    accessible-action-set-value(text) => {
        if enabled && text.is-float() { changed(clamp(text.to-float(), minimum, maximum)); }
    }
    accessible-action-increment => { if enabled { changed(min(maximum, value + step)); } }
    accessible-action-decrement => { if enabled { changed(max(minimum, value - step)); } }
    private property <float> fraction: clamp((value - minimum) / max(0.001, maximum - minimum), 0, 1);
    Rectangle { x: 3px; y: 9px; width: parent.width - 6px; height: 2px;
        background: #ffffff40; border-radius: 1px; }
    if neutral-mark : Rectangle { x: parent.width / 2 - 0.5px; y: 6px;
        width: 1px; height: 8px; background: #ffffff60; }
    Rectangle { x: 3px; y: 9px; width: (parent.width - 6px) * fraction; height: 2px;
        background: enabled ? #dddde5 : #666666; border-radius: 1px; }
    Rectangle { x: (parent.width - 6px) * fraction; y: 6px; width: 6px; height: 8px;
        border-radius: 2px; background: enabled ? #f4f4f7 : #777777; }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 3px; background: transparent; }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                focus.focus();
                root.changed(root.minimum + clamp((self.mouse-x - 3px) / max(1px, root.width - 6px), 0, 1) * (root.maximum - root.minimum));
            }
        }
        moved => { if self.pressed {
            root.changed(root.minimum + clamp((self.mouse-x - 3px) / max(1px, root.width - 6px), 0, 1) * (root.maximum - root.minimum));
        } }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            // Modified arrows belong to player shortcuts, not slider increments.
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.RightArrow { root.changed(min(root.maximum, root.value + root.step)); return accept; }
            if event.text == Key.LeftArrow { root.changed(max(root.minimum, root.value - root.step)); return accept; }
            return reject;
        }
    }
}

component Tool inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> hint;
    in property <bool> enabled: true;
    callback activated();
    width: 30px; height: 28px;
    border-radius: 5px;
    background: touch.has-hover && enabled ? #ffffff20 : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { activated(); } }
    if icon.width == 0 : Text { text: label; color: enabled ? #eeeeee : #777777; font-size: 17px;
        horizontal-alignment: center; vertical-alignment: center; }
    if icon.width > 0 : Image {
        source: icon; image-fit: contain;
        width: min(17px, root.width); height: min(17px, root.height);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        colorize: enabled ? #eeeeee : #777777;
    }
    if focus.has-focus : Rectangle {
        border-width: 1px; border-color: #90b7ef; border-radius: 5px; background: transparent;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activated(); return accept;
            }
            return reject;
        }
    }
}

component ObservedSizePicker inherits ComboBox {
    in property <int> observed-index: -1;
    in property <string> observed-value;
    current-index: observed-index;
    current-value: observed-value;
    // Popup selection mutates its own properties. Native observations must
    // restore both display text and keyboard cursor after those bindings break.
    changed observed-value => { self.current-value = self.observed-value; self.current-index = self.observed-index; }
    changed observed-index => { self.current-index = self.observed-index; }
}

component SubtitleColorWell inherits Rectangle {
    in property <color> observed-color;
    in property <bool> enabled: true;
    in property <string> hint;
    property <float> red-channel;
    property <float> green-channel;
    property <float> blue-channel;
    property <float> alpha-channel;
    callback edited(color);
    function open-editor() {
        self.red-channel = self.observed-color.red;
        self.green-channel = self.observed-color.green;
        self.blue-channel = self.observed-color.blue;
        self.alpha-channel = self.observed-color.alpha;
        editor.show();
    }
    function submit() {
        self.edited(rgba(round(self.red-channel), round(self.green-channel),
            round(self.blue-channel), self.alpha-channel / 255));
    }
    width: 32px; height: 24px;
    border-radius: 4px; border-width: 1px;
    border-color: focus.has-focus ? #90b7ef : #888892;
    background: #dddddd;
    accessible-role: button; accessible-label: hint; accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.open-editor(); } }
    // The checkerboard distinguishes transparent black from opaque black.
    Rectangle { x: 4px; y: 4px; width: 12px; height: 8px; background: #777777; }
    Rectangle { x: 16px; y: 12px; width: 12px; height: 8px; background: #777777; }
    Rectangle { x: 4px; y: 4px; width: 24px; height: 16px;
        background: root.observed-color; opacity: root.enabled ? 1 : 0.4; }
    TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.open-editor(); } }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " { root.open-editor(); return accept; }
            return reject;
        }
    }
    editor := PopupWindow {
        x: root.width - self.width; y: root.height;
        width: 240px; height: 176px;
        close-policy: close-on-click-outside;
        Rectangle { background: #29292e; border-width: 1px; border-color: #ffffff30; border-radius: 6px; }
        // Channel sliders consume arrows first. Other keys stay in the editor
        // instead of bubbling into the player's seek/pause/track shortcuts.
        FocusScope {
            width: 100%; height: 100%;
            key-pressed(event) => {
                if event.text == Key.Tab { return reject; }
                if event.text == Key.Escape { editor.close(); return accept; }
                return accept;
            }
        VerticalLayout { padding: 12px; spacing: 8px;
            Text { text: root.hint; color: #eeeeee; font-size: 12px; }
            HorizontalLayout { spacing: 8px;
                Text { text: "Red"; width: 48px; color: #dddddd; font-size: 11px; vertical-alignment: center; }
                PlayerSlider { minimum: 0; maximum: 255; step: 1; value: root.red-channel; hint: root.hint + " red";
                    changed(value) => { root.red-channel = round(value); root.submit(); } }
            }
            HorizontalLayout { spacing: 8px;
                Text { text: "Green"; width: 48px; color: #dddddd; font-size: 11px; vertical-alignment: center; }
                PlayerSlider { minimum: 0; maximum: 255; step: 1; value: root.green-channel; hint: root.hint + " green";
                    changed(value) => { root.green-channel = round(value); root.submit(); } }
            }
            HorizontalLayout { spacing: 8px;
                Text { text: "Blue"; width: 48px; color: #dddddd; font-size: 11px; vertical-alignment: center; }
                PlayerSlider { minimum: 0; maximum: 255; step: 1; value: root.blue-channel; hint: root.hint + " blue";
                    changed(value) => { root.blue-channel = round(value); root.submit(); } }
            }
            HorizontalLayout { spacing: 8px;
                Text { text: "Opacity"; width: 48px; color: #dddddd; font-size: 11px; vertical-alignment: center; }
                PlayerSlider { minimum: 0; maximum: 255; step: 1; value: root.alpha-channel; hint: root.hint + " opacity";
                    changed(value) => { root.alpha-channel = round(value); root.submit(); } }
            }
        }
        }
    }
}

component DelayInput inherits Rectangle {
    in property <float> value;
    in property <bool> secondary: false;
    in property <bool> enabled: true;
    in property <string> hint;
    callback committed(string);
    width: 72px; height: 24px;
    border-radius: 4px; background: #ffffff10;
    border-width: 1px; border-color: input.has-focus ? #90b7ef : #ffffff20;
    // Editing breaks TextInput's text binding; native updates and lane changes
    // must explicitly restore the observed value rather than retaining a draft.
    changed value => { input.text = "" + root.value; }
    changed secondary => { input.text = "" + root.value; }
    input := TextInput {
        x: 6px; width: parent.width - 12px; height: parent.height;
        text: "" + root.value;
        enabled: root.enabled;
        font-size: 12px; color: root.enabled ? #eeeeee : #777777;
        vertical-alignment: center;
        single-line: true;
        accessible-label: root.hint;
        accepted => { root.committed(self.text); }
    }
}

component SubtitleLaneSegment inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> selected;
    callback activated();
    height: 24px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: selected ? #ffffff28 : touch.has-hover ? #ffffff10 : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { activated(); }
    Text { text: label; font-size: 12px; color: #eeeeee;
        horizontal-alignment: center; vertical-alignment: center; }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef;
        border-radius: 4px; background: transparent; }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        key-pressed(event) => {
            // Lane choice is idempotent; modified player shortcuts still bubble.
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

export component PlayerWindow inherits Window {
    in property <bool> reflection-known: false;
    in property <bool> video-mirrored: false;
    in property <bool> video-flipped: false;
    callback toggle-video-reflection(bool);
    callback reflection-menu-changed();
    changed reflection-known => { root.reflection-menu-changed(); }
    changed video-mirrored => { root.reflection-menu-changed(); }
    changed video-flipped => { root.reflection-menu-changed(); }
    changed crop-editing => { root.reflection-menu-changed(); }
    if !native-video : MenuBar {
        Menu { title: "Video";
            Menu { title: "Flip"; enabled: root.loaded && root.reflection-known && !root.crop-editing;
                MenuItem { title: "Horizontal (Mirror)"; checkable: true; checked: root.video-mirrored;
                    activated => { root.toggle-video-reflection(true); } }
                MenuItem { title: "Vertical (Flip)"; checkable: true; checked: root.video-flipped;
                    activated => { root.toggle-video-reflection(false); } }
            }
        }
    }
    title: "riina";
    preferred-width: 960px; preferred-height: 600px;
    min-width: 520px; min-height: 300px;
    // The native VO lives in the owner window; this surface supplies only chrome.
    in property <bool> native-video: false;
    in-out property <bool> dialog-open: false;
    in-out property <int> media-request-generation: 0;
    no-frame: native-video;
    background: native-video ? transparent : #111111;
    in property <image> video-frame;
    in property <bool> loaded: false;
    in property <bool> crop-editing: false;
    in property <bool> crop-ready: false;
    in property <string> crop-description;
    in property <float> crop-box-x;
    in property <float> crop-box-y;
    in property <float> crop-box-width;
    in property <float> crop-box-height;
    in-out property <int> crop-preset-index: -1;
    callback begin-custom-crop();
    callback finish-custom-crop(bool);
    callback crop-preset(int);
    callback begin-crop-drag(int,float,float);
    callback move-crop-drag(float,float);
    callback end-crop-drag();
    callback crop-viewport-changed();
    callback focus-crop-editor();
    focus-crop-editor => { crop-editor.focus-editor(); }
    callback focus-player();
    focus-player => { keys.focus(); }
    in property <bool> paused: true;
    in property <bool> playing: false;
    in property <bool> seekable: false;
    in property <bool> muted: false;
    in-out property <bool> fullscreen: false;
    in property <string> media-title: "riina";
    in property <string> position-label: "--:--";
    in property <string> duration-label: "--:--";
    in property <string> seek-position-label;
    in property <string> seek-duration-label;
    in-out property <bool> seek-osd-visible: false;
    in-out property <bool> video-osd-visible: false;
    in property <string> video-osd-text;
    in property <float> video-osd-progress: -1;
    in property <bool> osd-enabled: true;
    in property <bool> primary-shortcut-is-meta: false;
    in property <string> status: "Open a file to begin";
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <float> volume: 100;
    in-out property <bool> volume-boost: false;
    private property <float> volume-limit: volume-boost ? 200 : 100;
    in property <float> speed-value: 1;
    in property <bool> engine-ready: false;
    in property <[CatalogRow]> audio-tracks;
    in property <[CatalogRow]> video-tracks;
    in property <[string]> video-aspect-presets;
    in-out property <int> video-aspect-index: 0;
    in property <bool> video-aspect-known: false;
    in property <bool> video-rotation-known: false;
    in property <int> video-rotation-index: -1;
    in property <[string]> video-crop-presets;
    in property <int> video-crop-index: -1;
    in property <bool> video-crop-known: false;
    in property <bool> hardware-decoding-known: false;
    in property <bool> hardware-decoding-enabled: false;
    in property <[int]> video-equalizer-values;
    in property <float> speed-slider-position: 8;
    in property <string> speed-edit-value: "1";
    in property <[bool]> video-equalizer-known;
    in property <[CatalogRow]> subtitle-tracks;
    in property <[CatalogRow]> secondary-subtitle-tracks;
    in property <bool> secondary-subtitle-visible;
    in property <bool> secondary-subtitle-visibility-known;
    in property <[CatalogRow]> chapters;
    in property <[CatalogRow]> playlist;
    in-out property <int> sidebar: 0;
    in-out property <string> selected-playlist-token: "";
    in property <float> audio-delay: 0;
    in property <float> subtitle-delay: 0;
    in property <float> secondary-subtitle-delay: 0;
    in property <bool> secondary-subtitle-delay-known: false;
    in property <float> secondary-subtitle-position: 0;
    in property <bool> secondary-subtitle-position-known: false;
    in property <float> subtitle-position: 0;
    in property <bool> subtitle-position-known: false;
    in property <float> subtitle-scale-slider: 0;
    in property <bool> subtitle-scale-known: false;
    in property <float> subtitle-font-size: 0;
    in property <bool> subtitle-font-size-known: false;
    in property <string> subtitle-font;
    in property <bool> subtitle-font-known: false;
    in property <float> subtitle-outline-size: 0;
    in property <bool> subtitle-outline-size-known: false;
    in property <color> subtitle-text-color;
    in property <color> subtitle-border-color;
    in property <color> subtitle-shadow-color;
    in property <bool> subtitle-text-color-known: false;
    in property <bool> subtitle-border-color-known: false;
    in property <bool> subtitle-shadow-color-known: false;
    in property <bool> subtitle-text-style-available: true;
    in property <bool> subtitle-ass-style-warning: false;
    in-out property <bool> edit-secondary-subtitle: false;
    in property <bool> subtitle-visible: true;
    in property <string> loop-label: "Off";
    in-out property <bool> controls-visible: true;
    out property <length> video-width: root.width;
    out property <length> video-height: root.height;
    in property <float> crop-picture-x;
    in property <float> crop-picture-y;
    in property <float> crop-picture-width;
    in property <float> crop-picture-height;
    out property <length> render-width: crop-editing && !native-video ? crop-picture-width * 1px : root.width;
    out property <length> render-height: crop-editing && !native-video ? crop-picture-height * 1px : root.height;
    changed video-width => { root.crop-viewport-changed(); }
    changed video-height => { root.crop-viewport-changed(); }
    callback open-file();
    callback toggle-pause();
    callback stop();
    callback seek(float);
    callback seek-relative(float);
    callback set-volume(float);
    callback adjust-volume(float);
    callback set-volume-boost(bool);
    callback toggle-mute();
    callback speed(float);
    callback frame-step();
    callback frame-back-step();
    callback set-video-aspect(string);
    callback set-video-rotation(int);
    callback set-video-crop(int);
    callback set-hardware-decoding(bool);
    callback set-video-equalizer(int, float);
    callback set-speed-slider(float);
    callback set-speed-text(string) -> bool;
    callback subtitle-seek(int);
    callback adjust-chapter(int);
    callback adjust-subtitle-delay(float);
    callback reset-subtitle-delay();
    callback adjust-subtitle-scale(float);
    callback set-subtitle-scale-slider(float);
    callback set-subtitle-font-size(float);
    callback choose-subtitle-font();
    callback dismiss-font-picker();
    callback set-subtitle-outline-size(float);
    callback set-subtitle-color(int, color);
    callback adjust-subtitle-position(float);
    callback set-subtitle-position(bool, float);
    callback adjust-audio-delay(float);
    callback reset-audio-delay();
    callback playlist-next();
    callback playlist-previous();
    callback reset-speed();
    callback toggle-fullscreen();
    callback activity();
    callback show-seek-osd();
    callback show-video-osd();
    callback cycle-ab-loop();
    callback toggle-file-loop();
    callback toggle-secondary-subtitle-visibility();
    callback cycle-audio-track();
    callback cycle-subtitle-track();
    callback cycle-video-track();
    callback select-item(int, string);
    callback browse-files(int);
    callback set-delay(int, float);
    callback set-delay-text(int, string) -> bool;
    callback toggle-subtitle-visibility();
    callback playlist-action(int, string);

    // Keys bubble from focused controls through this scope, including sliders.
    // A sibling key scope would lose fullscreen/escape after toolbar navigation.
    keys := FocusScope {
        width: root.width;
        height: root.height;
        if crop-editing && !native-video : Rectangle {
            x: crop-picture-x * 1px; y: crop-picture-y * 1px;
            width: root.render-width; height: root.render-height;
            background: #000000;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000080;
            drop-shadow-offset-x: 0px; drop-shadow-offset-y: 0px;
        }
        Image {
            source: video-frame;
            x: crop-editing && !native-video ? crop-picture-x * 1px : 0px;
            y: crop-editing && !native-video ? crop-picture-y * 1px : 0px;
            width: root.render-width; height: root.render-height; image-fit: contain;
        }
        TouchArea { moved => { root.controls-visible = true; root.activity(); }
            double-clicked => { root.toggle-fullscreen(); } }
        if !loaded : VerticalLayout {
            alignment: center; spacing: 20px;
            Text { text: "riina"; color: #ededed; font-size: 40px; horizontal-alignment: center; }
            Text { text: "Rust media player";
                color: #a0a0a0; font-size: 13px; horizontal-alignment: center; }
            Rectangle { width: 140px; height: 36px; border-radius: 6px; background: #ffffff18;
                accessible-role: button; accessible-label: "Open file";
                accessible-action-default => { if root.engine-ready { root.open-file(); } }
                Text { text: "Open File…"; color: #eeeeee; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { enabled: root.engine-ready; clicked => { root.open-file(); } }
            }
        }
        if controls-visible && !crop-editing : Rectangle {
            x: 0; y: 0; width: parent.width; height: 34px; background: #151515b0;
            HorizontalLayout { padding-left: 12px; padding-right: 12px;
                Tool { icon: @image-url("../../../assets/icons/add.svg"); hint: "Open file"; enabled: engine-ready; activated => { root.open-file(); } }
                Text { text: media-title; color: #dddddd; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                Tool { icon: @image-url("../../../assets/icons/video.svg"); hint: "Video settings"; activated => { root.sidebar = root.sidebar == 6 ? 0 : 6; } }
                Tool { icon: @image-url("../../../assets/icons/audio.svg"); hint: "Audio tracks"; activated => { root.sidebar = root.sidebar == 1 ? 0 : 1; } }
                Tool { label: "CC"; hint: "Subtitle tracks"; activated => { root.sidebar = root.sidebar == 2 ? 0 : 2; } }
                Tool { icon: @image-url("../../../assets/icons/chapters.svg"); hint: "Chapters"; activated => { root.sidebar = root.sidebar == 3 ? 0 : 3; } }
                Tool { icon: @image-url("../../../assets/icons/playlist.svg"); hint: "Playlist"; activated => { root.sidebar = root.sidebar == 4 ? 0 : 4; } }
                Tool { icon: @image-url("../../../assets/icons/fullscreen.svg"); hint: "Fullscreen"; activated => { root.toggle-fullscreen(); } }
            }
        }
        if sidebar != 0 && !crop-editing : Rectangle {
            x: root.sidebar == 3 || root.sidebar == 4 ? 0px : parent.width - self.width;
            y: 34px; width: min(360px, parent.width * 0.8);
            height: parent.height - 68px; background: #202025f5;
            // Track row height and None entry follow SidebarTrackSelector.swift.
            // Default width 360 and the 80% limit follow Preference/SidebarController.
            // Playlist/chapters default leading; settings default trailing.
            // Insets and material remain provisional until reference captures exist.
            VerticalLayout { padding: 12px; spacing: 8px;
                HorizontalLayout {
                    Text { text: sidebar == 1 ? "Audio" : sidebar == 2 ? "Subtitles" : sidebar == 3 ? "Chapters" : sidebar == 6 ? "Video" : "Playlist";
                        color: #eeeeee; vertical-alignment: center; }
                    Tool { icon: @image-url("../../../assets/icons/close.svg"); hint: "Close sidebar"; activated => { root.sidebar = 0; } }
                }
                if sidebar == 1 : HorizontalLayout {
                    Rectangle { height: 30px; horizontal-stretch: 1; border-radius: 4px; background: #ffffff15;
                        accessible-role: button; accessible-label: root.sidebar == 1 ? "Load external audio" : "Load subtitle";
                        accessible-enabled: root.loaded;
                        accessible-action-default => { if root.loaded { root.browse-files(root.sidebar); } }
                        Text { text: root.sidebar == 1 ? "Load External Audio…" : "Load Subtitle…";
                            color: root.loaded ? #eeeeee : #777777; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        if load-focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 4px; background: transparent; }
                        TouchArea { enabled: root.loaded; clicked => { load-focus.focus(); root.browse-files(root.sidebar); } }
                        load-focus := FocusScope {
                            enabled: root.loaded;
                            key-pressed(event) => {
                                if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                if event.text == Key.Return || event.text == " " { root.browse-files(root.sidebar); return accept; }
                                return reject;
                            }
                        }
                    }
                }
                if sidebar == 1 : VerticalLayout {
                    height: 48px; vertical-stretch: 0;
                    Text { text: "Delay: " + (root.sidebar == 1 ? root.audio-delay : root.subtitle-delay) + " s"; color: #bbbbbb; font-size: 11px; }
                    PlayerSlider { minimum: -5; maximum: 5; step: 0.1; value: root.sidebar == 1 ? root.audio-delay : root.subtitle-delay;
                        enabled: root.loaded; hint: root.sidebar == 1 ? "Audio delay" : "Subtitle delay";
                        changed(value) => { root.set-delay(root.sidebar, value); } }
                }
                if sidebar == 1 : Rectangle {
                    height: 28px; background: transparent;
                    accessible-role: checkbox;
                    accessible-label: "Allow volume boost (up to 200%)";
                    accessible-checkable: true;
                    accessible-checked: root.volume-boost;
                    accessible-action-default => { root.set-volume-boost(!root.volume-boost); }
                    Rectangle { x: 2px; y: 6px; width: 16px; height: 16px;
                        border-radius: 3px; border-width: 1px; border-color: #888892;
                        background: root.volume-boost ? #90b7ef : #ffffff10;
                        if root.volume-boost : Text { text: "✓"; color: #17202e;
                            horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                    }
                    Text { x: 26px; width: parent.width - 26px;
                        text: "Allow volume boost (up to 200%)"; color: #dddddd;
                        font-size: 12px; vertical-alignment: center; }
                    if boost-focus.has-focus : Rectangle { border-width: 1px;
                        border-color: #90b7ef; border-radius: 4px; background: transparent; }
                    TouchArea { clicked => { boost-focus.focus(); root.set-volume-boost(!root.volume-boost); } }
                    boost-focus := FocusScope {
                        key-pressed(event) => {
                            if event.text == " " || event.text == Key.Return {
                                root.set-volume-boost(!root.volume-boost); return accept;
                            }
                            return reject;
                        }
                    }
                }
                ScrollView {
                    VerticalLayout { alignment: start; spacing: 1px;
                        if root.sidebar == 2 : HorizontalLayout {
                            height: 28px;
                            Text { text: "Primary"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            Tool { label: root.subtitle-visible ? "●" : "○"; hint: "Toggle subtitle visibility";
                                enabled: root.loaded; activated => { root.toggle-subtitle-visibility(); } }
                        }
                        for row in (sidebar == 1 ? audio-tracks : sidebar == 2 ? subtitle-tracks : sidebar == 3 ? chapters : sidebar == 6 ? video-tracks : playlist): Rectangle {
                            height: root.sidebar < 3 || root.sidebar == 6 ? 26px : root.sidebar == 3 ? 40px : 30px;
                            background: (root.sidebar == 4 ? root.selected-playlist-token == row.token : row.selected) ? #ffffff15 : transparent;
                            accessible-role: button; accessible-label: row.label;
                            accessible-action-default => { root.select-item(root.sidebar, row.token); }
                            if row-focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 3px; background: transparent; }
                            if row.selected : Rectangle { x: 0; width: 4px; y: 5px; height: parent.height - 10px; background: #90b7ef; border-radius: 2px; }
                            Text { x: 12px; width: parent.width - 18px - (row.language != "" ? 42px : 0px); text: row.label; color: #dddddd;
                                font-size: 12px; vertical-alignment: center; overflow: elide; }
                            if row.language != "" : Rectangle { width: 38px; height: 16px; x: parent.width - self.width - 3px;
                                y: (parent.height - self.height) / 2; border-radius: 3px; background: #ffffff20;
                                Text { text: row.language; color: #dddddd; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                            TouchArea {
                                clicked => { row-focus.focus(); if root.sidebar < 3 { root.select-item(root.sidebar, row.token); }
                                    if root.sidebar == 4 { root.selected-playlist-token = row.token; } }
                                double-clicked => { if root.sidebar >= 3 { root.select-item(root.sidebar, row.token); root.selected-playlist-token = ""; } }
                            }
                            row-focus := FocusScope {
                                key-pressed(event) => {
                                    // Preserve global playback shortcuts while a catalog row has focus.
                                    if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                    if event.text == Key.Return {
                                        root.select-item(root.sidebar, row.token);
                                        root.selected-playlist-token = "";
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                        if sidebar == 6 : VideoControls {
                            aspect-presets: root.video-aspect-presets;
                            aspect-index: root.video-aspect-index;
                            rotation-index: root.video-rotation-index;
                            crop-presets: root.video-crop-presets;
                            crop-index: root.video-crop-index;
                            crop-enabled: root.loaded && root.video-crop-known;
                            crop-changed(value) => { root.set-video-crop(value); }
                            aspect-enabled: root.loaded && root.video-aspect-known;
                            rotation-enabled: root.loaded && root.video-rotation-known;
                            aspect-changed(value) => { root.set-video-aspect(value); }
                            rotation-changed(value) => { root.set-video-rotation(value); }
                        }
                        if sidebar == 6 : VerticalLayout { spacing: 8px;
                            Text { text: "Speed"; font-size: 12px; font-weight: 700; color: #dddddd; height: 14px; }
                            HorizontalLayout { spacing: 8px; height: 24px;
                                PlayerSlider { minimum: 0; maximum: 24; step: 1;
                                    value: root.speed-slider-position; hint: "Playback speed";
                                    enabled: root.loaded;
                                    changed(value) => { root.set-speed-slider(value); }
                                }
                                Rectangle { width: 76px; height: 24px; background: #ffffff10;
                                    border-radius: 4px; forward-focus: speed-input;
                                    property <string> observed-speed: root.speed-edit-value;
                                    changed observed-speed => { speed-input.text = self.observed-speed; }
                                    FocusScope { width: parent.width; height: parent.height; forward-focus: speed-input;
                                        key-pressed(event) => {
                                            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.text == Key.Tab || event.text == Key.Escape { return reject; }
                                            return accept;
                                        }
                                        speed-input := TextInput { x: 4px; width: parent.width - 8px; height: 24px;
                                            text: root.speed-edit-value; single-line: true;
                                            color: #eeeeee; font-size: 12px; vertical-alignment: center;
                                            enabled: root.loaded; accessible-label: "Custom playback speed";
                                            accessible-action-set-value(value) => { self.text = value; }
                                            accepted => { if root.set-speed-text(self.text) {
                                                self.text = root.speed-edit-value; keys.focus();
                                            } }
                                        }
                                    }
                                }
                                if root.speed-value != 1 : Tool { width: 20px; height: 24px;
                                    label: "↺"; hint: "Reset playback speed"; activated => { root.reset-speed(); } }
                            }
                            HorizontalLayout { height: 14px;
                                for label in ["0.25x", "1x", "4x", "16x"] : Text {
                                    text: label; font-size: 10px; color: #bbbbbb; horizontal-stretch: 1;
                                }
                            }
                        }
                        if sidebar == 6 : HardwareDecodingControls {
                            hardware-enabled: root.hardware-decoding-enabled;
                            hardware-known: root.hardware-decoding-known;
                            hardware-changed(value) => { root.set-hardware-decoding(value); }
                        }
                        if sidebar == 6 : VerticalLayout { spacing: 8px;
                            for label[index] in ["Brightness", "Contrast", "Saturation", "Gamma", "Hue"] : HorizontalLayout {
                                height: 20px; spacing: 8px;
                                Text { text: label; width: 65px; font-size: 11px; color: #dddddd;
                                    vertical-alignment: center; }
                                PlayerSlider { minimum: -100; maximum: 100; step: 1;
                                    neutral-mark: true;
                                    value: root.video-equalizer-values[index]; hint: label;
                                    enabled: root.video-equalizer-known[index];
                                    changed(value) => { root.set-video-equalizer(index, value); }
                                }
                                Tool { width: 20px; height: 20px; label: "↺";
                                    hint: "Reset " + label; enabled: root.video-equalizer-known[index];
                                    activated => { root.set-video-equalizer(index, 0); }
                                }
                            }
                        }
                        if root.sidebar == 2 : HorizontalLayout {
                            height: 28px;
                            Text { text: "Secondary"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            Tool { label: root.secondary-subtitle-visible ? "●" : "○"; hint: "Toggle secondary subtitle visibility";
                                enabled: root.loaded && root.secondary-subtitle-visibility-known;
                                activated => { root.toggle-secondary-subtitle-visibility(); } }
                        }
                        for row in (root.sidebar == 2 ? root.secondary-subtitle-tracks : []): Rectangle {
                            height: 26px;
                            background: row.selected ? #ffffff15 : transparent;
                            accessible-role: button; accessible-label: "Secondary subtitle: " + row.label;
                            accessible-enabled: root.loaded;
                            accessible-action-default => { if root.loaded { root.select-item(5, row.token); } }
                            if secondary-row-focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 3px; background: transparent; }
                            if row.selected : Rectangle { x: 0; width: 4px; y: 5px; height: parent.height - 10px; background: #90b7ef; border-radius: 2px; }
                            Text { x: 12px; width: parent.width - 18px - (row.language != "" ? 42px : 0px); text: row.label; color: #dddddd;
                                font-size: 12px; vertical-alignment: center; overflow: elide; }
                            if row.language != "" : Rectangle { width: 38px; height: 16px; x: parent.width - self.width - 3px;
                                y: (parent.height - self.height) / 2; border-radius: 3px; background: #ffffff20;
                                Text { text: row.language; color: #dddddd; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                            TouchArea { enabled: root.loaded; clicked => { secondary-row-focus.focus(); root.select-item(5, row.token); } }
                            secondary-row-focus := FocusScope {
                                enabled: root.loaded;
                                key-pressed(event) => {
                                    if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                    if event.text == Key.Return { root.select-item(5, row.token); return accept; }
                                    return reject;
                                }
                            }
                        }
                        if sidebar == 2 : HorizontalLayout {
                            Rectangle { height: 30px; horizontal-stretch: 1; border-radius: 4px; background: #ffffff15;
                                accessible-role: button; accessible-label: root.sidebar == 1 ? "Load external audio" : "Load subtitle";
                                accessible-enabled: root.loaded;
                                accessible-action-default => { if root.loaded { root.browse-files(root.sidebar); } }
                                Text { text: root.sidebar == 1 ? "Load External Audio…" : "Load Subtitle…";
                                    color: root.loaded ? #eeeeee : #777777; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                if subtitle-load-focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef; border-radius: 4px; background: transparent; }
                                TouchArea { enabled: root.loaded; clicked => { subtitle-load-focus.focus(); root.browse-files(root.sidebar); } }
                                subtitle-load-focus := FocusScope {
                                    enabled: root.loaded;
                                    key-pressed(event) => {
                                        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
                                        if event.text == Key.Return || event.text == " " { root.browse-files(root.sidebar); return accept; }
                                        return reject;
                                    }
                                }
                            }
                        }
                        if sidebar == 2 : VerticalLayout {
                            height: 124px; vertical-stretch: 0;
                            Rectangle { height: 28px; border-radius: 5px; background: #ffffff0c;
                                HorizontalLayout { padding: 2px; spacing: 1px;
                                    SubtitleLaneSegment { label: "Primary"; hint: "Edit primary subtitle timing and position";
                                        selected: !root.edit-secondary-subtitle;
                                        activated => { root.edit-secondary-subtitle = false; } }
                                    SubtitleLaneSegment { label: "Secondary"; hint: "Edit secondary subtitle timing and position";
                                        selected: root.edit-secondary-subtitle;
                                        activated => { root.edit-secondary-subtitle = true; } }
                                }
                            }
                            HorizontalLayout { height: 24px;
                                Text { text: "Delay"; color: #bbbbbb; font-size: 11px; vertical-alignment: center; }
                                DelayInput { value: root.edit-secondary-subtitle ? root.secondary-subtitle-delay : root.subtitle-delay;
                                    secondary: root.edit-secondary-subtitle;
                                    enabled: root.loaded && (!root.edit-secondary-subtitle || root.secondary-subtitle-delay-known);
                                    hint: root.edit-secondary-subtitle ? "Secondary subtitle delay in seconds" : "Subtitle delay in seconds";
                                    committed(text) => {
                                        if root.set-delay-text(root.edit-secondary-subtitle ? 5 : 2, text) { keys.focus(); }
                                    } }
                                Text { text: "s"; color: #bbbbbb; font-size: 11px; vertical-alignment: center; }
                            }
                            PlayerSlider { minimum: -5; maximum: 5; step: 0.1; value: root.edit-secondary-subtitle ? root.secondary-subtitle-delay : root.subtitle-delay;
                                enabled: root.loaded && (!root.edit-secondary-subtitle || root.secondary-subtitle-delay-known);
                                hint: root.edit-secondary-subtitle ? "Secondary subtitle delay" : "Subtitle delay";
                                changed(value) => { root.set-delay(root.edit-secondary-subtitle ? 5 : 2, value); } }
                            Text { text: "Position";
                                color: #bbbbbb; font-size: 11px; }
                            // The reference slider ends at 100 even though the engine accepts 150.
                            PlayerSlider { minimum: 0; maximum: 100; step: 1; value: root.edit-secondary-subtitle ? root.secondary-subtitle-position : root.subtitle-position;
                                enabled: root.loaded && (root.edit-secondary-subtitle ? root.secondary-subtitle-position-known : root.subtitle-position-known);
                                hint: root.edit-secondary-subtitle ? "Secondary subtitle position" : "Subtitle position";
                                changed(value) => { root.set-subtitle-position(root.edit-secondary-subtitle, round(value)); } }
                        }
                        if sidebar == 2 && root.subtitle-text-style-available : VerticalLayout {
                            height: 182px; vertical-stretch: 0; spacing: 8px;
                            HorizontalLayout { height: 30px; spacing: 8px;
                                Text { text: "Scale"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                PlayerSlider { minimum: -5; maximum: 5; step: 0.05; value: root.subtitle-scale-slider;
                                    enabled: root.loaded && root.subtitle-scale-known; hint: "Subtitle text scale";
                                    changed(value) => { root.set-subtitle-scale-slider(value); } }
                                Tool { label: "↺"; hint: "Reset subtitle text scale";
                                    enabled: root.loaded && root.subtitle-scale-known;
                                    activated => { root.set-subtitle-scale-slider(0); } }
                            }
                            HorizontalLayout { height: 30px; spacing: 8px;
                                Text { text: "Font"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Tool { width: 140px; label: root.subtitle-font; hint: "Choose subtitle font";
                                    enabled: root.loaded && root.subtitle-font-known;
                                    activated => { root.choose-subtitle-font(); } }
                                ObservedSizePicker { width: 60px; height: 24px;
                                    model: ["25", "30", "35", "40", "45", "50", "55", "60", "65", "70", "75"];
                                    observed-index: root.subtitle-font-size >= 25 && root.subtitle-font-size <= 75 && mod(root.subtitle-font-size - 25, 5) == 0 ? round((root.subtitle-font-size - 25) / 5) : -1;
                                    observed-value: root.subtitle-font-size-known ? "" + root.subtitle-font-size : "—";
                                    enabled: root.loaded && root.subtitle-font-size-known;
                                    accessible-label: "Subtitle font size";
                                    selected(value) => { if value.is-float() { root.set-subtitle-font-size(value.to-float()); } }
                                }
                            }
                            HorizontalLayout { height: 30px; spacing: 8px;
                                Text { text: "Color"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                SubtitleColorWell { observed-color: root.subtitle-text-color; hint: "Subtitle text color";
                                    enabled: root.loaded && root.subtitle-text-color-known;
                                    edited(value) => { root.set-subtitle-color(1, value); } }
                            }
                            HorizontalLayout { height: 30px; spacing: 8px;
                                Text { text: "Border"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                ObservedSizePicker { width: 60px; height: 24px;
                                model: ["0", "0.25", "0.5", "1", "1.5", "2", "2.5", "3", "4", "5"];
                                observed-index: root.subtitle-outline-size == 0 ? 0 : root.subtitle-outline-size == 0.25 ? 1 : root.subtitle-outline-size == 0.5 ? 2 : root.subtitle-outline-size == 1 ? 3 : root.subtitle-outline-size == 1.5 ? 4 : root.subtitle-outline-size == 2 ? 5 : root.subtitle-outline-size == 2.5 ? 6 : root.subtitle-outline-size == 3 ? 7 : root.subtitle-outline-size == 4 ? 8 : root.subtitle-outline-size == 5 ? 9 : -1;
                                observed-value: root.subtitle-outline-size-known ? "" + root.subtitle-outline-size : "—";
                                enabled: root.loaded && root.subtitle-outline-size-known;
                                accessible-label: "Subtitle outline width";
                                selected(value) => { if value.is-float() { root.set-subtitle-outline-size(value.to-float()); } }
                                }
                                SubtitleColorWell { observed-color: root.subtitle-border-color; hint: "Subtitle border color";
                                    enabled: root.loaded && root.subtitle-border-color-known;
                                    edited(value) => { root.set-subtitle-color(3, value); } }
                            }
                            HorizontalLayout { height: 30px; spacing: 8px;
                                Text { text: "Shadow"; color: #dddddd; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                SubtitleColorWell { observed-color: root.subtitle-shadow-color; hint: "Subtitle shadow color";
                                    enabled: root.loaded && root.subtitle-shadow-color-known;
                                    edited(value) => { root.set-subtitle-color(2, value); } }
                            }
                        }
                        if sidebar == 2 && !root.subtitle-text-style-available : Text {
                            text: "Some settings are not available for this subtitle type.";
                            wrap: word-wrap; color: #bbbbbb; font-size: 11px;
                        }
                        if sidebar == 2 && root.subtitle-ass-style-warning : Text {
                            text: "Setting style options for ASS subtitles may break rendering.";
                            wrap: word-wrap; color: #bbbbbb; font-size: 11px;
                        }
                    }
                }
                if sidebar == 4 : HorizontalLayout { spacing: 2px;
                    Tool { icon: @image-url("../../../assets/icons/add.svg"); hint: "Add files to playlist"; activated => { root.browse-files(4); } }
                    Tool { label: "−"; hint: "Remove selected playlist entry"; enabled: root.selected-playlist-token != "";
                        activated => { root.playlist-action(1, root.selected-playlist-token); root.selected-playlist-token = ""; } }
                    Tool { label: "↑"; hint: "Move selected entry up"; enabled: root.selected-playlist-token != "";
                        activated => { root.playlist-action(2, root.selected-playlist-token); } }
                    Tool { label: "↓"; hint: "Move selected entry down"; enabled: root.selected-playlist-token != "";
                        activated => { root.playlist-action(3, root.selected-playlist-token); } }
                    Tool { label: "⌫"; hint: "Clear playlist except current file"; activated => { root.playlist-action(4, ""); root.selected-playlist-token = ""; } }
                    Tool { label: loop-label == "File" ? "↻₁" : "↻"; hint: "Cycle repeat: " + loop-label; activated => { root.playlist-action(5, ""); } }
                }
            }
        }
        if controls-visible && loaded && !crop-editing : Rectangle {
            width: min(460px, parent.width - 24px); height: 67px;
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.9 - self.height;
            border-radius: 6px; background: #202025e8;
            border-width: 1px; border-color: #ffffff25;
            // This is a tinted SDR spike, not a claim of matching AppKit video blur.
            // Keep the outer baseline separate from glyph/material estimates. A
            // 17-point button row and 20-point timeline fit the recorded 67-point
            // panel with spacious 14/8 insets and an 8-point row separation.
            VerticalLayout { padding-top: 14px; padding-bottom: 8px; spacing: 8px;
                HorizontalLayout { height: 17px; vertical-stretch: 0; padding-left: 12px; padding-right: 12px; spacing: 4px;
                    Tool { height: 17px; icon: @image-url("../../../assets/icons/backward.svg"); hint: "Half playback speed"; activated => { root.speed(0.5); } }
                    Tool { height: 17px; icon: paused ? @image-url("../../../assets/icons/play.svg") : @image-url("../../../assets/icons/pause.svg"); hint: paused ? "Play" : "Pause";
                        activated => { root.toggle-pause(); } }
                    Tool { height: 17px; icon: @image-url("../../../assets/icons/forward.svg"); hint: "Double playback speed"; activated => { root.speed(2); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Tool { height: 17px; icon: muted ? @image-url("../../../assets/icons/muted.svg") : @image-url("../../../assets/icons/volume.svg"); hint: "Mute"; activated => { root.toggle-mute(); } }
                    PlayerSlider { width: 82px; height: 17px; minimum: 0; maximum: root.volume-limit; value: volume; hint: "Volume";
                        changed(value) => { root.set-volume(value); } }
                    Tool { height: 17px; icon: @image-url("../../../assets/icons/stop.svg"); hint: "Stop"; activated => { root.stop(); } }
                    Tool { height: 17px; icon: @image-url("../../../assets/icons/fullscreen.svg"); hint: "Fullscreen"; activated => { root.toggle-fullscreen(); } }
                }
                HorizontalLayout { height: 20px; vertical-stretch: 0; padding-left: 8px; padding-right: 8px; spacing: 8px;
                    Text { text: position-label; color: #d4d4d4; font-size: 11px; vertical-alignment: center; }
                    PlayerSlider { minimum: 0; maximum: max(1, duration); value: position; enabled: seekable; hint: "Playback position";
                        changed(value) => { root.seek(value); } }
                    Text { text: duration-label; color: #d4d4d4; font-size: 11px; vertical-alignment: center; }
                }
            }
        }
        // Geometry is estimated from the reviewed 320×180 reference capture.
        if seek-osd-visible && osd-enabled && loaded && !crop-editing : Rectangle {
            x: 8px; y: 49px; width: max(147px, seek-clock.preferred-width + 32px); height: 50px;
            border-radius: 14px; background: #181818dc;
            seek-clock := HorizontalLayout {
                x: 16px; y: 8px; width: parent.width - 32px; height: 25px; spacing: 5px;
                Text { text: seek-position-label; color: white; font-size: 20px; font-weight: 600; }
                Text { text: "/ " + seek-duration-label; color: #b0b0b0; font-size: 20px; font-weight: 600; }
            }
            Rectangle { x: 16px; y: 35px; height: 2px;
                width: (parent.width - 32px) * clamp(position / max(0.001, duration), 0, 1);
                background: #168bff; border-radius: 1px; }
        }
        if status != "" : Text { x: 16px; y: parent.height - 27px; width: parent.width - 32px;
            text: status; color: #bbbbbb; font-size: 11px; overflow: elide; }
        if video-osd-visible && osd-enabled && loaded : Rectangle {
            x: 8px; y: 49px; width: video-message.preferred-width + 32px;
            height: video-osd-progress >= 0 ? 50px : 41px;
            border-radius: 14px; background: #181818dc;
            video-message := Text { x: 16px; y: 8px; text: root.video-osd-text;
                color: white; font-size: 20px; font-weight: 600; }
            if root.video-osd-progress >= 0 : Rectangle { x: 16px; y: 35px;
                width: (parent.width - 32px) * clamp(root.video-osd-progress, 0, 1);
                height: 2px; background: #168bff; border-radius: 1px; }
        }
        crop-editor := CropEditor {
            width:parent.width; height:parent.height;
            editing:root.crop-editing; ready:root.crop-ready; description:root.crop-description;
            box-x:root.crop-box-x; box-y:root.crop-box-y;
            box-width:root.crop-box-width; box-height:root.crop-box-height;
            preset-index <=> root.crop-preset-index;
            preset(index) => { root.crop-preset(index); }
            finish(confirm) => { root.finish-custom-crop(confirm); }
            begin-drag(kind,x,y) => { root.begin-crop-drag(kind,x,y); }
            move-drag(x,y) => { root.move-crop-drag(x,y); }
            end-drag => { root.end-crop-drag(); }
        }
        key-pressed(event) => {
            if crop-editing { if event.text == Key.Escape { root.finish-custom-crop(false); } if event.text == Key.Tab { return reject; } return accept; }
            root.controls-visible = true; root.activity();
            if (primary-shortcut-is-meta ? event.modifiers.meta : event.modifiers.control) {
                if event.modifiers.shift {
                    if event.modifiers.alt || (primary-shortcut-is-meta && event.modifiers.control) { return reject; }
                    if event.text == "L" { root.toggle-file-loop(); return accept; }
                    if event.text == ">" { root.adjust-chapter(1); return accept; }
                    if event.text == "<" { root.adjust-chapter(-1); return accept; }
                    if event.text == "C" { root.sidebar = root.sidebar == 3 ? 0 : 3; return accept; }
                    if event.text == "P" { root.sidebar = root.sidebar == 4 ? 0 : 4; return accept; }
                    if event.text == "A" { root.sidebar = root.sidebar == 1 ? 0 : 1; return accept; }
                    if event.text == "S" { root.sidebar = root.sidebar == 2 ? 0 : 2; return accept; }
                    if event.text == "V" { root.sidebar = root.sidebar == 6 ? 0 : 6; return accept; }
                    return reject;
                }
                // Windows/Linux map the extra macOS Control modifier to Alt;
                // primary itself is already Control on those platforms.
                if (primary-shortcut-is-meta ? event.modifiers.control : event.modifiers.alt) {
                    if primary-shortcut-is-meta && event.modifiers.alt { return reject; }
                    if event.text == "a" { root.cycle-audio-track(); return accept; }
                    if event.text == "s" { root.cycle-subtitle-track(); return accept; }
                    if event.text == "v" { root.cycle-video-track(); return accept; }
                    if primary-shortcut-is-meta { return reject; }
                }
                if event.modifiers.alt {
                    if event.text == "[" { root.speed(1 / 1.1); return accept; }
                    if event.text == "]" { root.speed(1.1); return accept; }
                    return reject;
                }
                if event.text == "l" { root.cycle-ab-loop(); return accept; }
                if event.text == "." { root.stop(); return accept; }
                if event.text == Key.RightArrow { root.playlist-next(); return accept; }
                if event.text == Key.LeftArrow { root.playlist-previous(); return accept; }
                if event.text == "o" { root.open-file(); return accept; }
                if event.text == "/" { root.toggle-mute(); return accept; }
                if event.text == "[" { root.speed(0.5); return accept; }
                if event.text == "]" { root.speed(2); return accept; }
                if event.text == "\\" { root.reset-speed(); return accept; }
                return reject;
            }
            if event.modifiers.alt && !event.modifiers.shift {
                if !event.modifiers.control && !event.modifiers.meta && event.text == "v" { root.toggle-secondary-subtitle-visibility(); return accept; }
                if event.text == Key.RightArrow { root.frame-step(); return accept; }
                if event.text == Key.LeftArrow { root.frame-back-step(); return accept; }
                if event.text == Key.UpArrow { root.adjust-volume(1); return accept; }
                if event.text == Key.DownArrow { root.adjust-volume(-1); return accept; }
            }
            if !event.modifiers.control && !event.modifiers.meta {
                if event.modifiers.shift {
                    if event.text == "(" { root.adjust-audio-delay(event.modifiers.alt ? 0.1 : 0.5); return accept; }
                    if event.text == ")" { root.adjust-audio-delay(event.modifiers.alt ? -0.1 : -0.5); return accept; }
                    if event.text == "_" && !event.modifiers.alt { root.reset-audio-delay(); return accept; }
                }
                if event.text == "Z" { root.adjust-subtitle-delay(event.modifiers.alt ? -0.1 : -0.5); return accept; }
                if event.text == "X" { root.adjust-subtitle-delay(event.modifiers.alt ? 0.1 : 0.5); return accept; }
                if event.text == "C" && !event.modifiers.alt { root.reset-subtitle-delay(); return accept; }
            }
            if event.modifiers.shift && !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
                if event.text == Key.PageUp { root.seek-relative(600); return accept; }
                if event.text == Key.PageDown { root.seek-relative(-600); return accept; }
                if event.text == Key.RightArrow { root.subtitle-seek(1); return accept; }
                if event.text == Key.LeftArrow { root.subtitle-seek(-1); return accept; }
            }
            if !event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
                if event.text == "G" { root.adjust-subtitle-scale(0.1); return accept; }
                if event.text == "F" { root.adjust-subtitle-scale(-0.1); return accept; }
                if event.text == "R" { root.adjust-subtitle-position(1); return accept; }
            }
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == " " || event.text == "p" { root.toggle-pause(); return accept; }
            if event.text == Key.RightArrow { root.seek-relative(5); return accept; }
            if event.text == Key.LeftArrow { root.seek-relative(-5); return accept; }
            if event.text == Key.UpArrow { root.adjust-volume(5); return accept; }
            if event.text == Key.DownArrow { root.adjust-volume(-5); return accept; }
            if event.text == "m" { root.toggle-mute(); return accept; }
            if event.text == "v" { root.toggle-subtitle-visibility(); return accept; }
            if event.text == "r" { root.adjust-subtitle-position(-1); return accept; }
            if event.text == "t" { root.adjust-subtitle-position(1); return accept; }
            if event.text == "." { root.frame-step(); return accept; }
            if event.text == "," { root.frame-back-step(); return accept; }
            if event.text == "f" { root.toggle-fullscreen(); return accept; }
            if event.text == Key.Return { if !root.fullscreen { root.toggle-fullscreen(); } return accept; }
            if event.text == Key.Escape && root.fullscreen { root.toggle-fullscreen(); return accept; }
            if event.text == Key.Escape && root.sidebar != 0 { root.sidebar = 0; return accept; }
            return reject;
        }
    }
    // Removing the focused OSC on Stop/auto-hide must leave shortcuts available.
    changed loaded => { root.reflection-menu-changed(); if !root.loaded { keys.focus(); } }
    changed controls-visible => { if !root.controls-visible { keys.focus(); } }
    init => { keys.focus(); }
}
