import { ScrollView, ComboBox } from "std-widgets.slint";
import { PlayerSlider, SubtitleColorWell } from "shared-controls.slint";
import { VideoControls, HardwareDecodingControls, HdrControls } from "video-controls.slint";
import { CropEditor } from "crop-editor.slint";
import { ScreenshotPreview } from "screenshot-preview.slint";
export { NativeVideoHost, NativeProbeOverlay } from "native-probe.slint";
export { PictureInPictureWindow } from "pip-window.slint";
export { FontPicker } from "font-picker.slint";
export { PreferencesWindow } from "preferences.slint";
export struct CatalogRow { token: string, label: string, path: string, language: string, selected: bool, playing: bool }
export struct RecentMediaRow { title: string, position-label: string }
export struct LiveTextRegion { text: string, x: float, y: float, width: float, height: float }
component SidebarTab inherits FocusScope {
    in property <string> label;
    in property <bool> selected;
    callback activated();
    height: 30px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { activated(); }
    Rectangle {
        border-radius: 5px;
        background: root.selected ? #ffffff20 : touch.has-hover ? #ffffff0c : transparent;
        border-width: root.has-focus ? 1px : 0px;
        border-color: #90b7ef;
        Text { text: root.label; color: root.selected ? #ffffff : #bbbbc2;
            font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea { clicked => { root.focus(); root.activated(); } }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { activated(); return accept; }
        return reject;
    }
}
component LayoutChoice inherits FocusScope {
    in property <string> label;
    in property <int> position;
    in property <bool> selected;
    in property <length> card-width;
    callback activated();
    height: 62px;
    width: card-width;
    accessible-role: button;
    accessible-label: label;
    accessible-checked: selected;
    accessible-action-default => { activated(); }
    Rectangle {
        border-radius: 7px;
        border-width: selected ? 2px : root.has-focus ? 1px : 0px;
        border-color: selected || root.has-focus ? #168bff : transparent;
        background: selected ? #168bff18 : touch.has-hover ? #ffffff10 : #ffffff08;
        VerticalLayout {
            alignment: center; spacing: 5px;
            Rectangle {
                width: 38px; height: 26px; border-radius: 4px;
                border-width: 1px; border-color: #ffffff55; background: #151519;
                Rectangle {
                    x: position == 0 ? parent.width / 2 - 8px : 1px;
                    y: position == 1 ? 1px : position == 0 ? parent.height - 6px : parent.height - 6px;
                    width: position == 0 ? 16px : parent.width - 2px;
                    height: 5px; border-radius: position == 0 ? 3px : 1px;
                    background: selected ? #90b7ef : #aaaab4;
                }
            }
            Text { text: root.label; color: selected ? #ffffff : #bbbbc2;
                font-size: 11px; horizontal-alignment: center; }
        }
        touch := TouchArea { clicked => { root.focus(); root.activated(); } }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { activated(); return accept; }
        return reject;
    }
}
component SidebarPositionToggle inherits FocusScope {
    in property <string> label;
    in property <bool> leading;
    callback changed(bool);
    height: 30px;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: leading;
    accessible-action-default => { changed(!leading); }
    HorizontalLayout {
        Text { text: root.label; color: #dddddd; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
        Rectangle {
            width: 38px; height: 22px; border-radius: 11px;
            background: root.leading ? #3787ef : #55555e;
            Rectangle {
                x: root.leading ? parent.width - self.width - 2px : 2px;
                y: 2px; width: 18px; height: 18px; border-radius: 9px;
                background: #f5f5f7;
            }
        }
    }
    TouchArea { clicked => { root.changed(!root.leading); } }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { changed(!leading); return accept; }
        return reject;
    }
}
component SidebarAction inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    callback activated();
    height: 32px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { activated(); } }
    Rectangle {
        border-radius: 5px;
        background: touch.has-hover && root.enabled ? #ffffff18 : #ffffff0a;
        Image { source: root.icon; image-fit: contain; x: 8px; y: 8px;
            width: 16px; height: 16px; colorize: root.enabled ? #dddddd : #777777; }
        Text { x: 32px; width: parent.width - 38px; text: root.label;
            color: root.enabled ? #dddddd : #777777; font-size: 12px; vertical-alignment: center; }
        if root.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef;
            border-radius: 5px; background: transparent; }
        touch := TouchArea { enabled: root.enabled; clicked => { root.focus(); root.activated(); } }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { if root.enabled { activated(); } return accept; }
        return reject;
    }
}
component Tool inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> dark-theme: true;
    in property <bool> selected: false;
    callback activated();
    width: 30px; height: 28px;
    border-radius: 5px;
    background: selected ? (dark-theme ? #90b7ef24 : #168bff18) :
        touch.has-hover && enabled ? (dark-theme ? #ffffff20 : #00000014) : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { activated(); } }
    if icon.width == 0 : Text { text: label; color: !enabled ? #777777 : selected ? #90b7ef : (dark-theme ? #eeeeee : #29292d); font-size: 17px;
        horizontal-alignment: center; vertical-alignment: center; }
    if icon.width > 0 : Image {
        source: icon; image-fit: contain;
        width: min(17px, root.width); height: min(17px, root.height);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        colorize: !enabled ? #777777 : selected ? #90b7ef : (dark-theme ? #eeeeee : #29292d);
    }
    if focus.has-focus : Rectangle {
        border-width: 1px; border-color: #90b7ef; border-radius: 5px; background: transparent;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activated(); return accept;
            }
            return reject;
        }
    }
    // Keep pointer activation above the focus helper in Slint's stacking order;
    // otherwise a mouse press can focus a toolbar item without activating it.
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activated(); } }
}

component JumpDialogButton inherits FocusScope {
    in property <string> label;
    in property <bool> dark-theme: true;
    callback activated();
    width: 68px; height: 26px;
    accessible-role: button;
    accessible-label: label;
    Rectangle {
        width: parent.width; height: parent.height; border-radius: 5px;
        border-width: 1px; border-color: root.has-focus ? #6094dc : (root.dark-theme ? #62626a : #c7c7cc);
        background: root.has-focus ? (root.dark-theme ? #ffffff1b : #168bff16) :
            (root.dark-theme ? #3a3a40 : #ffffff);
        Text { text: root.label; width: parent.width; height: parent.height;
            color: root.dark-theme ? #f0f0f2 : #29292d; font-size: 12px;
            horizontal-alignment: center; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.focus(); root.activated(); } }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
        return reject;
    }
}

component PlaylistSortButton inherits Rectangle {
    in property <bool> dark-theme: true;
    callback sort-requested(int);
    width: 30px; height: 28px; background: transparent;
    Tool { dark-theme: root.dark-theme; icon: @image-url("../../../assets/icons/sort.svg"); hint: "Sort playlist";
        activated => { choices.show(); } }
    choices := PopupWindow {
        x: 0px; y: -self.height; width: 190px; height: 146px;
        close-policy: close-on-click-outside;
        Rectangle { background: root.dark-theme ? #29292e : #f8f8fa;
            border-width: 1px; border-color: root.dark-theme ? #ffffff38 : #b8b8bc; border-radius: 6px;
            VerticalLayout { padding: 6px; spacing: 1px;
                Text { text: "Sorting"; height: 22px; x: 7px; color: root.dark-theme ? #a9a9b1 : #77777d; font-size: 11px; vertical-alignment: center; }
                for label[index] in ["Filename Ascending", "Filename Descending", "File Path Ascending", "File Path Descending"] : Rectangle {
                    height: 27px; border-radius: 4px;
                    background: row-touch.has-hover ? (root.dark-theme ? #ffffff20 : #00000012) : transparent;
                    accessible-role: button; accessible-label: label;
                    accessible-action-default => { root.sort-requested(index); choices.close(); }
                    Text { x: 8px; width: parent.width - 16px; text: label; font-size: 11px;
                        color: root.dark-theme ? #eeeeee : #29292d; vertical-alignment: center; }
                    row-touch := TouchArea { clicked => { root.sort-requested(index); choices.close(); } }
                }
            }
        }
    }
}

component TopmostPin inherits Rectangle {
    in property <bool> pinned;
    in property <bool> dark-theme: true;
    callback changed(bool);
    width: 30px;
    height: 28px;
    background: transparent;
    Tool {
        dark-theme: root.dark-theme;
        icon: root.pinned
            ? @image-url("../../../assets/icons/pin-fill.svg")
            : @image-url("../../../assets/icons/pin.svg");
        hint: root.pinned ? "Remove float on top" : "Float on top";
        activated => { root.changed(!root.pinned); }
    }
}

component ObservedSizePicker inherits ComboBox {
    in property <int> observed-index: -1;
    in property <string> observed-value;
    current-index: observed-index;
    current-value: observed-value;
    // Popup selection mutates its own properties. Native observations must
    // restore both display text and keyboard cursor after those bindings break.
    changed observed-value => { self.current-value = self.observed-value; self.current-index = self.observed-index; }
    changed observed-index => { self.current-index = self.observed-index; }
}

component DelayInput inherits Rectangle {
    in property <float> value;
    in property <bool> secondary: false;
    in property <bool> enabled: true;
    in property <string> hint;
    callback committed(string);
    width: 72px; height: 24px;
    border-radius: 4px; background: #ffffff10;
    border-width: 1px; border-color: input.has-focus ? #90b7ef : #ffffff20;
    // Editing breaks TextInput's text binding; native updates and lane changes
    // must explicitly restore the observed value rather than retaining a draft.
    changed value => { input.text = "" + root.value; }
    changed secondary => { input.text = "" + root.value; }
    input := TextInput {
        x: 6px; width: parent.width - 12px; height: parent.height;
        text: "" + root.value;
        enabled: root.enabled;
        font-size: 12px; color: root.enabled ? #eeeeee : #777777;
        vertical-alignment: center;
        single-line: true;
        accessible-label: root.hint;
        accepted => { root.committed(self.text); }
    }
}

component SubtitleLaneSegment inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> selected;
    callback activated();
    height: 24px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: selected ? #ffffff28 : touch.has-hover ? #ffffff10 : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { activated(); }
    Text { text: label; font-size: 12px; color: #eeeeee;
        horizontal-alignment: center; vertical-alignment: center; }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef;
        border-radius: 4px; background: transparent; }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        key-pressed(event) => {
            // Lane choice is idempotent; modified player shortcuts still bubble.
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

component WelcomeAction inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> enabled: true;
    callback activated();
    width: 112px; height: 36px; border-radius: 5px;
    background: !enabled ? #ffffff08 : touch.has-hover ? #ffffff24 : #ffffff18;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: #8ab7f0;
    accessible-role: button;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { activated(); } }
    Text { text: root.label; color: root.enabled ? #f1f1f4 : #77777f;
        font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.activated(); }
    }
    focus := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

component RecentMediaEntry inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> prominent: false;
    in property <bool> selected: false;
    callback activated();
    height: 28px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: touch.has-hover ? #ffffff14 : selected ? #ffffff18 : prominent ? #ffffff0c : transparent;
    accessible-role: button;
    accessible-label: detail == "" ? label : label + ", " + detail;
    accessible-action-default => { activated(); }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        Text { text: root.label; color: #dedee4; font-size: 12px;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.detail; color: #92929a; font-size: 11px;
            vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

// The reference gives Resume its own action row above the document table.
// Keeping title and time separate preserves its truncation and alignment rules.
component ResumeMediaEntry inherits Rectangle {
    in property <string> media-title;
    in property <string> position-label;
    in property <bool> selected: false;
    callback activated();
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: selected ? #ffffff28 : touch.has-hover ? #ffffff10 : #ffffff0c;
    accessible-role: button;
    accessible-label: "Resume " + root.media-title + ", " + root.position-label;
    accessible-action-default => { root.activated(); }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px;
        Image { source: @image-url("../../../assets/icons/resume-history.svg");
            width: 16px; height: 16px; }
        Text { text: "Resume"; color: #dedee4; font-size: 12px;
            vertical-alignment: center; }
        Text { text: root.media-title; color: #dedee4; font-size: 12px;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.position-label; color: #92929a; font-size: 11px;
            vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

export component WelcomeWindow inherits Window {
    title: "Riina";
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    // Match IINA v1.5.0's fixed 560 x 440 point welcome window.
    preferred-width: 560px; preferred-height: 440px;
    min-width: 560px; min-height: 440px;
    max-width: 560px; max-height: 440px;
    background: #17171b;
    in property <string> app-version: "0.2.1";
    in-out property <string> url-draft;
    in-out property <bool> url-entry-visible: false;
    in property <string> url-error;
    in property <[RecentMediaRow]> recent-media;
    in property <[RecentMediaRow]> recent-documents;
    in property <int> recent-document-offset: 1;
    in-out property <int> selection-index: -1;
    callback open-file();
    callback open-url(string);
    callback open-recent(int);

    keys := FocusScope {
        width: root.width; height: root.height;
        Rectangle {
            width: parent.width; height: parent.height; background: #17171b;
            VerticalLayout {
                padding-left: 30px; padding-right: 30px;
                padding-top: 48px; padding-bottom: 24px; spacing: 0px;
            HorizontalLayout {
                alignment: start; spacing: 14px; height: 76px;
                Image {
                    width: 68px; height: 68px;
                    source: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
                    image-fit: contain;
                    accessible-label: "Riina";
                }
                VerticalLayout {
                    alignment: center; spacing: 3px;
                    Text { text: "Riina"; color: #f4f4f6; font-size: 20px; font-weight: 700; }
                    Text { text: "Version " + root.app-version; color: #a6a6ad; font-size: 11px; }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    alignment: center; spacing: 12px;
                    WelcomeAction { label: "Open File…"; hint: "Open a media file";
                        activated => { root.open-file(); } }
                    WelcomeAction { label: "Open URL…"; hint: "Open media from a URL";
                        activated => { root.url-entry-visible = !root.url-entry-visible; } }
                }
            }
            Rectangle { height: 16px; }
            if root.url-entry-visible : VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px; height: 36px;
                    Rectangle { horizontal-stretch: 1; height: 36px; border-radius: 5px;
                        background: #232329; border-width: 1px;
                        border-color: url-input.has-focus ? #6195d8 : #ffffff24;
                        url-input := TextInput { x: 10px; width: parent.width - 20px; height: parent.height;
                            text <=> root.url-draft; single-line: true;
                            font-size: 12px; color: #f0f0f3;
                            accessible-label: "Media URL";
                            accepted => { root.open-url(self.text); } }
                        if root.url-draft.is-empty && !url-input.has-focus : Text {
                            x: 10px; y: 0px; width: parent.width - 20px; height: parent.height;
                            text: "https://"; font-size: 12px; color: #85858d;
                            vertical-alignment: center;
                        }
                    }
                    WelcomeAction { label: "Open"; hint: "Open this URL";
                        activated => { root.open-url(root.url-draft); } }
                }
                if root.url-error != "" : Text {
                    text: root.url-error; color: #ed9389; font-size: 11px;
                }
            }
            Rectangle { height: 16px; }
            if root.recent-media.length > 0 : VerticalLayout {
                spacing: 2px; vertical-stretch: 1;
                ResumeMediaEntry {
                    media-title: root.recent-media[0].title;
                    position-label: root.recent-media[0].position-label;
                    selected: root.selection-index < 0;
                    activated => { root.selection-index = -1; root.open-recent(0); }
                }
                if root.recent-documents.length > 0 : ScrollView {
                    horizontal-stretch: 1; vertical-stretch: 1;
                    VerticalLayout { spacing: 1px;
                        for row[index] in root.recent-documents : RecentMediaEntry {
                            label: row.title; detail: row.position-label;
                            selected: root.selection-index == index;
                            activated => { root.selection-index = index; root.open-recent(index + root.recent-document-offset); }
                        }
                    }
                }
            }
        }
        }
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.DownArrow {
                if root.selection-index < root.recent-documents.length - 1 {
                    root.selection-index += 1;
                }
                return accept;
            }
            if event.text == Key.UpArrow {
                if root.selection-index > 0 {
                    root.selection-index -= 1;
                } else if root.selection-index == 0 && root.recent-media.length > 0 {
                    root.selection-index = -1;
                }
                return accept;
            }
            if event.text == Key.Return {
                if root.recent-media.length > 0 || root.recent-documents.length > 0 {
                    root.open-recent(root.selection-index < 0 && root.recent-media.length > 0
                        ? 0 : root.selection-index + root.recent-document-offset);
                }
                return accept;
            }
            return reject;
        }
    }
}

export component PlayerWindow inherits Window {
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    in property <bool> reflection-known: false;
    in property <bool> deinterlace-known: false;
    in property <bool> deinterlace-enabled: false;
    callback toggle-deinterlace();
    in property <bool> screenshot-available: false;
    callback take-screenshot();
    callback open-screenshot-folder();
    changed screenshot-available => { root.video-menu-changed(); }
    changed deinterlace-known => { root.video-menu-changed(); }
    changed deinterlace-enabled => { root.video-menu-changed(); }
    in-out property <bool> video-osd-request-feedback: false;
    in-out property <bool> scroll-input-suppressed: false;
    in property <bool> video-mirrored: false;
    in property <bool> video-flipped: false;
    callback toggle-video-reflection(bool);
    callback video-menu-changed();
    callback open-application-menu();
    callback open-preferences();
    changed reflection-known => { root.video-menu-changed(); }
    changed video-mirrored => { root.video-menu-changed(); }
    changed video-flipped => { root.video-menu-changed(); }
    callback crop-window-controls-changed();
    changed crop-editing => { root.video-menu-changed(); root.crop-window-controls-changed(); root.refresh-fullscreen-info(); }

    if !native-video : MenuBar {
        Menu { title: "riina";
            MenuItem { title: "Preferences…"; enabled: !root.crop-editing;
                activated => { root.open-preferences(); } }
        }
        Menu { title: "File";
            MenuItem { title: "Open…"; enabled: !root.crop-editing;
                activated => { root.open-file(); } }
        }
        Menu { title: "Playback";
            MenuItem { title: root.paused ? "Play" : "Pause";
                enabled: root.loaded && !root.crop-editing;
                activated => { root.toggle-pause(); } }
            MenuItem { title: "Stop"; enabled: root.loaded && !root.crop-editing;
                activated => { root.stop(); } }
            MenuSeparator {}
            MenuItem { title: "Step Forward 5s"; enabled: root.loaded && !root.crop-editing;
                activated => { root.seek-relative(5); } }
            MenuItem { title: "Next Frame"; enabled: root.loaded && !root.crop-editing;
                activated => { root.frame-step(); } }
            MenuItem { title: "Step Backward 5s"; enabled: root.loaded && !root.crop-editing;
                activated => { root.seek-relative(-5); } }
            MenuItem { title: "Previous Frame"; enabled: root.loaded && !root.crop-editing;
                activated => { root.frame-back-step(); } }
            MenuItem { title: "Jump to Beginning"; enabled: root.loaded && !root.crop-editing;
                activated => { root.seek(0); } }
            MenuItem { title: "Jump to…"; enabled: root.loaded && !root.crop-editing;
                activated => { root.open-jump-time-dialog(); } }
            MenuSeparator {}
            MenuItem { title: "Speed Up to 2x"; enabled: root.loaded && !root.crop-editing;
                activated => { root.speed(2); } }
            MenuItem { title: "Speed Down to 0.5x"; enabled: root.loaded && !root.crop-editing;
                activated => { root.speed(0.5); } }
            MenuItem { title: "Reset Speed"; enabled: root.loaded && !root.crop-editing;
                activated => { root.reset-speed(); } }
            MenuSeparator {}
            MenuItem { title: "Music Mode"; checkable: true; checked: root.music-mode;
                enabled: root.loaded && !root.crop-editing;
                activated => { root.toggle-music-mode(); } }
            MenuItem { title: "A-B Loop"; enabled: root.loaded && !root.crop-editing;
                activated => { root.cycle-ab-loop(); } }
            MenuItem { title: "File Loop"; checkable: true; checked: root.loop-label == "File";
                enabled: root.loaded && !root.crop-editing;
                activated => { root.toggle-file-loop(); } }
            MenuItem { title: "Playlist Loop"; checkable: true; checked: root.loop-label == "Playlist";
                enabled: root.loaded && !root.crop-editing;
                activated => { root.playlist-action(5, ""); } }
            MenuItem { title: "Show Playlist Panel"; enabled: !root.crop-editing;
                activated => { root.toggle-playlist-pane(4); } }
            MenuItem { title: "Next Media"; enabled: root.loaded && !root.crop-editing;
                activated => { root.playlist-next(); } }
            MenuItem { title: "Previous Media"; enabled: root.loaded && !root.crop-editing;
                activated => { root.playlist-previous(); } }
            MenuItem { title: "Show Chapters Panel"; enabled: !root.crop-editing;
                activated => { root.toggle-playlist-pane(3); } }
            MenuItem { title: "Next Chapter"; enabled: root.loaded && !root.crop-editing;
                activated => { root.adjust-chapter(1); } }
            MenuItem { title: "Previous Chapter"; enabled: root.loaded && !root.crop-editing;
                activated => { root.adjust-chapter(-1); } }
            MenuSeparator {}
            MenuItem { title: "Take a Screenshot"; enabled: root.screenshot-available && !root.crop-editing;
                activated => { root.take-screenshot(); } }
            MenuItem { title: "Go to Screenshot Folder"; enabled: !root.crop-editing;
                activated => { root.open-screenshot-folder(); } }
        }
        Menu { title: "Video";
            MenuItem { title: "Show Video Panel"; enabled: !root.crop-editing;
                activated => { root.toggle-settings-pane(6); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Video Tracks"; enabled: root.loaded && !root.crop-editing;
                activated => { root.cycle-video-track(); } }
            Menu { title: "Video Track"; enabled: root.loaded && !root.crop-editing;
                for row in root.video-tracks : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-item(6, row.token); }
                }
            }
            MenuSeparator {}
            Menu { title: "Aspect Ratio"; enabled: root.loaded && root.video-aspect-known && !root.crop-editing;
                for label[index] in root.video-aspect-menu-labels : MenuItem {
                    title: label; checkable: true; checked: root.video-aspect-menu-index == index;
                    activated => { root.set-menu-video-aspect(index); }
                }
            }
            Menu { title: "Crop"; enabled: root.loaded && root.video-crop-known && !root.crop-editing;
                for label[index] in root.video-crop-menu-labels : MenuItem {
                    title: label; checkable: true; checked: root.video-crop-menu-index == index;
                    activated => { root.set-menu-video-crop(index); }
                }
                MenuSeparator {}
                MenuItem { title: "Custom…"; checkable: true; checked: root.video-crop-menu-index == 10;
                    activated => { root.set-menu-video-crop(10); } }
            }
            Menu { title: "Rotation"; enabled: root.loaded && root.video-rotation-known && !root.crop-editing;
                MenuItem { title: "0°"; checkable: true; checked: root.video-rotation-index == 0;
                    activated => { root.set-menu-video-rotation(0); } }
                MenuItem { title: "90°"; checkable: true; checked: root.video-rotation-index == 1;
                    activated => { root.set-menu-video-rotation(90); } }
                MenuItem { title: "180°"; checkable: true; checked: root.video-rotation-index == 2;
                    activated => { root.set-menu-video-rotation(180); } }
                MenuItem { title: "270°"; checkable: true; checked: root.video-rotation-index == 3;
                    activated => { root.set-menu-video-rotation(270); } }
            }
            Menu { title: "Flip"; enabled: root.loaded && root.reflection-known && !root.crop-editing;
                MenuItem { title: "Horizontal (Mirror)"; checkable: true; checked: root.video-mirrored;
                    activated => { root.toggle-video-reflection(true); } }
                MenuItem { title: "Vertical (Flip)"; checkable: true; checked: root.video-flipped;
                    activated => { root.toggle-video-reflection(false); } }
            }
            MenuItem { title: "Deinterlace"; checkable: true; checked: root.deinterlace-enabled;
                enabled: root.loaded && root.deinterlace-known && !root.crop-editing;
                activated => { root.toggle-deinterlace(); } }
            MenuItem { title: "Fit Window to Video";
                enabled: root.loaded && root.video-display-aspect-ratio > 0 && !root.crop-editing;
                activated => { root.fit-window-to-video(); } }
            MenuItem { title: "Lock Window Aspect Ratio"; checkable: true;
                checked: !root.unlock-window-aspect-ratio; enabled: !root.crop-editing;
                activated => { root.unlock-window-aspect-ratio = !root.unlock-window-aspect-ratio; } }
            MenuItem { title: root.fullscreen ? "Exit Full Screen" : "Enter Full Screen";
                checkable: true; checked: root.fullscreen; enabled: !root.crop-editing;
                activated => { root.toggle-fullscreen(); } }
            MenuItem { title: "Float on Top"; checkable: true;
                checked: root.always-float-on-top; enabled: !root.crop-editing;
                activated => { root.always-float-on-top = !root.always-float-on-top; } }
        }
        Menu { title: "Audio";
            MenuItem { title: root.muted ? "Unmute" : "Mute";
                enabled: root.loaded && !root.crop-editing;
                activated => { root.toggle-mute(); } }
            MenuSeparator {}
            for row in root.audio-tracks : MenuItem {
                title: row.label; checkable: true; checked: row.selected;
                enabled: root.loaded && !root.crop-editing;
                activated => { root.select-item(1, row.token); }
            }
            MenuSeparator {}
            MenuItem { title: "Show Audio Panel"; enabled: !root.crop-editing;
                activated => { root.toggle-settings-pane(1); } }
        }
        Menu { title: "Subtitles";
            MenuItem { title: root.subtitle-visible ? "Hide Subtitles" : "Show Subtitles";
                checkable: true; checked: root.subtitle-visible;
                enabled: root.loaded && !root.crop-editing;
                activated => { root.toggle-subtitle-visibility(); } }
            MenuItem { title: "Load Subtitle…"; enabled: root.loaded && !root.crop-editing;
                activated => { root.browse-files(2); } }
            MenuSeparator {}
            for row in root.subtitle-tracks : MenuItem {
                title: row.label; checkable: true; checked: row.selected;
                enabled: root.loaded && !root.crop-editing;
                activated => { root.select-item(2, row.token); }
            }
            MenuSeparator {}
            MenuItem { title: "Show Subtitle Panel"; enabled: !root.crop-editing;
                activated => { root.toggle-settings-pane(2); } }
        }
    }
    title: "riina";
    preferred-width: 960px; preferred-height: 600px;
    min-width: music-mode ? 260px : 520px;
    min-height: music-mode ? 72px : 300px;
    // The native VO lives in the owner window; this surface supplies only chrome.
    // Native mode must begin frameless so Winit creates its transparent surface
    // before the owner window is attached. The shared-GL entry point opts out.
    // Start in overlay mode so the native video window can request a genuinely
    // transparent renderer before Slint discovers the conditional native menu.
    // Shared-window entry points opt into their opaque menu surface before show().
    in property <bool> native-video: true;
    in-out property <bool> dialog-open: false;
    in-out property <bool> jump-time-dialog-visible: false;
    in-out property <string> jump-time-draft: "";
    in-out property <string> jump-time-error: "";
    changed jump-time-dialog-visible => {
        root.dialog-open = jump-time-dialog-visible;
        if jump-time-dialog-visible { jump-time-input.focus(); }
    }
    in-out property <int> media-request-generation: 0;
    no-frame: native-video;
    // Native output sits behind this window even while loading or between files.
    background: native-video ? transparent : #111111;
    in property <image> video-frame;
    in property <bool> loaded: false;
    in-out property <bool> hdr-enabled: true;
    in property <bool> hdr-display-active: false;
    in property <bool> hdr-source-detected: false;
    in-out property <bool> live-text-enabled: false;
    in-out property <bool> live-text-available: false;
    in-out property <bool> disable-animations: false;
    in property <duration> osd-fade-duration: disable-animations || !osd-enabled ? 0ms : 500ms;
    in property <[LiveTextRegion]> live-text-regions: [];
    callback copy-live-text(string);
    callback set-hdr-enabled(bool);
    in-out property <bool> music-mode: false;
    in-out property <bool> auto-switch-to-music-mode: true;
    in-out property <bool> music-mode-show-playlist: false;
    in-out property <bool> music-mode-show-album-art: true;
    callback toggle-music-mode();
    callback music-mode-changed();
    callback auto-switch-music-mode-changed(bool);
    changed music-mode => { root.music-mode-changed(); root.video-menu-changed(); }
    changed auto-switch-to-music-mode => { root.auto-switch-music-mode-changed(root.auto-switch-to-music-mode); }
    changed music-mode-show-playlist => { if root.music-mode { root.music-mode-changed(); } }
    changed music-mode-show-album-art => { if root.music-mode { root.music-mode-changed(); } }
    callback renderer-ready();
    changed engine-ready => { if root.engine-ready { root.renderer-ready(); } }
    callback media-opened();
