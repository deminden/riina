                        LayoutChoice { label: "Top"; position: 1; card-width: (parent.width - 12px) / 3; selected: root.osc-position == 1;
                            activated => { root.osc-position = 1; root.layout-settings-changed(); } }
                        LayoutChoice { label: "Bottom"; position: 2; card-width: (parent.width - 12px) / 3; selected: root.osc-position == 2;
