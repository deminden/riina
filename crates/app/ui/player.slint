export struct CatalogRow { token: string, label: string, detail: string, path: string, language: string, selected: bool, playing: bool, network: bool }
export struct RecentMediaRow { title: string, position-label: string }
export struct LiveTextRegion { text: string, x: float, y: float, width: float, height: float }
component SidebarTab inherits FocusScope {
    in property <string> label;
    in property <bool> selected;
    in property <bool> dark-theme: true;
    callback activated();
    height: 30px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { activated(); }
    Rectangle {
        border-radius: 5px;
        background: root.selected ? (root.dark-theme ? #ffffff20 : #00000010) :
            touch.has-hover ? (root.dark-theme ? #ffffff0c : #00000008) : transparent;
        border-width: root.has-focus ? 1px : 0px;
        border-color: #90b7ef;
        Text { text: root.label; color: root.selected ? (root.dark-theme ? #ffffff : #202024) :
                (root.dark-theme ? #bbbbc2 : #505056);
            font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea { clicked => { root.focus(); root.activated(); } }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { activated(); return accept; }
        return reject;
    }
}
component QuickSettingsTab inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> dark-theme: true;
    callback activated();
    width: selected ? 86px : 32px;
    height: 28px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { activated(); }
    Rectangle {
        border-radius: 14px;
        background: root.selected ? (root.dark-theme ? #ffffff20 : #00000012) :
            touch.has-hover ? (root.dark-theme ? #ffffff0c : #00000008) : transparent;
        border-width: root.has-focus ? 1px : 0px;
        border-color: #90b7ef;
        HorizontalLayout {
            padding-left: root.selected ? 9px : 8px;
            padding-right: root.selected ? 9px : 8px;
            spacing: root.selected ? 5px : 0px;
            alignment: center;
            Image { source: root.icon; image-fit: contain; width: 15px; height: 15px;
                colorize: root.dark-theme ? #e3e3e8 : #45454b; }
            if root.selected : Text { text: root.label;
                color: root.dark-theme ? #f2f2f5 : #202024;
                font-size: 11px; font-weight: 600; vertical-alignment: center; }
        }
        touch := TouchArea { clicked => { root.focus(); root.activated(); } }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { activated(); return accept; }
        return reject;
    }
}

export component AboutWindow inherits Window {
    title: "About Riina";
    width: 640px;
    height: 400px;
    background: #f5f5f7;
    in property <string> version-label: "Version";
    in property <string> engine-label: "Checking libmpv version…";
    in property <string> ffmpeg-label: "Checking FFmpeg version…";
    in property <bool> dark-theme: false;
    in-out property <int> selected-tab: 0;
    callback open-license();
    callback open-project();
    callback open-contributors();

    Rectangle {
        background: root.dark-theme ? #242427 : #f5f5f7;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 220px;
                background: root.dark-theme ? #1d1d20 : #ececef;
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    Image {
                        source: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
                        width: 80px;
                        height: 80px;
                        image-fit: contain;
                    }
                    Text { text: "Riina"; font-size: 30px; font-weight: 300;
                        color: root.dark-theme ? #f5f5f7 : #202024; horizontal-alignment: center; }
                    Text { text: root.version-label; font-size: 12px;
                        color: root.dark-theme ? #a3a3a8 : #73737a; horizontal-alignment: center; }
                    Text { text: root.engine-label; font-size: 11px;
                        color: root.dark-theme ? #a3a3a8 : #73737a; horizontal-alignment: center; }
                    Text { text: root.ffmpeg-label; font-size: 10px;
                        color: root.dark-theme ? #a3a3a8 : #73737a; horizontal-alignment: center; }
                    Rectangle { height: 12px; background: transparent; }
                    Button { text: "License"; clicked => { root.selected-tab = 0; } }
                    Button { text: "Contributors"; clicked => { root.selected-tab = 1; } }
                    Button { text: "Credits"; clicked => { root.selected-tab = 2; } }
                }
            }
            Rectangle {
                background: root.dark-theme ? #242427 : #f5f5f7;
                VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    if root.selected-tab == 0 : VerticalLayout {
                        spacing: 14px;
                        Text { text: "License"; font-size: 20px; font-weight: 600;
                            color: root.dark-theme ? #f5f5f7 : #202024; }
                        Text {
                            text: "Original Riina source is MIT-licensed. The combined application package is distributed under GPLv3.";
                            font-size: 13px; color: root.dark-theme ? #d0d0d4 : #4b4b50; wrap: word-wrap;
                        }
                        Button { text: "View License"; clicked => { root.open-license(); } }
                    }
                    if root.selected-tab == 1 : VerticalLayout {
                        spacing: 14px;
                        Text { text: "Contributors"; font-size: 20px; font-weight: 600;
                            color: root.dark-theme ? #f5f5f7 : #202024; }
                        Text {
                            text: "See the project contributor graph for the people and accounts that have contributed to Riina.";
                            font-size: 13px; color: root.dark-theme ? #d0d0d4 : #4b4b50; wrap: word-wrap;
                        }
                        Button { text: "View Contributors"; clicked => { root.open-contributors(); } }
                    }
                    if root.selected-tab == 2 : VerticalLayout {
                        spacing: 14px;
                        Text { text: "Credits"; font-size: 20px; font-weight: 600;
                            color: root.dark-theme ? #f5f5f7 : #202024; }
                        Text {
                            text: "Riina is an independent Rust media player built around libmpv, Slint, and other open-source dependencies.";
                            font-size: 13px; color: root.dark-theme ? #d0d0d4 : #4b4b50; wrap: word-wrap;
                        }
                        Button { text: "Project Website"; clicked => { root.open-project(); } }
                    }
                }
            }
        }
    }
}
component LayoutChoice inherits FocusScope {
    in property <string> label;
    in property <int> position;
    in property <bool> selected;
    in property <bool> dark-theme: true;
    in property <length> card-width;
    callback activated();
    height: 62px;
    width: card-width;
    accessible-role: button;
    accessible-label: label;
    accessible-checked: selected;
    accessible-action-default => { activated(); }
    Rectangle {
        border-radius: 7px;
        border-width: selected ? 2px : root.has-focus ? 1px : 0px;
        border-color: selected || root.has-focus ? #168bff : transparent;
        background: selected ? #168bff18 : touch.has-hover
            ? (root.dark-theme ? #ffffff10 : #0000000a)
            : (root.dark-theme ? #ffffff08 : #00000006);
        VerticalLayout {
            alignment: center; spacing: 5px;
            Rectangle {
                width: 38px; height: 26px; border-radius: 4px;
                border-width: 1px; border-color: #ffffff55; background: #151519;
                Rectangle {
                    x: position == 0 ? parent.width / 2 - 8px : 1px;
                    y: position == 1 ? 1px : position == 0 ? parent.height - 6px : parent.height - 6px;
                    width: position == 0 ? 16px : parent.width - 2px;
                    height: 5px; border-radius: position == 0 ? 3px : 1px;
                    background: selected ? #90b7ef : #aaaab4;
                }
            }
            Text { text: root.label; color: selected ? #ffffff : (root.dark-theme ? #bbbbc2 : #505056);
                font-size: 11px; horizontal-alignment: center; }
        }
        touch := TouchArea { clicked => { root.focus(); root.activated(); } }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { activated(); return accept; }
        return reject;
    }
}
component SidebarSectionTitle inherits Rectangle {
    in property <string> label;
    in property <bool> dark-theme: true;
    height: 18px;
    background: transparent;
    HorizontalLayout {
        spacing: 8px;
        Rectangle { height: 1px; background: root.dark-theme ? #ffffff28 : #00000020;
            horizontal-stretch: 1; }
        Text { text: root.label; color: root.dark-theme ? #bdbdc5 : #707078;
            font-size: 11px; font-weight: 700; vertical-alignment: center; }
        Rectangle { height: 1px; background: root.dark-theme ? #ffffff28 : #00000020;
            horizontal-stretch: 1; }
    }
}
component SidebarPositionToggle inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    in property <bool> leading;
    in property <bool> dark-theme: true;
    callback changed(bool);
    height: 30px;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: leading;
    accessible-action-default => { changed(!leading); }
    HorizontalLayout {
        spacing: 8px;
        if root.icon.width > 0 : Image {
            source: root.icon; image-fit: contain;
            width: 16px; height: 16px;
            colorize: root.dark-theme ? #bdbdc5 : #73737a;
        }
        Text { text: root.label; color: root.dark-theme ? #dddddd : #29292d;
            font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
        Rectangle {
            width: 38px; height: 22px; border-radius: 11px;
            background: root.leading ? #3787ef : (root.dark-theme ? #55555e : #d0d0d4);
            Rectangle {
                x: root.leading ? parent.width - self.width - 2px : 2px;
                y: 2px; width: 18px; height: 18px; border-radius: 9px;
                background: #f5f5f7;
            }
        }
    }
    TouchArea { clicked => { root.changed(!root.leading); } }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { changed(!leading); return accept; }
        return reject;
    }
}
component SidebarSideChoice inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    in property <bool> leading;
    in property <bool> dark-theme: true;
    callback changed(bool);
    height: 30px;
    accessible-role: checkbox;
    accessible-label: label + " on leading side";
    accessible-checkable: true;
    accessible-checked: leading;
    accessible-action-default => { changed(!leading); }
    HorizontalLayout {
        spacing: 8px;
        Image { source: root.icon; image-fit: contain; width: 16px; height: 16px;
            colorize: root.dark-theme ? #bdbdc5 : #73737a; }
        Text { text: root.label; color: root.dark-theme ? #dddddd : #29292d;
            font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
        Rectangle {
            width: 58px; height: 24px; border-radius: 7px;
            background: root.dark-theme ? #ffffff16 : #0000000d;
            HorizontalLayout {
                padding: 2px; spacing: 2px;
                for side in [true, false] : Rectangle {
                    width: 25px; height: 20px; border-radius: 5px;
                    background: (root.leading == side) ? #168bff : transparent;
                    Rectangle {
                        x: 5px; y: 4px; width: 15px; height: 12px;
                        border-radius: 2px; border-width: 1px;
                        border-color: (root.leading == side) ? #ffffffd0 :
                            (root.dark-theme ? #c5c5cc : #77777e);
                        background: transparent;
                        Rectangle {
                            x: side ? 1px : parent.width - 3px;
                            width: 2px; height: parent.height - 2px;
                            background: (root.leading == side) ? #ffffffd0 :
                                (root.dark-theme ? #c5c5cc : #77777e);
                        }
                    }
                    TouchArea { clicked => { root.changed(side); } }
                }
            }
        }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.LeftArrow { changed(true); return accept; }
        if event.text == Key.RightArrow { changed(false); return accept; }
        if event.text == Key.Return || event.text == " " { changed(!leading); return accept; }
        return reject;
    }
}
component SidebarAction inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    callback activated();
    height: 32px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { activated(); } }
    Rectangle {
        border-radius: 5px;
        background: touch.has-hover && root.enabled ? #ffffff18 : #ffffff0a;
        Image { source: root.icon; image-fit: contain; x: 8px; y: 8px;
            width: 16px; height: 16px; colorize: root.enabled ? #dddddd : #777777; }
        Text { x: 32px; width: parent.width - 38px; text: root.label;
            color: root.enabled ? #dddddd : #777777; font-size: 12px; vertical-alignment: center; }
        if root.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef;
            border-radius: 5px; background: transparent; }
        touch := TouchArea { enabled: root.enabled; clicked => { root.focus(); root.activated(); } }
    }
    key-pressed(event) => {
        if event.modifiers.alt || event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return || event.text == " " { if root.enabled { activated(); } return accept; }
        return reject;
    }
}
component Tool inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> dark-theme: true;
    in property <bool> selected: false;
    callback activated();
    width: 30px; height: 28px;
    border-radius: 5px;
    background: selected ? (dark-theme ? #90b7ef24 : #168bff18) :
        touch.has-hover && enabled ? (dark-theme ? #ffffff20 : #00000014) : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { activated(); } }
    if icon.width == 0 : Text { text: label; color: !enabled ? #777777 : selected ? #90b7ef : (dark-theme ? #eeeeee : #29292d); font-size: 17px;
        horizontal-alignment: center; vertical-alignment: center; }
    if icon.width > 0 : Image {
        source: icon; image-fit: contain;
        width: min(17px, root.width); height: min(17px, root.height);
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        colorize: !enabled ? #777777 : selected ? #90b7ef : (dark-theme ? #eeeeee : #29292d);
    }
    if focus.has-focus : Rectangle {
        border-width: 1px; border-color: #90b7ef; border-radius: 5px; background: transparent;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activated(); return accept;
            }
            return reject;
        }
    }
    // Keep pointer activation above the focus helper in Slint's stacking order;
    // otherwise a mouse press can focus a toolbar item without activating it.
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activated(); } }
}

component ToolbarAction inherits Rectangle {
    in property <int> kind;
    in property <bool> dark-theme: true;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <string> hint;
    callback activated(int);
    width: 30px; height: 17px;
    Tool {
        width: parent.width; height: parent.height;
        dark-theme: root.dark-theme; enabled: root.enabled; selected: root.selected;
        hint: root.hint;
        icon: root.kind == 0 ? @image-url("../../../assets/icons/settings.svg") :
            root.kind == 1 ? @image-url("../../../assets/icons/playlist.svg") :
            root.kind == 2 ? @image-url("../../../assets/icons/pip.svg") :
            root.kind == 3 ? @image-url("../../../assets/icons/fullscreen.svg") :
            root.kind == 4 ? @image-url("../../../assets/icons/audio.svg") :
            root.kind == 5 ? @image-url("../../../assets/icons/subtitles-page.svg") :
            root.kind == 6 ? @image-url("../../../assets/icons/photo.svg") :
            root.kind == 7 ? @image-url("../../../assets/icons/plugins.svg") :
            @image-url("../../../assets/icons/video-page.svg");
        activated => { root.activated(root.kind); }
    }
}

component JumpDialogButton inherits FocusScope {
    in property <string> label;
    in property <bool> dark-theme: true;
    callback activated();
    width: 68px; height: 26px;
    accessible-role: button;
    accessible-label: label;
    Rectangle {
        width: parent.width; height: parent.height; border-radius: 5px;
        border-width: 1px; border-color: root.has-focus ? #6094dc : (root.dark-theme ? #62626a : #c7c7cc);
        background: root.has-focus ? (root.dark-theme ? #ffffff1b : #168bff16) :
            (root.dark-theme ? #3a3a40 : #ffffff);
        Text { text: root.label; width: parent.width; height: parent.height;
            color: root.dark-theme ? #f0f0f2 : #29292d; font-size: 12px;
            horizontal-alignment: center; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.focus(); root.activated(); } }
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
        return reject;
    }
}

component PlaylistSortButton inherits Rectangle {
    in property <bool> dark-theme: true;
    callback sort-requested(int);
    width: 30px; height: 28px; background: transparent;
    Tool { dark-theme: root.dark-theme; icon: @image-url("../../../assets/icons/sort.svg"); hint: "Sort playlist";
        activated => { choices.show(); } }
    choices := PopupWindow {
        x: 0px; y: -self.height; width: 190px; height: 146px;
        close-policy: close-on-click-outside;
        Rectangle { background: root.dark-theme ? #29292e : #f8f8fa;
            border-width: 1px; border-color: root.dark-theme ? #ffffff38 : #b8b8bc; border-radius: 6px;
            VerticalLayout { padding: 6px; spacing: 1px;
                Text { text: "Sorting"; height: 22px; x: 7px; color: root.dark-theme ? #a9a9b1 : #77777d; font-size: 11px; vertical-alignment: center; }
                for label[index] in ["Filename Ascending", "Filename Descending", "File Path Ascending", "File Path Descending"] : Rectangle {
                    height: 27px; border-radius: 4px;
                    background: row-touch.has-hover ? (root.dark-theme ? #ffffff20 : #00000012) : transparent;
                    accessible-role: button; accessible-label: label;
                    accessible-action-default => { root.sort-requested(index); choices.close(); }
                    Text { x: 8px; width: parent.width - 16px; text: label; font-size: 11px;
                        color: root.dark-theme ? #eeeeee : #29292d; vertical-alignment: center; }
                    row-touch := TouchArea { clicked => { root.sort-requested(index); choices.close(); } }
                }
            }
        }
    }
}

component TopmostPin inherits Rectangle {
    in property <bool> pinned;
    in property <bool> dark-theme: true;
    callback changed(bool);
    width: 30px;
    height: 28px;
    background: transparent;
    Tool {
        dark-theme: root.dark-theme;
        icon: root.pinned
            ? @image-url("../../../assets/icons/pin-fill.svg")
            : @image-url("../../../assets/icons/pin.svg");
        hint: root.pinned ? "Remove float on top" : "Float on top";
        activated => { root.changed(!root.pinned); }
    }
}

component ObservedSizePicker inherits ComboBox {
    in property <int> observed-index: -1;
    in property <string> observed-value;
    current-index: observed-index;
    current-value: observed-value;
    // Popup selection mutates its own properties. Native observations must
    // restore both display text and keyboard cursor after those bindings break.
    changed observed-value => { self.current-value = self.observed-value; self.current-index = self.observed-index; }
    changed observed-index => { self.current-index = self.observed-index; }
}

component DelayInput inherits Rectangle {
    in property <float> value;
    in property <string> formatted-value: "0";
    in property <bool> secondary: false;
    in property <bool> enabled: true;
    in property <string> hint;
    callback committed(string);
    width: 50px; height: 24px;
    border-radius: 4px; background: #ffffff10;
    border-width: 1px; border-color: input.has-focus ? #90b7ef : #ffffff20;
    // Editing breaks TextInput's text binding; native updates and lane changes
    // must explicitly restore the observed value rather than retaining a draft.
    changed value => { input.text = root.formatted-value; }
    changed formatted-value => { input.text = root.formatted-value; }
    changed secondary => { input.text = root.formatted-value; }
    input := TextInput {
        x: 6px; width: parent.width - 12px; height: parent.height;
        text: "" + root.value;
        enabled: root.enabled;
        font-size: 12px; color: root.enabled ? #eeeeee : #777777;
        vertical-alignment: center;
        single-line: true;
        accessible-label: root.hint;
        accepted => { root.committed(self.text); }
    }
}

component SubtitleLaneSegment inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> selected;
    callback activated();
    height: 24px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: selected ? #ffffff28 : touch.has-hover ? #ffffff10 : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { activated(); }
    Text { text: label; font-size: 12px; color: #eeeeee;
        horizontal-alignment: center; vertical-alignment: center; }
    if focus.has-focus : Rectangle { border-width: 1px; border-color: #90b7ef;
        border-radius: 4px; background: transparent; }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        key-pressed(event) => {
            // Lane choice is idempotent; modified player shortcuts still bubble.
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

component WelcomeAction inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> enabled: true;
    callback activated();
    width: 112px; height: 36px; border-radius: 5px;
    background: !enabled ? #ffffff08 : touch.has-hover ? #ffffff24 : #ffffff18;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: #8ab7f0;
    accessible-role: button;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { activated(); } }
    Text { text: root.label; color: root.enabled ? #f1f1f4 : #77777f;
        font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.activated(); }
    }
    focus := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

component RecentMediaEntry inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> prominent: false;
    in property <bool> selected: false;
    callback activated();
    height: 28px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: touch.has-hover ? #ffffff14 : selected ? #ffffff18 : prominent ? #ffffff0c : transparent;
    accessible-role: button;
    accessible-label: detail == "" ? label : label + ", " + detail;
    accessible-action-default => { activated(); }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        Text { text: root.label; color: #dedee4; font-size: 12px;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.detail; color: #92929a; font-size: 11px;
            vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

// The reference gives Resume its own action row above the document table.
// Keeping title and time separate preserves its truncation and alignment rules.
component ResumeMediaEntry inherits Rectangle {
    in property <string> media-title;
    in property <string> position-label;
    in property <bool> selected: false;
    callback activated();
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: selected ? #ffffff28 : touch.has-hover ? #ffffff10 : #ffffff0c;
    accessible-role: button;
    accessible-label: "Resume " + root.media-title + ", " + root.position-label;
    accessible-action-default => { root.activated(); }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px;
        Image { source: @image-url("../../../assets/icons/resume-history.svg");
            width: 16px; height: 16px; }
        Text { text: "Resume"; color: #dedee4; font-size: 12px;
            vertical-alignment: center; }
        Text { text: root.media-title; color: #dedee4; font-size: 12px;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: root.position-label; color: #92929a; font-size: 11px;
            vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
}

export component WelcomeWindow inherits Window {
    title: "Riina";
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    // Match IINA v1.5.0's fixed 560 x 440 point welcome window.
    preferred-width: 560px; preferred-height: 440px;
    min-width: 560px; min-height: 440px;
    max-width: 560px; max-height: 440px;
    background: #17171b;
    in property <string> app-version: "0.2.1";
    in-out property <string> url-draft;
    in-out property <bool> url-entry-visible: false;
    in property <string> url-error;
    in property <[RecentMediaRow]> recent-media;
    in property <[RecentMediaRow]> recent-documents;
    in property <int> recent-document-offset: 1;
    in-out property <int> selection-index: -1;
    callback open-file();
    callback open-url(string);
    callback open-recent(int);

    keys := FocusScope {
        width: root.width; height: root.height;
        Rectangle {
            width: parent.width; height: parent.height; background: #17171b;
            VerticalLayout {
                padding-left: 30px; padding-right: 30px;
                padding-top: 48px; padding-bottom: 24px; spacing: 0px;
            HorizontalLayout {
                alignment: start; spacing: 14px; height: 76px;
                Image {
                    width: 68px; height: 68px;
                    source: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
                    image-fit: contain;
                    accessible-label: "Riina";
                }
                VerticalLayout {
                    alignment: center; spacing: 3px;
                    Text { text: "Riina"; color: #f4f4f6; font-size: 20px; font-weight: 700; }
                    Text { text: "Version " + root.app-version; color: #a6a6ad; font-size: 11px; }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    alignment: center; spacing: 12px;
                    WelcomeAction { label: "Open File…"; hint: "Open a media file";
                        activated => { root.open-file(); } }
                    WelcomeAction { label: "Open URL…"; hint: "Open media from a URL";
                        activated => { root.url-entry-visible = !root.url-entry-visible; } }
                }
            }
            Rectangle { height: 16px; }
            if root.url-entry-visible : VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px; height: 36px;
                    Rectangle { horizontal-stretch: 1; height: 36px; border-radius: 5px;
                        background: #232329; border-width: 1px;
                        border-color: url-input.has-focus ? #6195d8 : #ffffff24;
                        url-input := TextInput { x: 10px; width: parent.width - 20px; height: parent.height;
                            text <=> root.url-draft; single-line: true;
                            font-size: 12px; color: #f0f0f3;
                            accessible-label: "Media URL";
                            accepted => { root.open-url(self.text); } }
                        if root.url-draft.is-empty && !url-input.has-focus : Text {
                            x: 10px; y: 0px; width: parent.width - 20px; height: parent.height;
                            text: "https://"; font-size: 12px; color: #85858d;
                            vertical-alignment: center;
                        }
                    }
                    WelcomeAction { label: "Open"; hint: "Open this URL";
                        activated => { root.open-url(root.url-draft); } }
                }
                if root.url-error != "" : Text {
                    text: root.url-error; color: #ed9389; font-size: 11px;
                }
            }
            Rectangle { height: 16px; }
            if root.recent-media.length > 0 : VerticalLayout {
                spacing: 2px; vertical-stretch: 1;
                ResumeMediaEntry {
                    media-title: root.recent-media[0].title;
                    position-label: root.recent-media[0].position-label;
                    selected: root.selection-index < 0;
                    activated => { root.selection-index = -1; root.open-recent(0); }
                }
                if root.recent-documents.length > 0 : ScrollView {
                    horizontal-stretch: 1; vertical-stretch: 1;
                    VerticalLayout { spacing: 1px;
                        for row[index] in root.recent-documents : RecentMediaEntry {
                            label: row.title; detail: row.position-label;
                            selected: root.selection-index == index;
                            activated => { root.selection-index = index; root.open-recent(index + root.recent-document-offset); }
                        }
                    }
                }
            }
        }
        }
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.DownArrow {
                if root.selection-index < root.recent-documents.length - 1 {
                    root.selection-index += 1;
                }
                return accept;
            }
            if event.text == Key.UpArrow {
                if root.selection-index > 0 {
                    root.selection-index -= 1;
                } else if root.selection-index == 0 && root.recent-media.length > 0 {
                    root.selection-index = -1;
                }
                return accept;
            }
            if event.text == Key.Return {
                if root.recent-media.length > 0 || root.recent-documents.length > 0 {
                    root.open-recent(root.selection-index < 0 && root.recent-media.length > 0
                        ? 0 : root.selection-index + root.recent-document-offset);
                }
                return accept;
            }
            return reject;
        }
    }
}

export component PlayerWindow inherits Window {
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    in property <bool> reflection-known: false;
    in property <bool> deinterlace-known: false;
    in property <bool> deinterlace-enabled: false;
    callback toggle-deinterlace();
    in property <bool> screenshot-available: false;
    callback take-screenshot();
    callback open-screenshot-folder();
    changed screenshot-available => { root.video-menu-changed(); }
    changed deinterlace-known => { root.video-menu-changed(); }
    changed deinterlace-enabled => { root.video-menu-changed(); }
    in-out property <bool> video-osd-request-feedback: false;
    in-out property <bool> scroll-input-suppressed: false;
    in property <bool> video-mirrored: false;
    in property <bool> video-flipped: false;
    callback toggle-video-reflection(bool);
    callback video-menu-changed();
    in property <[MenuShortcutRow]> menu-shortcuts: [];
    changed menu-shortcuts => { root.video-menu-changed(); }
    changed key-binding-current-profile => { root.video-menu-changed(); }
    function menu-shortcut(index: int) -> keys {
        if index < 0 || index >= root.menu-shortcuts.length { return @keys(); }
        return root.menu-shortcuts[index].shortcut;
    }
    callback window-title-changed(string);
    callback open-application-menu();
    callback open-preferences();
    in-out property <int> preferences-target-pane: -1;
    callback reload-plugins();
    callback activate-plugin-menu-item(string);
    callback plugin-menu-will-open();
    callback find-online-subtitles();
    callback find-online-subtitles-with-provider(int);
    callback native-menu-will-open();
    changed reflection-known => { root.video-menu-changed(); }
    changed video-mirrored => { root.video-menu-changed(); }
    changed video-flipped => { root.video-menu-changed(); }
    callback crop-window-controls-changed();
    changed crop-editing => { root.video-menu-changed(); root.crop-window-controls-changed(); root.refresh-fullscreen-info(); }

    if !native-video : MenuBar {
        Menu { title: "riina";
            MenuItem { title: "About Riina"; activated => { root.show-about(); } }
            MenuItem { title: "Check for Updates…"; enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Preferences…"; enabled: !root.crop-editing;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + ",") : @keys(Control + ",");
                activated => { root.open-preferences(); } }
            MenuSeparator {}
            MenuItem { title: "Services"; enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Hide Riina"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + H) : @keys(Control + H); }
            MenuItem { title: "Quit Riina";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Q) : @keys(Control + Q);
                activated => { root.quit-riina(); }
            }
        }
        Menu { title: "File";
            MenuItem { title: "Open…"; enabled: !root.crop-editing;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + O) : @keys(Control + O);
                activated => { root.open-file(); } }
            MenuItem { title: "Open in New Window…"; enabled: !root.crop-editing;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Alt + O) : @keys(Control + Alt + O);
                activated => { root.open-in-new-window(); } }
            MenuItem { title: "Open URL…"; enabled: !root.crop-editing;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + O) : @keys(Control + Shift + O);
                activated => { root.open-url-dialog(); } }
            if root.record-recent-files : Menu {
                title: "Open Recent";
                enabled: root.recent-open-menu-rows.length > 0;
                for row in root.recent-open-menu-rows : MenuItem {
                    title: row.label;
                    activated => { root.open-recent-path(row.token); }
                }
                MenuSeparator {}
                MenuItem { title: "Clear Menu"; enabled: root.recent-open-menu-rows.length > 0;
                    activated => { root.clear-open-recent(); } }
            }
            MenuSeparator {}
            MenuItem { title: "Playback History";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + H) : @keys(Control + Shift + H);
                activated => { root.show-playback-history(); } }
            MenuSeparator {}
            MenuItem {
                title: "Show Current File in " + root.current-file-manager-name;
                enabled: root.reveal-current-media-available;
                activated => { root.reveal-current-media(); } }
            MenuItem { title: "Delete Current File";
                enabled: root.delete-current-media-available;
                activated => { root.delete-current-media(); } }
            MenuItem { title: "Save Current Playlist…";
                enabled: root.save-current-playlist-available;
                activated => { root.save-current-playlist(); } }
            MenuSeparator {}
            MenuItem { title: "Close";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + W) : @keys(Control + W);
                activated => { root.close-player(); } }
        }
        Menu { title: "Edit";
            MenuItem { title: "Undo"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Z) : @keys(Control + Z); }
            MenuItem { title: "Redo"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + Z) : @keys(Control + Shift + Z); }
            MenuSeparator {}
            MenuItem { title: "Cut"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + X) : @keys(Control + X); }
            MenuItem { title: "Copy"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + C) : @keys(Control + C); }
            MenuItem { title: "Paste"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + V) : @keys(Control + V); }
            MenuItem { title: "Select All"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + A) : @keys(Control + A); }
        }
        Menu { title: "Playback";
            MenuItem { title: root.paused ? "Resume" : "Pause";
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(0);
                activated => { root.toggle-pause(); } }
            MenuItem { title: "Stop and Clear Playlists"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(1);
                activated => { root.stop(); } }
            MenuSeparator {}
            MenuItem { title: root.menu-alternates-visible ? "Next Frame" : "Step Forward 5s";
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 4 : 2);
                activated => { if root.menu-alternates-visible { root.frame-step(); } else { root.seek-relative(5); } } }
            MenuItem { title: root.menu-alternates-visible ? "Previous Frame" : "Step Backward 5s";
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 5 : 3);
                activated => { if root.menu-alternates-visible { root.frame-back-step(); } else { root.seek-relative(-5); } } }
            MenuItem { title: "Jump to Beginning"; enabled: root.loaded && !root.crop-editing;
                activated => { root.seek(0); } }
            MenuItem { title: "Jump to…"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + J) : @keys(Control + J);
                activated => { root.open-jump-time-dialog(); } }
            MenuSeparator {}
            MenuItem { title: "Speed: " + root.speed-edit-value + "x"; enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? "Speed Up by 1.1x" : "Speed Up by 2x";
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 9 : 7);
                activated => { root.speed(root.menu-alternates-visible ? 1.1 : 2); } }
            MenuItem { title: root.menu-alternates-visible ? "Speed Down by 0.9x" : "Speed Down by 0.5x";
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 10 : 8);
                activated => { root.speed(root.menu-alternates-visible ? 0.9 : 0.5); } }
            MenuItem { title: "Reset Speed"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(6);
                activated => { root.reset-speed(); } }
            MenuSeparator {}
            MenuItem { title: "Take a Screenshot"; enabled: root.screenshot-available && !root.crop-editing;
                shortcut: root.menu-shortcut(11);
                activated => { root.take-screenshot(); } }
            MenuItem { title: "Go to Screenshot Folder"; enabled: !root.crop-editing;
                activated => { root.open-screenshot-folder(); } }
            MenuSeparator {}
            MenuItem { title: "A-B Loop"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(46);
                activated => { root.cycle-ab-loop(); } }
            MenuItem { title: "File Loop"; checkable: true; checked: root.loop-label == "File";
                enabled: root.loaded && !root.crop-editing;
                activated => { root.toggle-file-loop(); } }
            MenuSeparator {}
            MenuItem { title: "Show Playlist Panel"; enabled: !root.crop-editing;
                shortcut: root.menu-shortcut(12);
                activated => { root.toggle-playlist-pane(4); } }
            MenuItem { title: "Playlist Loop"; checkable: true; checked: root.loop-label == "Playlist";
                enabled: root.loaded && !root.crop-editing;
                activated => { root.playlist-action(5, ""); } }
            Menu { title: "Playlist"; enabled: root.loaded && root.playlist.length > 0 && !root.crop-editing;
                for row in root.playlist : MenuItem {
                    title: row.label; checkable: true; checked: row.playing;
                    activated => { root.playlist-action(12, row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Next Media"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(13);
                activated => { root.playlist-next(); } }
            MenuItem { title: "Previous Media"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(14);
                activated => { root.playlist-previous(); } }
            MenuItem { title: "Show Chapters Panel"; enabled: !root.crop-editing;
                shortcut: root.menu-shortcut(15);
                activated => { root.toggle-playlist-pane(3); } }
            Menu { title: "Chapters"; enabled: root.loaded && root.chapters.length > 0 && !root.crop-editing;
                for row in root.chapters : MenuItem {
                    title: row.label;
                    checkable: true; checked: row.selected;
                    activated => { root.select-item(3, row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Next Chapter"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(16);
                activated => { root.adjust-chapter(1); } }
            MenuItem { title: "Previous Chapter"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(17);
                activated => { root.adjust-chapter(-1); } }
        }
        Menu { title: "Video";
            MenuItem { title: (root.settings-at-leading ? root.leading-sidebar == 6 : root.sidebar == 6) ? "Hide Video Panel" : "Show Video Panel"; enabled: !root.crop-editing;
                shortcut: root.menu-shortcut(18);
                activated => { root.toggle-settings-pane(6); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Video Tracks"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(19);
                activated => { root.cycle-video-track(); } }
            Menu { title: "Video Track"; enabled: root.loaded && !root.crop-editing;
                for row in root.video-tracks : MenuItem {
                    title: row.label;
                    checkable: true; checked: row.selected;
                    activated => { root.select-item(6, row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Half Size"; enabled: root.loaded && root.video-window-width > 0
                    && root.video-window-height > 0 && !root.music-mode && !root.crop-editing;
                shortcut: root.menu-shortcut(20);
                activated => { root.resize-window-command(0); } }
            MenuItem { title: "Normal Size"; enabled: root.loaded && root.video-window-width > 0
                    && root.video-window-height > 0 && !root.music-mode && !root.crop-editing;
                shortcut: root.menu-shortcut(21);
                activated => { root.resize-window-command(1); } }
            MenuItem { title: "Double Size"; enabled: root.loaded && root.video-window-width > 0
                    && root.video-window-height > 0 && !root.music-mode && !root.crop-editing;
                shortcut: root.menu-shortcut(22);
                activated => { root.resize-window-command(2); } }
            MenuItem { title: "Fit to Screen"; enabled: !root.crop-editing;
                shortcut: root.menu-shortcut(23);
                activated => { root.resize-window-command(3); } }
            MenuSeparator {}
            MenuItem { title: "Bigger Size"; enabled: root.loaded && root.video-window-width > 0
                    && root.video-window-height > 0 && !root.music-mode && !root.crop-editing;
                shortcut: root.menu-shortcut(24);
                activated => { root.resize-window-command(4); } }
            MenuItem { title: "Smaller Size"; enabled: root.loaded && root.video-window-width > 0
                    && root.video-window-height > 0 && !root.music-mode && !root.crop-editing;
                shortcut: root.menu-shortcut(25);
                activated => { root.resize-window-command(5); } }
            MenuSeparator {}
            MenuItem { title: root.picture-in-picture-active ? "Exit Picture in Picture" : "Enter Picture in Picture";
                enabled: root.picture-in-picture-active || root.picture-in-picture-available;
                shortcut: root.menu-shortcut(26);
                activated => { root.toggle-picture-in-picture(); } }
            MenuItem { title: root.fullscreen ? "Exit Full Screen" : "Enter Full Screen";
                checkable: true; checked: root.fullscreen; enabled: !root.crop-editing;
                shortcut: root.menu-shortcut(27);
                activated => { root.toggle-fullscreen(); } }
            MenuItem { title: "Float on Top"; checkable: true;
                checked: root.always-float-on-top; enabled: !root.crop-editing;
                shortcut: root.menu-shortcut(28);
                activated => { root.always-float-on-top = !root.always-float-on-top; } }
            MenuItem { title: "Lock Window Aspect Ratio"; checkable: true;
                checked: !root.unlock-window-aspect-ratio; enabled: !root.crop-editing;
                activated => { root.unlock-window-aspect-ratio = !root.unlock-window-aspect-ratio; } }
            MenuItem { title: "Live Text";
                checkable: true; checked: root.live-text-enabled;
                enabled: root.live-text-available && !root.crop-editing;
                shortcut: root.menu-shortcut(29);
                activated => { root.toggle-live-text(); } }
            MenuSeparator {}
            MenuItem { title: root.music-mode ? "Exit Music Mode" : "Enter Music Mode";
                checkable: true; checked: root.music-mode;
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(30);
                activated => { root.toggle-music-mode(); } }
            MenuSeparator {}
            Menu { title: "Aspect Ratio"; enabled: root.loaded && root.video-aspect-known && !root.crop-editing;
                for label[index] in root.video-aspect-menu-labels : MenuItem {
                    title: label; checkable: true; checked: root.video-aspect-menu-index == index;
                    activated => { root.set-menu-video-aspect(index); }
                }
            }
            Menu { title: "Crop"; enabled: root.loaded && root.video-crop-known && !root.crop-editing;
                for label[index] in root.video-crop-menu-labels : MenuItem {
                    title: label; checkable: true; checked: root.video-crop-menu-index == index;
                    activated => { root.set-menu-video-crop(index); }
                }
                MenuSeparator {}
                MenuItem { title: "Custom…"; checkable: true; checked: root.video-crop-menu-index == 10;
                    activated => { root.set-menu-video-crop(10); } }
            }
            Menu { title: "Rotation"; enabled: root.loaded && root.video-rotation-known && !root.crop-editing;
                MenuItem { title: "0°"; checkable: true; checked: root.video-rotation-index == 0;
                    activated => { root.set-menu-video-rotation(0); } }
                MenuItem { title: "90°"; checkable: true; checked: root.video-rotation-index == 1;
                    activated => { root.set-menu-video-rotation(90); } }
                MenuItem { title: "180°"; checkable: true; checked: root.video-rotation-index == 2;
                    activated => { root.set-menu-video-rotation(180); } }
                MenuItem { title: "270°"; checkable: true; checked: root.video-rotation-index == 3;
                    activated => { root.set-menu-video-rotation(270); } }
            }
            Menu { title: "Flip"; enabled: root.loaded && root.reflection-known && !root.crop-editing;
                MenuItem { title: "Horizontal (Mirror)"; checkable: true; checked: root.video-mirrored;
                    activated => { root.toggle-video-reflection(true); } }
                MenuItem { title: "Vertical (Flip)"; checkable: true; checked: root.video-flipped;
                    activated => { root.toggle-video-reflection(false); } }
            }
            MenuItem { title: "Deinterlace"; checkable: true; checked: root.deinterlace-enabled;
                enabled: root.loaded && root.deinterlace-known && !root.crop-editing;
                activated => { root.toggle-deinterlace(); } }
            MenuItem { title: "Delogo"; checkable: true; checked: root.delogo-active;
                enabled: root.delogo-enabled && !root.crop-editing;
                activated => { root.toggle-delogo(); } }
            MenuSeparator {}
            MenuItem { title: "Video Filters…"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + F) : @keys(Control + Shift + F);
                activated => { root.open-video-filters(); } }
            Menu { title: "Saved Video Filters"; enabled: root.loaded && !root.crop-editing;
                for row in root.saved-video-filter-rows : MenuItem {
                    title: row.label + (row.shortcut-label.is-empty ? "" : "    " + row.shortcut-label);
                    checkable: true; checked: row.selected;
                    activated => { root.toggle-saved-video-filter(row.token); }
                }
            }
        }
        Menu { title: "Audio";
            MenuItem { title: (root.settings-at-leading ? root.leading-sidebar == 1 : root.sidebar == 1) ? "Hide Audio Panel" : "Show Audio Panel"; enabled: !root.crop-editing;
                shortcut: root.menu-shortcut(31);
                activated => { root.toggle-settings-pane(1); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Audio Tracks"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(32);
                activated => { root.cycle-audio-track(); } }
            Menu { title: "Audio Track"; enabled: root.loaded && !root.crop-editing;
                for row in root.audio-tracks : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-item(1, row.token); }
                }
            }
            MenuItem { title: "Load External Audio…"; enabled: root.loaded && !root.crop-editing;
                activated => { root.browse-files(1); } }
            MenuSeparator {}
            MenuItem { title: root.volume-menu-title; enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? "Volume + 1%" : "Volume + 5%";
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 35 : 33);
                activated => { root.adjust-volume(root.menu-alternates-visible ? 1 : 5); } }
            MenuItem { title: root.menu-alternates-visible ? "Volume - 1%" : "Volume - 5%";
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 36 : 34);
                activated => { root.adjust-volume(root.menu-alternates-visible ? -1 : -5); } }
            MenuItem { title: "Mute"; checkable: true; checked: root.muted;
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(37);
                activated => { root.toggle-mute(); } }
            MenuSeparator {}
            MenuItem { title: "Audio Delay: " + root.audio-delay-text + "s"; enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? "Audio Delay + 0.1s" : "Audio Delay + 0.5s";
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 40 : 38);
                activated => { root.adjust-audio-delay(root.menu-alternates-visible ? 0.1 : 0.5); } }
            MenuItem { title: root.menu-alternates-visible ? "Audio Delay - 0.1s" : "Audio Delay - 0.5s";
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 41 : 39);
                activated => { root.adjust-audio-delay(root.menu-alternates-visible ? -0.1 : -0.5); } }
            MenuItem { title: "Reset Audio Delay"; enabled: root.loaded && !root.crop-editing;
                activated => { root.reset-audio-delay(); } }
            MenuSeparator {}
            Menu { title: "Audio Device";
                enabled: root.loaded && !root.crop-editing && root.audio-device-menu-rows.length > 0;
                for row in root.audio-device-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.set-audio-device(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Audio Filters…"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + G) : @keys(Control + Shift + G);
                activated => { root.open-audio-filters(); } }
            Menu { title: "Saved Audio Filters"; enabled: root.loaded && !root.crop-editing;
                for row in root.saved-audio-filter-rows : MenuItem {
                    title: row.label + (row.shortcut-label.is-empty ? "" : "    " + row.shortcut-label);
                    checkable: true; checked: row.selected;
                    activated => { root.toggle-saved-audio-filter(row.token); }
                }
            }
        }
        Menu { title: "Subtitles";
            MenuItem { title: (root.settings-at-leading ? root.leading-sidebar == 2 : root.sidebar == 2) ? "Hide Subtitles Panel" : "Show Subtitles Panel"; enabled: !root.crop-editing;
                shortcut: root.menu-shortcut(42);
                activated => { root.toggle-settings-pane(2); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Subtitles"; enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(43);
                activated => { root.cycle-subtitle-track(); } }
            Menu { title: "Subtitle"; enabled: root.loaded && !root.crop-editing;
                for row in root.subtitle-tracks : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-item(2, row.token); }
                }
            }
            MenuItem { title: root.subtitle-visible ? "Hide Subtitles" : "Show Subtitles";
                checkable: true; checked: root.subtitle-visible;
                enabled: root.loaded && !root.crop-editing;
                shortcut: root.menu-shortcut(44);
                activated => { root.toggle-subtitle-visibility(); } }
            Menu { title: "Secondary Subtitle"; enabled: root.loaded && !root.crop-editing;
                for row in root.secondary-subtitle-tracks : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-item(5, row.token); }
                }
            }
            MenuItem { title: root.secondary-subtitle-visible ? "Hide Secondary Subtitles" : "Show Secondary Subtitles";
                checkable: true; checked: root.secondary-subtitle-visible;
                enabled: root.loaded && root.secondary-subtitle-visibility-known && !root.crop-editing;
                activated => { root.toggle-secondary-subtitle-visibility(); }
            }
            MenuItem { title: "Load External Subtitle…"; enabled: root.loaded && !root.crop-editing;
                activated => { root.browse-files(2); } }
            MenuSeparator {}
            MenuItem { title: root.open-subtitles-provider-index == 1 ? "Find Online Subtitles from assrt.net" : root.open-subtitles-provider-index == 2 ? "Find Online Subtitles from shooter.cn" : "Find Online Subtitles from opensubtitles.com"; enabled: root.loaded && !root.crop-editing;
                activated => { root.find-online-subtitles(); } }
            Menu { title: "Find Online Subtitles from"; enabled: root.loaded && !root.crop-editing;
                MenuItem { title: "opensubtitles.com"; activated => { root.find-online-subtitles-with-provider(0); } }
                MenuItem { title: "assrt.net"; activated => { root.find-online-subtitles-with-provider(1); } }
                MenuItem { title: "shooter.cn"; activated => { root.find-online-subtitles-with-provider(2); } }
            }
            MenuItem { title: "Save Downloaded Subtitle…";
                enabled: root.downloaded-subtitle-save-available && !root.crop-editing;
                activated => { root.save-downloaded-subtitle(); }
            }
            MenuSeparator {}
            Menu { title: "Encoding"; enabled: root.loaded && !root.crop-editing;
                for row in root.subtitle-encoding-options : MenuItem {
                    title: row.label; checkable: true;
                    checked: root.subtitle-default-encoding == row.token;
                    activated => { root.set-subtitle-encoding(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Scale Up"; enabled: root.loaded && root.subtitle-scale-known && !root.crop-editing;
                activated => { root.adjust-subtitle-scale(0.1); } }
            MenuItem { title: "Scale Down"; enabled: root.loaded && root.subtitle-scale-known && !root.crop-editing;
                activated => { root.adjust-subtitle-scale(-0.1); } }
            MenuItem { title: "Reset Subtitle Scale"; enabled: root.loaded && root.subtitle-scale-known && !root.crop-editing;
                activated => { root.set-subtitle-scale-slider(0); } }
            MenuSeparator {}
            MenuItem { title: "Subtitle Delay:"; enabled: false; }
            MenuItem { title: "Subtitle Delay + 0.5s"; enabled: root.loaded && !root.crop-editing;
                activated => { root.adjust-subtitle-delay(0.5); } }
            MenuItem { title: "Subtitle Delay + 0.1s"; enabled: root.loaded && !root.crop-editing;
                activated => { root.adjust-subtitle-delay(0.1); } }
            MenuItem { title: "Subtitle Delay - 0.5s"; enabled: root.loaded && !root.crop-editing;
                activated => { root.adjust-subtitle-delay(-0.5); } }
            MenuItem { title: "Subtitle Delay - 0.1s"; enabled: root.loaded && !root.crop-editing;
                activated => { root.adjust-subtitle-delay(-0.1); } }
            MenuItem { title: "Reset Subtitle Delay"; enabled: root.loaded && !root.crop-editing;
                activated => { root.reset-subtitle-delay(); } }
            MenuSeparator {}
            MenuItem { title: "Font…"; enabled: !root.crop-editing;
                activated => { root.choose-subtitle-font(); } }
        }
        Menu { title: "Plugin";
            MenuItem { title: "Manage Plugins…"; enabled: !root.crop-editing;
                activated => { root.preferences-target-pane = 9; root.open-preferences(); } }
            MenuItem { title: (root.sidebar == 7 || root.leading-sidebar == 7) ? "Hide Plugins Panel" : "Show Plugins Panel"; enabled: !root.crop-editing;
                shortcut: root.menu-shortcut(45);
                activated => { root.toggle-plugins-pane(); } }
            MenuSeparator {}
            for row in root.plugin-menu-rows : MenuItem {
                title: row.label;
                enabled: row.enabled && !row.section-header && !root.crop-editing;
                checkable: false;
                checked: row.selected;
                shortcut: row.shortcut;
                activated => { root.activate-plugin-menu-item(row.token); }
            }
            if root.plugin-menu-rows.length > 0 : MenuSeparator {}
            MenuItem { title: "Reload All Plugins"; enabled: !root.crop-editing;
                activated => { root.reload-plugins(); } }
        }
        Menu { title: "Window";
            MenuItem { title: "Minimize";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + M) : @keys(Control + M);
                activated => { root.minimize-window(); }
            }
            MenuItem { title: "Zoom"; activated => { root.zoom-window(); } }
            MenuSeparator {}
            MenuItem { title: "Bring All to Front";
                enabled: root.in-process-player-manager;
                activated => { root.bring-all-to-front(); }
            }
        }
        Menu { title: "Help";
            MenuItem { title: "Riina Help";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + "/") : @keys(Control + Shift + "/");
                activated => { root.open-help-link("help"); } }
            MenuItem { title: "Dump Debug Info"; activated => { root.dump-debug-info(); } }
            MenuSeparator {}
            MenuItem { title: "Use New Settings Window"; checkable: true; checked: true;
                activated => { root.open-preferences(); } }
            MenuSeparator {}
            MenuItem { title: "Release Highlights"; activated => { root.open-help-link("release-highlights"); } }
            MenuSeparator {}
            MenuItem { title: "GitHub"; activated => { root.open-help-link("github"); } }
            MenuItem { title: "Website"; activated => { root.open-help-link("website"); } }
        }
    }
    in property <string> window-title: "riina";
    title: root.window-title;
    changed window-title => { root.window-title-changed(root.window-title); }
    preferred-width: 960px; preferred-height: 600px;
    min-width: music-mode ? 260px : 285px;
    min-height: music-mode ? 72px : 120px;
    // The native VO lives in the owner window; this surface supplies only chrome.
    // Native mode must begin frameless so Winit creates its transparent surface
    // before the owner window is attached. The shared-GL entry point opts out.
    // Start in overlay mode so the native video window can request a genuinely
    // transparent renderer before Slint discovers the conditional native menu.
    // Shared-window entry points opt into their opaque menu surface before show().
    in property <bool> native-video: true;
    in property <bool> native-transition-frame: false;
    in property <bool> show-player-title-row: false;
    in-out property <bool> dialog-open: false;
    in-out property <bool> jump-time-dialog-visible: false;
    in-out property <string> jump-time-draft: "";
    in-out property <string> jump-time-error: "";
    in-out property <bool> url-dialog-visible: false;
    in-out property <string> url-dialog-draft: "";
    changed jump-time-dialog-visible => {
        root.dialog-open = jump-time-dialog-visible || url-dialog-visible;
        if jump-time-dialog-visible { jump-time-input.focus(); }
    }
    changed url-dialog-visible => {
        root.dialog-open = jump-time-dialog-visible || url-dialog-visible;
        if url-dialog-visible { url-input.focus(); }
    }
    in-out property <int> media-request-generation: 0;
    no-frame: native-video;
    // Native output sits behind this window even while loading or between files.
    background: native-video ? transparent : #111111;
    in property <image> video-frame;
    in property <image> video-blurred-frame;
    in property <bool> loaded: false;
    in-out property <bool> reveal-current-media-available: false;
    in-out property <bool> delete-current-media-available: false;
    in-out property <bool> save-current-playlist-available: false;
    in property <bool> downloaded-subtitle-save-available: false;
    in property <string> current-file-manager-name: "File Manager";
    in property <image> timeline-thumbnail-image;
    in property <string> timeline-preview-label: "";
    in property <float> thumbnail-preview-width: 120;
    callback timeline-hovered(float);
    in-out property <string> plugin-osd-message: "";
    in property <[PluginMenuRow]> plugin-menu-rows: [];
    in property <[string]> plugin-menu-order: [];
    changed plugin-menu-rows => { root.video-menu-changed(); }
    in-out property <bool> hdr-enabled: true;
    in property <bool> hdr-display-active: false;
    in property <bool> hdr-source-detected: false;
    in-out property <bool> live-text-enabled: false;
    changed live-text-enabled => { root.video-menu-changed(); root.toolbar-settings-changed(); }
    in-out property <bool> live-text-available: false;
    changed live-text-available => { root.video-menu-changed(); root.toolbar-settings-changed(); }
    in-out property <bool> disable-animations: false;
    in property <bool> system-reduce-motion: false;
    in property <bool> platform-macos: false;
    private property <bool> animations-disabled: root.disable-animations ||
        (root.system-reduce-motion && !root.platform-macos);
    private property <bool> macos-sidebar-reduce-motion-fade:
        root.platform-macos && root.system-reduce-motion && !root.disable-animations;
    in property <duration> osd-fade-duration: animations-disabled || !osd-enabled ? 0ms : 500ms;
    in property <[LiveTextRegion]> live-text-regions: [];
    callback copy-live-text(string);
    callback toggle-live-text();
    callback set-hdr-enabled(bool);
    in-out property <bool> music-mode: false;
    in-out property <bool> auto-switch-to-music-mode: true;
    in-out property <bool> music-mode-show-playlist: false;
    in-out property <bool> music-mode-show-album-art: true;
    in-out property <float> music-mode-artwork-aspect-ratio: 0;
    in-out property <bool> music-mode-is-audio: false;
    in-out property <bool> music-mode-has-album-art: false;
    in-out property <bool> music-mode-has-visible-subtitles: false;
    private property <bool> music-mode-volume-open: false;
    callback toggle-music-mode();
    callback close-player();
    callback window-will-close();
    callback quit-riina();
    callback minimize-window();
    callback zoom-window();
    callback bring-all-to-front();
    in-out property <bool> in-process-player-manager: false;
    callback open-player-requested([string], float);
    callback music-mode-changed();
    callback auto-switch-music-mode-changed(bool);
    changed music-mode => {
        if root.music-mode {
            // IINA's compact audio surface is independent of main-window sidebars.
            root.leading-sidebar = 0;
            root.sidebar = 0;
        }
        if !root.music-mode { root.music-mode-volume-open = false; }
        root.music-mode-changed(); root.video-menu-changed();
    }
    changed auto-switch-to-music-mode => { root.auto-switch-music-mode-changed(root.auto-switch-to-music-mode); }
    changed music-mode-show-playlist => { if root.music-mode { root.music-mode-changed(); } }
    changed music-mode-show-album-art => { if root.music-mode { root.music-mode-changed(); } }
    changed music-mode-artwork-aspect-ratio => { if root.music-mode { root.music-mode-changed(); } }
    callback renderer-ready();
    changed engine-ready => { if root.engine-ready { root.renderer-ready(); } }
    callback media-opened(string, string);
