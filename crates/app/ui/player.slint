                            activated => { root.select-settings-pane(6); } }
                        SidebarTab { label: "Audio"; selected: pane-kind == 1;
                            activated => { root.select-settings-pane(1); } }
                        SidebarTab { label: "Subtitles"; selected: pane-kind == 2;
                            activated => { root.select-settings-pane(2); } }
