import { LineEdit, Button } from "std-widgets.slint";
import { FontList } from "font-list.slint";

export component FontPicker inherits Window {
    title: "Choose a Font";
    width: 458px; height: 524px;
    background: #29292e;
    in property <[StandardListViewItem]> families;
    in property <[StandardListViewItem]> faces;
    in property <bool> ready: false;
    in-out property <bool> picker-active: true;
    in-out property <string> custom-name;
    in-out property <int> family-index: -1;
    in-out property <int> face-index: -1;
    in property <string> preview-font-family;
    in property <int> preview-font-weight: 400;
    in property <bool> preview-font-italic: false;
    in-out property <string> preview-text: "Test";
    in-out property <string> filter-text;
    callback search(string);
    callback family-selected(int);
    callback face-selected(int);
    callback accept-font(string);
    callback cancel();
    private property <bool> restoring-selection: false;
    private property <int> reveal-family: -1;
    private property <int> reveal-face: -1;
    private property <bool> reveal-pending: false;
    callback restore-selection(int, int);
    callback cancel-reveal();
    cancel-reveal => { root.reveal-pending = false; }
    restore-selection(family, face) => {
        root.reveal-family = family;
        root.reveal-face = face;
        root.reveal-pending = true;
    }
    Timer {
        interval: 16ms; running: root.reveal-pending && root.picker-active;
        triggered => {
        // The virtualized rows need their first layout before scroll offsets
        // can be computed. Keep waiting while either populated list is unmeasured.
        if family-list.viewport-height <= 0 || face-list.viewport-height <= 0 { return; }
        // The list's selection API updates its scroll/focus cursor as well as
        // the highlight. Restoration must not be mistaken for a user choice.
        root.restoring-selection = true;
        root.family-index = -1;
        root.face-index = -1;
        family-list.set-current-item(root.reveal-family);
        face-list.set-current-item(root.reveal-face);
        root.restoring-selection = false;
        root.reveal-pending = false;
        }
    }
    FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            if event.text == Key.Return && !event.modifiers.control && !event.modifiers.alt
                && !event.modifiers.meta && !event.modifiers.shift {
                root.accept-font(root.custom-name); return accept;
            }
            return reject;
        }
    // Pinned XIB records 12pt margins, a 268pt table block and preview before
    // custom entry. Native table materials and exact glyph metrics remain open.
    VerticalLayout { padding: 12px; spacing: 0px;
        Text { text: "Choose a font:"; height: 16px; color: #dddddd; font-size: 13px; }
        Rectangle { height: 8px; }
        LineEdit { placeholder-text: "Type to filter..."; height: 24px;
            text <=> root.filter-text;
            accessible-label: "Filter font families";
            accepted => { root.accept-font(root.custom-name); }
            edited => { root.search(self.text); } }
        Rectangle { height: 8px; }
        HorizontalLayout { spacing: 0px; height: 268px;
            VerticalLayout { spacing: 0px;
                Text { text: "Family"; height: 23px; color: #dddddd; font-size: 12px; }
                family-list := FontList { model: root.families; enabled: root.ready;
                    current-item <=> root.family-index;
                    current-item-changed(index) => { if !root.restoring-selection { root.family-selected(index); } } }
            }
            VerticalLayout { spacing: 0px;
                Text { text: "Typeface"; height: 23px; color: #dddddd; font-size: 12px; }
                face-list := FontList { model: root.faces; enabled: root.ready;
                    current-item <=> root.face-index;
                    activated(index) => {
                        root.face-selected(index);
                        root.accept-font(root.custom-name);
                    }
                    current-item-changed(index) => { if !root.restoring-selection { root.face-selected(index); } } }
            }
        }
        Rectangle { height: 8px; }
        Rectangle { height: 36px; background: #202024; border-radius: 4px;
            TextInput { text <=> root.preview-text; single-line: true;
                accessible-label: "Font preview text";
                accessible-action-set-value(value) => { self.text = value; }
                accepted => { root.accept-font(root.custom-name); }
                font-family: root.preview-font-family;
                font-weight: root.preview-font-weight; font-italic: root.preview-font-italic;
                color: #eeeeee; font-size: 24px; horizontal-alignment: center;
                vertical-alignment: center;
                x: 10px; width: parent.width - 20px; height: parent.height; }
            Text { text: "Preview"; x: 8px; y: 4px; color: #bbbbbb; font-size: 11px; }
        }
        Rectangle { height: 12px; }
        Text { text: "Or enter the font name:"; height: 16px; color: #dddddd; font-size: 13px; }
        Rectangle { height: 8px; }
        LineEdit { text <=> root.custom-name; placeholder-text: "sans-serif"; height: 24px;
            accessible-label: "Custom font name";
            accepted => { root.accept-font(root.custom-name); } }
        Rectangle { min-height: 16px; vertical-stretch: 1; }
        HorizontalLayout { spacing: 12px; height: 24px;
            Text { text: root.ready ? "" : "Loading fonts…"; color: #bbbbbb; font-size: 11px; }
            Button { text: "Cancel"; width: 80px; clicked => { root.cancel(); } }
            Button { text: "OK"; width: 80px; primary: true; clicked => { root.accept-font(root.custom-name); } }
        }
    }
    }
}
