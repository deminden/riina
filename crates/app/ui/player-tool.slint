export component Tool inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <length> icon-size: 17px;
    in property <length> icon-optical-offset-x: 0px;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> dark-theme: true;
    in property <bool> selected: false;
    in property <bool> circular: false;
    in property <length> circular-size: 34px;
    in property <bool> windows-acrylic-surface: false;
    in property <color> accent-color: #90b7ef;
    callback activated();
    width: circular ? circular-size : 30px; height: circular ? circular-size : 28px;
    border-radius: circular ? circular-size / 2 : 5px;
    border-width: circular && windows-acrylic-surface ? 1px : 0px;
    border-color: dark-theme ? #ffffff24 : #00000020;
    background: selected ? (dark-theme ? #90b7ef24 : #168bff18) :
        touch.has-hover && enabled ? (windows-acrylic-surface
            ? (dark-theme ? #ffffff15 : #f9f9f980)
            : (dark-theme ? #ffffff20 : #00000014)) :
            circular ? (windows-acrylic-surface
                ? (dark-theme ? #ffffff0f : #f9f9f94d)
                : (dark-theme ? #ffffff14 : #0000000b))
            : transparent;
    accessible-role: button;
    accessible-label: hint;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { activated(); } }
    if icon.width == 0 : Text { text: label; color: !enabled ? #777777 : selected ? root.accent-color : (dark-theme ? #eeeeee : #29292d); font-size: 17px;
        horizontal-alignment: center; vertical-alignment: center; }
    if icon.width > 0 : glyph := Image {
        source: icon; image-fit: contain;
        width: min(root.icon-size, root.width); height: min(root.icon-size, root.height);
        x: (parent.width - self.width) / 2 + root.icon-optical-offset-x;
        y: (parent.height - self.height) / 2;
        colorize: !enabled ? #777777 : selected ? root.accent-color : (dark-theme ? #eeeeee : #29292d);
    }
    if focus.has-focus : Rectangle {
        border-width: 1px; border-color: root.accent-color;
        border-radius: circular ? circular-size / 2 : 5px; background: transparent;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.modifiers.alt || event.modifiers.control || event.modifiers.meta || event.modifiers.shift { return reject; }
            if event.text == Key.Return || event.text == " " {
                root.activated(); return accept;
            }
            return reject;
        }
    }
    // Keep pointer activation above the focus helper in Slint's stacking order;
    // otherwise a mouse press can focus a toolbar item without activating it.
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.activated(); } }
}
