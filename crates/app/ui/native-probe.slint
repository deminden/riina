import { Button, HorizontalBox, VerticalBox, LineEdit } from "std-widgets.slint";

export struct MenuCatalogRow { token: string, label: string, selected: bool }
export struct PluginMenuRow { token: string, label: string, enabled: bool, selected: bool, shortcut: keys, section-header: bool }
export struct SavedFilterMenuRow {
    token: string,
    label: string,
    selected: bool,
    shortcut-label: string,
    shortcut-key: string,
    shortcut-modifiers: int,
}
export struct MenuShortcutRow { shortcut: keys }

// The native video window owns OS-level menus while the shared chrome provides controls.
export component NativeVideoHost inherits Window {
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    callback open-preferences();
    callback manage-plugins();
    callback reload-plugins();
    callback activate-plugin-menu-item(string);
    in property <[PluginMenuRow]> plugin-menu-rows: [];
    callback open-media-file();
    callback open-in-new-window();
    callback reveal-current-media();
    callback delete-current-media();
    callback save-current-playlist();
    callback save-downloaded-subtitle();
    callback show-about();
    callback show-playback-history();
    callback close-player();
    callback quit-riina();
    callback minimize-window();
    callback zoom-window();
    callback bring-all-to-front();
    in property <bool> bring-all-to-front-available: false;
    in property <[MenuShortcutRow]> menu-shortcuts: [];
    callback menu-shortcuts-changed();
    changed menu-shortcuts => { root.menu-shortcuts-changed(); }
    function menu-shortcut(index: int) -> keys {
        if index < 0 || index >= root.menu-shortcuts.length { return @keys(); }
        return root.menu-shortcuts[index].shortcut;
    }
    callback open-url-dialog();
    in property <bool> primary-shortcut-is-meta: false;
    callback open-recent-path(string);
    callback clear-open-recent();
    callback open-jump-time-dialog();
    in property <bool> record-recent-files: true;
    in property <[MenuCatalogRow]> recent-open-menu-rows: [];
    in property <bool> playback-loaded: false;
    in property <int> open-subtitles-provider-index: 0;
    in property <bool> video-panel-open: false;
    in property <bool> audio-panel-open: false;
    in property <bool> subtitles-panel-open: false;
    in property <bool> plugins-panel-open: false;
    in property <bool> reveal-current-media-available: false;
    in property <bool> delete-current-media-available: false;
    in property <bool> save-current-playlist-available: false;
    in property <bool> downloaded-subtitle-save-available: false;
    in property <string> current-file-manager-name: "File Manager";
    in property <bool> video-resize-available: false;
    in property <bool> playback-paused: true;
    in property <bool> menu-alternates-visible: false;
    in property <string> playback-speed-value: "1";
    in property <string> volume-menu-title: "Volume: 100";
    in property <bool> playback-muted: false;
    in property <string> audio-delay-text: "0";
    in property <string> loop-label: "Off";
    callback toggle-pause();
    callback stop();
    callback seek-relative(float);
    callback seek(float);
    callback frame-step();
    callback frame-back-step();
    callback set-speed(float);
    callback reset-speed();
    callback cycle-ab-loop();
    callback toggle-file-loop();
    callback cycle-playlist-loop();
    callback playlist-next();
    callback playlist-previous();
    in property <[MenuCatalogRow]> playlist-menu-rows: [];
    callback select-menu-playlist-item(string);
    callback show-playlist-panel();
    callback show-chapters-panel();
    in property <[MenuCatalogRow]> chapter-menu-rows: [];
    callback select-menu-chapter-item(string);
    callback adjust-chapter(int);
    callback show-video-panel();
    callback show-plugins-panel();
    callback cycle-audio-tracks();
    in property <[MenuCatalogRow]> audio-device-menu-rows: [];
    callback select-audio-device(string);
    callback adjust-volume(float);
    callback toggle-mute();
    callback show-audio-panel();
    callback adjust-audio-delay(float);
    callback reset-audio-delay();
    callback cycle-subtitles();
    callback toggle-subtitle-visibility();
    callback show-subtitles-panel();
    in property <bool> subtitle-visible: true;
    in property <[MenuCatalogRow]> subtitle-track-menu-rows: [];
    in property <[MenuCatalogRow]> secondary-subtitle-menu-rows: [];
    in property <[MenuCatalogRow]> subtitle-encoding-menu-rows: [];
    in property <bool> secondary-subtitle-visible: false;
    in property <bool> secondary-subtitle-visibility-known: false;
    in property <bool> subtitle-scale-known: false;
    in property <string> subtitle-default-encoding: "auto";
    callback select-subtitle-track(string);
    callback select-secondary-subtitle(string);
    callback toggle-secondary-subtitle-visibility();
    callback load-external-subtitle();
    callback find-online-subtitles();
    callback find-online-subtitles-with-provider(int);
    callback set-subtitle-encoding(string);
    callback adjust-subtitle-scale(float);
    callback reset-subtitle-scale();
    callback adjust-subtitle-delay(float);
    callback reset-subtitle-delay();
    callback choose-subtitle-font();
    callback cycle-video-track();
    in property <[MenuCatalogRow]> video-track-menu-rows: [];
    callback select-video-track(string);
    callback fit-window-to-video();
    callback resize-window-command(int);
    callback toggle-fullscreen();
    callback toggle-float-on-top();
    callback toggle-window-aspect-lock();
    callback toggle-live-text();
    in property <bool> live-text-available: false;
    in property <bool> live-text-enabled: false;
    in property <bool> always-float-on-top: false;
    in property <bool> unlock-window-aspect-ratio: false;
    callback toggle-picture-in-picture();
    in property <bool> picture-in-picture-active: false;
    in property <bool> picture-in-picture-available: false;
    in property <bool> music-mode-available: false;
    in property <bool> music-mode: false;
    callback toggle-music-mode();
    in property <bool> screenshot-available: false;
    in property <bool> screenshot-folder-enabled: true;
    callback take-screenshot();
    callback open-screenshot-folder();
    in property <bool> deinterlace-menu-enabled: false;
    in property <bool> deinterlace-enabled: false;
    callback toggle-deinterlace();
    in property <bool> delogo-menu-enabled: false;
    in property <bool> delogo-active: false;
    callback toggle-delogo();
    in property <[SavedFilterMenuRow]> saved-video-filter-rows: [];
    callback toggle-saved-video-filter(string);
    callback open-video-filters();
    in property <[SavedFilterMenuRow]> saved-audio-filter-rows: [];
    callback toggle-saved-audio-filter(string);
    callback open-audio-filters();
    in property <bool> aspect-menu-enabled: false;
    in property <[string]> aspect-menu-labels;
    in property <int> video-aspect-menu-index: 0;
    callback set-menu-video-aspect(int);
    in property <bool> reflection-menu-enabled: false;
    in property <bool> video-mirrored: false;
    in property <bool> video-flipped: false;
    callback toggle-video-reflection(bool);
    in property <bool> crop-menu-enabled: false;
    in property <[string]> crop-menu-labels;
    in property <int> crop-menu-index: -1;
    callback set-menu-video-crop(int);
    in property <bool> rotation-menu-enabled: false;
    in property <int> video-rotation-index: -1;
    callback set-menu-video-rotation(int);
    in property <bool> fullscreen-mode: false;
    if !root.fullscreen-mode : MenuBar {
        Menu { title: "riina";
            MenuItem { title: "About Riina"; activated => { root.show-about(); } }
            MenuItem { title: "Check for Updates…"; enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Preferences…";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + ",") : @keys(Control + ",");
                activated => { root.open-preferences(); } }
            MenuSeparator {}
            MenuItem { title: "Services"; enabled: false; }
            MenuSeparator {}
            MenuItem { title: "Hide Riina"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + H) : @keys(Control + H); }
            MenuItem { title: "Quit Riina";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Q) : @keys(Control + Q);
                activated => { root.quit-riina(); }
            }
        }
        Menu { title: "File";
            MenuItem { title: "Open…";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + O) : @keys(Control + O);
                activated => { root.open-media-file(); } }
            MenuItem { title: "Open in New Window…";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Alt + O) : @keys(Control + Alt + O);
                activated => { root.open-in-new-window(); } }
            MenuItem { title: "Open URL…";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + O) : @keys(Control + Shift + O);
                activated => { root.open-url-dialog(); } }
            if root.record-recent-files : Menu {
                title: "Open Recent";
                enabled: root.recent-open-menu-rows.length > 0;
                for row in root.recent-open-menu-rows : MenuItem {
                    title: row.label;
                    activated => { root.open-recent-path(row.token); }
                }
                MenuSeparator {}
                MenuItem { title: "Clear Menu"; enabled: root.recent-open-menu-rows.length > 0;
                    activated => { root.clear-open-recent(); } }
            }
            MenuSeparator {}
            MenuItem { title: "Playback History";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + H) : @keys(Control + Shift + H);
                activated => { root.show-playback-history(); } }
            MenuSeparator {}
            MenuItem { title: "Show Current File in " + root.current-file-manager-name;
                enabled: root.reveal-current-media-available;
                activated => { root.reveal-current-media(); } }
            MenuItem { title: "Delete Current File";
                enabled: root.delete-current-media-available;
                activated => { root.delete-current-media(); } }
            MenuItem { title: "Save Current Playlist…";
                enabled: root.save-current-playlist-available;
                activated => { root.save-current-playlist(); } }
            MenuSeparator {}
            MenuItem { title: "Close";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + W) : @keys(Control + W);
                activated => { root.close-player(); } }
        }
        Menu { title: "Edit";
            MenuItem { title: "Undo"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Z) : @keys(Control + Z); }
            MenuItem { title: "Redo"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + Z) : @keys(Control + Shift + Z); }
            MenuSeparator {}
            MenuItem { title: "Cut"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + X) : @keys(Control + X); }
            MenuItem { title: "Copy"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + C) : @keys(Control + C); }
            MenuItem { title: "Paste"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + V) : @keys(Control + V); }
            MenuItem { title: "Select All"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + A) : @keys(Control + A); }
        }
        Menu { title: "Playback";
            MenuItem { title: root.playback-paused ? "Resume" : "Pause";
                enabled: root.playback-loaded; shortcut: root.menu-shortcut(0);
                activated => { root.toggle-pause(); } }
            MenuItem { title: "Stop and Clear Playlists"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(1);
                activated => { root.stop(); } }
            MenuSeparator {}
            MenuItem { title: root.menu-alternates-visible ? "Next Frame" : "Step Forward 5s";
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 4 : 2);
                activated => { if root.menu-alternates-visible { root.frame-step(); } else { root.seek-relative(5); } } }
            MenuItem { title: root.menu-alternates-visible ? "Previous Frame" : "Step Backward 5s";
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 5 : 3);
                activated => { if root.menu-alternates-visible { root.frame-back-step(); } else { root.seek-relative(-5); } } }
            MenuItem { title: "Jump to Beginning"; enabled: root.playback-loaded;
                activated => { root.seek(0); } }
            MenuItem { title: "Jump to…"; enabled: root.playback-loaded;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + J) : @keys(Control + J);
                activated => { root.open-jump-time-dialog(); } }
            MenuSeparator {}
            MenuItem { title: "Speed: " + root.playback-speed-value + "x"; enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? "Speed Up by 1.1x" : "Speed Up by 2x";
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 9 : 7);
                activated => { root.set-speed(root.menu-alternates-visible ? 1.1 : 2); } }
            MenuItem { title: root.menu-alternates-visible ? "Speed Down by 0.9x" : "Speed Down by 0.5x";
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 10 : 8);
                activated => { root.set-speed(root.menu-alternates-visible ? 0.9 : 0.5); } }
            MenuItem { title: "Reset Speed"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(6);
                activated => { root.reset-speed(); } }
            MenuSeparator {}
            MenuItem { title: "Take a Screenshot"; enabled: root.screenshot-available;
                shortcut: root.menu-shortcut(11);
                activated => { root.take-screenshot(); } }
            MenuItem { title: "Go to Screenshot Folder"; enabled: root.screenshot-folder-enabled;
                activated => { root.open-screenshot-folder(); } }
            MenuSeparator {}
            MenuItem { title: "A-B Loop"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(46);
                activated => { root.cycle-ab-loop(); } }
            MenuItem { title: "File Loop"; checkable: true; checked: root.loop-label == "File";
                enabled: root.playback-loaded; activated => { root.toggle-file-loop(); } }
            MenuSeparator {}
            MenuItem { title: "Show Playlist Panel"; shortcut: root.menu-shortcut(12);
                activated => { root.show-playlist-panel(); } }
            MenuItem { title: "Playlist Loop"; checkable: true; checked: root.loop-label == "Playlist";
                enabled: root.playback-loaded; activated => { root.cycle-playlist-loop(); } }
            Menu { title: "Playlist"; enabled: root.playback-loaded && root.playlist-menu-rows.length > 0;
                for row in root.playlist-menu-rows : MenuItem {
                    title: row.label;
                    checkable: true; checked: row.selected;
                    activated => { root.select-menu-playlist-item(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Next Media"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(13);
                activated => { root.playlist-next(); } }
            MenuItem { title: "Previous Media"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(14);
                activated => { root.playlist-previous(); } }
            MenuItem { title: "Show Chapters Panel";
                shortcut: root.menu-shortcut(15);
                activated => { root.show-chapters-panel(); } }
            Menu { title: "Chapters"; enabled: root.playback-loaded && root.chapter-menu-rows.length > 0;
                for row in root.chapter-menu-rows : MenuItem {
                    title: row.label;
                    checkable: true; checked: row.selected;
                    activated => { root.select-menu-chapter-item(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Next Chapter"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(16);
                activated => { root.adjust-chapter(1); } }
            MenuItem { title: "Previous Chapter"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(17);
                activated => { root.adjust-chapter(-1); } }
        }
        Menu { title: "Video";
            MenuItem { title: root.video-panel-open ? "Hide Video Panel" : "Show Video Panel"; shortcut: root.menu-shortcut(18);
                activated => { root.show-video-panel(); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Video Tracks"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(19);
                activated => { root.cycle-video-track(); } }
            Menu { title: "Video Track"; enabled: root.playback-loaded && root.video-track-menu-rows.length > 0;
                for row in root.video-track-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-video-track(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Half Size"; enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(20);
                activated => { root.resize-window-command(0); } }
            MenuItem { title: "Normal Size"; enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(21);
                activated => { root.resize-window-command(1); } }
            MenuItem { title: "Double Size"; enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(22);
                activated => { root.resize-window-command(2); } }
            MenuItem { title: "Fit to Screen"; shortcut: root.menu-shortcut(23);
                activated => { root.resize-window-command(3); } }
            MenuSeparator {}
            MenuItem { title: "Bigger Size"; enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(24);
                activated => { root.resize-window-command(4); } }
            MenuItem { title: "Smaller Size"; enabled: root.playback-loaded && root.video-resize-available
                    && !root.music-mode; shortcut: root.menu-shortcut(25);
                activated => { root.resize-window-command(5); } }
            MenuSeparator {}
            MenuItem {
                title: root.picture-in-picture-active ? "Exit Picture in Picture" : "Enter Picture in Picture";
                enabled: root.picture-in-picture-active || root.picture-in-picture-available;
                shortcut: root.menu-shortcut(26);
                activated => { root.toggle-picture-in-picture(); }
            }
            MenuItem { title: root.fullscreen-mode ? "Exit Full Screen" : "Enter Full Screen";
                checkable: true; checked: root.fullscreen-mode;
                shortcut: root.menu-shortcut(27);
                activated => { root.toggle-fullscreen(); } }
            MenuItem { title: "Float on Top"; checkable: true; checked: root.always-float-on-top;
                shortcut: root.menu-shortcut(28);
                activated => { root.toggle-float-on-top(); } }
            MenuItem { title: "Lock Window Aspect Ratio"; checkable: true;
                checked: !root.unlock-window-aspect-ratio;
                activated => { root.toggle-window-aspect-lock(); } }
            MenuItem { title: "Live Text";
                checkable: true; checked: root.live-text-enabled;
                enabled: root.live-text-available;
                shortcut: root.menu-shortcut(29);
                activated => { root.toggle-live-text(); } }
            MenuSeparator {}
            MenuItem { title: root.music-mode ? "Exit Music Mode" : "Enter Music Mode";
                checkable: true; checked: root.music-mode;
                enabled: root.music-mode-available;
                shortcut: root.menu-shortcut(30);
                activated => { root.toggle-music-mode(); } }
            MenuSeparator {}
            Menu { title: "Aspect Ratio"; enabled: root.aspect-menu-enabled;
                for label[index] in root.aspect-menu-labels : MenuItem {
                    title: label; checkable: true; checked: root.video-aspect-menu-index == index;
                    activated => { root.set-menu-video-aspect(index); }
                }
            }
            Menu { title: "Crop"; enabled: root.crop-menu-enabled;
                for label[index] in root.crop-menu-labels : MenuItem {
                    title: label; checkable: true; checked: root.crop-menu-index == index;
                    activated => { root.set-menu-video-crop(index); }
                }
                MenuSeparator {}
                MenuItem { title: "Custom…"; checkable: true; checked: root.crop-menu-index == 10;
                    activated => { root.set-menu-video-crop(10); } }
            }
            Menu { title: "Rotation"; enabled: root.rotation-menu-enabled;
                MenuItem { title: "0°"; checkable: true; checked: root.video-rotation-index == 0;
                    activated => { root.set-menu-video-rotation(0); } }
                MenuItem { title: "90°"; checkable: true; checked: root.video-rotation-index == 1;
                    activated => { root.set-menu-video-rotation(90); } }
                MenuItem { title: "180°"; checkable: true; checked: root.video-rotation-index == 2;
                    activated => { root.set-menu-video-rotation(180); } }
                MenuItem { title: "270°"; checkable: true; checked: root.video-rotation-index == 3;
                    activated => { root.set-menu-video-rotation(270); } }
            }
            Menu { title: "Flip"; enabled: root.reflection-menu-enabled;
                MenuItem { title: "Horizontal (Mirror)"; checkable: true; checked: root.video-mirrored;
                    activated => { root.toggle-video-reflection(true); } }
                MenuItem { title: "Vertical (Flip)"; checkable: true; checked: root.video-flipped;
                    activated => { root.toggle-video-reflection(false); } }
            }
            MenuItem { title: "Deinterlace"; checkable: true; checked: root.deinterlace-enabled;
                enabled: root.deinterlace-menu-enabled;
                activated => { root.toggle-deinterlace(); } }
            MenuItem { title: "Delogo"; checkable: true; checked: root.delogo-active;
                enabled: root.delogo-menu-enabled;
                activated => { root.toggle-delogo(); } }
            MenuSeparator {}
            MenuItem { title: "Video Filters…"; enabled: root.playback-loaded;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + F) : @keys(Control + Shift + F);
                activated => { root.open-video-filters(); } }
            Menu { title: "Saved Video Filters"; enabled: root.playback-loaded;
                for row in root.saved-video-filter-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.toggle-saved-video-filter(row.token); }
                }
            }
        }
        Menu { title: "Audio";
            MenuItem { title: root.audio-panel-open ? "Hide Audio Panel" : "Show Audio Panel"; shortcut: root.menu-shortcut(31);
                activated => { root.show-audio-panel(); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Audio Tracks"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(32);
                activated => { root.cycle-audio-tracks(); } }
            MenuItem { title: "Audio Track"; enabled: false; }
            MenuItem { title: "Load External Audio…"; enabled: false; }
            MenuSeparator {}
            MenuItem { title: root.volume-menu-title; enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? "Volume + 1%" : "Volume + 5%";
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 35 : 33);
                activated => { root.adjust-volume(root.menu-alternates-visible ? 1 : 5); } }
            MenuItem { title: root.menu-alternates-visible ? "Volume - 1%" : "Volume - 5%";
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 36 : 34);
                activated => { root.adjust-volume(root.menu-alternates-visible ? -1 : -5); } }
            MenuItem { title: "Mute"; checkable: true; checked: root.playback-muted;
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(37);
                activated => { root.toggle-mute(); } }
            MenuSeparator {}
            MenuItem { title: "Audio Delay: " + root.audio-delay-text + "s"; enabled: false; }
            MenuItem { title: root.menu-alternates-visible ? "Audio Delay + 0.1s" : "Audio Delay + 0.5s";
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 40 : 38);
                activated => { root.adjust-audio-delay(root.menu-alternates-visible ? 0.1 : 0.5); } }
            MenuItem { title: root.menu-alternates-visible ? "Audio Delay - 0.1s" : "Audio Delay - 0.5s";
                enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(root.menu-alternates-visible ? 41 : 39);
                activated => { root.adjust-audio-delay(root.menu-alternates-visible ? -0.1 : -0.5); } }
            MenuItem { title: "Reset Audio Delay"; enabled: root.playback-loaded;
                activated => { root.reset-audio-delay(); } }
            MenuSeparator {}
            Menu { title: "Audio Device";
                enabled: root.playback-loaded && root.audio-device-menu-rows.length > 0;
                for row in root.audio-device-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-audio-device(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Audio Filters…"; enabled: root.playback-loaded;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + G) : @keys(Control + Shift + G);
                activated => { root.open-audio-filters(); } }
            Menu { title: "Saved Audio Filters"; enabled: root.playback-loaded;
                for row in root.saved-audio-filter-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.toggle-saved-audio-filter(row.token); }
                }
            }
        }
        Menu { title: "Subtitles";
            MenuItem { title: root.subtitles-panel-open ? "Hide Subtitles Panel" : "Show Subtitles Panel"; shortcut: root.menu-shortcut(42);
                activated => { root.show-subtitles-panel(); } }
            MenuSeparator {}
            MenuItem { title: "Cycle Subtitles"; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(43);
                activated => { root.cycle-subtitles(); } }
            Menu { title: "Subtitle"; enabled: root.playback-loaded;
                for row in root.subtitle-track-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-subtitle-track(row.token); }
                }
            }
            MenuItem { title: root.subtitle-visible ? "Hide Subtitles" : "Show Subtitles";
                checkable: true; checked: root.subtitle-visible; enabled: root.playback-loaded;
                shortcut: root.menu-shortcut(44);
                activated => { root.toggle-subtitle-visibility(); } }
            Menu { title: "Secondary Subtitle"; enabled: root.playback-loaded;
                for row in root.secondary-subtitle-menu-rows : MenuItem {
                    title: row.label; checkable: true; checked: row.selected;
                    activated => { root.select-secondary-subtitle(row.token); }
                }
            }
            MenuItem { title: root.secondary-subtitle-visible ? "Hide Secondary Subtitles" : "Show Secondary Subtitles";
                checkable: true; checked: root.secondary-subtitle-visible;
                enabled: root.playback-loaded && root.secondary-subtitle-visibility-known;
                activated => { root.toggle-secondary-subtitle-visibility(); }
            }
            MenuItem { title: "Load External Subtitle…"; enabled: root.playback-loaded;
                activated => { root.load-external-subtitle(); } }
            MenuSeparator {}
            MenuItem { title: root.open-subtitles-provider-index == 1 ? "Find Online Subtitles from assrt.net" : root.open-subtitles-provider-index == 2 ? "Find Online Subtitles from shooter.cn" : "Find Online Subtitles from opensubtitles.com"; enabled: root.playback-loaded;
                activated => { root.find-online-subtitles(); } }
            Menu { title: "Find Online Subtitles from"; enabled: root.playback-loaded;
                MenuItem { title: "opensubtitles.com"; activated => { root.find-online-subtitles-with-provider(0); } }
                MenuItem { title: "assrt.net"; activated => { root.find-online-subtitles-with-provider(1); } }
                MenuItem { title: "shooter.cn"; activated => { root.find-online-subtitles-with-provider(2); } }
            }
            MenuItem { title: "Save Downloaded Subtitle…";
                enabled: root.downloaded-subtitle-save-available;
                activated => { root.save-downloaded-subtitle(); }
            }
            MenuSeparator {}
            Menu { title: "Encoding"; enabled: root.playback-loaded;
                for row in root.subtitle-encoding-menu-rows : MenuItem {
                    title: row.label; checkable: true;
                    checked: root.subtitle-default-encoding == row.token;
                    activated => { root.set-subtitle-encoding(row.token); }
                }
            }
            MenuSeparator {}
            MenuItem { title: "Scale Up"; enabled: root.playback-loaded && root.subtitle-scale-known;
                activated => { root.adjust-subtitle-scale(0.1); } }
            MenuItem { title: "Scale Down"; enabled: root.playback-loaded && root.subtitle-scale-known;
                activated => { root.adjust-subtitle-scale(-0.1); } }
            MenuItem { title: "Reset Subtitle Scale"; enabled: root.playback-loaded && root.subtitle-scale-known;
                activated => { root.reset-subtitle-scale(); } }
            MenuSeparator {}
            MenuItem { title: "Subtitle Delay:"; enabled: false; }
            MenuItem { title: "Subtitle Delay + 0.5s"; enabled: root.playback-loaded;
                activated => { root.adjust-subtitle-delay(0.5); } }
            MenuItem { title: "Subtitle Delay + 0.1s"; enabled: root.playback-loaded;
                activated => { root.adjust-subtitle-delay(0.1); } }
            MenuItem { title: "Subtitle Delay - 0.5s"; enabled: root.playback-loaded;
                activated => { root.adjust-subtitle-delay(-0.5); } }
            MenuItem { title: "Subtitle Delay - 0.1s"; enabled: root.playback-loaded;
                activated => { root.adjust-subtitle-delay(-0.1); } }
            MenuItem { title: "Reset Subtitle Delay"; enabled: root.playback-loaded;
                activated => { root.reset-subtitle-delay(); } }
            MenuSeparator {}
            MenuItem { title: "Font…"; activated => { root.choose-subtitle-font(); } }
        }
        Menu { title: "Plugin";
            MenuItem { title: "Manage Plugins…"; activated => { root.manage-plugins(); } }
            MenuItem { title: root.plugins-panel-open ? "Hide Plugins Panel" : "Show Plugins Panel"; shortcut: root.menu-shortcut(45);
                activated => { root.show-plugins-panel(); } }
            MenuSeparator {}
            for row in root.plugin-menu-rows : MenuItem {
                title: row.label;
                enabled: row.enabled && !row.section-header;
                checkable: false;
                checked: row.selected;
                shortcut: row.shortcut;
                activated => { root.activate-plugin-menu-item(row.token); }
            }
            if root.plugin-menu-rows.length > 0 : MenuSeparator {}
            MenuItem { title: "Reload All Plugins"; activated => { root.reload-plugins(); } }
        }
        Menu { title: "Window";
            MenuItem { title: "Minimize";
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + M) : @keys(Control + M);
                activated => { root.minimize-window(); }
            }
            MenuItem { title: "Zoom"; activated => { root.zoom-window(); } }
            MenuSeparator {}
            MenuItem { title: "Bring All to Front";
                enabled: root.bring-all-to-front-available;
                activated => { root.bring-all-to-front(); } }
        }
        Menu { title: "Help";
            MenuItem { title: "Riina Help"; enabled: false;
                shortcut: root.primary-shortcut-is-meta ? @keys(Meta + Shift + "/") : @keys(Control + Shift + "/"); }
            MenuItem { title: "Release Highlights"; enabled: false; }
            MenuSeparator {}
            MenuItem { title: "GitHub"; enabled: false; }
            MenuItem { title: "Website"; enabled: false; }
        }
    }
    in property <string> display-title: "riina — D3D11 experiment";
    title: display-title;
    preferred-width: 960px;
    preferred-height: 600px;
    min-width: 285px;
    min-height: 120px;
    background: black;
}

export component NativeProbeOverlay inherits Window {
    title: "riina — native controls";
    no-frame: true;
    width: 460px;
    height: 190px;
    background: transparent;
    in property <string> status: "Starting native renderer…";
    callback pause();
    callback seek(float);
    callback fullscreen();
    callback stop();
    callback next-file();
    Rectangle {
        background: #202020dc;
        border-radius: 12px;
        VerticalBox {
            padding: 12px;
            Text { text: root.status; color: white; font-size: 12px; wrap: word-wrap; }
            HorizontalBox {
                Button { text: "Stop"; clicked => { root.stop(); } }
                Button { text: "Next / Reload"; clicked => { root.next-file(); } }
            }
            HorizontalBox {
                Button { text: "−5s"; clicked => { root.seek(-5); } }
                Button { text: "Play / Pause"; clicked => { root.pause(); } }
                Button { text: "+5s"; clicked => { root.seek(5); } }
                Button { text: "Fullscreen"; clicked => { root.fullscreen(); } }
            }
            LineEdit { placeholder-text: "Overlay keyboard input test"; }
        }
    }
}
