import { Button, ScrollView } from "std-widgets.slint";

export struct PlaybackHistoryRow {
    is-group: bool,
    label: string,
    detail: string,
    progress: string,
    played-at: string,
    path: string,
    progress-ratio: float,
    available: bool,
    local-file: bool,
    selected: bool,
}

export component PlaybackHistoryWindow inherits Window {
    title: "Playback History";
    icon: @image-url("../../../assets/branding/svg/riina-app-icon-dark.svg");
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 520px;
    min-height: 340px;
    background: #f5f5f7;

    in property <[PlaybackHistoryRow]> rows: [];
    in-out property <string> search-text: "";
    in-out property <int> group-mode: 0;
    in-out property <int> search-mode: 1;
    in-out property <string> selected-path: "";
    in property <[string]> selected-paths: [];
    callback search-changed(string, int);
    callback history-key(int);
    callback select-entry(string, int, bool, bool);
    callback context-action(int, string);
    callback open-entry(string);
    callback clear-history();
    callback toggle-group(string);
    callback expand-all-groups();
    callback collapse-all-groups();
    changed search-text => { root.search-changed(root.search-text, root.group-mode); }

    keys := FocusScope {
    width: root.width; height: root.height;
    Rectangle {
        x: 0; y: 0; width: parent.width; height: 84px;
        background: #ececf0;
        HorizontalLayout {
            x: 16px; y: 7px; width: parent.width - 32px; height: 32px; spacing: 6px;
            Button {
                text: "Date";
                checkable: true;
                checked: root.group-mode == 0;
                clicked => { root.group-mode = 0; root.search-changed(root.search-text, root.group-mode); }
            }
            Button {
                text: "Folder & Website";
                checkable: true;
                checked: root.group-mode == 1;
                clicked => { root.group-mode = 1; root.search-changed(root.search-text, root.group-mode); }
            }
            Rectangle { horizontal-stretch: 1; }
            search-input := TextInput {
                width: max(110px, min(190px, parent.width * 0.26)); height: 28px;
                text <=> root.search-text;
                accepted => { root.search-changed(root.search-text, root.group-mode); }
            }
            Button {
                text: root.search-mode == 0 ? "Name" : "Path";
                clicked => {
                    root.search-mode = 1 - root.search-mode;
                    root.search-changed(root.search-text, root.group-mode);
                }
            }
            Button { text: "Clear History"; clicked => { root.clear-history(); } }
        }
        HorizontalLayout {
            x: 16px; y: 45px; width: parent.width - 32px; height: 30px; spacing: 6px;
            Button { text: "Expand All"; clicked => { root.expand-all-groups(); } }
            Button { text: "Collapse All"; clicked => { root.collapse-all-groups(); } }
        }
    }

    Rectangle {
        x: 16px; y: 92px; width: parent.width - 32px; height: 28px;
        background: #e9e9ed;
        Text { x: 34px; y: 0; width: parent.width - 390px; height: parent.height;
            text: "Media"; font-size: 11px; font-weight: 600; color: #55555b; vertical-alignment: center; }
        Text { x: parent.width - 350px; y: 0; width: 130px; height: parent.height;
            text: "Progress"; font-size: 11px; font-weight: 600; color: #55555b; vertical-alignment: center; }
        Text { x: parent.width - 205px; y: 0; width: 190px; height: parent.height;
            text: "Played At"; font-size: 11px; font-weight: 600; color: #55555b; vertical-alignment: center; }
    }

    ScrollView {
        x: 16px; y: 120px; width: parent.width - 32px; height: parent.height - 132px;
        content-height: max(1px, root.rows.length * 46px);
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        Rectangle {
            width: parent.width; height: max(1px, root.rows.length * 46px); background: #ffffff;
            for row[index] in root.rows : Rectangle {
                x: 0; y: index * 46px; width: parent.width; height: 46px;
                background: row.is-group ? #f0f0f2 : (row.selected ? #d8e8ff : (Math.mod(index, 2) == 0 ? #ffffff : #fafafa));
                if row.is-group : Text {
                    x: 12px; y: 0; width: parent.width - 24px; height: parent.height;
                    text: row.label; color: #66666c; font-size: 11px; font-weight: 600;
                    vertical-alignment: center; overflow: elide;
                }
                if row.is-group : TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.toggle-group(row.label); }
                }
                if !row.is-group : Rectangle {
                    x: 10px; y: 11px; width: 22px; height: 22px;
                    border-radius: 4px; background: row.available ? #d9e4f3 : #e4e4e7;
                    Text { width: parent.width; height: parent.height;
                        text: row.available ? "▶" : "•"; color: #65758c; font-size: 11px;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                if !row.is-group : VerticalLayout {
                    x: 40px; y: 5px; width: parent.width - 400px; height: 36px; spacing: 1px;
                    Text { text: row.label; color: row.available ? #202024 : #92929a;
                        font-size: 12px; vertical-alignment: center; overflow: elide; }
                    Text { text: row.detail; color: #85858b; font-size: 10px;
                        vertical-alignment: center; overflow: elide; }
                }
                if !row.is-group : Text {
                    x: parent.width - 350px; y: 0; width: 130px; height: parent.height;
                    text: row.progress; color: row.available ? #56565c : #a0a0a5;
                    font-size: 11px; vertical-alignment: center; overflow: elide;
                }
                if !row.is-group : Rectangle {
                    x: parent.width - 350px; y: parent.height - 8px; width: 112px; height: 3px;
                    border-radius: 2px; background: #d8d8dc;
                    Rectangle {
                        x: 0; y: 0; width: parent.width * row.progress-ratio; height: parent.height;
                        border-radius: 2px; background: #4b83d5;
                    }
                }
                if !row.is-group : Rectangle {
                    x: parent.width - 205px; y: 0; width: 190px; height: parent.height; background: transparent;
                    Text { x: 0; y: 0; width: parent.width; height: parent.height;
                        text: row.played-at; color: #77777d; font-size: 11px;
                        vertical-alignment: center; overflow: elide; }
                }
                if !row.is-group : TouchArea {
                    width: parent.width; height: parent.height;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                            root.select-entry(row.path, index,
                                event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                        }
                    }
                    double-clicked => {
                        if row.available { root.open-entry(row.path); }
                    }
                }
                if !row.is-group : ContextMenuArea {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    Menu {
                        MenuItem {
                            title: "Play"; enabled: row.available;
                            activated => { root.context-action(0, row.path); }
                        }
                        MenuItem {
                            title: "Play in New Window"; enabled: row.available;
                            activated => { root.context-action(1, row.path); }
                        }
                        MenuSeparator {}
                        MenuItem {
                            title: "Show in File Manager"; enabled: row.local-file && row.available;
                            activated => { root.context-action(2, row.path); }
                        }
                        MenuSeparator {}
                        MenuItem {
                            title: "Remove from History";
                            activated => { root.context-action(3, row.path); }
                        }
                        MenuItem {
                            title: "Move to Trash"; enabled: row.local-file && row.available;
                            activated => { root.context-action(4, row.path); }
                        }
                    }
                }
            }
            if root.rows.length == 0 : Text {
                x: 12px; y: 18px; width: parent.width - 24px; height: 30px;
                text: root.search-text == "" ? "No playback history" : "No matching history";
                color: #85858b; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }

    key-pressed(event) => {
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "a" || event.text == "A") {
            root.history-key(0); return accept;
        }
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "f" || event.text == "F") {
            search-input.focus(); return accept;
        }
        if event.modifiers.alt || event.modifiers.shift { return reject; }
        if (event.modifiers.control || event.modifiers.meta) && event.text == Key.Return {
            root.history-key(2); return accept;
        }
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "l" || event.text == "L") {
            root.history-key(3); return accept;
        }
        if event.modifiers.control || event.modifiers.meta { return reject; }
        if event.text == Key.Return { root.history-key(1); return accept; }
        if event.text == Key.Backspace || event.text == Key.Delete {
            root.history-key(4); return accept;
        }
        return reject;
    }
    }
}
