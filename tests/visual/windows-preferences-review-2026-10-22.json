  "findings": [
    {
      "area": "Music Mode preference commit",
      "problem": "The settings callback changed three live Music Mode fields before saving but omitted them from its candidate and did not roll them back on failure. Session shutdown could later mask the missing immediate save.",
      "resolution": "Persist the window choices and update live playback/window policy only after a successful write. Failed writes leave the current player policy intact and remain retryable.",
      "tests": [
        "music_mode_choices_are_saved_immediately_and_can_return_to_defaults",
        "failed_preferences_save_keeps_live_music_mode_choices_and_is_retryable"
      ],
      "before_fix": "Both new persistence tests failed against the extracted old save path."
    },
    {
      "area": "Queued OSD suppression",
      "problem": "Disabling speed or pause/resume feedback left already queued messages eligible for later display.",
      "resolution": "Discard only the disabled category from the pending queue, retaining unrelated feedback.",
      "tests": [
        "disabling_speed_feedback_removes_only_queued_speed_messages",
        "disabling_pause_feedback_removes_queued_pause_messages"
      ]
    },
    {
      "area": "Plugin private storage identity",
      "problem": "Distinct accepted identifiers with the same first 128 characters shared private storage. Character replacement and filesystem case/filename aliases also collided.",
      "resolution": "Keep ordinary lowercase portable names stable; hash the complete other identifiers with a reserved prefix. Do not migrate ambiguous legacy directories because ownership cannot be recovered.",
      "tests": [
        "accepted_long_plugin_identifiers_have_isolated_private_storage",
        "storage_names_do_not_alias_case_replacements_or_special_path_components"
      ],
      "before_fix": "A standalone harness compiled from the exact old safe_identifier function fails the distinct-storage assertion."
    }
  ],
