  "reference": {
    "version": "IINA v1.5.0",
    "commit": "fbcff4df7183b335880396af0655f6bb89d46442",
    "inspected_contracts": [
      "JavascriptPluginInstance realm ownership and API installation",
      "JavascriptPolyfill package-relative require bridge"
    ]
  },
  "review_findings": [
    {
      "severity": "medium",
      "area": "JavaScript continuations",
      "problem": "Only network responses drained Promise jobs; startup, timers and other callbacks could leave continuations permanently pending. The 256-job cap could also strand longer chains.",
      "resolution": "Each JavaScript turn drains its jobs under one deadline, including jobs queued before a synchronous exception. The worker checks cancellation and time between jobs.",
      "regressions": [
        "startup_promises_finish_without_an_external_event",
        "long_promise_chains_continue_after_the_job_batch_limit",
        "timers_and_player_and_menu_callbacks_run_their_promise_continuations",
        "unbounded_promise_chains_share_the_entry_execution_limit",
        "a_failed_overlay_callback_still_runs_its_queued_promise_jobs"
      ]
    },
    {
      "severity": "medium",
      "area": "Plugin shutdown",
      "problem": "A blocking shutdown message waited behind queued callbacks; a busy realm delayed destruction by the sum of their execution budgets.",
      "resolution": "Session cancellation interrupts active JavaScript and prevents queued callbacks from running. A nonblocking shutdown message wakes an idle worker before the owner joins it.",
      "regressions": [
        "shutdown_interrupts_the_active_callback_and_discards_queued_callbacks"
      ]
    },
    {
      "severity": "medium",
      "area": "Package require",
      "problem": "The loader deleted its global native bridge while the require closure still looked it up by that global name, breaking package module loads.",
      "resolution": "Capture the native function in the private loader closure before removing its global property.",
      "regressions": [
        "package_require_bridge_survives_api_installation"
      ]
    },
    {
      "severity": "medium",
      "area": "Network worker limits",
      "problem": "Workers released their request slots before sending results to a bounded runtime queue, allowing additional blocked worker threads to accumulate.",
      "resolution": "An owned slot remains held through result delivery and is released on worker, spawn or delivery failure.",
      "regressions": [
        "response_backpressure_retains_the_network_slot_until_delivery",
        "a_disconnected_runtime_releases_the_network_slot"
      ]
    }
  ],
