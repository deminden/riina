  "review_findings": [
    {
      "severity": "high",
      "area": "native lifecycle",
      "problem": "Public Command::Shutdown bypassed retained player/render ownership and could destroy a core before its render context.",
      "resolution": "Only the final Owner sends the private shutdown message; both public send routes reject the reserved intent.",
      "regressions": [
        "public_shutdown_is_rejected_without_consuming_a_command_slot",
        "only_the_final_owner_delivers_shutdown_even_when_command_senders_survive",
        "public_shutdown_cannot_invalidate_a_retained_player"
      ]
    },
    {
      "severity": "medium",
      "area": "Auto seek",
      "problem": "The worker applied its measured mode only before a decision, forcing every later Auto seek back to the command plan keyframe default. Failed/interrupted measurements could also consume unrelated native seeks.",
      "resolution": "A per-file typed state machine retains the decision and correlates failures; explicit navigation and the existing decoder-reset paths cancel only unfinished measurements.",
      "regressions": [
        "fast_seek_keeps_exact_mode_for_all_later_auto_seeks",
        "threshold_and_slower_seeks_keep_keyframes_until_the_next_file",
        "failed_and_superseded_requests_do_not_measure_unrelated_native_seeks",
        "initial_load_restart_does_not_decide_the_seek_mode"
      ]
    },
    {
      "severity": "medium",
      "area": "plugin menus",
      "problem": "Disabled parent menus left flattened child actions enabled, and runtime dispatch checked only the leaf. Submenu containers could also be invoked through queued runtime actions.",
      "resolution": "Propagate enabled state through menu ancestry; recheck live ancestry and leaf status before dispatch.",
      "regressions": [
        "disabled_plugin_menu_ancestors_disable_descendants_without_disabling_siblings",
        "plugin_menu_actions_respect_live_ancestors_and_submenu_containers"
      ]
    },
    {
      "severity": "medium",
      "area": "playback observations",
      "problem": "Non-finite time-pos/duration observations preserved stale timestamps.",
      "resolution": "Represent invalid clocks as unknown while allowing later valid observations to recover.",
      "regressions": [
        "invalid_clock_observations_clear_previous_values_and_valid_values_recover"
      ]
    }
  ],
