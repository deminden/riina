  "findings": [
    {
      "area": "Encoded key events",
      "problem": "Profile recording and dispatch matched printable key names, but Slint sends encoded key scalars. Navigation, editing and function keys failed to reach their profile mappings, and standalone modifiers could be recorded.",
      "resolution": "Convert encoded keys to mpv names at the event boundary, ignore modifier-only events and compile normalized profile keys once per keyboard dispatcher installation.",
      "before_fix": "Both encoded-key regressions failed before conversion was added.",
      "tests": [
        "encoded_slint_keys_record_portable_profile_names",
        "encoded_modifier_keys_are_not_recorded_as_shortcuts",
        "installed_profiles_dispatch_encoded_events_without_ui_fallbacks"
      ]
    },
    {
      "area": "Effective menu shortcuts",
      "problem": "Menu accelerators could retain a shadowed profile entry and invoke an action different from the last mapping of the same key.",
      "resolution": "One compiled index supplies dispatch and menu hints. Duplicate keys use the last action and retain their first ordered menu position.",
      "before_fix": "The shadowed-menu regression failed before effective-key filtering.",
      "tests": [
        "menus_do_not_install_accelerators_for_shadowed_profile_keys",
        "duplicate_keys_keep_their_first_menu_position_and_last_action"
      ]
    },
    {
      "area": "Malformed shortcut modifiers",
      "problem": "Unknown modifier segments were silently discarded and could shadow bare-letter mappings. Empty normalized keys also needed explicit rejection in menu conversion.",
      "resolution": "Parse a base key with recognized modifier prefixes; reject invalid or empty identities while preserving literal plus and shifted punctuation.",
      "tests": [
        "malformed_modifier_sequences_do_not_override_unmodified_keys",
        "shifted_punctuation_and_literal_plus_survive_profile_and_menu_conversion"
      ]
    },
    {
      "area": "Plugin grant persistence",
      "problem": "Independent read/modify/write operations lost grants under concurrent writers. The regression kept 12 of 72 updates.",
      "resolution": "Installation, updates and rollback use one mutation helper with a stable native file lock. Read the latest file under the lock, merge only the target plugin, reject malformed JSON and atomically save. Existing permission denials remain denied on update.",
      "before_fix": "The concurrent permission regression failed with 12 entries instead of 72.",
      "tests": [
        "concurrent_plugin_permission_updates_preserve_other_plugins",
        "permission_updates_preserve_denials_and_rollback_only_the_target_plugin",
        "malformed_permission_state_is_not_overwritten"
      ]
    }
  ],
